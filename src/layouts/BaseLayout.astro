---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageBanner from '../components/LanguageBanner.astro';
import NavigationProgressBar from '../components/NavigationProgressBar.astro';
import GoogleAnalytics from '../components/analytics/GoogleAnalytics.astro';
import { ADS_CONFIG } from '../lib/ads-config';
import { LOCALES_MAP, DEFAULT_LOCALE, isValidLocale, type Locale } from '../i18n/config';
import { extractLocaleFromPath, buildCanonicalUrl, buildHreflangCluster, getBcp47Lang } from '../i18n/utils';
import { getAvailableLocalesForPath } from '../i18n/registry';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  lang?: Locale;
}

const {
  title = 'Free Online Calculators - Finance, Health, Construction & Math',
  description = 'Use 42+ free online calculators for loan EMI, SIP returns, Indian income tax, RCC construction steel, BMI, calorie TDEE, percentages, and scientific math.',
  keywords = ['free online calculator', 'financial calculator', 'construction calculator', 'health calculator', 'math calculator', 'emi calculator', 'civil boq'],
  canonicalUrl,
  ogImage = '/og/default.png',
  noindex = false,
  lang: explicitLang,
} = Astro.props;

const localsLang = (Astro.locals as any)?.locale;
const originalPath = (Astro.locals as any)?.originalPath;
const pathname = originalPath || Astro.url.pathname;
const urlQueryLang = Astro.url.searchParams.get('lang');
const detectedLocale = extractLocaleFromPath(pathname).lang;
const candidateLang = explicitLang || (localsLang && isValidLocale(localsLang) ? localsLang : null) || (urlQueryLang && isValidLocale(urlQueryLang) ? urlQueryLang : null) || detectedLocale;
const currentLang: Locale = isValidLocale(candidateLang) ? candidateLang : DEFAULT_LOCALE;
const bcp47Lang = getBcp47Lang(currentLang);
const textDir = LOCALES_MAP[currentLang]?.dir || 'ltr';

// Automatic self-referencing canonical URL
const selfCanonical = canonicalUrl || buildCanonicalUrl(pathname);

// Reciprocal hreflang cluster for validated available translations
const availableLocales = getAvailableLocalesForPath(pathname);
const hreflangCluster = buildHreflangCluster(pathname, availableLocales);

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'AI Free Calculator';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Ensure ogImage is a fully-qualified URL for WhatsApp, Facebook, Twitter/X crawlers
const siteOrigin = (Astro.site ? Astro.site.origin : 'https://aifreecalculator.com').replace(/\/$/, '');
const resolvedOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
---

<!doctype html>
<html lang={bcp47Lang} dir={textDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={selfCanonical} />

    <!-- Reciprocal hreflang cluster (Strictly available translations + x-default) -->
    {hreflangCluster.map((item) => (
      <link rel="alternate" hreflang={item.lang} href={item.url} />
    ))}

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={selfCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${fullTitle} - AI Free Calculator`} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={selfCanonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={`${fullTitle} - AI Free Calculator`} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AIFreecalculator.com" />
    <link rel="manifest" href="/site.webmanifest" />

    <!--
      Third-Party Script Deferral Engine
      Keeps GA4 / AdSense off the critical rendering path. Each loader runs on the
      first real user interaction, or after the window `load` event settles into an
      idle frame — whichever comes first — so nothing about ad serving or analytics
      is lost, but the main thread stays free while the page paints.
    -->
    <script is:inline>
      window.__afcDefer = function (fn) {
        var done = false;

        function cleanup() {
          try {
            window.removeEventListener('scroll', run);
            window.removeEventListener('pointerdown', run);
            window.removeEventListener('keydown', run);
            window.removeEventListener('touchstart', run);
          } catch (e) {}
        }

        function run() {
          if (done) return;
          done = true;
          cleanup();
          try {
            fn();
          } catch (e) {
            /* A failing third-party loader must never break the page */
          }
        }

        // 1. First genuine user interaction wins (covers real visitors instantly)
        try {
          window.addEventListener('scroll', run, { passive: true });
          window.addEventListener('pointerdown', run, { passive: true });
          window.addEventListener('keydown', run, { passive: true });
          window.addEventListener('touchstart', run, { passive: true });
        } catch (e) {}

        // 2. Otherwise wait for a quiet moment after the page has fully loaded
        function scheduleIdle() {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(run, { timeout: 2500 });
          } else {
            setTimeout(run, 1500);
          }
        }

        if (document.readyState === 'complete') {
          scheduleIdle();
        } else {
          window.addEventListener('load', scheduleIdle, { once: true });
        }
      };
    </script>

    <!-- Google AdSense script loader (deferred off the critical path) -->
    {ADS_CONFIG.isConfigured && (
      <script is:inline define:vars={{ adsClientId: ADS_CONFIG.clientId }}>
        (function () {
          function loadAdSense() {
            try {
              if (document.querySelector('script[src*="pagead2.googlesyndication.com"]')) return;
              var s = document.createElement('script');
              s.async = true;
              s.crossOrigin = 'anonymous';
              s.src =
                'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' +
                adsClientId;
              document.head.appendChild(s);
            } catch (e) {}
          }

          // Exposed so the runtime slot engine can force an immediate load
          // whenever it actually needs to render an ad unit.
          window.__afcLoadAdSense = loadAdSense;

          if (window.__afcDefer) {
            window.__afcDefer(loadAdSense);
          } else {
            loadAdSense();
          }
        })();
      </script>
    )}

    <!-- Google Analytics 4 (deferred off the critical path) -->
    <GoogleAnalytics />

    <!-- Anti-flicker theme script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Schema.org WebSite JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": "https://aifreecalculator.com",
      "description": description,
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://aifreecalculator.com/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />

    <slot name="head" />
  </head>

  <body class="min-h-screen bg-slate-50/50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100 selection:bg-blue-600 selection:text-white transition-colors overflow-x-clip">
    <NavigationProgressBar />
    <div class="flex min-h-screen flex-col">
      <Header lang={currentLang} />

      <main class="flex-1">
        <slot />
      </main>

      <Footer lang={currentLang} />
    </div>

    <!-- Language Confirmation Banner -->
    <LanguageBanner lang={currentLang} />

    <!-- Client-Side Preferred Language Persistence -->
    <script is:inline define:vars={{ serverLang: currentLang }}>
      (function syncPreferredLanguage() {
        try {
          if (serverLang && serverLang !== 'en') {
            localStorage.setItem('preferred_locale', serverLang);
            document.cookie = 'preferred_locale=' + serverLang + '; path=/; max-age=31536000; SameSite=Lax';
          }
        } catch (e) {}
      })();
    </script>

    <!-- Client-Side Google AdSense Slot Hydration Engine (Static build-time config, bundled module) -->
    <script is:inline define:vars={{ initialAdsConfig: ADS_CONFIG }}>
      window.__AFC_ADS_CONFIG__ = initialAdsConfig;
    </script>
    <script src="../scripts/adsense-engine.ts"></script>

    <!-- Scroll to Top Button -->
    <button
      id="scroll-to-top"
      aria-label="Scroll to top"
      title="Scroll to top"
      class="fixed bottom-6 right-6 z-50 flex h-11 w-11 items-center justify-center rounded-full bg-linear-to-br from-blue-600 to-indigo-600 text-white shadow-lg shadow-blue-500/30 opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:scale-110 hover:shadow-xl hover:shadow-blue-500/40 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-950"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>
    </button>

    <script>
      (function () {
        const btn = document.getElementById('scroll-to-top');
        if (!btn) return;

        const updateVisibility = () => {
          if (window.scrollY > 300) {
            btn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            btn.classList.add('opacity-100', 'translate-y-0');
          } else {
            btn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
            btn.classList.remove('opacity-100', 'translate-y-0');
          }
        };

        window.addEventListener('scroll', updateVisibility, { passive: true });
        updateVisibility();

        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>

    <!-- Lightweight Client-Side Error Telemetry (Phase 9 Step 7) -->
    <script is:inline>
      (function () {
        var errorCount = 0;
        var MAX_ERRORS_PER_SESSION = 3;

        function reportClientError(message, source) {
          if (errorCount >= MAX_ERRORS_PER_SESSION) return;
          errorCount++;

          try {
            var payload = JSON.stringify({
              route: window.location.pathname,
              message: String(message || 'Unknown Error').slice(0, 200),
              source: String(source || '').slice(0, 100),
            });

            if (navigator.sendBeacon) {
              navigator.sendBeacon('/api/analytics/error', new Blob([payload], { type: 'application/json' }));
            } else {
              fetch('/api/analytics/error', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: payload,
                keepalive: true,
              }).catch(function () {});
            }
          } catch (e) {}
        }

        window.addEventListener('error', function (evt) {
          if (evt && evt.message) {
            reportClientError(evt.message, evt.filename);
          }
        });

        window.addEventListener('unhandledrejection', function (evt) {
          if (evt && evt.reason) {
            var msg = evt.reason.message || String(evt.reason);
            reportClientError('Unhandled Promise: ' + msg, 'promise');
          }
        });
      })();
    </script>
  </body>
</html>