---
import '../styles/global.css';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import MobileAdminNav from '../components/admin/MobileAdminNav.astro';
import AdminHeader from '../components/admin/AdminHeader.astro';
import AdminSearchModal from '../components/admin/AdminSearchModal.astro';

interface Props {
  title?: string;
  sectionTitle?: string;
  activeSection?: string;
  badge?: string;
}

const {
  title = 'Admin Panel | AI Free Calculator',
  sectionTitle = 'Dashboard',
  activeSection = 'dashboard',
  badge = 'Active',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Admin pages must NOT be indexed -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AIFreecalculator.com" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Anti-flicker theme script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="min-h-screen bg-slate-50/80 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100 transition-colors flex overflow-x-hidden">
    
    <!-- Desktop Sidebar -->
    <AdminSidebar currentPath={currentPath} activeSection={activeSection} />

    <!-- Mobile Slide-In Navigation Drawer -->
    <MobileAdminNav currentPath={currentPath} />

    <!-- Main Application Wrapper -->
    <div class="flex flex-1 flex-col min-w-0 overflow-x-hidden">
      
      <!-- Top Responsive Header -->
      <AdminHeader title={sectionTitle} sectionTitle={sectionTitle} badge={badge} />

      <!-- Page Main Content Slot -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8 min-w-0 max-w-7xl w-full mx-auto">
        <slot />
      </main>

      <!-- Admin Search Modal -->
      <AdminSearchModal />

    </div>

    <!-- Admin Client Controller Scripts -->
    <script is:inline>
      // 1. Auth Guard with 4-Hour Auto-Logout Enforcer
      const FOUR_HOURS_MS = 4 * 60 * 60 * 1000; // 14,400,000 ms

      function performLogout(reason = '') {
        localStorage.removeItem('admin_token');
        localStorage.removeItem('admin_login_time');
        document.cookie = 'admin_session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
        try {
          fetch('/api/admin/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'logout' }),
          });
        } catch {}
        const query = reason ? `?expired=true` : '';
        window.location.href = `/admin/barwalaoffice/${query}`;
      }

      (async function checkAdminAuth() {
        const token = localStorage.getItem('admin_token');
        const hasCookie = document.cookie.includes('admin_session=');
        const loginTimeStr = localStorage.getItem('admin_login_time');
        
        // If login time exists and exceeded 4 hours (14400000ms), log out immediately
        if (loginTimeStr) {
          const loginTime = parseInt(loginTimeStr, 10);
          if (Date.now() - loginTime > FOUR_HOURS_MS) {
            performLogout('expired');
            return;
          }
        }

        if (!token && !hasCookie) {
          const currentPath = encodeURIComponent(window.location.pathname);
          window.location.href = `/admin/barwalaoffice/?redirect=${currentPath}`;
          return;
        }

        try {
          const res = await fetch('/api/admin/auth', {
            headers: token ? { 'Authorization': `Bearer ${token}` } : {},
          });
          if (!res.ok) {
            performLogout('invalid');
          }
        } catch {
          // Allow dev fallback
        }
      })();

      // Background Periodic 4-Hour Expiry Checker (runs every 60 seconds)
      setInterval(() => {
        const loginTimeStr = localStorage.getItem('admin_login_time');
        if (loginTimeStr) {
          const loginTime = parseInt(loginTimeStr, 10);
          if (Date.now() - loginTime > FOUR_HOURS_MS) {
            alert('Your 4-hour admin session has expired for security. Please sign in again.');
            performLogout('expired');
          }
        }
      }, 60000);

      // 2. Theme Toggle
      const themeToggle = document.getElementById('admin-theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // 3. Logout Handlers
      document.getElementById('btn-sidebar-logout')?.addEventListener('click', () => performLogout());
      document.getElementById('btn-mobile-logout')?.addEventListener('click', () => performLogout());

      // 4. Mobile Drawer Navigation Controller
      const mobileDrawer = document.getElementById('mobile-admin-drawer');
      const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');
      const btnOpenDrawer = document.getElementById('btn-open-mobile-drawer');
      const btnCloseDrawer = document.getElementById('btn-close-mobile-drawer');

      function openMobileDrawer() {
        if (!mobileDrawer || !drawerBackdrop) return;
        drawerBackdrop.classList.remove('hidden');
        requestAnimationFrame(() => {
          drawerBackdrop.classList.add('opacity-100');
          mobileDrawer.classList.remove('-translate-x-full');
          mobileDrawer.classList.add('translate-x-0');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeMobileDrawer() {
        if (!mobileDrawer || !drawerBackdrop) return;
        mobileDrawer.classList.remove('translate-x-0');
        mobileDrawer.classList.add('-translate-x-full');
        drawerBackdrop.classList.remove('opacity-100');
        setTimeout(() => {
          drawerBackdrop.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }

      btnOpenDrawer?.addEventListener('click', openMobileDrawer);
      btnCloseDrawer?.addEventListener('click', closeMobileDrawer);
      drawerBackdrop?.addEventListener('click', closeMobileDrawer);

      // 5. Admin Search Modal (Cmd+K / Ctrl+K)
      const searchModal = document.getElementById('admin-search-modal');
      const btnSearchTrigger = document.getElementById('btn-admin-search');
      const btnCloseSearch = document.getElementById('btn-close-admin-search');
      const searchInput = document.getElementById('admin-modal-search-input');
      const searchResults = document.getElementById('admin-search-results-container');

      function openAdminSearch() {
        if (!searchModal) return;
        searchModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
          searchInput?.focus();
          searchInput?.select();
        }, 50);
        renderAdminSearchResults();
      }

      function closeAdminSearch() {
        if (!searchModal) return;
        searchModal.classList.add('hidden');
        document.body.style.overflow = '';
      }

      btnSearchTrigger?.addEventListener('click', openAdminSearch);
      btnCloseSearch?.addEventListener('click', closeAdminSearch);
      searchModal?.addEventListener('click', (e) => {
        if (e.target === searchModal) closeAdminSearch();
      });

      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (searchModal && searchModal.classList.contains('hidden')) {
            openAdminSearch();
          } else {
            closeAdminSearch();
          }
        }
        if (e.key === 'Escape') {
          closeAdminSearch();
          closeMobileDrawer();
        }
      });

      function renderAdminSearchResults() {
        const q = (searchInput?.value || '').toLowerCase().trim();
        const data = window.__ADMIN_SEARCH_DATA__ || [];
        const filtered = data.filter((item) => {
          if (!q) return true;
          return item.title.toLowerCase().includes(q) || item.category.toLowerCase().includes(q);
        });

        if (!searchResults) return;

        if (filtered.length === 0) {
          searchResults.innerHTML = `
            <div class="py-6 text-center text-xs text-slate-400">
              <p class="font-bold text-slate-600 dark:text-slate-300">No match for "${q}"</p>
            </div>
          `;
          return;
        }

        searchResults.innerHTML = filtered.slice(0, 10).map((item) => `
          <a
            href="${item.path}"
            class="flex items-center justify-between p-3 rounded-2xl transition hover:bg-blue-50 dark:hover:bg-slate-800"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-xl shrink-0">${item.icon || '📌'}</span>
              <div class="truncate">
                <div class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white truncate">${item.title}</div>
                <div class="text-[10px] text-slate-400">${item.category}</div>
              </div>
            </div>
            <span class="text-slate-400 text-xs shrink-0">→</span>
          </a>
        `).join('');
      }

      searchInput?.addEventListener('input', renderAdminSearchResults);
    </script>

  </body>
</html>
