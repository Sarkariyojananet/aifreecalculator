---
import '../styles/global.css';

interface Props {
  title?: string;
  activeTab?: 'dashboard' | 'calculators' | 'analytics' | 'settings';
}

const {
  title = 'Admin Panel | AI Free Calculator',
  activeTab = 'dashboard',
} = Astro.props;

const navItems = [
  { id: 'dashboard', label: 'Overview', icon: '📊', path: '/admin/dashboard/' },
  { id: 'calculators', label: 'Calculators (42+)', icon: '🧮', path: '/admin/calculators/' },
  { id: 'analytics', label: 'Traffic & Stats', icon: '📈', path: '/admin/analytics/' },
  { id: 'settings', label: 'AdSense Settings', icon: '📢', path: '/admin/settings/' },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Admin pages must NOT be indexed -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AIFreecalculator.com" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Anti-flicker theme script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100 transition-colors">
    <div class="flex min-h-screen">
      
      <!-- Admin Sidebar Navigation -->
      <aside class="w-64 shrink-0 border-r border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900 hidden md:flex flex-col justify-between">
        <div>
          <!-- Admin Brand Header -->
          <div class="flex h-16 items-center gap-3 border-b border-slate-200 px-6 dark:border-slate-800">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 font-bold text-white text-sm">
              AI
            </div>
            <div>
              <div class="text-sm font-bold tracking-tight">Admin Console</div>
              <div class="text-[10px] text-slate-400">AI Free Calculator</div>
            </div>
          </div>

          <!-- Nav Items -->
          <nav class="space-y-1 p-4">
            {navItems.map((item) => {
              const isActive = activeTab === item.id;
              return (
                <a
                  href={item.path}
                  class={`flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-xs font-semibold transition-colors ${
                    isActive
                      ? 'bg-blue-600 text-white shadow-sm shadow-blue-500/20'
                      : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white'
                  }`}
                >
                  <span class="text-base">{item.icon}</span>
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>
        </div>

        <!-- Sidebar Bottom: Back to Public Website & Logout -->
        <div class="border-t border-slate-200 p-4 dark:border-slate-800 space-y-2">
          <a
            href="/"
            target="_blank"
            class="flex items-center justify-between rounded-xl border border-slate-200 px-3 py-2 text-xs font-medium text-slate-600 hover:bg-slate-50 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800/60"
          >
            <span>Live Site ↗</span>
            <span class="text-[10px] text-slate-400">Public</span>
          </a>
          <button
            id="admin-logout-btn"
            type="button"
            class="w-full flex items-center justify-center gap-2 rounded-xl bg-red-50 py-2 text-xs font-semibold text-red-600 hover:bg-red-100 dark:bg-red-950/40 dark:text-red-400 dark:hover:bg-red-950/70 transition"
          >
            <span>🚪</span> Sign Out
          </button>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex flex-1 flex-col min-w-0">
        
        <!-- Admin Top Navigation Bar -->
        <header class="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-6 dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center gap-3">
            <h1 class="text-base font-bold text-slate-900 dark:text-white capitalize">
              {activeTab} Management
            </h1>
          </div>

          <div class="flex items-center gap-3">
            <button
              id="admin-theme-btn"
              type="button"
              class="rounded-lg border border-slate-200 p-2 text-slate-600 hover:bg-slate-100 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-800 text-xs"
            >
              🌓 Theme
            </button>
            <div class="flex items-center gap-2 rounded-full bg-slate-100 py-1 px-3 dark:bg-slate-800">
              <span class="h-2 w-2 rounded-full bg-green-500"></span>
              <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Admin</span>
            </div>
          </div>
        </header>

        <!-- Dynamic Body Slot -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8">
          <slot />
        </main>
      </div>

    </div>

    <script is:inline>
      // Auth Guard
      (async function checkAdminAuth() {
        const token = localStorage.getItem('admin_token');
        const hasCookie = document.cookie.includes('admin_session=');
        
        // If neither token nor cookie exists, redirect to login
        if (!token && !hasCookie) {
          const currentPath = encodeURIComponent(window.location.pathname);
          window.location.href = `/admin/barwalaoffice/?redirect=${currentPath}`;
          return;
        }

        try {
          const res = await fetch('/api/admin/auth', {
            headers: token ? { 'Authorization': `Bearer ${token}` } : {},
          });
          if (!res.ok) {
            localStorage.removeItem('admin_token');
            const currentPath = encodeURIComponent(window.location.pathname);
            window.location.href = `/admin/barwalaoffice/?redirect=${currentPath}`;
          }
        } catch {
          // If network error, allow local dev
        }
      })();

      const themeBtn = document.getElementById('admin-theme-btn');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      const logoutBtn = document.getElementById('admin-logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          localStorage.removeItem('admin_token');
          document.cookie = 'admin_session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
          try {
            await fetch('/api/admin/auth', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'logout' }),
            });
          } catch {}
          window.location.href = '/admin/barwalaoffice/';
        });
      }
    </script>
  </body>
</html>

