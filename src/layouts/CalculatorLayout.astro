---
import BaseLayout from './BaseLayout.astro';
import CalculatorActionBar from '../components/CalculatorActionBar.astro';
import AdSlotTop from '../components/ads/AdSlotTop.astro';
import AdSlotInline from '../components/ads/AdSlotInline.astro';
import AdSlotSidebar from '../components/ads/AdSlotSidebar.astro';
import AdSlotFooter from '../components/ads/AdSlotFooter.astro';
import { calculators, type CalculatorCategory } from '../data/calculators';
import { getInternalLinks, getCalculatorOverrides } from '../lib/admin/content-store';

interface Props {
  title: string;
  description: string;
  category: CalculatorCategory;
  calculatorName: string;
  slug: string;
  keywords?: string[];
  ogImage?: string;
}

const {
  title,
  description,
  category,
  calculatorName,
  slug,
  keywords = [],
  ogImage,
} = Astro.props;

// Fetch live CMS override (if admin configured custom SEO in /admin/seo/bulk/ or CMS)
const allOverrides = await getCalculatorOverrides(Astro.locals);
const override = allOverrides[slug] || {};

const effectiveName = override.name || calculatorName;
const effectiveTitle = override.metaTitle || title;
const effectiveDescription = override.metaDescription || override.description || description;
const effectiveCanonical = override.canonicalUrl;
const effectiveRobots = override.robots;
const effectiveKeywords = Array.isArray(override.keywords) && override.keywords.length > 0 ? override.keywords : keywords;

// Default to category-specific 1200x630 OG banner if custom one is not provided
const categorySlug = (category || 'general').toLowerCase();
const resolvedOgImage = override.ogImage || ogImage || `/og/${categorySlug}.png`;

// 1. Fetch custom curated internal links (if configured in Admin CMS)
const allInternalLinks = await getInternalLinks(Astro.locals);
const customRelatedSlugs = allInternalLinks[slug] || [];

let relatedCalculators = customRelatedSlugs
  .map((s) => calculators.find((c) => c.slug === s))
  .filter(Boolean) as typeof calculators;

// 2. Fallback to same-category calculators if no custom links defined
if (relatedCalculators.length === 0) {
  relatedCalculators = calculators
    .filter((c) => c.category === category && c.slug !== slug)
    .slice(0, 6);
}

// Top popular tools across site for quick reference
const popularCrossCategory = calculators
  .filter((c) => c.featured && c.slug !== slug)
  .slice(0, 5);

const categoryPath = `/${category.toLowerCase()}/`;
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
  noindex={effectiveRobots?.includes('noindex')}
  keywords={[...effectiveKeywords, effectiveName.toLowerCase(), `${effectiveName.toLowerCase()} online`, `${category.toLowerCase()} calculator`]}
  ogImage={resolvedOgImage}
>
  <Fragment slot="head">
    <!-- JSON-LD WebApplication / SoftwareApplication Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": effectiveName,
      "applicationCategory": `${category}Application`,
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": effectiveDescription,
      "url": Astro.url.href,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />
  </Fragment>

  <!-- Breadcrumbs & Hero Header -->
  <section class="border-b border-slate-200 bg-white px-4 py-6 dark:border-slate-800 dark:bg-slate-900/60 sm:py-8">
    <div class="mx-auto max-w-7xl">
      
      <!-- Breadcrumb Bar -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400">Home</a>
        <span>/</span>
        <a href={categoryPath} class="hover:text-blue-600 dark:hover:text-blue-400 font-medium">
          {category}
        </a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">
          {effectiveName}
        </span>
      </nav>

      <!-- Hero Title -->
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-bold tracking-wider text-blue-700 dark:border-blue-900/50 dark:bg-blue-950/60 dark:text-blue-400">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-600 dark:bg-blue-400"></span>
          {category.toUpperCase()} TOOL
        </div>

        <h1 class="mt-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl lg:text-4xl">
          {effectiveName}
        </h1>

        <p class="mt-2.5 text-xs leading-relaxed text-slate-600 dark:text-slate-300 sm:text-sm">
          {effectiveDescription}
        </p>
      </div>

    </div>
  </section>

  <!-- Top Leaderboard Ad Slot -->
  <div class="mx-auto max-w-7xl px-4">
    <AdSlotTop />
  </div>

  <!-- Main Content Layout (Calculator + Content + Sidebar) -->
  <div class="mx-auto max-w-7xl px-4 py-4 sm:py-6">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_320px]">
      
      <!-- Left Column: Tool Widget, Inline Ad, Guide, FAQs -->
      <div class="min-w-0 space-y-8">
        
        <!-- Interactive Calculator Widget Container -->
        <div class="rounded-3xl border border-slate-200/90 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-7">
          <slot />
          <CalculatorActionBar calculatorName={effectiveName} slug={slug} category={category} />
        </div>

        <!-- In-Feed Result Ad Slot -->
        <AdSlotInline />

        <!-- Feedback & Report Issue Banner -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-2xl border border-blue-100 bg-blue-50/60 p-4 text-xs dark:border-blue-900/40 dark:bg-blue-950/20">
          <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
            <span class="text-base shrink-0">💬</span>
            <span>
              <strong>Found an issue?</strong> If a calculator is not working as expected or you spot an error, please <a href="/contact/" class="font-bold text-blue-600 underline dark:text-blue-400">contact us</a> so we can help.
            </span>
          </div>
          <a
            href="/contact/"
            class="shrink-0 inline-flex items-center justify-center gap-1 rounded-xl bg-blue-600 px-3.5 py-1.5 font-bold text-white shadow-xs hover:bg-blue-700 transition"
          >
            Contact Support →
          </a>
        </div>

        <!-- Educational Content / Formula / How to Calculate Slot -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/60 sm:p-8">
          <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 dark:prose-a:text-blue-400">
            <slot name="content" />
          </div>
        </div>

        <!-- FAQs Section -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/60 sm:p-8">
          <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white mb-6 flex items-center gap-2">
            <span>❓</span> Frequently Asked Questions
          </h2>
          <slot name="faq" />
        </div>

      </div>

      <!-- Right Column: Sidebar (Sticky Ad + Related Tools) -->
      <aside class="space-y-6">
        <div class="sticky top-20 space-y-6">
          
          <!-- Sticky Sidebar Ad Slot -->
          <AdSlotSidebar />

          <!-- Related Tools in this Category -->
          {relatedCalculators.length > 0 && (
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/70">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-1.5">
                  <span>📂</span> More {category} Tools
                </h3>
                <a href={categoryPath} class="text-[11px] font-semibold text-blue-600 hover:underline dark:text-blue-400">
                  View all →
                </a>
              </div>

              <div class="mt-3 divide-y divide-slate-100 dark:divide-slate-800/60">
                {relatedCalculators.map((c) => (
                  <a
                    href={c.path}
                    class="group flex items-center justify-between py-2.5 text-xs transition hover:text-blue-600 dark:hover:text-blue-400"
                  >
                    <div class="flex items-center gap-2 min-w-0 pr-2">
                      <span class="text-base shrink-0">{c.icon}</span>
                      <span class="truncate font-medium text-slate-700 group-hover:text-blue-600 dark:text-slate-200 dark:group-hover:text-blue-400">
                        {c.name}
                      </span>
                    </div>
                    <span class="shrink-0 text-slate-400 group-hover:translate-x-0.5 transition-transform text-[10px]">
                      →
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Popular Calculators Across Site -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/70">
            <div class="border-b border-slate-100 pb-3 dark:border-slate-800">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-1.5">
                <span>🔥</span> Most Popular
              </h3>
            </div>
            <div class="mt-3 divide-y divide-slate-100 dark:divide-slate-800/60">
              {popularCrossCategory.map((c) => (
                <a
                  href={c.path}
                  class="group flex items-center justify-between py-2 text-xs transition hover:text-blue-600 dark:hover:text-blue-400"
                >
                  <div class="flex items-center gap-2 min-w-0 pr-2">
                    <span class="text-sm shrink-0">{c.icon}</span>
                    <span class="truncate font-medium text-slate-700 group-hover:text-blue-600 dark:text-slate-200 dark:group-hover:text-blue-400">
                      {c.name}
                    </span>
                  </div>
                  <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[9px] font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                    {c.category}
                  </span>
                </a>
              ))}
            </div>
          </div>

        </div>
      </aside>

    </div>
  </div>

  <!-- Bottom Footer Ad Slot -->
  <div class="mx-auto max-w-7xl px-4">
    <AdSlotFooter />
  </div>

  <!-- Client-side Calculator Error & Anomaly Telemetry -->
  <script is:inline define:vars={{ slug }}>
    (function() {
      if (typeof window === 'undefined') return;

      // Listen for uncaught calculation errors on the calculator page
      window.addEventListener('error', function(event) {
        if (!event || !event.message) return;
        var msg = String(event.message || '');
        // Filter out harmless browser noise, ad blockers, and third-party widgets
        if (
          msg.includes('ResizeObserver') ||
          msg.includes('Script error') ||
          msg.includes('adsbygoogle') ||
          msg.includes('extension')
        ) {
          return;
        }

        try {
          var payload = JSON.stringify({
            calculatorSlug: slug,
            errorType: event.error && event.error.name ? event.error.name : 'UncaughtException',
            errorMessage: msg.slice(0, 300),
            url: window.location.pathname
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/calculator-error-log', payload);
          } else {
            fetch('/api/calculator-error-log', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true
            }).catch(function() {});
          }
        } catch (e) {}
      });

      // Global hook for calculator script handlers to report NaN / Infinite results
      window.__reportCalculatorAnomaly = function(type, details) {
        try {
          var payload = JSON.stringify({
            calculatorSlug: slug,
            errorType: type || 'CalculationAnomaly',
            errorMessage: typeof details === 'string' ? details.slice(0, 300) : JSON.stringify(details).slice(0, 300),
            url: window.location.pathname
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/calculator-error-log', payload);
          }
        } catch (e) {}
      };
    })();
  </script>
</BaseLayout>
