---
import type { Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
  ui?: {
    calculate?: string;
    reset?: string;
    results?: string;
    loading?: string;
  };
}

const { lang = 'en', ui } = Astro.props;
const btnCalculate = ui?.calculate || 'Calculate Calories';
const btnReset = ui?.reset || 'Reset';
const resultsTitle = ui?.results || 'Daily Calorie Breakdown';
---

<div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-rose-50/60 p-5 sm:p-7 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-rose-950/20">
  <form id="localized-calorie-form" class="space-y-5" onsubmit="return false;">
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div>
        <label for="calorie-gender" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Gender / लिंग / Género
        </label>
        <select
          id="calorie-gender"
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-rose-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer"
        >
          <option value="male">Male</option>
          <option value="female">Female</option>
        </select>
      </div>

      <div>
        <label for="calorie-age" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Age (Years) / उम्र / Edad
        </label>
        <input
          type="number"
          id="calorie-age"
          min="15"
          max="100"
          value="30"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-rose-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
      </div>

      <div>
        <label for="calorie-weight" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Weight (kg) / वजन / Peso
        </label>
        <input
          type="number"
          id="calorie-weight"
          step="0.5"
          min="30"
          max="250"
          value="75"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-rose-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
      </div>

      <div>
        <label for="calorie-height" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Height (cm) / कद / Altura
        </label>
        <input
          type="number"
          id="calorie-height"
          min="100"
          max="230"
          value="180"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-rose-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
      </div>
    </div>

    <div>
      <label for="calorie-activity" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
        Physical Activity / शारीरिक सक्रियता / Actividad
      </label>
      <select
        id="calorie-activity"
        class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-rose-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer"
      >
        <option value="1.2">Sedentary (Little or no exercise, desk job)</option>
        <option value="1.375">Lightly Active (Exercise 1-3 times/week)</option>
        <option value="1.55" selected>Moderately Active (Exercise 3-5 times/week)</option>
        <option value="1.725">Very Active (Hard exercise 6-7 times/week)</option>
        <option value="1.9">Extra Active (Intense athlete / physical labor job)</option>
      </select>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button
        type="button"
        id="calorie-calc-btn"
        class="inline-flex items-center justify-center rounded-xl bg-rose-600 px-6 py-3 text-sm font-bold text-white shadow-md transition hover:bg-rose-700 cursor-pointer"
      >
        {btnCalculate}
      </button>
      <button
        type="button"
        id="calorie-reset-btn"
        class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer"
      >
        {btnReset}
      </button>
    </div>
  </form>

  <!-- Results Box -->
  <div id="calorie-result-card" class="mt-6 rounded-2xl border border-rose-200 bg-rose-50/70 p-5 dark:border-rose-900/50 dark:bg-rose-950/30">
    <div class="text-xs font-bold uppercase tracking-wider text-rose-800 dark:text-rose-300 mb-1">
      {resultsTitle}
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-rose-100 dark:border-rose-900/40">
        <div class="text-xs text-slate-500 dark:text-slate-400">Weight Loss (-500 kcal)</div>
        <div id="calorie-loss" class="text-2xl font-black text-rose-600 dark:text-rose-400 mt-1">2,181</div>
        <div class="text-[11px] text-slate-400">~0.5 kg fat loss / week</div>
      </div>

      <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-rose-100 dark:border-rose-900/40">
        <div class="text-xs text-slate-500 dark:text-slate-400">Maintenance (TDEE)</div>
        <div id="calorie-maintenance" class="text-2xl font-black text-slate-900 dark:text-white mt-1">2,681</div>
        <div class="text-[11px] text-slate-400">Maintains current weight</div>
      </div>

      <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-rose-100 dark:border-rose-900/40">
        <div class="text-xs text-slate-500 dark:text-slate-400">Weight Gain (+300 kcal)</div>
        <div id="calorie-gain" class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">2,981</div>
        <div class="text-[11px] text-slate-400">Lean muscle building</div>
      </div>
    </div>
    <div class="mt-3 text-xs text-slate-500 dark:text-slate-400">
      Basal Metabolic Rate (BMR): <strong id="calorie-bmr">1,730 kcal/day</strong>
    </div>
  </div>
</div>

<script>
  function initCalorieEngine() {
    const genderSelect = document.getElementById('calorie-gender') as HTMLSelectElement | null;
    const ageInput = document.getElementById('calorie-age') as HTMLInputElement | null;
    const weightInput = document.getElementById('calorie-weight') as HTMLInputElement | null;
    const heightInput = document.getElementById('calorie-height') as HTMLInputElement | null;
    const activitySelect = document.getElementById('calorie-activity') as HTMLSelectElement | null;
    const calcBtn = document.getElementById('calorie-calc-btn');
    const resetBtn = document.getElementById('calorie-reset-btn');
    const lossEl = document.getElementById('calorie-loss');
    const maintenanceEl = document.getElementById('calorie-maintenance');
    const gainEl = document.getElementById('calorie-gain');
    const bmrEl = document.getElementById('calorie-bmr');

    if (!genderSelect || !ageInput || !weightInput || !heightInput || !activitySelect || !calcBtn) return;

    function calculate() {
      const isMale = genderSelect?.value === 'male';
      const age = parseFloat(ageInput?.value || '0');
      const w = parseFloat(weightInput?.value || '0');
      const h = parseFloat(heightInput?.value || '0');
      const activity = parseFloat(activitySelect?.value || '1.55');

      if (age <= 0 || w <= 0 || h <= 0) return;

      // Mifflin-St Jeor
      const bmr = isMale
        ? (10 * w) + (6.25 * h) - (5 * age) + 5
        : (10 * w) + (6.25 * h) - (5 * age) - 161;

      const tdee = bmr * activity;

      if (bmrEl) bmrEl.textContent = `${Math.round(bmr).toLocaleString()} kcal/day`;
      if (maintenanceEl) maintenanceEl.textContent = Math.round(tdee).toLocaleString();
      if (lossEl) lossEl.textContent = Math.round(tdee - 500).toLocaleString();
      if (gainEl) gainEl.textContent = Math.round(tdee + 300).toLocaleString();
    }

    calcBtn.addEventListener('click', calculate);
    genderSelect.addEventListener('change', calculate);
    ageInput.addEventListener('input', calculate);
    weightInput.addEventListener('input', calculate);
    heightInput.addEventListener('input', calculate);
    activitySelect.addEventListener('change', calculate);

    resetBtn?.addEventListener('click', () => {
      if (genderSelect) genderSelect.value = 'male';
      if (ageInput) ageInput.value = '30';
      if (weightInput) weightInput.value = '75';
      if (heightInput) heightInput.value = '180';
      if (activitySelect) activitySelect.value = '1.55';
      calculate();
    });

    calculate();
  }

  initCalorieEngine();
  document.addEventListener('astro:page-load', initCalorieEngine);
</script>
