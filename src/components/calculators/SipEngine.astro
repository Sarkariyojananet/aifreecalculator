---
import type { Locale } from '../../i18n/config';

interface Props {
  lang?: Locale;
  ui?: {
    calculate?: string;
    reset?: string;
    results?: string;
    loading?: string;
  };
}

const { lang = 'en', ui } = Astro.props;
const btnCalculate = ui?.calculate || 'Calculate Returns';
const btnReset = ui?.reset || 'Reset';
const resultsTitle = ui?.results || 'Investment Projection';
---

<div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-indigo-50/60 p-5 sm:p-7 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-indigo-950/20">
  <form id="localized-sip-form" class="space-y-5" onsubmit="return false;">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label for="sip-monthly" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Monthly Investment / मासिक निवेश
        </label>
        <input
          type="number"
          id="sip-monthly"
          step="100"
          min="100"
          value="500"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-indigo-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
      </div>

      <div>
        <label for="sip-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Expected Return (% p.a.) / अपेक्षित रिटर्न
        </label>
        <input
          type="number"
          id="sip-rate"
          step="0.1"
          min="1"
          max="40"
          value="12"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-indigo-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
      </div>

      <div>
        <label for="sip-tenure" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Tenure (Years) / अवधि / Años
        </label>
        <input
          type="number"
          id="sip-tenure"
          min="1"
          max="40"
          value="15"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-indigo-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
      </div>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button
        type="button"
        id="sip-calc-btn"
        class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-md transition hover:bg-indigo-700 cursor-pointer"
      >
        {btnCalculate}
      </button>
      <button
        type="button"
        id="sip-reset-btn"
        class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer"
      >
        {btnReset}
      </button>
    </div>
  </form>

  <!-- Results Box -->
  <div id="sip-result-card" class="mt-6 rounded-2xl border border-indigo-200 bg-indigo-50/70 p-5 dark:border-indigo-900/50 dark:bg-indigo-950/30">
    <div class="text-xs font-bold uppercase tracking-wider text-indigo-800 dark:text-indigo-300 mb-1">
      {resultsTitle}
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
      <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-indigo-100 dark:border-indigo-900/40">
        <div class="text-xs text-slate-500 dark:text-slate-400">Invested Amount / कुल निवेश</div>
        <div id="sip-invested" class="text-xl sm:text-2xl font-bold text-slate-700 dark:text-slate-200 mt-1">90,000</div>
      </div>

      <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-indigo-100 dark:border-indigo-900/40">
        <div class="text-xs text-slate-500 dark:text-slate-400">Estimated Gains / अनुमानित लाभ</div>
        <div id="sip-gains" class="text-xl sm:text-2xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">159,985</div>
      </div>

      <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-indigo-100 dark:border-indigo-900/40">
        <div class="text-xs text-slate-500 dark:text-slate-400">Total Maturity Value / कुल धन</div>
        <div id="sip-total" class="text-2xl sm:text-3xl font-black text-indigo-600 dark:text-indigo-400 mt-1">249,985</div>
      </div>
    </div>
  </div>
</div>

<script>
  function initSipEngine() {
    const monthlyInput = document.getElementById('sip-monthly') as HTMLInputElement | null;
    const rateInput = document.getElementById('sip-rate') as HTMLInputElement | null;
    const tenureInput = document.getElementById('sip-tenure') as HTMLInputElement | null;
    const calcBtn = document.getElementById('sip-calc-btn');
    const resetBtn = document.getElementById('sip-reset-btn');
    const investedEl = document.getElementById('sip-invested');
    const gainsEl = document.getElementById('sip-gains');
    const totalEl = document.getElementById('sip-total');

    if (!monthlyInput || !rateInput || !tenureInput || !calcBtn) return;

    function calculate() {
      const p = parseFloat(monthlyInput?.value || '0');
      const annualRate = parseFloat(rateInput?.value || '0');
      const years = parseFloat(tenureInput?.value || '0');

      if (p <= 0 || annualRate <= 0 || years <= 0) return;

      const i = (annualRate / 12) / 100;
      const n = years * 12;

      // M = P × [((1 + i)^n - 1) / i] × (1 + i)
      const maturity = p * ((Math.pow(1 + i, n) - 1) / i) * (1 + i);
      const invested = p * n;
      const gains = maturity - invested;

      if (investedEl) investedEl.textContent = Math.round(invested).toLocaleString();
      if (gainsEl) gainsEl.textContent = Math.round(gains).toLocaleString();
      if (totalEl) totalEl.textContent = Math.round(maturity).toLocaleString();
    }

    calcBtn.addEventListener('click', calculate);
    monthlyInput.addEventListener('input', calculate);
    rateInput.addEventListener('input', calculate);
    tenureInput.addEventListener('input', calculate);

    resetBtn?.addEventListener('click', () => {
      if (monthlyInput) monthlyInput.value = '500';
      if (rateInput) rateInput.value = '12';
      if (tenureInput) tenureInput.value = '15';
      calculate();
    });

    calculate();
  }

  initSipEngine();
  document.addEventListener('astro:page-load', initSipEngine);
</script>
