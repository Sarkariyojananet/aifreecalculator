---
const categories = [
  'All',
  'Construction',
  'Finance',
  'Health',
  'General',
];
---

<div
  class="flex flex-wrap justify-center gap-3"
  id="category-tabs"
>
  {
    categories.map((category) => (
      <button
        type="button"
        data-category={category}
        class:list={[
          'category-tab rounded-xl border px-4 py-2 text-sm font-semibold transition',
          category === 'All'
            ? 'border-slate-900 bg-slate-900 text-white dark:border-blue-600 dark:bg-blue-600'
            : 'border-slate-300 bg-white text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800',
        ]}
      >
        {category}
      </button>
    ))
  }
</div>