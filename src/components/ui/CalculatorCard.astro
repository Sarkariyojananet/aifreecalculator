---
interface Props {
  name: string;
  slug: string;
  category: string;
  description: string;
}

const { name, slug, category, description } = Astro.props;
---

<a
  href={`/${slug}/`}
  class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700 dark:hover:bg-slate-800"
>
  <div class="flex items-center justify-between gap-4">
    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
      {category}
    </span>

    <span
      class="text-lg text-slate-400 transition group-hover:translate-x-1 group-hover:text-slate-900 dark:text-slate-500 dark:group-hover:text-white"
      aria-hidden="true"
    >
      →
    </span>
  </div>

  <h2 class="mt-5 text-xl font-bold tracking-tight text-slate-900 dark:text-white">
    {name}
  </h2>

  <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
    {description}
  </p>

  <div class="mt-auto pt-6">
    <span class="text-sm font-semibold text-slate-900 dark:text-white">
      Open Calculator
    </span>
  </div>
</a>