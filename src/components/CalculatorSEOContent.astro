      return [
        'स्लैब, बीम, कॉलम, फुटिंग और चिनाई के लिए निर्माण सामग्री की सही मात्रा का आकलन',
        'परियोजना बजट बनाना और साइट पर सामग्री की बर्बादी को रोकना',
        'मानक सीपीडब्ल्यूडी और आईएस 456 सिविल इंजीनियरिंग मानकों के अनुसार क्रॉस-सत्यापन'
      ];
    }
    if (cat === 'health') {
      return [
        'व्यक्तिगत स्वास्थ्य दिनचर्या के हिस्से के रूप में बायोमेट्रिक संकेतकों को ट्रैक करना',
        'मेटाबोलिक ऊर्जा आवश्यकताओं (बीएमआर/टीडीईई) का सटीक आकलन करना',
        'संतुलित जीवनशैली की आदतों के साथ प्रगति की निगरानी करना'
      ];
    }
    if (cat === 'finance') {
      return [
        `${name} के साथ सटीक वित्तीय राशियों और भुगतान अनुसूचियों का पूर्वानुमान लगाना`,
        'ब्याज दरों में उतार-चढ़ाव, अवधि और चक्रवृद्धि वृद्धि का मूल्यांकन करना',
        'पारदर्शी गणितीय सूत्रों के साथ व्यक्तिगत और व्यावसायिक वित्त का बजट बनाना'
      ];
    }
    return [
      `${name} द्वारा त्वरित और त्रुटिहीन गणना निष्पादित करना`,
      'चरण-दर-चरण गणितीय तर्क से हस्तलिखित गणनाओं का सत्यापन करना',
      'दैनिक रूपांतरण और संख्यात्मक अनुमान कार्यों को सरलता से हल करना'
    ];
  }

  if (locale === 'es') {
    if (cat === 'compiler-tools') {
      return [
        'Practicar sintaxis y algoritmos sin instalar compiladores locales ni entornos pesados',
        'Verificar fragmentos de código breves y comprobar resultados de terminal en tiempo real',
        'Estudiar patrones de programación para cursos académicos o entrevistas técnicas'
      ];
    }
    if (cat === 'image-tools') {
      return [
        'Optimizar y transformar imágenes en el navegador sin pérdida de resolución ni calidad',
        'Preparar archivos gráficos para sitios web, presentaciones y compatibilidad de formatos',
        'Garantizar privacidad absoluta con procesamiento local Canvas sin subir archivos'
      ];
    }
    if (cat === 'pdf-tools') {
      return [
        'Organizar, dividir y convertir páginas de documentos PDF sin software de pago',
        'Crear documentos PDF limpios para presentaciones oficiales, trámites y archivo',
        'Mantener la confidencialidad total procesando los archivos en su propio dispositivo'
      ];
    }
    if (cat === 'time-table-tools') {
      return [
        'Organizar clases, horarios de estudio y turnos en una cuadrícula visual intuitiva',
        'Equilibrar bloques de trabajo productivo con tiempo personal y descanso',
        'Exportar horarios imprimibles de alta resolución para tableros y carpetas'
      ];
    }
    if (cat === 'construction') {
      return [
        'Calcular cantidades de materiales para losas, vigas, columnas y albañilería',
        'Planificar presupuestos de compras y evitar desperdicio de material en obra',
        'Verificar cálculos frente a estándares habituales de construcción civil'
      ];
    }
    if (cat === 'health') {
      return [
        'Monitorear indicadores de bienestar y salud personal en su rutina habitual',
        'Estimar requerimientos metabólicos de energía (TMB/TDEE) y macronutrientes',
        'Seguir la evolución física junto con hábitos saludables y supervisión médica'
      ];
    }
    if (cat === 'finance') {
      return [
        `Calcular cantidades exactas y tablas de pagos para previsiones con ${name}`,
        'Evaluar variaciones de tipos de interés, plazos y crecimiento compuesto en el tiempo',
        'Presupuestar finanzas personales y profesionales con fórmulas matemáticas claras'
      ];
    }
    return [
      `Realizar cálculos rápidos y exactos utilizando ${name}`,
      'Verificar cálculos manuales con el procedimiento matemático paso a paso',
      'Resolver tareas cotidianas de conversión, porcentajes y estimaciones numéricas'
    ];
  }

  // Fallback English
  if (cat === 'compiler-tools') {
    return [
      'Practising programming syntax and basic algorithms without installing a local compiler or heavy IDE',
      'Verifying short code snippets, testing edge cases, and inspecting real-time terminal output',
      'Studying programming patterns and starter templates for academic coursework or technical interviews'
    ];
  }
  if (cat === 'image-tools') {
    return [
      'Optimizing and transforming graphic assets directly in your web browser with zero quality degradation',
      'Preparing image files for web publishing, presentations, or legacy system compatibility',
      'Guaranteeing photo privacy with 100% in-browser Canvas processing and zero file transmissions'
    ];
  }
  if (cat === 'pdf-tools') {
    return [
      'Managing, organizing, and converting document pages without paid desktop software suites',
      'Preparing clean, compliant PDF documents for official submissions, academic papers, and printing',
      'Maintaining document confidentiality with client-side zero-upload file manipulation'
    ];
  }
  if (cat === 'time-table-tools') {
    return [
      'Organizing classes, study sessions, fitness routines, and shift duties into an intuitive visual grid',
      'Balancing productive work blocks with personal rest, hobbies, and family time',
      'Exporting clean, high-resolution printable schedule sheets for binders, desks, or noticeboards'
    ];
  }
  if (cat === 'construction') {
    return [
      'Estimating structural material quantities for slabs, beams, columns, footing, and masonry',
      'Planning project procurement budgets and preventing expensive site material wastage',
      'Cross-referencing estimates against standard CPWD and IS 456 civil engineering benchmarks'
    ];
  }
  if (cat === 'health') {
    return [
      'Tracking personal biometric health and fitness indicators as part of a structured wellness regimen',
      'Estimating metabolic energy requirements (BMR/TDEE) and balancing caloric and macronutrient intakes',
      'Monitoring progress trends alongside balanced lifestyle habits and professional medical guidance'
    ];
  }
  if (cat === 'finance') {
    return [
      `Computing exact financial amounts and payment schedules for ${name} forecasting`,
      'Evaluating interest rate variations, tenure durations, and compound growth over time',
      'Budgeting personal and business finances with transparent, verified mathematical formulas'
    ];
  }
  return [
    `Performing quick, error-free computations with the ${name}`,
    'Verifying manual calculations with step-by-step mathematical logic',
    'Solving everyday conversion, percentage, and quantitative estimation tasks'
  ];
}

const useCases = getUseCases(categoryKey, calculatorName, validLang);

// Category-aware contextual feature cards (Finance, Construction, Health, PDF, Images, Compilers, Timetables, Math, General)
const features = getCategoryFeatures(categoryKey, validLang);
const eeat = getEEATContent(categoryKey, validLang);
---

<div class="space-y-8">

  <!-- Overview Section -->
  <div class="space-y-3">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>📖</span> {labels.about(calculatorName)}
    </h2>

    <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      {introText}
    </p>
  </div>

  <!-- Trust & Privacy Guarantee Strip -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    {eeat.trustBadges.map((badge) => (
      <div class="rounded-2xl border border-slate-200/90 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-900/60 shadow-2xs">
        <div class="flex items-center gap-2">
          <span class="text-lg shrink-0">{badge.icon}</span>
          <h3 class="text-xs font-bold text-slate-900 dark:text-white leading-tight">{badge.title}</h3>
        </div>
        <p class="mt-1.5 text-[11px] leading-relaxed text-slate-600 dark:text-slate-400">
          {badge.desc}
        </p>
      </div>
    ))}
  </div>

  <!-- Mathematical Formula (When Available) -->
  {translation?.formulaEquation && (
    <div class="space-y-3 rounded-2xl border border-blue-200/80 bg-linear-to-br from-blue-50/50 to-indigo-50/30 p-5 dark:border-blue-900/40 dark:from-slate-900 dark:to-blue-950/20">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">
        <span>📐</span> {translation.formulaTitle || labels.formula}
      </div>
      <div class="rounded-xl border border-blue-200 bg-white p-3.5 font-mono text-xs sm:text-sm font-bold text-blue-950 dark:border-blue-900/60 dark:bg-slate-950 dark:text-blue-200 overflow-x-auto shadow-2xs">
        <code>{translation.formulaEquation}</code>
      </div>
      {formulaDesc && (
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {formulaDesc}
        </p>
      )}
    </div>
  )}

  <!-- Variables Breakdown Table (When Available) -->
  {translation?.variables && translation.variables.length > 0 && (
    <div class="space-y-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>📋</span> {labels.variables}
      </h3>
      <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/70">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-800/60 text-slate-700 dark:text-slate-300 font-bold">
            <tr>
              <th class="p-2.5">{labels.symbol}</th>
              <th class="p-2.5">{labels.variableName}</th>
              <th class="p-2.5">{labels.description}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-slate-600 dark:text-slate-300">
            {translation.variables.map((v) => (
              <tr>
                <td class="p-2.5 font-mono font-bold text-blue-600 dark:text-blue-400">{v.symbol}</td>
                <td class="p-2.5 font-semibold text-slate-900 dark:text-white">{v.name || v.label}</td>
                <td class="p-2.5 leading-relaxed">{v.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Step-by-Step Procedure (When Available) -->
  {translation?.stepByStep && translation.stepByStep.length > 0 && (
    <div class="space-y-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>🔢</span> {labels.stepByStep}
      </h3>
      <ol class="space-y-2 list-decimal list-inside text-xs leading-relaxed text-slate-700 dark:text-slate-300">
        {translation.stepByStep.map((s) => (
          <li class="pl-1">
            {typeof s === 'string' ? (
              s
            ) : (
              <>
                {s.title && <strong class="text-slate-900 dark:text-white">{s.title}: </strong>}
                {s.instruction || s.description || ''}
              </>
            )}
          </li>
        ))}
      </ol>
    </div>
  )}

  <!-- Worked Example (When Available) -->
  {translation?.workedExample && (translation.workedExample.scenario || translation.workedExample.calculation) && (
    <div class="space-y-3 rounded-2xl border border-emerald-200/80 bg-emerald-50/40 p-5 dark:border-emerald-900/40 dark:bg-emerald-950/20">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">
        <span>💡</span> {translation.workedExample.title || labels.workedExample}
      </div>
      {translation.workedExample.scenario && (
        <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
          <strong>{labels.scenario}</strong> {translation.workedExample.scenario}
        </p>
      )}
      {translation.workedExample.calculation && (
        <div class="rounded-lg bg-white p-3 font-mono text-xs text-slate-800 dark:bg-slate-900 dark:text-slate-200 border border-emerald-200/60 dark:border-emerald-900/40">
          <code>{translation.workedExample.calculation}</code>
        </div>
      )}
      {translation.workedExample.result && (
        <p class="text-xs font-semibold text-emerald-800 dark:text-emerald-300">
          <strong>{labels.result}</strong> {translation.workedExample.result}
        </p>
      )}
    </div>
  )}

  <!-- Calculation Methodology & Reference Standards -->
  <div class="space-y-3 rounded-2xl border border-blue-200/80 bg-linear-to-br from-blue-50/40 via-white to-indigo-50/30 p-5 dark:border-blue-900/40 dark:from-slate-900 dark:via-slate-900 dark:to-blue-950/20 shadow-2xs">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">
        <span>📐</span> {eeat.methodology.title}
      </div>
      <span class="rounded-full border border-blue-200 bg-blue-100/80 px-2.5 py-0.5 text-[10px] font-bold text-blue-800 dark:border-blue-800 dark:bg-blue-900/60 dark:text-blue-200">
        {eeat.methodology.standardName}
      </span>
    </div>
    <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
      {eeat.methodology.description}
    </p>
  </div>

  <!-- Why Use This Tool/Calculator -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>✨</span> {labels.whyUse(toolKind)}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {features.map((feature) => (
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="flex items-start gap-2.5">
            <span class="text-xl shrink-0">{feature.icon}</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900 dark:text-white">{feature.title}</h3>
              <p class="mt-0.5 text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">{feature.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Common Practical Use Cases -->
  <div class="space-y-3">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>🎯</span> {labels.commonUseCases}
    </h2>

    <ul class="space-y-2 text-xs text-slate-700 dark:text-slate-300">
      {useCases.map((uc) => (
        <li class="flex items-start gap-2">
          <span class="text-blue-600 dark:text-blue-400 shrink-0 font-bold">•</span>
          <span>{uc}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Technical Limitations & Domain Disclaimers -->
  <div class="space-y-4">
    <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-5 dark:border-amber-900/40 dark:bg-amber-950/20 space-y-3">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">
        <span>⚠️</span> {eeat.limitations.title}
      </div>
      <div class="space-y-2 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
        <p class="font-medium text-slate-800 dark:text-slate-200">
          • {eeat.limitations.disclaimer}
        </p>
        <p>
          • {eeat.limitations.technicalNote}
        </p>
        {isHealth && (
          <p>• {labels.medicalNotice}</p>
        )}
        {isFinance && (
          <p>• {labels.financialNotice}</p>
        )}
        {isConstruction && (
          <p>• {labels.engineeringNotice}</p>
        )}
        {isCompiler && (
          <p>• {labels.executionNotice}</p>
        )}
        {(isImageTool || isPdfTool) && (
          <p>• {labels.privacyGuarantee}</p>
        )}
        <p>• {labels.disclaimerVerify}</p>
      </div>
    </div>

    <!-- Peer Review & Feedback Channel -->
    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs shadow-2xs">
      <div class="space-y-0.5">
        <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
          <span>🤝</span> {eeat.limitations.peerReviewNote}
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          Our engineering team regularly reviews algorithms against updated regulatory and technical publications.
        </p>
      </div>
      <a
        href={getLocalizedPath('/contact/', validLang)}
        class="shrink-0 rounded-lg bg-slate-100 hover:bg-slate-200 px-3.5 py-1.5 text-xs font-bold text-blue-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-blue-300 transition cursor-pointer"
      >
        {eeat.limitations.feedbackLinkText}
      </a>
    </div>
  </div>

</div>
