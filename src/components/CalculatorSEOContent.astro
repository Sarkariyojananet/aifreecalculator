---
/**
 * SEO-Friendly & Educational Content Section for Calculator & Tool Pages
 * Provides authentic, tool-specific mathematical formulas, variables breakdown,
 * step-by-step procedures, worked practical examples, and accurate domain disclaimers.
 * Fully localized across all 9 supported languages.
 */

import { getCalculatorTranslation } from '../i18n/translations/calculators';
import { isValidLocale, type Locale } from '../i18n/config';
import { getCategoryFeatures } from '../i18n/translations/category-features';
import { getEEATContent } from '../i18n/translations/eeat-standards';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  calculatorName: string;
  category: string;
  slug: string;
  lang?: string;
}

const { calculatorName, category, slug, lang = 'en' } = Astro.props;
const validLang: Locale = isValidLocale(lang) ? (lang as Locale) : 'en';
const translation = getCalculatorTranslation(slug, validLang);

const categoryKey = category.toLowerCase().replace(/\s+/g, '-');

const isCompiler = categoryKey === 'compiler-tools';
const isImageTool = categoryKey === 'image-tools';
const isPdfTool = categoryKey === 'pdf-tools';
const isTimetable = categoryKey === 'time-table-tools';
const isHealth = categoryKey === 'health';
const isFinance = categoryKey === 'finance';
const isConstruction = categoryKey === 'construction';

// Localized tool kinds
const toolKindMap: Record<Locale, { Calculator: string; Tool: string; Planner: string }> = {
  en: { Calculator: 'Calculator', Tool: 'Tool', Planner: 'Planner' },
  hi: { Calculator: 'कैलकुलेटर', Tool: 'टूल', Planner: 'प्लानर' },
  es: { Calculator: 'Calculadora', Tool: 'Herramienta', Planner: 'Planificador' },
  fr: { Calculator: 'Calculatrice', Tool: 'Outil', Planner: 'Planificateur' },
  de: { Calculator: 'Rechner', Tool: 'Tool', Planner: 'Planer' },
  it: { Calculator: 'Calcolatore', Tool: 'Strumento', Planner: 'Pianificatore' },
  pt: { Calculator: 'Calculadora', Tool: 'Ferramenta', Planner: 'Planejador' },
  ja: { Calculator: '計算ツール', Tool: 'ツール', Planner: 'プランナー' },
  ko: { Calculator: '계산기', Tool: '도구', Planner: '플래너' },
};

const rawKind = isCompiler ? 'Tool' : isImageTool ? 'Tool' : isPdfTool ? 'Tool' : isTimetable ? 'Planner' : 'Calculator';
const toolKind = (toolKindMap[validLang] || toolKindMap.en)[rawKind];

// Domain-specific intro fallback if translation has no custom intro
const categoryIntros: Record<string, string> = {
  finance: `Financial decisions require transparent, verified arithmetic. This ${calculatorName} applies standard financial formulas to evaluate your figures accurately, providing clear quantitative visibility for budgeting and planning.`,
  construction: `Civil and construction estimates demand reliable material and structural computations. This ${calculatorName} follows industry-standard engineering ratios to calculate quantities, dimensions, and project benchmarks.`,
  health: `Health tracking is most effective when grounded in validated biometric standards. This ${calculatorName} utilizes published physiological formulas to evaluate personal metrics and provide clear wellness benchmarks.`,
  math: `Mathematical calculations require precision and step-by-step transparency. This ${calculatorName} computes solutions instantly with verified algebraic principles.`,
  general: `This ${calculatorName} simplifies everyday numeric workflows, conversions, and quantitative tasks with instant, verified client-side computation.`,
  'free-online-tools': `Our browser-based ${calculatorName} processes your tasks locally with zero file uploads, providing fast, private, and accessible utility on any device.`,
  'image-tools': `This ${calculatorName} executes graphic processing directly within your web browser using HTML5 Canvas APIs, ensuring private, high-fidelity image output with zero server uploads.`,
  'pdf-tools': `This ${calculatorName} processes document tasks entirely on your local device. Enjoy private, reliable PDF manipulation without third-party cloud uploads.`,
  'time-table-tools': `Structuring daily and weekly commitments improves focus and consistency. This ${calculatorName} lets you create, customize, and print schedules directly in your web browser.`,
  'compiler-tools': `This ${calculatorName} provides an in-browser code editor and execution sandbox, allowing you to test syntax, practice algorithms, and inspect output instantly without local toolchain installation.`
};

function getLocalizedCategoryIntro(cat: string, name: string, lang: Locale): string {
  if (lang === 'hi') {
    if (cat === 'finance') return `वित्तीय निर्णयों के लिए सटीक और पारदर्शी गणना की आवश्यकता होती है। यह ${name} आपके बजट और वित्तीय नियोजन को स्पष्ट बनाने के लिए मानक वित्तीय सूत्रों का उपयोग करता है।`;
    if (cat === 'construction') return `निर्माण और सिविल कार्यों में सटीक सामग्री अनुमान आवश्यक होता है। यह ${name} सामग्री की मात्रा और संरचनात्मक आवश्यकताओं की सही गणना करता है।`;
    if (cat === 'health') return `स्वास्थ्य और फिटनेस ट्रैकिंग के लिए प्रमाणित बायोमेट्रिक मानकों की आवश्यकता होती है। यह ${name} व्यक्तिगत स्वास्थ्य संकेतकों का सटीक विश्लेषण करता है।`;
    return `यह ${name} दैनिक गणनाओं और संख्यात्मक कार्यों को तत्काल और सटीक रूप से हल करने के लिए डिज़ाइन किया गया है।`;
  }
  if (lang === 'es') {
    if (cat === 'finance') return `Las decisiones financieras requieren cálculos precisos y transparentes. Este ${name} aplica fórmulas financieras estándar para evaluar sus números con claridad.`;
    if (cat === 'construction') return `Las estimaciones de construcción demandan cálculos precisos de materiales. Este ${name} calcula cantidades y proporciones conforme a normas técnicas.`;
    if (cat === 'health') return `El seguimiento de la salud requiere mediciones biométricas validadas. Este ${name} evalúa parámetros personales con precisión.`;
    return `Este ${name} facilita cálculos numéricos diarios y conversiones con resultados instantáneos y verificados.`;
  }
  if (lang === 'ja') {
    if (cat === 'finance') return `資金計画や投資判断には透明性の高い数理モデルが必要です。この${name}は標準的な計算式を適用し正確な試算を提供します。`;
    if (cat === 'construction') return `土木・建築の見積もりには信頼できる資材計算が不可欠です。この${name}は標準工学基準に基づいて所要量を算出します。`;
    if (cat === 'health') return `健康管理には客観的な生体指標が役立ちます。この${name}は検証された生理学モデルに基づいて数値を算定します。`;
    return `この${name}は日常的な数値計算や単位換算をブラウザ上で即座かつ正確に実行します。`;
  }
  if (lang === 'de') {
    if (cat === 'finance') return `Finanzielle Entscheidungen erfordern transparente und genaue Berechnungen. Dieser ${name} wendet anerkannte Formeln für Ihre Planung an.`;
    if (cat === 'construction') return `Bau- und Mengenschätzungen verlangen verlässliche bautechnische Werte. Dieser ${name} berechnet Materialmengen präzise.`;
    if (cat === 'health') return `Gesundheitsvorsorge erfordert fundierte biometrische Orientierungswerte. Dieser ${name} ermittelt Richtwerte zuverlässig.`;
    return `Dieser ${name} ermöglicht schnelle, genaue und browserbasierte Berechnungen für den täglichen Bedarf.`;
  }
  if (lang === 'fr') {
    if (cat === 'finance') return `Les décisions financières reposent sur des calculs transparents. Cet outil ${name} applique les formules standards pour vos projections.`;
    if (cat === 'construction') return `Les devis et estimations de chantier exigent des ratios d'ingénierie fiables. Cet outil ${name} quantifie vos besoins en matériaux.`;
    if (cat === 'health') return `Le suivi de la forme requiert des repères biométriques validés. Cet outil ${name} analyse vos constantes avec rigueur.`;
    return `Cet outil ${name} simplifie vos opérations numériques quotidiennes grâce à des calculs immédiats et fiables.`;
  }
  if (lang === 'it') {
    if (cat === 'finance') return `Le decisioni finanziarie richiedono conteggi chiari e affidabili. Questo strumento ${name} impiega formule collaudate per le tue stime.`;
    if (cat === 'construction') return `Le stime edilizie richiedono parametri tecnici precisi. Questo strumento ${name} quantifica i materiali secondo regole dell'arte.`;
    if (cat === 'health') return `Il monitoraggio del benessere necessita di valori biometrici oggettivi. Questo strumento ${name} calcola i tuoi indici con accuratezza.`;
    return `Questo strumento ${name} esegue calcoli e conversioni quotidiane con riscontri numerici immediati.`;
  }
  if (lang === 'pt') {
    if (cat === 'finance') return `Decisões financeiras seguras exigem cálculos exatos e transparentes. Este ${name} utiliza fórmulas consagradas para o seu planejamento.`;
    if (cat === 'construction') return `Projetos de engenharia e obras demandam estimativas estruturais precisas. Este ${name} quantifica materiais com rigor.`;
    if (cat === 'health') return `O acompanhamento da saúde requer métricas biométricas confiáveis. Este ${name} avalia seus parâmetros de bem-estar.`;
    return `Este ${name} soluciona cálculos práticos e conversões rotineiras com rapidez e precisão matemática.`;
  }
  if (lang === 'ko') {
    if (cat === 'finance') return `금융 계획과 자산 관리는 투명한 수식에 기반해야 합니다. 본 ${name}은(는) 신뢰할 수 있는 공식을 적용하여 지표를 산출합니다.`;
    if (cat === 'construction') return `건축 및 토목 공사는 정확한 자재 산출이 기본입니다. 본 ${name}은(는) 표준 공학 기준에 맞춰 물량을 계산합니다.`;
    if (cat === 'health') return `건강 지표 관리는 과학적인 생체 측정 기준이 핵심입니다. 본 ${name}은(는) 입증된 공식을 통해 지수를 분석합니다.`;
    return `본 ${name}은(는) 일상 및 업무에서 필요한 수치 계산을 브라우저에서 즉시 정확하게 처리합니다.`;
  }
  return categoryIntros[cat] || categoryIntros.general;
}

const rawIntro = (translation?.intro || translation?.shortDescription || translation?.description || '').trim();
const introText = (validLang !== 'en' && rawIntro && translation?.status === 'translated')
  ? rawIntro
  : (rawIntro || getLocalizedCategoryIntro(categoryKey, calculatorName, validLang));
const formulaDesc = (translation?.formulaDescription && translation.formulaDescription !== translation.description && (validLang === 'en' || translation.status === 'translated')) ? translation.formulaDescription : null;

