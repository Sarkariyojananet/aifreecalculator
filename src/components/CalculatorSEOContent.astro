---
/**
 * SEO-Friendly Content Section for Calculator Pages
 * Adds valuable, natural content to help with AdSense approval
 * Provides helpful information without keyword stuffing
 */

interface Props {
  calculatorName: string;
  category: string;
  slug: string;
  lang?: string;
}

const { calculatorName, category, slug, lang = 'en' } = Astro.props;

// Content templates by category with natural, helpful text
const contentTemplates = {
  finance: {
    intro: "Understanding your finances is crucial for making informed decisions. This calculator helps you compute accurate figures quickly and easily, giving you clear insights into your financial planning.",
    howItWorks: "The calculator uses standard financial formulas to provide precise calculations. Simply enter your values, and the tool instantly processes the data to give you comprehensive results.",
    whyUse: "Using an online calculator saves time and reduces the risk of manual calculation errors. It's free, accessible anytime, and requires no installation or signup.",
    tips: "For best results, ensure you enter accurate values. Double-check your inputs, especially interest rates and time periods. You can save your calculations for future reference."
  },
  construction: {
    intro: "Construction planning requires accurate material estimates and structural calculations. This tool helps contractors, engineers, and homeowners make precise calculations for their building projects.",
    howItWorks: "Our calculator follows industry-standard engineering codes and formulas. Enter your project dimensions and specifications to get instant material estimates and structural requirements.",
    whyUse: "Accurate calculations prevent material wastage and ensure structural safety. Use this tool to get professional-grade estimates without complex manual calculations.",
    tips: "Always verify calculated values with on-site conditions. Consider adding 5-10% extra for material wastage. Consult a structural engineer for final approval on critical structures."
  },
  health: {
    intro: "Health tracking and fitness planning are easier with accurate calculations. This tool helps you understand your health metrics and set realistic wellness goals.",
    howItWorks: "The calculator uses medically recognized formulas and standards. Enter your measurements to receive instant health metrics and personalized recommendations.",
    whyUse: "Regular health monitoring helps you track progress and make informed lifestyle choices. This free tool provides quick assessments without needing medical equipment.",
    tips: "Use these calculations as general guidelines. For medical advice and personalized health plans, always consult qualified healthcare professionals."
  },
  math: {
    intro: "Mathematical calculations are essential for students, professionals, and everyday tasks. This calculator simplifies complex computations and provides step-by-step solutions.",
    howItWorks: "Enter your numbers or expressions, and the calculator applies proven mathematical principles to deliver accurate results instantly.",
    whyUse: "Whether you're studying, working, or solving daily problems, this tool makes math accessible and error-free. No installation needed—just open and calculate.",
    tips: "Understand the formulas behind the calculations to improve your math skills. Use the results to verify your manual work and build confidence in problem-solving."
  },
  general: {
    intro: "Daily calculations made simple. This versatile tool helps with common tasks like conversions, comparisons, and quick computations you need throughout the day.",
    howItWorks: "Select your input values and get instant results. The calculator handles the math so you can focus on using the information.",
    whyUse: "Save time on routine calculations. No need to search for formulas or use multiple tools—everything you need is here in one place.",
    tips: "Bookmark this page for quick access whenever you need it. All calculations run in your browser, keeping your data private and secure."
  },
  'free-online-tools': {
    intro: "Our free online tools make digital tasks easier. No downloads, no signups—just open your browser and start using powerful utilities instantly.",
    howItWorks: "Upload or enter your data, choose your options, and the tool processes everything locally in your browser. Your files never leave your device.",
    whyUse: "These tools are completely free and respect your privacy. Process files, generate content, and complete tasks without installing software or creating accounts.",
    tips: "All processing happens in your browser for maximum privacy. For best performance, use modern browsers like Chrome, Firefox, or Edge."
  }
};

const categoryKey = category.toLowerCase().replace(/\s+/g, '-');
const content = contentTemplates[categoryKey as keyof typeof contentTemplates] || contentTemplates.general;

// Additional features section
const features = [
  { icon: '⚡', title: 'Instant Results', desc: 'Get calculations in milliseconds with real-time updates as you type' },
  { icon: '🔒', title: 'Privacy First', desc: 'All calculations run in your browser—your data never leaves your device' },
  { icon: '📱', title: 'Works Anywhere', desc: 'Use on any device—desktop, tablet, or mobile—with a modern web browser' },
  { icon: '💯', title: 'Always Free', desc: 'No hidden costs, no subscriptions, no ads blocking functionality' },
  { icon: '🎯', title: 'Accurate Formulas', desc: 'Based on industry standards and verified mathematical principles' },
  { icon: '💾', title: 'Save & Share', desc: 'Download results as PDF or share calculations with colleagues' }
];
---

<div class="space-y-8">

  <!-- How to Use Section -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>📖</span> How to Use This {calculatorName}
    </h2>

    <div class="space-y-3 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      <p>{content.intro}</p>
      <p>{content.howItWorks}</p>
    </div>

    <div class="rounded-xl border border-blue-100 bg-blue-50/50 p-4 dark:border-blue-900/30 dark:bg-blue-950/20">
      <div class="flex items-start gap-3">
        <span class="text-2xl shrink-0">💡</span>
        <div class="space-y-1">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Pro Tips</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300">{content.tips}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Why Use This Calculator -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>✨</span> Why Use This Calculator?
    </h2>

    <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      {content.whyUse}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {features.map((feature) => (
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="flex items-start gap-2.5">
            <span class="text-xl shrink-0">{feature.icon}</span>
            <div>
              <h3 class="text-xs font-bold text-slate-900 dark:text-white">{feature.title}</h3>
              <p class="mt-0.5 text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">{feature.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Common Use Cases -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>🎯</span> Common Use Cases
    </h2>

    <div class="space-y-2">
      {categoryKey === 'finance' && (
        <>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Planning loan repayments and understanding interest costs over time</p>
          </div>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Comparing different loan offers to find the best deal for your needs</p>
          </div>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Budgeting monthly expenses and setting realistic financial goals</p>
          </div>
        </>
      )}

      {categoryKey === 'construction' && (
        <>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Estimating material quantities for construction and renovation projects</p>
          </div>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Calculating structural requirements for safe and compliant building design</p>
          </div>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Planning project budgets and preventing material wastage during construction</p>
          </div>
        </>
      )}

      {categoryKey === 'health' && (
        <>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Tracking fitness progress and setting achievable health goals</p>
          </div>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Understanding nutritional needs and planning balanced meal plans</p>
          </div>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Monitoring health metrics as part of a wellness routine or medical advice</p>
          </div>
        </>
      )}

      {(categoryKey === 'math' || categoryKey === 'general') && (
        <>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Solving homework problems and verifying manual calculations quickly</p>
          </div>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Handling everyday tasks like conversions, comparisons, and measurements</p>
          </div>
          <div class="flex items-start gap-2 text-sm">
            <span class="text-blue-600 dark:text-blue-400 shrink-0">•</span>
            <p class="text-slate-700 dark:text-slate-300">Completing work projects that require quick and accurate computations</p>
          </div>
        </>
      )}
    </div>
  </div>

  <!-- Important Notes -->
  <div class="rounded-xl border border-amber-200 bg-amber-50/50 p-4 dark:border-amber-900/30 dark:bg-amber-950/20">
    <div class="flex items-start gap-3">
      <span class="text-2xl shrink-0">⚠️</span>
      <div class="space-y-2">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Important Notes</h3>
        <div class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
          <p>• Results are based on standard formulas and should be used as estimates</p>
          {categoryKey === 'finance' && (
            <p>• For legal financial advice or large investments, consult a certified financial advisor</p>
          )}
          {categoryKey === 'construction' && (
            <p>• Always verify calculations with a licensed structural engineer before construction</p>
          )}
          {categoryKey === 'health' && (
            <p>• These calculations are for informational purposes—consult healthcare professionals for medical advice</p>
          )}
          <p>• Double-check all input values to ensure accurate results</p>
          <p>• Save or download your calculations for future reference and record-keeping</p>
        </div>
      </div>
    </div>
  </div>

</div>

<style>
  /* Ensure proper text styling */
  p {
    line-height: 1.6;
  }

  h2, h3 {
    line-height: 1.3;
  }
</style>
