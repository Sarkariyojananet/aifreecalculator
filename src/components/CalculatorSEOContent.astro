const rawKind = isCompiler ? 'Tool' : isImageTool ? 'Tool' : isPdfTool ? 'Tool' : isTimetable ? 'Planner' : 'Calculator';
const toolKind = (toolKindMap[validLang] || toolKindMap.en)[rawKind];

