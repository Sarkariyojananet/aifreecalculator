---
interface Props {
  className?: string;
  slotId?: string;
}

const { className = '', slotId = '' } = Astro.props;
---

<aside
  aria-label="Advertisement"
  data-ad-slot-location="sidebar"
  data-prop-slot-id={slotId}
  style="display: none;"
  class={`w-full overflow-hidden text-center transition-all ${className}`}
>
  <div class="text-[10px] uppercase font-semibold text-slate-400 tracking-wider mb-1 select-none">
    Sponsored
  </div>
  <div class="ad-content-slot min-h-[250px] max-h-[600px] w-full flex items-center justify-center">
  </div>
</aside>


