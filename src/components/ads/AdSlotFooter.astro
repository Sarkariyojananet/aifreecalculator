---
interface Props {
  className?: string;
  slotId?: string;
}

const { className = '', slotId = '' } = Astro.props;
---

<aside
  aria-label="Advertisement"
  data-ad-slot-location="footer"
  data-prop-slot-id={slotId}
  style="display: none;"
  class={`w-full max-w-5xl mx-auto my-6 overflow-hidden text-center transition-all ${className}`}
>

  <div class="text-[10px] uppercase font-semibold text-slate-400 tracking-wider mb-1 select-none">
    Advertisement
  </div>
  <div class="ad-content-slot min-h-22.5 w-full flex items-center justify-center">
  </div>
</aside>

