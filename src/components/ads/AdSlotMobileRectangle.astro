---
interface Props {
  className?: string;
  slotId?: string;
}

const { className = '', slotId = '' } = Astro.props;
---

<aside
  aria-label="Advertisement"
  data-ad-slot-location="mobile-rectangle"
  data-prop-slot-id={slotId}
  style="display: none;"
  hidden
  class={`hidden w-full my-4 transition-all ${className}`}
>
  <div class="ad-content-slot flex items-center justify-center w-full min-h-35">
  </div>
</aside>
