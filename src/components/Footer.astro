---
import { categories } from '../data/calculators';
import { extractLocaleFromPath, getLocalizedPath } from '../i18n/utils';
import { getCommonTranslations } from '../i18n/translations/common';
import { CATEGORIES_CONFIG } from '../i18n/translations/categories';
import { getCalculatorTranslation } from '../i18n/translations/calculators';
import { isValidLocale, DEFAULT_LOCALE, type Locale } from '../i18n/config';

interface Props {
  lang?: Locale;
}

const { lang: propLang } = Astro.props;
const localsLang = (Astro.locals as any)?.locale;
const originalPath = (Astro.locals as any)?.originalPath;
const currentPath = originalPath || Astro.url.pathname;
const urlQueryLang = Astro.url.searchParams.get('lang');
const { lang: pathLang } = extractLocaleFromPath(currentPath);
const candidateLang = propLang || (localsLang && isValidLocale(localsLang) ? (localsLang as Locale) : null) || (urlQueryLang && isValidLocale(urlQueryLang) ? (urlQueryLang as Locale) : null) || pathLang;
const lang: Locale = isValidLocale(candidateLang) ? candidateLang : DEFAULT_LOCALE;
const tCommon = getCommonTranslations(lang);
const currentYear = new Date().getFullYear();

const homeHref = getLocalizedPath('/', lang);

const popularCalculators = [
  { name: getCalculatorTranslation('emi-calculator', lang).name, href: getLocalizedPath('/finance/emi-calculator/', lang) },
  { name: getCalculatorTranslation('sip-calculator', lang).name, href: getLocalizedPath('/finance/sip-calculator/', lang) },
  { name: getCalculatorTranslation('bmi-calculator', lang).name, href: getLocalizedPath('/general/bmi-calculator/', lang) },
  { name: getCalculatorTranslation('age-calculator', lang).name, href: getLocalizedPath('/general/age-calculator/', lang) },
  { name: getCalculatorTranslation('calorie-calculator', lang).name, href: getLocalizedPath('/health/calorie-calculator/', lang) },
  { name: getCalculatorTranslation('rcc-slab-steel-calculator', lang).name, href: getLocalizedPath('/construction/rcc-slab-steel-calculator/', lang) },
];

const companyLinks = [
  { name: tCommon.nav.about, href: getLocalizedPath('/about/', lang) },
  { name: tCommon.nav.contact, href: getLocalizedPath('/contact/', lang) },
  { name: tCommon.nav.allCalculators, href: getLocalizedPath('/all-calculators/', lang) },
];

const legalLinks = [
  { name: tCommon.footer.privacy, href: getLocalizedPath('/privacy-policy/', lang) },
  { name: tCommon.footer.terms, href: getLocalizedPath('/terms/', lang) },
  { name: tCommon.footer.disclaimer, href: getLocalizedPath('/disclaimer/', lang) },
];
---

<footer class="border-t border-slate-200 bg-slate-50 text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    
    <!-- Main Footer Columns -->
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
      
      <!-- 1. Brand Section -->
      <div class="space-y-3 sm:col-span-2 lg:col-span-1">
        <a
          href={homeHref}
          class="inline-flex items-center gap-2 text-slate-900 dark:text-white"
          aria-label="AIFreeCalculator.com Home"
        >
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-blue-600 font-bold text-xs text-white shadow-xs">
            AI
          </div>
          <span class="text-base font-bold tracking-tight text-slate-900 dark:text-white">
            AI Free Calculator
          </span>
        </a>

        <p class="text-xs sm:text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          {tCommon.tagline}
        </p>
      </div>

      <!-- 2. Calculator Categories -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          {tCommon.footer.categoriesTitle}
        </h3>
        <nav aria-label="Calculator categories">
          <ul class="space-y-2 text-xs sm:text-sm">
            {categories.map((cat) => {
              const catKey = cat.name.toLowerCase() as keyof typeof CATEGORIES_CONFIG;
              const catName = CATEGORIES_CONFIG[catKey]?.names[lang];
              if (!catName) throw new Error(`[i18n] Missing category name for ${catKey} in ${lang}`);
              return (
                <li>
                  <a
                    href={getLocalizedPath(cat.path, lang)}
                    class="transition hover:text-slate-900 dark:hover:text-white"
                  >
                    {catName}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>

      <!-- 3. Popular Calculators -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          {tCommon.sections.popularTools}
        </h3>
        <nav aria-label="Popular calculators">
          <ul class="space-y-2 text-xs sm:text-sm">
            {popularCalculators.map((calc) => (
              <li>
                <a
                  href={calc.href}
                  class="transition hover:text-slate-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  {calc.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- 4. Company -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          {tCommon.footer.quickLinks}
        </h3>
        <nav aria-label="Company">
          <ul class="space-y-2 text-xs sm:text-sm">
            {companyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition hover:text-slate-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- 5. Legal -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          {tCommon.footer.legalTitle}
        </h3>
        <nav aria-label="Legal">
          <ul class="space-y-2 text-xs sm:text-sm">
            {legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition hover:text-slate-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

    </div>

    <!-- Small Subtle Informational Disclaimer -->
    <div class="mt-10 pt-6 border-t border-slate-200/80 dark:border-slate-800/80 text-[11px] text-slate-500 dark:text-slate-400 text-center sm:text-left">
      {tCommon.footer.freeNotice}
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="mt-4 pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-xs text-slate-500 dark:text-slate-400">
      <div>
        © {currentYear} AIFreeCalculator.com. {tCommon.footer.allRightsReserved}
      </div>
      <div>
        {tCommon.tagline}
      </div>
    </div>

  </div>
</footer>
