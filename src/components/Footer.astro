---
import { categories } from '../data/calculators';

const currentYear = new Date().getFullYear();

const popularCalculators = [
  { name: 'EMI Calculator', href: '/finance/emi-calculator/' },
  { name: 'SIP Calculator', href: '/finance/sip-calculator/' },
  { name: 'Percentage Calculator', href: '/general/percentage-calculator/' },
  { name: 'GST Calculator', href: '/finance/gst-calculator/' },
  { name: 'BMR Calculator', href: '/health/bmr-calculator/' },
  { name: 'Steel Weight Calculator', href: '/construction/steel-weight-calculator/' },
];

const companyLinks = [
  { name: 'About Us', href: '/about/' },
  { name: 'Contact Us', href: '/contact/' },
  { name: 'All Calculators', href: '/#all-calculators' },
];

const legalLinks = [
  { name: 'Privacy Policy', href: '/privacy-policy/' },
  { name: 'Terms of Use', href: '/terms/' },
  { name: 'Disclaimer', href: '/disclaimer/' },
];
---

<footer class="border-t border-slate-200 bg-slate-50 text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    
    <!-- Main Footer Columns -->
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
      
      <!-- 1. Brand Section -->
      <div class="space-y-4 sm:col-span-2 lg:col-span-1">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 text-slate-900 dark:text-white rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
          aria-label="AIFreeCalculator.com Home"
        >
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 font-bold text-white shadow-xs">
            AI
          </div>
          <span class="font-bold text-lg tracking-tight">
            AIFree<span class="text-blue-600 dark:text-blue-400">Calculator</span>.com
          </span>
        </a>

        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-300">
          Free online calculators for finance, health, construction, education, conversions and everyday calculations.
        </p>

        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          Need a calculator that isn't available yet? <a href="/contact/" class="text-blue-600 hover:underline dark:text-blue-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-xs">Contact us</a>.
        </p>
      </div>

      <!-- 2. Calculator Categories -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Calculators
        </h3>
        <nav aria-label="Calculator categories">
          <ul class="space-y-2 text-xs sm:text-sm">
            {categories.map((cat) => (
              <li>
                <a
                  href={cat.path}
                  class="transition hover:text-slate-900 dark:hover:text-white flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  <span aria-hidden="true">{cat.icon}</span>
                  <span>{cat.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- 3. Popular Calculators -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Popular Calculators
        </h3>
        <nav aria-label="Popular calculators">
          <ul class="space-y-2 text-xs sm:text-sm">
            {popularCalculators.map((calc) => (
              <li>
                <a
                  href={calc.href}
                  class="transition hover:text-slate-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  {calc.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- 4. Company -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Company
        </h3>
        <nav aria-label="Company">
          <ul class="space-y-2 text-xs sm:text-sm">
            {companyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition hover:text-slate-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- 5. Legal -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Legal
        </h3>
        <nav aria-label="Legal">
          <ul class="space-y-2 text-xs sm:text-sm">
            {legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition hover:text-slate-900 dark:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

    </div>

    <!-- Small Subtle Informational Disclaimer -->
    <div class="mt-10 pt-6 border-t border-slate-200/80 dark:border-slate-800/80 text-[11px] text-slate-500 dark:text-slate-400 text-center sm:text-left">
      Calculator results are estimates based on the information provided. Please verify important financial, health, construction, or professional decisions when necessary.
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="mt-4 pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-xs text-slate-500 dark:text-slate-400">
      <div>
        © {currentYear} AIFreeCalculator.com. All rights reserved.
      </div>
      <div>
        Free online tools for everyday calculations.
      </div>
    </div>

  </div>
</footer>
