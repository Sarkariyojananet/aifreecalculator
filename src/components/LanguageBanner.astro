---
/**
 * Language Selection Confirmation Banner
 * Shows a subtle notification when user switches language
 * Allows setting preferred language permanently
 */
import { DEFAULT_LOCALE, LOCALES_MAP, type Locale } from '../i18n/config';
import { getCommonTranslations } from '../i18n/translations/common';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tCommon = getCommonTranslations(lang);
const currentLocaleInfo = LOCALES_MAP[lang];

// Messages for different languages
const bannerMessages: Record<Locale, { viewing: string; setDefault: string; dismiss: string }> = {
  en: {
    viewing: 'You are viewing this site in English',
    setDefault: 'Always use English',
    dismiss: 'Dismiss'
  },
  hi: {
    viewing: 'आप यह साइट हिन्दी में देख रहे हैं',
    setDefault: 'हमेशा हिन्दी का उपयोग करें',
    dismiss: 'बंद करें'
  },
  es: {
    viewing: 'Estás viendo este sitio en Español',
    setDefault: 'Usar siempre Español',
    dismiss: 'Cerrar'
  },
  ja: {
    viewing: 'このサイトを日本語で表示しています',
    setDefault: '常に日本語を使用',
    dismiss: '閉じる'
  },
  fr: {
    viewing: 'Vous consultez ce site en Français',
    setDefault: 'Toujours utiliser le Français',
    dismiss: 'Fermer'
  },
  de: {
    viewing: 'Sie sehen diese Seite auf Deutsch',
    setDefault: 'Immer Deutsch verwenden',
    dismiss: 'Schließen'
  },
  pt: {
    viewing: 'Você está visualizando este site em Português',
    setDefault: 'Sempre usar Português',
    dismiss: 'Fechar'
  },
  ko: {
    viewing: '이 사이트를 한국어로 보고 계십니다',
    setDefault: '항상 한국어 사용',
    dismiss: '닫기'
  },
  it: {
    viewing: 'Stai visualizzando questo sito in Italiano',
    setDefault: 'Usa sempre Italiano',
    dismiss: 'Chiudi'
  }
};

const message = bannerMessages[lang];
---

<!-- Language Confirmation Banner (Hidden by default, shown on language switch) -->
<div
  id="language-banner"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden animate-in slide-in-from-bottom-4 duration-300"
  role="status"
  aria-live="polite"
>
  <div class="mx-4 max-w-md rounded-2xl border border-slate-200 bg-white/95 backdrop-blur-sm px-4 py-3 shadow-xl dark:border-slate-800 dark:bg-slate-900/95">
    <div class="flex items-center gap-3">
      <span class="text-2xl shrink-0 flag-hover">{currentLocaleInfo.flag}</span>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-slate-900 dark:text-white">
          {message.viewing}
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="lang-banner-set-default"
          class="text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition cursor-pointer whitespace-nowrap"
          data-lang={lang}
        >
          {message.setDefault}
        </button>
        <button
          type="button"
          id="lang-banner-dismiss"
          class="rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-200 transition cursor-pointer"
          aria-label={message.dismiss}
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function initLanguageBanner() {
    const banner = document.getElementById('language-banner');
    const btnSetDefault = document.getElementById('lang-banner-set-default');
    const btnDismiss = document.getElementById('lang-banner-dismiss');

    if (!banner || !btnSetDefault || !btnDismiss) return;

    const currentLang = btnSetDefault.getAttribute('data-lang') || document.documentElement.lang || 'en';
    const isDefaultLang = currentLang === 'en';

    // Check if user just switched language (via sessionStorage flag)
    const justSwitched = sessionStorage.getItem('lang_just_switched');
    const preferredLang = localStorage.getItem('preferred_locale');
    const languagePrefSet = localStorage.getItem('language_pref_set');

    // Show banner if:
    // 1. User just switched language, OR
    // 2. Non-English page and no preference set yet
    if (justSwitched === 'true' || (!isDefaultLang && !languagePrefSet && !preferredLang)) {
      setTimeout(() => {
        banner.classList.remove('hidden');
        sessionStorage.removeItem('lang_just_switched');
      }, 500);

      // Auto-hide after 8 seconds
      setTimeout(() => {
        hideBanner();
      }, 8000);
    }

    function hideBanner() {
      if (!banner) return;
      banner.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => {
        banner?.classList.add('hidden');
        banner?.classList.remove('opacity-0', 'translate-y-2');
      }, 300);
    }

    // Set as default language preference
    btnSetDefault.addEventListener('click', () => {
      try {
        localStorage.setItem('preferred_locale', currentLang);
        localStorage.setItem('language_pref_set', 'true');
        document.cookie = `preferred_locale=${currentLang}; path=/; max-age=31536000; SameSite=Lax`;

        // Show success feedback
        btnSetDefault.textContent = '✓ ' + btnSetDefault.textContent;
        btnSetDefault.classList.add('text-emerald-600', 'dark:text-emerald-400');

        setTimeout(hideBanner, 1500);
      } catch (e) {
        console.error('Failed to save language preference:', e);
      }
    });

    // Dismiss banner
    btnDismiss.addEventListener('click', hideBanner);

    // Mark that user switched language (for next page load)
    document.querySelectorAll('[data-locale-code]').forEach((link) => {
      link.addEventListener('click', () => {
        sessionStorage.setItem('lang_just_switched', 'true');
      });
    });
  })();
</script>
