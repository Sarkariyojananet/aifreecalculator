---
import type { CalculatorHealthSummary } from '../../lib/calculator-tests/types';

interface Props {
  health: CalculatorHealthSummary;
}

const { health } = Astro.props;

const statusStyles = {
  Healthy: {
    badge: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800',
    dot: 'bg-emerald-500',
    label: 'Healthy',
  },
  'Needs Review': {
    badge: 'bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300 border-amber-200 dark:border-amber-800',
    dot: 'bg-amber-500',
    label: 'Needs Review',
  },
  Critical: {
    badge: 'bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300 border-red-200 dark:border-red-800',
    dot: 'bg-red-500',
    label: 'Critical / Broken',
  },
  Unknown: {
    badge: 'bg-slate-50 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700',
    dot: 'bg-slate-400',
    label: 'Untested',
  },
};

const currentStyle = statusStyles[health.healthStatus] || statusStyles.Unknown;
---

<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900/90 flex flex-col justify-between space-y-4 hover:border-blue-300 dark:hover:border-blue-700 transition">
  <div class="space-y-3">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-xl shrink-0">{health.icon || '🧮'}</span>
          <h4 class="text-sm font-bold text-slate-900 dark:text-white truncate">
            {health.name}
          </h4>
        </div>
        <div class="flex items-center gap-2 mt-1">
          <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
            {health.category}
          </span>
          <span class="text-[11px] font-mono text-slate-400 truncate max-w-[140px]">
            /{health.slug}/
          </span>
        </div>
      </div>

      <div class="text-right shrink-0">
        <span class={`inline-flex items-center gap-1.5 rounded-xl border px-2.5 py-1 text-xs font-black ${currentStyle.badge}`}>
          <span class={`h-2 w-2 rounded-full ${currentStyle.dot}`}></span>
          {currentStyle.label}
        </span>
      </div>
    </div>

    <!-- Diagnostic Details -->
    <div class="space-y-1.5 pt-1 text-xs">
      <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
        <span class="text-slate-400">Formula Tests:</span>
        <span class="font-mono font-bold">
          {health.testTotal !== undefined ? (
            <span class={health.testPassed === health.testTotal ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400'}>
              {health.testPassed}/{health.testTotal} Passed
            </span>
          ) : (
            <span class="text-slate-400 italic">No tests run</span>
          )}
        </span>
      </div>

      <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
        <span class="text-slate-400">Runtime Errors:</span>
        <span class="font-mono font-bold">
          {health.unreviewedErrors > 0 ? (
            <span class="text-red-600 dark:text-red-400">
              ⚠️ {health.unreviewedErrors} unreviewed
            </span>
          ) : (
            <span class="text-emerald-600 dark:text-emerald-400">0 logged</span>
          )}
        </span>
      </div>

      {health.lastTestedAt && (
        <div class="flex items-center justify-between text-[11px] text-slate-400">
          <span>Last Verified:</span>
          <span>{new Date(health.lastTestedAt).toLocaleDateString()}</span>
        </div>
      )}

      {health.healthReason && (
        <div class="text-[11px] text-slate-500 dark:text-slate-400 pt-1 line-clamp-2 italic">
          {health.healthReason}
        </div>
      )}
    </div>
  </div>

  <!-- Actions -->
  <div class="border-t border-slate-100 pt-3 dark:border-slate-800 flex items-center justify-between text-xs font-bold">
    <a
      href={`/admin/calculator-health/${health.slug}/`}
      class="text-blue-600 hover:underline dark:text-blue-400 inline-flex items-center gap-1"
    >
      <span>Diagnostics & Details</span> →
    </a>
    <a
      href={`/${health.category.toLowerCase()}/${health.slug}/`}
      target="_blank"
      class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
    >
      Open Tool ↗
    </a>
  </div>
</div>
