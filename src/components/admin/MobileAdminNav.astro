---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavItem {
  id: string;
  label: string;
  icon: string;
  path: string;
  badge?: string;
}

interface NavGroup {
  title: string;
  items: NavItem[];
}

const navGroups: NavGroup[] = [
  {
    title: 'CORE',
    items: [
      { id: 'dashboard', label: 'Dashboard', icon: '📊', path: '/admin/dashboard/' },
    ],
  },
  {
    title: 'CALCULATORS',
    items: [
      { id: 'calculators', label: 'All Calculators', icon: '🧮', path: '/admin/calculators/', badge: '42+' },
      { id: 'calculator-health', label: 'Calculator Health', icon: '🛡️', path: '/admin/calculator-health/', badge: 'Monitor' },
      { id: 'calculator-new', label: 'Add Calculator', icon: '➕', path: '/admin/calculators/new/' },
      { id: 'categories', label: 'Categories', icon: '📂', path: '/admin/categories/' },
    ],
  },
  {
    title: 'CONTENT',
    items: [
      { id: 'messages', label: 'Inbox & Messages', icon: '📬', path: '/admin/messages/', badge: 'Support' },
      { id: 'faqs', label: 'FAQ Manager', icon: '❓', path: '/admin/faqs/' },
      { id: 'homepage', label: 'Homepage Sections', icon: '🏠', path: '/admin/homepage/' },
    ],
  },
  {
    title: 'SEO & TOOLS',
    items: [
      { id: 'seo', label: 'SEO Intelligence', icon: '🩺', path: '/admin/seo/', badge: 'Audit' },
      { id: 'seo-bulk', label: 'Bulk Meta Editor', icon: '📝', path: '/admin/seo/bulk/' },
      { id: 'schema', label: 'Schema Manager', icon: '⚡', path: '/admin/schema/' },
      { id: 'redirects', label: 'Redirects (301/302)', icon: '🔀', path: '/admin/redirects/' },
      { id: 'internal-links', label: 'Internal Links', icon: '🔗', path: '/admin/internal-links/' },
    ],
  },
  {
    title: 'ANALYTICS',
    items: [
      { id: 'analytics', label: 'Usage & Stats', icon: '📈', path: '/admin/analytics/' },
    ],
  },
  {
    title: 'SETTINGS',
    items: [
      { id: 'settings', label: 'Ad & Monetization', icon: '📢', path: '/admin/settings/' },
      { id: 'features', label: 'Feature Flags', icon: '🎛️', path: '/admin/settings/features/' },
    ],
  },
];
---

<!-- Mobile Drawer Backdrop Overlay -->
<div
  id="mobile-drawer-backdrop"
  class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 hidden lg:hidden opacity-0"
  aria-hidden="true"
></div>

<!-- Mobile Slide-In Drawer Navigation (Left) -->
<aside
  id="mobile-admin-drawer"
  class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] transform -translate-x-full bg-white dark:bg-slate-900 shadow-2xl transition-transform duration-300 ease-in-out lg:hidden flex flex-col justify-between"
  aria-label="Mobile Administration Navigation"
  role="dialog"
  aria-modal="true"
>
  <div class="flex flex-col h-full overflow-hidden">
    
    <!-- Drawer Header -->
    <div class="flex h-16 items-center justify-between border-b border-slate-200 px-5 dark:border-slate-800 shrink-0">
      <a href="/admin/dashboard/" class="flex items-center gap-2.5">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-blue-600 font-bold text-white text-xs">
          AI
        </div>
        <span class="text-sm font-black text-slate-900 dark:text-white tracking-tight">
          Calculator<span class="text-blue-600 dark:text-blue-400">CMS</span>
        </span>
      </a>

      <button
        id="btn-close-mobile-drawer"
        type="button"
        aria-label="Close navigation drawer"
        class="rounded-xl p-2 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 dark:text-slate-400 cursor-pointer"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation List -->
    <div class="flex-1 overflow-y-auto px-4 py-4 space-y-5 scrollbar-thin">
      {navGroups.map((group) => (
        <div class="space-y-1">
          <div class="px-2 text-[10px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500">
            {group.title}
          </div>
          <div class="space-y-0.5 pt-1">
            {group.items.map((item) => {
              const isActive = currentPath === item.path || (item.path !== '/admin/dashboard/' && currentPath.startsWith(item.path));
              return (
                <a
                  href={item.path}
                  class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-semibold transition ${
                    isActive
                      ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/20'
                      : 'text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800'
                  }`}
                >
                  <div class="flex items-center gap-3">
                    <span class="text-base">{item.icon}</span>
                    <span>{item.label}</span>
                  </div>
                  {item.badge && (
                    <span class={`rounded px-1.5 py-0.5 text-[9px] font-bold ${isActive ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300'}`}>
                      {item.badge}
                    </span>
                  )}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Drawer Bottom Actions -->
    <div class="border-t border-slate-200 p-4 dark:border-slate-800 space-y-2 bg-slate-50/70 dark:bg-slate-950/40 shrink-0">
      <a
        href="/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
      >
        <span>🌐 Live Site ↗</span>
        <span class="text-[10px] text-slate-400">Public</span>
      </a>

      <button
        id="btn-mobile-logout"
        type="button"
        class="w-full flex items-center justify-center gap-2 rounded-xl bg-red-50 py-2.5 text-xs font-bold text-red-600 dark:bg-red-950/40 dark:text-red-400"
      >
        <span>🚪</span> Sign Out
      </button>
    </div>

  </div>
</aside>
