---
import { calculators } from '../../data/calculators';

const searchItems = [
  // Admin Sections
  { title: 'Dashboard', category: 'Admin Area', path: '/admin/dashboard/', icon: '📊' },
  { title: 'AI Website Intelligence Hub', category: 'Admin Area', path: '/admin/intelligence/', icon: '🧠' },
  { title: 'All Calculators (42+)', category: 'Admin Area', path: '/admin/calculators/', icon: '🧮' },
  { title: 'Calculator Health & Reliability', category: 'Admin Area', path: '/admin/calculator-health/', icon: '🛡️' },
  { title: 'Calculator Health Test Suite', category: 'Admin Area', path: '/admin/calculator-health/tests/', icon: '🧪' },
  { title: 'Calculator Runtime Errors', category: 'Admin Area', path: '/admin/calculator-health/errors/', icon: '⚠️' },
  { title: 'Add New Calculator', category: 'Admin Area', path: '/admin/calculators/new/', icon: '➕' },
  { title: 'Categories Manager', category: 'Admin Area', path: '/admin/categories/', icon: '📂' },
  { title: 'Inbox & Messages', category: 'Admin Area', path: '/admin/messages/', icon: '📬' },
  { title: 'FAQ Manager', category: 'Admin Area', path: '/admin/faqs/', icon: '❓' },
  { title: 'Homepage Sections', category: 'Admin Area', path: '/admin/homepage/', icon: '🏠' },
  { title: 'SEO Health Diagnostics', category: 'Admin Area', path: '/admin/seo-health/', icon: '🩺' },
  { title: 'SEO Intelligence Dashboard', category: 'Admin Area', path: '/admin/seo/', icon: '🩺' },
  { title: 'Bulk SEO Meta Editor', category: 'Admin Area', path: '/admin/seo/bulk/', icon: '📝' },
  { title: 'Duplicate Content Inspector', category: 'Admin Area', path: '/admin/seo/duplicates/', icon: '👯' },
  { title: 'Internal Link & Orphan Audit', category: 'Admin Area', path: '/admin/seo/links/', icon: '🔗' },
  { title: 'Sitemap & Schema Validator', category: 'Admin Area', path: '/admin/seo/sitemap-schema/', icon: '🗺️' },
  { title: 'SEO Change History', category: 'Admin Area', path: '/admin/seo/history/', icon: '📜' },
  { title: 'Schema Manager', category: 'Admin Area', path: '/admin/schema/', icon: '⚡' },
  { title: 'Redirects (301/302)', category: 'Admin Area', path: '/admin/redirects/', icon: '🔀' },
  { title: 'Internal Links', category: 'Admin Area', path: '/admin/internal-links/', icon: '🔗' },
  { title: 'Site Monitoring & Uptime', category: 'Admin Area', path: '/admin/monitoring/', icon: '🛡️' },
  { title: 'CDN Cache & Performance', category: 'Admin Area', path: '/admin/performance/', icon: '⚡' },
  { title: 'AdSense & Monetization Analytics', category: 'Admin Area', path: '/admin/monetization/', icon: '💰' },
  { title: 'Ad & Monetization Settings', category: 'Admin Area', path: '/admin/settings/', icon: '📢' },
  { title: 'Feature Flags & Controls', category: 'Admin Area', path: '/admin/settings/features/', icon: '🎛️' },
  // Calculators
  ...calculators.map((c) => ({
    title: c.name,
    category: `${c.category} Calculator`,
    path: `/admin/calculators/new/?edit=${c.slug}`,
    icon: c.icon,
  })),
];

const searchDataJson = JSON.stringify(searchItems);
---

<div
  id="admin-search-modal"
  class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs p-4 sm:p-6 md:p-20 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="admin-search-title"
>
  <div class="mx-auto max-w-2xl transform rounded-3xl border border-slate-200 bg-white shadow-2xl transition-all dark:border-slate-800 dark:bg-slate-900 overflow-hidden">
    
    <!-- Search Input Box -->
    <div class="relative flex items-center border-b border-slate-200 px-4 dark:border-slate-800">
      <svg class="h-5 w-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <input
        type="text"
        id="admin-modal-search-input"
        class="w-full bg-transparent px-3 py-4 text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:outline-hidden dark:text-white"
        placeholder="Search calculators, SEO tools, FAQs, or settings..."
        autocomplete="off"
      />
      <button
        type="button"
        id="btn-close-admin-search"
        class="rounded-lg p-1.5 text-xs font-bold text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-200"
      >
        ESC
      </button>
    </div>

    <!-- Live Search Results List -->
    <div id="admin-search-results-container" class="max-h-80 overflow-y-auto p-2 divide-y divide-slate-100 dark:divide-slate-800/60">
      <!-- Populated by JS -->
    </div>

    <!-- Footer Hint -->
    <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50 px-4 py-2.5 text-[11px] text-slate-400 dark:border-slate-800 dark:bg-slate-950">
      <div class="flex items-center gap-3">
        <span><kbd class="rounded border border-slate-300 px-1 py-0.5 font-mono text-[9px] dark:border-slate-700">↑</kbd> <kbd class="rounded border border-slate-300 px-1 py-0.5 font-mono text-[9px] dark:border-slate-700">↓</kbd> navigate</span>
        <span><kbd class="rounded border border-slate-300 px-1 py-0.5 font-mono text-[9px] dark:border-slate-700">↵</kbd> select</span>
      </div>
      <span>Admin Quick Switcher</span>
    </div>

  </div>
</div>

<script is:inline define:vars={{ searchDataJson }}>
  window.__ADMIN_SEARCH_DATA__ = JSON.parse(searchDataJson);
</script>
