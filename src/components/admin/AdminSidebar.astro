---
interface Props {
  currentPath?: string;
  activeSection?: string;
}

const { currentPath = Astro.url.pathname, activeSection = 'dashboard' } = Astro.props;

interface NavItem {
  id: string;
  label: string;
  icon: string;
  path: string;
  badge?: string;
  badgeColor?: string;
}

interface NavGroup {
  title: string;
  items: NavItem[];
}

const navGroups: NavGroup[] = [
  {
    title: 'CORE',
    items: [
      { id: 'dashboard', label: 'Dashboard', icon: '📊', path: '/admin/dashboard/' },
    ],
  },
  {
    title: 'CALCULATORS',
    items: [
      { id: 'calculators', label: 'All Calculators', icon: '🧮', path: '/admin/calculators/', badge: '42+' },
      { id: 'calculator-health', label: 'Calculator Health', icon: '🛡️', path: '/admin/calculator-health/', badge: 'Monitor', badgeColor: 'bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300' },
      { id: 'calculator-new', label: 'Add Calculator', icon: '➕', path: '/admin/calculators/new/' },
      { id: 'categories', label: 'Categories', icon: '📂', path: '/admin/categories/', badge: '5' },
    ],
  },
  {
    title: 'CONTENT',
    items: [
      { id: 'messages', label: 'Inbox & Messages', icon: '📬', path: '/admin/messages/' },
      { id: 'faqs', label: 'FAQ Manager', icon: '❓', path: '/admin/faqs/' },
      { id: 'homepage', label: 'Homepage Sections', icon: '🏠', path: '/admin/homepage/' },
    ],
  },
  {
    title: 'SEO & TOOLS',
    items: [
      { id: 'seo', label: 'SEO Intelligence', icon: '🩺', path: '/admin/seo/', badge: 'Audit', badgeColor: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300' },
      { id: 'seo-bulk', label: 'Bulk Meta Editor', icon: '📝', path: '/admin/seo/bulk/' },
      { id: 'schema', label: 'Schema Manager', icon: '⚡', path: '/admin/schema/' },
      { id: 'redirects', label: 'Redirects (301/302)', icon: '🔀', path: '/admin/redirects/' },
      { id: 'internal-links', label: 'Internal Links', icon: '🔗', path: '/admin/internal-links/' },
    ],
  },
  {
    title: 'ANALYTICS',
    items: [
      { id: 'analytics', label: 'Usage & Stats', icon: '📈', path: '/admin/analytics/' },
    ],
  },
  {
    title: 'SETTINGS',
    items: [
      { id: 'settings', label: 'Ad & Monetization', icon: '📢', path: '/admin/settings/' },
      { id: 'features', label: 'Feature Flags', icon: '🎛️', path: '/admin/settings/features/' },
    ],
  },
];

const allNavItems = navGroups.flatMap((g) => g.items);
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const activeItem = allNavItems
  .filter((item) => normalizedPath === item.path || (item.path !== '/admin/dashboard/' && normalizedPath.startsWith(item.path)))
  .sort((a, b) => b.path.length - a.path.length)[0];
const activeItemId = activeItem?.id ?? (normalizedPath.startsWith('/admin/dashboard') ? 'dashboard' : '');
---

<aside
  id="admin-sidebar"
  class="hidden lg:flex flex-col justify-between w-64 shrink-0 border-r border-slate-200/80 bg-white dark:border-slate-800/80 dark:bg-slate-900 transition-all duration-300 select-none z-30"
>
  <div class="flex flex-col h-full overflow-hidden">
    
    <!-- Brand Header -->
    <div class="flex h-16 items-center justify-between border-b border-slate-200/80 px-6 dark:border-slate-800/80 shrink-0">
      <a href="/admin/dashboard/" class="flex items-center gap-3 group">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 font-black text-white text-sm shadow-sm shadow-blue-500/30 group-hover:scale-105 transition-transform">
          AI
        </div>
        <div class="flex flex-col leading-tight">
          <span class="text-sm font-extrabold text-slate-900 dark:text-white tracking-tight">
            Calculator<span class="text-blue-600 dark:text-blue-400">CMS</span>
          </span>
          <span class="text-[10px] font-semibold text-slate-400 dark:text-slate-500">
            Control Center
          </span>
        </div>
      </a>
    </div>

    <!-- Navigation Scroll Area -->
    <div class="flex-1 overflow-y-auto px-4 py-4 space-y-6 scrollbar-thin">
      {navGroups.map((group) => (
        <div class="space-y-1">
          <div class="px-3 text-[10px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500">
            {group.title}
          </div>
          <div class="space-y-0.5 pt-1">
            {group.items.map((item) => {
              const isActive = item.id === activeItemId;
              return (
                <a
                  href={item.path}
                  class={`flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold transition-all ${
                    isActive
                      ? 'bg-blue-600 text-white shadow-sm shadow-blue-500/20 font-bold'
                      : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'
                  }`}
                >
                  <div class="flex items-center gap-2.5 truncate">
                    <span class="text-sm">{item.icon}</span>
                    <span class="truncate">{item.label}</span>
                  </div>
                  {item.id === 'messages' ? (
                    <span
                      id="sidebar-unread-badge"
                      class={`admin-messages-unread-badge hidden rounded-full px-2 py-0.5 text-[10px] font-black shrink-0 transition-colors shadow-xs ${
                        isActive
                          ? 'bg-white text-blue-700'
                          : 'bg-blue-600 text-white'
                      }`}
                      data-count="0"
                    >
                      0
                    </span>
                  ) : item.badge ? (
                    <span
                      class={`rounded-md px-1.5 py-0.5 text-[9px] font-extrabold shrink-0 ${
                        isActive
                          ? 'bg-white/20 text-white'
                          : item.badgeColor || 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300'
                      }`}
                    >
                      {item.badge}
                    </span>
                  ) : null}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Sidebar Footer -->
    <div class="border-t border-slate-200/80 p-4 dark:border-slate-800/80 space-y-2 shrink-0 bg-slate-50/50 dark:bg-slate-950/20">
      <a
        href="/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 shadow-2xs transition"
      >
        <span class="flex items-center gap-2">
          <span>🌐</span> View Live Website
        </span>
        <span class="text-xs text-slate-400">↗</span>
      </a>

      <button
        id="btn-sidebar-logout"
        type="button"
        class="w-full flex items-center justify-center gap-2 rounded-xl bg-red-50/80 py-2 text-xs font-bold text-red-600 hover:bg-red-100 dark:bg-red-950/30 dark:text-red-400 dark:hover:bg-red-950/60 transition cursor-pointer"
      >
        <span>🚪</span> Sign Out
      </button>
    </div>

  </div>
</aside>
