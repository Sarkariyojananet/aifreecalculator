---
interface ActionItem {
  title: string;
  desc: string;
  icon: string;
  path: string;
  color: string;
  tag: string;
}

const actions: ActionItem[] = [
  {
    title: 'Add New Calculator',
    desc: 'Register a new calculation engine with formula, SEO metadata, and category.',
    icon: '➕',
    path: '/admin/calculators/new/',
    color: 'from-blue-600 to-indigo-600 text-white',
    tag: 'Create',
  },
  {
    title: 'SEO Health Audit',
    desc: 'Inspect meta tags, keyword coverage, and structured data scores across 42+ tools.',
    icon: '🩺',
    path: '/admin/seo-health/',
    color: 'from-emerald-600 to-teal-600 text-white',
    tag: 'Analyze',
  },
  {
    title: 'FAQ Manager',
    desc: 'Update global FAQs and calculator-specific step-by-step mathematical answers.',
    icon: '❓',
    path: '/admin/faqs/',
    color: 'from-purple-600 to-pink-600 text-white',
    tag: 'Content',
  },
  {
    title: 'Schema Generator',
    desc: 'Preview and validate WebApplication & FAQPage JSON-LD structured schemas.',
    icon: '⚡',
    path: '/admin/schema/',
    color: 'from-amber-500 to-orange-600 text-white',
    tag: 'Rich Snippets',
  },
  {
    title: 'AdSense & Monetization',
    desc: 'Configure Google AdSense, 3rd-party ad scripts, and edit authorized ads.txt lines.',
    icon: '📢',
    path: '/admin/settings/',
    color: 'from-sky-600 to-blue-700 text-white',
    tag: 'Revenue',
  },
  {
    title: 'Feature Flags & Controls',
    desc: 'Toggle PDF downloads, share links, recently used tools, and user feedback.',
    icon: '🎛️',
    path: '/admin/settings/features/',
    color: 'from-slate-700 to-slate-900 text-white',
    tag: 'Config',
  },
];
---

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <div>
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
        <span>⚡</span> Quick Management Actions
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        Frequently used administration shortcuts and content tools
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {actions.map((act) => (
      <a
        href={act.path}
        class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-5 shadow-xs transition hover:border-blue-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between space-y-3 cursor-pointer"
      >
        <div class="flex items-center justify-between gap-2">
          <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100 text-xl dark:bg-slate-800 group-hover:scale-110 transition-transform">
            {act.icon}
          </span>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-extrabold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
            {act.tag}
          </span>
        </div>

        <div>
          <h4 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
            {act.title}
          </h4>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
            {act.desc}
          </p>
        </div>

        <div class="pt-1 flex items-center gap-1 text-xs font-bold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform">
          <span>Manage</span> <span>→</span>
        </div>
      </a>
    ))}
  </div>
</div>
