---
interface Props {
  title?: string;
  sectionTitle?: string;
  badge?: string;
}

const {
  title = 'Dashboard',
  sectionTitle = 'Administration',
  badge = 'Active',
} = Astro.props;
---

<header class="sticky top-0 z-20 flex h-16 shrink-0 items-center justify-between border-b border-slate-200/80 bg-white/95 px-4 sm:px-6 lg:px-8 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-900/95 transition-colors">
  
  <!-- Left Header Area: Mobile Hamburger + Title -->
  <div class="flex items-center gap-3 min-w-0">
    <!-- Hamburger Button (Mobile / Tablet < 1024px) -->
    <button
      id="btn-open-mobile-drawer"
      type="button"
      aria-label="Open administration navigation drawer"
      class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-200 lg:hidden cursor-pointer"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>

    <div class="flex flex-col min-w-0">
      <div class="flex items-center gap-2">
        <h1 class="text-sm sm:text-base font-black tracking-tight text-slate-900 dark:text-white truncate">
          {title}
        </h1>
        {badge && (
          <span class="hidden sm:inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-extrabold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">
            {badge}
          </span>
        )}
      </div>
      <span class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 truncate hidden sm:block">
        AI Free Calculator • {sectionTitle}
      </span>
    </div>
  </div>

  <!-- Right Header Controls -->
  <div class="flex items-center gap-2 sm:gap-3 shrink-0">
    
    <!-- Quick Search Trigger Button -->
    <button
      id="btn-admin-search"
      type="button"
      class="hidden sm:inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-500 hover:border-slate-300 hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-400 transition cursor-pointer"
      title="Search Admin (Ctrl+K)"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <span>Quick Search...</span>
      <kbd class="rounded border border-slate-300 bg-white px-1 py-0.5 text-[9px] font-mono dark:border-slate-700 dark:bg-slate-900">⌘K</kbd>
    </button>

    <!-- Theme Toggle -->
    <button
      id="admin-theme-toggle"
      type="button"
      aria-label="Toggle dark/light theme"
      class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300 transition cursor-pointer"
    >
      <span class="dark:hidden text-sm">🌙</span>
      <span class="hidden dark:inline text-sm">☀️</span>
    </button>

    <!-- Admin Status Pill -->
    <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 py-1.5 px-3 dark:border-slate-800 dark:bg-slate-800/80">
      <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
      <span class="text-xs font-bold text-slate-700 dark:text-slate-200">Admin</span>
    </div>

  </div>

</header>
