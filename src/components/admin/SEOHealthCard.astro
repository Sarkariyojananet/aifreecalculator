---
import type { SEOAuditResult } from '../../lib/admin/seo-health';

interface Props {
  audit: SEOAuditResult;
}

const { audit } = Astro.props;

const gradeColors = {
  excellent: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800',
  good: 'bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 border-blue-200 dark:border-blue-800',
  fair: 'bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300 border-amber-200 dark:border-amber-800',
  poor: 'bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300 border-red-200 dark:border-red-800',
};

const gradeBarColors = {
  excellent: 'bg-emerald-500',
  good: 'bg-blue-500',
  fair: 'bg-amber-500',
  poor: 'bg-red-500',
};
---

<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900/90 flex flex-col justify-between space-y-4 hover:border-blue-300 transition">
  
  <div class="space-y-3">
    <!-- Header -->
    <div class="flex items-start justify-between gap-3">
      <div>
        <h4 class="text-sm font-bold text-slate-900 dark:text-white">
          {audit.name}
        </h4>
        <div class="flex items-center gap-2 mt-1">
          <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
            {audit.category}
          </span>
          <span class="text-[11px] font-mono text-slate-400 truncate max-w-[160px]">
            /{audit.slug}/
          </span>
        </div>
      </div>

      <div class="text-right shrink-0">
        <span class={`rounded-xl border px-2.5 py-1 text-xs font-black capitalize ${gradeColors[audit.grade]}`}>
          {audit.score}/100
        </span>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
      <div class={`h-full rounded-full ${gradeBarColors[audit.grade]}`} style={`width: ${audit.score}%`}></div>
    </div>

    <!-- Passed Checks & Warnings -->
    <div class="space-y-1.5 pt-1 text-xs">
      {audit.criticalIssues.map((issue) => (
        <div class="flex items-center gap-2 text-red-600 dark:text-red-400 font-semibold">
          <span>❌</span> <span class="line-clamp-1">{issue}</span>
        </div>
      ))}
      {audit.warnings.slice(0, 2).map((warn) => (
        <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-medium">
          <span>⚠️</span> <span class="line-clamp-1">{warn}</span>
        </div>
      ))}
      {audit.criticalIssues.length === 0 && audit.warnings.length === 0 && (
        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-semibold">
          <span>✓</span> <span>All core SEO signals optimized</span>
        </div>
      )}
    </div>
  </div>

  <!-- Actions -->
  <div class="border-t border-slate-100 pt-3 dark:border-slate-800 flex items-center justify-between text-xs font-bold">
    <a
      href={`/admin/calculators/new/?edit=${audit.slug}&tab=tab-seo`}
      class="text-blue-600 hover:underline dark:text-blue-400 inline-flex items-center gap-1"
    >
      <span>Edit SEO Metadata</span> →
    </a>
    <a
      href={`/${audit.category.toLowerCase()}/${audit.slug}/`}
      target="_blank"
      class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
    >
      Preview ↗
    </a>
  </div>

</div>
