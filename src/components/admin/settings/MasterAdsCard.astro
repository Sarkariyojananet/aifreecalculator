---
// Master Ads & Global Integration Settings Card
---

<div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 sm:p-8 space-y-6">
  <div class="flex items-center justify-between border-b border-slate-100 pb-4 dark:border-slate-800">
    <div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span aria-hidden="true">🌐</span> Master Ad Network Controls
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        Control global advertisement display, preview mode, and primary AdSense / GA4 credentials.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Master Ads Toggle Switch -->
    <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-950/40">
      <div>
        <label for="field-enabled" class="block text-xs font-bold text-slate-900 dark:text-white cursor-pointer select-none">
          Enable Ads Site-Wide
        </label>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Toggle all advertisements on/off with one switch</div>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <input
          type="checkbox"
          id="field-enabled"
          role="switch"
          class="sr-only peer"
          aria-checked="false"
        />
        <div
          class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500 peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-slate-900"
          aria-hidden="true"
        ></div>
      </label>
    </div>

    <!-- Test / Mockup Mode Switch -->
    <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-950/40">
      <div>
        <label for="field-test-mode" class="block text-xs font-bold text-slate-900 dark:text-white cursor-pointer select-none">
          Test / Preview Mode
          <span class="ml-1 rounded bg-amber-200 px-1.5 py-0.5 text-[9px] font-extrabold text-amber-900 dark:bg-amber-900/60 dark:text-amber-200">SAFE</span>
        </label>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Show visual test placeholders without requesting live ads</div>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <input
          type="checkbox"
          id="field-test-mode"
          role="switch"
          class="sr-only peer"
          aria-checked="false"
        />
        <div
          class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500 dark:bg-slate-700 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500 peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-slate-900"
          aria-hidden="true"
        ></div>
      </label>
    </div>
  </div>

  <!-- Publisher Client ID Field (AdSense) -->
  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <label for="field-client-id" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
        Google AdSense Publisher ID (<span class="font-mono text-blue-600 dark:text-blue-400">ca-pub-XXXXXXXXXXXXXXXX</span>)
      </label>
      <span class="text-[11px] text-slate-400 font-medium">Leave blank if only using Sponsors / 3rd-Party</span>
    </div>
    <div class="relative flex items-center">
      <span class="pointer-events-none absolute left-3.5 text-slate-400 text-sm" aria-hidden="true">🆔</span>
      <input
        type="text"
        id="field-client-id"
        placeholder="ca-pub-1234567890123456"
        autocomplete="off"
        spellcheck="false"
        class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-10 pr-4 text-sm font-mono font-semibold text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        aria-describedby="client-id-hint client-id-error"
      />
    </div>
    <p id="client-id-hint" class="text-[11px] text-slate-500 dark:text-slate-400">
      Found in AdSense under <strong>Account → Settings → Account information → Publisher ID</strong>.
    </p>
    <p id="client-id-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400" role="alert" aria-live="polite"></p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Auto Ads Option -->
    <div class="flex items-center justify-between rounded-xl border border-slate-100 bg-slate-50/40 p-3.5 dark:border-slate-800/80 dark:bg-slate-950/20">
      <div class="flex items-center gap-3">
        <span class="text-lg" aria-hidden="true">🤖</span>
        <div>
          <label for="field-auto-ads" class="block text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer select-none">
            Google Auto Ads
          </label>
          <div class="text-[10px] text-slate-500 dark:text-slate-400">Google automatically places ads in high-performing spots.</div>
        </div>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <input
          type="checkbox"
          id="field-auto-ads"
          role="switch"
          class="sr-only peer"
        />
        <div
          class="w-10 h-5 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600 dark:bg-slate-700"
          aria-hidden="true"
        ></div>
      </label>
    </div>

    <!-- GA4 Measurement ID -->
    <div class="rounded-xl border border-slate-100 bg-slate-50/40 p-3.5 dark:border-slate-800/80 dark:bg-slate-950/20 space-y-1.5">
      <label for="field-ga-id" class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
        <span>📊</span> Google Analytics 4 ID
      </label>
      <input
        type="text"
        id="field-ga-id"
        placeholder="G-XXXXXXXXXX"
        spellcheck="false"
        class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-mono font-semibold text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
      />
      <p id="ga-id-error" class="hidden text-[10px] font-semibold text-red-600 dark:text-red-400"></p>
    </div>
  </div>

  <!-- Global Header Tag / Script Area -->
  <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
    <div class="flex items-center justify-between">
      <label for="field-header-script" class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
        <span>🏷️</span> Global Header Script / Tags (AdX, Prebid, Ezoic, GTM)
      </label>
      <span class="text-[10px] font-mono text-slate-400">&lt;script&gt; tags allowed</span>
    </div>
    <textarea
      id="field-header-script"
      rows="3"
      placeholder="<!-- Paste global 3rd-party ad scripts, Prebid.js, or Google Ad Manager tag here -->"
      spellcheck="false"
      class="w-full rounded-2xl border border-slate-300 bg-white p-3 font-mono text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
    ></textarea>
  </div>
</div>
