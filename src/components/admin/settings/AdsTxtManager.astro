---
// AdsTxtManager.astro - Authorized Digital Sellers (ads.txt) Configuration & IAB Syntax Validator
---

<div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 sm:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4 dark:border-slate-800">
    <div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>📄</span> Authorized Digital Sellers (<code class="font-mono text-xs text-blue-600 dark:text-blue-400">/ads.txt</code>)
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        Manage authorized ad exchange seller records. Validated according to IAB OpenRTB specs.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/ads.txt"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition"
      >
        <span>🔗</span> View Live /ads.txt ↗
      </a>
    </div>
  </div>

  <div class="space-y-4">
    <!-- Auto AdSense Line Toggle -->
    <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40">
      <div>
        <label for="field-include-google-adstxt" class="block text-xs font-bold text-slate-900 dark:text-white cursor-pointer">
          Auto-Generate Google AdSense Seller Line
        </label>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
          Automatically injects <code class="font-mono text-blue-600 dark:text-blue-400">google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0</code>
        </p>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="field-include-google-adstxt" checked role="switch" class="sr-only peer" />
        <div class="w-10 h-5 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
      </label>
    </div>

    <!-- 3rd-Party Ads.txt Records -->
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <label for="field-third-party-adstxt" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
          Partner &amp; 3rd-Party Seller Lines (Ezoic, Mediavine, AdX Resellers, etc.)
        </label>
        <button
          type="button"
          id="btn-validate-adstxt"
          class="inline-flex items-center gap-1.5 rounded-lg bg-blue-50 px-2.5 py-1 text-[11px] font-bold text-blue-700 hover:bg-blue-100 dark:bg-blue-950 dark:text-blue-300 dark:hover:bg-blue-900 transition cursor-pointer"
        >
          <span>✓</span> Validate IAB Format
        </button>
      </div>

      <textarea
        id="field-third-party-adstxt"
        rows="5"
        placeholder="example-exchange.com, 12345, DIRECT, abcdef1234567890&#10;reseller-network.com, 67890, RESELLER"
        spellcheck="false"
        class="w-full rounded-2xl border border-slate-300 bg-white p-3 font-mono text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
      ></textarea>

      <div class="flex items-center justify-between text-[11px]">
        <span id="adstxt-validation-msg" class="text-slate-500 dark:text-slate-400">One seller record per line (Format: domain, pubId, DIRECT/RESELLER, [certId])</span>
        <span class="text-slate-400">IAB OpenRTB Compliant</span>
      </div>
    </div>
  </div>
</div>
