---
import { getGoogleAccountStatus, getGoogleOAuthConfig } from '../../../lib/auth/google-oauth';

const googleStatus = await getGoogleAccountStatus(Astro.locals);
const config = await getGoogleOAuthConfig(Astro.locals);

const isConfigured = !!config;
const isConnected = googleStatus.connected;
---

<div id="google-auth" class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-6">
  
  <!-- Header Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-100 pb-5 dark:border-slate-800">
    <div class="flex items-center gap-3.5">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white shadow-sm border border-slate-200 dark:border-slate-700 dark:bg-slate-800">
        <!-- Google Multi-color G Icon -->
        <svg class="h-6 w-6" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
      </div>

      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-base font-black text-slate-900 dark:text-white">
            Direct Google Account Authorization (Gmail)
          </h3>
          {isConnected ? (
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span> Connected
            </span>
          ) : (
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
              Not Connected
            </span>
          )}
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          1-Click direct OAuth connection for Google Search Console, Google AdSense, and Google Instant Indexing without manual API keys.
        </p>
      </div>
    </div>

    <!-- Right Action Button -->
    <div class="self-start sm:self-auto shrink-0">
      {isConnected ? (
        <button
          type="button"
          id="btn-google-disconnect"
          class="inline-flex items-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2 text-xs font-bold text-rose-700 hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/60 dark:text-rose-300 transition cursor-pointer"
        >
          Disconnect Google Account
        </button>
      ) : (
        <a
          href="/api/auth/google/login?returnTo=/admin/settings/"
          id="btn-google-connect"
          class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-blue-700 transition cursor-pointer"
        >
          <svg class="h-4 w-4 bg-white rounded-full p-0.5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          Connect with Google (Gmail)
        </a>
      )}
    </div>
  </div>

  <!-- Connected Details or Setup Guidance -->
  {isConnected ? (
    <div class="rounded-2xl bg-emerald-50/50 p-5 border border-emerald-200/80 dark:bg-emerald-950/20 dark:border-emerald-900/40 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          {googleStatus.picture ? (
            <img src={googleStatus.picture} alt="User Avatar" class="h-10 w-10 rounded-full border border-emerald-300" />
          ) : (
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-600 text-white font-bold text-sm">
              {googleStatus.email ? googleStatus.email.charAt(0).toUpperCase() : 'G'}
            </div>
          )}
          <div>
            <div class="text-xs font-bold text-slate-900 dark:text-white">
              {googleStatus.name || 'Google Account'}
            </div>
            <div class="text-[11px] font-mono font-medium text-emerald-700 dark:text-emerald-300">
              {googleStatus.email}
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded-lg bg-white px-2.5 py-1 text-[11px] font-bold text-slate-700 shadow-2xs dark:bg-slate-800 dark:text-slate-200">
            🔍 Search Console: Active
          </span>
          <span class="inline-flex items-center gap-1 rounded-lg bg-white px-2.5 py-1 text-[11px] font-bold text-slate-700 shadow-2xs dark:bg-slate-800 dark:text-slate-200">
            💰 AdSense: Active
          </span>
          <span class="inline-flex items-center gap-1 rounded-lg bg-white px-2.5 py-1 text-[11px] font-bold text-slate-700 shadow-2xs dark:bg-slate-800 dark:text-slate-200">
            ⚡ Instant Indexing: Active
          </span>
        </div>
      </div>
    </div>
  ) : (
    <div class="rounded-2xl bg-slate-50 p-5 border border-slate-200/80 dark:bg-slate-950 dark:border-slate-800 text-xs space-y-3">
      <div class="font-bold text-slate-800 dark:text-slate-200">
        ✨ How Direct Gmail Authorization Works:
      </div>
      <ul class="space-y-1.5 text-slate-600 dark:text-slate-400 pl-4 list-disc">
        <li>Click <strong>"Connect with Google"</strong> to sign in with the Gmail account having access to your Google Search Console property and Google AdSense account.</li>
        <li>No JSON private key files, service accounts, or manual RSA formatting required.</li>
        <li>Instant Indexing for Bing (IndexNow) and Google will automatically use this authenticated connection.</li>
      </ul>
    </div>
  )}

  <!-- Collapsible OAuth App Credentials Form -->
  <details class="group rounded-2xl border border-slate-200 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-950/50">
    <summary class="cursor-pointer text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
      <span class="flex items-center gap-2">
        <span>⚙️</span> Google Cloud OAuth Client Setup (Credentials)
      </span>
      <span class="text-[11px] text-blue-600 dark:text-blue-400 group-open:rotate-180 transition">▼</span>
    </summary>

    <div class="pt-4 mt-3 border-t border-slate-200 dark:border-slate-800 space-y-4">
      <p class="text-[11px] text-slate-500 dark:text-slate-400">
        Create a <strong>Web Application OAuth Client ID</strong> in Google Cloud Console. Enter credentials here (or set in <code class="font-mono">.env</code> as <code class="font-mono">GOOGLE_CLIENT_ID</code> and <code class="font-mono">GOOGLE_CLIENT_SECRET</code>).
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="oauth-client-id" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            Google Client ID:
          </label>
          <input
            type="text"
            id="oauth-client-id"
            value={config?.clientId || ''}
            placeholder="e.g. 123456789-xxx.apps.googleusercontent.com"
            class="w-full rounded-xl border border-slate-300 bg-white py-2 px-3 text-xs font-mono text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div>
          <label for="oauth-client-secret" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            Google Client Secret:
          </label>
          <input
            type="password"
            id="oauth-client-secret"
            value={config?.clientSecret ? '••••••••••••••••••••' : ''}
            placeholder="e.g. GOCSPX-xxxxxxxxxxxx"
            class="w-full rounded-xl border border-slate-300 bg-white py-2 px-3 text-xs font-mono text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>
      </div>

      <div class="text-[11px] text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-900 p-3 rounded-xl border border-slate-200 dark:border-slate-800">
        <strong>Authorized Redirect URI:</strong> <code class="font-mono text-blue-600 dark:text-blue-400 select-all">{Astro.url.origin}/api/auth/google/callback</code>
      </div>

      <div class="flex justify-end">
        <button
          type="button"
          id="btn-save-oauth-config"
          class="rounded-xl bg-slate-900 dark:bg-blue-600 px-4 py-2 text-xs font-bold text-white hover:opacity-90 transition cursor-pointer"
        >
          Save OAuth Credentials
        </button>
      </div>
    </div>
  </details>

</div>

<script is:inline>
  const btnDisconnect = document.getElementById('btn-google-disconnect');
  if (btnDisconnect) {
    btnDisconnect.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to disconnect this Google Account?')) return;
      btnDisconnect.disabled = true;
      try {
        const res = await fetch('/api/auth/google/disconnect', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('Google account disconnected successfully.');
          window.location.reload();
        }
      } catch {
        alert('Failed to disconnect Google account.');
        btnDisconnect.disabled = false;
      }
    });
  }

  const btnSaveConfig = document.getElementById('btn-save-oauth-config');
  if (btnSaveConfig) {
    btnSaveConfig.addEventListener('click', async () => {
      const clientId = document.getElementById('oauth-client-id')?.value.trim();
      const clientSecret = document.getElementById('oauth-client-secret')?.value.trim();

      if (!clientId || !clientSecret || clientSecret.includes('••••')) {
        alert('Please provide both a valid Client ID and Client Secret.');
        return;
      }

      btnSaveConfig.disabled = true;
      btnSaveConfig.innerText = 'Saving...';

      try {
        const res = await fetch('/api/auth/google/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ clientId, clientSecret }),
        });
        const data = await res.json();
        if (data.success) {
          alert('Google OAuth credentials saved! You can now click "Connect with Google".');
          window.location.reload();
        } else {
          alert(data.error || 'Failed to save configuration.');
        }
      } catch {
        alert('Error saving configuration.');
      } finally {
        btnSaveConfig.disabled = false;
        btnSaveConfig.innerText = 'Save OAuth Credentials';
      }
    });
  }
</script>
