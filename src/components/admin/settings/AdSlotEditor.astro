---
// AdSlotEditor.astro - Interactive Slot Configurator & Direct Sponsor / Affiliate Switcher
---

<div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 sm:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4 dark:border-slate-800">
    <div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>🎯</span> Ad Slots &amp; Monetization Switcher
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        Switch each placement between <strong>Google AdSense</strong>, <strong>Google AdX</strong>, <strong>Direct Sponsor Banner</strong>, or <strong>Affiliate Link</strong>.
      </p>
    </div>
    
    <!-- Quick Slot Navigation Tabs -->
    <div class="flex items-center gap-1.5 overflow-x-auto p-1 bg-slate-100 dark:bg-slate-800 rounded-xl">
      <button type="button" data-slot-tab="top" class="slot-tab-btn active px-3 py-1 text-xs font-bold rounded-lg transition bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 shadow-2xs">
        Top Banner
      </button>
      <button type="button" data-slot-tab="inline" class="slot-tab-btn px-3 py-1 text-xs font-bold rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
        In-Content
      </button>
      <button type="button" data-slot-tab="sidebar" class="slot-tab-btn px-3 py-1 text-xs font-bold rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
        Sidebar
      </button>
      <button type="button" data-slot-tab="footer" class="slot-tab-btn px-3 py-1 text-xs font-bold rounded-lg transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
        Footer
      </button>
    </div>
  </div>

  <!-- Slot Configuration Panels -->
  <div id="slot-panels-container" class="space-y-6">
    
    <!-- 1. Top Banner Slot -->
    <div id="panel-slot-top" class="slot-panel space-y-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-blue-100 text-blue-700 text-xs font-black dark:bg-blue-950 dark:text-blue-300">
            01
          </span>
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white">Top Banner Placement</h4>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">Positioned directly above calculator controls and below navigation header</p>
          </div>
        </div>

        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="field-slot-top-enabled" checked role="switch" class="sr-only peer" />
          <div class="w-10 h-5 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          <span class="ml-2 text-xs font-semibold text-slate-700 dark:text-slate-300">Enable Slot</span>
        </label>
      </div>

      <!-- Network Selector Segment -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">Active Monetization Mode</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-blue-500 bg-blue-50/50 dark:bg-blue-950/30 has-checked:border-blue-600 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/50">
            <input type="radio" name="top-network" value="adsense" class="sr-only" checked />
            <span class="text-lg">🟢</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Google AdSense</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Auto Responsive</span>
          </label>

          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-purple-600 has-checked:bg-purple-50 dark:has-checked:bg-purple-950/40">
            <input type="radio" name="top-network" value="adx" class="sr-only" />
            <span class="text-lg">🟣</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Google AdX / Script</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Custom Tag / GAM</span>
          </label>

          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-emerald-600 has-checked:bg-emerald-50 dark:has-checked:bg-emerald-950/40">
            <input type="radio" name="top-network" value="direct_sponsor" class="sr-only" />
            <span class="text-lg">🟠</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Direct Sponsor</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Custom Banner Ad</span>
          </label>

          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-amber-600 has-checked:bg-amber-50 dark:has-checked:bg-amber-950/40">
            <input type="radio" name="top-network" value="affiliate" class="sr-only" />
            <span class="text-lg">🔵</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Affiliate Creative</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Tracked Partner Link</span>
          </label>
        </div>
      </div>

      <!-- Mode 1: AdSense Inputs -->
      <div class="slot-mode-container mode-adsense space-y-2">
        <label for="field-slot-top-id" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
          Google AdSense Slot ID (10-digit numeric ID)
        </label>
        <input
          type="text"
          id="field-slot-top-id"
          placeholder="e.g. 1234567890"
          class="w-full rounded-2xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-mono font-bold text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
        <p id="slot-top-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400"></p>
      </div>

      <!-- Mode 2: AdX / Custom Script Inputs -->
      <div class="slot-mode-container mode-adx hidden space-y-2">
        <label for="field-slot-top-code" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
          AdX / GAM HTML &amp; Script Tag
        </label>
        <textarea
          id="field-slot-top-code"
          rows="3"
          placeholder="<div id='div-gpt-ad-12345'><script>googletag.cmd.push(...);</script></div>"
          class="w-full rounded-2xl border border-slate-300 bg-white p-3 font-mono text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        ></textarea>
        <p id="slot-top-code-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400"></p>
      </div>

      <!-- Mode 3 & 4: Direct Sponsor / Affiliate Inputs -->
      <div class="slot-mode-container mode-sponsor hidden space-y-4 rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="field-slot-top-sponsor-target" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Target Landing / Affiliate URL <span class="text-red-500">*</span>
            </label>
            <input
              type="url"
              id="field-slot-top-sponsor-target"
              placeholder="https://example.com/?ref=aifreecalc"
              class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="space-y-1.5">
            <label for="field-slot-top-sponsor-banner" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Banner Image URL (Responsive PNG, WEBP or JPG)
            </label>
            <input
              type="url"
              id="field-slot-top-sponsor-banner"
              placeholder="https://example.com/banners/728x90.webp"
              class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="space-y-1">
            <label for="field-slot-top-sponsor-alt" class="block text-[11px] font-bold text-slate-600 dark:text-slate-400">
              Alt Text / Title
            </label>
            <input
              type="text"
              id="field-slot-top-sponsor-alt"
              placeholder="Exclusive Loan Offer from HDFC"
              class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="space-y-1">
            <label for="field-slot-top-sponsor-badge" class="block text-[11px] font-bold text-slate-600 dark:text-slate-400">
              Badge Text
            </label>
            <input
              type="text"
              id="field-slot-top-sponsor-badge"
              placeholder="Sponsored"
              class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="flex items-center gap-4 pt-5">
            <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
              <input type="checkbox" id="field-slot-top-sponsor-newtab" checked class="rounded text-blue-600" />
              New Tab
            </label>
            <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
              <input type="checkbox" id="field-slot-top-sponsor-nofollow" checked class="rounded text-blue-600" />
              nofollow
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. In-Content Slot -->
    <div id="panel-slot-inline" class="slot-panel hidden space-y-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 text-xs font-black dark:bg-emerald-950 dark:text-emerald-300">
            02
          </span>
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white">In-Content Result Placement</h4>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">Appears directly after calculation outputs &amp; result cards</p>
          </div>
        </div>

        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="field-slot-inline-enabled" checked role="switch" class="sr-only peer" />
          <div class="w-10 h-5 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          <span class="ml-2 text-xs font-semibold text-slate-700 dark:text-slate-300">Enable Slot</span>
        </label>
      </div>

      <!-- Network Selector Segment -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">Active Monetization Mode</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-blue-500 bg-blue-50/50 dark:bg-blue-950/30 has-checked:border-blue-600 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/50">
            <input type="radio" name="inline-network" value="adsense" class="sr-only" checked />
            <span class="text-lg">🟢</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Google AdSense</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Rectangle Unit</span>
          </label>
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-purple-600 has-checked:bg-purple-50 dark:has-checked:bg-purple-950/40">
            <input type="radio" name="inline-network" value="adx" class="sr-only" />
            <span class="text-lg">🟣</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Google AdX / Script</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Custom Tag</span>
          </label>
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-emerald-600 has-checked:bg-emerald-50 dark:has-checked:bg-emerald-950/40">
            <input type="radio" name="inline-network" value="direct_sponsor" class="sr-only" />
            <span class="text-lg">🟠</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Direct Sponsor</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Custom Banner</span>
          </label>
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-amber-600 has-checked:bg-amber-50 dark:has-checked:bg-amber-950/40">
            <input type="radio" name="inline-network" value="affiliate" class="sr-only" />
            <span class="text-lg">🔵</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Affiliate Creative</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Tracked Partner</span>
          </label>
        </div>
      </div>

      <!-- Mode 1: AdSense Inputs -->
      <div class="slot-mode-container mode-adsense space-y-2">
        <label for="field-slot-inline-id" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
          Google AdSense Slot ID
        </label>
        <input
          type="text"
          id="field-slot-inline-id"
          placeholder="e.g. 2345678901"
          class="w-full rounded-2xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-mono font-bold text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
        <p id="slot-inline-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400"></p>
      </div>

      <!-- Mode 2: AdX Custom Code -->
      <div class="slot-mode-container mode-adx hidden space-y-2">
        <label for="field-slot-inline-code" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
          AdX HTML &amp; Script Tag
        </label>
        <textarea
          id="field-slot-inline-code"
          rows="3"
          placeholder="<div id='div-gpt-ad-inline'>...</div>"
          class="w-full rounded-2xl border border-slate-300 bg-white p-3 font-mono text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        ></textarea>
        <p id="slot-inline-code-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400"></p>
      </div>

      <!-- Mode 3 & 4: Sponsor Inputs -->
      <div class="slot-mode-container mode-sponsor hidden space-y-4 rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="field-slot-inline-sponsor-target" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Target URL</label>
            <input type="url" id="field-slot-inline-sponsor-target" placeholder="https://affiliate.partner.com/track" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
          </div>
          <div class="space-y-1.5">
            <label for="field-slot-inline-sponsor-banner" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Banner URL (336x280 or 300x250)</label>
            <input type="url" id="field-slot-inline-sponsor-banner" placeholder="https://example.com/banners/300x250.webp" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <input type="text" id="field-slot-inline-sponsor-alt" placeholder="Alt / Offer Title" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
          <input type="text" id="field-slot-inline-sponsor-badge" placeholder="Badge (e.g. Partner, Sponsored)" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
        </div>
      </div>
    </div>

    <!-- 3. Sidebar Slot -->
    <div id="panel-slot-sidebar" class="slot-panel hidden space-y-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-purple-100 text-purple-700 text-xs font-black dark:bg-purple-950 dark:text-purple-300">
            03
          </span>
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white">Desktop Sidebar Placement</h4>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">Positioned in the sticky right sidebar on large screens</p>
          </div>
        </div>

        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="field-slot-sidebar-enabled" checked role="switch" class="sr-only peer" />
          <div class="w-10 h-5 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          <span class="ml-2 text-xs font-semibold text-slate-700 dark:text-slate-300">Enable Slot</span>
        </label>
      </div>

      <!-- Network Selector Segment -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">Active Monetization Mode</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-blue-500 bg-blue-50/50 dark:bg-blue-950/30 has-checked:border-blue-600 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/50">
            <input type="radio" name="sidebar-network" value="adsense" class="sr-only" checked />
            <span class="text-lg">🟢</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Google AdSense</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Vertical 300x600</span>
          </label>
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-purple-600 has-checked:bg-purple-50 dark:has-checked:bg-purple-950/40">
            <input type="radio" name="sidebar-network" value="adx" class="sr-only" />
            <span class="text-lg">🟣</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Google AdX / Script</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Custom Tag</span>
          </label>
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-emerald-600 has-checked:bg-emerald-50 dark:has-checked:bg-emerald-950/40">
            <input type="radio" name="sidebar-network" value="direct_sponsor" class="sr-only" />
            <span class="text-lg">🟠</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Direct Sponsor</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Vertical Banner</span>
          </label>
          <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 cursor-pointer transition select-none text-center border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 has-checked:border-amber-600 has-checked:bg-amber-50 dark:has-checked:bg-amber-950/40">
            <input type="radio" name="sidebar-network" value="affiliate" class="sr-only" />
            <span class="text-lg">🔵</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white mt-1">Affiliate Creative</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Tracked Partner</span>
          </label>
        </div>
      </div>

