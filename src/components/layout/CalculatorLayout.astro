---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculators } from '../../data/calculators';

interface Props {
  title: string;
  description: string;
  category?: string;
  calculatorName?: string;
}

const {
  title,
  description,
  category = 'CALCULATOR',
  calculatorName = title,
} = Astro.props;

// Curated top 5 popular tools with distinct icons
const topPopular = [
  { name: 'Income Tax Calculator', slug: 'income-tax-calculator', icon: '💰', tag: 'AY 25-26 & 26-27' },
  { name: 'EMI Calculator', slug: 'emi-calculator', icon: '💳', tag: 'Loan & Interest' },
  { name: 'SIP Calculator', slug: 'sip-calculator', icon: '📈', tag: 'Mutual Funds' },
  { name: 'Universal Weight Calculator', slug: 'weight-calculator', icon: '⚖️', tag: '6-in-1 Tool' },
  { name: 'BMI Calculator', slug: 'bmi-calculator', icon: '❤️', tag: 'Men & Women' },
  { name: 'Time & Date Calculator', slug: 'time-calculator', icon: '⏰', tag: 'Work & Hours' },
];

const categories = [
  { name: 'Finance', icon: '💰', href: '/finance/' },
  { name: 'Construction', icon: '🏗️', href: '/construction/' },
  { name: 'Health', icon: '❤️', href: '/health/' },
  { name: 'General', icon: '⚙️', href: '/general/' },
];
---

<BaseLayout
  title={title}
  description={description}
>
  <!-- Calculator Hero Header -->
  <section class="border-b border-slate-200 bg-slate-50 px-4 py-8 dark:border-slate-800 dark:bg-slate-950 sm:py-12">
    <div class="mx-auto max-w-5xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-bold tracking-wider text-blue-700 dark:border-blue-800/60 dark:bg-blue-950/40 dark:text-blue-300">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-600 dark:bg-blue-400"></span>
        {category}
      </div>

      <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl lg:text-4xl">
        {calculatorName}
      </h1>

      <p class="mx-auto mt-3 max-w-2xl text-xs leading-6 text-slate-600 dark:text-slate-300 sm:text-sm">
        {description}
      </p>
    </div>
  </section>

  <!-- Interactive Tool Section -->
  <main class="bg-white px-4 py-8 dark:bg-slate-950 sm:py-12">
    <div class="mx-auto max-w-7xl space-y-12">
      
      <!-- Interactive Calculator Component -->
      <div>
        <slot />
      </div>

      <!-- Lower Guide & FAQs with Clean Compact Sidebar -->
      <div class="border-t border-slate-200 pt-10 dark:border-slate-800 grid gap-8 lg:grid-cols-[1fr_300px]">
        
        <!-- Left: SEO Content & FAQ -->
        <div class="space-y-10 min-w-0">
          <div class="prose prose-slate max-w-none dark:prose-invert">
            <slot name="content" />
          </div>

          <div class="border-t border-slate-200 pt-8 dark:border-slate-800">
            <slot name="faq" />
          </div>
        </div>

        <!-- Right: Sleek Compact Sidebar -->
        <aside class="space-y-5">
          <div class="sticky top-24 space-y-4">
            
            <!-- Compact Popular Tools Box -->
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/60">
              <div class="flex items-center gap-2 border-b border-slate-200/80 pb-2.5 dark:border-slate-800">
                <span class="text-sm">🔥</span>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                  Popular Tools
                </h3>
              </div>

              <div class="mt-2.5 divide-y divide-slate-100 dark:divide-slate-800/60">
                {topPopular.map((c) => (
                  <a
                    href={`/${c.slug}/`}
                    class="group flex items-center justify-between py-2 text-xs transition hover:text-blue-600 dark:hover:text-blue-400"
                  >
                    <div class="flex items-center gap-2 min-w-0 pr-1">
                      <span class="text-sm shrink-0">{c.icon}</span>
                      <span class="truncate font-medium text-slate-700 group-hover:text-blue-600 dark:text-slate-200 dark:group-hover:text-blue-400">
                        {c.name}
                      </span>
                    </div>
                    <span class="text-[10px] shrink-0 font-semibold text-slate-400 dark:text-slate-500">
                      {c.tag}
                    </span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Categories Quick Grid -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/40">
              <div class="flex items-center gap-2 border-b border-slate-100 pb-2.5 dark:border-slate-800">
                <span class="text-sm">📂</span>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                  Categories
                </h3>
              </div>
              <div class="mt-2.5 grid grid-cols-2 gap-1.5">
                {categories.map((cat) => (
                  <a
                    href={cat.href}
                    class="flex items-center gap-1.5 rounded-lg border border-slate-100 bg-slate-50/50 p-2 text-xs font-medium text-slate-700 transition hover:border-blue-200 hover:bg-blue-50/50 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300 dark:hover:bg-slate-800"
                  >
                    <span>{cat.icon}</span>
                    <span>{cat.name}</span>
                  </a>
                ))}
              </div>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </main>
</BaseLayout>