---
import ThemeToggle from '../ui/ThemeToggle.astro';
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-950/95">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">

    <!-- Logo -->
    <a
      href="/"
      class="text-xl font-bold tracking-tight text-slate-900 dark:text-white"
    >
      AI Free Calculator
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden items-center gap-7 md:flex">
      <nav class="flex items-center gap-7">
        <a
          href="/"
          class="text-sm font-medium text-slate-600 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white"
        >
          Home
        </a>

        <a
          href="#calculators"
          class="text-sm font-medium text-slate-600 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white"
        >
          Calculators
        </a>

        <a
          href="#categories"
          class="text-sm font-medium text-slate-600 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white"
        >
          Categories
        </a>

        <a
          href="#about"
          class="text-sm font-medium text-slate-600 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white"
        >
          About
        </a>
      </nav>

      <ThemeToggle />
    </div>

    <!-- Mobile Actions -->
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />

      <button
        type="button"
        id="mobile-menu-button"
        class="inline-flex items-center justify-center rounded-lg border border-slate-200 p-2 text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-slate-200 px-4 py-4 dark:border-slate-800 md:hidden"
  >
    <div class="flex flex-col gap-1">

      <a
        href="/"
        class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        Home
      </a>

      <a
        href="#calculators"
        class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        Calculators
      </a>

      <a
        href="#categories"
        class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        Categories
      </a>

      <a
        href="#about"
        class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        About
      </a>

    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector('#mobile-menu-button');
  const mobileMenu = document.querySelector('#mobile-menu');

  menuButton?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');

    mobileMenu?.classList.toggle('hidden');

    menuButton.setAttribute('aria-expanded', String(!isOpen));
  });
</script>