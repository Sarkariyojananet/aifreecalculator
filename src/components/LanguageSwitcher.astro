---
import { LOCALES, LOCALES_MAP, type Locale } from '../i18n/config';
import { extractLocaleFromPath, getLocalizedPath } from '../i18n/utils';
import { getAvailableLocalesForPath } from '../i18n/registry';

interface Props {
  class?: string;
  variant?: 'dropdown' | 'inline' | 'mobile';
}

const { class: className = '', variant = 'dropdown' } = Astro.props;

const currentPath = Astro.url.pathname;
const { lang: currentLang } = extractLocaleFromPath(currentPath);
const currentLocaleInfo = LOCALES_MAP[currentLang];
const availableLocales = getAvailableLocalesForPath(currentPath);

const languageOptions = LOCALES.map((locale) => {
  const isAvailable = availableLocales.includes(locale);
  const targetHref = isAvailable 
    ? getLocalizedPath(currentPath, locale)
    : getLocalizedPath('/', locale);
  
  return {
    code: locale,
    name: LOCALES_MAP[locale].name,
    nativeName: LOCALES_MAP[locale].nativeName,
    flag: LOCALES_MAP[locale].flag,
    href: targetHref,
    isActive: locale === currentLang,
    isAvailable,
  };
});
---

{variant === 'dropdown' && (
  <div class={`relative inline-block text-left language-switcher-dropdown ${className}`}>
    <button
      type="button"
      id="language-switcher-btn"
      aria-expanded="false"
      aria-haspopup="true"
      aria-label="Select Language"
      class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 hover:text-blue-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 cursor-pointer shadow-2xs"
    >
      <span class="text-sm leading-none" aria-hidden="true">{currentLocaleInfo.flag}</span>
      <span class="font-medium hidden sm:inline">{currentLocaleInfo.nativeName}</span>
      <span class="uppercase font-bold sm:hidden text-[11px]">{currentLang}</span>
      <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-200 dropdown-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <!-- Dropdown Menu -->
    <div
      id="language-switcher-menu"
      class="hidden absolute right-0 mt-1.5 w-52 origin-top-right rounded-2xl border border-slate-200 bg-white p-1.5 shadow-xl ring-1 ring-black/5 dark:border-slate-800 dark:bg-slate-900 z-50 transition-all duration-150 transform opacity-0 scale-95"
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="language-switcher-btn"
    >
      <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400 border-b border-slate-100 dark:border-slate-800 mb-1">
        Select Language
      </div>
      <div class="space-y-0.5 max-h-72 overflow-y-auto scrollbar-thin">
        {languageOptions.map((opt) => (
          <a
            href={opt.href}
            role="menuitem"
            class={`flex items-center justify-between rounded-xl px-2.5 py-1.5 text-xs transition ${
              opt.isActive
                ? 'bg-blue-50 font-bold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300'
                : 'text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800'
            }`}
          >
            <div class="flex items-center gap-2">
              <span class="text-sm">{opt.flag}</span>
              <div>
                <div class="font-medium leading-snug">{opt.nativeName}</div>
                <div class="text-[10px] text-slate-400 dark:text-slate-400 leading-none">{opt.name}</div>
              </div>
            </div>
            {opt.isActive && (
              <svg class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            )}
            {!opt.isAvailable && !opt.isActive && (
              <span class="text-[9px] text-slate-400 bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">Home</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
)}

{variant === 'mobile' && (
  <div class={`space-y-1 ${className}`}>
    <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400">
      Language / भाषा / Idioma
    </div>
    <div class="grid grid-cols-2 gap-1.5 pt-1">
      {languageOptions.map((opt) => (
        <a
          href={opt.href}
          class={`flex items-center gap-2 rounded-xl border p-2 text-xs transition ${
            opt.isActive
              ? 'border-blue-500 bg-blue-50/80 font-bold text-blue-700 dark:border-blue-500/50 dark:bg-blue-950/40 dark:text-blue-300'
              : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800'
          }`}
        >
          <span class="text-base">{opt.flag}</span>
          <div class="overflow-hidden">
            <div class="truncate font-semibold">{opt.nativeName}</div>
            <div class="truncate text-[10px] text-slate-400 dark:text-slate-400 leading-tight">{opt.name}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

<script>
  function initLanguageSwitcher() {
    const btn = document.getElementById('language-switcher-btn');
    const menu = document.getElementById('language-switcher-menu');
    if (!btn || !menu) return;

    function openMenu() {
      btn?.setAttribute('aria-expanded', 'true');
      menu?.classList.remove('hidden');
      requestAnimationFrame(() => {
        menu?.classList.remove('opacity-0', 'scale-95');
        menu?.classList.add('opacity-100', 'scale-100');
      });
    }

    function closeMenu() {
      btn?.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('opacity-100', 'scale-100');
      menu?.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        menu?.classList.add('hidden');
      }, 150);
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        if (btn.getAttribute('aria-expanded') === 'true') {
          closeMenu();
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        btn.focus();
      }
    });
  }

  // Run on first load and after Astro View Transitions if any
  initLanguageSwitcher();
  document.addEventListener('astro:page-load', initLanguageSwitcher);
</script>
