---
import { LOCALES, LOCALES_MAP, isValidLocale, DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { extractLocaleFromPath, getLocalizedPath } from '../i18n/utils';
import { getAvailableLocalesForPath } from '../i18n/registry';

interface Props {
  class?: string;
  variant?: 'dropdown' | 'inline' | 'mobile';
  lang?: Locale;
}

const { class: className = '', variant = 'dropdown', lang: propLang } = Astro.props;

const currentPath = Astro.url.pathname;
const localsLang = (Astro.locals as any)?.locale;
const originalPath = (Astro.locals as any)?.originalPath;
const effectivePath = originalPath || currentPath;
const urlQueryLang = Astro.url.searchParams.get('lang');
const { lang: pathLang, cleanPath } = extractLocaleFromPath(effectivePath);
const astroLocale = Astro.currentLocale as Locale | undefined;
const candidateLang = (astroLocale && isValidLocale(astroLocale) ? astroLocale : null) || propLang || pathLang || (localsLang && isValidLocale(localsLang) ? localsLang : null) || (urlQueryLang && isValidLocale(urlQueryLang) ? (urlQueryLang as Locale) : null);
const currentLang: Locale = isValidLocale(candidateLang) ? candidateLang : DEFAULT_LOCALE;
const currentLocaleInfo = LOCALES_MAP[currentLang];

const languageOptions = LOCALES.map((locale) => {
  const targetHref = getLocalizedPath(cleanPath, locale);
  
  return {
    code: locale,
    name: LOCALES_MAP[locale].name,
    nativeName: LOCALES_MAP[locale].nativeName,
    flag: LOCALES_MAP[locale].flag,
    href: targetHref,
    isActive: locale === currentLang,
    isAvailable: true,
  };
});
---

{LOCALES.length > 1 && variant === 'dropdown' && (
  <div class={`relative inline-block text-left language-switcher-dropdown ${className}`}>
    <button
      type="button"
      id="language-switcher-btn"
      aria-expanded="false"
      aria-haspopup="true"
      aria-label="Select Language"
      data-current-lang={currentLang}
      class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition-all duration-200 hover:bg-linear-to-br hover:from-slate-50 hover:to-slate-100 hover:text-blue-600 hover:border-slate-300 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:border-slate-700 cursor-pointer shadow-2xs language-badge"
    >
      <span class="text-sm leading-none language-btn-flag flag-hover" aria-hidden="true">{currentLocaleInfo.flag}</span>
      <span class="font-medium hidden sm:inline language-btn-name">{currentLocaleInfo.nativeName}</span>
      <span class="uppercase font-bold sm:hidden text-[11px] language-btn-code">{currentLang}</span>
      <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-200 dropdown-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <!-- Dropdown Menu -->
    <div
      id="language-switcher-menu"
      class="hidden absolute right-0 mt-1.5 w-52 origin-top-right rounded-2xl border border-slate-200 bg-white p-1.5 shadow-xl ring-1 ring-black/5 dark:border-slate-800 dark:bg-slate-900 z-50 transition-all duration-150 transform opacity-0 scale-95"
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="language-switcher-btn"
    >
      <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400 border-b border-slate-100 dark:border-slate-800 mb-1">
        Select Language
      </div>
      <div class="space-y-0.5 max-h-72 overflow-y-auto scrollbar-thin">
        {languageOptions.map((opt) => (
          <a
            href={opt.href}
            role="menuitem"
            data-locale-code={opt.code}
            class={`lang-choice-item flex items-center justify-between rounded-xl px-2.5 py-1.5 text-xs transition-all duration-200 ${
              opt.isActive
                ? 'bg-linear-to-r from-blue-50 to-blue-100/80 font-bold text-blue-700 shadow-sm dark:from-blue-950/60 dark:to-blue-900/40 dark:text-blue-300'
                : 'text-slate-700 hover:bg-linear-to-r hover:from-slate-50 hover:to-slate-100/50 hover:shadow-sm dark:text-slate-300 dark:hover:bg-slate-800'
            }`}
          >
            <div class="flex items-center gap-2">
              <span class="text-sm flag-hover">{opt.flag}</span>
              <div>
                <div class="font-medium leading-snug">{opt.nativeName}</div>
                <div class="text-[10px] text-slate-400 dark:text-slate-400 leading-none">{opt.name}</div>
              </div>
            </div>
            {opt.isActive && (
              <svg class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400 shrink-0 lang-check-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
)}

{LOCALES.length > 1 && variant === 'mobile' && (
  <div class={`space-y-1 ${className}`}>
    <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400 flex items-center gap-2">
      <span>🌍</span>
      <span>Language / भाषा / Idioma</span>
    </div>
    <div class="grid grid-cols-2 gap-1.5 pt-1">
      {languageOptions.map((opt) => (
        <a
          href={opt.href}
          data-locale-code={opt.code}
          class={`lang-choice-item flex items-center gap-2 rounded-xl border p-2.5 text-xs transition-all duration-200 language-badge ${
            opt.isActive
              ? 'border-blue-500 bg-linear-to-br from-blue-50 to-blue-100/80 font-bold text-blue-700 shadow-sm dark:border-blue-500/50 dark:from-blue-950/60 dark:to-blue-900/40 dark:text-blue-300'
              : 'border-slate-200 bg-white text-slate-700 hover:bg-linear-to-br hover:from-slate-50 hover:to-slate-100/50 hover:border-slate-300 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:border-slate-700'
          }`}
        >
          <span class="text-base flag-hover">{opt.flag}</span>
          <div class="overflow-hidden">
            <div class="truncate font-semibold">{opt.nativeName}</div>
            <div class="truncate text-[10px] text-slate-400 dark:text-slate-400 leading-tight">{opt.name}</div>
          </div>
          {opt.isActive && (
            <svg class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400 ml-auto shrink-0 lang-check-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          )}
        </a>
      ))}
    </div>
  </div>
)}

{LOCALES.length > 1 && (
<script>
  function initLanguageSwitcher() {
    const btn = document.getElementById('language-switcher-btn');
    const menu = document.getElementById('language-switcher-menu');

    function openMenu() {
      btn?.setAttribute('aria-expanded', 'true');
      menu?.classList.remove('hidden');
      requestAnimationFrame(() => {
        menu?.classList.remove('opacity-0', 'scale-95');
        menu?.classList.add('opacity-100', 'scale-100');
      });
    }

    function closeMenu() {
      btn?.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('opacity-100', 'scale-100');
      menu?.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        menu?.classList.add('hidden');
      }, 150);
    }

    if (btn && menu) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      document.addEventListener('click', (e) => {
        if (!btn.contains(e.target as Node) && !menu.contains(e.target as Node)) {
          if (btn.getAttribute('aria-expanded') === 'true') {
            closeMenu();
          }
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          btn.focus();
        }
      });
    }

    // Persist language choice when clicking any language option
    document.querySelectorAll('[data-locale-code]').forEach((link) => {
      link.addEventListener('click', () => {
        const code = link.getAttribute('data-locale-code');
        if (code) {
          try {
            sessionStorage.setItem('lang_just_switched', 'true');
            localStorage.setItem('preferred_locale', code);
            document.cookie = `preferred_locale=${code}; path=/; max-age=31536000; SameSite=Lax`;
          } catch (e) {}
        }
      });
    });

    // Client-side locale sync: dynamically bind to current URL / active route to prevent SSR edge cache mismatch
    const LOCALES_METADATA: Record<string, { flag: string; nativeName: string; code: string }> = {
      en: { flag: '🇺🇸', nativeName: 'English', code: 'EN' },
      hi: { flag: '🇮🇳', nativeName: 'हिन्दी', code: 'HI' },
      es: { flag: '🇪🇸', nativeName: 'Español', code: 'ES' },
      ja: { flag: '🇯🇵', nativeName: '日本語', code: 'JA' },
      fr: { flag: '🇫🇷', nativeName: 'Français', code: 'FR' },
      de: { flag: '🇩🇪', nativeName: 'Deutsch', code: 'DE' },
      pt: { flag: '🇧🇷', nativeName: 'Português', code: 'PT' },
      ko: { flag: '🇰🇷', nativeName: '한국어', code: 'KO' },
      it: { flag: '🇮🇹', nativeName: 'Italiano', code: 'IT' },
    };

    function resolveCurrentPageLocale(): string {
      // 1. Current URL pathname is the primary source of truth (e.g. /es/..., /hi/...)
      const path = (window.location.pathname || '/').toLowerCase();
      const segments = path.split('/').filter(Boolean);
      if (segments.length > 0) {
        const firstSegment = segments[0];
        if (firstSegment in LOCALES_METADATA && firstSegment !== 'en') {
          return firstSegment;
        }
      }

      // 2. Query param ?lang= if present and valid
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const qLang = (urlParams.get('lang') || '').toLowerCase();
        if (qLang in LOCALES_METADATA) {
          return qLang;
        }
      } catch (e) {}

      // 3. Document language attribute (set by server during SSR)
      const htmlLang = (document.documentElement.lang || '').slice(0, 2).toLowerCase();
      if (htmlLang in LOCALES_METADATA && htmlLang !== 'en') {
        return htmlLang;
      }

      // 4. Default is strictly 'en' for root and un-prefixed routes
      return 'en';
    }

    function syncLanguageState() {
      const activeLocale = resolveCurrentPageLocale();
      const meta = LOCALES_METADATA[activeLocale] || LOCALES_METADATA.en;

      // Update button flag, name, code, and data attribute
      const btnFlag = document.querySelector('.language-btn-flag');
      const btnName = document.querySelector('.language-btn-name');
      const btnCode = document.querySelector('.language-btn-code');
      const switchBtn = document.getElementById('language-switcher-btn');

      if (btnFlag && btnFlag.textContent !== meta.flag) btnFlag.textContent = meta.flag;
      if (btnName && btnName.textContent !== meta.nativeName) btnName.textContent = meta.nativeName;
      if (btnCode && btnCode.textContent !== meta.code) btnCode.textContent = meta.code;
      if (switchBtn) switchBtn.setAttribute('data-current-lang', activeLocale);

      // Update active checkmarks in desktop dropdown menu
      document.querySelectorAll('.language-switcher-dropdown .lang-choice-item').forEach((item) => {
        const itemCode = item.getAttribute('data-locale-code');
        const isActive = itemCode === activeLocale;
        if (isActive) {
          item.classList.add(
            'bg-linear-to-r',
            'from-blue-50',
            'to-blue-100/80',
            'font-bold',
            'text-blue-700',
            'shadow-sm',
            'dark:from-blue-950/60',
            'dark:to-blue-900/40',
            'dark:text-blue-300'
          );
          item.classList.remove('text-slate-700', 'dark:text-slate-300');
          if (!item.querySelector('.lang-check-svg')) {
            const checkSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            checkSvg.setAttribute('class', 'h-3.5 w-3.5 text-blue-600 dark:text-blue-400 shrink-0 lang-check-svg');
            checkSvg.setAttribute('fill', 'none');
            checkSvg.setAttribute('viewBox', '0 0 24 24');
            checkSvg.setAttribute('stroke', 'currentColor');
            checkSvg.setAttribute('stroke-width', '2.5');
            checkSvg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />';
            item.appendChild(checkSvg);
          }
        } else {
          item.classList.remove(
            'bg-linear-to-r',
            'from-blue-50',
            'to-blue-100/80',
            'font-bold',
            'text-blue-700',
            'shadow-sm',
            'dark:from-blue-950/60',
            'dark:to-blue-900/40',
            'dark:text-blue-300'
          );
          item.classList.add('text-slate-700', 'dark:text-slate-300');
          const existingCheck = item.querySelector('.lang-check-svg');
          if (existingCheck) existingCheck.remove();
        }
      });

      // Update active checkmarks in mobile language list
      document.querySelectorAll('.language-badge.lang-choice-item').forEach((item) => {
        const itemCode = item.getAttribute('data-locale-code');
        const isActive = itemCode === activeLocale;
        if (isActive) {
          item.classList.add(
            'border-blue-500',
            'bg-linear-to-br',
            'from-blue-50',
            'to-blue-100/80',
            'font-bold',
            'text-blue-700',
            'shadow-sm',
            'dark:border-blue-500/50',
            'dark:from-blue-950/60',
            'dark:to-blue-900/40',
            'dark:text-blue-300'
          );
          item.classList.remove('border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
          if (!item.querySelector('.lang-check-svg')) {
            const checkSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            checkSvg.setAttribute('class', 'h-3.5 w-3.5 text-blue-600 dark:text-blue-400 ml-auto shrink-0 lang-check-svg');
            checkSvg.setAttribute('fill', 'none');
            checkSvg.setAttribute('viewBox', '0 0 24 24');
            checkSvg.setAttribute('stroke', 'currentColor');
            checkSvg.setAttribute('stroke-width', '2.5');
            checkSvg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />';
            item.appendChild(checkSvg);
          }
        } else {
          item.classList.remove(
            'border-blue-500',
            'bg-linear-to-br',
            'from-blue-50',
            'to-blue-100/80',
            'font-bold',
            'text-blue-700',
            'shadow-sm',
            'dark:border-blue-500/50',
            'dark:from-blue-950/60',
            'dark:to-blue-900/40',
            'dark:text-blue-300'
          );
          item.classList.add('border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
          const existingCheck = item.querySelector('.lang-check-svg');
          if (existingCheck) existingCheck.remove();
        }
      });
    }

    syncLanguageState();
  }

  // Run on first load and after Astro View Transitions
  initLanguageSwitcher();
  document.addEventListener('astro:page-load', initLanguageSwitcher);
</script>

)}
