---
import { categories } from '../data/calculators';
import { CATEGORIES_CONFIG } from '../i18n/translations/categories';
import { getCommonTranslations } from '../i18n/translations/common';
import { getLocalizedPath, extractLocaleFromPath } from '../i18n/utils';
import { isValidLocale, type Locale } from '../i18n/config';

interface Props {
  activeCategory?: string;
  lang?: Locale;
}

const { activeCategory = 'all', lang: propLang } = Astro.props;

const localsLang = (Astro.locals as any)?.locale;
const detectedLang = extractLocaleFromPath(Astro.url.pathname).lang;
const lang: Locale = propLang || (localsLang && isValidLocale(localsLang) ? (localsLang as Locale) : null) || detectedLang || 'en';
const tCommon = getCommonTranslations(lang);

const allLabel = tCommon.nav.allCalculators;

const tabs = [
  { id: 'all', name: allLabel, icon: '✨', path: getLocalizedPath('/all-calculators/', lang) },
  ...categories.map((c) => {
    const catKey = c.name.toLowerCase() as keyof typeof CATEGORIES_CONFIG;
    const localizedName = CATEGORIES_CONFIG[catKey]?.names[lang];
    if (!localizedName) throw new Error(`[i18n] Missing category name for ${catKey} in ${lang}`);
    return {
      id: c.name.toLowerCase(),
      name: localizedName,
      icon: c.icon,
      path: getLocalizedPath(c.path, lang),
    };
  }),
];
---

<div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
  {tabs.map((tab) => {
    const isSelected = tab.id === activeCategory.toLowerCase();
    return (
      <a
        href={tab.path}
        class={`inline-flex shrink-0 items-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold transition-all ${
          isSelected
            ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20'
            : 'border border-slate-200 bg-white text-slate-700 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800'
        }`}
      >
        <span>{tab.icon}</span>
        <span>{tab.name}</span>
      </a>
    );
  })}
</div>
