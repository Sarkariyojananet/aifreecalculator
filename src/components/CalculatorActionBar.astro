---
interface Props {
  calculatorName: string;
  slug: string;
  category: string;
}

const { calculatorName, slug, category } = Astro.props;
---

<div
  id="calc-action-bar-container"
  class="hidden mt-6 pt-5 border-t border-slate-200/90 dark:border-slate-800 transition-opacity duration-200"
  data-calculator-name={calculatorName}
  data-slug={slug}
  data-category={category}
>
  <div class="rounded-2xl border border-slate-200/80 bg-slate-50/70 p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900/60 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-3 border-b border-slate-200/70 dark:border-slate-800/80">
      <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200 flex items-center gap-2">
        <span>Save or share this calculation</span>
      </h3>
      <button
        type="button"
        id="btn-view-saved-projects"
        class="self-start sm:self-auto inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline cursor-pointer"
        title="View previously saved calculations"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
        <span>My Saved Projects</span>
        <span id="saved-projects-counter" class="hidden rounded-full bg-blue-100 px-1.5 py-0.2 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">0</span>
      </button>
    </div>

    <!-- Action Buttons Row matching provided design (Order: Share, Copy, CSV, Preview, Print/PDF, Save to Project) -->
    <div class="mt-3 flex flex-wrap items-center gap-2 sm:gap-2.5">
      
      <!-- 1. Share Link (Opens Share Modal matching Image 2) -->
      <button
        type="button"
        id="btn-open-share-modal"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs sm:text-sm font-semibold text-slate-700 shadow-2xs hover:bg-slate-100 active:scale-[0.98] transition cursor-pointer dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        title="Share calculation with active inputs"
      >
        <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span>Share</span>
      </button>

      <!-- 2. Copy Results (Copies BOTH inputs and results) -->
      <button
        type="button"
        id="btn-copy-calc-results"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs sm:text-sm font-semibold text-slate-700 shadow-2xs hover:bg-slate-100 active:scale-[0.98] transition cursor-pointer dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        title="Copy complete inputs and calculation results to clipboard"
      >
        <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span id="txt-copy-results">Copy results</span>
      </button>

      <!-- 3. Download CSV (Exports inputs, outputs, and tables) -->
      <button
        type="button"
        id="btn-download-calc-csv"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs sm:text-sm font-semibold text-slate-700 shadow-2xs hover:bg-slate-100 active:scale-[0.98] transition cursor-pointer dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        title="Download complete inputs, results, and breakdown table as a CSV spreadsheet"
      >
        <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>Download CSV</span>
      </button>

      <!-- 4. Preview (Opens in New Tab with website & calculator name) -->
      <button
        type="button"
        id="btn-preview-calc"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs sm:text-sm font-semibold text-slate-700 shadow-2xs hover:bg-slate-100 active:scale-[0.98] transition cursor-pointer dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        title="Open formal calculation report preview in a new tab"
      >
        <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>Preview</span>
      </button>

      <!-- 5. Print / PDF (Filled Teal Button) -->
      <button
        type="button"
        id="btn-print-calc"
        class="inline-flex items-center gap-2 rounded-xl bg-[#007b8f] hover:bg-[#00687a] px-4 py-2 text-xs sm:text-sm font-bold text-white shadow-xs active:scale-[0.98] transition cursor-pointer"
        title="Print Given Values, Formula & Outputs only"
      >
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
        </svg>
        <span>Print / PDF</span>
      </button>

      <!-- 6. Save to Project (With Attached Dropdown Popover matching Image 1) -->
      <div class="relative inline-block" id="popover-save-project-wrapper">
        <button
          type="button"
          id="btn-save-to-project"
          class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs sm:text-sm font-semibold text-slate-700 shadow-2xs hover:bg-slate-100 active:scale-[0.98] transition cursor-pointer dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
          title="Save this calculation under a specific project name"
        >
          <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
            <polyline points="17 21 17 13 7 13 7 21"></polyline>
            <polyline points="7 3 7 8 15 8"></polyline>
          </svg>
          <span id="txt-save-project">Save to Project</span>
        </button>

        <!-- Attached Dropdown Popover matching Screenshot Image 1 -->
        <div
          id="popover-save-project"
          class="hidden absolute right-0 top-full mt-2 w-72 sm:w-80 rounded-2xl border border-slate-200 bg-white p-4 shadow-xl z-50 dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-center justify-between pb-2 mb-1 border-b border-slate-100 dark:border-slate-800">
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Save to Project</h4>
            <span id="popover-status-badge" class="hidden text-[11px] font-bold text-emerald-600">Saved ✓</span>
          </div>

          <!-- Existing Projects List -->
          <div id="popover-project-list" class="max-h-36 overflow-y-auto space-y-1 my-2 pr-0.5">
            <!-- Dynamically populated: e.g. sac  1 calc -->
          </div>

          <hr class="border-slate-100 dark:border-slate-800 my-2" />

          <!-- Create New Project Row -->
          <div class="flex items-center gap-1.5">
            <input
              type="text"
              id="popover-new-project-name"
              placeholder="New project name"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2 text-xs text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-hidden focus:border-[#007b8f]"
            />
            <button
              type="button"
              id="popover-btn-create-project"
              class="shrink-0 rounded-xl bg-[#007b8f] hover:bg-[#00687a] px-3.5 py-2 text-xs font-bold text-white shadow-xs cursor-pointer transition active:scale-[0.98]"
            >
              Create
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Feedback Toast Alert -->
    <div
      id="calc-action-toast"
      class="hidden mt-3 rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-xs font-bold text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 flex items-center justify-between"
      role="status"
    >
      <span id="calc-action-toast-msg">Calculation copied!</span>
      <button type="button" id="btn-close-toast" class="text-emerald-600 hover:text-emerald-800 font-bold ml-2">✕</button>
    </div>
  </div>
</div>

<!-- ================================================================= -->
<!-- MODAL 1: SHARE CALCULATION (Matching user screenshot)             -->
<!-- ================================================================= -->
<div
  id="modal-share-calculation"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-share-title"
>
  <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900 my-8">
    <div class="flex items-center justify-between border-b border-slate-200 pb-3.5 dark:border-slate-800">
      <h2 id="modal-share-title" class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
        {calculatorName} Calculation
      </h2>
      <button
        type="button"
        id="btn-close-share-modal"
        class="rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200 transition text-lg"
        aria-label="Close dialog"
      >
        ✕
      </button>
    </div>

    <div class="mt-4 space-y-4">
      <div>
        <label for="inp-share-url" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
          Shareable URL
        </label>
        <div class="mt-1.5 flex gap-2">
          <input
            type="text"
            id="inp-share-url"
            readonly
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-xs font-medium text-slate-700 select-all dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
          />
          <button
            type="button"
            id="btn-copy-share-url"
            class="shrink-0 inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer shadow-2xs"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="txt-copy-share-url">Copy</span>
          </button>
        </div>
      </div>

      <!-- Action Share Buttons Row matching screenshot -->
      <div class="flex items-center gap-2 pt-1">
        <button
          type="button"
          id="btn-action-share-native"
          class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-[#007b8f] hover:bg-[#00687a] px-4 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs transition active:scale-[0.98] cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
          </svg>
          <span>Share</span>
        </button>

        <a
          id="share-btn-x"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition text-sm font-black cursor-pointer shadow-2xs"
          title="Share on X (Twitter)"
        >
          𝕏
        </a>

        <a
          id="share-btn-linkedin"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-300 bg-white text-blue-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 transition text-xs font-black cursor-pointer shadow-2xs"
          title="Share on LinkedIn"
        >
          in
        </a>

        <a
          id="share-btn-email"
          href="#"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer shadow-2xs"
          title="Share via Email"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>
      </div>

      <p class="text-[11px] text-slate-500 dark:text-slate-400">
        This link includes all current input values. Recipients can view and modify the calculation.
      </p>
    </div>
  </div>
</div>

<!-- ================================================================= -->
<!-- MODAL 2: SAVE TO PROJECT                                          -->
<!-- ================================================================= -->
<div
  id="modal-save-project"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-save-title"
>
  <div class="relative w-full max-w-lg rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900 my-8">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 dark:border-slate-800">
      <div class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-100 text-lg text-blue-700 dark:bg-blue-950 dark:text-blue-300">
          📁
        </span>
        <div>
          <h2 id="modal-save-title" class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white">
            Save to Project
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Organize this calculation under a project for future reference.
          </p>
        </div>
      </div>
      <button
        type="button"
        id="btn-close-save-modal"
        class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200 transition"
        aria-label="Close dialog"
      >
        ✕
      </button>
    </div>

    <form id="form-save-project" class="mt-4 space-y-4" onsubmit="return false;">
      <div>
        <label for="inp-project-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          Project Name <span class="text-red-500">*</span>
        </label>
        <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
          Enter a new project name or pick an existing project from the list below.
        </p>
        <div class="relative mt-1.5">
          <input
            type="text"
            id="inp-project-name"
            list="datalist-existing-projects"
            placeholder="e.g. Ground Floor Slab, Dream Home Loan, Fitness 2026..."
            required
            class="w-full rounded-xl border-2 border-slate-300 bg-white px-3.5 py-2.5 text-sm font-bold text-slate-900 shadow-2xs transition focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          />
          <datalist id="datalist-existing-projects">
            <!-- Populated from localStorage -->
          </datalist>
        </div>
      </div>

      <div>
        <label for="inp-calc-title" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          Calculation Title / Tag
        </label>
        <input
          type="text"
          id="inp-calc-title"
          placeholder="e.g. 75 kg weight conversion, 10-Yr SIP ₹5000"
          class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
      </div>

      <div>
        <label for="inp-calc-notes" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          Notes / Remarks <span class="text-[10px] font-normal text-slate-400">(Optional)</span>
        </label>
        <textarea
          id="inp-calc-notes"
          rows="2"
          placeholder="Add any specific client, material, or rate assumptions..."
          class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-medium text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        ></textarea>
      </div>

      <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 text-xs dark:border-slate-800 dark:bg-slate-950/50">
        <div class="font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
          <span id="save-preview-calc-name">{calculatorName}</span>
          <span id="save-preview-timestamp" class="text-[10px] font-normal text-slate-500">Just now</span>
        </div>
        <div id="save-preview-summary" class="mt-1.5 text-[11px] text-slate-600 dark:text-slate-400 space-y-0.5 max-h-24 overflow-y-auto">
          <!-- Populated by JS -->
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="button"
          id="btn-cancel-save-modal"
          class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="btn-confirm-save-project"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-5 py-2 text-xs font-bold text-white shadow-sm hover:bg-blue-700 active:scale-[0.98] transition cursor-pointer"
        >
          <span>💾</span>
          <span>Save to Project</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================================================================= -->
<!-- MODAL 3: SAVED PROJECTS & CALCULATIONS MANAGER                    -->
<!-- ================================================================= -->
<div
  id="modal-saved-projects"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-saved-projects-title"
>
  <div class="relative w-full max-w-2xl rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900 my-8">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 dark:border-slate-800">
      <div class="flex items-center gap-2.5">
        <span class="text-xl">🗂️</span>
        <div>
          <h2 id="modal-saved-projects-title" class="text-base sm:text-lg font-black text-slate-900 dark:text-white">
            My Saved Projects
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            View, review, or export your saved calculations organized by project.
          </p>
        </div>
      </div>
      <button
        type="button"
        id="btn-close-saved-projects-modal"
        class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200 transition"
        aria-label="Close saved projects"
      >
        ✕
      </button>
    </div>

    <!-- Saved Projects List -->
    <div id="saved-projects-content" class="mt-4 max-h-96 overflow-y-auto space-y-4 pr-1">
      <!-- Populated dynamically -->
    </div>

    <div class="mt-6 flex items-center justify-between pt-4 border-t border-slate-200 dark:border-slate-800 text-xs">
      <button
        type="button"
        id="btn-clear-all-saved"
        class="text-red-500 hover:text-red-700 font-semibold cursor-pointer"
      >
        Clear All Saved Calculations
      </button>
      <button
        type="button"
        id="btn-close-saved-projects-bottom"
        class="rounded-xl border border-slate-300 px-4 py-2 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 cursor-pointer"
      >
        Close
      </button>
    </div>
  </div>
</div>

<!-- ================================================================= -->
<!-- CLIENT-SIDE LOGIC                                                 -->
<!-- ================================================================= -->
<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;

    var STORAGE_KEY = 'aifreecalc_saved_projects';

    function initActionBar() {
      var barContainer = document.getElementById('calc-action-bar-container');
      if (!barContainer) return;

      var calcName = barContainer.getAttribute('data-calculator-name') || document.title;
      var calcSlug = barContainer.getAttribute('data-slug') || '';
      var calcCategory = barContainer.getAttribute('data-category') || '';

      // Toast feedback helper
      var toastEl = document.getElementById('calc-action-toast');
      var toastMsgEl = document.getElementById('calc-action-toast-msg');
      var toastTimer = null;

      function showToast(message, isError) {
        if (!toastEl || !toastMsgEl) return;
        toastMsgEl.textContent = message;
        if (isError) {
          toastEl.className = 'mt-3 rounded-xl border border-red-200 bg-red-50 px-3.5 py-2 text-xs font-bold text-red-800 dark:border-red-900/60 dark:bg-red-950/40 dark:text-red-300 flex items-center justify-between';
        } else {
          toastEl.className = 'mt-3 rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-xs font-bold text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 flex items-center justify-between';
        }
        toastEl.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toastEl.classList.add('hidden');
        }, 4000);
      }

      var btnCloseToast = document.getElementById('btn-close-toast');
      if (btnCloseToast) {
        btnCloseToast.addEventListener('click', function () {
          if (toastEl) toastEl.classList.add('hidden');
        });
      }

      // Auto-populate inputs if opened with shareable URL parameters
      function autoPopulateFromUrl() {
        if (!window.location.search) return;
        try {
          var params = new URLSearchParams(window.location.search);
          var hasApplied = false;

          params.forEach(function (val, key) {
            var el = document.getElementById(key) || document.querySelector('[name="' + key + '"]');
            if (el) {
              if (el.type === 'checkbox') {
                el.checked = val === '1' || val === 'true';
              } else if (el.type === 'radio') {
                var radio = document.querySelector('input[name="' + key + '"][value="' + val + '"]');
                if (radio) radio.checked = true;
              } else {
                el.value = val;
              }
              el.dispatchEvent(new Event('input', { bubbles: true }));
              el.dispatchEvent(new Event('change', { bubbles: true }));
              hasApplied = true;
            }
          });

          if (hasApplied) {
            setTimeout(function () {
              var calcBtn = document.querySelector('button[id*="calc"], button[id*="convert"], form button[type="submit"]');
              if (calcBtn) {
                calcBtn.click();
              }
            }, 120);
          }
        } catch (e) {}
      }
      autoPopulateFromUrl();

      // Update project counter
      function updateSavedCounter() {
        try {
          var data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
          var totalItems = 0;
          var datalist = document.getElementById('datalist-existing-projects');
          if (datalist) datalist.innerHTML = '';

          for (var proj in data) {
            if (Object.prototype.hasOwnProperty.call(data, proj)) {
              totalItems += (data[proj] || []).length;
              if (datalist) {
                var opt = document.createElement('option');
                opt.value = proj;
                datalist.appendChild(opt);
              }
            }
          }
          var counterEl = document.getElementById('saved-projects-counter');
          if (counterEl) {
            if (totalItems > 0) {
              counterEl.textContent = String(totalItems);
              counterEl.classList.remove('hidden');
            } else {
              counterEl.classList.add('hidden');
            }
          }
        } catch (e) {}
      }
      updateSavedCounter();

      // Find if any results container is currently visible
      function getActiveResultContainer() {
        var container = barContainer.parentElement;
        if (!container) return null;

        var selectors = [
          '#results-section',
          '#results-card',
          '#results-box',
          '#age-result',
          '#gpa-results-card',
          '#sip-results-section',
          '#emi-results-section',
          '#mg-results-section',
          '#am-results-section',
          '#gst-results-section',
          '#tax-results-section',
          '#sal-results-section',
          '#st-results-section',
          '#ln-results-section',
          '#ret-results-section',
          '#disc-results-section',
          '#ci-results-section',
          '#si-results-section',
          '#auto-results-section',
          '#pm-results-section',
          '#gold-results-box',
          '#hw-results-box',
          '[id*="results-"]',
          '[id*="-results"]',
          '[id*="-result"]'
        ];

        for (var i = 0; i < selectors.length; i++) {
          var els = container.querySelectorAll(selectors[i]);
          for (var j = 0; j < els.length; j++) {
            var el = els[j];
            if (
              el &&
              el !== barContainer &&
              !el.closest('#calc-action-bar-container') &&
              !el.closest('[role="dialog"]') &&
              !el.classList.contains('hidden') &&
              el.offsetHeight > 30
            ) {
              return el;
            }
          }
        }
        return null;
      }

      // Safe sync
      var isSyncing = false;
      function syncBarVisibility() {
        if (isSyncing) return;
        isSyncing = true;
        try {
          var resContainer = getActiveResultContainer();
          var isHidden = barContainer.classList.contains('hidden');

          if (resContainer) {
            if (isHidden) {
              barContainer.classList.remove('hidden');
            }
          } else {
            if (!isHidden) {
              barContainer.classList.add('hidden');
            }
          }
        } catch (e) {
        } finally {
          setTimeout(function () {
            isSyncing = false;
          }, 60);
        }
      }

      // Observe parent card
      var parentCard = barContainer.parentElement;
      if (parentCard && window.MutationObserver) {
        var debounceTimer = null;
        var observer = new MutationObserver(function (mutations) {
          if (isSyncing) return;
          var shouldCheck = false;
          for (var m = 0; m < mutations.length; m++) {
            var tgt = mutations[m].target;
            if (tgt && tgt !== barContainer && !barContainer.contains(tgt)) {
              shouldCheck = true;
              break;
            }
          }
          if (!shouldCheck) return;

          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = setTimeout(syncBarVisibility, 80);
        });

        observer.observe(parentCard, {
          attributes: true,
          attributeFilter: ['class', 'style'],
          childList: true,
          subtree: true
        });
      }

      document.addEventListener('submit', function () {
        setTimeout(syncBarVisibility, 80);
      });
      document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest('button');
        if (btn && (btn.id.includes('calc') || btn.id.includes('generate') || btn.id.includes('compute') || btn.id.includes('convert') || btn.id.includes('clear') || btn.id.includes('reset') || btn.id.includes('preset') || btn.type === 'submit')) {
          setTimeout(syncBarVisibility, 80);
        }
      });
      document.addEventListener('calculator:updated', function () {
        setTimeout(syncBarVisibility, 50);
      });
      setTimeout(syncBarVisibility, 200);

      // Generate shareable URL with parameters
      function generateShareableUrl() {
        var url = new URL(window.location.origin + window.location.pathname);
        var container = barContainer.parentElement || document.body;
        var inputElements = container.querySelectorAll('input:not([type="hidden"]):not([type="submit"]):not([type="button"]):not(#inp-project-name):not(#inp-calc-title):not(#inp-calc-notes):not(#inp-share-url), select:not(#inp-project-name), textarea:not(#inp-calc-notes)');

        inputElements.forEach(function (inp) {
          if (!inp.offsetParent) return;
          var key = inp.id || inp.name;
          if (!key) return;

          var val = '';
          if (inp.type === 'checkbox') {
            val = inp.checked ? '1' : '0';
          } else if (inp.type === 'radio') {
            if (!inp.checked) return;
            val = inp.value;
          } else {
            val = inp.value;
          }

          if (val !== '') {
            url.searchParams.set(key, val);
          }
        });

        return url.toString();
      }

      // Comprehensive Data Extraction (inputs, results, tables)
      function extractCalculationData() {
        var inputs = [];
        var results = [];
        var tables = [];
        var container = barContainer.parentElement || document.body;

        // 1. Gather all inputs
        var inputElements = container.querySelectorAll('input:not([type="hidden"]):not([type="submit"]):not([type="button"]):not(#inp-project-name):not(#inp-calc-title):not(#inp-calc-notes):not(#inp-share-url), select:not(#inp-project-name), textarea:not(#inp-calc-notes)');
        inputElements.forEach(function (inp) {
          if (!inp.offsetParent) return;
          var label = '';
          if (inp.id) {
            var lbl = document.querySelector('label[for="' + inp.id + '"]');
            if (lbl) label = lbl.textContent.trim();
          }
          if (!label) {
            var parentLbl = inp.closest('label');
            if (parentLbl) label = parentLbl.textContent.trim();
          }
          if (!label && inp.placeholder) {
            label = inp.placeholder;
          }
          if (!label && inp.name) {
            label = inp.name;
          }
          if (!label) return;

          label = label.replace(/\*/g, '').replace(/\s+/g, ' ').trim();

          var val = '';
          if (inp.tagName.toLowerCase() === 'select') {
            val = inp.options[inp.selectedIndex] ? inp.options[inp.selectedIndex].text.trim() : inp.value;
          } else if (inp.type === 'checkbox') {
            val = inp.checked ? 'Yes' : 'No';
          } else if (inp.type === 'radio') {
            if (!inp.checked) return;
            val = inp.value;
          } else {
            val = inp.value;
          }

          if (val) {
            inputs.push({ label: label, value: val });
          }
        });

        // 2. Gather results
        var resContainer = getActiveResultContainer();
        if (resContainer) {
          // A. Hero / Main highlighted metrics
          var heroElements = resContainer.querySelectorAll('[id*="hero"], [id*="main"], [id*="primary"], [id*="future-val"], [id*="monthly-emi"], [id*="bmi"], [id*="total-steel"], [id*="concrete"], [id*="res-total"], [id*="res-excavation"], [id*="res-steel"], [id*="res-shuttering"]');
          heroElements.forEach(function (h) {
            var text = (h.textContent || '').trim().replace(/\s+/g, ' ');
            if (text && text !== '--' && text !== '-- m³' && text !== '-- kg' && text.length < 60 && !h.closest('button')) {
              var prevLbl = h.previousElementSibling;
              var labelText = prevLbl ? prevLbl.textContent.trim() : '';
              if (!labelText) {
                var pCard = h.closest('div');
                var headerEl = pCard ? pCard.querySelector('[class*="uppercase"], [class*="text-slate-500"], [class*="text-slate-400"]') : null;
                if (headerEl && headerEl !== h) labelText = headerEl.textContent.trim();
              }
              if (!labelText) {
                labelText = h.id.replace(/^res-/, '').replace(/-/g, ' ').toUpperCase();
              }
              labelText = labelText.replace(/\s+/g, ' ').trim();
              if (labelText && !results.some(function (r) { return r.label === labelText; })) {
                results.push({ label: labelText, value: text, isHero: true });
              }
            }
          });

          // B. Result Cards (handles multi-line, structured divs & sub-metrics)
          var cardItems = resContainer.querySelectorAll('.unit-result-card, [class*="rounded-xl"], [class*="rounded-2xl"]');
          cardItems.forEach(function (card) {
            if (card.querySelector('table') || card.closest('table') || card === barContainer || barContainer.contains(card)) return;

            var lblEl = card.querySelector('[class*="uppercase"], label, .text-xs, .text-\\[11px\\], .text-\\[10px\\], span:first-child');
            var valEl = card.querySelector('[class*="font-black"], [class*="font-bold"], .text-lg, .text-xl, .text-2xl, .text-3xl, [id^="res-"], [id^="mat-"]');
            var subValEl = card.querySelector('[class*="text-slate-400"], [class*="text-slate-500"], .text-\\[11px\\], .text-\\[10px\\]');

            if (lblEl && valEl && lblEl !== valEl) {
              var lText = lblEl.textContent.trim().replace(/\s+/g, ' ');
              var vText = valEl.textContent.trim().replace(/\s+/g, ' ');
              if (subValEl && subValEl !== lblEl && subValEl !== valEl) {
                var sText = subValEl.textContent.trim().replace(/\s+/g, ' ');
                if (sText && sText !== vText && !vText.includes(sText) && sText !== '--' && sText.length < 50) {
                  vText += ' (' + sText + ')';
                }
              }
              if (lText && vText && vText !== '--' && vText !== '-- m³' && vText !== '-- kg' && !results.some(function (r) { return r.label.toLowerCase() === lText.toLowerCase(); })) {
                results.push({
                  label: lText,
                  value: vText,
                  isHero: valEl.classList.contains('text-xl') || valEl.classList.contains('text-2xl') || valEl.classList.contains('text-3xl')
                });
                return;
              }
            }

            // Fallback split by lines
            var text = (card.textContent || '').trim();
            if (text.length > 3 && text.length < 150) {
              var parts = text.split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
              if (parts.length >= 2) {
                var lbl = parts[0];
                var v = parts.slice(1).join(' ');
                if (lbl && v && v !== '--' && !results.some(function (r) { return r.label.toLowerCase() === lbl.toLowerCase(); })) {
                  results.push({ label: lbl, value: v, isHero: false });
                }
              }
            }
          });

          // C. Explicit fallback for all named result elements [id^="res-"], [id^="mat-"]
          var explicitValElements = resContainer.querySelectorAll('[id^="res-"], [id^="mat-"]');
          explicitValElements.forEach(function (el) {
            var vText = (el.textContent || '').trim().replace(/\s+/g, ' ');
            if (!vText || vText === '--' || vText === '-- m³' || vText === '-- kg' || vText.startsWith('--')) return;

            // Find matching label
            var p = el.parentElement;
            var lText = '';
            if (p) {
              var lCandidate = p.querySelector('[class*="uppercase"], label, .text-xs, .text-\\[11px\\], .text-\\[10px\\], div:first-child');
              if (lCandidate && lCandidate !== el) {
                lText = lCandidate.textContent.trim().replace(/\s+/g, ' ');
              }
            }
            if (!lText) {
              lText = el.id.replace(/^(res-|mat-)/, '').replace(/-/g, ' ');
              lText = lText.charAt(0).toUpperCase() + lText.slice(1);
            }

            if (lText && !results.some(function (r) { return r.label.toLowerCase() === lText.toLowerCase(); })) {
              results.push({ label: lText, value: vText, isHero: false });
            }
          });

          // D. Breakdown Tables
          var tblElements = resContainer.querySelectorAll('table');
          tblElements.forEach(function (tbl) {
            var headers = [];
            var ths = tbl.querySelectorAll('thead th, th');
            ths.forEach(function (th) {
              headers.push(th.textContent.trim().replace(/\s+/g, ' '));
            });

            var rows = [];
            var trs = tbl.querySelectorAll('tbody tr');
            trs.forEach(function (tr) {
              var rowData = [];
              var tds = tr.querySelectorAll('td');
              tds.forEach(function (td) {
                rowData.push(td.textContent.trim().replace(/\s+/g, ' '));
              });
              if (rowData.length > 0) {
                rows.push(rowData);
              }
            });

            if (headers.length > 0 && rows.length > 0) {
              tables.push({ headers: headers, rows: rows });
            }
          });
        }

        var uniqueResults = [];
        var seen = {};
        results.forEach(function (r) {
          var key = r.label.toLowerCase() + '::' + r.value.toLowerCase();
          if (!seen[key] && r.label.length < 80 && r.value.length < 120) {
            seen[key] = true;
            uniqueResults.push(r);
          }
        });

        return {
          calculatorName: calcName,
          slug: calcSlug,
          category: calcCategory,
          timestamp: new Date().toISOString(),
          formattedDate: new Date().toLocaleString(),
          url: window.location.href,
          shareableUrl: generateShareableUrl(),
          inputs: inputs,
          results: uniqueResults,
          tables: tables
        };
      }

      // ==============================================================
      // 1. COPY RESULTS (Both Inputs & Results Copied Thoroughly)
      // ==============================================================
      var btnCopy = document.getElementById('btn-copy-calc-results');
      if (btnCopy) {
        btnCopy.addEventListener('click', function () {
          var data = extractCalculationData();
          var lines = [];
          lines.push('==================================================');
          lines.push('AI FREE CALCULATOR - CALCULATION REPORT');
          lines.push('==================================================');
          lines.push('Calculator: ' + data.calculatorName);
          lines.push('Category: ' + data.category);
          lines.push('Date & Time: ' + data.formattedDate);
          lines.push('Shareable Link: ' + data.shareableUrl);
          lines.push('');

          // 1. Input Parameters
          lines.push('--------------------------------------------------');
          lines.push('1. INPUT PARAMETERS');
          lines.push('--------------------------------------------------');
          if (data.inputs.length === 0) {
            lines.push('• (Default / Live values used)');
          } else {
            data.inputs.forEach(function (inp) {
              lines.push('• ' + inp.label + ': ' + inp.value);
            });
          }
          lines.push('');

          // 2. Calculation Results
          lines.push('--------------------------------------------------');
          lines.push('2. CALCULATION RESULTS');
          lines.push('--------------------------------------------------');
          if (data.results.length === 0) {
            lines.push('• (No result data detected)');
          } else {
            data.results.forEach(function (res) {
              lines.push('• ' + res.label + ': ' + res.value);
            });
          }
          lines.push('');

          // 3. Breakdown Tables (if any)
          if (data.tables.length > 0) {
            data.tables.forEach(function (tbl, tIdx) {
              lines.push('--------------------------------------------------');
              lines.push('3. BREAKDOWN TABLE ' + (data.tables.length > 1 ? (tIdx + 1) : ''));
              lines.push('--------------------------------------------------');
              lines.push(tbl.headers.join(' | '));
              tbl.rows.forEach(function (row) {
                lines.push(row.join(' | '));
              });
              lines.push('');
            });
          }

          lines.push('==================================================');
          lines.push('Calculated at https://aifreecalculator.com');
          lines.push('Free online tools & civil engineering estimators');
          lines.push('==================================================');

          var fullText = lines.join('\n');

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(fullText).then(function () {
              showToast('Both Inputs & Results copied to clipboard! ✓');
            }).catch(function () {
              fallbackCopy(fullText);
            });
          } else {
            fallbackCopy(fullText);
          }
        });
      }

      function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          showToast('Both Inputs & Results copied to clipboard! ✓');
        } catch (err) {
          showToast('Unable to copy automatically.', true);
        }
        document.body.removeChild(ta);
      }

      // ==============================================================
      // 2. DOWNLOAD CSV (Complete Report with Inputs & Results)
      // ==============================================================
      var btnDownloadCsv = document.getElementById('btn-download-calc-csv');
      if (btnDownloadCsv) {
        btnDownloadCsv.addEventListener('click', function () {
          var data = extractCalculationData();
          var csvLines = [];

          function escapeCsv(val) {
            var str = String(val == null ? '' : val).replace(/"/g, '""');
            return '"' + str + '"';
          }

          csvLines.push([escapeCsv('Calculator Report'), escapeCsv(data.calculatorName)].join(','));
          csvLines.push([escapeCsv('Category'), escapeCsv(data.category)].join(','));
          csvLines.push([escapeCsv('Generated Date'), escapeCsv(data.formattedDate)].join(','));
          csvLines.push([escapeCsv('Shareable Link'), escapeCsv(data.shareableUrl)].join(','));
          csvLines.push('');

          // Section 1: Inputs
          csvLines.push([escapeCsv('--- 1. INPUT PARAMETERS ---'), ''].join(','));
          csvLines.push([escapeCsv('Parameter Name'), escapeCsv('Input Value')].join(','));
          data.inputs.forEach(function (inp) {
            csvLines.push([escapeCsv(inp.label), escapeCsv(inp.value)].join(','));
          });
          csvLines.push('');

          // Section 2: Results
          csvLines.push([escapeCsv('--- 2. CALCULATION RESULTS ---'), ''].join(','));
          csvLines.push([escapeCsv('Metric / Output Description'), escapeCsv('Calculated Value')].join(','));
          data.results.forEach(function (res) {
            csvLines.push([escapeCsv(res.label), escapeCsv(res.value)].join(','));
          });
          csvLines.push('');

          // Section 3: Tables
          if (data.tables.length > 0) {
            data.tables.forEach(function (tbl, idx) {
              csvLines.push([escapeCsv('--- 3. DETAILED BREAKDOWN TABLE ' + (idx + 1) + ' ---')].join(','));
              csvLines.push(tbl.headers.map(escapeCsv).join(','));
              tbl.rows.forEach(function (row) {
                csvLines.push(row.map(escapeCsv).join(','));
              });
              csvLines.push('');
            });
          }

          csvLines.push([escapeCsv('---'), ''].join(','));
          csvLines.push([escapeCsv('Source'), escapeCsv('AI Free Calculator (https://aifreecalculator.com)')].join(','));

          var csvContent = '\uFEFF' + csvLines.join('\r\n');
          var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          var filename = (data.slug || 'calculation') + '-full-report.csv';

          if (navigator.msSaveBlob) {
            navigator.msSaveBlob(blob, filename);
          } else {
            var link = document.createElement('a');
            var url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', filename);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
          }

          showToast('Complete CSV report downloaded successfully! ✓');
        });
      }

      // ==============================================================
      // 3. PREVIEW IN NEW TAB (Website Name & Calculator Name on top)
      // ==============================================================
      var btnPreview = document.getElementById('btn-preview-calc');
      if (btnPreview) {
        btnPreview.addEventListener('click', function () {
          var data = extractCalculationData();
          openPreviewInNewTab(data);
        });
      }

      function openPreviewInNewTab(data) {
        var previewWin = window.open('', '_blank');
        if (!previewWin) {
          showToast('Please allow popups to open preview in a new tab.', true);
          return;
        }

        var inputsRowsHtml = '';
        if (data.inputs.length === 0) {
          inputsRowsHtml = '<tr><td colspan="2" style="padding:8px 12px;color:#94a3b8;font-style:italic;font-size:12px;">No input parameters specified</td></tr>';
        } else {
          data.inputs.forEach(function (inp, idx) {
            var bg = idx % 2 === 0 ? '#ffffff' : '#f8fafc';
            inputsRowsHtml += '<tr style="background:' + bg + ';border-bottom:1px solid #e2e8f0;">' +
              '<td style="padding:6.5px 12px;font-weight:600;color:#475569;font-size:12px;width:50%;">' + escapeHtml(inp.label) + '</td>' +
              '<td style="padding:6.5px 12px;font-weight:700;color:#0f172a;font-size:12px;width:50%;">' + escapeHtml(inp.value) + '</td>' +
              '</tr>';
          });
        }

        // Separate hero highlights and full results
        var heroList = data.results.filter(function (r) { return r.isHero; });
        if (heroList.length === 0 && data.results.length > 0) {
          heroList = data.results.slice(0, Math.min(4, data.results.length));
        } else if (heroList.length > 4) {
          heroList = heroList.slice(0, 4);
        }

        var heroHighlightsHtml = '';
        if (heroList.length > 0) {
          var heroCards = heroList.map(function (res) {
            return '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:8px 12px;">' +
              '<div style="font-size:10px;font-weight:700;text-transform:uppercase;color:#64748b;letter-spacing:0.4px;">' + escapeHtml(res.label) + '</div>' +
              '<div style="margin-top:2px;font-size:15px;font-weight:800;color:#0284c7;">' + escapeHtml(res.value) + '</div>' +
