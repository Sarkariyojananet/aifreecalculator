      if (btnCopyShareUrl && inpShareUrl) {
        btnCopyShareUrl.addEventListener('click', function () {
          var urlToCopy = inpShareUrl.value || generateShareableUrl();
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(urlToCopy).then(function () {
              if (txtCopyShareUrl) txtCopyShareUrl.textContent = 'Copied!';
              showToast('Shareable link copied! ✓');
              setTimeout(function () {
                if (txtCopyShareUrl) txtCopyShareUrl.textContent = 'Copy';
              }, 2500);
            });
          } else {
            inpShareUrl.select();
            document.execCommand('copy');
            if (txtCopyShareUrl) txtCopyShareUrl.textContent = 'Copied!';
            showToast('Shareable link copied! ✓');
            setTimeout(function () {
              if (txtCopyShareUrl) txtCopyShareUrl.textContent = 'Copy';
            }, 2500);
          }
        });
      }

      if (btnNativeShare) {
        btnNativeShare.addEventListener('click', function () {
          var shareUrl = inpShareUrl ? inpShareUrl.value : generateShareableUrl();
          var shareTitle = calcName + ' Calculation | AI Free Calculator';
          if (navigator.share) {
            navigator.share({
              title: shareTitle,
              text: 'Review this ' + calcName + ' calculation:',
              url: shareUrl
            }).catch(function () {});
          } else if (btnCopyShareUrl) {
            btnCopyShareUrl.click();
          }
        });
      }

      // ==============================================================
      // 6. SAVE TO PROJECT (Attached Popover matching Image 1)
      // ==============================================================
      var btnSaveProject = document.getElementById('btn-save-to-project');
      var popoverWrapper = document.getElementById('popover-save-project-wrapper');
      var popoverSave = document.getElementById('popover-save-project');
      var popoverList = document.getElementById('popover-project-list');
      var popoverInput = document.getElementById('popover-new-project-name');
      var popoverBtnCreate = document.getElementById('popover-btn-create-project');
      var popoverStatusBadge = document.getElementById('popover-status-badge');

      function renderPopoverProjects() {
        if (!popoverList) return;
        var existing = {};
        try {
          existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        } catch (e) {}

        var projectNames = Object.keys(existing);
        if (projectNames.length === 0) {
          popoverList.innerHTML = '<div class="text-[11px] text-slate-400 py-1.5 italic">No projects yet. Create one below:</div>';
          return;
        }

        var html = '';
        projectNames.forEach(function (proj) {
          var items = existing[proj] || [];
          html += '<button type="button" class="btn-popover-row w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800 transition text-left cursor-pointer" data-project="' + escapeHtml(proj) + '">' +
            '<span>' + escapeHtml(proj) + '</span>' +
            '<span class="text-slate-400 font-normal text-[11px]">' + items.length + ' calc' + (items.length === 1 ? '' : 's') + '</span>' +
            '</button>';
        });

        popoverList.innerHTML = html;

        popoverList.querySelectorAll('.btn-popover-row').forEach(function (rowBtn) {
          rowBtn.addEventListener('click', function () {
            var pName = rowBtn.getAttribute('data-project');
            saveCalculationRecord(pName);
          });
        });
      }

      function saveCalculationRecord(projectName) {
        var pName = (projectName || '').trim();
        if (!pName) return;

        var data = extractCalculationData();
        var record = {
          id: 'calc_' + Date.now(),
          projectName: pName,
          calculatorName: data.calculatorName,
          slug: data.slug,
          category: data.category,
          title: data.calculatorName + (data.results[0] ? ' - ' + data.results[0].value : ''),
          notes: '',
          timestamp: new Date().toISOString(),
          formattedDate: new Date().toLocaleString(),
          url: data.shareableUrl || window.location.href,
          inputs: data.inputs,
          results: data.results,
          tableSummary: data.tables.length > 0 ? (data.tables[0].headers.join(', ') + ' (' + data.tables[0].rows.length + ' rows)') : ''
        };

        try {
          var existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
          if (!existing[pName]) existing[pName] = [];
          existing[pName].unshift(record);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(existing));

          if (popoverStatusBadge) {
            popoverStatusBadge.textContent = 'Saved to ' + pName + ' ✓';
            popoverStatusBadge.classList.remove('hidden');
          }

          showToast('Saved to project "' + pName + '" successfully! ✓');
          window.dispatchEvent(new CustomEvent('saved-projects-updated'));
          updateSavedCounter();

          setTimeout(function () {
            closePopover();
            if (popoverStatusBadge) popoverStatusBadge.classList.add('hidden');
          }, 600);
        } catch (e) {
          showToast('Could not save to project.', true);
        }
      }

      function togglePopover() {
        if (!popoverSave) return;
        var isHidden = popoverSave.classList.contains('hidden');
        if (isHidden) {
          renderPopoverProjects();
          popoverSave.classList.remove('hidden');
          if (btnSaveProject) {
            btnSaveProject.classList.add('ring-2', 'ring-[#007b8f]', 'border-[#007b8f]');
          }
          if (popoverInput) popoverInput.focus();
        } else {
          closePopover();
        }
      }

      function closePopover() {
        if (popoverSave) popoverSave.classList.add('hidden');
        if (btnSaveProject) {
          btnSaveProject.classList.remove('ring-2', 'ring-[#007b8f]', 'border-[#007b8f]');
        }
      }

      if (btnSaveProject) {
        btnSaveProject.addEventListener('click', function (e) {
          e.stopPropagation();
          togglePopover();
        });
      }

      if (popoverBtnCreate) {
        popoverBtnCreate.addEventListener('click', function () {
          var newName = popoverInput ? popoverInput.value.trim() : '';
          if (newName) {
            saveCalculationRecord(newName);
            if (popoverInput) popoverInput.value = '';
          } else if (popoverInput) {
            popoverInput.focus();
          }
        });
      }

      if (popoverInput) {
        popoverInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            if (popoverBtnCreate) popoverBtnCreate.click();
          }
        });
      }

      document.addEventListener('click', function (e) {
        if (popoverWrapper && !popoverWrapper.contains(e.target)) {
          closePopover();
        }
      });

      // 7. My Saved Projects Manager (Dispatches to Header Modal)
      var btnViewSaved = document.getElementById('btn-view-saved-projects');
      if (btnViewSaved) {
        btnViewSaved.addEventListener('click', function () {
          window.dispatchEvent(new CustomEvent('open-my-projects'));
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeShareModal();
          closePopover();
        }
      });
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initActionBar);
    } else {
      initActionBar();
    }
  })();
</script>

