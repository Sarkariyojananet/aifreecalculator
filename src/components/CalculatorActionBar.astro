      function extractFormulas(slug, category) {
        var formulas = [];

        // 1. Look for explicit formula sections in content slot / article
        var contentSlot = document.querySelector('[slot="content"], article, .prose');
        if (contentSlot) {
          var formulaHeadings = contentSlot.querySelectorAll('h2, h3, h4');
          formulaHeadings.forEach(function (h) {
            var title = h.textContent.trim();
            if (/formula|equation|how.*calculated|calculation/i.test(title)) {
              var next = h.nextElementSibling;
              var items = [];
              while (next && !/^H[1-6]$/i.test(next.tagName) && items.length < 6) {
                if (next.tagName === 'UL' || next.tagName === 'OL') {
                  var lis = next.querySelectorAll('li');
                  lis.forEach(function (li) {
                    var t = li.textContent.trim().replace(/\s+/g, ' ');
                    if (t) items.push(t);
                  });
                } else if (next.tagName === 'PRE' || next.tagName === 'CODE' || next.tagName === 'P') {
                  var pt = next.textContent.trim().replace(/\s+/g, ' ');
                  if (pt && (pt.includes('=') || pt.includes('×') || pt.includes('÷') || pt.includes('+') || pt.includes('-') || pt.includes('*'))) {
                    items.push(pt);
                  }
                }
                next = next.nextElementSibling;
              }
              if (items.length > 0) {
                formulas.push({ heading: title, items: items });
              }
            }
          });
        }

        // 2. Built-in verified formulas fallback per calculator category/slug
        if (formulas.length === 0) {
          var s = (slug || '').toLowerCase();
          if (s.includes('footing')) {
            formulas.push({
              heading: 'Isolated Footing Steel & Concrete Formulas',
              items: [
                'Concrete Volume (m³) = Length (m) × Width (m) × Depth (m) × Number of Footings',
                'Bars in X Direction = ceil(Width / Spacing) + 1',
                'Bars in Y Direction = ceil(Length / Spacing) + 1',
                'Total Bars per Footing = Bars X + Bars Y',
                'Unit Weight of Rebar = (d² / 162) kg/m  (where d is rebar diameter in mm)',
                'Total Steel Weight (kg) = Total Rebar Length (m) × Unit Weight × Footing Count',
                'Pit Excavation Volume (m³) = (Length + 0.6) × (Width + 0.6) × (Depth + 1.0) × Footing Count'
              ]
            });
          } else if (s.includes('slab')) {
            formulas.push({
              heading: 'RCC Slab Concrete & Rebar Formulas',
              items: [
                'Wet Concrete Volume (m³) = Length (m) × Width (m) × Thickness (m)',
                'Dry Concrete Volume = Wet Volume × 1.54 (standard dry shrinkage allowance)',
                'Main Steel Bars Count = ceil(Longer Span / Spacing) + 1',
                'Distribution Bars Count = ceil(Shorter Span / Spacing) + 1',
                'Rebar Unit Weight = d² / 162 kg/m'
              ]
            });
          } else if (s.includes('column')) {
            formulas.push({
              heading: 'RCC Column Concrete & Steel Formulas',
              items: [
                'Concrete Volume = Length × Width × Height × Column Count',
                'Main Steel Weight = Number of Vertical Bars × Bar Length × (d² / 162)',
                'Lateral Ties Spacing = min(Least Column Dimension, 16 × d_main, 300 mm)'
              ]
            });
          } else if (s.includes('emi') || s.includes('loan')) {
            formulas.push({
              heading: 'Equated Monthly Installment (EMI) Formula',
              items: [
                'EMI = [P × r × (1 + r)^n] / [(1 + r)^n - 1]',
                'Where: P = Principal Loan Amount, r = Monthly Interest Rate (Annual Rate / 12 / 100), n = Loan Tenure in Months',
                'Total Repayment = EMI × n',
                'Total Interest Payable = Total Repayment - Principal'
              ]
            });
          } else if (s.includes('sip')) {
            formulas.push({
              heading: 'Systematic Investment Plan (SIP) Compound Formula',
              items: [
                'Future Value (M) = P × [((1 + i)^n - 1) / i] × (1 + i)',
                'Where: P = Monthly Investment, i = Monthly Rate of Return (Annual / 12 / 100), n = Total Months',
                'Total Investment = P × n',
                'Estimated Wealth Gain = Future Value - Total Investment'
              ]
            });
          } else if (s.includes('bmi')) {
            formulas.push({
              heading: 'Body Mass Index (BMI) Formula',
              items: [
                'Metric BMI = Weight (kg) / [Height (m)]²',
                'Imperial BMI = [Weight (lbs) / (Height (inches))²] × 703',
                'WHO Classification: Underweight (<18.5), Normal (18.5-24.9), Overweight (25-29.9), Obese (30+)'
              ]
            });
          } else {
            formulas.push({
              heading: 'Mathematical Calculation Model',
              items: [
                'Mathematical computations executed directly using verified algorithmic rules and standards.'
              ]
            });
          }
        }

        return formulas;
      }

