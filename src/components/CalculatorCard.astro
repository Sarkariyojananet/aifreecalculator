---
import type { Calculator } from '../data/calculators';

interface Props {
  calculator: Calculator;
  featured?: boolean;
}

const { calculator, featured = false } = Astro.props;
---

<a
  href={calculator.path}
  class={`group flex flex-col justify-between rounded-xl border bg-white p-5 shadow-xs transition hover:border-slate-400 dark:hover:border-slate-600 hover:shadow-sm dark:bg-slate-900 ${
    featured
      ? 'border-blue-300 dark:border-blue-900/60 bg-blue-50/20 dark:bg-blue-950/20'
      : 'border-slate-200 dark:border-slate-800'
  }`}
>
  <div>
    <!-- Category Label & Optional Featured Flag -->
    <div class="flex items-center justify-between">
      <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
        {calculator.category}
      </span>
      {featured && (
        <span class="text-[11px] font-semibold text-blue-600 dark:text-blue-400">
          Featured
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="mt-3 text-base font-bold text-slate-900 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 transition-colors">
      {calculator.name}
    </h3>

    <!-- Description -->
    <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-2">
      {calculator.description}
    </p>
  </div>

  <!-- Utility CTA -->
  <div class="mt-4 flex items-center pt-3 border-t border-slate-100 dark:border-slate-800/80 text-xs font-semibold text-blue-600 dark:text-blue-400">
    <span>Open Calculator</span>
    <span class="ml-1 group-hover:translate-x-1 transition-transform">→</span>
  </div>
</a>
