---
import { calculators } from '../../data/calculators';

const totalCount = calculators.length;

const popularSearches = [
  { label: 'EMI Calculator', query: 'emi' },
  { label: 'SIP Calculator', query: 'sip' },
  { label: 'RCC Slab Steel', query: 'slab steel' },
  { label: 'Income Tax', query: 'income tax' },
  { label: 'BMI Calculator', query: 'bmi' },
  { label: 'Age Calculator', query: 'age' },
];

const benefits = [
  { icon: '🎁', title: '100% Free', desc: 'No subscriptions or locked tools' },
  { icon: '⚡', title: 'Instant Results', desc: 'Runs in your browser with zero lag' },
  { icon: '🔒', title: 'Private & Secure', desc: 'No calculation data is stored' },
  { icon: '📱', title: 'Mobile Friendly', desc: 'Optimized for phones & tablets' },
];
---

<section class="relative overflow-hidden border-b border-slate-200/80 bg-gradient-to-b from-blue-50/40 via-white to-slate-50/60 px-4 py-14 sm:py-20 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900/60 dark:to-slate-950">
  
  <!-- Subtle Background Glow -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-1/2 top-0 h-80 w-80 -translate-x-1/2 rounded-full bg-blue-500/10 blur-3xl dark:bg-blue-500/15"></div>
  </div>

  <div class="relative mx-auto max-w-5xl text-center">
    
    <!-- Top Pill Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1.5 text-xs font-bold tracking-wide text-blue-700 dark:border-blue-900/50 dark:bg-blue-950/60 dark:text-blue-300 shadow-2xs">
      <span class="h-2 w-2 rounded-full bg-blue-600 dark:bg-blue-400 animate-pulse"></span>
      {totalCount}+ Verified Online Calculation Engines
    </div>

    <!-- Main Value Proposition Heading -->
    <h1 class="mx-auto mt-5 max-w-4xl text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
      Free Online Calculators for
      <span class="block bg-gradient-to-r from-blue-600 via-indigo-600 to-sky-500 bg-clip-text text-transparent">
        Everyday Calculations
      </span>
    </h1>

    <!-- Short Concise Subtitle -->
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300 sm:text-base">
      Calculate loans, investments, civil engineering quantities, health biometrics, percentages, and scientific math with verified formulas and zero signups.
    </p>

    <!-- Prominent Search Bar -->
    <div class="relative mx-auto mt-8 max-w-2xl text-left">
      <div class="relative group">
        <input
          type="text"
          id="home-main-search"
          aria-label="Search calculators"
          placeholder="Search calculators, e.g. EMI, SIP, RCC Slab, Age Calculator…"
          class="w-full rounded-2xl border border-slate-300 bg-white py-4 pl-12 pr-14 text-sm font-medium text-slate-900 shadow-xl shadow-slate-200/50 focus:border-blue-600 focus:outline-hidden focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:shadow-none transition"
          autocomplete="off"
        />
        
        <!-- Search Icon -->
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </div>

        <!-- Clear Search Button -->
        <button
          type="button"
          id="home-search-clear"
          aria-label="Clear search query"
          class="hidden absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Autocomplete Dropdown Menu -->
      <div
        id="home-search-dropdown"
        class="hidden absolute left-0 right-0 top-full z-40 mt-2 rounded-2xl border border-slate-200 bg-white shadow-2xl transition-all dark:border-slate-800 dark:bg-slate-900 overflow-hidden"
      >
        <div id="home-dropdown-items" class="max-h-80 overflow-y-auto p-2 divide-y divide-slate-100 dark:divide-slate-800/60">
          <!-- Populated via JS -->
        </div>
        <div id="home-dropdown-footer" class="border-t border-slate-100 bg-slate-50 px-4 py-2 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-950 flex items-center justify-between">
          <span id="home-match-count">0 calculators match</span>
          <a href="#popular-calculators" class="font-bold text-blue-600 hover:underline dark:text-blue-400">
            Browse Popular Tools ↓
          </a>
        </div>
      </div>

      <!-- Popular Searches Quick Pills -->
      <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5 text-xs">
        <span class="text-slate-400 font-semibold pr-1">Popular:</span>
        {popularSearches.map((item) => (
          <button
            type="button"
            class="home-quick-tag rounded-full border border-slate-200 bg-white/80 px-2.5 py-1 font-semibold text-slate-600 hover:border-blue-400 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-300 dark:hover:border-blue-500 dark:hover:text-blue-400 transition cursor-pointer shadow-2xs"
            data-query={item.query}
          >
            {item.label}
          </button>
        ))}
      </div>
    </div>

    <!-- 4 Compact Trust / Benefit Points -->
    <div class="mx-auto mt-12 grid max-w-4xl grid-cols-2 gap-3 sm:grid-cols-4">
      {benefits.map((b) => (
        <div class="rounded-2xl border border-slate-200/80 bg-white/90 p-3.5 sm:p-4 text-left shadow-xs dark:border-slate-800 dark:bg-slate-900/60 transition hover:border-blue-500/30">
          <div class="flex items-center gap-2">
            <span class="text-xl shrink-0">{b.icon}</span>
            <span class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white truncate">{b.title}</span>
          </div>
          <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 leading-tight line-clamp-1">
            {b.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
