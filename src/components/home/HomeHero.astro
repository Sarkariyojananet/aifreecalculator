---
const popularSearches = [
  { label: 'EMI Calculator', query: 'emi' },
  { label: 'SIP Calculator', query: 'sip' },
  { label: 'BMI Calculator', query: 'bmi' },
  { label: 'Age Calculator', query: 'age' },
  { label: 'RCC Slab Steel', query: 'slab steel' },
  { label: 'Percentage', query: 'percentage' },
];
---

<section class="border-b border-slate-200 bg-white px-4 py-12 sm:py-16 dark:border-slate-800 dark:bg-slate-900/60">
  <div class="mx-auto max-w-4xl text-center">
    
    <!-- Headline -->
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      Free Online Calculators for<br />
      Everyday Calculations
    </h1>

    <!-- Natural Subtitle -->
    <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base dark:text-slate-400">
      Free online calculators for finance, construction, health, math and everyday tasks.
    </p>

    <!-- Main Search Container -->
    <div class="relative mx-auto mt-8 max-w-2xl text-left">
      <div class="relative">
        <label for="home-main-search" class="sr-only">Search for a calculator</label>
        
        <input
          type="text"
          id="home-main-search"
          aria-label="Search for a calculator"
          placeholder="Search for a calculator, e.g. EMI, SIP, BMI, Age, Slab Steel…"
          class="w-full rounded-xl border border-slate-300 bg-white py-3.5 pl-11 pr-12 text-sm font-medium text-slate-900 shadow-xs focus:border-blue-600 focus:outline-hidden focus:ring-3 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-white transition"
          autocomplete="off"
        />
        
        <!-- Search Icon -->
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </div>

        <!-- Clear Search Button -->
        <button
          type="button"
          id="home-search-clear"
          aria-label="Clear search query"
          class="hidden absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Autocomplete Dropdown Menu -->
      <div
        id="home-search-dropdown"
        class="hidden absolute left-0 right-0 top-full z-40 mt-1.5 rounded-xl border border-slate-200 bg-white shadow-xl transition-all dark:border-slate-800 dark:bg-slate-900 overflow-hidden"
      >
        <div id="home-dropdown-items" class="max-h-80 overflow-y-auto p-1.5 divide-y divide-slate-100 dark:divide-slate-800/60">
          <!-- Populated via JS -->
        </div>
        <div id="home-dropdown-footer" class="border-t border-slate-100 bg-slate-50 px-4 py-2 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-950 flex items-center justify-between">
          <span id="home-match-count">0 calculators match</span>
          <a href="/all-calculators/" class="font-medium text-blue-600 hover:underline dark:text-blue-400">
            View All Calculators →
          </a>
        </div>
      </div>

      <!-- Popular Searches Quick Links -->
      <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5 text-xs">
        <span class="text-slate-400 font-medium mr-1">Popular:</span>
        {popularSearches.map((item, idx) => (
          <span>
            <button
              type="button"
              class="home-quick-tag text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 font-medium transition cursor-pointer"
              data-query={item.query}
            >
              {item.label}
            </button>
            {idx < popularSearches.length - 1 && <span class="text-slate-300 dark:text-slate-700 ml-1.5 mr-0.5">·</span>}
          </span>
        ))}
      </div>
    </div>

    <!-- Simple Trust Indicators -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-500 dark:text-slate-400 font-medium">
      <div class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        <span>Free to use</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        <span>No signup required</span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        <span>Simple and easy to use</span>
      </div>
    </div>

  </div>
</section>
