---
const benefits = [
  {
    title: 'Free to Use',
    description: 'Use all available calculators without creating an account or paying fees. Every single tool is open and ready to use immediately.',
    svg: `<svg class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
  },
  {
    title: 'Simple Results',
    description: 'Enter your values and get clear results without unnecessary complexity, intrusive popups, or confusing multi-step forms.',
    svg: `<svg class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>`,
  },
  {
    title: 'Easy to Access & Private',
    description: 'Calculations run directly inside your web browser. No calculation data is stored on our servers, and every tool works smoothly on mobile and desktop.',
    svg: `<svg class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-2.18-7.77a2.25 2.25 0 0 0-2.14 0L4.17 6.47a2.25 2.25 0 0 0-1.17 1.97v6.62a2.25 2.25 0 0 0 1.17 1.97l6.76 3.49c.67.34 1.47.34 2.14 0l6.76-3.49a2.25 2.25 0 0 0 1.17-1.97V8.44a2.25 2.25 0 0 0-1.17-1.97l-6.76-3.49Z" /></svg>`,
  },
];
---

<section class="border-b border-slate-200 bg-white px-4 py-12 sm:py-16 dark:border-slate-800 dark:bg-slate-900/60" id="why-us">
  <div class="mx-auto max-w-7xl">
    
    <!-- Section Header -->
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
        Why Use This Website
      </h2>
      <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">
        Straightforward calculators designed to be fast, reliable, and respectful of your privacy.
      </p>
    </div>

    <!-- 3 Simple Pillars -->
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {benefits.map((b) => (
        <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-6 dark:border-slate-800 dark:bg-slate-900/80">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-950/50" set:html={b.svg} />
          
          <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">
            {b.title}
          </h3>
          
          <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            {b.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
