---
const benefits = [
  {
    icon: '🎁',
    title: '100% Free Forever',
    description: 'No subscription tiers, no hidden paywalls, and unlimited free calculations across all tools.',
  },
  {
    icon: '🛡️',
    title: 'Complete Client-Side Privacy',
    description: 'All calculations execute locally in your web browser. Your inputs, salaries, and dimensions are never stored on our servers.',
  },
  {
    icon: '⚡',
    title: 'Instant Execution',
    description: 'Native mathematical algorithms compute results dynamically as you type with zero server roundtrip latency.',
  },
  {
    icon: '📱',
    title: 'Mobile-First Experience',
    description: 'Designed for quick calculations on job sites, in class, or on the go with responsive, touch-friendly inputs.',
  },
  {
    icon: '📚',
    title: 'Formula Transparency',
    description: 'Every tool includes mathematical methodology, standard codes (IS/ASTM), and step-by-step worked examples.',
  },
  {
    icon: '📑',
    title: 'PDF & Share Reports',
    description: 'Export structured calculation summaries to PDF or generate shareable URLs for clients and teammates.',
  },
];
---

<section class="border-b border-slate-200/80 bg-white px-4 py-14 sm:py-18 dark:border-slate-800 dark:bg-slate-900/40" id="why-us">
  <div class="mx-auto max-w-7xl space-y-10">
    
    <!-- Section Header -->
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">
        <span>💎</span> Built for Privacy &amp; Speed
      </div>
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
        Why Use AI Free Calculator?
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        Engineered to provide clean, fast, and transparent computational tools without tracking or signups.
      </p>
    </div>

    <!-- Benefits Grid (1-col mobile, 2-col tablet, 3-col desktop) -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b) => (
        <div class="rounded-3xl border border-slate-200 bg-slate-50/60 p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 space-y-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white text-2xl shadow-2xs dark:bg-slate-800">
            {b.icon}
          </span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">
            {b.title}
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            {b.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
