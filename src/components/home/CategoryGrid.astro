---
import { categories, calculators } from '../../data/calculators';

const categoryDetails: Record<string, { description: string; svg: string }> = {
  Finance: {
    description: 'Tools for loan EMI, SIP investments, income tax comparisons, GST, and salary planning.',
    svg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
  },
  Construction: {
    description: 'Civil engineering tools for RCC slab BBS, rebar weights, concrete dry volume, and brickwork.',
    svg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>`,
  },
  Health: {
    description: 'Tools for BMI body mass index, daily calories (TDEE), BMR metabolic rate, and body fat percentage.',
    svg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>`,
  },
  Math: {
    description: 'Academic and scientific tools for fractions, college & high school GPA, standard deviation, and RNG.',
    svg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 6h7.5v2.25h-7.5V6ZM12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Z" /></svg>`,
  },
  General: {
    description: 'Everyday utilities for exact age, date differences, percentage changes, time duration, and height-weight.',
    svg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>`,
  },
};

const categoryData = categories.map((cat) => {
  const count = calculators.filter((c) => c.category.toLowerCase() === cat.name.toLowerCase()).length;
  const extra = categoryDetails[cat.name] || {
    description: cat.description,
    svg: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>`,
  };
  return {
    ...cat,
    count,
    description: extra.description,
    svg: extra.svg,
  };
});
---

<section class="border-b border-slate-200 bg-slate-50/50 px-4 py-12 sm:py-16 dark:border-slate-800 dark:bg-slate-950/40" id="categories">
  <div class="mx-auto max-w-7xl">
    
    <!-- Section Header -->
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
        Browse by Category
      </h2>
      <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">
        Explore dedicated calculation tools organized by practical everyday needs and technical fields.
      </p>
    </div>

    <!-- Categories Grid (1-col mobile, 2-col tablet, 5-col desktop) -->
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {categoryData.map((cat) => (
        <a
          href={cat.path}
          class="group flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 shadow-xs transition hover:border-slate-400 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700"
        >
          <div>
            <!-- Category Icon (Clean SVG) -->
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 group-hover:bg-blue-50 group-hover:text-blue-600 dark:group-hover:bg-blue-950/50 dark:group-hover:text-blue-400 transition-colors" set:html={cat.svg} />

            <h3 class="mt-4 text-base font-bold text-slate-900 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 transition-colors">
              {cat.name}
            </h3>

            <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              {cat.description}
            </p>
          </div>

          <div class="mt-5 flex items-center text-xs font-semibold text-blue-600 dark:text-blue-400">
            <span>{cat.count} calculators</span>
            <span class="ml-1 group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
