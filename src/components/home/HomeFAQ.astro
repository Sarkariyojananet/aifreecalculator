---
export const homeFaqs = [
  {
    question: 'Are all the calculators on AIFreeCalculator.com completely free?',
    answer: 'Yes, 100%. Every single calculator on AIFreeCalculator.com is free to use with unlimited calculations, zero subscription fees, and no locked features.',
  },
  {
    question: 'Do I need to create an account or sign in to calculate?',
    answer: 'No registration or signup is required. You can use any calculator immediately upon visiting the website without creating an account.',
  },
  {
    question: 'Is my financial, health, or personal data saved on your servers?',
    answer: 'No. All calculations run strictly in your web browser using client-side JavaScript. Your inputs, loan amounts, weight, and project dimensions are never stored, transmitted, or sold.',
  },
  {
    question: 'Can I use these calculators comfortably on mobile phones?',
    answer: 'Yes. Every tool is built with a responsive design featuring touch-friendly inputs, readable typography, and layouts that prevent awkward horizontal scrolling on small screens.',
  },
  {
    question: 'How accurate are the construction and civil engineering calculators?',
    answer: 'Our construction estimators follow recognized building standards (such as IS 456, standard steel density 7850 kg/m³, and concrete dry volume multiplier 1.54). They provide dependable preliminary BOQ and material estimates for project planning.',
  },
  {
    question: 'Can I download or share my calculation results?',
    answer: 'Yes. Supported tools (including RCC Slab Steel, Loan EMI, and Calorie tools) provide a direct button to export clean PDF summaries or share calculation links.',
  },
];
---

<section class="border-b border-slate-200 bg-slate-50/50 px-4 py-12 sm:py-16 dark:border-slate-800 dark:bg-slate-950/40" id="faq">
  <div class="mx-auto max-w-4xl">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
        Frequently Asked Questions
      </h2>
      <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">
        Common questions about calculations, privacy protections, and accuracy.
      </p>
    </div>

    <!-- Accordion FAQ List -->
    <div class="space-y-3">
      {homeFaqs.map((faq) => (
        <details
          class="group rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-2xs transition-all dark:border-slate-800 dark:bg-slate-900 open:border-slate-300 dark:open:border-slate-700"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between text-left text-sm font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">
            <span class="pr-4">{faq.question}</span>
            <svg class="h-4 w-4 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180 group-hover:text-blue-600 dark:group-hover:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <div class="mt-3 border-t border-slate-100 pt-3 text-xs sm:text-sm leading-relaxed text-slate-600 dark:border-slate-800 dark:text-slate-400">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
