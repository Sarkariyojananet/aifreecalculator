---
export const homeFaqs = [
  {
    question: 'Are all the calculators on AIFreeCalculator.com completely free?',
    answer: 'Yes, 100%. Every single calculator on AIFreeCalculator.com is free to use with unlimited calculations, zero subscription fees, and no locked features.',
  },
  {
    question: 'Do I need to create an account or sign in to calculate?',
    answer: 'No registration or signup is required. You can use any calculator immediately upon visiting the website.',
  },
  {
    question: 'Is my financial, health, or personal data saved on your servers?',
    answer: 'No. All calculations run strictly in your web browser using client-side JavaScript. Your inputs, loan amounts, weight, and project dimensions are never stored, transmitted, or sold.',
  },
  {
    question: 'Can I use these calculators comfortably on mobile phones?',
    answer: 'Yes. Every tool is built with a responsive, mobile-first design featuring large touch inputs, adaptive keyboards, and clean layouts that avoid horizontal scrolling.',
  },
  {
    question: 'How accurate are the construction and civil engineering calculators?',
    answer: 'Our construction estimators follow recognized building standards (such as IS 456, standard steel density 7850 kg/m³, and concrete dry volume multiplier 1.54). They provide fast, reliable preliminary BOQ and material estimates.',
  },
  {
    question: 'Can I download or share my calculation results?',
    answer: 'Yes. Many specialized calculators (including RCC Slab Steel, Loan EMI, and Calorie tools) provide 1-click PDF download and shareable calculation summaries.',
  },
];
---

<section class="border-t border-slate-200/80 bg-slate-50/70 px-4 py-16 dark:border-slate-800 dark:bg-slate-950/60" id="faq">
  <div class="mx-auto max-w-4xl space-y-8">
    
    <!-- Section Header -->
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">
        <span>❓</span> Frequently Asked Questions
      </div>
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
        Got Questions? We Have Answers
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl mx-auto">
        Learn more about our free calculation tools, privacy protections, and mathematical accuracy.
      </p>
    </div>

    <!-- Accordion FAQ List -->
    <div class="space-y-3.5">
      {homeFaqs.map((faq, idx) => (
        <details
          class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-xs transition-all duration-200 dark:border-slate-800 dark:bg-slate-900 open:border-blue-500/40 open:shadow-md"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between text-left text-sm font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">
            <span class="pr-4">{faq.question}</span>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-xs text-slate-500 transition-transform duration-200 group-open:rotate-180 group-open:bg-blue-50 group-open:text-blue-600 dark:bg-slate-800 dark:text-slate-400 dark:group-open:bg-blue-950 dark:group-open:text-blue-400">
              ▼
            </span>
          </summary>
          <div class="mt-3.5 border-t border-slate-100 pt-3 text-xs sm:text-sm leading-relaxed text-slate-600 dark:border-slate-800 dark:text-slate-300">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
