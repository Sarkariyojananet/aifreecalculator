---
import { getConstructionSpotlightCalculators } from '../../data/calculators';

const constructionTools = getConstructionSpotlightCalculators(8);
---

<section class="border-b border-slate-200/80 bg-white px-4 py-14 sm:py-18 dark:border-slate-800 dark:bg-slate-900/40" id="construction-spotlight">
  <div class="mx-auto max-w-7xl space-y-8">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
          <span>🏗️</span> Civil &amp; Site Engineering
        </div>
        <h2 class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
          Construction &amp; BOQ Spotlight
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-2xl">
          Bar bending schedules (BBS), concrete dry volume multipliers (1.54), rebar unit weight (D²/162), brickwork, and plastering estimators.
        </p>
      </div>

      <a
        href="/construction/"
        class="inline-flex items-center gap-1.5 rounded-xl border border-amber-300 bg-amber-50/60 px-4 py-2 text-xs font-bold text-amber-900 hover:bg-amber-100 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300 dark:hover:bg-amber-950/70 transition shrink-0 self-start sm:self-auto"
      >
        <span>Explore All Construction Tools</span>
        <span>→</span>
      </a>
    </div>

    <!-- Construction Cards Grid (1-col mobile, 2-col tablet, 4-col desktop) -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {constructionTools.map((tool) => (
        <a
          href={tool.path}
          class="group relative flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-5 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-amber-400 hover:shadow-lg hover:shadow-amber-500/5 dark:border-slate-800 dark:bg-slate-900/90 dark:hover:border-amber-500/40"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-amber-50 text-2xl group-hover:scale-110 transition-transform dark:bg-amber-950/50 shadow-2xs">
                {tool.icon}
              </span>
              <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                Civil BOQ
              </span>
            </div>

            <h3 class="mt-4 text-sm font-bold text-slate-900 group-hover:text-amber-600 dark:text-white dark:group-hover:text-amber-400 transition-colors">
              {tool.name}
            </h3>

            <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-2">
              {tool.description}
            </p>
          </div>

          <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 text-xs font-bold text-amber-600 dark:border-slate-800 dark:text-amber-400">
            <span>Calculate BOQ</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
