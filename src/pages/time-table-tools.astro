---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import AdSlotTop from '../components/ads/AdSlotTop.astro';
import AdSlotInline from '../components/ads/AdSlotInline.astro';
import AdSlotFooter from '../components/ads/AdSlotFooter.astro';
import { getCalculatorsByCategory } from '../data/calculators';
import { getCalculatorOverrides } from '../lib/admin/content-store';
import { getLivePageMeta } from '../lib/seo/page-metadata';

const timeTableTools = getCalculatorsByCategory('Time Table Tools');
const overrides = await getCalculatorOverrides(Astro.locals);
const override = overrides['category:time-table-tools'] || {};
const liveMeta = getLivePageMeta('category:time-table-tools');

const effectiveTitle = override.metaTitle || liveMeta.title;
const effectiveDescription = override.metaDescription || liveMeta.description;
const effectiveCanonical = override.canonicalUrl;
const effectiveRobots = override.robots;
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
  noindex={effectiveRobots?.includes('noindex')}
  ogImage="/og/default.png"
>
  <section class="border-b border-slate-200 bg-white px-4 py-12 dark:border-slate-800 dark:bg-slate-900/60 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <div class="flex items-center gap-2 text-xs text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider mb-2">
        <span>📅</span> SCHEDULE GENERATORS & TIMETABLE MAKERS
      </div>
      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Free Timetable Makers & Schedule Generators
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        Design beautiful, printable weekly and daily schedules online for free. Custom templates for school classes, college lectures, university study sessions, exams, workout splits, employee shifts, and personal daily routines.
      </p>
    </div>
  </section>

  <!-- Top Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotTop />
  </div>

  <section class="px-4 py-10">
    <div class="mx-auto max-w-7xl space-y-6">
      <CategoryTabs activeCategory="time-table-tools" />

      <!-- First 6 Calculators -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {timeTableTools.slice(0, 6).map((calc) => (
          <CalculatorCard calculator={calc} />
        ))}
      </div>

      <!-- Middle Ad Slot -->
      <div class="py-2">
        <AdSlotInline />
      </div>

      <!-- Remaining Calculators (if any) -->
      {timeTableTools.length > 6 && (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {timeTableTools.slice(6).map((calc) => (
            <CalculatorCard calculator={calc} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Scheduling Science & Time Management Educational Section -->
  <section class="border-t border-slate-200 bg-white px-4 py-12 dark:border-slate-800 dark:bg-slate-900/60 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-10">
      <div class="max-w-3xl space-y-3">
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">
          Science-Backed Scheduling & Time Management Methods
        </h2>
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          Effective scheduling transforms ambiguous goals into disciplined daily routines. Our interactive planners support academic revision, shift work schedules, fitness tracking, and meal preparation using validated productivity methodologies.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">⏳</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Time-Blocking & Deep Work</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Rather than relying on reactive to-do lists, time-blocking designates dedicated windows for cognitive deep work. By grouping mentally demanding tasks during morning peak cortisol and alertness periods, students and professionals prevent multitasking fatigue and context switching.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">🧠</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Spaced Repetition & Exam Pacing</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Cramming leads to rapid memory decay per Ebbinghaus's forgetting curve. Our study planners facilitate distributed practice schedules: reviewing difficult topics at spaced intervals (1 day, 3 days, 1 week, 3 weeks) to consolidate knowledge into long-term neural pathways.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">🔄</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Shift Work & Circadian Alignment</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Rotational 8-hour and 12-hour shifts require structured recovery windows. Our shift schedule planner enables workers to visualize alternating day/night cycles, plan blackout sleep blocks, and schedule meal times to minimize circadian disruption.
          </p>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-6 dark:border-slate-800 dark:bg-slate-950/40 text-xs leading-relaxed text-slate-700 dark:text-slate-300 space-y-2">
        <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🖨️</span> Print & Offline Availability
        </div>
        <p>
          All schedules created in our timetable makers export cleanly to high-resolution PDF or printable physical formats. Your calendar entries and schedules remain saved in your local browser storage for quick offline access without mandatory account registration.
        </p>
      </div>
    </div>
  </section>

  <!-- Bottom Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotFooter />
  </div>
</BaseLayout>
