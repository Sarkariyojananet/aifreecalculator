---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How does the Word to PDF converter work directly in the browser?",
    answer: "Our Word to PDF tool uses mammoth.js and jsPDF in your browser to parse .docx structures, typography, headings, and margins. It builds a print-ready vector PDF document directly in your browser memory without uploading your file to any server."
  },
  {
    question: "Will the formatting of my Word document be preserved?",
    answer: "Yes. Headings, paragraph line wraps, lists, margins, and text hierarchies are faithfully converted into a standard PDF page format (A4 or US Letter)."
  },
  {
    question: "Is it secure to convert confidential Word documents here?",
    answer: "Yes, 100% secure. Because the tool runs entirely on your local machine using JavaScript, private business contracts, student resumes, and personal notes are never transmitted across the web."
  },
  {
    question: "Can I customize the PDF page size and margin?",
    answer: "Yes. You can select between standard A4 and US Letter page sizes, as well as Normal, Narrow, or Wide margin options before generating your PDF."
  },
  {
    question: "Is this Word to PDF converter completely free?",
    answer: "Yes. Our tool is 100% free with no subscription, no daily usage limits, and zero watermarks stamped onto your converted documents."
  },
  {
    question: "Can I use this tool on iPhone, Android, or Mac?",
    answer: "Yes. The converter works seamlessly in Google Chrome, Safari, Edge, and Firefox across mobile phones, tablets, and desktop computers."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Word to PDF Converter",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Convert Microsoft Word (.docx) documents into clean, print-ready PDF files online for free directly in your browser."
};
---

<CalculatorLayout
  title="Word to PDF Converter - Convert DOCX to PDF Online Free"
  description="Convert Word DOCX files to clean, formatted PDF documents online for free. Fast, private client-side Word to PDF conversion with zero uploads."
  category="PDF Tools"
  calculatorName="Word to PDF"
  slug="word-to-pdf"
  keywords={[
    'word to pdf',
    'word to pdf converter',
    'convert docx to pdf',
    'doc to pdf online free',
    'save word as pdf',
    'docx to pdf converter free'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Client-Side Libraries Loader -->
  <script is:inline>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = cb;
        s.onerror = cb;
        document.head.appendChild(s);
      }

      loadScript('https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js', function() {
        loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js', function() {
          var ts = document.createElement('script');
          ts.src = '/js/tools/word-to-pdf.js';
          document.body.appendChild(ts);
        });
      });
    })();
  </script>

  <div class="space-y-5">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>100% Client-Side • Standard PDF Layouts • 100% Free & Private</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Word to PDF Converter
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Convert Microsoft Word (.docx, .doc) files into universally compatible, print-ready PDF documents directly in your web browser.
      </p>

      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Local Privacy:</strong> Your Word files are converted locally inside your browser memory and are never uploaded to any remote server.</span>
      </div>
    </div>

    <!-- Error Box -->
    <div
      id="wp-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="wp-error-text"></span>
    </div>

    <!-- Drop Zone -->
    <div
      id="wp-drop-zone"
      tabindex="0"
      role="button"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-blue-400 dark:hover:border-blue-600 hover:bg-blue-50/40 dark:hover:bg-blue-950/20 focus:outline-none focus:ring-4 focus:ring-blue-500/20"
    >
      <input type="file" id="wp-file-input" accept=".docx,.doc,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword" class="sr-only" />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 dark:bg-blue-950/60 text-4xl transition group-hover:scale-105">
        📄
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop your Word (.docx) file here to convert to PDF
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or click below to choose a Word document from your device
        </p>
      </div>

      <button
        type="button"
        id="wp-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose Word Document
      </button>
    </div>

    <!-- Options Section -->
    <div id="wp-options-section" class="hidden space-y-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <div class="flex items-start gap-3">
          <span class="text-2xl shrink-0">📄</span>
          <div class="flex-1 min-w-0">
            <p id="wp-filename" class="text-sm font-bold text-slate-900 dark:text-white truncate"></p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              <span id="wp-file-size"></span>
            </p>
          </div>
          <button type="button" id="wp-clear-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer">
            Change File
          </button>
        </div>
      </div>

      <!-- Settings Box -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          PDF Page Layout Settings
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="wp-page-size" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Page Size
            </label>
            <select
              id="wp-page-size"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2 text-sm font-medium text-slate-900 dark:text-white focus:border-blue-500 focus:outline-none"
            >
              <option value="a4" selected>A4 (Standard International)</option>
              <option value="letter">US Letter (North America)</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="wp-margin" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Margins
            </label>
            <select
              id="wp-margin"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2 text-sm font-medium text-slate-900 dark:text-white focus:border-blue-500 focus:outline-none"
            >
              <option value="normal" selected>Normal (Standard)</option>
              <option value="narrow">Narrow (More content per page)</option>
              <option value="wide">Wide (Spacious presentation)</option>
            </select>
          </div>
        </div>
      </div>

      <button
        type="button"
        id="wp-convert-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-6 py-3 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Convert Word to PDF Now
      </button>
    </div>

    <!-- Status Section -->
    <div id="wp-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="wp-status-icon" class="text-2xl shrink-0"></span>
        <div class="space-y-1 min-w-0 flex-1">
          <p id="wp-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="wp-status-body" class="text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="wp-progress-bar" class="hidden mt-2.5">
            <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div id="wp-progress-fill" class="bg-blue-600 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Download Section -->
    <div id="wp-download-section" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 p-6 text-center space-y-4">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 dark:bg-emerald-900/60 text-3xl">
        🎉
      </div>
      <div>
        <h3 class="text-lg font-bold text-emerald-900 dark:text-emerald-200">
          PDF Document Generated Successfully!
        </h3>
        <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">
          <span id="wp-download-filename"></span> • <span id="wp-download-size"></span>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="wp-download-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 px-6 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Converted PDF
        </button>

        <button
          type="button"
          id="wp-start-over-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 transition cursor-pointer"
        >
          Convert Another Word File
        </button>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Word to PDF Converter: Convert DOCX to Print-Ready PDF Online
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Transform Word documents into fixed-layout, professional PDF files that look identical on any computer, tablet, or smartphone. Our <strong>Word to PDF</strong> converter renders clean typography, margins, and page divisions directly inside your browser.
        </p>
        <p class="leading-relaxed">
          No external software installation, no Microsoft Office subscription required, and 100% private with local JavaScript execution.
        </p>
      </section>

      <!-- Key Benefits -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Why Convert Word to PDF With Us?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '📄',
              title: 'Preserve Layouts & Fonts',
              desc: 'Locks your fonts, text formatting, and line breaks so your document prints and displays consistently everywhere.'
            },
            {
              icon: '🔒',
              title: '100% Client-Side Privacy',
              desc: 'Document rendering occurs directly in your local browser memory. No data is ever transmitted to a cloud server.'
            },
            {
              icon: '⚡',
              title: 'Instant Conversion Speed',
              desc: 'Convert multi-page DOCX files in milliseconds without waiting for server upload queues or email download links.'
            },
            {
              icon: '📐',
              title: 'Customizable Page Formats',
              desc: 'Choose between international A4 and North American US Letter paper sizes with customizable margins.'
            },
            {
              icon: '📱',
              title: 'Full Mobile Compatibility',
              desc: 'Convert Word files on the go using Safari on iPhone/iPad or Google Chrome on Android devices.'
            },
            {
              icon: '🚫',
              title: 'Completely Free & Clean',
              desc: 'No watermarks, no document page caps, no signup forms, and unlimited free document conversions.'
            }
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{icon}</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related PDF Navigation -->
      <section class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Explore Related PDF Tools
        </h3>
        <div class="flex flex-wrap gap-2 text-xs sm:text-sm">
          <a href="/pdf-tools/pdf-to-word/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            PDF to Word Converter →
          </a>
          <a href="/pdf-tools/pdf-compress/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-purple-600 dark:text-purple-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Compress PDF →
          </a>
          <a href="/pdf-tools/protect-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-red-600 dark:text-red-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Protect PDF →
          </a>
          <a href="/pdf-tools/pdf-merge/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Merge PDF Files →
          </a>
        </div>
      </section>
    </div>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-4 transition-colors [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 dark:text-white font-semibold text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-blue-600 dark:text-blue-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>
