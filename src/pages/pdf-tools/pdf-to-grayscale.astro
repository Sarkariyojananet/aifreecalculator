---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How does the PDF to Grayscale converter work?",
    answer: "Our tool renders each PDF page onto an HTML5 canvas in your browser, applies standard Rec. 601 grayscale luminance conversion (0.299*R + 0.587*G + 0.114*B) across every pixel, and packages the monochrome pages into a brand new PDF document."
  },
  {
    question: "Why convert a color PDF to black & white or grayscale?",
    answer: "Grayscale PDFs save expensive colored printer ink or toner, create clean contrast for official black-and-white archives, reduce file size, and meet monochrome submission standards for government or legal filings."
  },
  {
    question: "Is my document uploaded to any external server?",
    answer: "No. The entire conversion process occurs entirely inside your local browser memory using PDF.js and jsPDF. Your sensitive files and private records are never uploaded to any remote server."
  },
  {
    question: "Can I adjust the output image quality or resolution?",
    answer: "Yes. You can select between High (300 DPI, Print-ready), Medium (150 DPI, Balanced), and Low (72 DPI, Web/Email) resolution options before converting."
  },
  {
    question: "Will the converted PDF be compatible with all PDF readers?",
    answer: "Yes. The output is a standard PDF document compatible with Adobe Acrobat Reader, Apple Preview, Google Chrome, Microsoft Edge, and all mobile PDF viewers."
  },
  {
    question: "Is there any cost or limit on page count?",
    answer: "No. Our tool is 100% free with no subscription, no page count restrictions, and zero watermarks added to your converted documents."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "PDF to Grayscale Converter",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Convert color PDF files into black & white grayscale documents online for free directly in your web browser."
};
---

<CalculatorLayout
  layoutVariant="workspace"
  title="PDF to Grayscale - Convert PDF to Black & White Online Free"
  description="Convert color PDF files to monochrome black & white / grayscale online for free. Save printer toner and ink, high-quality client-side processing."
  category="PDF Tools"
  calculatorName="PDF to Grayscale"
  slug="pdf-to-grayscale"
  keywords={[
    'pdf to grayscale',
    'convert pdf to black and white',
    'color pdf to grayscale online',
    'black and white pdf converter',
    'monochrome pdf',
    'save ink pdf converter'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Client-Side Libraries Loader -->
  <script is:inline>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = cb;
        s.onerror = cb;
        document.head.appendChild(s);
      }

      loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js', function() {
        if (window.pdfjsLib) {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }
        loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js', function() {
          var ts = document.createElement('script');
          ts.src = '/js/tools/pdf-to-grayscale.js';
          document.body.appendChild(ts);
        });
      });
    })();
  </script>

  <div class="space-y-5">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span>100% Client-Side • Save Printer Ink & Toner • 100% Free & Private</span>
      </div>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Convert color PDF documents into clean, high-contrast black & white grayscale files directly in your web browser.
      </p>

      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Local Privacy:</strong> Grayscale conversion happens entirely inside your local browser memory with zero server uploads.</span>
      </div>
    </div>

    <!-- Error Box -->
    <div
      id="gs-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="gs-error-text"></span>
    </div>

    <!-- Drop Zone -->
    <div
      id="gs-drop-zone"
      tabindex="0"
      role="button"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-slate-400 dark:hover:border-slate-600 hover:bg-slate-100/40 dark:hover:bg-slate-800/40 focus:outline-none focus:ring-4 focus:ring-slate-500/20"
    >
      <input type="file" id="gs-file-input" accept="application/pdf,.pdf" class="sr-only" />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-200 dark:bg-slate-800 text-4xl transition group-hover:scale-105">
        🔘
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop your PDF here to convert to grayscale
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or click below to choose a PDF from your device
        </p>
      </div>

      <button
        type="button"
        id="gs-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-slate-800 hover:bg-slate-900 dark:bg-slate-700 dark:hover:bg-slate-600 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-slate-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose PDF File
      </button>
    </div>

    <!-- Options Section -->
    <div id="gs-options-section" class="hidden space-y-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <div class="flex items-start gap-3">
          <span class="text-2xl shrink-0">📄</span>
          <div class="flex-1 min-w-0">
            <p id="gs-filename" class="text-sm font-bold text-slate-900 dark:text-white truncate"></p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              <span id="gs-page-count">0</span> pages • <span id="gs-file-size">0 KB</span>
            </p>
          </div>
          <button type="button" id="gs-clear-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer">
            Change File
          </button>
        </div>
      </div>

      <!-- Settings Box -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          Conversion Quality & Resolution
        </h2>

        <div class="space-y-1.5">
          <label for="gs-dpi-select" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
            Output Rendering Quality
          </label>
          <select
            id="gs-dpi-select"
            class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2 text-sm font-medium text-slate-900 dark:text-white focus:border-slate-500 focus:outline-none"
          >
            <option value="150" selected>Balanced (150 DPI) — Recommended for general documents & reading</option>
            <option value="300">High Quality (300 DPI) — Best for crisp printing & fine text</option>
            <option value="72">Compact / Web (72 DPI) — Smallest file size for email sharing</option>
          </select>
        </div>
      </div>

      <button
        type="button"
        id="gs-convert-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-slate-800 hover:bg-slate-900 dark:bg-slate-700 dark:hover:bg-slate-600 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-6 py-3 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-slate-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        Convert to Grayscale Now
      </button>
    </div>

    <!-- Status Section -->
    <div id="gs-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="gs-status-icon" class="text-2xl shrink-0"></span>
        <div class="space-y-1 min-w-0 flex-1">
          <p id="gs-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="gs-status-body" class="text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="gs-progress-bar" class="hidden mt-2.5">
            <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div id="gs-progress-fill" class="bg-slate-800 dark:bg-slate-400 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Download Section -->
    <div id="gs-download-section" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 p-6 text-center space-y-4">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 dark:bg-emerald-900/60 text-3xl">
        🎉
      </div>
      <div>
        <h3 class="text-lg font-bold text-emerald-900 dark:text-emerald-200">
          Grayscale PDF Generated Successfully!
        </h3>
        <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">
          <span id="gs-download-filename"></span> • <span id="gs-download-size"></span>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="gs-download-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 px-6 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Grayscale PDF
        </button>

        <button
          type="button"
          id="gs-start-over-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 transition cursor-pointer"
        >
          Convert Another PDF
        </button>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Convert PDF to Grayscale: High-Contrast Black & White PDF Converter
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Transform colorful PDF files, graphs, reports, and brochures into clear monochrome black & white documents. Our <strong>PDF to Grayscale</strong> tool applies precise luminance calculations across every pixel to preserve contrast and legibility.
        </p>
        <p class="leading-relaxed">
          Ideal for printing documents with monochrome laser printers, reducing toner and cartridge expenses, and fulfilling monochrome legal or administrative requirements.
        </p>
      </section>

      <!-- Key Benefits -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Why Convert Color PDF to Grayscale?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '🖨️',
              title: 'Save Printer Toner & Ink',
              desc: 'Avoid using costly CMYK color inks when printing draft documents, receipts, or study notes.'
            },
            {
              icon: '🔒',
              title: '100% Client-Side Privacy',
              desc: 'Pixel luminance transformation executes locally in your web browser. No document data is ever uploaded.'
            },
            {
              icon: '📐',
              title: 'Selectable DPI Resolution',
              desc: 'Choose between 300 DPI for ultra-sharp prints, 150 DPI for daily viewing, or 72 DPI for web compression.'
            },
            {
              icon: '⚖️',
              title: 'Perfect Luminance Contrast',
              desc: 'Uses Rec. 601 grayscale color matrix formulas to maintain text clarity and graphic distinctions.'
            },
            {
              icon: '📱',
              title: 'Runs on Any Device',
              desc: 'Compatible with all modern browsers across Windows, macOS, Linux, iOS, and Android.'
            },
            {
              icon: '🚫',
              title: 'Free with No Watermarks',
              desc: 'Unlimited free conversions with zero added watermarks, branding stamps, or registrations.'
            }
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{icon}</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related PDF Navigation -->
      <section class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Explore Related PDF Tools
        </h3>
        <div class="flex flex-wrap gap-2 text-xs sm:text-sm">
          <a href="/pdf-tools/pdf-compress/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-purple-600 dark:text-purple-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Compress PDF →
          </a>
          <a href="/pdf-tools/pdf-to-image/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            PDF to JPG/PNG →
          </a>
          <a href="/pdf-tools/rotate-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Rotate PDF Pages →
          </a>
          <a href="/pdf-tools/add-page-numbers-to-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Add Page Numbers →
          </a>
        </div>
      </section>
    </div>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-4 transition-colors [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 dark:text-white font-semibold text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-slate-700 dark:text-slate-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>
