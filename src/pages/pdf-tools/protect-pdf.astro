---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How does Protect PDF encrypt my documents directly in the browser?",
    answer: "Our Protect PDF tool applies standard PDF encryption algorithms directly inside your web browser using Web Crypto APIs and pdf-lib. Your chosen password is cryptographically embedded into the document's security dictionary without uploading the file or your password to any remote server."
  },
  {
    question: "Is it safe to password-protect confidential legal and financial PDFs here?",
    answer: "Yes, 100% safe. Because all processing happens client-side in your local browser environment, neither your sensitive PDF contents nor your chosen password are ever transmitted across the internet, logged in cloud databases, or stored on third-party servers."
  },
  {
    question: "What type of password should I choose for maximum security?",
    answer: "We recommend a strong alphanumeric password of at least 8 to 16 characters containing a mix of uppercase letters, lowercase letters, numbers, and special symbols (e.g., !@#$%). Avoid obvious personal dates or sequential dictionary words."
  },
  {
    question: "Can anyone open my PDF without the password after protection?",
    answer: "No. Standard PDF encryption requires standard PDF readers (such as Adobe Acrobat, Apple Preview, Google Chrome, Microsoft Edge, and mobile PDF viewers) to prompt the user for the password before decrypting and displaying page contents."
  },
  {
    question: "Is this Protect PDF tool completely free to use?",
    answer: "Yes, our online PDF protector is completely free with no limits on file sizes or page counts, no user accounts or registrations, and no watermarks added to your secured documents."
  },
  {
    question: "What should I do if I forget the password I set on my PDF?",
    answer: "Because we do not store your files or track passwords on any server, we cannot recover forgotten passwords. Make sure to keep a secure record of your password in a password manager."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Protect PDF",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Encrypt and password protect PDF files online for free. Secure sensitive PDF documents with strong password protection in your browser with zero server uploads."
};
---

<CalculatorLayout
  layoutVariant="workspace"
  title="Protect PDF - Password Protect PDF Online Free"
  description="Encrypt and password protect PDF files online for free. Secure sensitive PDF documents with strong password encryption in your browser with zero uploads."
  category="PDF Tools"
  calculatorName="Protect PDF"
  slug="protect-pdf"
  keywords={[
    'protect pdf',
    'password protect pdf',
    'encrypt pdf',
    'pdf password protect online',
    'lock pdf',
    'secure pdf document',
    'pdf encryption free'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Client-Side PDF-Lib and Protect Tool Script -->
  <script is:inline>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = cb;
        s.onerror = cb;
        document.head.appendChild(s);
      }

      loadScript('https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js', function() {
        var ts = document.createElement('script');
        ts.src = '/js/tools/protect-pdf.js';
        document.body.appendChild(ts);
      });
    })();
  </script>

  <div class="space-y-5">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/80 text-red-700 dark:text-red-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>100% Client-Side • Strong Encryption • Zero Server Uploads</span>
      </div>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Encrypt and password-protect your sensitive PDF documents directly in your web browser. Prevent unauthorized access to contracts, financial statements, and personal records.
      </p>

      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>Complete Local Privacy:</strong> Your PDF file is encrypted directly inside your browser memory. No data or passwords are ever sent to our servers.</span>
      </div>
    </div>

    <!-- Error Box -->
    <div
      id="pp-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="pp-error-text"></span>
    </div>

    <!-- Drag and Drop Zone -->
    <div
      id="pp-drop-zone"
      tabindex="0"
      role="button"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-red-400 dark:hover:border-red-600 hover:bg-red-50/40 dark:hover:bg-red-950/20 focus:outline-none focus:ring-4 focus:ring-red-500/20"
    >
      <input type="file" id="pp-file-input" accept=".pdf,application/pdf" class="sr-only" />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 dark:bg-red-950/60 text-4xl transition group-hover:scale-105">
        🔒
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop your PDF file here to password protect
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or click below to choose a PDF from your device
        </p>
      </div>

      <button
        type="button"
        id="pp-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose PDF File
      </button>
    </div>

    <!-- Options Section -->
    <div id="pp-options-section" class="hidden space-y-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <div class="flex items-start gap-3">
          <span class="text-2xl shrink-0">📄</span>
          <div class="flex-1 min-w-0">
            <p id="pp-filename" class="text-sm font-bold text-slate-900 dark:text-white truncate"></p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              <span id="pp-file-size"></span>
            </p>
          </div>
          <button type="button" id="pp-clear-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer">
            Change File
          </button>
        </div>
      </div>

      <!-- Password Configuration Box -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Set Document Password
          </h2>
          <button type="button" id="pp-toggle-password" class="text-xs font-semibold text-red-600 dark:text-red-400 hover:underline cursor-pointer">
            👁️ Show
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="pp-password" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Enter Password <span class="text-red-500">*</span>
            </label>
            <input
              type="password"
              id="pp-password"
              placeholder="e.g. SecretPass#2026"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3.5 py-2.5 text-sm font-medium text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/20"
            />
          </div>

          <div class="space-y-1.5">
            <label for="pp-confirm-password" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Confirm Password <span class="text-red-500">*</span>
            </label>
            <input
              type="password"
              id="pp-confirm-password"
              placeholder="Re-type your password"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3.5 py-2.5 text-sm font-medium text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/20"
            />
          </div>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400">
          💡 Anyone opening this protected PDF will need this password to view the document contents.
        </p>
      </div>

      <button
        type="button"
        id="pp-protect-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-6 py-3 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        Encrypt & Protect PDF Now
      </button>
    </div>

    <!-- Status & Progress Section -->
    <div id="pp-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="pp-status-icon" class="text-2xl shrink-0"></span>
        <div class="space-y-1 min-w-0 flex-1">
          <p id="pp-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="pp-status-body" class="text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="pp-progress-bar" class="hidden mt-2.5">
            <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div id="pp-progress-fill" class="bg-red-600 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Download Section -->
    <div id="pp-download-section" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 p-6 text-center space-y-4">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 dark:bg-emerald-900/60 text-3xl">
        🎉
      </div>
      <div>
        <h3 class="text-lg font-bold text-emerald-900 dark:text-emerald-200">
          PDF Successfully Protected!
        </h3>
        <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">
          <span id="pp-download-filename"></span> • <span id="pp-download-size"></span>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="pp-download-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 px-6 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Protected PDF
        </button>

        <button
          type="button"
          id="pp-start-over-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 transition cursor-pointer"
        >
          Protect Another PDF
        </button>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <!-- Overview -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Protect PDF: Strong Client-Side PDF Password Encryption
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Protect sensitive contracts, salary slips, bank statements, medical histories, and confidential intellectual property by adding standard password security to your PDF files. Our <strong>Protect PDF</strong> tool encrypts your document directly in your browser using modern cryptographic standards.
        </p>
        <p class="leading-relaxed">
          Unlike ordinary cloud-based PDF conversion websites that require you to upload your confidential files to remote servers, our tool runs 100% locally on your computer or smartphone. Your passwords and PDF data never touch the cloud.
        </p>
      </section>

      <!-- Key Benefits -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Why Password Protect Your PDF Documents?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '🛡️',
              title: '100% Client-Side Encryption',
              desc: 'Document cryptographic encryption runs in local memory via Web APIs. No uploads, no logging, zero privacy risks.'
            },
            {
              icon: '🔑',
              title: 'Universal Reader Compatibility',
              desc: 'Protected PDFs are fully compatible with Adobe Acrobat, Apple Preview, Google Chrome, Microsoft Edge, and iOS/Android.'
            },
            {
              icon: '⚡',
              title: 'Lightning-Fast Speed',
              desc: 'Encrypt multi-page PDF documents in seconds without waiting for cloud upload queues or remote server processing.'
            },
            {
              icon: '💼',
              title: 'Confidential Business Files',
              desc: 'Safeguard employee salary records, investor decks, legal agreements, tax forms, and proprietary business plans.'
            },
            {
              icon: '📱',
              title: 'Mobile & Desktop Friendly',
              desc: 'Seamlessly works across all modern web browsers on Windows, Mac, Linux, iPhone, iPad, and Android devices.'
            },
            {
              icon: '🚫',
              title: 'Completely Free with No Watermark',
              desc: 'Unlimited document protection without subscriptions, hidden fees, page restrictions, or promotional watermarks.'
            }
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{icon}</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Step-by-Step Instructions -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          How to Password Protect a PDF in 3 Easy Steps
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {[
            {
              step: '1',
              title: 'Upload PDF',
              desc: 'Drop your PDF document into the designated box or click "Choose PDF File" from your device.'
            },
            {
              step: '2',
              title: 'Set Your Password',
              desc: 'Enter your desired secure password and confirm it to verify accuracy.'
            },
            {
              step: '3',
              title: 'Download Protected PDF',
              desc: 'Click "Encrypt & Protect PDF Now" and instantly download your encrypted, password-secured file.'
            }
          ].map(({ step, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2 relative">
              <span class="inline-block px-2 py-0.5 text-xs font-extrabold text-red-600 dark:text-red-400 bg-red-100 dark:bg-red-950/80 rounded-md uppercase tracking-wider">
                Step {step}
              </span>
              <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related Tools -->
      <section class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Explore Related PDF Tools
        </h3>
        <div class="flex flex-wrap gap-2 text-xs sm:text-sm">
          <a href="/pdf-tools/unlock-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Unlock PDF →
          </a>
          <a href="/pdf-tools/pdf-compress/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-purple-600 dark:text-purple-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Compress PDF →
          </a>
          <a href="/pdf-tools/rotate-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Rotate PDF Pages →
          </a>
          <a href="/pdf-tools/pdf-merge/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Merge PDF Files →
          </a>
        </div>
      </section>
    </div>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-4 transition-colors [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 dark:text-white font-semibold text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-red-600 dark:text-red-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>
