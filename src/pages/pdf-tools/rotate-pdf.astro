---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How does Rotate PDF turn pages without uploading to a server?",
    answer: "Our Rotate PDF tool modifies the internal /Rotate attribute in the PDF document object tree directly inside your web browser using pdf-lib. Because only the rotation matrix metadata is updated, the change is instant and 100% private with no server uploads."
  },
  {
    question: "Can I rotate individual pages or only the whole document?",
    answer: "You can rotate individual specific pages, all pages together, or select custom rotations for different pages (90° clockwise, 180° upside down, or 270° counter-clockwise) using our visual preview grid."
  },
  {
    question: "Is the rotation permanent when I download the PDF?",
    answer: "Yes. When you download the rotated PDF, the orientation metadata is permanently encoded into the PDF file structure so it opens right-side-up in all PDF viewers, printers, and mobile devices."
  },
  {
    question: "Will rotating PDF pages decrease visual clarity or compress images?",
    answer: "No. Rotating a PDF page simply alters the visual display coordinate matrix. The underlying text vectors, embedded images, and formatting are untouched and retain 100% original quality."
  },
  {
    question: "Is this Rotate PDF tool completely free to use?",
    answer: "Yes, our Rotate PDF tool is completely free with no restrictions on page count, no required registration, and no watermarks added to your output files."
  },
  {
    question: "Is my document private when using this rotation tool?",
    answer: "Yes, 100% private. Your files are processed entirely in your device's browser memory and are never uploaded or transmitted to any external server."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Rotate PDF",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Rotate PDF pages 90, 180, or 270 degrees online for free. Permanently rotate specific pages or entire PDF documents directly in your browser."
};
---

<CalculatorLayout
  title="Rotate PDF - Rotate PDF Pages Online Free"
  description="Rotate PDF pages 90, 180, or 270 degrees clockwise or counter-clockwise online. Rotate all pages or specific pages permanently directly in your browser."
  category="PDF Tools"
  calculatorName="Rotate PDF"
  slug="rotate-pdf"
  keywords={[
    'rotate pdf',
    'rotate pdf pages',
    'rotate pdf online free',
    'turn pdf upside down',
    'rotate specific pdf pages',
    'pdf orientation changer',
    'rotate pdf permanently'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- PDF-Lib and Rotate Tool Script -->
  <script is:inline>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = cb;
        s.onerror = cb;
        document.head.appendChild(s);
      }

      loadScript('https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js', function() {
        var ts = document.createElement('script');
        ts.src = '/js/tools/rotate-pdf.js';
        document.body.appendChild(ts);
      });
    })();
  </script>

  <div class="space-y-5">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/80 text-amber-700 dark:text-amber-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>100% Client-Side • Rotate All or Selected Pages • Zero Uploads</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Rotate PDF Pages Online
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Rotate sideways or upside-down PDF documents permanently. Rotate single pages or entire PDF files 90°, 180°, or 270° clockwise with visual previews.
      </p>

      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Local Privacy:</strong> Your PDF pages are rotated directly inside your browser memory and are never uploaded to any remote server.</span>
      </div>
    </div>

    <!-- Error Box -->
    <div
      id="rp-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="rp-error-text"></span>
    </div>

    <!-- Drop Zone -->
    <div
      id="rp-drop-zone"
      tabindex="0"
      role="button"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-amber-400 dark:hover:border-amber-600 hover:bg-amber-50/40 dark:hover:bg-amber-950/20 focus:outline-none focus:ring-4 focus:ring-amber-500/20"
    >
      <input type="file" id="rp-file-input" accept=".pdf,application/pdf" class="sr-only" />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 dark:bg-amber-950/60 text-4xl transition group-hover:scale-105">
        🔄
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop your PDF file here to rotate pages
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or click below to choose a PDF from your computer or mobile device
        </p>
      </div>

      <button
        type="button"
        id="rp-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-amber-600 hover:bg-amber-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose PDF File
      </button>
    </div>

    <!-- Options & Preview Section -->
    <div id="rp-options-section" class="hidden space-y-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <div class="flex items-start gap-3">
          <span class="text-2xl shrink-0">📄</span>
          <div class="flex-1 min-w-0">
            <p id="rp-filename" class="text-sm font-bold text-slate-900 dark:text-white truncate"></p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              <span id="rp-file-size"></span> • <span id="rp-page-count"></span>
            </p>
          </div>
          <button type="button" id="rp-clear-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer">
            Change File
          </button>
        </div>
      </div>

      <!-- Quick Rotation Controls -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Batch Rotation Controls
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Apply uniform rotation to all pages or rotate specific pages individually below.
            </p>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <button
              type="button"
              id="rp-rot-90"
              class="px-3 py-1.5 rounded-xl font-bold text-xs bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/60 dark:hover:bg-amber-900/80 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/80 transition cursor-pointer"
            >
              ⟳ All 90° CW
            </button>
            <button
              type="button"
              id="rp-rot-180"
              class="px-3 py-1.5 rounded-xl font-bold text-xs bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/60 dark:hover:bg-amber-900/80 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/80 transition cursor-pointer"
            >
              🔄 All 180°
            </button>
            <button
              type="button"
              id="rp-rot-270"
              class="px-3 py-1.5 rounded-xl font-bold text-xs bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/60 dark:hover:bg-amber-900/80 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/80 transition cursor-pointer"
            >
              ⟲ All 270° (90° CCW)
            </button>
            <button
              type="button"
              id="rp-rot-reset"
              class="px-3 py-1.5 rounded-xl font-bold text-xs bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition cursor-pointer"
            >
              Reset
            </button>
          </div>
        </div>

        <!-- Page Thumbnails Grid -->
        <div id="rp-pages-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 max-h-96 overflow-y-auto p-2 bg-slate-50 dark:bg-slate-950/50 rounded-xl border border-slate-200 dark:border-slate-800">
          <!-- Dynamically populated page cards -->
        </div>
      </div>

      <button
        type="button"
        id="rp-rotate-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-amber-600 hover:bg-amber-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-6 py-3 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Save & Download Rotated PDF
      </button>
    </div>

    <!-- Status Section -->
    <div id="rp-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="rp-status-icon" class="text-2xl shrink-0"></span>
        <div class="space-y-1 min-w-0 flex-1">
          <p id="rp-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="rp-status-body" class="text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="rp-progress-bar" class="hidden mt-2.5">
            <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div id="rp-progress-fill" class="bg-amber-600 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Download Section -->
    <div id="rp-download-section" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 p-6 text-center space-y-4">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 dark:bg-emerald-900/60 text-3xl">
        🎉
      </div>
      <div>
        <h3 class="text-lg font-bold text-emerald-900 dark:text-emerald-200">
          PDF Successfully Rotated!
        </h3>
        <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">
          <span id="rp-download-filename"></span> • <span id="rp-download-size"></span>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="rp-download-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 px-6 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Rotated PDF
        </button>

        <button
          type="button"
          id="rp-start-over-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 transition cursor-pointer"
        >
          Rotate Another PDF
        </button>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <!-- Section 1 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Rotate PDF: Permanently Rotate PDF Pages Online for Free
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Scanned documents, smartphone photos converted to PDF, or landscape spreadsheets frequently open sideways or upside down. Our <strong>Rotate PDF</strong> tool allows you to fix page orientation permanently directly within your browser.
        </p>
        <p class="leading-relaxed">
          Rotate all pages uniformly or target individual inverted pages with 90° clockwise, 180°, and 270° rotation options. Everything is processed 100% locally on your device for complete data privacy.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Why Use Our Online PDF Rotator?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '🔄',
              title: 'Individual & Batch Rotation',
              desc: 'Rotate single landscape pages or apply 90°/180° rotation across all pages in one single click.'
            },
            {
              icon: '🔒',
              title: '100% Client-Side Privacy',
              desc: 'Your files are processed locally inside your web browser. No documents are ever uploaded to any server.'
            },
            {
              icon: '⚡',
              title: 'Instant Metadata Updates',
              desc: 'Rotation modifies internal PDF orientation flags in milliseconds with zero re-rendering delay.'
            },
            {
              icon: '📄',
              title: 'No Quality Degradation',
              desc: 'Vector typography, high-res scans, and embedded artwork remain untouched and 100% sharp.'
            },
            {
              icon: '💾',
              title: 'Permanent Orientation Fix',
              desc: 'The downloaded PDF stays oriented correctly permanently across Adobe Acrobat, Chrome, and printers.'
            },
            {
              icon: '🚫',
              title: 'Completely Free & Unlimited',
              desc: 'No page count caps, no daily quotas, no registration needed, and zero promotional watermarks.'
            }
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{icon}</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related PDF Navigation -->
      <section class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Explore Related PDF Tools
        </h3>
        <div class="flex flex-wrap gap-2 text-xs sm:text-sm">
          <a href="/pdf-tools/delete-pages-from-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-red-600 dark:text-red-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Delete PDF Pages →
          </a>
          <a href="/pdf-tools/reorder-pdf-pages/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Reorder PDF Pages →
          </a>
          <a href="/pdf-tools/pdf-split/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Split PDF Pages →
          </a>
          <a href="/pdf-tools/pdf-compress/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-purple-600 dark:text-purple-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Compress PDF →
          </a>
        </div>
      </section>
    </div>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-4 transition-colors [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 dark:text-white font-semibold text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-amber-600 dark:text-amber-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>
