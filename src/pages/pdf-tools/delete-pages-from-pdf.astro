---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How do I select which pages to delete from my PDF?",
    answer: "You can click directly on page preview thumbnails to toggle their deletion (marked with a red cross), or type specific page numbers and ranges (e.g. '1, 3-5, 8') in the page input field."
  },
  {
    question: "Is my original PDF modified or permanently damaged?",
    answer: "No. Your original file remains untouched on your computer. The tool creates a brand new PDF containing only the pages you choose to keep."
  },
  {
    question: "Are my PDF files uploaded to your server?",
    answer: "Never. All page extraction, filtering, and PDF generation take place locally within your web browser memory using pdf-lib and PDF.js. Your documents never leave your computer."
  },
  {
    question: "Can I delete multiple pages at the same time?",
    answer: "Yes. You can delete single pages, multiple selected pages, or entire page ranges simultaneously."
  },
  {
    question: "Is there any limit on file size or page count?",
    answer: "There are no arbitrary software limits or paywalls. You can delete pages from PDFs of any size as long as your browser and computer have sufficient RAM."
  },
  {
    question: "Will hyperlinks, text formatting, and images be preserved?",
    answer: "Yes. The remaining pages retain 100% of their original vector quality, embedded images, fonts, and annotations."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Delete PDF Pages Online",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Delete specific pages or page ranges from any PDF online for free directly in your web browser with complete privacy."
};
---

<CalculatorLayout
  layoutVariant="workspace"
  title="Delete Pages from PDF - Remove PDF Pages Online Free"
  description="Delete single pages, multiple pages, or custom page ranges from any PDF file online for free. Visual page picker, fast, secure client-side processing."
  category="PDF Tools"
  calculatorName="Delete PDF Pages"
  slug="delete-pages-from-pdf"
  keywords={[
    'delete pages from pdf',
    'remove pages from pdf',
    'delete pdf pages online',
    'remove pdf pages free',
    'extract pages from pdf',
    'pdf page remover'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Client-Side Libraries Loader -->
  <script is:inline>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = cb;
        s.onerror = cb;
        document.head.appendChild(s);
      }

      loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js', function() {
        if (window.pdfjsLib) {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }
        loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js', function() {
          var ts = document.createElement('script');
          ts.src = '/js/tools/delete-pages-from-pdf.js';
          document.body.appendChild(ts);
        });
      });
    })();
  </script>

  <div class="space-y-5">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800/80 text-rose-700 dark:text-rose-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>100% Client-Side • Visual Page Selector • 100% Free & Private</span>
      </div>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Selectively remove unwanted pages or blank sheets from any PDF document. Click pages visually or enter page ranges.
      </p>

      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Local Privacy:</strong> Your PDF is processed locally in your browser memory and is never uploaded to any remote server.</span>
      </div>
    </div>

    <!-- Error Box -->
    <div
      id="dp-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="dp-error-text"></span>
    </div>

    <!-- Drop Zone -->
    <div
      id="dp-drop-zone"
      tabindex="0"
      role="button"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-rose-400 dark:hover:border-rose-600 hover:bg-rose-50/40 dark:hover:bg-rose-950/20 focus:outline-none focus:ring-4 focus:ring-rose-500/20"
    >
      <input type="file" id="dp-file-input" accept="application/pdf,.pdf" class="sr-only" />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-rose-100 dark:bg-rose-950/60 text-4xl transition group-hover:scale-105">
        🗑️
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop your PDF here to remove pages
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or click below to browse from your device
        </p>
      </div>

      <button
        type="button"
        id="dp-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-rose-600 hover:bg-rose-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-rose-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose PDF File
      </button>
    </div>

    <!-- Options & Page Grid -->
    <div id="dp-options-section" class="hidden space-y-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div class="flex items-start gap-3 min-w-0">
            <span class="text-2xl shrink-0">📄</span>
            <div class="min-w-0">
              <p id="dp-filename" class="text-sm font-bold text-slate-900 dark:text-white truncate"></p>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                <span id="dp-page-count">0</span> pages • <span id="dp-file-size">0 KB</span>
              </p>
            </div>
          </div>
          <button type="button" id="dp-clear-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer">
            Change PDF
          </button>
        </div>
      </div>

      <!-- Controls and Range Input -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5 space-y-4">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Select Pages to Remove
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Click thumbnails below to mark for deletion, or type ranges.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              id="dp-select-all"
              class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition cursor-pointer"
            >
              Select All
            </button>
            <button
              type="button"
              id="dp-deselect-all"
              class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition cursor-pointer"
            >
              Clear Selection
            </button>
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="dp-range-input" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
            Pages to Delete (e.g. 1, 3-5, 8)
          </label>
          <input
            type="text"
            id="dp-range-input"
            placeholder="e.g. 2, 4-6, 9"
            class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3.5 py-2.5 text-sm font-medium text-slate-900 dark:text-white focus:border-rose-500 focus:outline-none"
          />
        </div>
      </div>

      <!-- Thumbnails Grid -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5 space-y-3">
        <div class="flex items-center justify-between text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          <span>Page Previews</span>
          <span id="dp-delete-summary" class="text-rose-600 dark:text-rose-400 font-semibold">0 pages selected for deletion</span>
        </div>

        <div id="dp-pages-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 max-h-[500px] overflow-y-auto p-1"></div>
      </div>

      <button
        type="button"
        id="dp-delete-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-rose-600 hover:bg-rose-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-6 py-3 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-rose-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Delete Selected Pages & Save PDF
      </button>
    </div>

    <!-- Status Section -->
    <div id="dp-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="dp-status-icon" class="text-2xl shrink-0"></span>
        <div class="space-y-1 min-w-0 flex-1">
          <p id="dp-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="dp-status-body" class="text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="dp-progress-bar" class="hidden mt-2.5">
            <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div id="dp-progress-fill" class="bg-rose-600 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Download Section -->
    <div id="dp-download-section" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 p-6 text-center space-y-4">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 dark:bg-emerald-900/60 text-3xl">
        🎉
      </div>
      <div>
        <h3 class="text-lg font-bold text-emerald-900 dark:text-emerald-200">
          Pages Removed Successfully!
        </h3>
        <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">
          <span id="dp-download-filename"></span> • <span id="dp-download-size"></span>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="dp-download-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 px-6 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Cleaned PDF
        </button>

        <button
          type="button"
          id="dp-start-over-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 transition cursor-pointer"
        >
          Modify Another PDF
        </button>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Delete Pages from PDF: Fast, Visual & 100% Private
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Accidentally scanned blank pages? Need to extract sensitive information before sharing a presentation? Our <strong>Delete Pages from PDF</strong> tool gives you full control over document curation.
        </p>
        <p class="leading-relaxed">
          Inspect visual page thumbnails directly in your web browser, select specific pages or enter comma-separated page ranges, and generate a freshly cleaned PDF document in seconds.
        </p>
      </section>

      <!-- Key Benefits -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Why Use Our Delete PDF Pages Tool?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '👁️',
              title: 'Visual Page Previews',
              desc: 'Interactive high-resolution thumbnail previews let you inspect each page before deciding to remove it.'
            },
            {
              icon: '🔒',
              title: '100% Private & Secure',
              desc: 'Pages are extracted and saved directly in your browser memory without uploading any bytes to remote servers.'
            },
            {
              icon: '⚡',
              title: 'Zero Re-compression Loss',
              desc: 'Retains all original vector graphics, crisp fonts, sharp images, and interactive bookmarks.'
            },
            {
              icon: '🔢',
              title: 'Flexible Range Selection',
              desc: 'Delete pages by clicking previews or typing comma-separated ranges such as 1-3, 5, 7-10.'
            },
            {
              icon: '📱',
              title: 'Works on All Devices',
              desc: 'Smoothly delete PDF pages on mobile phones, iPads, laptops, and desktop computers.'
            },
            {
              icon: '🚫',
              title: 'No Limits or Watermarks',
              desc: 'Clean up documents of any length with zero watermarks, limits, or hidden fees.'
            }
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{icon}</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related PDF Navigation -->
      <section class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Explore Related PDF Tools
        </h3>
        <div class="flex flex-wrap gap-2 text-xs sm:text-sm">
          <a href="/pdf-tools/reorder-pdf-pages/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Reorder PDF Pages →
          </a>
          <a href="/pdf-tools/rotate-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Rotate PDF Pages →
          </a>
          <a href="/pdf-tools/pdf-split/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Split PDF Document →
          </a>
          <a href="/pdf-tools/pdf-merge/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Merge PDF Files →
          </a>
        </div>
      </section>
    </div>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-4 transition-colors [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 dark:text-white font-semibold text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-rose-600 dark:text-rose-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>
