---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How does the Unlock PDF tool remove passwords and restrictions?",
    answer: "Our Unlock PDF tool operates 100% inside your browser using pdf-lib. When you provide the password for an encrypted PDF, the tool authenticates the encryption key, extracts the original unencrypted page streams, and reconstructs a completely unrestricted, decrypted PDF file."
  },
  {
    question: "Do I need to know the PDF password to unlock it?",
    answer: "If the PDF has user-level (open) password encryption, you need to provide the valid password once so the browser can decrypt the binary streams. If the document only has permission restrictions (e.g. printing or editing blocked without an open password), our tool can remove those restrictions automatically."
  },
  {
    question: "Is it secure to unlock sensitive PDFs on this website?",
    answer: "Yes, completely safe. Your PDF file and password are never uploaded to any cloud server. Decryption occurs exclusively in your local device's browser memory, ensuring your confidential financial, legal, and personal documents stay 100% private."
  },
  {
    question: "Will unlocking a PDF reduce its visual quality or formatting?",
    answer: "No. The document's vector text, embedded images, fonts, tables, and hyperlinks are copied losslessly into the newly unlocked PDF document without any quality degradation."
  },
  {
    question: "Can I use this unlocked PDF on any device or software?",
    answer: "Yes. Once unlocked and downloaded, the PDF is a standard, unencrypted document that can be opened, edited, annotated, and printed in any PDF viewer or browser without prompting for a password."
  },
  {
    question: "Is this Unlock PDF tool free with no limits?",
    answer: "Yes, our Unlock PDF tool is 100% free with no registration, no file size caps, no daily quotas, and no watermarks."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Unlock PDF",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Unlock password protected PDF files online for free. Decrypt and remove PDF security restrictions directly in your browser with zero file uploads."
};
---

<CalculatorLayout
  title="Unlock PDF - Remove Password from PDF Online Free"
  description="Unlock password protected PDF files online for free. Decrypt and remove PDF password security directly in your browser with zero uploads."
  category="PDF Tools"
  calculatorName="Unlock PDF"
  slug="unlock-pdf"
  keywords={[
    'unlock pdf',
    'remove password from pdf',
    'decrypt pdf online',
    'pdf password remover',
    'unlock pdf free',
    'remove pdf security',
    'pdf unlocker'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- PDF-Lib and Unlock Tool Script -->
  <script is:inline>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = cb;
        s.onerror = cb;
        document.head.appendChild(s);
      }

      loadScript('https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js', function() {
        var ts = document.createElement('script');
        ts.src = '/js/tools/unlock-pdf.js';
        document.body.appendChild(ts);
      });
    })();
  </script>

  <div class="space-y-5">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
        </svg>
        <span>100% Client-Side • Decrypt & Remove Restrictions • 100% Private</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Unlock PDF Online Free
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Remove password protection and printing/editing restrictions from PDF documents directly in your web browser. No software installation needed.
      </p>

      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Local Processing:</strong> Your password and PDF are decrypted entirely in your local browser memory. Nothing is ever uploaded to external servers.</span>
      </div>
    </div>

    <!-- Error Box -->
    <div
      id="up-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="up-error-text"></span>
    </div>

    <!-- Drop Zone -->
    <div
      id="up-drop-zone"
      tabindex="0"
      role="button"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-blue-400 dark:hover:border-blue-600 hover:bg-blue-50/40 dark:hover:bg-blue-950/20 focus:outline-none focus:ring-4 focus:ring-blue-500/20"
    >
      <input type="file" id="up-file-input" accept=".pdf,application/pdf" class="sr-only" />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 dark:bg-blue-950/60 text-4xl transition group-hover:scale-105">
        🔓
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop your protected PDF file here to unlock
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or click below to choose a PDF from your computer or phone
        </p>
      </div>

      <button
        type="button"
        id="up-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose PDF File
      </button>
    </div>

    <!-- Options Section -->
    <div id="up-options-section" class="hidden space-y-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <div class="flex items-start gap-3">
          <span class="text-2xl shrink-0">📄</span>
          <div class="flex-1 min-w-0">
            <p id="up-filename" class="text-sm font-bold text-slate-900 dark:text-white truncate"></p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              <span id="up-file-size"></span>
            </p>
          </div>
          <button type="button" id="up-clear-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer">
            Change File
          </button>
        </div>
      </div>

      <!-- Password Input Box -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Enter Document Password
          </h2>
          <button type="button" id="up-toggle-password" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline cursor-pointer">
            👁️ Show
          </button>
        </div>

        <div class="space-y-1.5">
          <label for="up-password" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
            PDF Password (if required to open)
          </label>
          <input
            type="password"
            id="up-password"
            placeholder="Type password if the document is encrypted"
            class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3.5 py-2.5 text-sm font-medium text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
          />
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400">
          💡 If the PDF only has print/copy restrictions without a password, leave blank and click unlock.
        </p>
      </div>

      <button
        type="button"
        id="up-unlock-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-6 py-3 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
        </svg>
        Unlock & Decrypt PDF Now
      </button>
    </div>

    <!-- Status Section -->
    <div id="up-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="up-status-icon" class="text-2xl shrink-0"></span>
        <div class="space-y-1 min-w-0 flex-1">
          <p id="up-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="up-status-body" class="text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="up-progress-bar" class="hidden mt-2.5">
            <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div id="up-progress-fill" class="bg-blue-600 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Download Section -->
    <div id="up-download-section" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 p-6 text-center space-y-4">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 dark:bg-emerald-900/60 text-3xl">
        🎉
      </div>
      <div>
        <h3 class="text-lg font-bold text-emerald-900 dark:text-emerald-200">
          PDF Successfully Unlocked!
        </h3>
        <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">
          <span id="up-download-filename"></span> • <span id="up-download-size"></span>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="up-download-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 px-6 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Unlocked PDF
        </button>

        <button
          type="button"
          id="up-start-over-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 transition cursor-pointer"
        >
          Unlock Another PDF
        </button>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <!-- Section 1 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Unlock PDF: Free Online PDF Password & Restriction Remover
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Password-protected PDF files can be cumbersome to open every time you need to review a bank e-statement, paystub, insurance policy, or tax document. Our <strong>Unlock PDF</strong> tool decrypts and removes security restrictions permanently so you can open, print, and share your PDF freely.
        </p>
        <p class="leading-relaxed">
          Best of all, our tool runs 100% client-side in your web browser. Neither your PDF file nor your password is ever uploaded to a remote cloud server, giving you complete privacy for confidential records.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Key Features of Our PDF Unlocker
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '🔒',
              title: '100% Client-Side Decryption',
              desc: 'Decryption algorithms execute locally in your browser memory. Your documents and passwords never leave your computer.'
            },
            {
              icon: '🖨️',
              title: 'Remove Printing & Copying Limits',
              desc: 'Instantly strip owner restrictions that prevent printing, copying text, or editing pages in external viewers.'
            },
            {
              icon: '⚡',
              title: 'Instant Document Generation',
              desc: 'Process files in seconds without waiting for cloud upload/download queues or external server queues.'
            },
            {
              icon: '📄',
              title: 'Lossless Visual Quality',
              desc: 'High-resolution images, vector text, font glyphs, and forms are preserved with zero compression degradation.'
            },
            {
              icon: '📱',
              title: 'Cross-Platform Compatibility',
              desc: 'Works flawlessly across Google Chrome, Safari, Firefox, and Edge on iOS, Android, macOS, and Windows.'
            },
            {
              icon: '🚫',
              title: 'Unlimited Free Usage',
              desc: 'No account registration, no hidden subscriptions, no file size caps, and zero watermarks on unlocked PDFs.'
            }
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{icon}</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related PDF Navigation -->
      <section class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Explore More PDF Tools
        </h3>
        <div class="flex flex-wrap gap-2 text-xs sm:text-sm">
          <a href="/pdf-tools/protect-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-red-600 dark:text-red-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Protect PDF →
          </a>
          <a href="/pdf-tools/pdf-compress/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-purple-600 dark:text-purple-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Compress PDF →
          </a>
          <a href="/pdf-tools/rotate-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Rotate PDF Pages →
          </a>
          <a href="/pdf-tools/pdf-split/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Split PDF Pages →
          </a>
        </div>
      </section>
    </div>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-4 transition-colors [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 dark:text-white font-semibold text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-blue-600 dark:text-blue-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>
