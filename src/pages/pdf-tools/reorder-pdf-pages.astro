---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How do I rearrange or reorder pages in my PDF?",
    answer: "Upload your PDF document to see all page thumbnails. Use the ◀ Left and Right ▶ buttons on each page card to shift pages into your desired sequence, or click 'Reverse All' to invert the entire document order."
  },
  {
    question: "Will rearranging pages affect document quality or bookmarks?",
    answer: "No. The pages are cloned losslessly at the binary level using pdf-lib. All high-resolution graphics, vectors, embedded fonts, and page contents remain 100% intact."
  },
  {
    question: "Are my files stored or uploaded to any server?",
    answer: "No. All reordering operations occur entirely inside your local web browser memory. No files are uploaded to any external server, ensuring absolute privacy."
  },
  {
    question: "Can I invert the page order of a scanned document?",
    answer: "Yes. With a single click of the 'Reverse All Pages' button, you can flip documents that were scanned in backwards order."
  },
  {
    question: "Is there a limit on how many pages I can reorder?",
    answer: "No arbitrary limits exist. You can reorder documents with dozens or hundreds of pages as long as your device has adequate RAM."
  },
  {
    question: "Is this PDF reordering tool free to use?",
    answer: "Yes, our Reorder PDF tool is completely free with no registration, no subscriptions, and zero watermarks added to your output file."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Reorder PDF Pages Online",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Rearrange, sort, and reorder pages in any PDF file online for free with interactive visual preview and 100% client-side privacy."
};
---

<CalculatorLayout
  title="Reorder PDF Pages - Rearrange PDF Pages Online Free"
  description="Rearrange and sort PDF pages in any order online for free. Visual page organizer, reverse page order, fast and secure client-side processing."
  category="PDF Tools"
  calculatorName="Reorder PDF Pages"
  slug="reorder-pdf-pages"
  keywords={[
    'reorder pdf pages',
    'rearrange pdf pages',
    'organize pdf pages',
    'sort pdf pages online',
    'reverse pdf page order',
    'pdf page organizer'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Client-Side Libraries Loader -->
  <script is:inline>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = cb;
        s.onerror = cb;
        document.head.appendChild(s);
      }

      loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js', function() {
        if (window.pdfjsLib) {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }
        loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js', function() {
          var ts = document.createElement('script');
          ts.src = '/js/tools/reorder-pdf-pages.js';
          document.body.appendChild(ts);
        });
      });
    })();
  </script>

  <div class="space-y-5">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800/80 text-cyan-700 dark:text-cyan-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        <span>100% Client-Side • Interactive Visual Sorting • 100% Free & Private</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Reorder PDF Pages
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Rearrange, sort, and organize the pages of any PDF document into your desired custom order with easy interactive controls.
      </p>

      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Local Privacy:</strong> Your PDF document is rearranged in local browser memory and is never uploaded to any remote server.</span>
      </div>
    </div>

    <!-- Error Box -->
    <div
      id="ro-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="ro-error-text"></span>
    </div>

    <!-- Drop Zone -->
    <div
      id="ro-drop-zone"
      tabindex="0"
      role="button"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-cyan-400 dark:hover:border-cyan-600 hover:bg-cyan-50/40 dark:hover:bg-cyan-950/20 focus:outline-none focus:ring-4 focus:ring-cyan-500/20"
    >
      <input type="file" id="ro-file-input" accept="application/pdf,.pdf" class="sr-only" />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-cyan-100 dark:bg-cyan-950/60 text-4xl transition group-hover:scale-105">
        🔄
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop your PDF here to rearrange page order
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or click below to choose a document from your computer
        </p>
      </div>

      <button
        type="button"
        id="ro-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-cyan-600 hover:bg-cyan-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose PDF File
      </button>
    </div>

    <!-- Options & Page Sorter -->
    <div id="ro-options-section" class="hidden space-y-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div class="flex items-start gap-3 min-w-0">
            <span class="text-2xl shrink-0">📄</span>
            <div class="min-w-0">
              <p id="ro-filename" class="text-sm font-bold text-slate-900 dark:text-white truncate"></p>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                <span id="ro-page-count">0</span> pages • <span id="ro-file-size">0 KB</span>
              </p>
            </div>
          </div>
          <button type="button" id="ro-clear-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer">
            Change PDF
          </button>
        </div>
      </div>

      <!-- Quick Action Toolbar -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Organize & Sort Pages
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Use the arrow buttons on each card to adjust sequence.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="ro-reverse-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
            Reverse All Pages
          </button>
          <button
            type="button"
            id="ro-reset-btn"
            class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition cursor-pointer"
          >
            Reset Order
          </button>
        </div>
      </div>

      <!-- Thumbnails Sorting Grid -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5">
        <div id="ro-pages-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 max-h-[550px] overflow-y-auto p-1"></div>
      </div>

      <button
        type="button"
        id="ro-save-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-600 hover:bg-cyan-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-6 py-3 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
        </svg>
        Save & Download Reordered PDF
      </button>
    </div>

    <!-- Status Section -->
    <div id="ro-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="ro-status-icon" class="text-2xl shrink-0"></span>
        <div class="space-y-1 min-w-0 flex-1">
          <p id="ro-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="ro-status-body" class="text-xs text-slate-500 dark:text-slate-400"></div>
          <div id="ro-progress-bar" class="hidden mt-2.5">
            <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div id="ro-progress-fill" class="bg-cyan-600 h-full transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Download Section -->
    <div id="ro-download-section" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 p-6 text-center space-y-4">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 dark:bg-emerald-900/60 text-3xl">
        🎉
      </div>
      <div>
        <h3 class="text-lg font-bold text-emerald-900 dark:text-emerald-200">
          PDF Pages Reordered Successfully!
        </h3>
        <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">
          <span id="ro-download-filename"></span> • <span id="ro-download-size"></span>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="ro-download-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 px-6 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Reordered PDF
        </button>

        <button
          type="button"
          id="ro-start-over-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 transition cursor-pointer"
        >
          Reorder Another PDF
        </button>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Reorder PDF Pages: Sort and Organize PDF Pages Online
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Need to correct out-of-order scanned contracts, shift presentation slides, or arrange chapters logically? Our <strong>Reorder PDF Pages</strong> tool allows you to visually sort and reposition every page in your PDF document effortlessly.
        </p>
        <p class="leading-relaxed">
          Instantly adjust positions with responsive left and right arrows or invert the entire document order with a single click. Everything executes locally in your browser memory with zero loss in quality.
        </p>
      </section>

      <!-- Key Benefits -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Why Use Our PDF Page Reordering Tool?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '🔄',
              title: 'Visual Page Sorting',
              desc: 'Interactive high-definition previews make it simple to track and rearrange page positions.'
            },
            {
              icon: '🔒',
              title: '100% Private & Client-Side',
              desc: 'Pages are re-sequenced locally in your browser memory. Your documents never touch external servers.'
            },
            {
              icon: '⚡',
              title: 'Lossless Page Cloning',
              desc: 'Preserves 100% of original vector quality, embedded images, crisp fonts, and document bookmarks.'
            },
            {
              icon: '🔁',
              title: 'One-Click Page Inversion',
              desc: 'Easily fix documents that were scanned backwards with the instant Reverse All feature.'
            },
            {
              icon: '📱',
              title: 'Cross-Device Compatibility',
              desc: 'Reorder PDF documents on your desktop, laptop, iPhone, iPad, or Android phone.'
            },
            {
              icon: '🚫',
              title: 'Completely Free with No Limits',
              desc: 'No page caps, no daily upload limitations, and zero unwanted watermarks stamped on your documents.'
            }
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{icon}</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related PDF Navigation -->
      <section class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Explore Related PDF Tools
        </h3>
        <div class="flex flex-wrap gap-2 text-xs sm:text-sm">
          <a href="/pdf-tools/delete-pages-from-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-rose-600 dark:text-rose-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Delete PDF Pages →
          </a>
          <a href="/pdf-tools/rotate-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Rotate PDF Pages →
          </a>
          <a href="/pdf-tools/pdf-merge/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Merge PDF Files →
          </a>
          <a href="/pdf-tools/pdf-split/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Split PDF Document →
          </a>
        </div>
      </section>
    </div>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-4 transition-colors [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 text-slate-900 dark:text-white font-semibold text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="shrink-0 transition duration-300 group-open:-rotate-180 text-cyan-600 dark:text-cyan-400">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>
