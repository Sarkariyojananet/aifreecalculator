---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import AdSlotTop from '../components/ads/AdSlotTop.astro';
import AdSlotInline from '../components/ads/AdSlotInline.astro';
import AdSlotFooter from '../components/ads/AdSlotFooter.astro';
import { getCalculatorsByCategory } from '../data/calculators';
import { getCalculatorOverrides } from '../lib/admin/content-store';
import { getLivePageMeta } from '../lib/seo/page-metadata';

const pdfTools = getCalculatorsByCategory('PDF Tools');
const overrides = await getCalculatorOverrides(Astro.locals);
const override = overrides['category:pdf-tools'] || {};
const liveMeta = getLivePageMeta('category:pdf-tools');

const effectiveTitle = override.metaTitle || liveMeta.title;
const effectiveDescription = override.metaDescription || liveMeta.description;
const effectiveCanonical = override.canonicalUrl;
const effectiveRobots = override.robots;
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
  noindex={effectiveRobots?.includes('noindex')}
  ogImage="/og/default.png"
>
  <section class="border-b border-slate-200 bg-white px-4 py-12 dark:border-slate-800 dark:bg-slate-900/60 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <div class="flex items-center gap-2 text-xs text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider mb-2">
        <span>📄</span> PDF UTILITIES SUITE
      </div>
      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Free Online PDF Tools
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        Free, fast, and privacy-friendly web utilities for merging, splitting, compressing, and converting PDF documents directly in your browser with zero server uploads.
      </p>
    </div>
  </section>

  <!-- Top Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotTop />
  </div>

  <section class="px-4 py-10">
    <div class="mx-auto max-w-7xl space-y-6">
      <CategoryTabs activeCategory="pdf-tools" />

      <!-- First 6 Calculators -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pdfTools.slice(0, 6).map((calc) => (
          <CalculatorCard calculator={calc} />
        ))}
      </div>

      <!-- Middle Ad Slot -->
      <div class="py-2">
        <AdSlotInline />
      </div>

      <!-- Remaining Calculators (if any) -->
      {pdfTools.length > 6 && (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {pdfTools.slice(6).map((calc) => (
            <CalculatorCard calculator={calc} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Client-Side PDF Engineering & Document Security Educational Section -->
  <section class="border-t border-slate-200 bg-white px-4 py-12 dark:border-slate-800 dark:bg-slate-900/60 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-10">
      <div class="max-w-3xl space-y-3">
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">
          Client-Side PDF Manipulation & Cryptographic Security
        </h2>
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          Working with contracts, invoices, and sensitive legal documentation requires absolute data discretion. Our browser-based PDF suite merges, splits, compresses, and extracts pages without transmitting records across public networks.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">📑</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">PDF Binary Stream Parsing</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            PDF manipulation utilizes modern WebAssembly and JavaScript binary stream parsers (such as pdf-lib). Operations like merging multiple documents, deleting pages, or rearranging sheet sequences modify the underlying cross-reference tables (XRef) entirely in browser memory.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">🔐</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Zero Cloud Ingestion Compliance</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Most online PDF tools upload your sensitive tax forms, medical records, or corporate NDAs to remote cloud servers for conversion. In contrast, our tools run 100% locally on your device, ensuring complete adherence to GDPR and data sovereignty best practices.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">⚡</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Sub-Second Processing</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Because operations do not incur upload or download network latency, file processing takes milliseconds rather than minutes. Output files download immediately as fresh binary Blobs without server queues or rate-limiting subscriptions.
          </p>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-6 dark:border-slate-800 dark:bg-slate-950/40 text-xs leading-relaxed text-slate-700 dark:text-slate-300 space-y-2">
        <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🔒</span> Document Security Recommendation
        </div>
        <p>
          Always ensure confidential PDF documents are password-protected before sharing via email. For digitally signed PDFs, note that rearranging or removing pages invalidates existing cryptographic certificates, which require re-signing after structural edits.
        </p>
      </div>
    </div>
  </section>

  <!-- Bottom Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotFooter />
  </div>
</BaseLayout>
