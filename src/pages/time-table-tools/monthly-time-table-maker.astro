---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { buildYear, EN_LOCALE } from '../../utils/monthlyTimetable';

const defaultYear = 2026;
const initialYearData = buildYear(defaultYear, 'sunday', 'DD-MM-YYYY', 'all', false);

// FAQ Schema for Search Engines
const faqs = [
  {
    question: "How do I add date-wise notes to my timetable?",
    answer: "You can add notes in two ways: 1) Use the dedicated 'Add Date-Wise Note' panel to select any date and type your schedule or reminder, or 2) Click directly on any date box in Calendar View or type into the Notes column in Table View. All notes are saved automatically in your browser."
  },
  {
    question: "How are Excel and CSV files structured?",
    answer: "Both Excel (.xlsx) and CSV exports are formatted with a calendar grid structure featuring 7-column day layouts for each month along with dedicated note rows for each scheduled date."
  },
  {
    question: "How does the combined Print / PDF button work?",
    answer: "Clicking 'Print / PDF' opens the high-resolution browser print and PDF preview dialog. You can print directly to any physical printer or select 'Save as PDF' to export a vector PDF that strictly matches your selected Calendar, Table, or Full Year layout."
  },
  {
    question: "Are my schedule notes stored permanently?",
    answer: "Yes, all notes are stored in your local browser storage (localStorage) so they remain intact across page reloads and future visits without needing a login or account."
  },
  {
    question: "Can I filter only weekdays or weekends?",
    answer: "Yes. Choose 'Weekdays Only' to isolate Monday through Friday for work and academic planning, or 'Weekends Only' to focus on Saturday and Sunday events and rest schedules."
  },
  {
    question: "Is my timetable data private and secure?",
    answer: "Yes. All timetable calculations, note storage, and PDF/Excel generation happen 100% in your browser. No schedule data is ever sent to our servers."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  title="Monthly Time Table Maker - Printable Calendar Generator with Date Notes"
  description="Generate, customize, print, and export monthly and yearly calendar timetables with date-wise notes. Export to Calendar-formatted Excel, CSV, and Print/PDF in active layout."
  category="Time Table Tools"
  calculatorName="Monthly Time Table Maker"
  slug="monthly-time-table-maker"
  keywords={[
    'monthly time table maker',
    'monthly timetable maker',
    'monthly schedule generator',
    'calendar timetable maker',
    'printable monthly timetable',
    'yearly timetable maker',
    'timetable with date notes',
    'calendar excel exporter',
    'calendar csv maker'
  ]}
>
  <!-- Injected FAQPage Schema for Search Engines -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Print Stylesheet -->
  <style is:inline>
    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
      header, footer, nav, aside, .no-print, #ttControlsCard, #ttStatsGrid, #ttExportBar, #ttDedicatedNotesSection, [data-ad-slot], .breadcrumb, #ttNoteModal {
        display: none !important;
      }
      #ttPrintTitle {
        display: block !important;
        text-align: center;
        margin-bottom: 20px;
        font-size: 20pt;
        font-weight: bold;
      }
      .month-card {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        border: 1px solid #cbd5e1 !important;
        margin-bottom: 24px !important;
        box-shadow: none !important;
      }
      table {
        width: 100% !important;
        border-collapse: collapse !important;
      }
      th, td {
        border: 1px solid #cbd5e1 !important;
        padding: 6px 8px !important;
        color: #000000 !important;
      }
    }
  </style>

  <!-- MAIN INTERACTIVE TOOL WIDGET -->
  <div class="space-y-6">

    <!-- Header & Intro Badge -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Calendar Grid Excel & CSV • Date-Wise Notes • Unified Print / PDF</span>
      </div>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Create, organize, and export customizable <strong>monthly and yearly timetables</strong> with custom date-wise notes. Download calendar-structured <strong>Excel & CSV</strong> files, and print or export to <strong>PDF</strong> in your active layout.
      </p>
    </div>

    <!-- PRINT ONLY TITLE -->
    <div id="ttPrintTitle" class="hidden text-center text-2xl font-bold text-slate-900 pb-2 mb-4 border-b border-slate-300">
      Monthly Timetable — 2026
    </div>

    <!-- STATS OVERVIEW CARDS -->
    <div id="ttStatsGrid" class="grid grid-cols-2 sm:grid-cols-6 gap-2.5 sm:gap-3">
      <div class="p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
        <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Active Year</span>
        <div id="ttStatYear" class="text-xl font-bold text-blue-600 dark:text-blue-400 font-mono mt-0.5">{defaultYear}</div>
      </div>
      <div class="p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
        <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Days</span>
        <div id="ttStatTotalDays" class="text-xl font-bold text-slate-900 dark:text-white font-mono mt-0.5">{initialYearData.totalDays}</div>
      </div>
      <div class="p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
        <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Weekdays</span>
        <div id="ttStatWeekdays" class="text-xl font-bold text-emerald-600 dark:text-emerald-400 font-mono mt-0.5">{initialYearData.totalWeekdays}</div>
      </div>
      <div class="p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
        <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Weekends</span>
        <div id="ttStatWeekends" class="text-xl font-bold text-rose-600 dark:text-rose-400 font-mono mt-0.5">{initialYearData.totalWeekends}</div>
      </div>
      <div class="p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs">
        <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Leap Year?</span>
        <div id="ttStatLeap" class="text-sm font-bold text-slate-800 dark:text-slate-200 mt-1">{initialYearData.isLeapYear ? 'Yes (366d)' : 'No (365d)'}</div>
      </div>
      <div class="col-span-2 sm:col-span-1 p-3.5 rounded-2xl border border-amber-200/80 dark:border-amber-900/60 bg-amber-50/50 dark:bg-amber-950/30 shadow-2xs">
        <span class="text-[11px] font-semibold text-amber-700 dark:text-amber-400 uppercase tracking-wider">Notes Saved</span>
        <div id="ttStatNotesCount" class="text-sm font-bold text-amber-900 dark:text-amber-200 mt-1">0 Saved</div>
      </div>
    </div>

    <!-- CONTROLS & FILTERS PANEL -->
    <div id="ttControlsCard" class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-6 shadow-sm space-y-5">

      <!-- Top Row: Year Picker + View Switcher -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">

        <!-- Year Control -->
        <div class="md:col-span-6 space-y-1.5">
          <label for="ttYearInput" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Target Year (1900 - 2100)
          </label>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="ttYearPrevBtn"
              class="px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 font-bold transition cursor-pointer shadow-2xs"
              title="Previous Year"
              aria-label="Previous Year"
            >
              ◀
            </button>
            <input
              type="number"
              id="ttYearInput"
              min="1900"
              max="2100"
              value={defaultYear}
              class="w-full text-center px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white font-mono font-bold text-lg focus:outline-hidden focus:ring-2 focus:ring-blue-500"
            />
            <button
              type="button"
              id="ttYearNextBtn"
              class="px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 font-bold transition cursor-pointer shadow-2xs"
              title="Next Year"
              aria-label="Next Year"
            >
              ▶
            </button>
          </div>
          <p id="ttYearError" class="hidden text-xs font-medium text-rose-600 dark:text-rose-400"></p>
        </div>

        <!-- View Segmented Switcher -->
        <div class="md:col-span-6 space-y-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Layout View (Print & PDF Will Match This Layout)
          </label>
          <div class="grid grid-cols-3 gap-1.5 p-1 rounded-2xl bg-slate-100 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800">
            <button
              type="button"
              id="ttViewCalendarBtn"
              class="px-3 py-2 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 text-white shadow-sm transition flex items-center justify-center gap-1.5 cursor-pointer"
              aria-pressed="true"
            >
              <span>📅</span> <span>Calendar</span>
            </button>
            <button
              type="button"
              id="ttViewTableBtn"
              class="px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition flex items-center justify-center gap-1.5 cursor-pointer"
              aria-pressed="false"
            >
              <span>📋</span> <span>Table</span>
            </button>
            <button
              type="button"
              id="ttViewFullYearBtn"
              class="px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition flex items-center justify-center gap-1.5 cursor-pointer"
              aria-pressed="false"
            >
              <span>🗂️</span> <span>Full Year</span>
            </button>
          </div>
        </div>

      </div>

      <!-- Secondary Filters Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-3 border-t border-slate-100 dark:border-slate-800">

        <!-- Month & Quarter Selector -->
        <div class="space-y-1">
          <label for="ttMonthSelect" class="block text-xs font-semibold text-slate-600 dark:text-slate-400">
            Calendar Month / Quarter
          </label>
          <select
            id="ttMonthSelect"
            class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-blue-500"
          >
            <option value="all">All 12 Months (Jan - Dec)</option>
            <optgroup label="Quarters & Semesters">
              <option value="q1">Q1 (January - March)</option>
              <option value="q2">Q2 (April - June)</option>
              <option value="q3">Q3 (July - September)</option>
              <option value="q4">Q4 (October - December)</option>
              <option value="h1">H1 (Jan - Jun / 1st Half)</option>
              <option value="h2">H2 (Jul - Dec / 2nd Half)</option>
            </optgroup>
            <optgroup label="Single Month">
              {EN_LOCALE.monthNames.map((name, idx) => (
                <option value={idx}>{name}</option>
              ))}
            </optgroup>
            <option value="custom" disabled>Custom Selection (Use Chips Below)</option>
          </select>
        </div>

        <!-- Weekday & Weekend Toggles -->
        <div class="space-y-1">
          <span class="block text-xs font-semibold text-slate-600 dark:text-slate-400">
            Show / Hide Days
          </span>
          <div class="flex items-center gap-2 pt-1">
            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer select-none">
              <input
                type="checkbox"
                id="ttToggleWeekdays"
                checked
                class="rounded text-blue-600 focus:ring-blue-500 w-3.5 h-3.5 cursor-pointer"
              />
              <span>Weekdays (Mon-Fri)</span>
            </label>
            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer select-none">
              <input
                type="checkbox"
                id="ttToggleWeekends"
                checked
                class="rounded text-rose-600 focus:ring-rose-500 w-3.5 h-3.5 cursor-pointer"
              />
              <span>Weekends (Sat-Sun)</span>
            </label>
          </div>
        </div>

        <!-- Week Starts On -->
        <div class="space-y-1">
          <label for="ttWeekStartSelect" class="block text-xs font-semibold text-slate-600 dark:text-slate-400">
            Week Starts On
          </label>
          <select
            id="ttWeekStartSelect"
            class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-blue-500"
          >
            <option value="sunday" selected>Sunday (Default)</option>
            <option value="monday">Monday</option>
          </select>
        </div>

        <!-- Date Format -->
        <div class="space-y-1">
          <label for="ttDateFormatSelect" class="block text-xs font-semibold text-slate-600 dark:text-slate-400">
            Date Format
          </label>
          <select
            id="ttDateFormatSelect"
            class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-xs sm:text-sm focus:ring-2 focus:ring-blue-500"
          >
            <option value="DD-MM-YYYY">DD-MM-YYYY (01-01-2026)</option>
            <option value="MM-DD-YYYY">MM-DD-YYYY (01-01-2026)</option>
            <option value="YYYY-MM-DD">YYYY-MM-DD (2026-01-01)</option>
            <option value="D MMMM YYYY">D MMMM YYYY (1 January 2026)</option>
            <option value="DD MMMM YYYY">DD MMMM YYYY (01 January 2026)</option>
          </select>
        </div>

      </div>

      <!-- Quick Multi-Month Selection Chips -->
      <div class="space-y-1.5 pt-2 border-t border-slate-100 dark:border-slate-800">
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400">
          Select Multiple Months to View & Print Together:
        </label>
        <div id="ttMonthChipsContainer" class="min-h-9.5 flex items-center">
          <!-- Dynamically populated chips -->
        </div>
      </div>

      <!-- Action Buttons Row (Combined Print/PDF, Calendar Excel, Calendar CSV) -->
      <div id="ttExportBar" class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100 dark:border-slate-800">

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- COMBINED PRINT / PDF BUTTON -->
          <button
            type="button"
            id="ttPrintPdfBtn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-sm transition cursor-pointer"
            title="Print or Save as PDF Calendar"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>🖨️ Print / PDF</span>
          </button>

          <!-- Export Excel (Calendar-Structured) -->
          <button
            type="button"
            id="ttExportExcelBtn"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition cursor-pointer shadow-2xs"
            title="Download Calendar-formatted Excel with notes"
          >
            <span>📊</span> <span>Calendar Excel (.xlsx)</span>
          </button>

          <!-- Export CSV (Calendar-Structured) -->
          <button
            type="button"
            id="ttExportCsvBtn"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition cursor-pointer shadow-2xs"
            title="Download Calendar-formatted CSV with notes"
          >
            <span>📑</span> <span>Calendar CSV</span>
          </button>
        </div>

        <div class="flex items-center gap-2">
          <!-- Clear Notes Button -->
          <button
            type="button"
            id="ttClearNotesBtn"
            class="inline-flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/50 transition cursor-pointer"
            title="Delete all custom schedule notes"
          >
            <span>🗑️ Clear Notes</span>
          </button>

          <!-- Reset Button -->
          <button
            type="button"
            id="ttResetBtn"
            class="inline-flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
          >
            <span>↺ Reset</span>
          </button>
        </div>

      </div>

    </div>

    <!-- DEDICATED DATE-WISE NOTE ADDITION SECTION -->
    <div id="ttDedicatedNotesSection" class="rounded-3xl border border-amber-200/80 dark:border-amber-900/60 bg-amber-50/40 dark:bg-amber-950/20 p-5 sm:p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-amber-200/60 dark:border-amber-900/40 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-lg">📝</span>
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            Add Date-Wise Note / Event / Reminder
          </h3>
        </div>
        <span class="text-xs text-amber-800 dark:text-amber-300 font-medium">Auto-saves to browser</span>
      </div>

      <!-- Quick Note Creator Form -->
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
        <!-- Select Date -->
        <div class="sm:col-span-4 space-y-1">
          <label for="ttDedicatedDateInput" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Select Date
          </label>
          <input
            type="date"
            id="ttDedicatedDateInput"
            class="w-full px-3 py-2.5 rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-xs sm:text-sm font-semibold focus:outline-hidden focus:ring-2 focus:ring-amber-500"
          />
        </div>

        <!-- Note Text Input -->
        <div class="sm:col-span-6 space-y-1">
          <div class="flex items-center justify-between">
            <label for="ttDedicatedNoteInput" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Schedule Note / Event Details
            </label>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="ttDedicatedBoldBtn"
                class="px-2 py-0.5 rounded text-[11px] font-black bg-white dark:bg-slate-850 border border-amber-300 dark:border-amber-800 text-slate-800 dark:text-white cursor-pointer shadow-2xs hover:bg-amber-100 dark:hover:bg-amber-950 transition"
                title="Bold"
              >
                B
              </button>
              <select
                id="ttDedicatedSizeSelect"
                class="px-1.5 py-0.5 rounded text-[11px] font-semibold bg-white dark:bg-slate-850 border border-amber-300 dark:border-amber-800 text-slate-800 dark:text-white cursor-pointer"
              >
                <option value="normal">Normal</option>
                <option value="sm">Small</option>
                <option value="lg">Large</option>
              </select>
            </div>
          </div>
          <input
            type="text"
            id="ttDedicatedNoteInput"
            placeholder="e.g. **Physics Exam** 10 AM, Project Deadline, Meeting..."
            class="w-full px-3.5 py-2.5 rounded-xl border border-amber-200 dark:border-amber-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-xs sm:text-sm focus:outline-hidden focus:ring-2 focus:ring-amber-500"
          />
        </div>

        <!-- Add Button -->
        <div class="sm:col-span-2">
          <button
            type="button"
            id="ttDedicatedAddNoteBtn"
            class="w-full py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold bg-amber-600 hover:bg-amber-700 text-white shadow-sm transition cursor-pointer flex items-center justify-center gap-1.5"
          >
            <span>+ Save Note</span>
          </button>
        </div>
      </div>

      <!-- Active Notes List Box -->
      <div class="pt-2 space-y-2">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">
          Saved Schedule Notes for Active Year:
        </h4>
        <div id="ttDedicatedNotesList" class="space-y-2">
          <!-- Dynamically filled by JS -->
        </div>
      </div>
    </div>

    <!-- MAIN TIMETABLE CONTAINER (Prerendered default static HTML) -->
    <div id="ttTimetableContainer" class="space-y-8">
      {initialYearData.months.map((m) => (
        <div class="month-card rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs">
          <div class="px-4 py-3 bg-linear-to-r from-slate-50 to-blue-50/50 dark:from-slate-950 dark:to-blue-950/20 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-600 dark:bg-blue-400"></span>
              <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white tracking-tight">
                {m.monthName} {m.year}
              </h3>
            </div>
            <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">
              {m.days.length} Days
            </div>
          </div>

          <div class="p-3 sm:p-5">
            <div class="grid grid-cols-7 gap-1 sm:gap-2 mb-2">
              {EN_LOCALE.shortDayNamesSundayStart.map((day, idx) => (
                <div class={`py-1.5 text-center text-[11px] sm:text-xs font-bold uppercase tracking-wider ${
                  (idx === 0 || idx === 6)
                    ? 'text-rose-600 dark:text-rose-400 bg-rose-50/60 dark:bg-rose-950/30 rounded-lg'
                    : 'text-slate-600 dark:text-slate-400 bg-slate-100/70 dark:bg-slate-800/70 rounded-lg'
                }`}>
                  {day}
                </div>
              ))}
            </div>

            <div class="grid grid-cols-7 gap-1 sm:gap-2">
              {m.calendarWeeks.flat().map((cell) => {
                if (!cell) {
                  return <div class="min-h-17.5 sm:min-h-21.25 rounded-xl border border-transparent bg-slate-50/30 dark:bg-slate-900/30 opacity-25"></div>;
                }

                let cellClasses = 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/80 text-slate-800 dark:text-slate-200';
                if (cell.isWeekend) {
                  cellClasses = 'border-rose-200/80 dark:border-rose-900/40 bg-rose-50/40 dark:bg-rose-950/20 text-rose-900 dark:text-rose-200';
                }

                return (
                  <div class={`min-h-17.5 sm:min-h-21.25 p-1.5 sm:p-2 rounded-xl border ${cellClasses} transition hover:shadow-xs flex flex-col justify-between`}>
                    <div class="flex items-center justify-between">
                      <span class="text-xs sm:text-sm font-bold">{cell.dayOfMonth}</span>
                      {cell.isWeekend && <span class="inline-block text-[9px] font-bold text-rose-600 dark:text-rose-400">W/E</span>}
                    </div>
                    <div class="text-[10px] text-slate-400 dark:text-slate-500 truncate print:hidden">
                      {cell.shortDayName}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      ))}
