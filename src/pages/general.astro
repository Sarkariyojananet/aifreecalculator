---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import AdSlotTop from '../components/ads/AdSlotTop.astro';
import AdSlotInline from '../components/ads/AdSlotInline.astro';
import AdSlotFooter from '../components/ads/AdSlotFooter.astro';
import { getCalculatorsByCategory } from '../data/calculators';
import { getCalculatorOverrides } from '../lib/admin/content-store';
import { getLivePageMeta } from '../lib/seo/page-metadata';

const generalCalculators = getCalculatorsByCategory('General');
const overrides = await getCalculatorOverrides(Astro.locals);
const override = overrides['category:general'] || {};
const liveMeta = getLivePageMeta('category:general');

const effectiveTitle = override.metaTitle || liveMeta.title;
const effectiveDescription = override.metaDescription || liveMeta.description;
const effectiveCanonical = override.canonicalUrl;
const effectiveRobots = override.robots;
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
  noindex={effectiveRobots?.includes('noindex')}
  ogImage="/og/general.png"
>
  <section class="border-b border-slate-200 bg-white px-4 py-12 dark:border-slate-800 dark:bg-slate-900/60 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <div class="flex items-center gap-2 text-xs text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider mb-2">
        <span>⚙️</span> CATEGORY SUITE
      </div>
      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        General & Everyday Calculators
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        Accurate utility calculators for day-to-day math, age chronology, unit conversions, working days date math, and percentage calculations.
      </p>
    </div>
  </section>

  <!-- Top Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotTop />
  </div>

  <section class="px-4 py-10">
    <div class="mx-auto max-w-7xl space-y-6">
      <CategoryTabs activeCategory="general" />

      <!-- First 6 Calculators -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {generalCalculators.slice(0, 6).map((calc) => (
          <CalculatorCard calculator={calc} />
        ))}
      </div>

      <!-- Middle Ad Slot -->
      <div class="py-2">
        <AdSlotInline />
      </div>

      <!-- Remaining Calculators (if any) -->
      {generalCalculators.length > 6 && (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {generalCalculators.slice(6).map((calc) => (
            <CalculatorCard calculator={calc} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Daily Calculation & Measurement Standards Educational Section -->
  <section class="border-t border-slate-200 bg-white px-4 py-12 dark:border-slate-800 dark:bg-slate-900/60 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-10">
      <div class="max-w-3xl space-y-3">
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">
          Practical Everyday Calculations & Conversion Standards
        </h2>
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          From precise chronological age calculation and date spans to SI metric conversions and travel fuel estimates, everyday calculations require standardized reference benchmarks. Below is an overview of the formulas powering our daily utility tools.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">📅</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Chronological Date Arithmetic</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Calendar computations accurately adjust for variable month lengths (28 to 31 days) and Gregorian leap years (years divisible by 4, excluding century years unless divisible by 400). Age calculations compute precise elapsed years, months, days, and weekday intervals without Gregorian drift.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">⚖️</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Metric & Imperial Unit Conversion</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Conversions adhere strictly to International System of Units (SI) standards and exact statutory conversion constants (e.g. 1 inch = exactly 25.4 mm; 1 pound = 0.45359237 kg; 1 gallon (US) = 3.785411784 liters). This ensures full reproducibility across scientific, culinary, and freight contexts.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">⚡</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Pure In-Browser Evaluation</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            All general utility calculations execute locally on your device within sub-millisecond response windows. Input parameters are processed synchronously in your browser without transmitting personal timestamps, birthday data, or locations across remote networks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotFooter />
  </div>
</BaseLayout>
