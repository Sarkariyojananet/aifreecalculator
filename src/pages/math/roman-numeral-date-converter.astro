  <!-- CLIENT-SIDE SCRIPT -->
  <script>
    const ROMAN_MAP: [number, string][] = [
      [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
      [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
      [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"]
    ];

    const CHAR_MAP: Record<string, number> = {
      I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000
    };

    const MONTH_NAMES = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];

    function toRoman(num: number): string {
      if (num <= 0 || num > 3999) return num.toString();
      let n = num;
      let res = '';
      for (const [val, sym] of ROMAN_MAP) {
        while (n >= val) {
          res += sym;
          n -= val;
        }
      }
      return res;
    }

    function romanToArabic(roman: string): number | null {
      const clean = roman.toUpperCase().trim();
      if (!clean || !/^[IVXLCDM]+$/.test(clean)) return null;
      let total = 0;
      let prev = 0;
      for (let i = clean.length - 1; i >= 0; i--) {
        const val = CHAR_MAP[clean[i]];
        if (!val) return null;
        if (val < prev) {
          total -= val;
        } else {
          total += val;
          prev = val;
        }
      }
      return total;
    }

    function init() {
      const tabDate = document.getElementById('tab-mode-date');
      const tabText = document.getElementById('tab-mode-text');
      const panelDate = document.getElementById('panel-calendar-mode');
      const panelText = document.getElementById('panel-text-mode');
      const selMonth = document.getElementById('date-month') as HTMLSelectElement | null;
      const inpDay = document.getElementById('date-day') as HTMLInputElement | null;
      const inpYear = document.getElementById('date-year') as HTMLInputElement | null;
      const selOrder = document.getElementById('date-order') as HTMLSelectElement | null;
      const selSep = document.getElementById('date-separator') as HTMLSelectElement | null;
      const inpRomanStr = document.getElementById('inp-roman-date-str') as HTMLInputElement | null;
      const btnCalc = document.getElementById('btn-calc-date');
      const btnClear = document.getElementById('btn-clear-date');
      const errBox = document.getElementById('date-error-box');
      const resSection = document.getElementById('date-result-section');

      let currentMode: 'calendar' | 'reverse' = 'calendar';

      function setMode(mode: 'calendar' | 'reverse') {
        currentMode = mode;
        if (mode === 'calendar') {
          tabDate?.classList.add('active', 'bg-white', 'text-amber-800', 'dark:bg-slate-800', 'dark:text-amber-300');
          tabDate?.classList.remove('text-slate-600', 'dark:text-slate-400');
          tabText?.classList.remove('active', 'bg-white', 'text-amber-800', 'dark:bg-slate-800', 'dark:text-amber-300');
          tabText?.classList.add('text-slate-600', 'dark:text-slate-400');
          panelDate?.classList.remove('hidden');
          panelText?.classList.add('hidden');
        } else {
          tabText?.classList.add('active', 'bg-white', 'text-amber-800', 'dark:bg-slate-800', 'dark:text-amber-300');
          tabText?.classList.remove('text-slate-600', 'dark:text-slate-400');
          tabDate?.classList.remove('active', 'bg-white', 'text-amber-800', 'dark:bg-slate-800', 'dark:text-amber-300');
          tabDate?.classList.add('text-slate-600', 'dark:text-slate-400');
          panelText?.classList.remove('hidden');
          panelDate?.classList.add('hidden');
        }
      }

      tabDate?.addEventListener('click', () => setMode('calendar'));
      tabText?.addEventListener('click', () => setMode('reverse'));

      // Presets
      document.querySelectorAll('.btn-preset-date').forEach((b) => {
        b.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLElement;
          const y = btn.getAttribute('data-y');
          const m = btn.getAttribute('data-m');
          const d = btn.getAttribute('data-d');
          if (selMonth && m) selMonth.value = m;
          if (inpDay && d) inpDay.value = d;
          if (inpYear && y) inpYear.value = y;
          setMode('calendar');
          calculateDate();
        });
      });

      function calculateDate() {
        if (!resSection || !errBox) return;

        let month = 10;
        let day = 18;
        let year = 2026;

        if (currentMode === 'calendar') {
          if (!selMonth || !inpDay || !inpYear) return;
          month = parseInt(selMonth.value, 10);
          day = parseInt(inpDay.value, 10);
          year = parseInt(inpYear.value, 10);

          if (isNaN(day) || day < 1 || day > 31) {
            errBox.textContent = "Please enter a valid day of the month (1–31).";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }
          if (isNaN(year) || year < 1 || year > 3999) {
            errBox.textContent = "Please enter a valid year between 1 and 3,999.";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }
        } else {
          // Reverse mode: parse roman date string
          if (!inpRomanStr) return;
          const raw = inpRomanStr.value.trim().toUpperCase();
          if (!raw) {
            errBox.textContent = "Please enter a Roman numeral date to decode.";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }
          const tokens = raw.split(/[\s·•\/\-\.\,]+/).filter(Boolean);
          if (tokens.length !== 3) {
            errBox.textContent = "Could not parse 3 date components (Month, Day, Year). Please separate them with dots, slashes, or dashes.";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }
          const p1 = romanToArabic(tokens[0]);
          const p2 = romanToArabic(tokens[1]);
          const p3 = romanToArabic(tokens[2]);

          if (p1 === null || p2 === null || p3 === null) {
            errBox.textContent = "One or more date tokens contain invalid Roman numeral characters.";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }

          // Heuristic: determine which is year
          if (p3 > 31) {
            year = p3;
            if (p1 <= 12 && p2 <= 31) {
              month = p1;
              day = p2;
            } else {
              day = p1;
              month = p2;
            }
          } else if (p1 > 31) {
            year = p1;
            month = p2;
            day = p3;
          } else {
            month = p1;
            day = p2;
            year = p3;
          }
        }

        errBox.classList.add('hidden');

        const romanM = toRoman(month);
        const romanD = toRoman(day);
        const romanY = toRoman(year);
        const sep = selSep ? selSep.value : ' · ';
        const order = selOrder ? selOrder.value : 'MDY';

        let primaryTattoo = '';
        if (order === 'DMY') {
          primaryTattoo = `${romanD} ${sep} ${romanM} ${sep} ${romanY}`;
        } else if (order === 'YMD') {
          primaryTattoo = `${romanY} ${sep} ${romanM} ${sep} ${romanD}`;
        } else {
          primaryTattoo = `${romanM} ${sep} ${romanD} ${sep} ${romanY}`;
        }

        const usFmt = `${romanM} · ${romanD} · ${romanY}`;
        const euFmt = `${romanD} · ${romanM} · ${romanY}`;
        const isoFmt = `${romanY} · ${romanM} · ${romanD}`;
        const slashFmt = `${romanM} / ${romanD} / ${romanY}`;
        const monthName = MONTH_NAMES[month - 1] || 'Month';
        const writtenFmt = `${monthName} ${romanD}, ${romanY}`;

        // Update UI
        const resRead = document.getElementById('res-date-readable');
        if (resRead) resRead.textContent = `${monthName} ${day}, ${year}`;

        const elPrimary = document.getElementById('res-primary-tattoo');
        if (elPrimary) elPrimary.textContent = primaryTattoo;

        const elUs = document.getElementById('fmt-us');
        if (elUs) elUs.textContent = usFmt;
        const tblUs = document.getElementById('tbl-fmt-us');
        if (tblUs) tblUs.textContent = usFmt;

        const elEu = document.getElementById('fmt-eu');
        if (elEu) elEu.textContent = euFmt;
        const tblEu = document.getElementById('tbl-fmt-eu');
        if (tblEu) tblEu.textContent = euFmt;

        const elIso = document.getElementById('fmt-iso');
        if (elIso) elIso.textContent = isoFmt;
        const tblIso = document.getElementById('tbl-fmt-iso');
        if (tblIso) tblIso.textContent = isoFmt;

        const elSlash = document.getElementById('fmt-slash');
        if (elSlash) elSlash.textContent = slashFmt;
        const tblSlash = document.getElementById('tbl-fmt-slash');
        if (tblSlash) tblSlash.textContent = slashFmt;

        const elWritten = document.getElementById('fmt-written');
        if (elWritten) elWritten.textContent = writtenFmt;
        const tblWritten = document.getElementById('tbl-fmt-written');
        if (tblWritten) tblWritten.textContent = writtenFmt;

        const elBm = document.getElementById('break-month');
        if (elBm) elBm.textContent = `${romanM} (${monthName} - ${month})`;
        const tblBm = document.getElementById('tbl-break-month');
        if (tblBm) tblBm.textContent = `${romanM} (${monthName} - ${month})`;

        const elBd = document.getElementById('break-day');
        if (elBd) elBd.textContent = `${romanD} (Day ${day})`;
        const tblBd = document.getElementById('tbl-break-day');
        if (tblBd) tblBd.textContent = `${romanD} (Day ${day})`;

        const elBy = document.getElementById('break-year');
        if (elBy) elBy.textContent = `${romanY} (Year ${year})`;
        const tblBy = document.getElementById('tbl-break-year');
        if (tblBy) tblBy.textContent = `${romanY} (Year ${year})`;

        resSection.classList.remove('hidden');
        resSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      btnCalc?.addEventListener('click', calculateDate);

      btnClear?.addEventListener('click', () => {
        if (inpDay) inpDay.value = '';
        if (inpYear) inpYear.value = '';
        if (inpRomanStr) inpRomanStr.value = '';
        if (errBox) errBox.classList.add('hidden');
        if (resSection) resSection.classList.add('hidden');
      });

      // Individual copy buttons
      document.querySelectorAll('.btn-copy-val').forEach((b) => {
        b.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLElement;
          const targetId = btn.getAttribute('data-target');
          if (targetId) {
            const el = document.getElementById(targetId);
            const text = el?.textContent || '';
            navigator.clipboard.writeText(text).then(() => {
              const orig = btn.textContent;
              btn.textContent = 'Copied!';
              setTimeout(() => { btn.textContent = orig; }, 1800);
            });
          }
        });
      });

      // Print
      document.getElementById('btn-print-date')?.addEventListener('click', () => {
        const detailsEl = document.getElementById('details-all-formats') as HTMLDetailsElement | null;
        if (detailsEl) detailsEl.open = true;
        window.print();
      });

      window.addEventListener('beforeprint', () => {
        const detailsEl = document.getElementById('details-all-formats') as HTMLDetailsElement | null;
        if (detailsEl) detailsEl.open = true;
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</CalculatorLayout>
