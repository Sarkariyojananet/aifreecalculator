---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const popularTattooSeparators = [
  { name: "Middle Dot (Classical Roman)", symbol: "·", example: "VI · XX · MMXXIV" },
  { name: "Bullet Point", symbol: "•", example: "VI • XX • MMXXIV" },
  { name: "Slash", symbol: "/", example: "VI / XX / MMXXIV" },
  { name: "Hyphen / Dash", symbol: "-", example: "VI - XX - MMXXIV" },
  { name: "Space", symbol: " ", example: "VI XX MMXXIV" }
];

const sevenSymbols = [
  { symbol: "I", value: "1" },
  { symbol: "V", value: "5" },
  { symbol: "X", value: "10" },
  { symbol: "L", value: "50" },
  { symbol: "C", value: "100" },
  { symbol: "D", value: "500" },
  { symbol: "M", value: "1,000" }
];

const daysOfWeek = [
  { day: "Monday", num: "1st", roman: "I" },
  { day: "Tuesday", num: "2nd", roman: "II" },
  { day: "Wednesday", num: "3rd", roman: "III" },
  { day: "Thursday", num: "4th", roman: "IV" },
  { day: "Friday", num: "5th", roman: "V" },
  { day: "Saturday", num: "6th", roman: "VI" },
  { day: "Sunday", num: "7th", roman: "VII" }
];
---

<CalculatorLayout
  title="Roman Numeral Date Converter – Convert Dates to Roman Numerals (Tattoos & Rings)"
  description="Free Roman Numeral Date Converter: convert birthdays, wedding anniversaries, and calendar dates into Roman numerals in tattoo, jewelry, US, and EU formats."
  category="Math"
  calculatorName="Roman Numeral Date Converter"
  slug="roman-numeral-date-converter"
  keywords={[
    "roman numeral date converter",
    "date to roman numerals",
    "roman numeral birthday",
    "roman numeral tattoo date",
    "wedding anniversary in roman numerals",
    "roman date generator",
    "convert date to roman numerals"
  ]}
>
  <div class="space-y-6">

    <!-- COMPACT HERO HEADER -->
    <div class="rounded-2xl border border-amber-200/80 bg-linear-to-r from-amber-500/10 via-orange-500/5 to-amber-500/10 p-3 sm:p-3.5 dark:border-amber-900/40 dark:from-amber-950/20">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h1 class="text-base sm:text-lg font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-1.5">
            <span>📅</span> Roman Numeral Date Converter
          </h1>
          <p class="text-xs text-slate-600 dark:text-slate-400">
            Convert birthdays, anniversaries, and memorial dates into classical Roman numeral tattoo and jewelry formats.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-1 text-[11px] shrink-0">
          <span class="font-bold text-slate-500 dark:text-slate-400">Presets:</span>
          <button type="button" class="btn-preset-date rounded-md border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-amber-500 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-y="2026" data-m="10" data-d="18">Today</button>
          <button type="button" class="btn-preset-date rounded-md border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-amber-500 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-y="2000" data-m="1" data-d="1">2000</button>
          <button type="button" class="btn-preset-date rounded-md border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-amber-500 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-y="1776" data-m="7" data-d="4">1776</button>
        </div>
      </div>
    </div>

    <!-- MAIN COMPACT CONVERTER WIDGET -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 sm:p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-3">

      <!-- MODE TOGGLE & FORMAT CONTROLS ROW -->
      <div class="flex flex-wrap items-center justify-between gap-2 pb-1 border-b border-slate-100 dark:border-slate-800 text-xs">
        <div class="inline-flex rounded-xl border border-slate-200 bg-slate-100 p-0.5 dark:border-slate-800 dark:bg-slate-950">
          <button
            type="button"
            id="tab-mode-date"
            class="date-mode-btn active rounded-lg bg-white px-3 py-1 font-bold text-amber-800 shadow-xs dark:bg-slate-800 dark:text-amber-300 cursor-pointer transition text-xs"
          >
            Calendar &rarr; Roman
          </button>
          <button
            type="button"
            id="tab-mode-text"
            class="date-mode-btn rounded-lg px-3 py-1 font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer transition text-xs"
          >
            Roman &rarr; Calendar
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-[11px]">
          <div class="flex items-center gap-1">
            <span class="text-slate-500">Order:</span>
            <select id="date-order" class="rounded-md border border-slate-300 bg-white px-1.5 py-0.5 font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:scheme-dark cursor-pointer">
              <option value="MDY" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100" selected>MM·DD·YYYY (US)</option>
              <option value="DMY" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">DD·MM·YYYY (UK/World)</option>
              <option value="YMD" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">YYYY·MM·DD (ISO)</option>
            </select>
          </div>
          <div class="flex items-center gap-1">
            <span class="text-slate-500">Separator:</span>
            <select id="date-separator" class="rounded-md border border-slate-300 bg-white px-1.5 py-0.5 font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:scheme-dark cursor-pointer">
              <option value="·" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100" selected>Dot ( · ) Tattoos</option>
              <option value="•" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">Bullet ( • )</option>
              <option value="/" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">Slash ( / )</option>
              <option value="-" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">Hyphen ( - )</option>
              <option value="." class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">Period ( . )</option>
              <option value=" " class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">Space ( &nbsp; )</option>
            </select>
          </div>
        </div>
      </div>

      <!-- PANEL 1: CALENDAR DATE PICKER (Compact Grid) -->
      <div id="panel-calendar-mode" class="space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-end">
          <!-- Month -->
          <div class="sm:col-span-5 space-y-1">
            <label for="date-month" class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Month</label>
            <select
              id="date-month"
              class="w-full rounded-xl border border-slate-300 bg-white px-2.5 py-2 text-xs font-semibold text-slate-800 shadow-2xs focus:border-amber-500 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:scheme-dark cursor-pointer"
            >
              <option value="1" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">1 - January (I)</option>
              <option value="2" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">2 - February (II)</option>
              <option value="3" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">3 - March (III)</option>
              <option value="4" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">4 - April (IV)</option>
              <option value="5" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">5 - May (V)</option>
              <option value="6" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">6 - June (VI)</option>
              <option value="7" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">7 - July (VII)</option>
              <option value="8" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">8 - August (VIII)</option>
              <option value="9" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">9 - September (IX)</option>
              <option value="10" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100" selected>10 - October (X)</option>
              <option value="11" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">11 - November (XI)</option>
              <option value="12" class="bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">12 - December (XII)</option>
            </select>
          </div>

          <!-- Day -->
          <div class="sm:col-span-3 space-y-1">
            <label for="date-day" class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Day (1–31)</label>
            <input
              type="number"
              id="date-day"
              value="18"
              min="1"
              max="31"
              class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-2.5 py-2 text-center text-sm font-bold text-slate-900 shadow-2xs focus:border-amber-500 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            />
          </div>

          <!-- Year -->
          <div class="sm:col-span-4 space-y-1">
            <label for="date-year" class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Year (1–3999)</label>
            <input
              type="number"
              id="date-year"
              value="2026"
              min="1"
              max="3999"
              class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-2.5 py-2 text-center text-sm font-bold text-slate-900 shadow-2xs focus:border-amber-500 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            />
          </div>
        </div>
      </div>

      <!-- PANEL 2: REVERSE ROMAN TEXT INPUT (Hidden by default) -->
      <div id="panel-text-mode" class="hidden space-y-1.5">
        <label for="inp-roman-date-str" class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
          Enter Roman Date String (e.g. X · XVIII · MMXXVI or 18/10/2026):
        </label>
        <input
          type="text"
          id="inp-roman-date-str"
          placeholder="e.g. X · XVIII · MMXXVI"
          class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-3 py-2 text-center text-base font-mono font-black uppercase text-slate-900 shadow-2xs focus:border-amber-500 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
      </div>

      <!-- Action Buttons Row -->
      <div class="flex items-center justify-center gap-2 pt-1">
        <button
          type="button"
          id="btn-calc-date"
          class="flex items-center gap-1.5 rounded-xl bg-amber-600 px-6 py-2.5 text-xs sm:text-sm font-black text-white shadow-sm hover:bg-amber-700 active:scale-98 transition cursor-pointer"
        >
          <span>Convert Date</span> <span>▶</span>
        </button>
        <button
          type="button"
          id="btn-clear-date"
          class="rounded-xl border border-slate-300 bg-slate-100 px-4 py-2.5 text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition cursor-pointer"
        >
          Clear
        </button>
      </div>

      <!-- Inline Error -->
      <div id="date-error-box" class="hidden rounded-xl border border-rose-300 bg-rose-50 p-2.5 text-xs font-medium text-rose-800 dark:border-rose-900/50 dark:bg-rose-950/40 dark:text-rose-300 text-center">
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- MASTER COMPACT RESULT BANNER (REVEALED ON "CONVERT DATE ▶" CLICK ONLY) -->
    <!-- ========================================================================= -->
    <div id="date-result-section" class="hidden rounded-2xl border border-amber-300/80 bg-linear-to-br from-amber-50/60 via-white to-orange-50/40 p-3.5 sm:p-4 shadow-sm dark:border-amber-900/50 dark:from-slate-950 dark:via-slate-900 dark:to-amber-950/20 space-y-3">

      <!-- Compact Primary Result Banner -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 bg-white dark:bg-slate-900 rounded-xl p-3 border-2 border-amber-400 dark:border-amber-600">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-black uppercase tracking-wider text-amber-700 dark:text-amber-400">★ Tattoo &amp; Ring Format:</span>
            <span class="text-[11px] text-slate-500" id="res-date-readable">October 18, 2026</span>
          </div>
          <div class="text-xl sm:text-2xl font-mono font-black text-slate-900 dark:text-white tracking-widest select-all" id="res-primary-tattoo">
            X · XVIII · MMXXVI
          </div>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button type="button" class="btn-copy-val text-xs font-bold text-amber-700 bg-amber-50 dark:bg-amber-950/60 dark:text-amber-300 px-3 py-1.5 rounded-lg border border-amber-200 dark:border-amber-800 hover:bg-amber-100 cursor-pointer" data-target="res-primary-tattoo">
            Copy Primary
          </button>
          <button type="button" id="btn-print-date" class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
            <span>🖨️</span> PDF
          </button>
        </div>
      </div>

      <!-- Collapsible Additional Formats & Breakdown -->
      <details id="details-all-formats" class="group rounded-xl border border-slate-200 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-950/40 text-xs">
        <summary class="cursor-pointer font-bold text-slate-700 hover:text-amber-600 dark:text-slate-300 flex items-center justify-between select-none">
          <span class="flex items-center gap-1.5">
            <span>📋</span> View All Formats (US, EU, ISO, Written) &amp; Element Breakdown
          </span>
          <span class="text-[11px] text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>

        <div class="mt-3 pt-2 border-t border-slate-200/80 dark:border-slate-800 space-y-3">
          <!-- Formats Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div class="unit-result-card flex items-center justify-between gap-1 p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <div class="min-w-0">
                <span class="text-[10px] text-slate-500 block">US (MM · DD · YYYY)</span>
                <span class="font-mono font-bold text-amber-700 dark:text-amber-400 text-xs truncate block" id="fmt-us">X · XVIII · MMXXVI</span>
              </div>
              <button type="button" class="btn-copy-val shrink-0 rounded border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-bold text-slate-600 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-target="fmt-us">Copy</button>
            </div>

            <div class="unit-result-card flex items-center justify-between gap-1 p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <div class="min-w-0">
                <span class="text-[10px] text-slate-500 block">European (DD · MM · YYYY)</span>
                <span class="font-mono font-bold text-amber-700 dark:text-amber-400 text-xs truncate block" id="fmt-eu">XVIII · X · MMXXVI</span>
              </div>
              <button type="button" class="btn-copy-val shrink-0 rounded border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-bold text-slate-600 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-target="fmt-eu">Copy</button>
            </div>

            <div class="unit-result-card flex items-center justify-between gap-1 p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <div class="min-w-0">
                <span class="text-[10px] text-slate-500 block">ISO (YYYY · MM · DD)</span>
                <span class="font-mono font-bold text-amber-700 dark:text-amber-400 text-xs truncate block" id="fmt-iso">MMXXVI · X · XVIII</span>
              </div>
              <button type="button" class="btn-copy-val shrink-0 rounded border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-bold text-slate-600 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-target="fmt-iso">Copy</button>
            </div>

            <div class="unit-result-card flex items-center justify-between gap-1 p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <div class="min-w-0">
                <span class="text-[10px] text-slate-500 block">Slash Separator ( / )</span>
                <span class="font-mono font-bold text-slate-800 dark:text-slate-200 text-xs truncate block" id="fmt-slash">X / XVIII / MMXXVI</span>
              </div>
              <button type="button" class="btn-copy-val shrink-0 rounded border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-bold text-slate-600 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-target="fmt-slash">Copy</button>
            </div>
          </div>

          <!-- Written Form -->
          <div class="unit-result-card flex items-center justify-between gap-2 p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <div>
              <span class="text-[10px] text-slate-500 block">Written Month with Roman Day &amp; Year</span>
              <span class="font-semibold text-slate-900 dark:text-white text-xs" id="fmt-written">October XVIII, MMXXVI</span>
            </div>
            <button type="button" class="btn-copy-val shrink-0 rounded border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-bold text-slate-600 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-target="fmt-written">Copy</button>
          </div>

          <!-- Component Breakdown -->
          <div class="grid grid-cols-3 gap-2 text-center text-xs pt-1 font-mono">
            <div class="unit-result-card p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <span class="text-[10px] text-slate-500 block">Month</span>
              <strong class="text-amber-700 dark:text-amber-400 text-xs block" id="break-month">X (10)</strong>
            </div>
            <div class="unit-result-card p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <span class="text-[10px] text-slate-500 block">Day</span>
              <strong class="text-amber-700 dark:text-amber-400 text-xs block" id="break-day">XVIII (18)</strong>
            </div>
            <div class="unit-result-card p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <span class="text-[10px] text-slate-500 block">Year</span>
              <strong class="text-amber-700 dark:text-amber-400 text-xs block" id="break-year">MMXXVI (2026)</strong>
            </div>
          </div>

          <!-- Formats & Element Breakdown Table (For Print/Preview & Clear Structured Breakdown) -->
          <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 mt-2">
            <table id="table-formats-breakdown" class="w-full border-collapse text-left text-xs">
              <thead>
                <tr class="bg-slate-100 dark:bg-slate-800/80 text-[10.5px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 border-b border-slate-200 dark:border-slate-800">
                  <th class="p-2">Format / Component</th>
                  <th class="p-2">Pattern</th>
                  <th class="p-2 text-right">Roman Numeral Output</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono text-xs">
                <tr class="bg-white dark:bg-slate-900">
                  <td class="p-2 font-sans font-semibold text-slate-700 dark:text-slate-200">US Date Format</td>
                  <td class="p-2 text-slate-500 text-[11px]">MM · DD · YYYY</td>
                  <td class="p-2 text-right font-bold text-amber-700 dark:text-amber-400" id="tbl-fmt-us">X · XVIII · MMXXVI</td>
                </tr>
                <tr class="bg-slate-50/50 dark:bg-slate-950/40">
                  <td class="p-2 font-sans font-semibold text-slate-700 dark:text-slate-200">European Date Format</td>
                  <td class="p-2 text-slate-500 text-[11px]">DD · MM · YYYY</td>
                  <td class="p-2 text-right font-bold text-amber-700 dark:text-amber-400" id="tbl-fmt-eu">XVIII · X · MMXXVI</td>
                </tr>
                <tr class="bg-white dark:bg-slate-900">
                  <td class="p-2 font-sans font-semibold text-slate-700 dark:text-slate-200">ISO 8601 Date Format</td>
                  <td class="p-2 text-slate-500 text-[11px]">YYYY · MM · DD</td>
                  <td class="p-2 text-right font-bold text-amber-700 dark:text-amber-400" id="tbl-fmt-iso">MMXXVI · X · XVIII</td>
                </tr>
                <tr class="bg-slate-50/50 dark:bg-slate-950/40">
                  <td class="p-2 font-sans font-semibold text-slate-700 dark:text-slate-200">Slash Separator Format</td>
                  <td class="p-2 text-slate-500 text-[11px]">MM / DD / YYYY</td>
                  <td class="p-2 text-right font-bold text-slate-800 dark:text-slate-200" id="tbl-fmt-slash">X / XVIII / MMXXVI</td>
                </tr>
                <tr class="bg-white dark:bg-slate-900">
                  <td class="p-2 font-sans font-semibold text-slate-700 dark:text-slate-200">Written Month &amp; Roman Day/Year</td>
                  <td class="p-2 font-sans text-slate-500 text-[11px]">Month Day, Year</td>
                  <td class="p-2 text-right font-sans font-semibold text-slate-900 dark:text-white" id="tbl-fmt-written">October XVIII, MMXXVI</td>
                </tr>
                <tr class="bg-slate-50/50 dark:bg-slate-950/40">
                  <td class="p-2 font-sans font-semibold text-slate-700 dark:text-slate-200">Month Component</td>
                  <td class="p-2 font-sans text-slate-500 text-[11px]">Month Number</td>
                  <td class="p-2 text-right font-bold text-amber-700 dark:text-amber-400" id="tbl-break-month">X (October - 10)</td>
                </tr>
