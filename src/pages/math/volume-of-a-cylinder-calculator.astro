---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Volume of a Cylinder Calculator – Calculate Cylinder Volume"
  description="Calculate cylinder volume using radius, diameter, height, reverse dimensions, hollow shell pipes, or oblique cylinders with step-by-step formulas."
  category="Math"
  calculatorName="Volume of a Cylinder Calculator"
  slug="volume-of-a-cylinder-calculator"
  keywords={[
    'volume of a cylinder calculator',
    'cylinder volume calculator',
    'volume calculator cylinder',
    'calculate cylinder volume',
    'volume of cylinder',
    'cylinder volume formula',
    'volume of a hollow cylinder',
    'hollow cylinder volume calculator',
    'cylindrical shell volume',
    'oblique cylinder volume',
    'cylinder volume from diameter',
    'cylinder volume from radius and height',
    'find cylinder height from volume',
    'find cylinder radius from volume',
    'pipe volume calculator'
  ]}
>
  <div class="space-y-6">

    <!-- Shape switcher / parent suite banner -->
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 rounded-2xl border border-slate-200/90 bg-white px-4 py-3 shadow-2xs dark:border-slate-800 dark:bg-slate-900 text-xs"
    >
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-700 dark:text-slate-200">Volume Suite:</span>
        <span class="rounded-md bg-blue-100 px-2 py-0.5 font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
          Cylinder (7 Specialized Modes)
        </span>
      </div>
      <a
        href="/math/volume-calculator/"
        class="inline-flex items-center gap-1 font-bold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition"
      >
        <span>Looking for other 3D shapes (Tanks, Pipes, Pools, Cones)?</span>
        <span>→</span>
      </a>
    </div>

    <!-- Calculator Card Container -->
    <div
      class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/50 p-1.5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20"
    >
      <!-- Top Mode Selector Tabs -->
      <div
        class="flex items-center gap-1 border-b border-slate-300/80 px-2 pt-1 pb-0 dark:border-slate-800 overflow-x-auto scrollbar-thin"
        role="tablist"
        aria-label="Cylinder Calculation Modes"
      >
        <button
          type="button"
          id="tab-radius-height"
          data-mode="radius_height"
          role="tab"
          aria-selected="true"
          class="mode-tab active rounded-t-xl border-t border-x border-slate-300/90 bg-white px-3.5 py-2.5 text-xs sm:text-sm font-bold text-slate-900 shadow-2xs -mb-px dark:border-slate-700 dark:bg-slate-900 dark:text-white transition cursor-pointer shrink-0"
        >
          Radius &amp; Height
        </button>
        <button
          type="button"
          id="tab-diameter-height"
          data-mode="diameter_height"
          role="tab"
          aria-selected="false"
          class="mode-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0"
        >
          Diameter &amp; Height
        </button>
        <button
          type="button"
          id="tab-find-height"
          data-mode="find_height"
          role="tab"
          aria-selected="false"
          class="mode-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0"
        >
          Find Height (h)
        </button>
        <button
          type="button"
          id="tab-find-radius"
          data-mode="find_radius"
          role="tab"
          aria-selected="false"
          class="mode-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0"
        >
          Find Radius (r)
        </button>
        <button
          type="button"
          id="tab-hollow-radius"
          data-mode="hollow_radius"
          role="tab"
          aria-selected="false"
          class="mode-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0"
        >
          Hollow (Radii)
        </button>
        <button
          type="button"
          id="tab-hollow-diameter"
          data-mode="hollow_diameter"
          role="tab"
          aria-selected="false"
          class="mode-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0"
        >
          Hollow (Diameters)
        </button>
        <button
          type="button"
          id="tab-oblique"
          data-mode="oblique"
          role="tab"
          aria-selected="false"
          class="mode-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0"
        >
          Oblique Cylinder
        </button>
      </div>

      <!-- Main Form Container -->
      <form
        id="cylinder-form"
        class="space-y-4 bg-white/50 p-4 sm:p-6 dark:bg-slate-950/40"
        novalidate
        onsubmit="return false;"
      >
        <!-- Mode Subtitle & Unit Selectors Bar -->
        <div
          class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200/80 pb-3 dark:border-slate-800/80 text-xs"
        >
          <span id="mode-subtitle" class="font-bold text-slate-700 dark:text-slate-300">
            Known: Base Radius r and Perpendicular Height h
          </span>

          <div class="flex flex-wrap items-center gap-3">
            <!-- Length Unit Selector -->
            <div class="flex items-center gap-1.5">
              <label for="select-length-unit" class="font-semibold text-slate-600 dark:text-slate-400">Length Unit:</label>
              <select
                id="select-length-unit"
                class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-800 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 cursor-pointer"
              >
                <option value="mm">Millimeters (mm)</option>
                <option value="cm" selected>Centimeters (cm)</option>
                <option value="m">Meters (m)</option>
                <option value="in">Inches (in)</option>
                <option value="ft">Feet (ft)</option>
                <option value="yd">Yards (yd)</option>
              </select>
            </div>

            <!-- Volume Unit Display Selector -->
            <div class="flex items-center gap-1.5">
              <label for="select-volume-unit" class="font-semibold text-slate-600 dark:text-slate-400">Result Volume Unit:</label>
              <select
                id="select-volume-unit"
                class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-800 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 cursor-pointer"
              >
                <option value="cm3" selected>Cubic Centimeters (cm³)</option>
                <option value="m3">Cubic Meters (m³)</option>
                <option value="mm3">Cubic Millimeters (mm³)</option>
                <option value="L">Liters (L)</option>
                <option value="mL">Milliliters (mL)</option>
                <option value="in3">Cubic Inches (in³)</option>
                <option value="ft3">Cubic Feet (ft³)</option>
                <option value="yd3">Cubic Yards (yd³)</option>
                <option value="us_gal">US Gallons (gal)</option>
                <option value="imp_gal">Imperial Gallons (UK gal)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Dynamic Inputs Grid (EVERY INPUT STARTS EMPTY) -->

        <!-- Row: Radius r (Standard & Oblique modes) -->
        <div
          id="row-radius"
          class="grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-radius"
            id="label-radius"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Base Radius (r)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-radius"
                value=""
                step="any"
                min="0"
                placeholder="Enter radius"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
                autocomplete="off"
              />
              <span class="unit-badge pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-medium">cm</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">center to outer circle rim (r &gt; 0)</span>
          </div>
        </div>

        <!-- Row: Diameter d (Diameter mode) -->
        <div
          id="row-diameter"
          class="hidden grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-diameter"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Base Diameter (d)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-diameter"
                value=""
                step="any"
                min="0"
                placeholder="Enter diameter"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
                autocomplete="off"
              />
              <span class="unit-badge pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-medium">cm</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">across base through center (d = 2r)</span>
          </div>
        </div>

        <!-- Row: Height h (Perpendicular Height) -->
        <div
          id="row-height"
          class="grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-height"
            id="label-height"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Height (h)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-height"
                value=""
                step="any"
                min="0"
                placeholder="Enter height"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
                autocomplete="off"
              />
              <span class="unit-badge pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-medium">cm</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">perpendicular distance between bases</span>
          </div>
        </div>

        <!-- Row: Volume Input (Reverse Modes: Find Height / Find Radius) -->
        <div
          id="row-volume-input"
          class="hidden grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-volume"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Known Volume (V)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-volume"
                value=""
                step="any"
                min="0"
                placeholder="Enter volume"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                autocomplete="off"
              />
            </div>
            <select
              id="select-input-volume-unit"
              class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-800 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 cursor-pointer"
            >
              <option value="cm3" selected>cm³ (mL)</option>
              <option value="m3">m³</option>
              <option value="L">Liters (L)</option>
              <option value="mm3">mm³</option>
              <option value="in3">in³</option>
              <option value="ft3">ft³</option>
              <option value="us_gal">US Gallons</option>
            </select>
          </div>
        </div>

        <!-- Row: Hollow Outer Radius R -->
        <div
          id="row-outer-radius"
          class="hidden grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-outer-radius"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Outer Radius (R)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-outer-radius"
                value=""
                step="any"
                min="0"
                placeholder="Enter outer radius R"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
                autocomplete="off"
              />
              <span class="unit-badge pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-medium">cm</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">external shell radius (R &gt; r)</span>
          </div>
        </div>

        <!-- Row: Hollow Inner Radius r -->
        <div
          id="row-inner-radius"
          class="hidden grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-inner-radius"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Inner Radius (r)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-inner-radius"
                value=""
                step="any"
                min="0"
                placeholder="Enter inner radius r"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
                autocomplete="off"
              />
              <span class="unit-badge pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-medium">cm</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">internal hollow bore radius (r &lt; R)</span>
          </div>
        </div>

        <!-- Row: Hollow Outer Diameter D -->
        <div
          id="row-outer-diameter"
          class="hidden grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-outer-diameter"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Outer Diameter (D)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-outer-diameter"
                value=""
                step="any"
                min="0"
                placeholder="Enter outer diameter D"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
                autocomplete="off"
              />
              <span class="unit-badge pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-medium">cm</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">pipe outside diameter (OD)</span>
          </div>
        </div>

        <!-- Row: Hollow Inner Diameter d -->
        <div
          id="row-inner-diameter"
          class="hidden grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-inner-diameter"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Inner Diameter (d)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-inner-diameter"
                value=""
                step="any"
                min="0"
                placeholder="Enter inner diameter d"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
                autocomplete="off"
              />
              <span class="unit-badge pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-medium">cm</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">pipe inside diameter (ID, d &lt; D)</span>
          </div>
        </div>

        <!-- Oblique Subtype Radio (Perpendicular vs Slant Length) -->
        <div id="row-oblique-type" class="hidden">
          <div class="grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4">
            <span class="text-sm font-bold text-slate-900 dark:text-white">Height Input:</span>
            <div class="flex flex-wrap items-center gap-4 text-xs font-bold text-slate-800 dark:text-slate-200">
              <label class="flex items-center gap-1.5 cursor-pointer">
                <input type="radio" name="oblique-type" value="perpendicular_height" checked class="text-blue-600 focus:ring-blue-500 cursor-pointer" />
                <span>Known Perpendicular Height (h)</span>
              </label>
              <label class="flex items-center gap-1.5 cursor-pointer">
                <input type="radio" name="oblique-type" value="slant_angle" class="text-blue-600 focus:ring-blue-500 cursor-pointer" />
                <span>Known Slant Side Length (L) &amp; Angle (θ)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Row: Slant Side Length L (Oblique mode) -->
        <div
          id="row-slant-length"
          class="hidden grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-slant-length"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Slant Side Length (L)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-slant-length"
                value=""
                step="any"
                min="0"
                placeholder="Enter slant length L"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
                autocomplete="off"
              />
              <span class="unit-badge pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-medium">cm</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">length of slanted edge (L &gt; 0)</span>
          </div>
        </div>

        <!-- Row: Slant Angle θ (Oblique mode) -->
        <div
          id="row-slant-angle"
          class="hidden grid grid-cols-1 sm:grid-cols-[160px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-slant-angle"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Inclination Angle (θ)
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex items-center w-44 sm:w-56">
              <input
                type="number"
                id="input-slant-angle"
                value=""
                step="any"
                min="0.1"
                max="89.9"
                placeholder="e.g. 60"
                class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-8"
                autocomplete="off"
              />
              <span class="pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400 font-bold">°</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400">measured relative to base plane (0° &lt; θ &lt; 90°)</span>
          </div>
        </div>

        <!-- Action Buttons (Green Calculate & Gray Clear) -->
        <div class="flex flex-wrap items-center gap-3 pt-3">
          <button
            type="submit"
            id="btn-calculate"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-2.5 text-sm font-extrabold text-white shadow-lg shadow-emerald-600/20 transition hover:-translate-y-0.5 hover:bg-emerald-700 active:scale-[0.98] cursor-pointer"
          >
            <span>Calculate</span>
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-[10px]">
              ▶
            </span>
          </button>
          <button
            type="button"
            id="btn-clear"
            class="inline-flex items-center justify-center rounded-md bg-slate-400 hover:bg-slate-500 dark:bg-slate-600 dark:hover:bg-slate-500 px-5 py-2.5 text-sm font-bold text-white shadow-xs active:scale-[0.98] transition cursor-pointer"
          >
            Clear
          </button>
        </div>

        <!-- Validation / Error Banner -->
        <p
          id="cylinder-error"
          class="hidden rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300"
          role="alert"
          aria-live="polite"
        >
        </p>
      </form>
    </div>

    <!-- Initial Prompt Placeholder (Shown before Calculate is clicked) -->
    <div
      id="results-placeholder"
      class="rounded-2xl border border-dashed border-slate-300 bg-slate-50/60 p-8 text-center dark:border-slate-800 dark:bg-slate-950/40"
    >
      <div
        class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-xl text-blue-700 dark:bg-blue-950 dark:text-blue-300"
      >
        🛢️
      </div>
      <h3 class="mt-3 text-sm font-bold text-slate-900 dark:text-white">
        Ready to Calculate Cylinder Volume
      </h3>
