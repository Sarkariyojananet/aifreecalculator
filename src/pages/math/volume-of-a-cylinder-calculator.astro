  // Inputs
  const inputRadius = document.getElementById('input-radius') as HTMLInputElement;
  const inputDiameter = document.getElementById('input-diameter') as HTMLInputElement;
  const inputHeight = document.getElementById('input-height') as HTMLInputElement;
  const inputVolume = document.getElementById('input-volume') as HTMLInputElement;
  const inputOuterRadius = document.getElementById('input-outer-radius') as HTMLInputElement;
  const inputInnerRadius = document.getElementById('input-inner-radius') as HTMLInputElement;
  const inputOuterDiameter = document.getElementById('input-outer-diameter') as HTMLInputElement;
  const inputInnerDiameter = document.getElementById('input-inner-diameter') as HTMLInputElement;
  const inputSlantLength = document.getElementById('input-slant-length') as HTMLInputElement;
  const inputSlantAngle = document.getElementById('input-slant-angle') as HTMLInputElement;

  // Labels
  const labelRadius = document.getElementById('label-radius')!;
  const labelHeight = document.getElementById('label-height')!;

  // Buttons & Error
  const btnCalculate = document.getElementById('btn-calculate')!;
  const btnClear = document.getElementById('btn-clear')!;
  const cylinderError = document.getElementById('cylinder-error')!;

  // Results Card
  const resultsPlaceholder = document.getElementById('results-placeholder')!;
  const resultsCard = document.getElementById('results-card')!;

  const resPrimaryLabel = document.getElementById('res-primary-label')!;
  const resModeBadge = document.getElementById('res-mode-badge')!;
  const resPrimaryVal = document.getElementById('res-primary-val')!;
  const resPrimaryUnit = document.getElementById('res-primary-unit')!;
  const resSubtitle = document.getElementById('res-subtitle')!;

  const resLitersStat = document.getElementById('res-liters-stat')!;
  const resGallonsStat = document.getElementById('res-gallons-stat')!;
  const resWaterWeight = document.getElementById('res-water-weight')!;

  const statRadius = document.getElementById('stat-radius')!;
  const statHeight = document.getElementById('stat-height')!;
  const statBaseArea = document.getElementById('stat-base-area')!;
  const statTotalSurface = document.getElementById('stat-total-surface')!;

  const resSteps = document.getElementById('res-steps')!;
  const tableUnitsBody = document.getElementById('table-units-body')!;

  // SVG Elements
  const svgTopEllipse = document.getElementById('svg-top-ellipse') as SVGEllipseElement | null;
  const svgBottomHidden = document.getElementById('svg-bottom-hidden') as SVGPathElement | null;
  const svgBottomFront = document.getElementById('svg-bottom-front') as SVGPathElement | null;
  const svgBodyPath = document.getElementById('svg-body-path') as SVGPathElement | null;
  const svgSideLeft = document.getElementById('svg-side-left') as SVGLineElement | null;
  const svgSideRight = document.getElementById('svg-side-right') as SVGLineElement | null;
  const svgRadiusLine = document.getElementById('svg-radius-line') as SVGLineElement | null;
  const svgRadiusTxt = document.getElementById('svg-radius-txt') as SVGTextElement | null;
  const svgHeightTxt = document.getElementById('svg-height-txt') as SVGTextElement | null;

  let currentMode: CylinderMode = 'radius_height';

  // 1. Mode Switching Logic
  function switchMode(mode: CylinderMode) {
    currentMode = mode;

    modeTabs.forEach((tab) => {
      const isTarget = tab.getAttribute('data-mode') === mode;
      tab.classList.toggle('active', isTarget);
      tab.classList.toggle('border-t', isTarget);
      tab.classList.toggle('border-x', isTarget);
      tab.classList.toggle('border-slate-300/90', isTarget);
      tab.classList.toggle('bg-white', isTarget);
      tab.classList.toggle('text-slate-900', isTarget);
      tab.classList.toggle('shadow-2xs', isTarget);
      tab.classList.toggle('-mb-px', isTarget);
      tab.classList.toggle('dark:border-slate-700', isTarget);
      tab.classList.toggle('dark:bg-slate-900', isTarget);
      tab.classList.toggle('dark:text-white', isTarget);

      tab.classList.toggle('bg-blue-700/90', !isTarget);
      tab.classList.toggle('text-white', !isTarget);
      tab.classList.toggle('dark:bg-blue-800', !isTarget);
      tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
    });

    // Reset rows visibility
    rowRadius.classList.add('hidden');
    rowDiameter.classList.add('hidden');
    rowHeight.classList.add('hidden');
    rowVolumeInput.classList.add('hidden');
    rowOuterRadius.classList.add('hidden');
    rowInnerRadius.classList.add('hidden');
    rowOuterDiameter.classList.add('hidden');
    rowInnerDiameter.classList.add('hidden');
    rowObliqueType.classList.add('hidden');
    rowSlantLength.classList.add('hidden');
    rowSlantAngle.classList.add('hidden');

    if (mode === 'radius_height') {
      modeSubtitle.textContent = 'Known: Base Radius r and Perpendicular Height h';
      rowRadius.classList.remove('hidden');
      labelRadius.textContent = 'Base Radius (r)';
      rowHeight.classList.remove('hidden');
      labelHeight.textContent = 'Height (h)';
    } else if (mode === 'diameter_height') {
      modeSubtitle.textContent = 'Known: Base Diameter d and Perpendicular Height h';
      rowDiameter.classList.remove('hidden');
      rowHeight.classList.remove('hidden');
      labelHeight.textContent = 'Height (h)';
    } else if (mode === 'find_height') {
      modeSubtitle.textContent = 'Reverse Calculation: Find Height from Known Volume & Radius';
      rowVolumeInput.classList.remove('hidden');
      rowRadius.classList.remove('hidden');
      labelRadius.textContent = 'Base Radius (r)';
    } else if (mode === 'find_radius') {
      modeSubtitle.textContent = 'Reverse Calculation: Find Radius & Diameter from Known Volume & Height';
      rowVolumeInput.classList.remove('hidden');
      rowHeight.classList.remove('hidden');
      labelHeight.textContent = 'Height (h)';
    } else if (mode === 'hollow_radius') {
      modeSubtitle.textContent = 'Hollow Cylinder Shell: Known Outer Radius R, Inner Radius r, and Height h';
      rowOuterRadius.classList.remove('hidden');
      rowInnerRadius.classList.remove('hidden');
      rowHeight.classList.remove('hidden');
      labelHeight.textContent = 'Height / Length (h)';
    } else if (mode === 'hollow_diameter') {
      modeSubtitle.textContent = 'Hollow Cylinder / Pipe: Known Outer Diameter D, Inner Diameter d, and Height h';
      rowOuterDiameter.classList.remove('hidden');
      rowInnerDiameter.classList.remove('hidden');
      rowHeight.classList.remove('hidden');
      labelHeight.textContent = 'Height / Length (h)';
    } else if (mode === 'oblique') {
      modeSubtitle.textContent = 'Oblique / Slanted Cylinder: Radius and Perpendicular Height or Slant Length';
      rowRadius.classList.remove('hidden');
      labelRadius.textContent = 'Base Radius (r)';
      rowObliqueType.classList.remove('hidden');
      updateObliqueSubtype();
    }

    // Hide error banner when switching modes
    cylinderError.classList.add('hidden');
  }

  function getSelectedObliqueType(): 'perpendicular_height' | 'slant_angle' {
    const checked = document.querySelector<HTMLInputElement>('input[name="oblique-type"]:checked');
    return (checked?.value as 'perpendicular_height' | 'slant_angle') || 'perpendicular_height';
  }

  function updateObliqueSubtype() {
    if (currentMode !== 'oblique') return;
    const type = getSelectedObliqueType();
    if (type === 'perpendicular_height') {
      rowHeight.classList.remove('hidden');
      labelHeight.textContent = 'Perpendicular Height (h)';
      rowSlantLength.classList.add('hidden');
      rowSlantAngle.classList.add('hidden');
    } else {
      rowHeight.classList.add('hidden');
      rowSlantLength.classList.remove('hidden');
      rowSlantAngle.classList.remove('hidden');
    }
  }

  modeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const mode = tab.getAttribute('data-mode') as CylinderMode;
      if (mode) switchMode(mode);
    });
  });

  document.querySelectorAll('input[name="oblique-type"]').forEach((el) => {
    el.addEventListener('change', () => {
      updateObliqueSubtype();
      if (!resultsCard.classList.contains('hidden')) runCalculation();
    });
  });

  // Length unit badge update
  selectLengthUnit?.addEventListener('change', () => {
    const unit = selectLengthUnit.value;
    unitBadges.forEach((b) => (b.textContent = unit));
    if (!resultsCard.classList.contains('hidden')) runCalculation();
  });

  selectVolumeUnit?.addEventListener('change', () => {
    if (!resultsCard.classList.contains('hidden')) runCalculation();
  });

  // 2. Calculation Execution
  function runCalculation() {
    cylinderError.classList.add('hidden');
    cylinderError.textContent = '';

    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');

    const lengthUnit = (selectLengthUnit.value as LengthUnit) || 'cm';
    const volumeUnit = (selectVolumeUnit.value as VolumeUnit) || 'cm3';
    const inputVolumeUnit = (selectInputVolumeUnit?.value as VolumeUnit) || 'cm3';

    try {
      let result;

      if (currentMode === 'radius_height') {
        const valR = inputRadius.value.trim();
        const valH = inputHeight.value.trim();

        if (!valR) {
          throw new Error('Please enter a value for the base radius (r).');
        }
        if (!valH) {
          throw new Error('Please enter a value for the height (h).');
        }

        result = calculateCylinderVolume({
          mode: 'radius_height',
          lengthUnit,
          volumeUnit,
          radius: valR,
          height: valH,
        });

      } else if (currentMode === 'diameter_height') {
        const valD = inputDiameter.value.trim();
        const valH = inputHeight.value.trim();

        if (!valD) {
          throw new Error('Please enter a value for the base diameter (d).');
        }
        if (!valH) {
          throw new Error('Please enter a value for the height (h).');
        }

        result = calculateCylinderVolume({
          mode: 'diameter_height',
          lengthUnit,
          volumeUnit,
          diameter: valD,
          height: valH,
        });

      } else if (currentMode === 'find_height') {
        const valV = inputVolume.value.trim();
        const valR = inputRadius.value.trim();

        if (!valV) {
          throw new Error('Please enter a known volume (V).');
        }
        if (!valR) {
          throw new Error('Please enter the base radius (r).');
        }

        result = calculateCylinderVolume({
          mode: 'find_height',
          lengthUnit,
          volumeUnit,
          volume: valV,
          inputVolumeUnit,
          radius: valR,
        });

      } else if (currentMode === 'find_radius') {
        const valV = inputVolume.value.trim();
        const valH = inputHeight.value.trim();

        if (!valV) {
          throw new Error('Please enter a known volume (V).');
        }
        if (!valH) {
          throw new Error('Please enter the cylinder height (h).');
        }

        result = calculateCylinderVolume({
          mode: 'find_radius',
          lengthUnit,
          volumeUnit,
          volume: valV,
          inputVolumeUnit,
          height: valH,
        });

      } else if (currentMode === 'hollow_radius') {
        const valR = inputOuterRadius.value.trim();
        const valr = inputInnerRadius.value.trim();
        const valH = inputHeight.value.trim();

        if (!valR) {
          throw new Error('Please enter the outer radius (R).');
        }
        if (!valr) {
          throw new Error('Please enter the inner radius (r).');
        }
        if (!valH) {
          throw new Error('Please enter the height or length (h).');
        }

        result = calculateCylinderVolume({
          mode: 'hollow_radius',
          lengthUnit,
          volumeUnit,
          outerRadius: valR,
          innerRadius: valr,
          height: valH,
        });

      } else if (currentMode === 'hollow_diameter') {
        const valD = inputOuterDiameter.value.trim();
        const vald = inputInnerDiameter.value.trim();
        const valH = inputHeight.value.trim();

        if (!valD) {
          throw new Error('Please enter the outer diameter (D).');
        }
        if (!vald) {
          throw new Error('Please enter the inner diameter (d).');
        }
        if (!valH) {
          throw new Error('Please enter the height or length (h).');
        }

        result = calculateCylinderVolume({
          mode: 'hollow_diameter',
          lengthUnit,
          volumeUnit,
          outerDiameter: valD,
          innerDiameter: vald,
          height: valH,
        });

      } else {
        // oblique
        const valR = inputRadius.value.trim();
        if (!valR) {
          throw new Error('Please enter the base radius (r).');
        }

        const obliqueType = getSelectedObliqueType();
        if (obliqueType === 'slant_angle') {
          const valL = inputSlantLength.value.trim();
          const valAngle = inputSlantAngle.value.trim();

          if (!valL) {
            throw new Error('Please enter the slant side length (L).');
          }
          if (!valAngle) {
            throw new Error('Please enter the slant angle (θ) between 0° and 90°.');
          }

          result = calculateCylinderVolume({
            mode: 'oblique',
            lengthUnit,
            volumeUnit,
            radius: valR,
            obliqueInputType: 'slant_angle',
            slantLength: valL,
            slantAngleDeg: valAngle,
          });
        } else {
          const valH = inputHeight.value.trim();
          if (!valH) {
            throw new Error('Please enter the perpendicular height (h).');
          }

          result = calculateCylinderVolume({
            mode: 'oblique',
            lengthUnit,
            volumeUnit,
            radius: valR,
            obliqueInputType: 'perpendicular_height',
            height: valH,
          });
        }
      }

      // Update Result UI
      if (currentMode === 'find_height') {
        resPrimaryLabel.textContent = 'Derived Cylinder Height (h)';
        resPrimaryVal.textContent = formatNum(result.height);
        resPrimaryUnit.textContent = result.lengthUnit;
        resSubtitle.textContent = `Required perpendicular height for Volume = ${formatNum(Number(inputVolume.value))} ${selectInputVolumeUnit?.value || ''}`;
        resModeBadge.textContent = 'Solved Height';
      } else if (currentMode === 'find_radius') {
        resPrimaryLabel.textContent = 'Derived Base Radius (r)';
        resPrimaryVal.textContent = formatNum(result.radius);
        resPrimaryUnit.textContent = result.lengthUnit;
        resSubtitle.textContent = `Required radius (Diameter: ${formatNum(result.diameter)} ${result.lengthUnit}) for Volume = ${formatNum(Number(inputVolume.value))} ${selectInputVolumeUnit?.value || ''}`;
        resModeBadge.textContent = 'Solved Radius';
      } else {
        resPrimaryLabel.textContent = result.isHollow ? 'Hollow Cylinder Shell Volume (V)' : 'Cylinder Volume (V)';
        resPrimaryVal.textContent = formatNum(result.volume);
        resPrimaryUnit.textContent = VOLUME_UNIT_SYMBOLS[result.displayVolumeUnit] || result.displayVolumeUnit;
        resSubtitle.textContent = result.isHollow
          ? `Material volume of shell with wall thickness ${formatNum(result.wallThickness || 0)} ${result.lengthUnit}`
          : result.isOblique
          ? `Oblique volume derived with perpendicular separation ${formatNum(result.height)} ${result.lengthUnit}`
          : `Standard cylinder volume (Base Area × Perpendicular Height)`;
        resModeBadge.textContent = result.isHollow ? 'Hollow Shell' : result.isOblique ? 'Oblique Cylinder' : 'Right Cylinder';
      }

      // Secondary summary stats
      resLitersStat.textContent = `${formatNum(result.volumeConversions.L, 3)} L (${formatNum(result.volumeConversions.mL, 1)} mL)`;
      resGallonsStat.textContent = `${formatNum(result.volumeConversions.us_gal, 3)} gal (US)`;
      resWaterWeight.textContent = `${formatNum(result.waterWeightKg, 2)} kg (${formatNum(result.waterWeightLbs, 1)} lbs)`;

      statRadius.textContent = `${formatNum(result.radius)} ${result.lengthUnit}`;
      statHeight.textContent = `${formatNum(result.height)} ${result.lengthUnit}`;
      statBaseArea.textContent = `${formatNum(result.baseArea)} ${result.lengthUnit}²`;
      statTotalSurface.textContent = `${formatNum(result.totalSurfaceArea)} ${result.lengthUnit}²`;

      // Render step by step derivation
      resSteps.innerHTML = '';
      result.steps.forEach((step) => {
        const li = document.createElement('li');
        li.textContent = step;
        resSteps.appendChild(li);
      });

      // Render converted units table
      tableUnitsBody.innerHTML = '';
      (Object.keys(result.volumeConversions) as VolumeUnit[]).forEach((u) => {
        const tr = document.createElement('tr');
        const isCurrent = u === result.displayVolumeUnit;
        tr.className = isCurrent
          ? 'bg-blue-50/70 font-bold dark:bg-blue-950/40'
          : 'hover:bg-slate-50 dark:hover:bg-slate-900/60';
        tr.innerHTML = `
          <td class="p-2 text-slate-800 dark:text-slate-200">${VOLUME_UNIT_NAMES[u]}</td>
          <td class="p-2 text-right ${isCurrent ? 'text-blue-600 dark:text-blue-400 font-black' : 'text-slate-900 dark:text-white'}">
            ${formatNum(result.volumeConversions[u], 4)} ${VOLUME_UNIT_SYMBOLS[u]}
          </td>
        `;
        tableUnitsBody.appendChild(tr);
      });

      // Update proportional SVG diagram preview
      renderSvgCylinder(result);

      // Reveal Results Card and Action Bar
      resultsPlaceholder.classList.add('hidden');
      resultsCard.classList.remove('hidden');

      if (bar) bar.classList.remove('hidden');

    } catch (err: any) {
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      if (bar) bar.classList.add('hidden');
      cylinderError.textContent = err?.message || 'Invalid geometric dimensions entered.';
      cylinderError.classList.remove('hidden');
    }
  }

  function renderSvgCylinder(res: any) {
    if (!svgTopEllipse || !svgBodyPath || !svgSideLeft || !svgSideRight || !svgBottomFront || !svgBottomHidden || !svgRadiusLine || !svgRadiusTxt || !svgHeightTxt) return;

    const r = res.radius;
    const h = res.height;
    const unit = res.lengthUnit;

    // ViewBox is 420 x 250
    // Center X = 210
    const centerX = 210;
    const maxDrawWidth = 180;
    const maxDrawHeight = 120;

    // Compute aspect scaling
    const scale = Math.min(maxDrawWidth / (2 * (r || 1)), maxDrawHeight / (h || 1));
    const drawR = Math.max(28, Math.min(90, r * scale));
    const drawH = Math.max(30, Math.min(130, h * scale));
    const drawRy = Math.max(10, Math.min(26, drawR * 0.3));

    const centerYTop = 125 - drawH / 2;
    const centerYBottom = 125 + drawH / 2;

    const leftX = centerX - drawR;
    const rightX = centerX + drawR;

    // Oblique horizontal shift if oblique
    const shiftX = res.isOblique ? 25 : 0;
    const topCenterX = centerX + shiftX;
    const topLeftX = leftX + shiftX;
    const topRightX = rightX + shiftX;

    // Top Base Ellipse
    svgTopEllipse.setAttribute('cx', String(topCenterX));
    svgTopEllipse.setAttribute('cy', String(centerYTop));
    svgTopEllipse.setAttribute('rx', String(drawR));
    svgTopEllipse.setAttribute('ry', String(drawRy));

    // Bottom Base Curves
    svgBottomHidden.setAttribute('d', `M ${leftX} ${centerYBottom} A ${drawR} ${drawRy} 0 0 1 ${rightX} ${centerYBottom}`);
    svgBottomFront.setAttribute('d', `M ${leftX} ${centerYBottom} A ${drawR} ${drawRy} 0 0 0 ${rightX} ${centerYBottom}`);

    // Lateral Surface Body & Edges
    svgBodyPath.setAttribute(
      'd',
      `M ${topLeftX} ${centerYTop} L ${leftX} ${centerYBottom} A ${drawR} ${drawRy} 0 0 0 ${rightX} ${centerYBottom} L ${topRightX} ${centerYTop} Z`
    );
    svgSideLeft.setAttribute('x1', String(topLeftX));
    svgSideLeft.setAttribute('y1', String(centerYTop));
    svgSideLeft.setAttribute('x2', String(leftX));
    svgSideLeft.setAttribute('y2', String(centerYBottom));

    svgSideRight.setAttribute('x1', String(topRightX));
    svgSideRight.setAttribute('y1', String(centerYTop));
    svgSideRight.setAttribute('x2', String(rightX));
    svgSideRight.setAttribute('y2', String(centerYBottom));

    // Radius line & text
    svgRadiusLine.setAttribute('x1', String(topCenterX));
    svgRadiusLine.setAttribute('y1', String(centerYTop));
    svgRadiusLine.setAttribute('x2', String(topRightX));
    svgRadiusLine.setAttribute('y2', String(centerYTop));

    svgRadiusTxt.setAttribute('x', String(topCenterX + drawR / 2));
    svgRadiusTxt.setAttribute('y', String(centerYTop - 6));
    svgRadiusTxt.textContent = `r = ${formatNum(r)} ${unit}`;

    // Height text
    svgHeightTxt.setAttribute('x', String(Math.min(topLeftX, leftX) - 24));
    svgHeightTxt.setAttribute('y', String(125));
    svgHeightTxt.textContent = `h = ${formatNum(h)} ${unit}`;
  }

  // 3. Buttons & Reset Handlers
  btnCalculate?.addEventListener('click', runCalculation);

  btnClear?.addEventListener('click', () => {
    // STRICT ZERO DEFAULT VALUES: All numeric fields must be completely empty!
    inputRadius.value = '';
    inputDiameter.value = '';
    inputHeight.value = '';
    inputVolume.value = '';
    inputOuterRadius.value = '';
    inputInnerRadius.value = '';
    inputOuterDiameter.value = '';
    inputInnerDiameter.value = '';
    inputSlantLength.value = '';
    inputSlantAngle.value = '';

    cylinderError.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');

    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');

    if (currentMode === 'radius_height' || currentMode === 'oblique') inputRadius.focus();
    else if (currentMode === 'diameter_height') inputDiameter.focus();
    else if (currentMode === 'find_height' || currentMode === 'find_radius') inputVolume.focus();
    else if (currentMode === 'hollow_radius') inputOuterRadius.focus();
    else if (currentMode === 'hollow_diameter') inputOuterDiameter.focus();
  });

  // Enter key trigger on form inputs
  document.querySelectorAll('#cylinder-form input').forEach((inp) => {
    inp.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        btnCalculate?.click();
      }
    });
  });

  // CRITICAL AUDIT: EVERY INPUT FIELD STARTS COMPLETELY EMPTY (value="").
  // NO PREFILLED NUMBERS. RESULTS ARE INITIALLY HIDDEN.
</script>
