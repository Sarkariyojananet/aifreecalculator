            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Height:</span> <strong class="text-slate-900 dark:text-white">${h} ${hUnit}</strong></div>
            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Calc Radius:</span> <strong class="text-slate-900 dark:text-white">${rDisp.toFixed(2)} ${rUnit}</strong></div>
