          `;

          legendHtml = `
            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Length:</span> <strong class="text-slate-900 dark:text-white">${l} ${lUnit}</strong></div>
