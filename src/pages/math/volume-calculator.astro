            <text x="160" y="125" text-anchor="middle" font-size="12" font-weight="bold" fill="#0c4a6e">${shape.toUpperCase()} POOL</text>
            <text x="160" y="165" text-anchor="middle" font-size="10" font-weight="bold" fill="#ffffff">Water Depth ~ ${depth} ${lUnit}</text>
          `;

          legendHtml = `
            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Shape:</span> <strong class="capitalize text-slate-900 dark:text-white">${shape}</strong></div>
            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Plan Size:</span> <strong class="text-slate-900 dark:text-white">${l} × ${w} ${lUnit}</strong></div>
            <div class="rounded-lg bg-blue-50 p-2 text-blue-700 dark:bg-blue-950 dark:text-blue-300 col-span-2"><strong>Volume = Area × Avg Depth</strong></div>
          `;
        } else if (activeMode === "sphere") {
          const dimType =
            document.querySelector('input[name="sph-dim-type"]:checked')
              ?.value || "radius";
          const val = parseFloat(document.getElementById("sph-r")?.value) || 5;
          const unit = document.getElementById("sph-r-unit")?.value || "cm";
          const rDisp = dimType === "diameter" ? val / 2 : val;

          svgHtml = `
            <defs>
              <radialGradient id="sphereGrad" cx="35%" cy="35%" r="65%">
                <stop offset="0%" stop-color="#93c5fd"/>
