          const rUnit = document.getElementById("cyl-r-unit")?.value || "m";
          const hUnit = document.getElementById("cyl-h-unit")?.value || "m";

          const rDisp = dimType === "diameter" ? val / 2 : val;
          const rx = 65;
          const ry = 22;
          const cyH = 110;
          const cx = 170;
          const topY = 65;
          const botY = topY + cyH;

          svgHtml = `
            <defs>
              <linearGradient id="gradCyl" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#1d4ed8"/>
