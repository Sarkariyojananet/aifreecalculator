---
export const prerender = true;

import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
---

<CalculatorLayout
  title="Volume Calculator – Tank, Cylinder, Pipe, Pool, Sphere & Cone"
  description="Calculate exact volume and fluid capacity for rectangular tanks, cylinders, pipes, swimming pools, spheres, cones, and prostate ellipsoid with high-precision unit conversions."
  category="Math"
  calculatorName="Volume Calculator"
  slug="volume-calculator"
  keywords={[
    "volume calculator",
    "tank volume calculator",
    "cylinder volume calculator",
    "pipe volume calculator",
    "prostate volume calculator",
    "pool volume calculator",
    "sphere volume calculator",
    "cone volume calculator",
    "water tank capacity calculator",
    "liters to gallons calculator",
  ]}
>
  <div class="space-y-6">
    <!-- TOP MODE SELECTION TABS -->
    <div
      class="rounded-2xl border border-slate-200/90 bg-white p-2 shadow-2xs dark:border-slate-800 dark:bg-slate-900"
    >
      <div
        class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin"
      >
        <button
          type="button"
          class="btn-shape-tab active shrink-0 rounded-xl bg-blue-600 px-3.5 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5"
          data-mode="rectangular"
        >
          <span>📦</span>
          <span>Rectangular Tank / Box</span>
        </button>
        <button
          type="button"
          class="btn-shape-tab shrink-0 rounded-xl border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-mode="cylinder"
        >
          <span>🛢️</span>
          <span>Cylindrical Tank / Cylinder</span>
        </button>
        <button
          type="button"
          class="btn-shape-tab shrink-0 rounded-xl border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-mode="pipe"
        >
          <span>🚿</span>
          <span>Pipe Volume &amp; Capacity</span>
        </button>
        <button
          type="button"
          class="btn-shape-tab shrink-0 rounded-xl border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-mode="pool"
        >
          <span>🏊</span>
          <span>Swimming Pool</span>
        </button>
        <button
          type="button"
          class="btn-shape-tab shrink-0 rounded-xl border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-mode="sphere"
        >
          <span>⚪</span>
          <span>Sphere</span>
        </button>
        <button
          type="button"
          class="btn-shape-tab shrink-0 rounded-xl border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-mode="cone"
        >
          <span>📐</span>
          <span>Cone</span>
        </button>
        <button
          type="button"
          class="btn-shape-tab shrink-0 rounded-xl border border-purple-300 bg-purple-50/70 px-3.5 py-2 font-semibold text-purple-800 hover:bg-purple-100 dark:border-purple-800 dark:bg-purple-950/40 dark:text-purple-300 cursor-pointer transition flex items-center gap-1.5"
          data-mode="prostate"
        >
          <span>🩺</span>
          <span>Prostate Volume (Medical)</span>
        </button>
      </div>
    </div>

    <!-- QUICK PRESETS BAR -->
    <div
      class="rounded-2xl border border-slate-200/90 bg-white p-3 shadow-2xs dark:border-slate-800 dark:bg-slate-900"
    >
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span
          class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1"
        >
          <span>⚡</span> Quick Presets:
        </span>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-preset="rect_tank"
        >
          📦 5m × 2m × 1.5m Tank (15k L)
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-preset="cylinder_silo"
        >
          🛢️ Cylinder r=2m, h=5m
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-preset="pipe_100mm"
        >
          🚿 100mm Pipe (10m length)
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-preset="pool_10x5"
        >
          🏊 10m × 5m Pool (Avg Depth 2m)
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-preset="sphere_5cm"
        >
          ⚪ Sphere r=5cm
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-preset="cone_3x6"
        >
          📐 Cone r=3m, h=6m
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-purple-300 bg-purple-50/70 px-2.5 py-1 font-semibold text-purple-800 hover:border-purple-500 hover:text-purple-600 dark:border-purple-800 dark:bg-purple-950/40 dark:text-purple-300 cursor-pointer transition"
          data-preset="prostate_sample"
        >
          🩺 Prostate 4 × 3 × 4 cm
        </button>
      </div>
    </div>

    <!-- MAIN CALCULATOR WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- LEFT: INPUT FORM CARD -->
      <div
        class="lg:col-span-7 rounded-2xl border border-slate-200/80 bg-slate-50/50 p-5 dark:border-slate-800 dark:bg-slate-950/40 sm:p-6 space-y-5"
      >
        <!-- Shape Header & Description -->
        <div class="border-b border-slate-200/80 pb-3.5 dark:border-slate-800">
          <div class="flex items-center justify-between">
            <h2
              id="mode-title"
              class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"
            >
              <span>📦</span> Rectangular Tank / Box Volume
            </h2>
            <span
              id="mode-badge"
              class="rounded-full bg-blue-100 px-2.5 py-0.5 text-[11px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300"
            >
              V = L × W × H
            </span>
          </div>
          <p
            id="mode-desc"
            class="mt-1 text-xs text-slate-600 dark:text-slate-400"
          >
            Calculate the exact internal volume, liquid storage capacity, and
            water weight of any rectangular container or box.
          </p>
        </div>

        <!-- FORM CONTAINER -->
        <form
          id="volume-form"
          class="space-y-4"
          onsubmit="return false;"
          novalidate
        >
          <!-- 1. RECTANGULAR INPUTS -->
          <div id="fields-rectangular" class="shape-fields space-y-3.5">
            <div>
              <label
                for="rect-l"
                class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
              >
                Length (L)
              </label>
              <div class="flex gap-2">
                <input
                  type="number"
                  id="rect-l"
                  value="5"
                  step="any"
                  min="0.0001"
                  class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="e.g. 5"
                />
                <select
                  id="rect-l-unit"
                  class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                >
                  <option value="m" selected>Meters (m)</option>
                  <option value="cm">Centimeters (cm)</option>
                  <option value="mm">Millimeters (mm)</option>
                  <option value="ft">Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                </select>
              </div>
            </div>

            <div>
              <label
                for="rect-w"
                class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
              >
                Width (W)
              </label>
              <div class="flex gap-2">
                <input
                  type="number"
                  id="rect-w"
                  value="2"
                  step="any"
                  min="0.0001"
                  class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="e.g. 2"
                />
                <select
                  id="rect-w-unit"
                  class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                >
                  <option value="m" selected>Meters (m)</option>
                  <option value="cm">Centimeters (cm)</option>
                  <option value="mm">Millimeters (mm)</option>
                  <option value="ft">Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                </select>
              </div>
            </div>

            <div>
              <label
                for="rect-h"
                class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
              >
                Height / Depth (H)
              </label>
              <div class="flex gap-2">
                <input
                  type="number"
                  id="rect-h"
                  value="1.5"
                  step="any"
                  min="0.0001"
                  class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="e.g. 1.5"
                />
                <select
                  id="rect-h-unit"
                  class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                >
                  <option value="m" selected>Meters (m)</option>
                  <option value="cm">Centimeters (cm)</option>
                  <option value="mm">Millimeters (mm)</option>
                  <option value="ft">Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- 2. CYLINDER INPUTS -->
          <div id="fields-cylinder" class="shape-fields hidden space-y-3.5">
            <div>
              <div class="flex items-center justify-between mb-1">
                <label
                  class="text-xs font-bold text-slate-700 dark:text-slate-300"
                  >Base Dimension Input</label
                >
                <div class="flex items-center gap-3 text-xs font-semibold">
                  <label class="inline-flex items-center gap-1 cursor-pointer">
                    <input
                      type="radio"
                      name="cyl-dim-type"
                      value="radius"
                      checked
                      class="text-blue-600 focus:ring-blue-500"
                    />
                    <span>Radius (r)</span>
                  </label>
                  <label class="inline-flex items-center gap-1 cursor-pointer">
                    <input
                      type="radio"
                      name="cyl-dim-type"
                      value="diameter"
                      class="text-blue-600 focus:ring-blue-500"
                    />
                    <span>Diameter (d)</span>
                  </label>
                </div>
              </div>
              <div class="flex gap-2">
                <input
                  type="number"
                  id="cyl-r"
                  value="2"
                  step="any"
                  min="0.0001"
                  class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <select
                  id="cyl-r-unit"
                  class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                >
                  <option value="m" selected>Meters (m)</option>
                  <option value="cm">Centimeters (cm)</option>
                  <option value="mm">Millimeters (mm)</option>
                  <option value="ft">Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                </select>
              </div>
            </div>

            <div>
              <label
                for="cyl-h"
                class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
              >
                Height / Length (h)
              </label>
              <div class="flex gap-2">
                <input
                  type="number"
                  id="cyl-h"
                  value="5"
                  step="any"
                  min="0.0001"
                  class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <select
                  id="cyl-h-unit"
                  class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                >
                  <option value="m" selected>Meters (m)</option>
                  <option value="cm">Centimeters (cm)</option>
                  <option value="mm">Millimeters (mm)</option>
                  <option value="ft">Feet (ft)</option>
                  <option value="in">Inches (in)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- 3. PIPE INPUTS -->
          <div id="fields-pipe" class="shape-fields hidden space-y-3.5">
            <div
              class="rounded-xl bg-slate-50 p-2.5 border border-slate-200 dark:bg-slate-800/50 dark:border-slate-800"
            >
              <span
                class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5"
                >Pipe Dimension Method</span
              >
              <div class="grid grid-cols-2 gap-2 text-xs">
                <label
                  class="flex items-center gap-1.5 rounded-lg border border-slate-300 p-2 cursor-pointer bg-white dark:bg-slate-900 dark:border-slate-700"
                >
                  <input
                    type="radio"
                    name="pipe-mode"
                    value="inner_diameter"
                    checked
                    class="text-blue-600"
                  />
                  <span class="font-semibold">Internal Diameter Only</span>
                </label>
                <label
                  class="flex items-center gap-1.5 rounded-lg border border-slate-300 p-2 cursor-pointer bg-white dark:bg-slate-900 dark:border-slate-700"
                >
                  <input
                    type="radio"
                    name="pipe-mode"
                    value="outer_and_wall"
                    class="text-blue-600"
                  />
                  <span class="font-semibold">Outer Dia + Wall Thickness</span>
                </label>
              </div>
            </div>

            <div id="pipe-box-inner" class="space-y-1">
              <label
                for="pipe-id"
                class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
              >
                Internal Diameter (ID)
              </label>
              <div class="flex gap-2">
                <input
                  type="number"
                  id="pipe-id"
                  value="100"
                  step="any"
                  min="0.001"
                  class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="e.g. 100"
                />
                <select
                  id="pipe-id-unit"
                  class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                >
                  <option value="mm" selected>Millimeters (mm)</option>
                  <option value="cm">Centimeters (cm)</option>
                  <option value="m">Meters (m)</option>
                  <option value="in">Inches (in)</option>
                  <option value="ft">Feet (ft)</option>
                </select>
              </div>
            </div>

            <div id="pipe-box-outer" class="hidden space-y-3">
              <div>
                <label
                  for="pipe-od"
                  class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
                >
                  Outer Diameter (OD)
                </label>
                <div class="flex gap-2">
                  <input
                    type="number"
                    id="pipe-od"
                    value="110"
                    step="any"
                    min="0.001"
                    class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                    placeholder="e.g. 110"
                  />
                  <select
                    id="pipe-od-unit"
                    class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                  >
                    <option value="mm" selected>Millimeters (mm)</option>
                    <option value="cm">Centimeters (cm)</option>
                    <option value="m">Meters (m)</option>
                    <option value="in">Inches (in)</option>
                  </select>
                </div>
              </div>

              <div>
                <label
                  for="pipe-thk"
                  class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
                >
                  Wall Thickness (t)
                </label>
                <div class="flex gap-2">
                  <input
                    type="number"
                    id="pipe-thk"
                    value="5"
                    step="any"
                    min="0.001"
                    class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                    placeholder="e.g. 5"
                  />
                  <select
                    id="pipe-thk-unit"
                    class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                  >
                    <option value="mm" selected>Millimeters (mm)</option>
                    <option value="cm">Centimeters (cm)</option>
                    <option value="in">Inches (in)</option>
                  </select>
                </div>
                <p class="mt-1 text-[11px] text-slate-500">
                  Note: Internal Diameter = Outer Dia − (2 × Wall Thickness).
                </p>
              </div>
            </div>

            <div>
              <label
                for="pipe-len"
                class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
              >
                Pipe Length (L)
              </label>
              <div class="flex gap-2">
                <input
                  type="number"
                  id="pipe-len"
                  value="10"
                  step="any"
                  min="0.0001"
                  class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="e.g. 10"
                />
                <select
                  id="pipe-len-unit"
                  class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                >
                  <option value="m" selected>Meters (m)</option>
                  <option value="ft">Feet (ft)</option>
                  <option value="cm">Centimeters (cm)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- 4. POOL INPUTS -->
          <div id="fields-pool" class="shape-fields hidden space-y-3.5">
            <div class="grid grid-cols-3 gap-2">
              <label
                class="flex flex-col items-center gap-1 rounded-xl border border-slate-300 p-2.5 text-center cursor-pointer bg-white dark:bg-slate-800 dark:border-slate-700 has-checked:border-blue-600 has-checked:bg-blue-50/50 dark:has-checked:bg-blue-950/40"
              >
                <input
                  type="radio"
                  name="pool-shape"
                  value="rectangular"
                  checked
                  class="text-blue-600"
                />
                <span
                  class="text-xs font-bold text-slate-800 dark:text-slate-200"
                  >Rectangular</span
                >
              </label>
              <label
                class="flex flex-col items-center gap-1 rounded-xl border border-slate-300 p-2.5 text-center cursor-pointer bg-white dark:bg-slate-800 dark:border-slate-700 has-checked:border-blue-600 has-checked:bg-blue-50/50 dark:has-checked:bg-blue-950/40"
              >
                <input
                  type="radio"
                  name="pool-shape"
                  value="circular"
                  class="text-blue-600"
                />
                <span
                  class="text-xs font-bold text-slate-800 dark:text-slate-200"
                  >Circular</span
                >
              </label>
              <label
                class="flex flex-col items-center gap-1 rounded-xl border border-slate-300 p-2.5 text-center cursor-pointer bg-white dark:bg-slate-800 dark:border-slate-700 has-checked:border-blue-600 has-checked:bg-blue-50/50 dark:has-checked:bg-blue-950/40"
              >
                <input
                  type="radio"
                  name="pool-shape"
                  value="oval"
                  class="text-blue-600"
                />
                <span
                  class="text-xs font-bold text-slate-800 dark:text-slate-200"
                  >Oval</span
                >
              </label>
            </div>

            <!-- Pool Plan Dimensions -->
            <div id="pool-box-linear" class="space-y-3">
              <div>
                <label
                  for="pool-l"
                  class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1"
                >
                  Pool Length
                </label>
                <div class="flex gap-2">
                  <input
                    type="number"
                    id="pool-l"
                    value="10"
                    step="any"
                    min="0.1"
