            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Length:</span> <strong class="text-slate-900 dark:text-white">${len} ${lenUnit}</strong></div>
            <div class="rounded-lg bg-blue-50 p-2 text-blue-700 dark:bg-blue-950 dark:text-blue-300 col-span-2"><strong>Fluid Volume = π × (ID / 2)² × L</strong></div>
          `;
        } else if (activeMode === "pool") {
