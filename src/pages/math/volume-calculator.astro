            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Height:</span> <strong class="text-slate-900 dark:text-white">${h} ${hUnit}</strong></div>
            <div class="rounded-lg bg-blue-50 p-2 text-blue-700 dark:bg-blue-950 dark:text-blue-300"><strong>V = L × W × H</strong></div>
          `;
        } else if (activeMode === "cylinder") {
          const dimType =
            document.querySelector('input[name="cyl-dim-type"]:checked')
              ?.value || "radius";
          const val = parseFloat(document.getElementById("cyl-r")?.value) || 2;
