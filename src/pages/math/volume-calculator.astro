          svgHtml = `
            <defs>
              <linearGradient id="coneGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#1d4ed8"/>
                <stop offset="50%" stop-color="#3b82f6"/>
                <stop offset="100%" stop-color="#1e40af"/>
              </linearGradient>
            </defs>
            <!-- Cone Body -->
            <path d="M 170 35 L 240 170 A 70 20 0 0 1 100 170 Z" fill="url(#coneGrad)" stroke="#1e3a8a" stroke-width="1.5"/>
            <!-- Base Ellipse bottom arc -->
            <ellipse cx="170" cy="170" rx="70" ry="20" fill="#93c5fd" opacity="0.4" stroke="#1e3a8a" stroke-width="1.5"/>
            <!-- Height line -->
            <line x1="170" y1="35" x2="170" y2="170" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="3 3"/>
            <!-- Radius line -->
            <line x1="170" y1="170" x2="240" y2="170" stroke="#ffffff" stroke-width="2"/>
            <text x="205" y="164" text-anchor="middle" font-size="10" font-weight="bold" fill="#ffffff">r: ${rDisp} ${rUnit}</text>
            <text x="160" y="105" text-anchor="end" font-size="11" font-weight="bold" fill="#ffffff">h: ${h} ${hUnit}</text>
          `;

          legendHtml = `
            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Radius:</span> <strong class="text-slate-900 dark:text-white">${rDisp} ${rUnit}</strong></div>
            <div class="rounded-lg bg-slate-100 p-2 dark:bg-slate-800"><span class="text-slate-500">Height:</span> <strong class="text-slate-900 dark:text-white">${h} ${hUnit}</strong></div>
            <div class="rounded-lg bg-blue-50 p-2 text-blue-700 dark:bg-blue-950 dark:text-blue-300 col-span-2"><strong>V = (1 / 3) × π × r² × h</strong></div>
          `;
        } else if (activeMode === "prostate") {
          const l = parseFloat(document.getElementById("pros-l")?.value) || 4.0;
          const w = parseFloat(document.getElementById("pros-w")?.value) || 3.0;
          const h = parseFloat(document.getElementById("pros-h")?.value) || 4.0;

          svgHtml = `
            <defs>
              <radialGradient id="prosGrad" cx="35%" cy="35%" r="65%">
                <stop offset="0%" stop-color="#d8b4fe"/>
                <stop offset="50%" stop-color="#9333ea"/>
                <stop offset="100%" stop-color="#581c87"/>
              </radialGradient>
            </defs>
            <ellipse cx="170" cy="115" rx="75" ry="55" fill="url(#prosGrad)" stroke="#6b21a8" stroke-width="2"/>
            <!-- Measurement axes -->
            <line x1="95" y1="115" x2="245" y2="115" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="3 3"/>
            <line x1="170" y1="60" x2="170" y2="170" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="3 3"/>
            <text x="170" y="110" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">Prolate Ellipsoid</text>
            <text x="170" y="128" text-anchor="middle" font-size="10" font-weight="bold" fill="#f3e8ff">${l} × ${w} × ${h} cm</text>
          `;

          legendHtml = `
            <div class="rounded-lg bg-purple-50 p-2 dark:bg-purple-950 col-span-2 text-purple-900 dark:text-purple-300">
              <strong>V = Length × Width × Height × 0.52 (mL)</strong>
            </div>
          `;
        }

        svg.innerHTML = svgHtml;
        legend.innerHTML = legendHtml;
      }

      // ─── MAIN CALCULATION ENGINE ───────────────────────────────────────────
      function executeVolumeCalculation() {
        const errEl = document.getElementById("calc-error");
        if (errEl) errEl.classList.add("hidden");

        const outUnit =
          document.getElementById("output-unit-pref")?.value || "m3";

        try {
          let volumeM3 = 0;
          let formulaUsed = "";
          let steps = [];
          let secondaryData = null;

          if (activeMode === "rectangular") {
            const l = parseFloat(document.getElementById("rect-l")?.value);
            const w = parseFloat(document.getElementById("rect-w")?.value);
            const h = parseFloat(document.getElementById("rect-h")?.value);
            const lUnit = document.getElementById("rect-l-unit")?.value;
            const wUnit = document.getElementById("rect-w-unit")?.value;
            const hUnit = document.getElementById("rect-h-unit")?.value;

            if (
              isNaN(l) ||
              isNaN(w) ||
              isNaN(h) ||
              l <= 0 ||
              w <= 0 ||
              h <= 0
            ) {
              throw new Error(
                "All rectangular tank dimensions (length, width, height) must be positive numbers greater than zero.",
              );
            }

            const lM = toM(l, lUnit);
            const wM = toM(w, wUnit);
            const hM = toM(h, hUnit);
            volumeM3 = lM * wM * hM;
            formulaUsed = "Volume = Length × Width × Height";
            steps = [
              `Formula: V = Length × Width × Height`,
              `Input: ${l} ${lUnit} × ${w} ${wUnit} × ${h} ${hUnit}`,
              `Converted to meters: ${lM.toFixed(4)} m × ${wM.toFixed(4)} m × ${hM.toFixed(4)} m`,
              `Result in Cubic Meters = ${volumeM3.toFixed(6)} m³`,
              `Converted to ${V_LABELS[outUnit] || outUnit}: ${formatNum(fromM3(volumeM3, outUnit))} ${outUnit}`,
            ];
          } else if (activeMode === "cylinder") {
            const dimType = document.querySelector(
              'input[name="cyl-dim-type"]:checked',
            )?.value;
            const val = parseFloat(document.getElementById("cyl-r")?.value);
            const h = parseFloat(document.getElementById("cyl-h")?.value);
            const rUnit = document.getElementById("cyl-r-unit")?.value;
            const hUnit = document.getElementById("cyl-h-unit")?.value;

            if (isNaN(val) || isNaN(h) || val <= 0 || h <= 0) {
              throw new Error(
                `The cylinder ${dimType} and height must be positive numbers greater than zero.`,
              );
            }

            const rawM = toM(val, rUnit);
            const rM = dimType === "diameter" ? rawM / 2 : rawM;
            const hM = toM(h, hUnit);

            volumeM3 = Math.PI * Math.pow(rM, 2) * hM;
            formulaUsed =
              dimType === "diameter"
                ? "V = π × (Diameter / 2)² × Height"
                : "V = π × Radius² × Height";
            steps = [
              `Formula: ${formulaUsed}`,
              dimType === "diameter"
                ? `Diameter = ${val} ${rUnit} → Radius = ${(val / 2).toFixed(4)} ${rUnit}`
                : `Radius = ${val} ${rUnit}`,
              `Normalized to meters: Radius = ${rM.toFixed(4)} m, Height = ${hM.toFixed(4)} m`,
              `Calculation: π × (${rM.toFixed(4)})² × ${hM.toFixed(4)} = ${volumeM3.toFixed(6)} m³`,
              `Output in ${V_LABELS[outUnit]}: ${formatNum(fromM3(volumeM3, outUnit))} ${outUnit}`,
            ];
          } else if (activeMode === "pipe") {
            const pipeMode = document.querySelector(
              'input[name="pipe-mode"]:checked',
            )?.value;
            const len = parseFloat(document.getElementById("pipe-len")?.value);
            const lenUnit = document.getElementById("pipe-len-unit")?.value;

            if (isNaN(len) || len <= 0) {
              throw new Error("Pipe length must be greater than zero.");
            }
            const lenM = toM(len, lenUnit);

            let innerM = 0;
            let outerM = null;

            if (pipeMode === "inner_diameter") {
              const idVal = parseFloat(
                document.getElementById("pipe-id")?.value,
              );
              const idUnit = document.getElementById("pipe-id-unit")?.value;
              if (isNaN(idVal) || idVal <= 0)
                throw new Error("Internal diameter must be greater than zero.");
              innerM = toM(idVal, idUnit);
            } else {
              const odVal = parseFloat(
                document.getElementById("pipe-od")?.value,
              );
              const odUnit = document.getElementById("pipe-od-unit")?.value;
              const thkVal = parseFloat(
                document.getElementById("pipe-thk")?.value,
              );
              const thkUnit = document.getElementById("pipe-thk-unit")?.value;

              if (isNaN(odVal) || odVal <= 0)
                throw new Error("Outer diameter must be greater than zero.");
              if (isNaN(thkVal) || thkVal <= 0)
                throw new Error("Wall thickness must be greater than zero.");

              outerM = toM(odVal, odUnit);
              const thkM = toM(thkVal, thkUnit);
              innerM = outerM - 2 * thkM;
              if (innerM <= 0) {
                throw new Error(
                  "Wall thickness is too large: Outer diameter must be greater than 2 × Wall Thickness.",
                );
              }
            }

            const innerRadiusM = innerM / 2;
            volumeM3 = Math.PI * Math.pow(innerRadiusM, 2) * lenM;
            const litersPerM = (volumeM3 * 1000) / lenM;
            const litersPerFt = (volumeM3 * 1000) / (lenM / 0.3048);

            formulaUsed =
              "Fluid Volume = π × (Internal Diameter / 2)² × Length";
            steps = [
              `Formula: Internal Capacity = π × (ID / 2)² × Length`,
              `Internal Diameter = ${innerM.toFixed(4)} m (Radius = ${innerRadiusM.toFixed(4)} m)`,
              `Pipe Length = ${lenM.toFixed(4)} m`,
              `Calculation: π × (${innerRadiusM.toFixed(4)} m)² × ${lenM.toFixed(4)} m = ${volumeM3.toFixed(6)} m³`,
              `Total Internal Fluid = ${(volumeM3 * 1000).toFixed(3)} Liters`,
              `Linear Metric Capacity = ${litersPerM.toFixed(3)} Liters per linear meter (${litersPerFt.toFixed(3)} L/ft)`,
            ];

            let matVolM3 = null;
            if (outerM !== null) {
              const outerTotal = Math.PI * Math.pow(outerM / 2, 2) * lenM;
              matVolM3 = outerTotal - volumeM3;
              steps.push(
                `Pipe Material Volume (Walls) = Outer Cylinder (${outerTotal.toFixed(5)} m³) − Lumen (${volumeM3.toFixed(5)} m³) = ${matVolM3.toFixed(5)} m³`,
              );
            }

            secondaryData = {
              type: "pipe",
              litersPerM: litersPerM,
              litersPerFt: litersPerFt,
              materialVolM3: matVolM3,
            };
          } else if (activeMode === "pool") {
            const shape = document.querySelector(
              'input[name="pool-shape"]:checked',
            )?.value;
            const depthMode = document.querySelector(
              'input[name="pool-depth-mode"]:checked',
            )?.value;
            let avgDepthM = 0;

            if (depthMode === "average") {
              const d = parseFloat(
                document.getElementById("pool-depth-single")?.value,
              );
              const dUnit = document.getElementById(
                "pool-depth-single-unit",
              )?.value;
              if (isNaN(d) || d <= 0)
                throw new Error("Pool depth must be greater than zero.");
              avgDepthM = toM(d, dUnit);
            } else {
              const dShallow = parseFloat(
                document.getElementById("pool-depth-shallow")?.value,
              );
              const dShallowUnit = document.getElementById(
                "pool-depth-shallow-unit",
              )?.value;
              const dDeep = parseFloat(
                document.getElementById("pool-depth-deep")?.value,
              );
              const dDeepUnit = document.getElementById(
                "pool-depth-deep-unit",
              )?.value;
              if (
                isNaN(dShallow) ||
                isNaN(dDeep) ||
                dShallow <= 0 ||
                dDeep <= 0
              ) {
                throw new Error(
                  "Both shallow and deep depths must be positive numbers greater than zero.",
                );
              }
              avgDepthM =
                (toM(dShallow, dShallowUnit) + toM(dDeep, dDeepUnit)) / 2;
            }

            let areaM2 = 0;
            if (shape === "rectangular") {
              const l = parseFloat(document.getElementById("pool-l")?.value);
              const w = parseFloat(document.getElementById("pool-w")?.value);
              const lUnit = document.getElementById("pool-l-unit")?.value;
              const wUnit = document.getElementById("pool-w-unit")?.value;
              if (isNaN(l) || isNaN(w) || l <= 0 || w <= 0)
                throw new Error(
                  "Pool length and width must be greater than zero.",
                );
              areaM2 = toM(l, lUnit) * toM(w, wUnit);
              formulaUsed = "Volume = Length × Width × Average Depth";
            } else if (shape === "circular") {
              const dia = parseFloat(
                document.getElementById("pool-dia")?.value,
              );
              const diaUnit = document.getElementById("pool-dia-unit")?.value;
              if (isNaN(dia) || dia <= 0)
                throw new Error("Pool diameter must be greater than zero.");
              const rM = toM(dia, diaUnit) / 2;
              areaM2 = Math.PI * Math.pow(rM, 2);
              formulaUsed = "Volume = π × (Diameter / 2)² × Average Depth";
            } else {
              // oval
              const l = parseFloat(document.getElementById("pool-l")?.value);
              const w = parseFloat(document.getElementById("pool-w")?.value);
              const lUnit = document.getElementById("pool-l-unit")?.value;
              const wUnit = document.getElementById("pool-w-unit")?.value;
              if (isNaN(l) || isNaN(w) || l <= 0 || w <= 0)
                throw new Error(
                  "Oval pool length and width must be greater than zero.",
                );
              areaM2 = Math.PI * (toM(l, lUnit) / 2) * (toM(w, wUnit) / 2);
              formulaUsed =
                "Volume = π × (Length / 2) × (Width / 2) × Average Depth";
            }

            volumeM3 = areaM2 * avgDepthM;
            steps = [
              `Pool Type: ${shape.toUpperCase()} Pool`,
              `Formula: ${formulaUsed}`,
              `Surface Area: ${areaM2.toFixed(3)} m² (${(areaM2 * 10.7639).toFixed(2)} sq ft)`,
              `Average Depth: ${avgDepthM.toFixed(3)} m`,
              `Total Water Volume: ${volumeM3.toFixed(4)} m³ = ${(volumeM3 * 1000).toLocaleString()} Liters`,
              `Approximate Water Weight: ${(volumeM3 * 1000).toLocaleString()} kg (${(volumeM3 * 2204.62).toLocaleString(undefined, { maximumFractionDigits: 0 })} lbs)`,
            ];

            secondaryData = {
              type: "pool",
              surfaceAreaM2: areaM2,
              avgDepthM: avgDepthM,
            };
          } else if (activeMode === "sphere") {
            const dimType = document.querySelector(
              'input[name="sph-dim-type"]:checked',
            )?.value;
            const val = parseFloat(document.getElementById("sph-r")?.value);
            const unit = document.getElementById("sph-r-unit")?.value;

            if (isNaN(val) || val <= 0)
              throw new Error(`Sphere ${dimType} must be greater than zero.`);
            const rawM = toM(val, unit);
            const rM = dimType === "diameter" ? rawM / 2 : rawM;

            volumeM3 = (4.0 / 3.0) * Math.PI * Math.pow(rM, 3);
            const saM2 = 4.0 * Math.PI * Math.pow(rM, 2);
            formulaUsed = "Volume = (4 / 3) × π × Radius³";
            steps = [
              `Formula: V = (4 / 3) × π × Radius³`,
              dimType === "diameter"
                ? `Diameter = ${val} ${unit} → Radius = ${(val / 2).toFixed(4)} ${unit}`
                : `Radius = ${val} ${unit}`,
              `Radius in meters: ${rM.toFixed(5)} m`,
              `Calculation: (4 / 3) × π × (${rM.toFixed(5)})³ = ${volumeM3.toFixed(7)} m³`,
              `Surface Area: ${saM2.toFixed(5)} m²`,
            ];
            secondaryData = { type: "sphere", surfaceAreaM2: saM2 };
          } else if (activeMode === "cone") {
            const dimType = document.querySelector(
              'input[name="cone-dim-type"]:checked',
            )?.value;
            const val = parseFloat(document.getElementById("cone-r")?.value);
            const h = parseFloat(document.getElementById("cone-h")?.value);
            const rUnit = document.getElementById("cone-r-unit")?.value;
            const hUnit = document.getElementById("cone-h-unit")?.value;

            if (isNaN(val) || isNaN(h) || val <= 0 || h <= 0) {
              throw new Error(
                `The cone ${dimType} and height must be positive numbers greater than zero.`,
              );
            }
            const rawM = toM(val, rUnit);
            const rM = dimType === "diameter" ? rawM / 2 : rawM;
            const hM = toM(h, hUnit);

            volumeM3 = (1.0 / 3.0) * Math.PI * Math.pow(rM, 2) * hM;
            const slantH = Math.sqrt(Math.pow(rM, 2) + Math.pow(hM, 2));
            formulaUsed = "Volume = (1 / 3) × π × Radius² × Height";
            steps = [
              `Formula: V = (1 / 3) × π × Radius² × Height`,
              `Radius = ${rM.toFixed(4)} m, Height = ${hM.toFixed(4)} m`,
              `Calculation: (1 / 3) × π × (${rM.toFixed(4)})² × ${hM.toFixed(4)} = ${volumeM3.toFixed(6)} m³`,
              `Slant Height (Pythagoras): ${slantH.toFixed(4)} m`,
            ];
            secondaryData = { type: "cone", slantHeightM: slantH };
          } else if (activeMode === "prostate") {
            const l = parseFloat(document.getElementById("pros-l")?.value);
            const w = parseFloat(document.getElementById("pros-w")?.value);
            const h = parseFloat(document.getElementById("pros-h")?.value);
            const lUnit = document.getElementById("pros-l-unit")?.value;
            const wUnit = document.getElementById("pros-w-unit")?.value;
            const hUnit = document.getElementById("pros-h-unit")?.value;

            if (
              isNaN(l) ||
              isNaN(w) ||
              isNaN(h) ||
              l <= 0 ||
              w <= 0 ||
              h <= 0
            ) {
              throw new Error(
                "All prostate dimensions must be positive numbers greater than zero.",
              );
            }

            const lCm = lUnit === "mm" ? l / 10 : l;
            const wCm = wUnit === "mm" ? w / 10 : w;
            const hCm = hUnit === "mm" ? h / 10 : h;

            const volML = lCm * wCm * hCm * 0.52;
            volumeM3 = volML * 1e-6; // 1 mL = 10⁻⁶ m³
            formulaUsed =
              "Prostate Volume (mL) = Length × Width × Height × 0.52";
            steps = [
              `Formula: Volume = Length × Width × Height × 0.52 (Prolate Ellipsoid Approximation)`,
              `Dimensions in cm: ${lCm.toFixed(2)} cm × ${wCm.toFixed(2)} cm × ${hCm.toFixed(2)} cm`,
              `Calculation: ${lCm.toFixed(2)} × ${wCm.toFixed(2)} × ${hCm.toFixed(2)} × 0.52`,
              `Estimated Prostate Volume = ${volML.toFixed(2)} mL (cc)`,
              `Medical Notice: This calculator provides an estimated volume based on measurements entered by the user and is not a substitute for professional medical interpretation.`,
            ];

            secondaryData = { type: "prostate", volumeML: volML };
          }

          lastResult = { volumeM3, formulaUsed, steps, secondaryData, outUnit };
          renderResults(lastResult);
        } catch (err) {
          if (errEl) {
            errEl.classList.remove("hidden");
            errEl.textContent =
              "❌ " +
              (err && err.message
                ? err.message
                : "Invalid calculation parameters.");
          }
        }
      }

      function renderResults(res) {
        const wrapper = document.getElementById("results-wrapper");
        if (!wrapper) return;
        wrapper.classList.remove("hidden");

        const vM3 = res.volumeM3;
        const targetUnit = res.outUnit || "m3";
        const primaryVal = fromM3(vM3, targetUnit);

        // Hero value and unit
        const heroVal = document.getElementById("hero-volume-val");
        const heroUnit = document.getElementById("hero-volume-unit");
        const heroWaterWeight = document.getElementById("hero-water-weight");

        if (
          activeMode === "prostate" &&
          res.secondaryData?.volumeML !== undefined
        ) {
          if (heroVal)
            heroVal.textContent = res.secondaryData.volumeML.toFixed(2);
          if (heroUnit) heroUnit.textContent = "mL (cc)";
          if (heroWaterWeight)
            heroWaterWeight.textContent =
              "Estimated Prostate Volume (Prolate Ellipsoid Approximation)";
        } else {
          if (heroVal)
            heroVal.textContent = formatNum(
              primaryVal,
              primaryVal > 1000 ? 1 : 3,
            );
          if (heroUnit)
            heroUnit.textContent = V_LABELS[targetUnit] || targetUnit;
          if (heroWaterWeight) {
            const kg = vM3 * 1000;
            const tons = vM3;
            heroWaterWeight.textContent = `Equivalent Pure Water Weight: ${formatNum(kg, 0)} kg (~${formatNum(tons, 2)} Metric Tons)`;
          }
        }

        // Active hero unit buttons
        document.querySelectorAll(".btn-hero-unit").forEach(function (btn) {
          const u = btn.getAttribute("data-unit");
          if (u === targetUnit) {
            btn.className =
              "btn-hero-unit active rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-bold text-white shadow-xs";
          } else {
            btn.className =
              "btn-hero-unit rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200";
          }
        });

        // Equivalents Matrix
        const setVal = function (id, val, dec) {
          const el = document.getElementById(id);
          if (el) el.textContent = formatNum(val, dec);
        };

        setVal("eq-m3", vM3, vM3 < 0.01 ? 5 : 3);
        setVal("eq-liters", vM3 * V_CONV.L, 2);
        setVal("eq-usgal", vM3 * V_CONV.us_gal, 2);
        setVal("eq-impgal", vM3 * V_CONV.imp_gal, 2);
        setVal("eq-ft3", vM3 * V_CONV.ft3, 2);
        setVal("eq-in3", vM3 * V_CONV.in3, 0);
        setVal("eq-ml", vM3 * V_CONV.mL, 0);
        setVal("eq-lbs", vM3 * 1000 * 2.2046226, 0);

        // Secondary Details Box
        const secBox = document.getElementById("secondary-results-box");
        const secTitle = document.getElementById("secondary-title");
        const secItems = document.getElementById("secondary-items");

        if (secBox && secItems) {
          if (res.secondaryData) {
            secBox.classList.remove("hidden");
            let itemsHtml = "";

            if (res.secondaryData.type === "pipe") {
              if (secTitle)
                secTitle.textContent = "Pipe Capacity & Engineering Metrics";
              itemsHtml += `
                <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                  <span class="text-[11px] text-slate-500 block">Linear Meter Capacity:</span>
                  <strong class="text-base text-blue-600 dark:text-blue-400 block">${res.secondaryData.litersPerM.toFixed(3)} L / meter</strong>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                  <span class="text-[11px] text-slate-500 block">Linear Foot Capacity:</span>
                  <strong class="text-base text-blue-600 dark:text-blue-400 block">${res.secondaryData.litersPerFt.toFixed(3)} L / foot</strong>
                </div>
              `;
              if (res.secondaryData.materialVolM3 !== null) {
                itemsHtml += `
                  <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                    <span class="text-[11px] text-slate-500 block">Pipe Material Volume:</span>
                    <strong class="text-base text-slate-900 dark:text-white block">${(res.secondaryData.materialVolM3 * 1000).toFixed(2)} L (${res.secondaryData.materialVolM3.toFixed(4)} m³)</strong>
                  </div>
                `;
              }
            } else if (res.secondaryData.type === "pool") {
              if (secTitle)
                secTitle.textContent = "Pool Surface & Water Mass Metrics";
              itemsHtml += `
                <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                  <span class="text-[11px] text-slate-500 block">Pool Water Surface:</span>
                  <strong class="text-base text-slate-900 dark:text-white block">${res.secondaryData.surfaceAreaM2.toFixed(2)} m² (${(res.secondaryData.surfaceAreaM2 * 10.7639).toFixed(1)} sq ft)</strong>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                  <span class="text-[11px] text-slate-500 block">Average Depth:</span>
                  <strong class="text-base text-blue-600 dark:text-blue-400 block">${res.secondaryData.avgDepthM.toFixed(2)} meters</strong>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                  <span class="text-[11px] text-slate-500 block">Total Pool Mass:</span>
                  <strong class="text-base text-emerald-600 dark:text-emerald-400 block">${(vM3 * 1000).toLocaleString()} kg (~${vM3.toFixed(1)} tons)</strong>
                </div>
              `;
            } else if (res.secondaryData.type === "prostate") {
              if (secTitle)
                secTitle.textContent = "Clinical Measurement Summary";
              itemsHtml += `
                <div class="rounded-2xl border border-purple-200 bg-purple-50 p-3 col-span-3 text-xs text-purple-900 dark:border-purple-900 dark:bg-purple-950/60 dark:text-purple-300">
                  <strong>Non-Diagnostic Disclaimer:</strong> This calculator provides an estimated volume based on measurements entered by the user and is not a substitute for professional medical interpretation. Normal prostate volume in healthy adult men generally ranges between 20 mL and 25 mL, but clinical interpretation must always be performed by a healthcare provider.
                </div>
              `;
            } else if (res.secondaryData.type === "cone") {
              if (secTitle) secTitle.textContent = "Cone Geometry Properties";
              itemsHtml += `
                <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                  <span class="text-[11px] text-slate-500 block">Slant Height (s):</span>
                  <strong class="text-base text-blue-600 dark:text-blue-400 block">${res.secondaryData.slantHeightM.toFixed(3)} m</strong>
                </div>
              `;
            } else if (res.secondaryData.type === "sphere") {
              if (secTitle)
                secTitle.textContent = "Sphere Geometric Properties";
              itemsHtml += `
                <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                  <span class="text-[11px] text-slate-500 block">Total Surface Area (4πr²):</span>
                  <strong class="text-base text-blue-600 dark:text-blue-400 block">${res.secondaryData.surfaceAreaM2.toFixed(3)} m²</strong>
                </div>
              `;
            }

            secItems.innerHTML = itemsHtml;
          } else {
            secBox.classList.add("hidden");
          }
        }

        // Steps list
        const stepsList = document.getElementById("calc-steps-list");
        if (stepsList) {
          stepsList.innerHTML = res.steps
            .map(function (step) {
              return '<li class="leading-relaxed">' + step + "</li>";
            })
            .join("");
        }
      }

      // ─── EVENT HANDLERS & INITIALIZATION ──────────────────────────────────
      function switchMode(newMode) {
        activeMode = newMode;

        // Update top tabs
        document.querySelectorAll(".btn-shape-tab").forEach(function (btn) {
          const m = btn.getAttribute("data-mode");
          if (m === newMode) {
            btn.className =
              "btn-shape-tab active shrink-0 rounded-xl bg-blue-600 px-3.5 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5";
          } else {
            btn.className =
              "btn-shape-tab shrink-0 rounded-xl border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5";
          }
        });

        // Hide all fields, show active
        document.querySelectorAll(".shape-fields").forEach(function (el) {
          el.classList.add("hidden");
        });
        const activeFields = document.getElementById("fields-" + newMode);
        if (activeFields) activeFields.classList.remove("hidden");

        // Update headers & badges
        const modeTitle = document.getElementById("mode-title");
        const modeBadge = document.getElementById("mode-badge");
        const modeDesc = document.getElementById("mode-desc");
        const outPref = document.getElementById("output-unit-pref");

        if (newMode === "rectangular") {
          if (modeTitle)
            modeTitle.innerHTML =
              "<span>📦</span> Rectangular Tank / Box Volume";
          if (modeBadge) modeBadge.textContent = "V = L × W × H";
          if (modeDesc)
            modeDesc.textContent =
              "Calculate the exact internal volume, liquid storage capacity, and water weight of any rectangular container or box.";
          if (outPref) outPref.value = "m3";
        } else if (newMode === "cylinder") {
          if (modeTitle)
            modeTitle.innerHTML = "<span>🛢️</span> Cylindrical Tank / Cylinder";
          if (modeBadge) modeBadge.textContent = "V = π × r² × h";
          if (modeDesc)
            modeDesc.textContent =
              "Calculate vertical and horizontal standing cylindrical tank volume, drum capacity, or silo volume.";
          if (outPref) outPref.value = "m3";
        } else if (newMode === "pipe") {
          if (modeTitle)
            modeTitle.innerHTML = "<span>🚿</span> Pipe Volume &amp; Capacity";
          if (modeBadge) modeBadge.textContent = "V = π × (ID / 2)² × L";
          if (modeDesc)
            modeDesc.textContent =
              "Accurately determine internal fluid capacity and volume per meter/foot. Wall thickness determines material volume.";
          if (outPref) outPref.value = "L";
        } else if (newMode === "pool") {
          if (modeTitle)
            modeTitle.innerHTML = "<span>🏊</span> Swimming Pool Volume";
          if (modeBadge) modeBadge.textContent = "V = Area × Avg Depth";
          if (modeDesc)
            modeDesc.textContent =
              "Calculate water capacity in Liters and US Gallons for rectangular, circular, and oval swimming pools.";
          if (outPref) outPref.value = "L";
        } else if (newMode === "sphere") {
          if (modeTitle) modeTitle.innerHTML = "<span>⚪</span> Sphere Volume";
          if (modeBadge) modeBadge.textContent = "V = (4 / 3) × π × r³";
          if (modeDesc)
            modeDesc.textContent =
              "Compute the 3D spherical capacity and outer surface area from radius or diameter.";
          if (outPref) outPref.value = "cm3";
        } else if (newMode === "cone") {
          if (modeTitle) modeTitle.innerHTML = "<span>📐</span> Cone Volume";
          if (modeBadge) modeBadge.textContent = "V = (1 / 3) × π × r² × h";
          if (modeDesc)
            modeDesc.textContent =
              "Determine conical volume, base circle area, and slant height for cones and hoppers.";
          if (outPref) outPref.value = "m3";
        } else if (newMode === "prostate") {
          if (modeTitle)
            modeTitle.innerHTML =
              "<span>🩺</span> Prostate Volume Estimation (Medical)";
          if (modeBadge) modeBadge.textContent = "V = L × W × H × 0.52";
          if (modeDesc)
            modeDesc.textContent =
              "Estimated volume in mL/cc using the standard urological prolate ellipsoid formula (non-diagnostic informational tool).";
          if (outPref) outPref.value = "cm3";
        }

        updateSvgVisualizer();
        // Hide previous results until user clicks Calculate
        const wrapper = document.getElementById("results-wrapper");
        if (wrapper) wrapper.classList.add("hidden");
      }

      function initEventListeners() {
        // Mode tab buttons
        document.querySelectorAll(".btn-shape-tab").forEach(function (btn) {
          btn.addEventListener("click", function () {
            const m = btn.getAttribute("data-mode");
            if (m) switchMode(m);
          });
        });

        // Live inputs listener for dynamic SVG
        document
          .getElementById("volume-form")
          ?.addEventListener("input", function () {
            updateSvgVisualizer();
            if (lastResult) {
              executeVolumeCalculation();
            }
          });

        // Radio changes
        document
          .querySelectorAll('input[type="radio"]')
          .forEach(function (radio) {
            radio.addEventListener("change", function () {
              // Pipe radio toggle
              if (radio.name === "pipe-mode") {
                const isInner = radio.value === "inner_diameter";
                document
                  .getElementById("pipe-box-inner")
                  ?.classList.toggle("hidden", !isInner);
                document
                  .getElementById("pipe-box-outer")
                  ?.classList.toggle("hidden", isInner);
              }
              // Pool shape toggle
              if (radio.name === "pool-shape") {
                const isCirc = radio.value === "circular";
                document
                  .getElementById("pool-box-linear")
                  ?.classList.toggle("hidden", isCirc);
                document
                  .getElementById("pool-box-circular")
                  ?.classList.toggle("hidden", !isCirc);
              }
              // Pool depth toggle
              if (radio.name === "pool-depth-mode") {
                const isAvg = radio.value === "average";
                document
                  .getElementById("pool-box-depth-avg")
                  ?.classList.toggle("hidden", !isAvg);
                document
                  .getElementById("pool-box-depth-slope")
                  ?.classList.toggle("hidden", isAvg);
              }
              updateSvgVisualizer();
              if (lastResult) executeVolumeCalculation();
            });
          });

        // Calculate button
        document
          .getElementById("btn-calculate")
          ?.addEventListener("click", function () {
            executeVolumeCalculation();
            requestAnimationFrame(function () {
              const heroCard = document.getElementById("hero-volume-card");
              if (!heroCard) return;

              const rect = heroCard.getBoundingClientRect();
              // If the top of the hero result card is already comfortably in view, do not scroll
              if (rect.top >= 70 && rect.top <= window.innerHeight * 0.45) {
                return;
              }

              // Cleanly scroll directly to the top of the hero result card
              const headerOffset = 80;
              const targetY = window.pageYOffset + rect.top - headerOffset;
              window.scrollTo({
                top: Math.max(0, targetY),
                behavior: "smooth"
              });
            });
          });

        // Reset button
        document
          .getElementById("btn-reset")
          ?.addEventListener("click", function () {
            document.getElementById("volume-form")?.reset();
            const resWrap = document.getElementById("results-wrapper");
            if (resWrap) resWrap.classList.add("hidden");
            lastResult = null;
            updateSvgVisualizer();
          });

        // Hero quick unit switch buttons
        document.querySelectorAll(".btn-hero-unit").forEach(function (btn) {
          btn.addEventListener("click", function () {
            const u = btn.getAttribute("data-unit");
            const outPref = document.getElementById("output-unit-pref");
            if (outPref && u) {
              outPref.value = u;
              if (lastResult) {
                lastResult.outUnit = u;
                renderResults(lastResult);
              }
            }
          });
        });

        // Quick Presets buttons
        document.querySelectorAll(".btn-preset").forEach(function (btn) {
          btn.addEventListener("click", function () {
            const preset = btn.getAttribute("data-preset");
            if (preset === "rect_tank") {
              switchMode("rectangular");
              document.getElementById("rect-l").value = 5;
              document.getElementById("rect-l-unit").value = "m";
              document.getElementById("rect-w").value = 2;
              document.getElementById("rect-w-unit").value = "m";
              document.getElementById("rect-h").value = 1.5;
              document.getElementById("rect-h-unit").value = "m";
              document.getElementById("output-unit-pref").value = "L";
            } else if (preset === "cylinder_silo") {
              switchMode("cylinder");
              document.querySelector(
                'input[name="cyl-dim-type"][value="radius"]',
              ).checked = true;
              document.getElementById("cyl-r").value = 2;
              document.getElementById("cyl-r-unit").value = "m";
              document.getElementById("cyl-h").value = 5;
              document.getElementById("cyl-h-unit").value = "m";
              document.getElementById("output-unit-pref").value = "m3";
            } else if (preset === "pipe_100mm") {
              switchMode("pipe");
              document.querySelector(
                'input[name="pipe-mode"][value="inner_diameter"]',
              ).checked = true;
              document
                .getElementById("pipe-box-inner")
                .classList.remove("hidden");
              document.getElementById("pipe-box-outer").classList.add("hidden");
              document.getElementById("pipe-id").value = 100;
              document.getElementById("pipe-id-unit").value = "mm";
              document.getElementById("pipe-len").value = 10;
              document.getElementById("pipe-len-unit").value = "m";
              document.getElementById("output-unit-pref").value = "L";
            } else if (preset === "pool_10x5") {
              switchMode("pool");
              document.querySelector(
                'input[name="pool-shape"][value="rectangular"]',
              ).checked = true;
              document
                .getElementById("pool-box-linear")
                .classList.remove("hidden");
              document
                .getElementById("pool-box-circular")
                .classList.add("hidden");
              document.querySelector(
                'input[name="pool-depth-mode"][value="average"]',
              ).checked = true;
              document
                .getElementById("pool-box-depth-avg")
                .classList.remove("hidden");
              document
                .getElementById("pool-box-depth-slope")
                .classList.add("hidden");
              document.getElementById("pool-l").value = 10;
              document.getElementById("pool-l-unit").value = "m";
              document.getElementById("pool-w").value = 5;
              document.getElementById("pool-w-unit").value = "m";
              document.getElementById("pool-depth-single").value = 2;
              document.getElementById("pool-depth-single-unit").value = "m";
              document.getElementById("output-unit-pref").value = "L";
            } else if (preset === "sphere_5cm") {
              switchMode("sphere");
              document.querySelector(
                'input[name="sph-dim-type"][value="radius"]',
              ).checked = true;
              document.getElementById("sph-r").value = 5;
              document.getElementById("sph-r-unit").value = "cm";
              document.getElementById("output-unit-pref").value = "cm3";
            } else if (preset === "cone_3x6") {
              switchMode("cone");
              document.querySelector(
                'input[name="cone-dim-type"][value="radius"]',
              ).checked = true;
              document.getElementById("cone-r").value = 3;
              document.getElementById("cone-r-unit").value = "m";
              document.getElementById("cone-h").value = 6;
              document.getElementById("cone-h-unit").value = "m";
              document.getElementById("output-unit-pref").value = "m3";
            } else if (preset === "prostate_sample") {
              switchMode("prostate");
              document.getElementById("pros-l").value = 4.0;
              document.getElementById("pros-l-unit").value = "cm";
              document.getElementById("pros-w").value = 3.0;
              document.getElementById("pros-w-unit").value = "cm";
              document.getElementById("pros-h").value = 4.0;
              document.getElementById("pros-h-unit").value = "cm";
              document.getElementById("output-unit-pref").value = "cm3";
            }
            updateSvgVisualizer();
            executeVolumeCalculation();
          });
        });

        // Initialize SVG and Initial Calculation
        updateSvgVisualizer();
        executeVolumeCalculation();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initEventListeners);
      } else {
        initEventListeners();
      }
    })();
  </script>

