  <!-- CLIENT-SIDE ENGINE & DYNAMIC VISUALIZER SCRIPT -->
  <script is:inline>
    (function () {
      // SI and volume conversions table
      const L_CONV = { mm: 0.001, cm: 0.01, m: 1.0, in: 0.0254, ft: 0.3048 };
      const V_CONV = {
        m3: 1.0,
        L: 1000.0,
        mL: 1000000.0,
        cm3: 1000000.0,
        mm3: 1000000000.0,
        us_gal: 1.0 / 0.003785411784,
        imp_gal: 1.0 / 0.00454609,
        ft3: 1.0 / 0.028316846592,
        in3: 1.0 / 0.000016387064,
      };
      const V_LABELS = {
        m3: "Cubic Meters (m³)",
        L: "Liters (L)",
        mL: "Milliliters (mL)",
        cm3: "Cubic Centimeters (cm³)",
        mm3: "Cubic Millimeters (mm³)",
        us_gal: "US Gallons (gal)",
        imp_gal: "Imperial Gallons (UK)",
        ft3: "Cubic Feet (ft³)",
        in3: "Cubic Inches (in³)",
      };

      let activeMode = "rectangular";
      let lastResult = null;

      function toM(val, unit) {
        return (parseFloat(val) || 0) * (L_CONV[unit] || 1);
      }

      function fromM3(m3, unit) {
        return m3 * (V_CONV[unit] || 1);
      }

      function formatNum(num, maxDec) {
        if (num === 0) return "0";
        if (Math.abs(num) < 0.001) return num.toExponential(3);
        return num.toLocaleString("en-US", {
          maximumFractionDigits: maxDec !== undefined ? maxDec : 3,
        });
      }

      // ─── SVG DRAWING ENGINES ───────────────────────────────────────────────
      function updateSvgVisualizer() {
        const svg = document.getElementById("shape-svg");
        const legend = document.getElementById("svg-dimension-legend");
        if (!svg) return;

        let svgHtml = "";
        let legendHtml = "";

        if (activeMode === "rectangular") {
          const l = parseFloat(document.getElementById("rect-l")?.value) || 5;
          const w = parseFloat(document.getElementById("rect-w")?.value) || 2;
          const h = parseFloat(document.getElementById("rect-h")?.value) || 1.5;
          const lUnit = document.getElementById("rect-l-unit")?.value || "m";
          const wUnit = document.getElementById("rect-w-unit")?.value || "m";
          const hUnit = document.getElementById("rect-h-unit")?.value || "m";

          // Proportional isometric projection
          const maxDim = Math.max(l, w, h, 0.1);
          const sL = 120 * Math.max(0.3, Math.min(1.4, l / maxDim));
          const sW = 60 * Math.max(0.3, Math.min(1.2, w / maxDim));
          const sH = 90 * Math.max(0.3, Math.min(1.3, h / maxDim));

          const originX = 170 - sL / 2 + sW / 4;
          const originY = 130 + sH / 4;

          const p0 = [originX, originY];
          const p1 = [originX + sL, originY];
          const p2 = [originX + sL, originY - sH];
          const p3 = [originX, originY - sH];

          const p4 = [originX + sW * 0.7, originY - sW * 0.4];
          const p5 = [originX + sL + sW * 0.7, originY - sW * 0.4];
          const p6 = [originX + sL + sW * 0.7, originY - sH - sW * 0.4];
          const p7 = [originX + sW * 0.7, originY - sH - sW * 0.4];

          svgHtml = `
            <defs>
              <linearGradient id="gradFront" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.85"/>
                <stop offset="100%" stop-color="#1d4ed8" stop-opacity="0.95"/>
              </linearGradient>
              <linearGradient id="gradTop" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#93c5fd" stop-opacity="0.9"/>
              </linearGradient>
              <linearGradient id="gradSide" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#2563eb" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#1e40af" stop-opacity="0.95"/>
              </linearGradient>
            </defs>
            <!-- Top Face -->
            <polygon points="${p3[0]},${p3[1]} ${p2[0]},${p2[1]} ${p6[0]},${p6[1]} ${p7[0]},${p7[1]}" fill="url(#gradTop)" stroke="#1e3a8a" stroke-width="1.5"/>
            <!-- Right Face -->
            <polygon points="${p1[0]},${p1[1]} ${p5[0]},${p5[1]} ${p6[0]},${p6[1]} ${p2[0]},${p2[1]}" fill="url(#gradSide)" stroke="#1e3a8a" stroke-width="1.5"/>
            <!-- Front Face -->
            <polygon points="${p0[0]},${p0[1]} ${p1[0]},${p1[1]} ${p2[0]},${p2[1]} ${p3[0]},${p3[1]}" fill="url(#gradFront)" stroke="#1e3a8a" stroke-width="1.5"/>
            <!-- Front Length Label -->
            <line x1="${p0[0]}" y1="${p0[1] + 12}" x2="${p1[0]}" y2="${p1[1] + 12}" stroke="#0284c7" stroke-width="2" marker-start="url(#dot)" marker-end="url(#dot)"/>
            <text x="${(p0[0] + p1[0]) / 2}" y="${p0[1] + 26}" text-anchor="middle" font-size="11" font-weight="bold" fill="#0369a1">L: ${l} ${lUnit}</text>
            <!-- Height Label -->
            <line x1="${p0[0] - 12}" y1="${p0[1]}" x2="${p3[0] - 12}" y2="${p3[1]}" stroke="#0284c7" stroke-width="2"/>
