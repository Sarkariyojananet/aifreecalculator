            <!-- Body -->
            <path d="M ${cx - rx} ${topY} L ${cx - rx} ${botY} A ${rx} ${ry} 0 0 0 ${cx + rx} ${botY} L ${cx + rx} ${topY} Z" fill="url(#gradCyl)" stroke="#1e3a8a" stroke-width="1.5"/>
            <!-- Bottom Ellipse base outline -->
            <path d="M ${cx - rx} ${botY} A ${rx} ${ry} 0 0 1 ${cx + rx} ${botY}" fill="none" stroke="#60a5fa" stroke-dasharray="3 3"/>
            <!-- Top Ellipse (Cap) -->
            <ellipse cx="${cx}" cy="${topY}" rx="${rx}" ry="${ry}" fill="#93c5fd" stroke="#1e3a8a" stroke-width="1.5"/>
            <!-- Center Radius indicator -->
