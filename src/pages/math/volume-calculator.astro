            <path d="M 80 82 L 260 82 A 13 25 0 0 1 260 128 L 80 128 A 13 25 0 0 1 80 82 Z" fill="url(#waterFlow)" opacity="0.9"/>
            <!-- Near end face with wall ring -->
            <ellipse cx="80" cy="105" rx="20" ry="38" fill="#64748b" stroke="#0f172a" stroke-width="1.5"/>
            <ellipse cx="80" cy="105" rx="14" ry="26" fill="#0284c7" stroke="#0369a1" stroke-width="1.5"/>
            <!-- Labels -->
