<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  function gcd(a, b) {
    let x = Math.abs(a);
    let y = Math.abs(b);
    while (y) { const t = y; y = x % y; x = t; }
    return x || 1;
  }

  function lcm(a, b) {
    return Math.abs(a * b) / gcd(a, b);
  }

  function simplify(num, den) {
    if (den === 0) return { num: 0, den: 1, err: 'Denominator cannot be zero.' };
    const divisor = gcd(num, den);
    let sNum = num / divisor;
    let sDen = den / divisor;
    if (sDen < 0) { sNum = -sNum; sDen = -sDen; }
    return { num: sNum, den: sDen };
  }

  // Tab Navigation
  const tabButtons = document.querySelectorAll('.btn-frac-tab');
  const fracPanels = document.querySelectorAll('.frac-panel');

  function switchTab(tabId) {
    tabButtons.forEach((btn) => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.className = 'btn-frac-tab active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-frac-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    fracPanels.forEach((panel) => {
      if (panel.id === `panel-${tabId}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab')));
  });

  // ==========================================
  // 1. BASIC FRACTION CALCULATOR
  // ==========================================
  const basicN1 = document.getElementById('basic-n1');
  const basicD1 = document.getElementById('basic-d1');
  const basicOp = document.getElementById('basic-op');
  const basicN2 = document.getElementById('basic-n2');
  const basicD2 = document.getElementById('basic-d2');
  const btnBasicCalc = document.getElementById('btn-basic-calc');
  const btnBasicClear = document.getElementById('btn-basic-clear');
  const errBasic = document.getElementById('err-basic');
  const resBasicCard = document.getElementById('res-basic-card');
  const resBasicSimp = document.getElementById('res-basic-simp');
  const resBasicMixed = document.getElementById('res-basic-mixed');
  const resBasicDec = document.getElementById('res-basic-dec');
  const resBasicPct = document.getElementById('res-basic-pct');
  const resBasicSteps = document.getElementById('res-basic-steps');

  function calculateBasic() {
    errBasic.classList.add('hidden');
    const a = parseInt(basicN1.value);
    const b = parseInt(basicD1.value);
    const c = parseInt(basicN2.value);
    const d = parseInt(basicD2.value);
    const op = basicOp.value;

    if (isNaN(a) || isNaN(b) || isNaN(c) || isNaN(d)) {
      errBasic.textContent = 'Please enter valid integer numbers for all fraction fields.';
      errBasic.classList.remove('hidden');
      return;
    }
    if (b === 0 || d === 0) {
      errBasic.textContent = 'Denominator cannot be zero.';
      errBasic.classList.remove('hidden');
      return;
    }
    if (op === '/' && c === 0) {
      errBasic.textContent = 'Division by zero fraction is not allowed.';
      errBasic.classList.remove('hidden');
      return;
    }

    let rawNum = 0;
    let rawDen = 1;
    const steps = [];

    if (op === '+' || op === '-') {
      const commonDen = lcm(b, d);
      const m1 = commonDen / b;
      const m2 = commonDen / d;
      const adj1 = a * m1;
      const adj2 = c * m2;
      steps.push(`• Find Least Common Denominator: LCD(${b}, ${d}) = ${commonDen}`);
      steps.push(`• Convert fractions: ${a}/${b} = ${adj1}/${commonDen},  ${c}/${d} = ${adj2}/${commonDen}`);
      if (op === '+') {
        rawNum = adj1 + adj2;
        steps.push(`• Add numerators: ${adj1} + ${adj2} = ${rawNum}`);
      } else {
        rawNum = adj1 - adj2;
        steps.push(`• Subtract numerators: ${adj1} - ${adj2} = ${rawNum}`);
      }
      rawDen = commonDen;
    } else if (op === '*') {
      rawNum = a * c;
      rawDen = b * d;
      steps.push(`• Multiply numerators: ${a} × ${c} = ${rawNum}`);
      steps.push(`• Multiply denominators: ${b} × ${d} = ${rawDen}`);
    } else if (op === '/') {
      rawNum = a * d;
      rawDen = b * c;
      steps.push(`• Multiply by reciprocal: (${a}/${b}) × (${d}/${c})`);
      steps.push(`• Numerator = ${a} × ${d} = ${rawNum}, Denominator = ${b} × ${c} = ${rawDen}`);
    }

    const simp = simplify(rawNum, rawDen);
    const div = gcd(rawNum, rawDen);
    if (div > 1) {
      steps.push(`• Simplify by GCD (${div}): ${simp.num}/${simp.den}`);
    }

    const simpStr = simp.den === 1 ? `${simp.num}` : `${simp.num}/${simp.den}`;
    const absNum = Math.abs(simp.num);
    const whole = Math.floor(absNum / simp.den) * (simp.num < 0 ? -1 : 1);
    const rem = absNum % simp.den;
    const mixedStr = (absNum > simp.den && rem !== 0) ? `${whole < 0 ? '-' : ''}${Math.abs(whole)} ${rem}/${simp.den}` : simpStr;
    const decVal = (simp.num / simp.den).toFixed(4).replace(/\.?0+$/, '');

    resBasicSimp.textContent = simpStr;
    resBasicMixed.textContent = mixedStr;
    resBasicDec.textContent = decVal;
    resBasicPct.textContent = `${(parseFloat(decVal) * 100).toFixed(2)}%`;

    resBasicSteps.innerHTML = steps.map((s) => `<div>${s}</div>`).join('');
    resBasicCard.classList.remove('hidden');
  }

  btnBasicCalc.addEventListener('click', calculateBasic);

  btnBasicClear.addEventListener('click', () => {
    basicN1.value = '1';
    basicD1.value = '2';
    basicOp.value = '+';
    basicN2.value = '3';
    basicD2.value = '4';
    errBasic.classList.add('hidden');
    resBasicCard.classList.add('hidden');
  });

  // ==========================================
  // 2. MIXED FRACTIONS
  // ==========================================
  const mixedW1 = document.getElementById('mixed-w1');
  const mixedN1 = document.getElementById('mixed-n1');
  const mixedD1 = document.getElementById('mixed-d1');
  const mixedOp = document.getElementById('mixed-op');
  const mixedW2 = document.getElementById('mixed-w2');
  const mixedN2 = document.getElementById('mixed-n2');
  const mixedD2 = document.getElementById('mixed-d2');
  const btnMixedCalc = document.getElementById('btn-mixed-calc');
  const btnMixedClear = document.getElementById('btn-mixed-clear');
  const errMixed = document.getElementById('err-mixed');
  const resMixedCard = document.getElementById('res-mixed-card');
  const resMixedOut = document.getElementById('res-mixed-out');
  const resMixedImproper = document.getElementById('res-mixed-improper');
  const resMixedDec = document.getElementById('res-mixed-dec');
  const resMixedSteps = document.getElementById('res-mixed-steps');

  function calculateMixed() {
    errMixed.classList.add('hidden');
    const w1 = parseInt(mixedW1.value) || 0;
    const n1 = parseInt(mixedN1.value) || 0;
    const d1 = parseInt(mixedD1.value) || 1;
    const op = mixedOp.value;
    const w2 = parseInt(mixedW2.value) || 0;
    const n2 = parseInt(mixedN2.value) || 0;
    const d2 = parseInt(mixedD2.value) || 1;

    if (d1 === 0 || d2 === 0) {
      errMixed.textContent = 'Denominator cannot be zero.';
      errMixed.classList.remove('hidden');
      return;
    }

    const imp1Num = (w1 < 0 ? -1 : 1) * (Math.abs(w1) * d1 + n1);
    const imp2Num = (w2 < 0 ? -1 : 1) * (Math.abs(w2) * d2 + n2);

    let rawNum = 0;
    let rawDen = 1;
    const steps = [
      `• Convert Mixed 1: ${w1 !== 0 ? w1 + ' ' : ''}${n1}/${d1} ➔ ${imp1Num}/${d1}`,
      `• Convert Mixed 2: ${w2 !== 0 ? w2 + ' ' : ''}${n2}/${d2} ➔ ${imp2Num}/${d2}`
    ];

    if (op === '+' || op === '-') {
      const commonDen = lcm(d1, d2);
      const adj1 = imp1Num * (commonDen / d1);
      const adj2 = imp2Num * (commonDen / d2);
      rawNum = op === '+' ? adj1 + adj2 : adj1 - adj2;
      rawDen = commonDen;
      steps.push(`• Common Denominator LCD(${d1}, ${d2}) = ${commonDen}`);
      steps.push(`• Calculate: ${adj1}/${commonDen} ${op} ${adj2}/${commonDen} = ${rawNum}/${rawDen}`);
    } else if (op === '*') {
      rawNum = imp1Num * imp2Num;
      rawDen = d1 * d2;
      steps.push(`• Multiply numerators and denominators: ${rawNum}/${rawDen}`);
    } else if (op === '/') {
      if (imp2Num === 0) {
        errMixed.textContent = 'Cannot divide by zero.';
        errMixed.classList.remove('hidden');
        return;
      }
      rawNum = imp1Num * d2;
      rawDen = d1 * imp2Num;
      steps.push(`• Multiply by reciprocal: (${imp1Num}/${d1}) × (${d2}/${imp2Num}) = ${rawNum}/${rawDen}`);
    }

    const simp = simplify(rawNum, rawDen);
    const impStr = simp.den === 1 ? `${simp.num}` : `${simp.num}/${simp.den}`;
    const absNum = Math.abs(simp.num);
    const whole = Math.floor(absNum / simp.den) * (simp.num < 0 ? -1 : 1);
    const rem = absNum % simp.den;
    const mixedStr = (absNum > simp.den && rem !== 0) ? `${whole < 0 ? '-' : ''}${Math.abs(whole)} ${rem}/${simp.den}` : impStr;
    const decVal = (simp.num / simp.den).toFixed(4).replace(/\.?0+$/, '');

    resMixedOut.textContent = mixedStr;
    resMixedImproper.textContent = impStr;
    resMixedDec.textContent = decVal;
    resMixedSteps.innerHTML = steps.map((s) => `<div>${s}</div>`).join('');
    resMixedCard.classList.remove('hidden');
  }

  btnMixedCalc.addEventListener('click', calculateMixed);

  btnMixedClear.addEventListener('click', () => {
    mixedW1.value = '2';
    mixedN1.value = '1';
    mixedD1.value = '3';
    mixedOp.value = '+';
    mixedW2.value = '1';
    mixedN2.value = '3';
    mixedD2.value = '4';
    errMixed.classList.add('hidden');
    resMixedCard.classList.add('hidden');
  });

  // ==========================================
  // 3. DECIMAL TO FRACTION
  // ==========================================
  const decInput = document.getElementById('dec-input');
  const decMaxDen = document.getElementById('dec-max-den');
  const btnDecCalc = document.getElementById('btn-dec-calc');
  const btnDecClear = document.getElementById('btn-dec-clear');
  const errDec = document.getElementById('err-dec');
  const resDecCard = document.getElementById('res-dec-card');
  const resDecFrac = document.getElementById('res-dec-frac');
  const resDecMixed = document.getElementById('res-dec-mixed');
  const resDecSteps = document.getElementById('res-dec-steps');

  function calculateDecimal() {
    errDec.classList.add('hidden');
    const str = decInput.value.trim();
    const val = parseFloat(str);

    if (isNaN(val)) {
      errDec.textContent = 'Please enter a valid decimal number.';
      errDec.classList.remove('hidden');
      return;
    }

    const dotIdx = str.indexOf('.');
    let num = 0;
    let den = 1;
    const steps = [];

    if (dotIdx !== -1) {
      const decPlaces = str.length - dotIdx - 1;
      den = Math.pow(10, decPlaces);
      num = Math.round(val * den);
      steps.push(`• Number has ${decPlaces} decimal places ➔ ${val} = ${num}/${den}`);
      const simp = simplify(num, den);
      steps.push(`• Divide by GCD (${gcd(num, den)}): ${simp.num}/${simp.den}`);
      num = simp.num;
      den = simp.den;
    } else {
      num = val;
      den = 1;
    }

    const fracStr = den === 1 ? `${num}` : `${num}/${den}`;
    const absNum = Math.abs(num);
    const whole = Math.floor(absNum / den) * (num < 0 ? -1 : 1);
    const rem = absNum % den;
    const mixedStr = (absNum > den && rem !== 0) ? `${whole < 0 ? '-' : ''}${Math.abs(whole)} ${rem}/${den}` : fracStr;

    resDecFrac.textContent = fracStr;
    resDecMixed.textContent = `Mixed Number: ${mixedStr}`;
    resDecSteps.innerHTML = steps.map((s) => `<div>${s}</div>`).join('');
    resDecCard.classList.remove('hidden');
  }

  btnDecCalc.addEventListener('click', calculateDecimal);

  btnDecClear.addEventListener('click', () => {
    decInput.value = '0.75';
    errDec.classList.add('hidden');
    resDecCard.classList.add('hidden');
  });

  // ==========================================
  // 4. FRACTION SIMPLIFIER
  // ==========================================
  const simpNum = document.getElementById('simp-num');
  const simpDen = document.getElementById('simp-den');
  const btnSimpCalc = document.getElementById('btn-simp-calc');
  const btnSimpClear = document.getElementById('btn-simp-clear');
  const errSimp = document.getElementById('err-simp');
  const resSimpCard = document.getElementById('res-simp-card');
  const resSimpOut = document.getElementById('res-simp-out');
  const resSimpGcd = document.getElementById('res-simp-gcd');
  const resSimpSteps = document.getElementById('res-simp-steps');

  function calculateSimplifier() {
    errSimp.classList.add('hidden');
    const n = parseInt(simpNum.value);
    const d = parseInt(simpDen.value);

    if (isNaN(n) || isNaN(d)) {
      errSimp.textContent = 'Please enter valid numerator and denominator integers.';
      errSimp.classList.remove('hidden');
      return;
    }
    if (d === 0) {
      errSimp.textContent = 'Denominator cannot be zero.';
      errSimp.classList.remove('hidden');
      return;
    }

    const g = gcd(n, d);
    const simp = simplify(n, d);
    const outStr = simp.den === 1 ? `${simp.num}` : `${simp.num}/${simp.den}`;

    resSimpOut.textContent = outStr;
    resSimpGcd.textContent = g;
    resSimpSteps.innerHTML = `
      <div>• Original Fraction: ${n}/${d}</div>
      <div>• Greatest Common Divisor (GCD): ${g}</div>
      <div>• (${n} ÷ ${g}) / (${d} ÷ ${g}) = <strong>${outStr}</strong></div>
    `;
    resSimpCard.classList.remove('hidden');
  }

  btnSimpCalc.addEventListener('click', calculateSimplifier);

  btnSimpClear.addEventListener('click', () => {
    simpNum.value = '24';
    simpDen.value = '36';
    errSimp.classList.add('hidden');
    resSimpCard.classList.add('hidden');
  });

  // ==========================================
  // 5. PARTIAL FRACTIONS
  // ==========================================
  const partialNum = document.getElementById('partial-num');
  const partialDen = document.getElementById('partial-den');
  const btnPartialCalc = document.getElementById('btn-partial-calc');
  const btnPartialClear = document.getElementById('btn-partial-clear');
  const errPartial = document.getElementById('err-partial');
  const resPartialCard = document.getElementById('res-partial-card');
  const resPartialOut = document.getElementById('res-partial-out');
  const resPartialSteps = document.getElementById('res-partial-steps');

  function calculatePartial() {
    errPartial.classList.add('hidden');
    const numStr = partialNum.value.trim();
    const denStr = partialDen.value.trim();

    if (!numStr || !denStr) {
      errPartial.textContent = 'Please enter numerator and denominator expressions.';
      errPartial.classList.remove('hidden');
      return;
    }

    // Match (x - a)(x + b)
    const match = denStr.match(/\(\s*x\s*([+-]\s*\d+)\s*\)\s*\(\s*x\s*([+-]\s*\d+)\s*\)/i);
    if (match) {
      const r1 = -parseFloat(match[1].replace(/\s+/g, ''));
      const r2 = -parseFloat(match[2].replace(/\s+/g, ''));

      const numMatch = numStr.match(/([+-]?\s*\d*)\s*x\s*([+-]\s*\d+)?/i);
      let nA = 0, nB = 0;
      if (numMatch) {
        const aStr = numMatch[1].replace(/\s+/g, '');
        nA = aStr === '' || aStr === '+' ? 1 : aStr === '-' ? -1 : parseFloat(aStr) || 0;
        if (numMatch[2]) nB = parseFloat(numMatch[2].replace(/\s+/g, '')) || 0;
      } else {
        nB = parseFloat(numStr) || 0;
      }

      const evalAt = (x) => nA * x + nB;
      const valA = evalAt(r1) / (r1 - r2);
      const valB = evalAt(r2) / (r2 - r1);

      const t1 = r1 >= 0 ? `(x - ${r1})` : `(x + ${Math.abs(r1)})`;
      const t2 = r2 >= 0 ? `(x - ${r2})` : `(x + ${Math.abs(r2)})`;

      const formatV = (v) => {
        if (Number.isInteger(v)) return String(v);
        const s = simplify(Math.round(v * 100), 100);
        return `${s.num}/${s.den}`;
      };

      const outStr = `${formatV(valA)} / ${t1} + ${formatV(valB)} / ${t2}`;
      resPartialOut.textContent = outStr;
      resPartialSteps.innerHTML = `
        <div>• Set up decomposition: A / ${t1} + B / ${t2}</div>
        <div>• P(x) = A ${t2} + B ${t1}</div>
        <div>• Cover-up at x = ${r1}: P(${r1}) = ${evalAt(r1)} ➔ A = ${formatV(valA)}</div>
        <div>• Cover-up at x = ${r2}: P(${r2}) = ${evalAt(r2)} ➔ B = ${formatV(valB)}</div>
        <div class="font-bold text-slate-900 dark:text-white pt-1">👉 Result: ${outStr}</div>
      `;
      resPartialCard.classList.remove('hidden');
    } else {
      resPartialOut.textContent = `A / (Factor 1) + B / (Factor 2)`;
      resPartialSteps.innerHTML = `
        <div>• Given: (${numStr}) / (${denStr})</div>
        <div>• Factor denominator completely into linear or quadratic factors.</div>
        <div>• Equate coefficients to solve for partial fraction constants.</div>
      `;
      resPartialCard.classList.remove('hidden');
    }
  }

  btnPartialCalc.addEventListener('click', calculatePartial);

  btnPartialClear.addEventListener('click', () => {
    partialNum.value = '3x + 5';
    partialDen.value = '(x - 1)(x + 2)';
    errPartial.classList.add('hidden');
    resPartialCard.classList.add('hidden');
  });

  // ==========================================
  // 6. EXPRESSION PARSER
  // ==========================================
  const exprInput = document.getElementById('expr-input');
  const btnExprCalc = document.getElementById('btn-expr-calc');
  const btnExprClear = document.getElementById('btn-expr-clear');
  const errExpr = document.getElementById('err-expr');
  const resExprCard = document.getElementById('res-expr-card');
  const resExprVal = document.getElementById('res-expr-val');
  const resExprMixed = document.getElementById('res-expr-mixed');
  const resExprDec = document.getElementById('res-expr-dec');
  const resExprPct = document.getElementById('res-expr-pct');

  function calculateExpression() {
    errExpr.classList.add('hidden');
    const raw = exprInput.value.trim();
    if (!raw) {
      errExpr.textContent = 'Please enter an expression.';
      errExpr.classList.remove('hidden');
      return;
    }

    try {
      // Safe recursive descent token parser
      const clean = raw.replace(/\s+/g, ' ');
      const tokens = [];
      let i = 0;
      while (i < clean.length) {
        const ch = clean[i];
        if (ch === ' ') { i++; continue; }
        if ('+-*/()'.includes(ch)) { tokens.push(ch); i++; }
        else if (/\d/.test(ch)) {
          let s = '';
          while (i < clean.length && /\d/.test(clean[i])) { s += clean[i]; i++; }
          tokens.push(s);
        } else {
          throw new Error(`Invalid character: ${ch}`);
        }
      }

      let pos = 0;
      function parsePrimary() {
        const t = tokens[pos];
        if (t === '(') {
          pos++;
          const val = parseAddSub();
          if (tokens[pos] !== ')') throw new Error('Missing closing parenthesis');
          pos++;
          return val;
        }
        if (t && /^\d+$/.test(t)) {
          pos++;
          return { num: parseInt(t), den: 1 };
        }
        throw new Error('Unexpected syntax in expression');
      }

      function parseMulDiv() {
        let left = parsePrimary();
        while (tokens[pos] === '*' || tokens[pos] === '/') {
          const op = tokens[pos++];
          const right = parsePrimary();
          if (op === '*') {
            left = simplify(left.num * right.num, left.den * right.den);
          } else {
            if (right.num === 0) throw new Error('Division by zero');
            left = simplify(left.num * right.den, left.den * right.num);
          }
        }
        return left;
      }

      function parseAddSub() {
        let left = parseMulDiv();
        while (tokens[pos] === '+' || tokens[pos] === '-') {
          const op = tokens[pos++];
          const right = parseMulDiv();
          const common = lcm(left.den, right.den);
          const n1 = left.num * (common / left.den);
          const n2 = right.num * (common / right.den);
          const finalN = op === '+' ? n1 + n2 : n1 - n2;
          left = simplify(finalN, common);
        }
        return left;
      }

      const res = parseAddSub();
      const fracStr = res.den === 1 ? `${res.num}` : `${res.num}/${res.den}`;
      const absNum = Math.abs(res.num);
      const whole = Math.floor(absNum / res.den) * (res.num < 0 ? -1 : 1);
      const rem = absNum % res.den;
      const mixedStr = (absNum > res.den && rem !== 0) ? `${whole < 0 ? '-' : ''}${Math.abs(whole)} ${rem}/${res.den}` : fracStr;
      const decVal = (res.num / res.den).toFixed(4).replace(/\.?0+$/, '');

      resExprVal.textContent = fracStr;
      resExprMixed.textContent = mixedStr;
      resExprDec.textContent = decVal;
      resExprPct.textContent = `${(parseFloat(decVal) * 100).toFixed(2)}%`;
      resExprCard.classList.remove('hidden');
    } catch (e) {
      errExpr.textContent = e.message || 'Invalid fraction expression.';
      errExpr.classList.remove('hidden');
    }
  }

  btnExprCalc.addEventListener('click', calculateExpression);

  btnExprClear.addEventListener('click', () => {
    exprInput.value = '(1/2 + 3/4) * 2';
    errExpr.classList.add('hidden');
    resExprCard.classList.add('hidden');
  });

  // ==========================================
  // PRESET CLICKS
  // ==========================================
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      switchTab(target);

      if (target === 'tab-basic') {
        basicN1.value = btn.getAttribute('data-n1');
        basicD1.value = btn.getAttribute('data-d1');
        basicOp.value = btn.getAttribute('data-op');
        basicN2.value = btn.getAttribute('data-n2');
        basicD2.value = btn.getAttribute('data-d2');
      } else if (target === 'tab-mixed') {
        mixedW1.value = btn.getAttribute('data-w1');
        mixedN1.value = btn.getAttribute('data-n1');
        mixedD1.value = btn.getAttribute('data-d1');
        mixedOp.value = btn.getAttribute('data-op');
        mixedW2.value = btn.getAttribute('data-w2');
        mixedN2.value = btn.getAttribute('data-n2');
        mixedD2.value = btn.getAttribute('data-d2');
      } else if (target === 'tab-decimal') {
        decInput.value = btn.getAttribute('data-dec');
      } else if (target === 'tab-simplify') {
        simpNum.value = btn.getAttribute('data-snum');
        simpDen.value = btn.getAttribute('data-sden');
      } else if (target === 'tab-partial') {
        partialNum.value = btn.getAttribute('data-pnum');
        partialDen.value = btn.getAttribute('data-pden');
      }
    });
  });

  // Enter Key Handler
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.click();
        }
      });
    });
  });
</script>
