---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Fraction Calculator – Solve, Simplify and Convert Fractions"
  description="Free fraction calculator with step-by-step solutions. Add, subtract, multiply, and divide fractions, mixed numbers, decimal to fraction, fraction simplifier, and partial fraction decomposition."
  category="Math"
  calculatorName="Fraction Calculator"
  slug="fraction-calculator"
  keywords={[
    'fraction calculator',
    'decimal to fraction calculator',
    'mixed fraction calculator',
    'partial fraction calculator',
    'fraction simplifier',
    'add fractions',
    'casio fx-55 plus fraction calculator'
  ]}
>
  <div class="space-y-6">

    <!-- CALCULATOR MODE SELECTOR TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-frac-tab active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="tab-basic">Basic Fraction</button>
        <button type="button" class="btn-frac-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-mixed">Mixed Fractions</button>
        <button type="button" class="btn-frac-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-decimal">Decimal ⇄ Fraction</button>
        <button type="button" class="btn-frac-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-simplify">Fraction Simplifier</button>
        <button type="button" class="btn-frac-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-partial">Partial Fractions</button>
        <button type="button" class="btn-frac-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-expression">Expression Parser</button>
      </div>
    </div>

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-basic" data-n1="1" data-d1="2" data-op="+" data-n2="3" data-d2="4">➕ 1/2 + 3/4</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-basic" data-n1="5" data-d1="6" data-op="-" data-n2="1" data-d2="4">➖ 5/6 − 1/4</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-basic" data-n1="2" data-d1="3" data-op="*" data-n2="9" data-d2="10">✖️ 2/3 × 9/10</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-basic" data-n1="3" data-d1="4" data-op="/" data-n2="2" data-d2="5">➗ 3/4 ÷ 2/5</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-mixed" data-w1="2" data-n1="1" data-d1="3" data-op="+" data-w2="1" data-n2="3" data-d2="4">🍰 2 1/3 + 1 3/4</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-decimal" data-dec="0.875">🔢 0.875 ➔ 7/8</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-simplify" data-snum="24" data-sden="36">📐 Simplify 24/36</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-partial" data-pnum="3x + 5" data-pden="(x - 1)(x + 2)">∫ Partial Fraction</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR PANELS CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- 1. BASIC FRACTION CALCULATOR -->
      <div id="panel-tab-basic" class="frac-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>➗</span> Basic Fraction Arithmetic (+, −, ×, ÷)
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Enter numerators and denominators, choose an operation, and click <strong>Calculate</strong>.
          </p>
        </div>

        <form id="form-frac-basic" class="space-y-5" novalidate onsubmit="return false;">
          <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 py-2">
            
            <!-- Fraction 1 -->
            <div class="flex flex-col items-center gap-1.5">
              <label for="basic-n1" class="text-[11px] font-bold text-slate-500">Numerator</label>
              <input type="number" id="basic-n1" value="1" class="w-20 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-base font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              <div class="h-1 w-20 rounded-full bg-slate-400 dark:bg-slate-600"></div>
              <label for="basic-d1" class="text-[11px] font-bold text-slate-500">Denominator</label>
              <input type="number" id="basic-d1" value="2" class="w-20 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-base font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
            </div>

            <!-- Operation Selector -->
            <div class="flex flex-col items-center justify-center">
              <label for="basic-op" class="text-[11px] font-bold text-slate-500 mb-1">Operator</label>
              <select id="basic-op" class="rounded-2xl border-2 border-blue-500 bg-white px-3 py-2.5 text-xl font-black text-blue-600 shadow-sm dark:border-blue-600 dark:bg-slate-900 dark:text-blue-400 cursor-pointer">
                <option value="+" selected>➕ Addition (+)</option>
                <option value="-">➖ Subtraction (−)</option>
                <option value="*">✖️ Multiplication (×)</option>
                <option value="/">➗ Division (÷)</option>
              </select>
            </div>

            <!-- Fraction 2 -->
            <div class="flex flex-col items-center gap-1.5">
              <label for="basic-n2" class="text-[11px] font-bold text-slate-500">Numerator</label>
              <input type="number" id="basic-n2" value="3" class="w-20 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-base font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              <div class="h-1 w-20 rounded-full bg-slate-400 dark:bg-slate-600"></div>
              <label for="basic-d2" class="text-[11px] font-bold text-slate-500">Denominator</label>
              <input type="number" id="basic-d2" value="4" class="w-20 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-base font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
            </div>

          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-basic-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate Fraction →
            </button>
            <button type="button" id="btn-basic-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-basic" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

          <!-- Result Box -->
          <div id="res-basic-card" class="hidden space-y-4 rounded-3xl border border-blue-200 bg-white p-5 dark:border-blue-900/60 dark:bg-slate-900">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-200 pb-4 dark:border-slate-800">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Calculation Result</span>
                <div id="res-basic-simp" class="mt-1 text-3xl sm:text-4xl font-black text-blue-600 dark:text-blue-400">5/4</div>
              </div>
              <div class="sm:text-right">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Mixed Number:</span>
                <div id="res-basic-mixed" class="text-xl font-bold text-emerald-600 dark:text-emerald-400">1 1/4</div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-800 dark:bg-slate-950">
                <span class="text-slate-500 dark:text-slate-400 font-semibold">Decimal Value</span>
                <div id="res-basic-dec" class="mt-1 text-base font-bold text-slate-900 dark:text-white">1.25</div>
              </div>
              <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-800 dark:bg-slate-950">
                <span class="text-slate-500 dark:text-slate-400 font-semibold">Percentage</span>
                <div id="res-basic-pct" class="mt-1 text-base font-bold text-slate-900 dark:text-white">125%</div>
              </div>
            </div>

            <details class="group rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950" open>
              <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold text-slate-800 dark:text-slate-200">
                <span>📝 Step-by-Step Solution</span>
                <span class="text-blue-600 dark:text-blue-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div id="res-basic-steps" class="mt-3 space-y-1.5 text-xs text-slate-700 dark:text-slate-300 font-mono"></div>
            </details>
          </div>
        </form>
      </div>

      <!-- 2. MIXED FRACTION CALCULATOR -->
      <div id="panel-tab-mixed" class="frac-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🍰</span> Mixed Fraction Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Perform arithmetic on mixed numbers (e.g. 2 1/3 + 1 3/4) and convert to improper fractions.
          </p>
        </div>

        <form id="form-frac-mixed" class="space-y-5" novalidate onsubmit="return false;">
          <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 py-2">
            
            <!-- Mixed Fraction 1 -->
            <div class="flex items-center gap-2">
              <div>
                <label for="mixed-w1" class="block text-[11px] font-bold text-slate-500 text-center">Whole</label>
                <input type="number" id="mixed-w1" value="2" class="w-14 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-base font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div class="flex flex-col items-center gap-1">
                <input type="number" id="mixed-n1" value="1" placeholder="Num" class="w-14 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
                <div class="h-0.5 w-14 bg-slate-400"></div>
                <input type="number" id="mixed-d1" value="3" placeholder="Den" class="w-14 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
            </div>

            <!-- Operator -->
            <select id="mixed-op" class="rounded-2xl border-2 border-blue-500 bg-white px-3 py-2 text-lg font-black text-blue-600 shadow-sm dark:border-blue-600 dark:bg-slate-900 dark:text-blue-400 cursor-pointer">
              <option value="+" selected>➕</option>
              <option value="-">➖</option>
              <option value="*">✖️</option>
              <option value="/">➗</option>
            </select>

            <!-- Mixed Fraction 2 -->
            <div class="flex items-center gap-2">
              <div>
                <label for="mixed-w2" class="block text-[11px] font-bold text-slate-500 text-center">Whole</label>
                <input type="number" id="mixed-w2" value="1" class="w-14 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-base font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div class="flex flex-col items-center gap-1">
                <input type="number" id="mixed-n2" value="3" placeholder="Num" class="w-14 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
                <div class="h-0.5 w-14 bg-slate-400"></div>
                <input type="number" id="mixed-d2" value="4" placeholder="Den" class="w-14 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-black text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
            </div>

          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-mixed-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate Mixed Fractions →
            </button>
            <button type="button" id="btn-mixed-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-mixed" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

          <div id="res-mixed-card" class="hidden space-y-4 rounded-3xl border border-blue-200 bg-white p-5 dark:border-blue-900/60 dark:bg-slate-900">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-200 pb-4 dark:border-slate-800">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Mixed Number Result</span>
                <div id="res-mixed-out" class="mt-1 text-3xl sm:text-4xl font-black text-blue-600 dark:text-blue-400">4 1/12</div>
              </div>
              <div class="sm:text-right">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Improper Fraction:</span>
                <div id="res-mixed-improper" class="text-xl font-bold text-emerald-600 dark:text-emerald-400">49/12</div>
              </div>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 dark:border-slate-800 dark:bg-slate-950 text-xs">
              <span class="text-slate-500 dark:text-slate-400 font-semibold">Decimal Representation:</span>
              <span id="res-mixed-dec" class="font-bold text-slate-900 dark:text-white ml-2 text-sm">4.0833</span>
            </div>

            <details class="group rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950" open>
              <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold text-slate-800 dark:text-slate-200">
                <span>📝 Step-by-Step Conversion & Math</span>
                <span class="text-blue-600 dark:text-blue-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div id="res-mixed-steps" class="mt-3 space-y-1.5 text-xs text-slate-700 dark:text-slate-300 font-mono"></div>
            </details>
          </div>
        </form>
      </div>

      <!-- 3. DECIMAL TO FRACTION -->
      <div id="panel-tab-decimal" class="frac-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🔢</span> Decimal to Fraction & Fraction to Decimal Converter
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Convert terminating or repeating decimals into exact simplified fractions.
          </p>
        </div>

        <form id="form-frac-decimal" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label for="dec-input" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Decimal Number</label>
              <input type="text" id="dec-input" value="0.75" placeholder="e.g. 0.75 or 1.375" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="dec-max-den" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Max Denominator (Optional Precision)</label>
              <input type="number" id="dec-max-den" value="10000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-dec-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Convert to Fraction →
            </button>
            <button type="button" id="btn-dec-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-dec" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

          <div id="res-dec-card" class="hidden space-y-3 rounded-3xl border border-blue-200 bg-white p-5 dark:border-blue-900/60 dark:bg-slate-900">
            <div class="border-b border-slate-200 pb-3 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Converted Fraction</span>
              <div id="res-dec-frac" class="mt-1 text-4xl font-black text-blue-600 dark:text-blue-400">3/4</div>
              <div id="res-dec-mixed" class="text-sm font-bold text-emerald-600 dark:text-emerald-400 mt-1">Mixed: 3/4</div>
            </div>
            <div id="res-dec-steps" class="space-y-1 text-xs text-slate-700 dark:text-slate-300 font-mono"></div>
          </div>
        </form>
      </div>

      <!-- 4. FRACTION SIMPLIFIER -->
      <div id="panel-tab-simplify" class="frac-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>📐</span> Fraction Simplifier & Reducer
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Reduce any fraction to its simplest lowest terms using the Greatest Common Divisor (GCD).
          </p>
        </div>

        <form id="form-frac-simplify" class="space-y-4" novalidate onsubmit="return false;">
          <div class="flex items-center justify-center gap-3 py-2">
            <div class="flex flex-col items-center gap-1.5">
              <label for="simp-num" class="text-xs font-bold text-slate-500">Numerator</label>
