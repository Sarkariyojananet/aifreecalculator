---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const standardAndOverlineChart = [
  { numeral: "I", value: "1", type: "Standard Unit" },
  { numeral: "V", value: "5", type: "Standard Unit" },
  { numeral: "X", value: "10", type: "Standard Unit" },
  { numeral: "L", value: "50", type: "Standard Unit" },
  { numeral: "C", value: "100", type: "Standard Unit" },
  { numeral: "D", value: "500", type: "Standard Unit" },
  { numeral: "M", value: "1,000", type: "Standard Unit" },
  { numeral: "I\u0305", value: "1,000", type: "Overline (1 \u00d7 1,000)" },
  { numeral: "V\u0305", value: "5,000", type: "Overline (5 \u00d7 1,000)" },
  { numeral: "X\u0305", value: "10,000", type: "Overline (10 \u00d7 1,000)" },
  { numeral: "L\u0305", value: "50,000", type: "Overline (50 \u00d7 1,000)" },
  { numeral: "C\u0305", value: "100,000", type: "Overline (100 \u00d7 1,000)" },
  { numeral: "D\u0305", value: "500,000", type: "Overline (500 \u00d7 1,000)" },
  { numeral: "M\u0305", value: "1,000,000", type: "Overline (1,000 \u00d7 1,000)" }
];

const notationComparison = [
  { value: "4", subtractive: "IV", additive: "IIII" },
  { value: "9", subtractive: "IX", additive: "VIIII" },
  { value: "40", subtractive: "XL", additive: "XXXX" },
  { value: "90", subtractive: "XC", additive: "LXXXX" },
  { value: "400", subtractive: "CD", additive: "CCCC" },
  { value: "900", subtractive: "CM", additive: "DCCCC" },
  { value: "4,000", subtractive: "I\u0305V\u0305", additive: "MMMM" },
  { value: "9,000", subtractive: "I\u0305X\u0305", additive: "V\u0305MMMM" },
  { value: "40,000", subtractive: "X\u0305L\u0305", additive: "X\u0305X\u0305X\u0305X\u0305" },
  { value: "90,000", subtractive: "X\u0305C\u0305", additive: "L\u0305X\u0305X\u0305X\u0305X\u0305" },
  { value: "400,000", subtractive: "C\u0305D\u0305", additive: "C\u0305C\u0305C\u0305C\u0305" },
  { value: "900,000", subtractive: "C\u0305M\u0305", additive: "D\u0305C\u0305C\u0305C\u0305C\u0305" }
];
---

<CalculatorLayout
  title="Roman Numeral Calculator – Add, Subtract, Multiply & Divide Roman Numerals"
  description="Free online Roman Numeral Calculator to perform arithmetic (+, -, ×, ÷) on Roman numerals with step-by-step conversion proofs, Arabic integers, and breakdown."
  category="Math"
  calculatorName="Roman Numeral Calculator"
  slug="roman-numeral-calculator"
  keywords={[
    "roman numeral calculator",
    "roman numerals calculator",
    "add roman numerals",
    "subtract roman numerals",
    "multiply roman numerals",
    "divide roman numerals",
    "roman arithmetic calculator",
    "roman numeral math"
  ]}
>
  <div class="space-y-4">

    <!-- COMPACT HERO & PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-linear-to-r from-amber-50/70 via-orange-50/30 to-white p-3.5 sm:p-4 shadow-2xs dark:border-slate-800 dark:from-slate-900 dark:via-amber-950/20 dark:to-slate-900">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="text-lg">🏛️</span>
          <h1 class="text-base sm:text-lg font-black text-slate-900 dark:text-white tracking-tight">
            Roman Numeral Calculator
          </h1>
          <span class="hidden sm:inline-flex rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">
            1 – 3,999
          </span>
        </div>

        <!-- QUICK PRESETS INLINE -->
        <div class="flex flex-wrap items-center gap-1 text-[11px]">
          <span class="text-slate-500 font-semibold mr-0.5">Presets:</span>
          <button type="button" class="btn-preset-calc rounded-md border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val1="XIV" data-op="+" data-val2="IX">XIV + IX</button>
          <button type="button" class="btn-preset-calc rounded-lg border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val1="C" data-op="-" data-val2="XLV">C - XLV</button>
          <button type="button" class="btn-preset-calc rounded-lg border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val1="XII" data-op="*" data-val2="XII">XII × XII</button>
          <button type="button" class="btn-preset-calc rounded-lg border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val1="MMXXIV" data-op="+" data-val2="II">MMXXIV + II</button>
        </div>
      </div>
    </div>

    <!-- MAIN COMPACT CALCULATOR CARD -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 sm:p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3">

      <!-- INPUT ROW -->
      <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr_auto] items-center gap-2">
        <!-- Operand 1 -->
        <div class="relative">
          <div class="flex items-center justify-between text-[11px] font-bold text-slate-500 dark:text-slate-400 mb-1 px-1">
            <span>First Value</span>
            <span class="text-amber-600 dark:text-amber-400 font-mono" id="val1-preview">14</span>
          </div>
          <input
            type="text"
            id="calc-val1"
            value="XIV"
            placeholder="e.g. XIV"
            class="w-full rounded-xl border border-slate-300 bg-slate-50/70 p-2.5 text-center text-base sm:text-lg font-mono font-black uppercase text-slate-900 shadow-2xs focus:border-amber-500 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          />
        </div>

        <!-- Operator -->
        <div class="flex flex-col items-center justify-center">
          <span class="text-[10px] font-bold text-slate-400 hidden sm:block mb-1">Op</span>
          <select
            id="calc-operator"
            class="w-full sm:w-auto rounded-xl border-2 border-amber-400 bg-amber-50/90 px-3 py-2 text-base font-black text-amber-900 shadow-2xs focus:outline-hidden dark:border-amber-600 dark:bg-slate-800 dark:text-amber-300 cursor-pointer text-center"
          >
            <option value="+" selected>+</option>
            <option value="-">&minus;</option>
            <option value="*">&times;</option>
            <option value="/">&divide;</option>
            <option value="%">%</option>
          </select>
        </div>

        <!-- Operand 2 -->
        <div class="relative">
          <div class="flex items-center justify-between text-[11px] font-bold text-slate-500 dark:text-slate-400 mb-1 px-1">
            <span>Second Value</span>
            <span class="text-amber-600 dark:text-amber-400 font-mono" id="val2-preview">9</span>
          </div>
          <input
            type="text"
            id="calc-val2"
            value="IX"
            placeholder="e.g. IX"
            class="w-full rounded-xl border border-slate-300 bg-slate-50/70 p-2.5 text-center text-base sm:text-lg font-mono font-black uppercase text-slate-900 shadow-2xs focus:border-amber-500 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          />
        </div>

        <!-- Action Buttons Inline on Desktop -->
        <div class="flex sm:flex-col items-center gap-1.5 pt-4 sm:pt-4">
          <button
            type="button"
            id="btn-calculate"
            class="w-full sm:w-auto flex items-center justify-center gap-1 rounded-xl bg-amber-600 px-5 py-2.5 text-xs font-black text-white shadow-xs hover:bg-amber-700 active:scale-95 transition cursor-pointer"
          >
            <span>Calculate</span> <span>▶</span>
          </button>
          <button
            type="button"
            id="btn-clear"
            class="w-full sm:w-auto rounded-xl border border-slate-200 bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-600 hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
          >
            Clear
          </button>
        </div>
      </div>

      <!-- SINGLE SHARED VIRTUAL KEYPAD BAR -->
      <div class="flex flex-wrap items-center justify-between gap-1.5 pt-1 border-t border-slate-100 dark:border-slate-800/80 text-xs">
        <span class="text-[11px] text-slate-400 font-medium">Quick Keypad:</span>
        <div class="flex flex-wrap items-center gap-1">
          {["I", "V", "X", "L", "C", "D", "M"].map((sym) => (
            <button
              type="button"
              class="btn-sym rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-mono font-bold text-slate-800 hover:bg-amber-100 hover:text-amber-800 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-amber-900/60 dark:hover:text-amber-300 cursor-pointer"
              data-char={sym}
            >
              {sym}
            </button>
          ))}
          <button
            type="button"
            id="btn-backspace"
            class="rounded-md border border-slate-200 bg-slate-100 px-2 py-1 text-xs font-bold text-slate-600 hover:bg-rose-100 hover:text-rose-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
          >
            ⌫
          </button>
        </div>
      </div>

      <!-- Inline validation alert if error -->
      <div id="calc-error-box" class="hidden rounded-xl border border-rose-300 bg-rose-50 p-2.5 text-xs font-medium text-rose-800 dark:border-rose-900/50 dark:bg-rose-950/40 dark:text-rose-300">
        <!-- Error text -->
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- COMPACT MASTER RESULT CONTAINER -->
    <!-- ========================================================================= -->
    <div id="calc-result-section" class="hidden rounded-2xl border border-amber-300/80 bg-linear-to-br from-amber-50/50 via-white to-orange-50/30 p-3.5 sm:p-5 shadow-sm dark:border-amber-900/40 dark:from-slate-950 dark:via-slate-900 dark:to-amber-950/20 space-y-3">
      
      <!-- Result Highlight Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-amber-100/80 pb-2.5 dark:border-amber-900/50">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Answer:</span>
          <span class="text-2xl sm:text-3xl font-mono font-black text-amber-700 dark:text-amber-400 tracking-wider" id="res-roman-val">
            XXIII
          </span>
          <span class="text-sm font-bold text-slate-600 dark:text-slate-400 font-mono" id="res-arabic-val">
            (= 23)
          </span>
        </div>
        <div class="flex items-center gap-1.5 self-end sm:self-auto">
          <button type="button" id="btn-copy-result" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-700 shadow-2xs hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
            <span>📋</span> Copy
          </button>
          <button type="button" id="btn-print-result" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-700 shadow-2xs hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
            <span>🖨️</span> Print
          </button>
        </div>
      </div>

      <!-- Collapsible Step-by-Step Derivation -->
      <details class="group rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900 text-xs transition">
        <summary class="flex cursor-pointer items-center justify-between font-bold text-slate-800 dark:text-slate-200">
          <span class="flex items-center gap-1.5">
            <span>📝</span> View Step-by-Step Conversion &amp; Math Proof
          </span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div id="res-steps-list" class="mt-2.5 space-y-1.5 font-mono text-slate-700 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-2">
          <!-- Populated by script -->
        </div>
      </details>

    </div><!-- End #calc-result-section -->

  </div><!-- End Calculator Tool Widget Container -->

  <!-- EDUCATIONAL SEO & GUIDE ARTICLE (Slotted into CalculatorLayout content slot) -->
  <Fragment slot="content">
    <div class="space-y-8">

      <!-- SECTION 1: ARITHMETIC OVERVIEW -->
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Roman Numeral Arithmetic: Addition, Subtraction, Multiplication &amp; Division
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Add, subtract, multiply, and divide Roman numerals from <strong>I to MMMCMXCIX</strong> and/or numbers from <strong>1 to 3,999</strong>. Get answers in Roman numerals and regular numbers. This Roman numeral calculator shows the answer with step-by-step conversion proofs when you add, subtract, multiply, or divide Roman numerals.
        </p>
        <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Need to convert individual numbers or dates? See the <a href="/math/roman-numeral-converter/" class="font-bold text-amber-700 underline hover:text-amber-800 dark:text-amber-400 dark:hover:text-amber-300">Roman Numeral Converter</a> to convert between Roman numerals and numbers, or visit the <a href="/math/roman-numeral-date-converter/" class="font-bold text-amber-700 underline hover:text-amber-800 dark:text-amber-400 dark:hover:text-amber-300">Roman Numeral Date Converter</a> to convert calendar dates.
        </p>
      </div>

      <!-- SECTION 2: ROMAN NUMERAL CHART & OVERLINE VALUES -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📊</span> Roman Numeral Chart: Standard &amp; Overline Values
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Your answer or historical Roman calculations may contain Roman numerals with an overline. An overline means that the value of the Roman numeral is multiplied by 1,000. See the chart below for standard Roman numeral values and overline values.
        </p>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950/60">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-800/90 text-slate-800 dark:text-slate-200 font-bold">
              <tr>
                <th class="p-3">Roman Numeral</th>
                <th class="p-3">Number Value</th>
                <th class="p-3">Type &amp; Calculation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-slate-600 dark:text-slate-300">
              {standardAndOverlineChart.map((row) => (
                <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40">
                  <td class="p-3 font-mono font-bold text-amber-700 dark:text-amber-400 text-sm">{row.numeral}</td>
                  <td class="p-3 font-bold text-slate-900 dark:text-white font-mono">{row.value}</td>
                  <td class="p-3 text-slate-600 dark:text-slate-400">{row.type}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 italic">
          Note: This calculator operates on standard Roman numerals from I to MMMCMXCIX (1 to 3,999). If a calculation produces an answer exceeding 3,999, the exact result is displayed in standard Arabic numbers.
        </p>
      </div>

      <!-- SECTION 3: ADDITIVE & SUBTRACTIVE NOTATION -->
      <div class="space-y-4">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>⚖️</span> Roman Numeral Notation: Additive &amp; Subtractive
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Roman numerals are written in additive and subtractive notation:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase">Additive Notation</h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Additive notation means that the individual values in a Roman numeral are added together to get the total value. In the case of <strong>VIII</strong>, you add up the values for V and three I's. V is 5 and I is 1, so <strong>5 + 1 + 1 + 1 = 8</strong>.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase">Subtractive Notation</h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Subtractive notation means that the value of the Roman numeral is found by taking the last character value and subtracting the value of the character that comes just before it. In the case of <strong>XC</strong>, you subtract the value of X from the value of C. X is 10 and C is 100, so <strong>100 - 10 = 90</strong>.
            </p>
          </div>
        </div>

        <!-- NOTATION COMPARISON TABLE -->
        <div class="space-y-2 pt-2">
          <h4 class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200">
            Subtractive and Additive Notation Comparison
          </h4>
          <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950/60">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-800/90 text-slate-800 dark:text-slate-200 font-bold">
                <tr>
                  <th class="p-3">Numeral Value</th>
                  <th class="p-3">Subtractive Notation</th>
                  <th class="p-3">Additive Notation</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-slate-600 dark:text-slate-300">
                {notationComparison.map((row) => (
                  <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40">
                    <td class="p-3 font-bold text-slate-900 dark:text-white font-mono">{row.value}</td>
                    <td class="p-3 font-mono font-bold text-amber-700 dark:text-amber-400">{row.subtractive}</td>
                    <td class="p-3 font-mono text-slate-600 dark:text-slate-400">{row.additive}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- SECTION 4: HOW CALCULATIONS ARE PERFORMED -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🧮</span> How Roman Numeral Calculations Work Step-by-Step
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Because Roman numerals do not use a positional base-10 system or a zero symbol, arithmetic operations are resolved by converting each Roman numeral to its Arabic number equivalent, performing the calculation, and converting the result back into standard Roman numerals:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
          <div class="rounded-xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1.5">
            <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
              <span class="rounded bg-amber-100 px-1.5 py-0.5 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">+</span> Addition
            </div>
            <p class="text-slate-600 dark:text-slate-400">
              <strong>XIV + IX:</strong> XIV = 14, IX = 9. Sum = 14 + 9 = 23 = <strong>XXIII</strong>.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1.5">
            <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
              <span class="rounded bg-amber-100 px-1.5 py-0.5 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">&minus;</span> Subtraction
            </div>
            <p class="text-slate-600 dark:text-slate-400">
              <strong>C &minus; XLV:</strong> C = 100, XLV = 45. Difference = 100 &minus; 45 = 55 = <strong>LV</strong>. (Results must be &gt; 0).
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1.5">
            <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
              <span class="rounded bg-amber-100 px-1.5 py-0.5 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">&times;</span> Multiplication
            </div>
            <p class="text-slate-600 dark:text-slate-400">
              <strong>XII &times; XII:</strong> XII = 12. Product = 12 &times; 12 = 144 = <strong>CXLIV</strong>.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1.5">
            <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
              <span class="rounded bg-amber-100 px-1.5 py-0.5 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">&divide;</span> Division
            </div>
            <p class="text-slate-600 dark:text-slate-400">
              <strong>C &divide; IV:</strong> C = 100, IV = 4. Quotient = 100 &divide; 4 = 25 = <strong>XXV</strong>.
            </p>
          </div>
        </div>
      </div>

      <!-- SECTION 5: RELATED CALCULATORS -->
      <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🔗</span> Related Roman Numeral &amp; Math Tools
        </h3>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href="/math/roman-numeral-converter/" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-semibold text-amber-700 hover:border-amber-500 hover:shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-amber-400 transition">Roman Numeral Converter &rarr;</a>
          <a href="/math/roman-numeral-date-converter/" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-semibold text-amber-700 hover:border-amber-500 hover:shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-amber-400 transition">Roman Numeral Date Converter &rarr;</a>
          <a href="/math/fraction-calculator/" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-semibold text-blue-600 hover:border-blue-500 hover:shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 transition">Fraction Calculator &rarr;</a>
          <a href="/math/ratio-calculator/" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-semibold text-blue-600 hover:border-blue-500 hover:shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 transition">Ratio Calculator &rarr;</a>
        </div>
      </div>

    </div>
  </Fragment>

  <!-- CLIENT-SIDE SCRIPT -->
  <script>
    const ROMAN_MAP: [number, string][] = [
      [1000, "M"],
      [900, "CM"],
      [500, "D"],
      [400, "CD"],
      [100, "C"],
      [90, "XC"],
      [50, "L"],
      [40, "XL"],
      [10, "X"],
      [9, "IX"],
      [5, "V"],
      [4, "IV"],
      [1, "I"]
    ];

    const CHAR_MAP: Record<string, number> = {
      I: 1,
      V: 5,
      X: 10,
      L: 50,
      C: 100,
      D: 500,
      M: 1000
    };

    function parseInput(input: string): { num: number; roman: string; isRoman: boolean } | null {
      const clean = input.trim().toUpperCase();
      if (!clean) return null;

      // If it's a numeric integer
      if (/^-?\d+$/.test(clean)) {
        const n = parseInt(clean, 10);
        const r = toRoman(n);
        return { num: n, roman: r, isRoman: false };
      }

      // If it's Roman letters
      if (/^[IVXLCDM]+$/.test(clean)) {
        const n = romanToArabic(clean);
        if (n === null) return null;
        return { num: n, roman: clean, isRoman: true };
      }

      return null;
    }

    function romanToArabic(roman: string): number | null {
      let total = 0;
      let prev = 0;
      for (let i = roman.length - 1; i >= 0; i--) {
        const ch = roman[i];
        const val = CHAR_MAP[ch];
        if (!val) return null;
        if (val < prev) {
          total -= val;
        } else {
          total += val;
          prev = val;
        }
      }
      return total;
    }

    function toRoman(num: number): string {
      if (num <= 0 || num > 3999) {
        return num.toString();
      }
      let result = '';
      let n = num;
      for (const [val, sym] of ROMAN_MAP) {
        while (n >= val) {
          result += sym;
          n -= val;
        }
      }
      return result;
    }

    function init() {
      const inp1 = document.getElementById('calc-val1') as HTMLInputElement | null;
      const inp2 = document.getElementById('calc-val2') as HTMLInputElement | null;
      const selOp = document.getElementById('calc-operator') as HTMLSelectElement | null;
      const btnCalc = document.getElementById('btn-calculate');
      const btnClear = document.getElementById('btn-clear');
      const errBox = document.getElementById('calc-error-box');
      const resSection = document.getElementById('calc-result-section');

      function updatePreviews() {
        if (inp1) {
          const p1 = parseInput(inp1.value);
          const el1 = document.getElementById('val1-preview');
          if (el1) {
            el1.textContent = p1 ? (p1.isRoman ? `Arabic: ${p1.num}` : `Roman: ${p1.roman}`) : 'Invalid';
          }
        }
        if (inp2) {
          const p2 = parseInput(inp2.value);
          const el2 = document.getElementById('val2-preview');
          if (el2) {
            el2.textContent = p2 ? (p2.isRoman ? `Arabic: ${p2.num}` : `Roman: ${p2.roman}`) : 'Invalid';
          }
        }
      }

      let activeInput = inp1;
      inp1?.addEventListener('focus', () => { activeInput = inp1; });
      inp2?.addEventListener('focus', () => { activeInput = inp2; });

      inp1?.addEventListener('input', updatePreviews);
      inp2?.addEventListener('input', updatePreviews);

      // Keypad symbol insertion
      document.querySelectorAll('.btn-sym').forEach((b) => {
        b.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLElement;
          const char = btn.getAttribute('data-char');
          if (activeInput && char) {
            activeInput.value = (activeInput.value + char).toUpperCase();
            updatePreviews();
          }
        });
      });

      // Backspace
      document.getElementById('btn-backspace')?.addEventListener('click', () => {
        if (activeInput && activeInput.value.length > 0) {
          activeInput.value = activeInput.value.slice(0, -1);
          updatePreviews();
        }
      });

      // Quick preset buttons
      document.querySelectorAll('.btn-preset-calc').forEach((b) => {
        b.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLElement;
          const v1 = btn.getAttribute('data-val1');
          const op = btn.getAttribute('data-op');
          const v2 = btn.getAttribute('data-val2');
          if (inp1 && v1) inp1.value = v1;
          if (inp2 && v2) inp2.value = v2;
          if (selOp && op) selOp.value = op;
          updatePreviews();
          calculate();
        });
      });

      function calculate() {
        if (!inp1 || !inp2 || !selOp || !resSection || !errBox) return;

        const p1 = parseInput(inp1.value);
        const p2 = parseInput(inp2.value);
        const op = selOp.value;

        if (!p1 || !p2) {
          errBox.textContent = "Please enter valid Roman numerals (I, V, X, L, C, D, M) or numbers in both input fields.";
          errBox.classList.remove('hidden');
          resSection.classList.add('hidden');
          return;
        }

        const a = p1.num;
        const b = p2.num;
        let ansArabic = 0;
        let opSymbol = op;

        if (op === '+') {
          ansArabic = a + b;
        } else if (op === '-') {
          ansArabic = a - b;
        } else if (op === '*') {
          ansArabic = a * b;
          opSymbol = '×';
        } else if (op === '/') {
          if (b === 0) {
            errBox.textContent = "Cannot divide by zero.";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }
          ansArabic = Math.floor(a / b);
          opSymbol = '÷';
        } else if (op === '%') {
          if (b === 0) {
            errBox.textContent = "Cannot divide by zero.";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }
          ansArabic = a % b;
        }

        errBox.classList.add('hidden');

        const roman1 = toRoman(a);
        const roman2 = toRoman(b);
        const isStandardRoman = ansArabic >= 1 && ansArabic <= 3999;
        const romanAns = isStandardRoman ? toRoman(ansArabic) : (ansArabic === 0 ? "nulla (0)" : "Out of standard range (1–3,999)");

        // Update Results
        const formulaLine = document.getElementById('res-formula-line');
        if (formulaLine) {
          formulaLine.textContent = `${roman1} ${opSymbol} ${roman2} = ${romanAns} (${a} ${opSymbol} ${b} = ${ansArabic})`;
        }

        const resRoman = document.getElementById('res-roman-val');
        if (resRoman) resRoman.textContent = romanAns;

        const resRomanSub = document.getElementById('res-roman-sub');
        if (resRomanSub) {
          resRomanSub.textContent = isStandardRoman ? `Standard Roman representation of ${ansArabic}` : `Note: Roman numerals do not typically represent non-positive or >3999 integers`;
        }

        const resArabic = document.getElementById('res-arabic-val');
        if (resArabic) resArabic.textContent = ansArabic.toLocaleString();

        // Steps
        const stepsEl = document.getElementById('res-steps-list');
        if (stepsEl) {
          stepsEl.innerHTML = `
            <div class="p-2 rounded bg-slate-50 dark:bg-slate-800">
              <strong class="text-amber-700 dark:text-amber-400">Step 1 (Convert Operands to Arabic):</strong><br />
              &bull; ${roman1} = ${a}<br />
              &bull; ${roman2} = ${b}
            </div>
            <div class="p-2 rounded bg-slate-50 dark:bg-slate-800">
              <strong class="text-amber-700 dark:text-amber-400">Step 2 (Arithmetic Calculation):</strong><br />
              &bull; ${a} ${opSymbol} ${b} = <strong>${ansArabic}</strong>
            </div>
            <div class="p-2 rounded bg-slate-50 dark:bg-slate-800">
              <strong class="text-amber-700 dark:text-amber-400">Step 3 (Convert Result to Roman):</strong><br />
              &bull; ${ansArabic} in Roman numerals = <strong>${romanAns}</strong>
            </div>
          `;
        }

        resSection.classList.remove('hidden');
        resSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      btnCalc?.addEventListener('click', calculate);

      btnClear?.addEventListener('click', () => {
        if (inp1) inp1.value = '';
        if (inp2) inp2.value = '';
        if (errBox) errBox.classList.add('hidden');
        if (resSection) resSection.classList.add('hidden');
        updatePreviews();
      });

      // Copy result
      document.getElementById('btn-copy-result')?.addEventListener('click', () => {
        const val = document.getElementById('res-roman-val')?.textContent || '';
        navigator.clipboard.writeText(val).then(() => {
          const btn = document.getElementById('btn-copy-result');
          if (btn) {
            const orig = btn.innerHTML;
            btn.innerHTML = '<span>✅</span> Copied!';
            setTimeout(() => { btn.innerHTML = orig; }, 2000);
          }
        });
      });

      // Print
      document.getElementById('btn-print-result')?.addEventListener('click', () => {
        window.print();
      });

      updatePreviews();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</CalculatorLayout>
