---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const commonRomanNumbers = [
  { n: 1, r: "I" }, { n: 2, r: "II" }, { n: 3, r: "III" }, { n: 4, r: "IV" }, { n: 5, r: "V" },
  { n: 6, r: "VI" }, { n: 7, r: "VII" }, { n: 8, r: "VIII" }, { n: 9, r: "IX" }, { n: 10, r: "X" },
  { n: 20, r: "XX" }, { n: 30, r: "XXX" }, { n: 40, r: "XL" }, { n: 50, r: "L" }, { n: 60, r: "LX" },
  { n: 70, r: "LXX" }, { n: 80, r: "LXXX" }, { n: 90, r: "XC" }, { n: 100, r: "C" }, { n: 500, r: "D" },
  { n: 1000, r: "M" }, { n: 1984, r: "MCMLXXXIV" }, { n: 1999, r: "MCMXCIX" }, { n: 2000, r: "MM" },
  { n: 2024, r: "MMXXIV" }, { n: 2025, r: "MMXXV" }, { n: 2026, r: "MMXXVI" }, { n: 3000, r: "MMM" }
];

const sevenSymbols = [
  { symbol: "I", value: "1" },
  { symbol: "V", value: "5" },
  { symbol: "X", value: "10" },
  { symbol: "L", value: "50" },
  { symbol: "C", value: "100" },
  { symbol: "D", value: "500" },
  { symbol: "M", value: "1,000" }
];
---

<CalculatorLayout
  title="Roman Numeral Converter: Convert Numbers to Roman Numerals & Vice Versa"
  description="Free two-way Roman Numeral Converter: convert Roman numerals to numbers (Arabic) and numbers to Roman numerals instantly with expansion breakdown and validation."
  category="Math"
  calculatorName="Roman Numeral Converter"
  slug="roman-numeral-converter"
  keywords={[
    "roman numeral converter",
    "roman numerals converter",
    "convert roman numerals to numbers",
    "numbers to roman numerals",
    "roman to arabic converter",
    "arabic to roman converter",
    "roman numeral translator",
    "roman number converter"
  ]}
>
  <div class="space-y-4">

    <!-- COMPACT HERO & PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-linear-to-r from-amber-50/70 via-yellow-50/30 to-white p-3.5 sm:p-4 shadow-2xs dark:border-slate-800 dark:from-slate-900 dark:via-amber-950/20 dark:to-slate-900">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="text-lg">🔄</span>
          <h1 class="text-base sm:text-lg font-black text-slate-900 dark:text-white tracking-tight">
            Roman Numeral Converter
          </h1>
          <span class="hidden sm:inline-flex rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">
            1 – 3,999
          </span>
        </div>

        <!-- QUICK PRESETS INLINE -->
        <div class="flex flex-wrap items-center gap-1 text-[11px]">
          <span class="text-slate-500 font-semibold mr-0.5">Presets:</span>
          <button type="button" class="btn-preset-conv rounded-md border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val="2026">2026</button>
          <button type="button" class="btn-preset-conv rounded-md border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val="MMXXIV">MMXXIV</button>
          <button type="button" class="btn-preset-conv rounded-md border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val="1999">1999</button>
          <button type="button" class="btn-preset-conv rounded-md border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val="LIX">LIX</button>
          <button type="button" class="btn-preset-conv rounded-md border border-slate-200 bg-white px-2 py-0.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-val="100">100 (C)</button>
        </div>
      </div>
    </div>

    <!-- MAIN CONVERTER WIDGET (COMPACT) -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 sm:p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3">

      <!-- MODE TOGGLE -->
      <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-2">
        <div class="inline-flex rounded-xl border border-slate-200 bg-slate-100 p-0.5 dark:border-slate-800 dark:bg-slate-950 text-xs">
          <button
            type="button"
            id="tab-mode-num"
            class="mode-toggle-btn active rounded-lg bg-white px-3 py-1 font-bold text-amber-800 shadow-2xs dark:bg-slate-800 dark:text-amber-300 cursor-pointer transition"
          >
            Number &rarr; Roman
          </button>
          <button
            type="button"
            id="tab-mode-rom"
            class="mode-toggle-btn rounded-lg px-3 py-1 font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer transition"
          >
            Roman &rarr; Number
          </button>
        </div>

        <span class="text-[11px] text-amber-600 dark:text-amber-400 font-mono" id="inp-status-hint">Auto-detecting</span>
      </div>

      <!-- INPUT & CONVERT ROW -->
      <div class="flex flex-col sm:flex-row items-center gap-2">
        <div class="relative w-full">
          <input
            type="text"
            id="conv-input"
            value="2026"
            placeholder="e.g. 2026 or MMXXVI"
            class="w-full rounded-xl border border-slate-300 bg-slate-50/70 p-2.5 sm:p-3 text-center sm:text-left sm:pl-4 text-base sm:text-lg font-mono font-black uppercase text-slate-900 shadow-2xs focus:border-amber-500 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          />
        </div>

        <div class="flex items-center gap-1.5 w-full sm:w-auto shrink-0">
          <button
            type="button"
            id="btn-convert"
            class="w-full sm:w-auto flex items-center justify-center gap-1 rounded-xl bg-amber-600 px-6 py-2.5 sm:py-3 text-xs font-black text-white shadow-xs hover:bg-amber-700 active:scale-95 transition cursor-pointer"
          >
            <span>Convert</span> <span>▶</span>
          </button>
          <button
            type="button"
            id="btn-clear-conv"
            class="w-auto rounded-xl border border-slate-200 bg-slate-100 px-3.5 py-2.5 sm:py-3 text-xs font-bold text-slate-600 hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
          >
            Clear
          </button>
        </div>
      </div>

      <!-- COMPACT KEYPAD BAR -->
      <div id="virtual-roman-keypad" class="flex flex-wrap items-center justify-between gap-1 pt-1 text-xs">
        <span class="text-[11px] text-slate-400 font-medium">Symbols:</span>
        <div class="flex flex-wrap items-center gap-1">
          {["I", "V", "X", "L", "C", "D", "M"].map((ch) => (
            <button
              type="button"
              class="btn-keypad-char rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-mono font-bold text-slate-800 hover:bg-amber-100 hover:text-amber-800 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-amber-900/60 dark:hover:text-amber-300 cursor-pointer"
              data-char={ch}
            >
              {ch}
            </button>
          ))}
          <button
            type="button"
            id="btn-backspace"
            class="rounded-md border border-slate-200 bg-slate-100 px-2 py-1 text-xs font-bold text-slate-600 hover:bg-rose-100 hover:text-rose-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
          >
            ⌫
          </button>
        </div>
      </div>

      <!-- Inline error alert -->
      <div id="conv-error-box" class="hidden rounded-xl border border-rose-300 bg-rose-50 p-2.5 text-xs font-medium text-rose-800 dark:border-rose-900/50 dark:bg-rose-950/40 dark:text-rose-300">
        <!-- Error details -->
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- COMPACT CONVERSION RESULT CONTAINER -->
    <!-- ========================================================================= -->
    <div id="conv-result-section" class="hidden rounded-2xl border border-amber-300/80 bg-linear-to-br from-amber-50/50 via-white to-orange-50/30 p-3.5 sm:p-5 shadow-sm dark:border-amber-900/40 dark:from-slate-950 dark:via-slate-900 dark:to-amber-950/20 space-y-3">

      <!-- Result Highlight Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-amber-100/80 pb-2.5 dark:border-amber-900/50">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider" id="lbl-primary-output">Roman:</span>
          <span class="text-2xl sm:text-3xl font-mono font-black text-amber-700 dark:text-amber-400 tracking-wider" id="res-primary-output">
            MMXXVI
          </span>
          <span class="text-sm font-bold text-slate-600 dark:text-slate-400 font-mono" id="res-secondary-output">
            (= 2,026)
          </span>
        </div>
        <div class="flex items-center gap-1.5 self-end sm:self-auto">
          <button type="button" id="btn-copy-conv" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-700 shadow-2xs hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
            <span>📋</span> Copy
          </button>
          <button type="button" id="btn-print-conv" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-700 shadow-2xs hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
            <span>🖨️</span> Print
          </button>
        </div>
      </div>

      <!-- Collapsible Expansion Breakdown -->
      <details class="group rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900 text-xs transition">
        <summary class="flex cursor-pointer items-center justify-between font-bold text-slate-800 dark:text-slate-200">
          <span class="flex items-center gap-1.5">
            <span>🔍</span> View Additive / Subtractive Breakdown
          </span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div id="res-breakdown-content" class="mt-2.5 space-y-1 font-mono text-slate-700 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-2">
          <!-- Populated by script -->
        </div>
      </details>

    </div><!-- End #conv-result-section -->

  </div><!-- End Calculator Tool Widget Container -->

  <!-- EDUCATIONAL SEO & GUIDE ARTICLE (Slotted into CalculatorLayout content slot) -->
  <Fragment slot="content">
    <div class="space-y-8">

      <!-- SECTION 1: HOW THE CONVERTER WORKS & PRACTICAL TRANSLATION -->
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          How This Roman Numeral Converter Works
        </h2>

        <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          This two-way Roman numeral converter translates standard decimal numbers into Roman numerals and decodes Roman letter strings back into Arabic integers from 1 to 3,999. If you type an Arabic number such as 2026, the tool breaks the number into place values from thousands down to units to produce MMXXVI.
        </p>

        <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          When you enter a Roman string like CDXLIV, the parser scans each symbol from left to right, detects subtractive pairs, and returns 444 alongside an additive expansion.
        </p>

        <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Roman numerals served as the primary counting system across Europe for over fifteen centuries. While decimal Arabic numerals took over commerce and bookkeeping by the late Middle Ages, Roman notation remains widespread on clock faces, monuments, film copyright notices, monarch names, plus major sporting events.
        </p>
      </div>

      <!-- SECTION 2: THE 7 BASIC ROMAN NUMERALS -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📜</span> The Seven Standard Roman Numeral Symbols
        </h3>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Classical Roman notation relies on seven uppercase Latin letters, where each symbol represents a fixed numerical value without any position-holding zero. Instead of using zero to shift orders of magnitude, Roman numerals assign distinct letters to powers of ten and their five-unit midpoints.
        </p>

        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950/60 shadow-2xs">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-800/90 text-slate-800 dark:text-slate-200 font-bold">
              <tr>
                <th class="p-3">Roman Numeral</th>
                {sevenSymbols.map((s) => (
                  <th class="p-3 text-center font-mono font-bold text-amber-700 dark:text-amber-400 text-sm sm:text-base">{s.symbol}</th>
                ))}
              </tr>
            </thead>
            <tbody class="text-slate-700 dark:text-slate-300">
              <tr>
                <td class="p-3 font-semibold text-slate-900 dark:text-white">Arabic Number</td>
                {sevenSymbols.map((s) => (
                  <td class="p-3 text-center font-mono font-bold">{s.value}</td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Historians trace these symbols back to ancient tally sticks used by Etruscan and Roman shepherds. A single vertical notch marked unit one, while every fifth notch formed an open chevron, and every tenth notch crossed two chevrons into an X. As written Latin became the administrative standard of the empire, stone carvers along with scribes adopted the familiar alphabet characters that closest resembled those ancestral notches.
        </p>
      </div>

      <!-- SECTION 3: RULES FOR READING AND WRITING -->
      <div class="space-y-4">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>⚖️</span> The Four Rules of Roman Numeral Notation
        </h3>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Every standard Roman numeral follows four consistent principles. Mastering these rules eliminates guesswork and clarifies why certain letter sequences are valid while others are strictly forbidden.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Rule 1: Additive -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
              1. The Additive Principle
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              When a symbol appears after an equal or larger numeral, you add its value to the total. This rule governs the vast majority of numerals.
            </p>
            <div class="font-mono text-xs text-slate-800 dark:text-slate-200 bg-white dark:bg-slate-900 p-2.5 rounded-xl border border-slate-200 dark:border-slate-800">
              <span>• VIII = 5 + 1 + 1 + 1 = 8 &nbsp;|&nbsp; CLX = 100 + 50 + 10 = 160 &nbsp;|&nbsp; MDCC = 1,000 + 500 + 100 + 100 = 1,700</span>
            </div>
          </div>

          <!-- Rule 2: Subtractive -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
              2. The Subtractive Principle
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              When a smaller symbol immediately precedes a larger one, subtract the smaller value from the larger one. Standard Roman notation permits only six subtractive pairs:
            </p>
            <div class="font-mono text-xs text-slate-800 dark:text-slate-200 bg-white dark:bg-slate-900 p-2.5 rounded-xl border border-slate-200 dark:border-slate-800">
              <span>• IV = 5 &minus; 1 = 4 &nbsp;|&nbsp; IX = 10 &minus; 1 = 9 &nbsp;|&nbsp; XL = 50 &minus; 10 = 40 &nbsp;|&nbsp; XC = 100 &minus; 10 = 90 &nbsp;|&nbsp; CD = 500 &minus; 100 = 400 &nbsp;|&nbsp; CM = 1,000 &minus; 100 = 900</span>
            </div>
          </div>

          <!-- Rule 3: Repetition Limits -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
              3. Repetition Boundaries
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              You can repeat the symbols I, X, C, M up to three consecutive times in standard modern usage. Writing IIII or XXXX violates standard formatting.
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              The intermediate symbols V, L, D represent five-based values and never repeat because doubling them duplicates existing decimal values.
            </p>
          </div>

          <!-- Rule 4: Subtraction Constraints -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
              4. Order of Magnitude Constraints
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Subtraction works strictly between adjacent decimal tiers. The symbol I subtracts only from V or X, while X subtracts only from L or C, and C subtracts only from D or M.
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Because you cannot skip place values, writing 99 as IC or 49 as IL is invalid. Instead, 99 decomposes into 90 + 9, producing XCIX.
            </p>
          </div>
        </div>
      </div>

      <!-- SECTION 4: STEP-BY-STEP WORKED EXAMPLES -->
      <div class="space-y-4">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🔢</span> Step-by-Step Conversion Walkthrough
        </h3>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Converting between numerical formats requires systematic place-value decomposition. By processing thousands, hundreds, tens, plus single units separately, you avoid common transposition errors.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Arabic to Roman: Example 1994 -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900 space-y-2.5 shadow-2xs">
            <h4 class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
              Example 1: Convert 1,994 to Roman Numerals
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Deconstruct 1,994 into its four constituent decimal tiers: 1,000 + 900 + 90 + 4.
            </p>
            <div class="font-mono text-xs bg-slate-50 dark:bg-slate-950 p-3 rounded-xl border border-slate-200 dark:border-slate-800 space-y-1">
              <div class="text-slate-600 dark:text-slate-400">• 1,000 = <strong class="text-amber-700 dark:text-amber-400">M</strong> | 900 = <strong class="text-amber-700 dark:text-amber-400">CM</strong> | 90 = <strong class="text-amber-700 dark:text-amber-400">XC</strong> | 4 = <strong class="text-amber-700 dark:text-amber-400">IV</strong></div>
              <div class="pt-1 font-bold text-slate-900 dark:text-white">Combining these segments left to right yields MCMXCIV.</div>
            </div>
          </div>

          <!-- Roman to Arabic: Example MMXXVI -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900 space-y-2.5 shadow-2xs">
            <h4 class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
              Example 2: Convert MMXXVI to Arabic Numbers
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Read the numeral sequence from left to right, grouping additive alongside subtractive blocks.
            </p>
            <div class="font-mono text-xs bg-slate-50 dark:bg-slate-950 p-3 rounded-xl border border-slate-200 dark:border-slate-800 space-y-1">
              <div class="text-slate-600 dark:text-slate-400">• MM = 1,000 + 1,000 = 2,000 | XX = 10 + 10 = 20 | VI = 5 + 1 = 6</div>
              <div class="pt-1 font-bold text-slate-900 dark:text-white">Summing each portion gives 2,000 + 20 + 6 = 2,026.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 5: WHY CLOCKS USE IIII INSTEAD OF IV -->
      <div class="rounded-2xl border border-slate-200 bg-amber-50/40 p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-900/60 space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>⏰</span> Why Do Clock Faces Show IIII Instead of IV?
        </h3>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Look closely at traditional wristwatches and historic clock towers, and you will almost certainly spot IIII instead of IV at the four o'clock position. Horologists preserve this convention primarily for aesthetic equilibrium across the circular dial. Displaying IIII balances the dial into three harmonious sectors: four hours containing only numeral I, four hours incorporating numeral V, and four hours centered around numeral X.
        </p>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Historical practice also explains this horological tradition. Everyday Roman stone inscriptions overwhelmingly favored additive forms like IIII over subtractive forms. Strict subtractive standardization emerged primarily after Renaissance typography solidified across European printing houses.
        </p>
      </div>

      <!-- SECTION 6: LARGE NUMBERS AND HISTORICAL NOTATION -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🏛️</span> Expressing Numbers Beyond 3,999
        </h3>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Standard Roman notation terminates at 3,999 (MMMCMXCIX) because writing four consecutive M symbols violates classical grammar. Whenever ancient administrators and medieval scholars needed to document larger quantities, they employed two formal extensions.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
          <!-- Vinculum -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2">
            <h4 class="font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider text-xs">
              The Vinculum (Overline System)
            </h4>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
              A horizontal bar placed over a numeral multiplies its value by 1,000. Under this system, <span class="overline font-mono font-bold">V</span> represents 5,000, <span class="overline font-mono font-bold">X</span> represents 10,000, and <span class="overline font-mono font-bold">M</span> represents 1,000,000. Placing a double overline multiplied values by one million.
            </p>
          </div>

          <!-- Apostrophus -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2">
            <h4 class="font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider text-xs">
              The Apostrophus Notation
            </h4>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
              Early scribes and printers combined letter C with mirrored C characters (Ↄ). In this system, IↃ represented 500, CIↃ represented 1,000, and each added outer bracket multiplied the encapsulated value by ten.
            </p>
          </div>
        </div>
      </div>

      <!-- SECTION 7: COMMON ROMAN NUMERAL REFERENCE CHART -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📋</span> Quick Reference Conversion Chart
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2 text-xs">
          {commonRomanNumbers.map((c) => (
            <div class="rounded-xl border border-slate-200 bg-white p-2.5 text-center dark:border-slate-800 dark:bg-slate-900 shadow-2xs">
              <span class="block text-slate-500 font-bold text-[10px]">{c.n}</span>
              <span class="font-mono font-black text-amber-700 dark:text-amber-400 text-sm">{c.r}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- SECTION 8: PRACTICAL FAQS -->
      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>❓</span> Frequently Asked Questions
        </h3>

        <div class="space-y-2.5 text-xs sm:text-sm">
          <div class="rounded-xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1">
            <p class="font-bold text-slate-900 dark:text-white">Why is 99 written as XCIX instead of IC?</p>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
              Roman subtraction applies strictly within the same place value. You can only subtract I from V or X. Writing IC skips the tens place entirely, violating decimal place-value decomposition. The correct form is (100 &minus; 10) + (10 &minus; 1), which gives XCIX.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1">
            <p class="font-bold text-slate-900 dark:text-white">Is there a Roman numeral for zero?</p>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
              No single letter represents zero in classical Roman notation. Romans recorded empty amounts using Latin words such as <em>nulla</em> or <em>nihil</em>. The mathematical zero as a placeholding digit originated in India and arrived in Europe through Arabic mathematical manuscripts centuries later.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1">
            <p class="font-bold text-slate-900 dark:text-white">What is the highest number you can write without an overline?</p>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
              The largest standard number is 3,999, written as MMMCMXCIX. Writing 4,000 requires four consecutive M symbols, which violates modern standard rules, or a vinculum bar over IV.
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1">
            <p class="font-bold text-slate-900 dark:text-white">How do you write modern calendar years in Roman numerals?</p>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-xs">
              Convert the millennium first, followed by centuries, decades, then single years. For example, 2024 is MMXXIV, 2025 is MMXXV, and 2026 is MMXXVI.
            </p>
          </div>
        </div>
      </div>

      <!-- SECTION 9: RELATED TOOLS -->
      <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🔗</span> Related Calculation Tools
        </h3>

        <p class="text-xs text-slate-600 dark:text-slate-400">
          Perform Roman numeral arithmetic or format commemorative dates using our companion tools:
        </p>

        <div class="flex flex-wrap gap-2 text-xs">
          <a href="/math/roman-numeral-calculator/" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-semibold text-amber-700 hover:border-amber-500 hover:shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-amber-400 transition">Roman Numeral Calculator (+, &minus;, &times;, &divide;) &rarr;</a>
          <a href="/math/roman-numeral-date-converter/" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-semibold text-amber-700 hover:border-amber-500 hover:shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-amber-400 transition">Roman Numeral Date Converter (Tattoos &amp; Rings) &rarr;</a>
          <a href="/math/fraction-calculator/" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-semibold text-blue-600 hover:border-blue-500 hover:shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 transition">Fraction Calculator &rarr;</a>
        </div>
      </div>

      <!-- SECTION 10: SOURCES & HISTORICAL REFERENCES -->
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950/40 text-xs text-slate-500 dark:text-slate-400 space-y-1.5">
        <h4 class="font-bold uppercase tracking-wider text-[11px] text-slate-600 dark:text-slate-300">
          Sources and Historical References
        </h4>

        <ul class="space-y-1 list-disc pl-4">
          <li>Cajori, Florian. <em>A History of Mathematical Notations</em>. Open Court Publishing, 1928. Detailed historical analysis of subtractive forms and tally origins.</li>
          <li>Encyclopaedia Britannica. "Roman Numerals." Overview of classical notation, medieval adaptations, alongside the vinculum system.</li>
          <li>Ifrah, Georges. <em>The Universal History of Numbers: From Prehistory to the Invention of the Computer</em>. John Wiley &amp; Sons, 2000. Examination of Roman arithmetic methods and the transition to Hindu-Arabic positional systems.</li>
        </ul>
      </div>

    </div>
  </Fragment>

  <!-- CLIENT-SIDE CONVERTER SCRIPT -->
  <script>
    const ROMAN_MAP: [number, string][] = [
      [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
      [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
      [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"]
    ];

    const CHAR_MAP: Record<string, number> = {
      I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000
    };

    function toRomanWithBreakdown(num: number): { roman: string; breakdown: string } {
      if (num <= 0 || num > 3999) return { roman: num.toString(), breakdown: 'Out of standard range' };
      let n = num;
      let roman = '';
      const parts: string[] = [];

      for (const [val, sym] of ROMAN_MAP) {
        while (n >= val) {
          roman += sym;
          parts.push(`${sym} (${val})`);
          n -= val;
        }
      }
      return { roman, breakdown: parts.join(' + ') };
    }

    function fromRomanWithBreakdown(roman: string): { num: number; breakdown: string } | null {
      const clean = roman.toUpperCase().trim();
      if (!clean || !/^[IVXLCDM]+$/.test(clean)) return null;

      let total = 0;
      let prev = 0;
      const terms: string[] = [];

      for (let i = clean.length - 1; i >= 0; i--) {
        const ch = clean[i];
        const val = CHAR_MAP[ch];
        if (!val) return null;
        if (val < prev) {
          total -= val;
          terms.unshift(`-${val}`);
        } else {
          total += val;
          terms.unshift(`+${val}`);
          prev = val;
        }
      }

      // Check if reconverting total yields same roman (strict validation)
      const rechecked = toRomanWithBreakdown(total).roman;
      const isValid = (rechecked === clean);

      return {
        num: total,
        breakdown: `${clean} = ${terms.join(' ')} = ${total} ${!isValid ? '(Non-standard Roman spelling)' : ''}`
      };
    }

    function init() {
      const inp = document.getElementById('conv-input') as HTMLInputElement | null;
      const btnConvert = document.getElementById('btn-convert');
      const btnClear = document.getElementById('btn-clear-conv');
      const errBox = document.getElementById('conv-error-box');
      const resSection = document.getElementById('conv-result-section');
      const tabNum = document.getElementById('tab-mode-num');
      const tabRom = document.getElementById('tab-mode-rom');
      const lblInput = document.getElementById('lbl-conv-input');

      let currentMode: 'num-to-rom' | 'rom-to-num' = 'num-to-rom';

      function setMode(mode: 'num-to-rom' | 'rom-to-num') {
        currentMode = mode;
        if (mode === 'num-to-rom') {
          tabNum?.classList.add('active', 'bg-white', 'text-amber-800', 'dark:bg-slate-800', 'dark:text-amber-300');
          tabNum?.classList.remove('text-slate-600', 'dark:text-slate-400');
          tabRom?.classList.remove('active', 'bg-white', 'text-amber-800', 'dark:bg-slate-800', 'dark:text-amber-300');
          tabRom?.classList.add('text-slate-600', 'dark:text-slate-400');
          if (lblInput) lblInput.innerHTML = `<span>Enter Arabic Number (1 – 3,999):</span>`;
          if (inp) {
            inp.placeholder = "e.g. 2026 or 1984";
            if (!/^\d+$/.test(inp.value)) inp.value = "2026";
          }
        } else {
          tabRom?.classList.add('active', 'bg-white', 'text-amber-800', 'dark:bg-slate-800', 'dark:text-amber-300');
          tabRom?.classList.remove('text-slate-600', 'dark:text-slate-400');
          tabNum?.classList.remove('active', 'bg-white', 'text-amber-800', 'dark:bg-slate-800', 'dark:text-amber-300');
          tabNum?.classList.add('text-slate-600', 'dark:text-slate-400');
          if (lblInput) lblInput.innerHTML = `<span>Enter Roman Numeral:</span>`;
          if (inp) {
            inp.placeholder = "e.g. MMXXVI or MCMXCIX";
            if (!/^[A-Z]+$/i.test(inp.value)) inp.value = "MMXXVI";
          }
        }
      }

      tabNum?.addEventListener('click', () => setMode('num-to-rom'));
      tabRom?.addEventListener('click', () => setMode('rom-to-num'));

      // Keypad input
      document.querySelectorAll('.btn-keypad-char').forEach((b) => {
        b.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLElement;
          const char = btn.getAttribute('data-char');
          if (inp && char) {
            inp.value = (inp.value + char).toUpperCase();
          }
        });
      });

      document.getElementById('btn-backspace')?.addEventListener('click', () => {
        if (inp && inp.value.length > 0) {
          inp.value = inp.value.slice(0, -1);
        }
      });

      // Preset buttons
      document.querySelectorAll('.btn-preset-conv').forEach((b) => {
        b.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLElement;
          const val = btn.getAttribute('data-val');
          if (inp && val) {
            inp.value = val;
            if (/^\d+$/.test(val)) {
              setMode('num-to-rom');
            } else {
              setMode('rom-to-num');
            }
            convert();
          }
        });
      });

      function convert() {
        if (!inp || !errBox || !resSection) return;
        const raw = inp.value.trim().toUpperCase();

        if (!raw) {
          errBox.textContent = "Please enter a number or Roman numeral to convert.";
          errBox.classList.remove('hidden');
          resSection.classList.add('hidden');
          return;
        }

        // Auto-detect if user typed numbers vs Roman
        const isNumeric = /^\d+$/.test(raw);

        if (isNumeric) {
          const num = parseInt(raw, 10);
          if (num < 1 || num > 3999) {
            errBox.textContent = "Please enter an Arabic integer between 1 and 3,999.";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }
          errBox.classList.add('hidden');

          const { roman, breakdown } = toRomanWithBreakdown(num);

          // Update UI
          const lblPri = document.getElementById('lbl-primary-output');
          const resPri = document.getElementById('res-primary-output');
          const resPriDesc = document.getElementById('res-primary-desc');
          const lblSec = document.getElementById('lbl-secondary-output');
          const resSec = document.getElementById('res-secondary-output');
          const resSecDesc = document.getElementById('res-secondary-desc');
          const sumLine = document.getElementById('res-conversion-summary');
          const bdContent = document.getElementById('res-breakdown-content');

          if (lblPri) lblPri.textContent = "Roman Numeral Output";
          if (resPri) resPri.textContent = roman;
          if (resPriDesc) resPriDesc.textContent = "Classical Roman Numeral";
          if (lblSec) lblSec.textContent = "Input Arabic Value";
          if (resSec) resSec.textContent = num.toLocaleString();
          if (resSecDesc) resSecDesc.textContent = "Base-10 Integer";
          if (sumLine) sumLine.textContent = `${num.toLocaleString()} = ${roman}`;

          if (bdContent) {
            bdContent.innerHTML = `
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 space-y-1">
                <span class="text-slate-500 font-bold">Sum of Symbol Values:</span><br />
                <strong>${breakdown} = ${num}</strong>
              </div>
            `;
          }

        } else {
          // Roman to number
          const res = fromRomanWithBreakdown(raw);
          if (!res) {
            errBox.textContent = "Invalid Roman numeral string. Use only I, V, X, L, C, D, M.";
            errBox.classList.remove('hidden');
            resSection.classList.add('hidden');
            return;
          }
          errBox.classList.add('hidden');

          const lblPri = document.getElementById('lbl-primary-output');
          const resPri = document.getElementById('res-primary-output');
          const resPriDesc = document.getElementById('res-primary-desc');
          const lblSec = document.getElementById('lbl-secondary-output');
          const resSec = document.getElementById('res-secondary-output');
          const resSecDesc = document.getElementById('res-secondary-desc');
          const sumLine = document.getElementById('res-conversion-summary');
          const bdContent = document.getElementById('res-breakdown-content');

          if (lblPri) lblPri.textContent = "Arabic Decimal Value";
          if (resPri) resPri.textContent = res.num.toLocaleString();
          if (resPriDesc) resPriDesc.textContent = "Base-10 Integer";
          if (lblSec) lblSec.textContent = "Input Roman Numeral";
          if (resSec) resSec.textContent = raw;
          if (resSecDesc) resSecDesc.textContent = "Roman Symbols";
          if (sumLine) sumLine.textContent = `${raw} = ${res.num.toLocaleString()}`;

          if (bdContent) {
            bdContent.innerHTML = `
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 space-y-1">
                <span class="text-slate-500 font-bold">Additive &amp; Subtractive Breakdown:</span><br />
                <strong>${res.breakdown}</strong>
              </div>
            `;
          }
        }

        resSection.classList.remove('hidden');
        resSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      btnConvert?.addEventListener('click', convert);

      btnClear?.addEventListener('click', () => {
        if (inp) inp.value = '';
        if (errBox) errBox.classList.add('hidden');
        if (resSection) resSection.classList.add('hidden');
      });

      // Copy
      document.getElementById('btn-copy-conv')?.addEventListener('click', () => {
        const text = document.getElementById('res-primary-output')?.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          const btn = document.getElementById('btn-copy-conv');
          if (btn) {
            const orig = btn.innerHTML;
            btn.innerHTML = '<span>✅</span> Copied!';
            setTimeout(() => { btn.innerHTML = orig; }, 2000);
          }
        });
      });

      // Print
      document.getElementById('btn-print-conv')?.addEventListener('click', () => {
        window.print();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</CalculatorLayout>
