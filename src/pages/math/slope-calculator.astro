---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Slope Calculator – Rise Over Run, Percentage, Roof Pitch & Ramp Angle"
  description="Calculate slope percentage, angle in degrees, rise over run ratio, roof pitch (X:12), and wheelchair ramp dimensions with step-by-step formulas."
  category="Math"
  calculatorName="Slope Calculator"
  slug="slope-calculator"
  keywords={[
    'slope calculator',
    'slope percentage calculator',
    'slope calculator percentage',
    'slope angle calculator',
    'rise over run calculator',
    'calculate slope percentage',
    'slope percentage to degrees',
    'degrees to slope percentage',
    'roof slope calculator',
    'roof pitch calculator',
    'roof pitch to angle',
    'wheelchair ramp slope calculator',
    'ramp slope calculator',
    'ramp angle calculator',
    'calculate ramp length',
  ]}
>
  <div class="space-y-6">

    <!-- Calculator Card Container -->
    <div
      class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/50 p-1.5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20"
    >
      <!-- Top Mode Selector Tabs -->
      <div
        class="flex items-center gap-1 border-b border-slate-300/80 px-2 pt-1 pb-0 dark:border-slate-800 overflow-x-auto scrollbar-thin"
        role="tablist"
        aria-label="Slope Calculation Categories"
      >
        <button
          type="button"
          id="tab-standard"
          data-category="standard"
          role="tab"
          aria-selected="true"
          class="category-tab active rounded-t-xl border-t border-x border-slate-300/90 bg-white px-3.5 py-2.5 text-xs sm:text-sm font-bold text-slate-900 shadow-2xs -mb-px dark:border-slate-700 dark:bg-slate-900 dark:text-white transition cursor-pointer shrink-0 flex items-center gap-1.5"
        >
          <span>📐</span>
          <span>Standard Slope (Rise &amp; Run)</span>
        </button>
        <button
          type="button"
          id="tab-percentage"
          data-category="percentage"
          role="tab"
          aria-selected="false"
          class="category-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0 flex items-center gap-1.5"
        >
          <span>📊</span>
          <span>Slope % &amp; Angle Conversion</span>
        </button>
        <button
          type="button"
          id="tab-roof"
          data-category="roof"
          role="tab"
          aria-selected="false"
          class="category-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0 flex items-center gap-1.5"
        >
          <span>🏠</span>
          <span>Roof Slope &amp; Pitch (X:12)</span>
        </button>
        <button
          type="button"
          id="tab-ramp"
          data-category="ramp"
          role="tab"
          aria-selected="false"
          class="category-tab rounded-t-xl bg-blue-700/90 px-3.5 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer shrink-0 flex items-center gap-1.5"
        >
          <span>♿</span>
          <span>Wheelchair Ramp Slope</span>
        </button>
      </div>

      <!-- Main Form Container -->
      <form
        id="slope-form"
        class="space-y-4 bg-white/50 p-4 sm:p-6 dark:bg-slate-950/40"
        novalidate
        onsubmit="return false;"
      >
        <!-- Category Subtitle & Global Unit Selector -->
        <div
          class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200/80 pb-3 dark:border-slate-800/80 text-xs"
        >
          <span id="mode-subtitle" class="font-bold text-slate-700 dark:text-slate-300">
            Calculate slope ratio, percentage, and angle from rise and horizontal run.
          </span>

          <div class="flex items-center gap-1.5">
            <label for="select-length-unit" class="font-semibold text-slate-600 dark:text-slate-400">Measurement Unit:</label>
            <select
              id="select-length-unit"
              class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-800 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 cursor-pointer"
            >
              <option value="m" selected>Meters (m)</option>
              <option value="cm">Centimeters (cm)</option>
              <option value="mm">Millimeters (mm)</option>
              <option value="ft">Feet (ft)</option>
              <option value="in">Inches (in)</option>
              <option value="yd">Yards (yd)</option>
            </select>
          </div>
        </div>

        <!-- 1. STANDARD SLOPEN PANEL -->
        <div id="panel-standard" class="category-panel space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              Standard Calculation Mode
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 text-xs">
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="standard-submode" value="rise_run" checked class="text-blue-600 focus:ring-blue-500" />
                <span>Rise &amp; Run</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="standard-submode" value="rise_percentage" class="text-blue-600 focus:ring-blue-500" />
                <span>Rise &amp; Slope %</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="standard-submode" value="run_percentage" class="text-blue-600 focus:ring-blue-500" />
                <span>Run &amp; Slope %</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="standard-submode" value="rise_angle" class="text-blue-600 focus:ring-blue-500" />
                <span>Rise &amp; Angle (θ)</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="standard-submode" value="run_angle" class="text-blue-600 focus:ring-blue-500" />
                <span>Run &amp; Angle (θ)</span>
              </label>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Field: Rise -->
            <div id="wrapper-std-rise">
              <label for="input-std-rise" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Vertical Rise (<span class="text-blue-600 dark:text-blue-400">y</span>)
                <span class="text-[11px] font-normal text-slate-500">(Negative for downward slope)</span>
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-std-rise"
                  step="any"
                  value=""
                  placeholder="Enter vertical rise"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="unit-badge absolute right-3 top-2.5 text-xs font-bold text-slate-400">m</span>
              </div>
            </div>

            <!-- Field: Run -->
            <div id="wrapper-std-run">
              <label for="input-std-run" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Horizontal Run (<span class="text-emerald-600 dark:text-emerald-400">x</span>)
                <span class="text-[11px] font-normal text-slate-500">(Non-zero distance)</span>
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-std-run"
                  step="any"
                  value=""
                  placeholder="Enter horizontal run"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="unit-badge absolute right-3 top-2.5 text-xs font-bold text-slate-400">m</span>
              </div>
            </div>

            <!-- Field: Slope Percentage (Standard) -->
            <div id="wrapper-std-slopepct" class="hidden">
              <label for="input-std-slopepct" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Slope Percentage (<span class="text-purple-600 dark:text-purple-400">%</span>)
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-std-slopepct"
                  step="any"
                  value=""
                  placeholder="Enter slope % (e.g., 25)"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">%</span>
              </div>
            </div>

            <!-- Field: Angle Degrees (Standard) -->
            <div id="wrapper-std-angle" class="hidden">
              <label for="input-std-angle" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Slope Angle (<span class="text-amber-600 dark:text-amber-400">θ</span> in degrees)
                <span class="text-[11px] font-normal text-slate-500">(Strictly between -90° and +90°)</span>
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-std-angle"
                  step="any"
                  min="-89.999"
                  max="89.999"
                  value=""
                  placeholder="Enter angle in degrees (e.g., 14)"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">°</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. PERCENTAGE & ANGLE PANEL -->
        <div id="panel-percentage" class="category-panel hidden space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              Conversion Direction
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="pct-submode" value="percentage_to_angle" checked class="text-blue-600 focus:ring-blue-500" />
                <span>Slope Percentage (%) ➔ Angle (Degrees °)</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="pct-submode" value="angle_to_percentage" class="text-blue-600 focus:ring-blue-500" />
                <span>Angle (Degrees °) ➔ Slope Percentage (%)</span>
              </label>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div id="wrapper-direct-pct">
              <label for="input-direct-pct" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Slope Percentage (<span class="text-purple-600 dark:text-purple-400">%</span>)
                <span class="text-[11px] font-normal text-slate-500">(100% = 45°, &gt;100% allowed)</span>
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-direct-pct"
                  step="any"
                  value=""
                  placeholder="Enter slope percentage (e.g., 100)"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">%</span>
              </div>
            </div>

            <div id="wrapper-direct-angle" class="hidden">
              <label for="input-direct-angle" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Slope Angle (<span class="text-amber-600 dark:text-amber-400">θ</span> in degrees)
                <span class="text-[11px] font-normal text-slate-500">(Strictly between -90° and +90°)</span>
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-direct-angle"
                  step="any"
                  min="-89.999"
                  max="89.999"
                  value=""
                  placeholder="Enter angle in degrees (e.g., 45)"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">°</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. ROOF PITCH PANEL -->
        <div id="panel-roof" class="category-panel hidden space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              Roof Dimension Mode
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="roof-submode" value="roof_pitch" checked class="text-blue-600 focus:ring-blue-500" />
                <span>Roof Pitch (X : 12)</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="roof-submode" value="roof_rise_run" class="text-blue-600 focus:ring-blue-500" />
                <span>Roof Rise &amp; Run</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="roof-submode" value="roof_rafter" class="text-blue-600 focus:ring-blue-500" />
                <span>Run &amp; Rafter Length</span>
              </label>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Field: Pitch X in X:12 -->
            <div id="wrapper-roof-pitch">
              <label for="input-roof-pitch" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Rise per 12 units of run (<span class="text-amber-600 dark:text-amber-400">X in X:12</span>)
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-roof-pitch"
                  step="any"
                  min="0"
                  value=""
                  placeholder="Enter X (e.g., 6 for 6:12 pitch)"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">: 12</span>
              </div>
            </div>

            <!-- Field: Roof Run -->
            <div id="wrapper-roof-run">
              <label for="input-roof-run" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Horizontal Roof Run
                <span class="text-[11px] font-normal text-slate-500">(Optional for pitch X:12, defaults to 12)</span>
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-roof-run"
                  step="any"
                  min="0.001"
                  value=""
                  placeholder="Enter horizontal run (e.g., 12)"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="unit-badge absolute right-3 top-2.5 text-xs font-bold text-slate-400">m</span>
              </div>
            </div>

            <!-- Field: Roof Rise -->
            <div id="wrapper-roof-rise" class="hidden">
              <label for="input-roof-rise" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Vertical Roof Rise (Ridge Height)
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-roof-rise"
                  step="any"
                  min="0"
                  value=""
                  placeholder="Enter vertical roof rise"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="unit-badge absolute right-3 top-2.5 text-xs font-bold text-slate-400">m</span>
              </div>
            </div>

            <!-- Field: Rafter Length -->
            <div id="wrapper-roof-rafter" class="hidden">
              <label for="input-roof-rafter" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Sloped Rafter Length (<span class="text-blue-600 dark:text-blue-400">Hypotenuse L</span>)
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-roof-rafter"
                  step="any"
                  min="0.001"
                  value=""
                  placeholder="Enter rafter length"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="unit-badge absolute right-3 top-2.5 text-xs font-bold text-slate-400">m</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. WHEELCHAIR RAMP PANEL -->
        <div id="panel-ramp" class="category-panel hidden space-y-4">
          <!-- Official Accessibility Disclaimer Banner -->
          <div class="rounded-2xl border border-amber-300 bg-amber-50/80 p-3.5 text-xs text-amber-950 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
            <div class="flex items-center gap-2 font-bold mb-1">
              <span>⚠️</span>
              <span>Accessibility Planning Aid &amp; Compliance Disclaimer</span>
            </div>
            <p class="leading-relaxed">
              Use this calculation as a planning aid only. Ramp requirements can vary by jurisdiction, building type, accessibility standard, available landing space, handrail requirements, edge protection, and other factors. Verify the final design against the applicable local regulations and professional guidance.
            </p>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              Ramp Design Scenario
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="ramp-submode" value="ramp_rise_target" checked class="text-blue-600 focus:ring-blue-500" />
                <span>Rise + Target Slope % ➔ Run Needed</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="ramp-submode" value="ramp_rise_run" class="text-blue-600 focus:ring-blue-500" />
                <span>Rise + Run ➔ Actual Slope %</span>
              </label>
              <label class="flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white p-2.5 cursor-pointer hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 font-medium text-slate-700 dark:text-slate-200">
                <input type="radio" name="ramp-submode" value="ramp_run_target" class="text-blue-600 focus:ring-blue-500" />
                <span>Available Run + Target % ➔ Max Rise</span>
              </label>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Ramp Rise -->
            <div id="wrapper-ramp-rise">
              <label for="input-ramp-rise" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Threshold Rise Height
                <span class="text-[11px] font-normal text-slate-500">(Total vertical elevation change)</span>
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-ramp-rise"
                  step="any"
                  min="0.001"
                  value=""
                  placeholder="Enter vertical rise"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
                <span class="unit-badge absolute right-3 top-2.5 text-xs font-bold text-slate-400">m</span>
              </div>
            </div>

            <!-- Target Slope % -->
            <div id="wrapper-ramp-target">
              <label for="input-ramp-target" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Target Slope Percentage
                <span class="text-[11px] font-normal text-slate-500">(Common: 8.33% for 1:12 ADA max; 5% for 1:20 gentle)</span>
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="input-ramp-target"
                  step="any"
                  min="0.01"
                  value=""
