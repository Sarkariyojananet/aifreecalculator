          <!-- Right Angle Marker -->
          <path d="M ${runEndX - 16},${originY} L ${runEndX - 16},${res.isDownhill ? originY + 16 : originY - 16} L ${runEndX},${res.isDownhill ? originY + 16 : originY - 16}" fill="none" stroke="#94a3b8" stroke-width="1.5"/>

          <!-- Horizontal Run Base Line -->
          <line x1="${originX}" y1="${originY}" x2="${runEndX}" y2="${originY}" stroke="#059669" stroke-width="3" stroke-linecap="round"/>
          <text x="${(originX + runEndX) / 2}" y="${originY + 22}" text-anchor="middle" font-size="11" font-weight="bold" fill="#047857">
            Run: ${res.run.toFixed(2)} ${res.unit}
          </text>

          <!-- Vertical Rise Line -->
          <line x1="${runEndX}" y1="${originY}" x2="${runEndX}" y2="${riseEndY}" stroke="#2563eb" stroke-width="3" stroke-linecap="round"/>
          <text x="${runEndX + 10}" y="${(originY + riseEndY) / 2 + 4}" text-anchor="start" font-size="11" font-weight="bold" fill="#1e40af">
            Rise: ${res.rise.toFixed(2)} ${res.unit}
          </text>

          <!-- Inclined Slope Line (Hypotenuse) -->
          <line x1="${originX}" y1="${originY}" x2="${runEndX}" y2="${riseEndY}" stroke="${colorHyp}" stroke-width="4" stroke-linecap="round"/>

          <!-- Sloped Length / Hypotenuse Label -->
          <text x="${(originX + runEndX) / 2 - 12}" y="${(originY + riseEndY) / 2 - 12}" text-anchor="middle" font-size="11" font-weight="bold" fill="${colorHyp}">
            L: ${res.hypotenuseLength.toFixed(2)} ${res.unit}
          </text>

          <!-- Angle Indicator Arc -->
          <path d="M ${originX + 36},${originY} A 36 36 0 0 ${res.isDownhill ? 1 : 0} ${originX + 32},${res.isDownhill ? originY + 16 : originY - 16}" fill="none" stroke="#7c3aed" stroke-width="2"/>
          <text x="${originX + 44}" y="${res.isDownhill ? originY + 24 : originY - 8}" font-size="11" font-weight="bold" fill="#7c3aed">
