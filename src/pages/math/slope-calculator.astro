        if (!svg) return;

        const absRise = Math.abs(res.rise);
        const absRun = Math.max(0.001, Math.abs(res.run));
        const maxDim = Math.max(absRise, absRun);

        // Aspect scaled to fits within viewBox 400x280
        const scaleW = 260;
        const scaleH = 170;
        const drawRun = Math.max(40, Math.min(scaleW, (absRun / maxDim) * scaleW));
        const drawRise = Math.max(20, Math.min(scaleH, (absRise / maxDim) * scaleH));

        const originX = 60;
        const originY = 220;
        const runEndX = originX + drawRun;
        const riseEndY = res.isDownhill ? originY + drawRise : originY - drawRise;

        if (badge) {
          badge.textContent = res.isDownhill ? "Downhill Profile" : "Uphill Profile";
