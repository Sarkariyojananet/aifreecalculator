          <circle cx="${runEndX}" cy="${originY}" r="4" fill="#1e293b"/>
          <circle cx="${runEndX}" cy="${riseEndY}" r="4" fill="#1e293b"/>
        `;

        svg.innerHTML = svgContent;
      }

      // ─── PURE CLIENT-SIDE MATH ENGINE ─────────────────────────────────────
      function executeCalculation() {
