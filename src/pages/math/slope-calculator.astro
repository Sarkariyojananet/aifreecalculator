      // Standalone client calculation logic mirroring slope.ts
      function calculateSlopeDirect(input) {
        const mode = input.mode;
        const unit = input.unit || "m";
        let rise = 0, run = 0, slopePct = 0, angleDeg = 0, decimalSlope = 0, hypotenuse = 0, pitchX = 0, pitchStr = "";
        const steps = [];

        function f(n, d) { return Number(n.toFixed(d || 3)).toString(); }

        if (mode === "rise_run") {
          const r = parseFloat(input.rise);
          const x = parseFloat(input.run);
          if (isNaN(r)) throw new Error("Please enter a valid number for rise.");
          if (isNaN(x) || x === 0) throw new Error("Horizontal run cannot be zero.");
          rise = r; run = x;
          decimalSlope = rise / run;
          slopePct = decimalSlope * 100;
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          pitchX = Math.abs(decimalSlope) * 12;
          steps.push(`Slope Ratio: m = Rise / Run = ${f(rise)} / ${f(run)} = ${f(decimalSlope, 4)}`);
          steps.push(`Slope Percentage: (Rise / Run) × 100 = (${f(rise)} / ${f(run)}) × 100 = ${f(slopePct, 3)}%`);
          steps.push(`Slope Angle: θ = arctan(m) = arctan(${f(decimalSlope, 4)}) = ${f(angleDeg, 3)}°`);
          steps.push(`Sloped Length: L = √(Rise² + Run²) = √(${f(rise)}² + ${f(run)}²) = ${f(hypotenuse, 3)} ${unit}`);
        } else if (mode === "rise_percentage") {
          const r = parseFloat(input.rise);
          const sp = parseFloat(input.slopePercentage);
          if (isNaN(r) || isNaN(sp) || sp === 0) throw new Error("Please enter valid non-zero values.");
          rise = r; slopePct = sp; decimalSlope = slopePct / 100;
          run = (rise * 100) / slopePct;
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          pitchX = Math.abs(decimalSlope) * 12;
          steps.push(`Run = (Rise × 100) / Slope % = (${f(rise)} × 100) / ${f(slopePct)} = ${f(run, 3)} ${unit}`);
          steps.push(`Angle θ = arctan(Slope % / 100) = arctan(${f(decimalSlope, 4)}) = ${f(angleDeg, 3)}°`);
        } else if (mode === "run_percentage") {
          const x = parseFloat(input.run);
          const sp = parseFloat(input.slopePercentage);
          if (isNaN(x) || isNaN(sp) || x === 0) throw new Error("Please enter valid values for run and slope %.");
          run = x; slopePct = sp; decimalSlope = slopePct / 100;
          rise = (run * slopePct) / 100;
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          pitchX = Math.abs(decimalSlope) * 12;
          steps.push(`Rise = Run × (Slope % / 100) = ${f(run)} × (${f(slopePct)} / 100) = ${f(rise, 3)} ${unit}`);
          steps.push(`Angle θ = arctan(${f(decimalSlope, 4)}) = ${f(angleDeg, 3)}°`);
        } else if (mode === "rise_angle") {
          const r = parseFloat(input.rise);
          const a = parseFloat(input.angleDeg);
          if (isNaN(r) || isNaN(a) || Math.abs(a) >= 90) throw new Error("Angle must be strictly between -90° and +90°.");
          rise = r; angleDeg = a;
          decimalSlope = Math.tan(angleDeg * Math.PI / 180);
          slopePct = decimalSlope * 100;
          run = rise / decimalSlope;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          pitchX = Math.abs(decimalSlope) * 12;
          steps.push(`Run = Rise / tan(θ) = ${f(rise)} / tan(${f(angleDeg)}°) = ${f(run, 3)} ${unit}`);
          steps.push(`Slope % = tan(${f(angleDeg)}°) × 100 = ${f(slopePct, 3)}%`);
        } else if (mode === "run_angle") {
          const x = parseFloat(input.run);
          const a = parseFloat(input.angleDeg);
          if (isNaN(x) || isNaN(a) || Math.abs(a) >= 90 || x === 0) throw new Error("Angle must be between -90° and +90° and run cannot be zero.");
          run = x; angleDeg = a;
          decimalSlope = Math.tan(angleDeg * Math.PI / 180);
          slopePct = decimalSlope * 100;
          rise = run * decimalSlope;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          pitchX = Math.abs(decimalSlope) * 12;
          steps.push(`Rise = Run × tan(θ) = ${f(run)} × tan(${f(angleDeg)}°) = ${f(rise, 3)} ${unit}`);
          steps.push(`Slope % = tan(${f(angleDeg)}°) × 100 = ${f(slopePct, 3)}%`);
        } else if (mode === "percentage_to_angle") {
          const sp = parseFloat(input.slopePercentage);
          if (isNaN(sp)) throw new Error("Please enter a valid slope percentage.");
          slopePct = sp; decimalSlope = slopePct / 100;
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          run = 100; rise = slopePct;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          pitchX = Math.abs(decimalSlope) * 12;
          steps.push(`Angle θ = arctan(Slope % / 100) = arctan(${f(decimalSlope, 4)}) = ${f(angleDeg, 3)}°`);
          steps.push(`Slope Ratio: 1 : ${f(100 / Math.abs(slopePct || 1), 2)}`);
        } else if (mode === "angle_to_percentage") {
          const a = parseFloat(input.angleDeg);
          if (isNaN(a) || Math.abs(a) >= 90) throw new Error("Angle must be strictly between -90° and +90°.");
          angleDeg = a;
          decimalSlope = Math.tan(angleDeg * Math.PI / 180);
          slopePct = decimalSlope * 100;
          run = 100; rise = decimalSlope * 100;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          pitchX = Math.abs(decimalSlope) * 12;
          steps.push(`Slope % = tan(${f(angleDeg)}°) × 100 = ${f(decimalSlope, 4)} × 100 = ${f(slopePct, 3)}%`);
        } else if (mode === "roof_pitch") {
          const px = parseFloat(input.pitchX);
          if (isNaN(px) || px < 0) throw new Error("Roof pitch rise X cannot be negative.");
          pitchX = px; decimalSlope = pitchX / 12; slopePct = decimalSlope * 100;
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          run = parseFloat(input.run) || 12;
          rise = run * decimalSlope;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          steps.push(`Pitch Designation: ${f(pitchX, 2)}:12`);
          steps.push(`Slope %: (${f(pitchX, 2)} / 12) × 100 = ${f(slopePct, 3)}%`);
          steps.push(`Roof Angle: arctan(${f(pitchX, 2)} / 12) = ${f(angleDeg, 3)}°`);
          steps.push(`Rafter Length (for Run = ${f(run)} ${unit}): L = √(${f(rise, 3)}² + ${f(run, 3)}²) = ${f(hypotenuse, 3)} ${unit}`);
        } else if (mode === "roof_rise_run") {
          const r = parseFloat(input.rise);
          const x = parseFloat(input.run);
          if (isNaN(r) || isNaN(x) || r < 0 || x <= 0) throw new Error("Roof rise and run must be positive numbers.");
          rise = r; run = x; decimalSlope = rise / run; slopePct = decimalSlope * 100;
          pitchX = decimalSlope * 12;
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          steps.push(`Pitch X = (Rise / Run) × 12 = (${f(rise)} / ${f(run)}) × 12 = ${f(pitchX, 2)} ➔ ${f(pitchX, 2)}:12 pitch`);
          steps.push(`Roof Angle = arctan(${f(decimalSlope, 4)}) = ${f(angleDeg, 3)}°`);
          steps.push(`Rafter Length L = √(${f(rise)}² + ${f(run)}²) = ${f(hypotenuse, 3)} ${unit}`);
        } else if (mode === "roof_rafter") {
          const x = parseFloat(input.run);
          const l = parseFloat(input.rafterLength);
          if (isNaN(x) || isNaN(l) || x <= 0 || l <= x) throw new Error("Sloped rafter length must be strictly greater than horizontal run.");
          run = x; hypotenuse = l;
          rise = Math.sqrt(hypotenuse * hypotenuse - run * run);
          decimalSlope = rise / run; slopePct = decimalSlope * 100; pitchX = decimalSlope * 12;
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          steps.push(`Vertical Rise = √(Rafter² − Run²) = √(${f(hypotenuse)}² − ${f(run)}²) = ${f(rise, 3)} ${unit}`);
          steps.push(`Derived Pitch: ${f(pitchX, 2)}:12`);
          steps.push(`Roof Angle = arctan(${f(decimalSlope, 4)}) = ${f(angleDeg, 3)}°`);
        } else if (mode === "ramp_rise_target") {
          const r = parseFloat(input.rise);
          const target = parseFloat(input.targetSlopePercentage);
          if (isNaN(r) || isNaN(target) || r <= 0 || target <= 0) throw new Error("Ramp rise and target slope % must be greater than zero.");
          rise = r; slopePct = target; decimalSlope = slopePct / 100;
          run = (rise * 100) / slopePct;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          pitchX = decimalSlope * 12;
          steps.push(`Required Run = (Rise × 100) / Target Slope % = (${f(rise)} × 100) / ${f(slopePct)} = ${f(run, 3)} ${unit}`);
          steps.push(`Ramp Surface Length L = √(${f(rise)}² + ${f(run, 3)}²) = ${f(hypotenuse, 3)} ${unit}`);
          steps.push(`Ramp Angle θ = arctan(${f(decimalSlope, 4)}) = ${f(angleDeg, 3)}°`);
        } else if (mode === "ramp_rise_run") {
          const r = parseFloat(input.rise);
          const x = parseFloat(input.run);
          if (isNaN(r) || isNaN(x) || r <= 0 || x <= 0) throw new Error("Ramp rise and run must be positive numbers.");
          rise = r; run = x; decimalSlope = rise / run; slopePct = decimalSlope * 100;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          pitchX = decimalSlope * 12;
          steps.push(`Actual Ramp Slope % = (${f(rise)} / ${f(run)}) × 100 = ${f(slopePct, 3)}%`);
          steps.push(`Ramp Slope Ratio: 1 : ${f(run / rise, 2)}`);
          steps.push(`Ramp Surface Length L = √(${f(rise)}² + ${f(run)}²) = ${f(hypotenuse, 3)} ${unit}`);
        } else if (mode === "ramp_run_target") {
          const x = parseFloat(input.run);
          const target = parseFloat(input.targetSlopePercentage);
          if (isNaN(x) || isNaN(target) || x <= 0 || target <= 0) throw new Error("Available run and target slope % must be greater than zero.");
          run = x; slopePct = target; decimalSlope = slopePct / 100;
          rise = (run * slopePct) / 100;
          hypotenuse = Math.sqrt(rise * rise + run * run);
          angleDeg = Math.atan(decimalSlope) * 180 / Math.PI;
          pitchX = decimalSlope * 12;
          steps.push(`Maximum Allowable Rise = Run × (Target % / 100) = ${f(run)} × (${f(slopePct)} / 100) = ${f(rise, 3)} ${unit}`);
          steps.push(`Ramp Surface Length L = √(${f(rise, 3)}² + ${f(run)}²) = ${f(hypotenuse, 3)} ${unit}`);
        }

        const normRatio = rise === 0 ? "0 : 1" : `1 : ${f(Math.abs(run / rise), 2)}`;

        return {
          mode: mode,
          category: activeCategory,
          unit: unit,
          rise: rise,
          run: run,
          decimalSlope: decimalSlope,
          slopePercentage: slopePct,
          angleDeg: angleDeg,
          angleRad: angleDeg * Math.PI / 180,
          slopeRatio: normRatio,
          hypotenuseLength: hypotenuse,
          pitchX: pitchX,
          pitchString: `${f(pitchX, 2)}:12`,
          isDownhill: rise < 0,
          steps: steps
        };
      }

      // ─── RENDER RESULTS ───────────────────────────────────────────────────
      function renderResults(res) {
        const wrap = document.getElementById("results-wrapper");
        if (!wrap) return;
        wrap.classList.remove("hidden");

        const heroVal = document.getElementById("hero-primary-val");
        const heroUnit = document.getElementById("hero-primary-unit");
        const heroBadge = document.getElementById("hero-badge");
        const heroCaption = document.getElementById("hero-caption");
        const heroPillAngle = document.getElementById("hero-pill-angle");
        const heroPillLength = document.getElementById("hero-pill-length");

        if (res.category === "roof") {
          if (heroBadge) heroBadge.textContent = "Roof Pitch Designation";
          if (heroVal) heroVal.textContent = res.pitchString;
          if (heroUnit) heroUnit.textContent = `(${res.slopePercentage.toFixed(2)}%)`;
          if (heroCaption) heroCaption.textContent = `Slope Angle: ${res.angleDeg.toFixed(2)}° | Rafter Length: ${res.hypotenuseLength.toFixed(3)} ${res.unit}`;
        } else if (res.category === "ramp") {
          if (heroBadge) heroBadge.textContent = "Wheelchair Ramp Slope";
          if (heroVal) heroVal.textContent = res.slopePercentage.toFixed(2);
          if (heroUnit) heroUnit.textContent = "%";
          if (heroCaption) {
            const adaText = res.slopePercentage <= 8.333 ? "Complies with standard 1:12 ADA maximum" : "Exceeds standard 1:12 (8.33%) maximum";
            heroCaption.textContent = `Ratio: ${res.slopeRatio} | ${adaText}`;
          }
        } else {
          if (heroBadge) heroBadge.textContent = "Calculated Slope Percentage";
          if (heroVal) heroVal.textContent = res.slopePercentage.toFixed(2);
          if (heroUnit) heroUnit.textContent = "%";
          if (heroCaption) {
            const dir = res.isDownhill ? "Downward descent" : "Upward incline";
            heroCaption.textContent = `${dir} | Equivalent Angle: ${res.angleDeg.toFixed(3)}° | Ratio: ${res.slopeRatio}`;
          }
        }

        if (heroPillAngle) heroPillAngle.textContent = `${res.angleDeg.toFixed(3)}°`;
        if (heroPillLength) heroPillLength.textContent = `${res.hypotenuseLength.toFixed(3)} ${res.unit}`;

        // Secondary matrix
        const setTxt = function (id, txt) {
          const el = document.getElementById(id);
          if (el) el.textContent = txt;
        };

        setTxt("res-rise", `${res.rise.toFixed(3)} ${res.unit}`);
        setTxt("res-run", `${res.run.toFixed(3)} ${res.unit}`);
        setTxt("res-ratio", res.slopeRatio);
        setTxt("res-decimal", res.decimalSlope.toFixed(4));
        setTxt("res-pitch", res.pitchString);
        setTxt("res-rad", `${res.angleRad.toFixed(4)} rad`);

        // Render steps
        const stepsEl = document.getElementById("steps-list");
        if (stepsEl) {
          stepsEl.innerHTML = res.steps
            .map(function (step) {
              return `<li class="leading-relaxed"><strong class="text-slate-900 dark:text-white">${step.split(":")[0]}:</strong>${step.split(":").slice(1).join(":")}</li>`;
            })
            .join("");
        }

        // Draw visualizer
        drawSlopeVisualizer(res);

        // Smooth scroll to hero result card
        requestAnimationFrame(function () {
          const card = document.getElementById("hero-result-card");
          if (card) {
            const rect = card.getBoundingClientRect();
            if (rect.top < 70 || rect.top > window.innerHeight * 0.5) {
              const targetY = window.pageYOffset + rect.top - 80;
              window.scrollTo({ top: Math.max(0, targetY), behavior: "smooth" });
            }
          }
        });
      }

      // ─── RESET (STRICT EMPTY STATE) ───────────────────────────────────────
      function resetCalculator() {
        document.getElementById("slope-form")?.reset();
        hideError();

        // Clear every numeric input value explicitly to ""
        document.querySelectorAll('input[type="number"]').forEach(function (inp) {
          inp.value = "";
        });

        // Hide results wrapper
        const wrap = document.getElementById("results-wrapper");
        if (wrap) wrap.classList.add("hidden");

        // Clear live SVG
        const svg = document.getElementById("live-slope-svg");
        if (svg) svg.innerHTML = "";

        updateStandardSubmodeFields();
        updatePercentageSubmodeFields();
        updateRoofSubmodeFields();
        updateRampSubmodeFields();
        updateUnitBadges();
      }

      // ─── EVENT LISTENERS & DEEP ROUTING ───────────────────────────────────
      function initListeners() {
        // Category tab buttons
        document.querySelectorAll(".category-tab").forEach(function (btn) {
          btn.addEventListener("click", function () {
            const cat = btn.getAttribute("data-category");
            if (cat) switchCategory(cat);
          });
        });

        // Radio submodes
        document.querySelectorAll('input[name="standard-submode"]').forEach(function (r) {
          r.addEventListener("change", updateStandardSubmodeFields);
        });
        document.querySelectorAll('input[name="pct-submode"]').forEach(function (r) {
          r.addEventListener("change", updatePercentageSubmodeFields);
        });
        document.querySelectorAll('input[name="roof-submode"]').forEach(function (r) {
          r.addEventListener("change", updateRoofSubmodeFields);
        });
        document.querySelectorAll('input[name="ramp-submode"]').forEach(function (r) {
          r.addEventListener("change", updateRampSubmodeFields);
        });

        // Unit selector
        document.getElementById("select-length-unit")?.addEventListener("change", updateUnitBadges);

        // Buttons
        document.getElementById("btn-calculate")?.addEventListener("click", function () {
          try {
            executeCalculation();
          } catch (err) {
            showError(err.message || "Calculation error. Please check your inputs.");
          }
        });

        document.getElementById("btn-reset")?.addEventListener("click", resetCalculator);

        // Check URL hash/search params: #mode=roof, #mode=ramp, #mode=percentage, #mode=standard
        const rawSlopeParams = (window.location.hash ? window.location.hash.replace(/^#/, '') : '') || (window.location.search ? window.location.search.replace(/^\?/, '') : '');
        const urlParams = new URLSearchParams(rawSlopeParams);
        const queryMode = urlParams.get("mode") || urlParams.get("category");
        if (queryMode) {
          const q = queryMode.toLowerCase();
          if (q === "roof" || q === "roof-slope") switchCategory("roof");
          else if (q === "ramp" || q === "wheelchair-ramp") switchCategory("ramp");
          else if (q === "percentage" || q === "slope-percentage") switchCategory("percentage");
          else if (q === "standard" || q === "rise-run") switchCategory("standard");
        }

        // Initialize state
        updateStandardSubmodeFields();
        updatePercentageSubmodeFields();
        updateRoofSubmodeFields();
        updateRampSubmodeFields();
        updateUnitBadges();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initListeners);
      } else {
        initListeners();
      }
    })();
  </script>


  

</CalculatorLayout>
