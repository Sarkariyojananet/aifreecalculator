  <!-- CLIENT-SIDE SCRIPT -->
  <script>
    function isPrime(n: number): boolean {
      if (n < 2) return false;
      if (n === 2 || n === 3) return true;
      if (n % 2 === 0 || n % 3 === 0) return false;
      for (let i = 5; i * i <= n; i += 6) {
        if (n % i === 0 || n % (i + 2) === 0) return false;
      }
      return true;
    }

    function nextPrime(p: number): number {
      let next = p + 1;
      while (!isPrime(next)) {
        next++;
      }
      return next;
    }

    function gcd(a: number, b: number): number {
      let x = Math.abs(a);
      let y = Math.abs(b);
      while (y !== 0) {
        const t = y;
        y = x % y;
        x = t;
      }
      return x;
    }

    function getPrimeFactors(n: number): Record<number, number> {
      const factors: Record<number, number> = {};
      let d = 2;
      let temp = n;
      while (d * d <= temp) {
        while (temp % d === 0) {
          factors[d] = (factors[d] || 0) + 1;
          temp = Math.floor(temp / d);
        }
        d = d === 2 ? 3 : d + 2;
      }
      if (temp > 1) {
        factors[temp] = (factors[temp] || 0) + 1;
      }
      return factors;
    }

    function getPrimeFactorsList(n: number): number[] {
      const list: number[] = [];
      let d = 2;
      let temp = n;
      while (d * d <= temp) {
        while (temp % d === 0) {
          list.push(d);
          temp = Math.floor(temp / d);
        }
        d = d === 2 ? 3 : d + 2;
      }
      if (temp > 1) {
        list.push(temp);
      }
      return list;
    }

    function formatFactorString(factors: Record<number, number>): string {
      const parts: string[] = [];
      const primes = Object.keys(factors).map(Number).sort((a, b) => a - b);
      for (const p of primes) {
        const exp = factors[p];
        if (exp === 1) {
          parts.push(`${p}`);
        } else {
          parts.push(`${p}<sup>${exp}</sup>`);
        }
      }
      return parts.join(' × ') || '1';
    }

    function initLcmCalculator() {
      const inputEl = document.getElementById('lcm-raw-input') as HTMLInputElement | null;
      const methodSelect = document.getElementById('lcm-method-select') as HTMLSelectElement | null;
      const btnCalc = document.getElementById('btn-lcm-calc') as HTMLButtonElement | null;
      const btnClear = document.getElementById('btn-lcm-clear') as HTMLButtonElement | null;
      const btnRecalc = document.getElementById('btn-recalculate') as HTMLButtonElement | null;
      const errorBox = document.getElementById('lcm-error-box');
      const staleNotice = document.getElementById('lcm-stale-notice');
      const resultsCard = document.getElementById('lcm-results-card');

      const resLcmVal = document.getElementById('res-lcm-value');
      const resLcmEq = document.getElementById('res-lcm-equation');
      const metricInputs = document.getElementById('metric-inputs');
      const metricGcf = document.getElementById('metric-gcf');
      const metricCount = document.getElementById('metric-count');
      const metricProduct = document.getElementById('metric-product');
      const methodBadge = document.getElementById('current-method-badge');

      const stepsContainer = document.getElementById('lcm-steps-container');
      const cardPrime = document.getElementById('card-step-prime');
      const cardGcf = document.getElementById('card-step-gcf');
      const cardMultiples = document.getElementById('card-step-multiples');
      const cardCake = document.getElementById('card-step-cake');
      const cardDivision = document.getElementById('card-step-division');
      const cardVenn = document.getElementById('card-step-venn');

      const stepPrimeDetails = document.getElementById('step-prime-details');
      const stepGcfDetails = document.getElementById('step-gcf-details');
      const stepMultiplesDetails = document.getElementById('step-multiples-details');
      const stepCakeDetails = document.getElementById('step-cake-details');
      const stepDivisionDetails = document.getElementById('step-division-details');
      const stepVennDetails = document.getElementById('step-venn-details');

      const btnCopy = document.getElementById('btn-copy-lcm');
      const btnPrint = document.getElementById('btn-print-lcm');

      if (!inputEl || !btnCalc) return;

      let hasCalculated = false;
      let lastCalculatedInput = '';
      let cachedNumbers: number[] = [];

      function showError(msg: string) {
        if (!errorBox) return;
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
        if (staleNotice) staleNotice.classList.add('hidden');
        if (resultsCard) resultsCard.classList.add('hidden');
      }

      function clearError() {
        if (!errorBox) return;
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
      }

      function updateStepVisibility(selectedMethod: string) {
        if (!stepsContainer) return;

        if (selectedMethod === 'none') {
          stepsContainer.classList.add('hidden');
          return;
        }

        stepsContainer.classList.remove('hidden');

        const allCards = [
          { el: cardPrime, key: 'prime', label: 'Method 1: Prime Factorization' },
          { el: cardGcf, key: 'gcf', label: 'Method 2: GCF Formula' },
          { el: cardMultiples, key: 'listing', label: 'Method 3: Listing Multiples' },
          { el: cardCake, key: 'cake', label: 'Method 4: Cake / Ladder Method' },
          { el: cardDivision, key: 'division', label: 'Method 5: Division Method' },
          { el: cardVenn, key: 'venn', label: 'Method 6: Venn Diagram' }
        ];

        if (methodBadge) {
          const match = allCards.find(c => c.key === selectedMethod);
          methodBadge.textContent = selectedMethod === 'all' ? 'Showing All Methods' : `Method: ${match ? match.label : 'Selected'}`;
        }

        for (const item of allCards) {
          if (!item.el) continue;
          if (selectedMethod === 'all' || selectedMethod === item.key) {
            item.el.classList.remove('hidden');
          } else {
            item.el.classList.add('hidden');
          }
        }
      }

      function renderCakeMethod(nums: number[]): string {
        if (nums.length < 2) return '';
        const current = [...nums];
        const steps: { divisor: number; quotients: number[] }[] = [];
        
        let iterations = 0;
        while (iterations < 60) {
          iterations++;
          const maxVal = Math.max(...current);
          let foundPrime = 0;
          let p = 2;
          while (p <= maxVal) {
            const count = current.filter(x => x % p === 0).length;
            if (count >= 2) {
              foundPrime = p;
              break;
            }
            p = nextPrime(p);
          }

          if (foundPrime === 0) break;

          for (let i = 0; i < current.length; i++) {
            if (current[i] % foundPrime === 0) {
              current[i] = current[i] / foundPrime;
            }
          }
          steps.push({ divisor: foundPrime, quotients: [...current] });
        }

        const divisors = steps.map(s => s.divisor);
        const bottomRow = current;

        let html = `
          <div class="space-y-2">
            <div class="text-xs text-slate-600 dark:text-slate-400">
              Divide layers by prime numbers that divide <strong>at least two numbers</strong> in the row, carrying down undividable values:
            </div>
            <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
              <table class="w-full text-left text-xs">
                <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-800/80 font-bold text-slate-800 dark:text-slate-200">
                  <tr>
                    <th class="p-2.5">Prime Divisor (Layer)</th>
                    ${nums.map((_, i) => `<th class="p-2.5 text-center">Col ${i + 1}</th>`).join('')}
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-mono text-slate-700 dark:text-slate-300">
                  <tr class="bg-slate-50/40 dark:bg-slate-900/40">
                    <td class="p-2.5 font-bold text-slate-400">Initial Row</td>
                    ${nums.map(n => `<td class="p-2.5 text-center font-bold text-slate-800 dark:text-slate-200">${n}</td>`).join('')}
                  </tr>
        `;

        for (const step of steps) {
          html += `
            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
              <td class="p-2.5 font-bold text-blue-700 dark:text-blue-400">${step.divisor}</td>
              ${step.quotients.map(q => `<td class="p-2.5 text-center">${q}</td>`).join('')}
            </tr>
          `;
        }

        html += `
                  <tr class="bg-amber-50/70 dark:bg-amber-950/40 font-bold text-amber-900 dark:text-amber-300">
                    <td class="p-2.5">Bottom Row</td>
                    ${bottomRow.map(b => `<td class="p-2.5 text-center">${b}</td>`).join('')}
                  </tr>
                </tbody>
              </table>
            </div>
        `;

        const lShapeTerms = [...divisors, ...bottomRow.filter(x => x > 1)];
        const lShapeProduct = lShapeTerms.reduce((acc, v) => acc * v, 1);

        html += `
            <div class="rounded-lg bg-blue-50/70 dark:bg-blue-950/40 p-2.5 font-mono text-xs text-blue-900 dark:text-blue-300 font-bold border border-blue-200/60 dark:border-blue-900/40">
              L-Shape Product = (${divisors.join(' × ') || '1'}) × (${bottomRow.join(' × ')}) = ${lShapeProduct.toLocaleString()}
            </div>
          </div>
        `;
        return html;
      }

      function renderDivisionMethod(nums: number[]): string {
        if (nums.length < 2) return '';
        const current = [...nums];
        const rows: { divisor: number; quotients: number[] }[] = [];
        
        let p = 2;
        let iterations = 0;
        while (!current.every(x => x === 1) && iterations < 80) {
          iterations++;
          const divides = current.some(x => x % p === 0);
          if (divides) {
            for (let i = 0; i < current.length; i++) {
              if (current[i] % p === 0) {
                current[i] = current[i] / p;
              }
            }
            rows.push({ divisor: p, quotients: [...current] });
          } else {
            p = nextPrime(p);
          }
        }

        let html = `
          <div class="space-y-2">
            <div class="text-xs text-slate-600 dark:text-slate-400">
              Divide rows by the lowest prime number that divides into at least one value, bringing down quotients and remaining values until all values reach 1:
            </div>
            <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
              <table class="w-full text-left text-xs">
                <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-800/80 font-bold text-slate-800 dark:text-slate-200">
                  <tr>
                    <th class="p-2.5">Prime Divisor (Col 1)</th>
                    ${nums.map(n => `<th class="p-2.5 text-center">${n}</th>`).join('')}
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-mono text-slate-700 dark:text-slate-300">
        `;

        for (const row of rows) {
          html += `
            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
              <td class="p-2.5 font-bold text-blue-700 dark:text-blue-400">${row.divisor}</td>
              ${row.quotients.map(q => `<td class="p-2.5 text-center">${q}</td>`).join('')}
            </tr>
          `;
        }

        const allDivisors = rows.map(r => r.divisor);
        const totalLcm = allDivisors.reduce((acc, v) => acc * v, 1);

        html += `
                </tbody>
              </table>
            </div>
            <div class="rounded-lg bg-blue-50/70 dark:bg-blue-950/40 p-2.5 font-mono text-xs text-blue-900 dark:text-blue-300 font-bold border border-blue-200/60 dark:border-blue-900/40">
              LCM = Product of Column 1 Primes = ${allDivisors.join(' × ')} = ${totalLcm.toLocaleString()}
            </div>
          </div>
        `;
        return html;
      }

      function renderVennDiagram(nums: number[]): string {
        if (nums.length < 2) return '';

        if (nums.length === 2) {
          const a = nums[0];
          const b = nums[1];
          const fa = getPrimeFactorsList(a);
          const fb = getPrimeFactorsList(b);

          const intersection: number[] = [];
          const onlyA = [...fa];
          const onlyB = [...fb];

          for (let i = onlyA.length - 1; i >= 0; i--) {
            const idx = onlyB.indexOf(onlyA[i]);
            if (idx !== -1) {
              intersection.push(onlyA[i]);
              onlyA.splice(i, 1);
              onlyB.splice(idx, 1);
            }
          }
          intersection.sort((x, y) => x - y);
          onlyA.sort((x, y) => x - y);
          onlyB.sort((x, y) => x - y);

          const allUnion = [...onlyA, ...intersection, ...onlyB].sort((x, y) => x - y);
          const lcmVal = allUnion.reduce((acc, v) => acc * v, 1);
          const gcfVal = intersection.length > 0 ? intersection.reduce((acc, v) => acc * v, 1) : 1;

          const strOnlyA = onlyA.length > 0 ? onlyA.join(' · ') : '';
          const strInter = intersection.length > 0 ? intersection.join(' · ') : '';
          const strOnlyB = onlyB.length > 0 ? onlyB.join(' · ') : '';

          return `
            <div class="space-y-3">
              <div class="text-xs text-slate-600 dark:text-slate-300">
                Visual 2-circle Venn diagram distribution for <strong>${a}</strong> and <strong>${b}</strong>:
              </div>

              <!-- Visual SVG Venn Diagram -->
              <div class="w-full overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950/80 p-2 sm:p-4 my-2 flex justify-center">
                <svg id="svg-lcm-venn-diagram" class="visual-diagram w-full h-auto max-w-lg" viewBox="0 0 500 240" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="vennGradA" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.32" />
                      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.16" />
                    </linearGradient>
                    <linearGradient id="vennGradB" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#a855f7" stop-opacity="0.32" />
                      <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.16" />
                    </linearGradient>
                  </defs>
                  <style>
                    .v-title-a { fill: #0284c7; font-weight: 800; font-size: 13px; font-family: system-ui, sans-serif; }
                    .v-title-b { fill: #7c3aed; font-weight: 800; font-size: 13px; font-family: system-ui, sans-serif; }
                    .v-title-mid { fill: #4338ca; font-weight: 700; font-size: 11px; font-family: system-ui, sans-serif; }
                    .v-num-a { fill: #0f172a; font-weight: 800; font-size: 16px; font-family: ui-monospace, SFMono-Regular, monospace; }
                    .v-num-mid { fill: #4338ca; font-weight: 900; font-size: 17px; font-family: ui-monospace, SFMono-Regular, monospace; }
                    .v-num-b { fill: #0f172a; font-weight: 800; font-size: 16px; font-family: ui-monospace, SFMono-Regular, monospace; }
                    .v-sub { fill: #64748b; font-size: 10px; font-family: system-ui, sans-serif; }
                    :global(.dark) .v-title-a, html.dark .v-title-a { fill: #38bdf8; }
                    :global(.dark) .v-title-b, html.dark .v-title-b { fill: #c084fc; }
                    :global(.dark) .v-title-mid, html.dark .v-title-mid { fill: #facc15; }
                    :global(.dark) .v-num-a, html.dark .v-num-a { fill: #f8fafc; }
                    :global(.dark) .v-num-mid, html.dark .v-num-mid { fill: #fef08a; }
                    :global(.dark) .v-num-b, html.dark .v-num-b { fill: #f8fafc; }
                    :global(.dark) .v-sub, html.dark .v-sub { fill: #94a3b8; }
                  </style>

                  <!-- Circle A -->
                  <circle cx="190" cy="120" r="95" fill="url(#vennGradA)" stroke="#0284c7" stroke-width="2.5" />
                  
                  <!-- Circle B -->
                  <circle cx="310" cy="120" r="95" fill="url(#vennGradB)" stroke="#7c3aed" stroke-width="2.5" />

                  <!-- Titles -->
                  <text x="145" y="36" text-anchor="middle" class="v-title-a">Set A (${a})</text>
                  <text x="355" y="36" text-anchor="middle" class="v-title-b">Set B (${b})</text>

                  <!-- Region 1: Only in A -->
                  ${strOnlyA ? `<text x="145" y="128" text-anchor="middle" class="v-num-a">${strOnlyA}</text>` : ''}

                  <!-- Region 2: Intersection -->
                  ${strInter ? `<text x="250" y="128" text-anchor="middle" class="v-num-mid">${strInter}</text>` : ''}

                  <!-- Region 3: Only in B -->
                  ${strOnlyB ? `<text x="355" y="128" text-anchor="middle" class="v-num-b">${strOnlyB}</text>` : ''}
                </svg>
              </div>

              <!-- Region Breakdown Chips -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                <div class="rounded-xl border border-sky-200 bg-sky-50/70 p-2.5 dark:border-sky-900/60 dark:bg-sky-950/40 text-center space-y-1">
                  <div class="font-bold text-sky-800 dark:text-sky-300">Factors Exclusive to ${a}</div>
                  <div class="font-mono text-sm font-bold text-slate-800 dark:text-slate-100">${strOnlyA || '— (None)'}</div>
                </div>
                <div class="rounded-xl border border-indigo-200 bg-indigo-50/70 p-2.5 dark:border-indigo-900/60 dark:bg-indigo-950/40 text-center space-y-1">
                  <div class="font-bold text-indigo-800 dark:text-indigo-300">Shared Factors (Intersection)</div>
                  <div class="font-mono text-sm font-bold text-indigo-700 dark:text-yellow-300">${strInter || '— (None)'}</div>
                  <div class="text-[10px] text-slate-500 dark:text-slate-400">GCF = ${gcfVal}</div>
                </div>
                <div class="rounded-xl border border-purple-200 bg-purple-50/70 p-2.5 dark:border-purple-900/60 dark:bg-purple-950/40 text-center space-y-1">
                  <div class="font-bold text-purple-800 dark:text-purple-300">Factors Exclusive to ${b}</div>
                  <div class="font-mono text-sm font-bold text-slate-800 dark:text-slate-100">${strOnlyB || '— (None)'}</div>
                </div>
              </div>

              <div class="rounded-lg bg-blue-50/70 dark:bg-blue-950/50 p-2.5 font-mono text-xs text-blue-900 dark:text-blue-300 font-bold border border-blue-200/60 dark:border-blue-900/50">
                LCM = Union of all prime factors = ${allUnion.join(' × ')} = ${lcmVal.toLocaleString()}
              </div>
            </div>
          `;
        } else if (nums.length === 3) {
          const [a, b, c] = nums;
          const fa = getPrimeFactorsList(a);
          const fb = getPrimeFactorsList(b);
          const fc = getPrimeFactorsList(c);

          const primes = Array.from(new Set([...fa, ...fb, ...fc])).sort((x, y) => x - y);
          
          const centerABC: number[] = [];
          const overlapAB: number[] = [];
          const overlapAC: number[] = [];
          const overlapBC: number[] = [];
          const onlyA: number[] = [];
          const onlyB: number[] = [];
          const onlyC: number[] = [];

          for (const p of primes) {
            let pa = fa.filter(x => x === p).length;
            let pb = fb.filter(x => x === p).length;
            let pc = fc.filter(x => x === p).length;

            const cAll = Math.min(pa, pb, pc);
            for (let i = 0; i < cAll; i++) centerABC.push(p);
            pa -= cAll;
            pb -= cAll;
            pc -= cAll;

            const cAB = Math.min(pa, pb);
            for (let i = 0; i < cAB; i++) overlapAB.push(p);
            pa -= cAB;
            pb -= cAB;

            const cAC = Math.min(pa, pc);
            for (let i = 0; i < cAC; i++) overlapAC.push(p);
            pa -= cAC;
            pc -= cAC;

            const cBC = Math.min(pb, pc);
            for (let i = 0; i < cBC; i++) overlapBC.push(p);
            pb -= cBC;
            pc -= cBC;

            for (let i = 0; i < pa; i++) onlyA.push(p);
            for (let i = 0; i < pb; i++) onlyB.push(p);
            for (let i = 0; i < pc; i++) onlyC.push(p);
          }

          const allUnion = [...centerABC, ...overlapAB, ...overlapAC, ...overlapBC, ...onlyA, ...onlyB, ...onlyC].sort((x, y) => x - y);
          const lcmVal = allUnion.reduce((acc, v) => acc * v, 1);
          const gcfVal = centerABC.length > 0 ? centerABC.reduce((acc, v) => acc * v, 1) : 1;

          const sCenter = centerABC.length > 0 ? centerABC.join(' · ') : '';
          const sAB = overlapAB.length > 0 ? overlapAB.join(' · ') : '';
          const sAC = overlapAC.length > 0 ? overlapAC.join(' · ') : '';
          const sBC = overlapBC.length > 0 ? overlapBC.join(' · ') : '';
          const sA = onlyA.length > 0 ? onlyA.join(' · ') : '';
          const sB = onlyB.length > 0 ? onlyB.join(' · ') : '';
          const sC = onlyC.length > 0 ? onlyC.join(' · ') : '';

          return `
            <div class="space-y-3">
              <div class="text-xs text-slate-600 dark:text-slate-300">
                Visual 3-circle Venn diagram showing prime factor distribution for <strong>${a}</strong>, <strong>${b}</strong>, and <strong>${c}</strong>:
              </div>

              <!-- Visual 3-Circle SVG Venn Diagram -->
              <div class="w-full overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950/80 p-2 sm:p-4 my-2 flex justify-center">
                <svg id="svg-lcm-venn-diagram" class="visual-diagram w-full h-auto max-w-md sm:max-w-lg" viewBox="0 0 540 400" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="venn3A" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.30" />
                      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.14" />
                    </linearGradient>
                    <linearGradient id="venn3B" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#c084fc" stop-opacity="0.30" />
                      <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.14" />
                    </linearGradient>
                    <linearGradient id="venn3C" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#34d399" stop-opacity="0.30" />
                      <stop offset="100%" stop-color="#059669" stop-opacity="0.14" />
                    </linearGradient>
                  </defs>
                  <style>
                    .v3-title-a { fill: #0284c7; font-weight: 800; font-size: 14px; font-family: system-ui, sans-serif; }
                    .v3-title-b { fill: #7c3aed; font-weight: 800; font-size: 14px; font-family: system-ui, sans-serif; }
                    .v3-title-c { fill: #059669; font-weight: 800; font-size: 14px; font-family: system-ui, sans-serif; }
                    .v3-num-main { fill: #0f172a; font-weight: 800; font-size: 18px; font-family: ui-monospace, SFMono-Regular, monospace; }
                    .v3-num-center { fill: #d97706; font-weight: 900; font-size: 20px; font-family: ui-monospace, SFMono-Regular, monospace; }
                    :global(.dark) .v3-title-a, html.dark .v3-title-a { fill: #38bdf8; }
                    :global(.dark) .v3-title-b, html.dark .v3-title-b { fill: #c084fc; }
                    :global(.dark) .v3-title-c, html.dark .v3-title-c { fill: #34d399; }
                    :global(.dark) .v3-num-main, html.dark .v3-num-main { fill: #f8fafc; }
                    :global(.dark) .v3-num-center, html.dark .v3-num-center { fill: #fde047; }
                  </style>

                  <!-- Circle A (Top Left) -->
                  <circle cx="210" cy="175" r="115" fill="url(#venn3A)" stroke="#0284c7" stroke-width="2.5" />

                  <!-- Circle B (Top Right) -->
                  <circle cx="330" cy="175" r="115" fill="url(#venn3B)" stroke="#7c3aed" stroke-width="2.5" />

                  <!-- Circle C (Bottom Center) -->
                  <circle cx="270" cy="265" r="115" fill="url(#venn3C)" stroke="#059669" stroke-width="2.5" />

                  <!-- Set Titles -->
                  <text x="140" y="46" text-anchor="middle" class="v3-title-a">Set A (${a})</text>
                  <text x="400" y="46" text-anchor="middle" class="v3-title-b">Set B (${b})</text>
                  <text x="270" y="398" text-anchor="middle" class="v3-title-c">Set C (${c})</text>

                  <!-- Center: Shared by all 3 (GCF) -->
                  ${sCenter ? `<text x="270" y="218" text-anchor="middle" class="v3-num-center">${sCenter}</text>` : ''}

                  <!-- Overlap AB -->
                  ${sAB ? `<text x="270" y="145" text-anchor="middle" class="v3-num-main">${sAB}</text>` : ''}

                  <!-- Overlap AC -->
                  ${sAC ? `<text x="205" y="246" text-anchor="middle" class="v3-num-main">${sAC}</text>` : ''}

                  <!-- Overlap BC -->
                  ${sBC ? `<text x="335" y="246" text-anchor="middle" class="v3-num-main">${sBC}</text>` : ''}

                  <!-- Only A -->
                  ${sA ? `<text x="150" y="175" text-anchor="middle" class="v3-num-main">${sA}</text>` : ''}

                  <!-- Only B -->
                  ${sB ? `<text x="390" y="175" text-anchor="middle" class="v3-num-main">${sB}</text>` : ''}

                  <!-- Only C -->
                  ${sC ? `<text x="270" y="332" text-anchor="middle" class="v3-num-main">${sC}</text>` : ''}
                </svg>
              </div>

              <!-- Region Breakdown Grid for all 7 regions -->
              <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2 text-xs">
                <div class="rounded-xl border border-amber-300 bg-amber-50/80 p-2 dark:border-amber-900/60 dark:bg-amber-950/50 text-center">
                  <div class="text-[10px] font-bold text-amber-800 dark:text-amber-300 uppercase">Center (All 3)</div>
                  <div class="font-mono font-bold text-amber-700 dark:text-yellow-300 mt-0.5">${sCenter || '—'}</div>
                  <div class="text-[9px] text-slate-500 dark:text-slate-400">GCF = ${gcfVal}</div>
                </div>
                <div class="rounded-xl border border-blue-200 bg-blue-50/70 p-2 dark:border-blue-900/60 dark:bg-blue-950/40 text-center">
                  <div class="text-[10px] font-bold text-blue-800 dark:text-blue-300 uppercase">${a} &amp; ${b} Only</div>
                  <div class="font-mono font-bold text-slate-800 dark:text-slate-100 mt-0.5">${sAB || '—'}</div>
                </div>
                <div class="rounded-xl border border-teal-200 bg-teal-50/70 p-2 dark:border-teal-900/60 dark:bg-teal-950/40 text-center">
                  <div class="text-[10px] font-bold text-teal-800 dark:text-teal-300 uppercase">${a} &amp; ${c} Only</div>
                  <div class="font-mono font-bold text-slate-800 dark:text-slate-100 mt-0.5">${sAC || '—'}</div>
                </div>
                <div class="rounded-xl border border-purple-200 bg-purple-50/70 p-2 dark:border-purple-900/60 dark:bg-purple-950/40 text-center">
                  <div class="text-[10px] font-bold text-purple-800 dark:text-purple-300 uppercase">${b} &amp; ${c} Only</div>
                  <div class="font-mono font-bold text-slate-800 dark:text-slate-100 mt-0.5">${sBC || '—'}</div>
                </div>
                <div class="rounded-xl border border-sky-200 bg-sky-50/70 p-2 dark:border-sky-900/60 dark:bg-sky-950/40 text-center">
                  <div class="text-[10px] font-bold text-sky-800 dark:text-sky-300 uppercase">Only in ${a}</div>
                  <div class="font-mono font-bold text-slate-800 dark:text-slate-100 mt-0.5">${sA || '—'}</div>
                </div>
                <div class="rounded-xl border border-violet-200 bg-violet-50/70 p-2 dark:border-violet-900/60 dark:bg-violet-950/40 text-center">
                  <div class="text-[10px] font-bold text-violet-800 dark:text-violet-300 uppercase">Only in ${b}</div>
                  <div class="font-mono font-bold text-slate-800 dark:text-slate-100 mt-0.5">${sB || '—'}</div>
                </div>
                <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 p-2 dark:border-emerald-900/60 dark:bg-emerald-950/40 text-center">
                  <div class="text-[10px] font-bold text-emerald-800 dark:text-emerald-300 uppercase">Only in ${c}</div>
                  <div class="font-mono font-bold text-slate-800 dark:text-slate-100 mt-0.5">${sC || '—'}</div>
                </div>
              </div>

              <div class="rounded-lg bg-blue-50/70 dark:bg-blue-950/50 p-2.5 font-mono text-xs text-blue-900 dark:text-blue-300 font-bold border border-blue-200/60 dark:border-blue-900/50">
                LCM = Product of all unique Venn regions = ${allUnion.join(' × ')} = ${lcmVal.toLocaleString()}
              </div>
            </div>
          `;
        } else {
          return `
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
              Geometric Venn diagrams are designed for sets of 2 or 3 numbers. For ${nums.length} numbers, please view the <strong>Method 1: Prime Factorization</strong> or <strong>Method 5: Division Method</strong> above.
            </div>
          `;
        }
      }

      function calculate() {
        clearError();
        const raw = (inputEl?.value || '').trim();

        if (!raw) {
          showError('Please enter at least two positive integers separated by commas or spaces.');
          return;
        }

        if (raw.includes('.')) {
          showError('Decimals are not permitted in standard integer LCM calculation. Please enter positive whole numbers.');
          return;
        }

        const tokens = raw.split(/[,;\s]+/).filter((t) => t.length > 0);

        if (tokens.length < 2) {
          showError('Please enter at least two numbers to calculate the least common multiple.');
          return;
        }

        const numbers: number[] = [];
        for (const token of tokens) {
          if (!/^\d+$/.test(token)) {
            showError(`Invalid character or token "${token}". Please enter positive integers only (e.g. 12, 18, 30).`);
            return;
          }
          const num = parseInt(token, 10);
          if (isNaN(num) || num <= 0) {
            showError(`Numbers must be positive integers greater than zero. Received: "${token}".`);
            return;
          }
          if (num > 10000000) {
            showError(`Number ${num.toLocaleString()} exceeds the maximum supported limit of 10,000,000.`);
            return;
          }
          numbers.push(num);
        }

        // Calculate LCM iteratively with overflow protection
        let currentLcm = numbers[0];
        let currentGcd = numbers[0];
        let totalProduct = 1;
        let productOverflow = false;

        const gcfSteps: { a: number; b: number; g: number; lcm: number; stepNum: number }[] = [];

        for (let i = 0; i < numbers.length; i++) {
          const n = numbers[i];
          if (!productOverflow) {
            if (totalProduct > Number.MAX_SAFE_INTEGER / n) {
              productOverflow = true;
            } else {
              totalProduct *= n;
            }
          }

          if (i > 0) {
            const prevLcm = currentLcm;
            const g = gcd(prevLcm, n);
            const nextLcm = Math.floor(prevLcm / g) * n;

            if (nextLcm > Number.MAX_SAFE_INTEGER) {
              showError('Calculation overflow: The resulting LCM exceeds JavaScript safe integer limit (9,007,199,254,740,991).');
              return;
            }

            gcfSteps.push({
              stepNum: i,
              a: prevLcm,
              b: n,
              g,
              lcm: nextLcm
            });

            currentLcm = nextLcm;
            currentGcd = gcd(currentGcd, n);
          }
        }

        // Factorization Breakdown
        const numFactors: { num: number; factors: Record<number, number>; formatted: string }[] = [];
        const maxPrimePowers: Record<number, number> = {};

        for (const num of numbers) {
          const f = getPrimeFactors(num);
          numFactors.push({
            num,
            factors: f,
            formatted: formatFactorString(f)
          });
          for (const [pStr, exp] of Object.entries(f)) {
            const p = Number(pStr);
            maxPrimePowers[p] = Math.max(maxPrimePowers[p] || 0, exp);
          }
        }

        // Render Primary Results
        if (resLcmVal) resLcmVal.textContent = currentLcm.toLocaleString();
        if (resLcmEq) resLcmEq.textContent = `= LCM(${numbers.join(', ')})`;
        if (metricInputs) metricInputs.textContent = numbers.join(', ');
        if (metricGcf) metricGcf.textContent = currentGcd.toLocaleString();
        if (metricCount) metricCount.textContent = numbers.length.toString();
        if (metricProduct) metricProduct.textContent = productOverflow ? '> Safe Integer Limit' : totalProduct.toLocaleString();

        // Render Method 1: Prime Factorization
        if (stepPrimeDetails) {
          const sortedPrimes = Object.keys(maxPrimePowers).map(Number).sort((a, b) => a - b);
          const maxParts: string[] = [];
          const expParts: string[] = [];
          let computedCheck = 1;

          for (const p of sortedPrimes) {
            const exp = maxPrimePowers[p];
            const powVal = Math.pow(p, exp);
            computedCheck *= powVal;
            if (exp === 1) {
              maxParts.push(`${p}`);
              expParts.push(`${p}`);
            } else {
              maxParts.push(`${p}<sup>${exp}</sup>`);
              expParts.push(`${powVal}`);
            }
          }

          let html = `
            <div class="space-y-2">
              <div class="font-semibold text-slate-800 dark:text-slate-200">1. Find the prime factorization of each number:</div>
              <ul class="font-mono space-y-1 pl-2 border-l-2 border-blue-200 dark:border-blue-900">
          `;
          for (const item of numFactors) {
            html += `<li><strong>${item.num}</strong> = ${item.formatted}</li>`;
          }
          html += `
              </ul>
              <div class="font-semibold text-slate-800 dark:text-slate-200 pt-1">2. Identify highest power for each unique prime factor:</div>
              <ul class="list-disc list-inside space-y-0.5 pl-1 text-slate-600 dark:text-slate-400">
          `;
          for (const p of sortedPrimes) {
            const exp = maxPrimePowers[p];
            html += `<li>Prime <strong>${p}</strong>: highest power is <strong>${p}<sup>${exp}</sup></strong> = ${Math.pow(p, exp)}</li>`;
          }
          html += `
              </ul>
              <div class="rounded-lg bg-blue-50/70 dark:bg-blue-950/40 p-2.5 font-mono text-blue-900 dark:text-blue-300 font-bold border border-blue-200/60 dark:border-blue-900/40">
                LCM = ${maxParts.join(' × ')} = ${expParts.join(' × ')} = ${currentLcm.toLocaleString()}
              </div>
            </div>
          `;
          stepPrimeDetails.innerHTML = html;
        }

        // Render Method 2: GCF Formula
        if (stepGcfDetails) {
          let html = `<div class="space-y-2">`;
          html += `<div class="text-slate-500 dark:text-slate-400 text-xs font-sans">Formula: <code>LCM(a, b) = (a × b) / GCF(a, b)</code></div>`;
          for (const step of gcfSteps) {
            html += `
              <div class="rounded-lg border border-slate-100 bg-slate-50/80 p-2 dark:border-slate-800 dark:bg-slate-950/50">
                <div class="font-bold text-slate-800 dark:text-slate-200">Step ${step.stepNum}: LCM(${step.a}, ${step.b})</div>
                <div class="text-slate-600 dark:text-slate-400 pl-2">
                  GCF(${step.a}, ${step.b}) = ${step.g}<br/>
                  LCM = (${step.a} × ${step.b}) / ${step.g} = ${step.a * step.b} / ${step.g} = <strong>${step.lcm.toLocaleString()}</strong>
                </div>
              </div>
            `;
          }
          html += `</div>`;
          stepGcfDetails.innerHTML = html;
        }

        // Render Method 3: Multiples Listing
        if (stepMultiplesDetails) {
          let html = `<div class="space-y-2">`;
          const maxMultCount = 10;
          for (const num of numbers) {
            const multiplesList: string[] = [];
            const countToShow = Math.min(Math.floor(currentLcm / num), maxMultCount);
            for (let m = 1; m <= countToShow; m++) {
              const val = num * m;
              if (val === currentLcm) {
                multiplesList.push(`<span class="font-bold text-blue-600 dark:text-blue-400 underline">${val}</span>`);
              } else {
                multiplesList.push(val.toString());
              }
            }
            if (currentLcm / num > maxMultCount) {
              multiplesList.push(`... <span class="font-bold text-blue-600 dark:text-blue-400 underline">${currentLcm.toLocaleString()}</span>`);
            }
            html += `
              <div class="font-mono text-xs">
                <strong>Multiples of ${num}:</strong> ${multiplesList.join(', ')}
              </div>
            `;
          }
          html += `
            <div class="text-xs text-slate-600 dark:text-slate-400 pt-1 font-sans">
              The smallest common multiple appearing on every list is <strong class="text-blue-600 dark:text-blue-400">${currentLcm.toLocaleString()}</strong>.
            </div>
          </div>`;
          stepMultiplesDetails.innerHTML = html;
        }

        // Render Method 4: Cake / Ladder Method
        if (stepCakeDetails) {
          stepCakeDetails.innerHTML = renderCakeMethod(numbers);
        }

        // Render Method 5: Division Method
        if (stepDivisionDetails) {
          stepDivisionDetails.innerHTML = renderDivisionMethod(numbers);
        }

        // Render Method 6: Venn Diagram
        if (stepVennDetails) {
          stepVennDetails.innerHTML = renderVennDiagram(numbers);
        }

        // Filter visible steps based on dropdown
        const selectedMethod = methodSelect?.value || 'prime';
        updateStepVisibility(selectedMethod);

        // State update
        hasCalculated = true;
        lastCalculatedInput = raw;
        cachedNumbers = numbers;

        // Reveal results card and hide stale notice
        if (staleNotice) staleNotice.classList.add('hidden');
        if (resultsCard) resultsCard.classList.remove('hidden');

        try {
          document.dispatchEvent(new CustomEvent('calculator:updated'));
        } catch (e) {}
      }

      // Event: Calculate Button
      btnCalc.addEventListener('click', calculate);

      // Event: Recalculate Button
      btnRecalc?.addEventListener('click', calculate);

      // Event: Dropdown Selection Change
      methodSelect?.addEventListener('change', () => {
        if (hasCalculated) {
          updateStepVisibility(methodSelect.value);
        }
      });

      // Event: Clear Button
      btnClear?.addEventListener('click', () => {
        if (inputEl) {
          inputEl.value = '';
          inputEl.focus();
        }
        hasCalculated = false;
        lastCalculatedInput = '';
        cachedNumbers = [];
        clearError();
        if (staleNotice) staleNotice.classList.add('hidden');
        if (resultsCard) resultsCard.classList.add('hidden');
        try {
          document.dispatchEvent(new CustomEvent('calculator:updated'));
        } catch (e) {}
      });

      // Event: Input Keydown (Enter to calculate)
      inputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          calculate();
        }
      });

      // Event: Input Value Change (Stale State Handling)
      inputEl.addEventListener('input', () => {
        if (hasCalculated) {
          const currentVal = inputEl.value.trim();
          if (currentVal !== lastCalculatedInput) {
            // Hide old output and show prompt to recalculate
            if (resultsCard) resultsCard.classList.add('hidden');
            if (staleNotice) staleNotice.classList.remove('hidden');
            try {
              document.dispatchEvent(new CustomEvent('calculator:updated'));
            } catch (e) {}
          } else {
            // Returned to identical calculated value
            if (resultsCard) resultsCard.classList.remove('hidden');
            if (staleNotice) staleNotice.classList.add('hidden');
            try {
              document.dispatchEvent(new CustomEvent('calculator:updated'));
            } catch (e) {}
          }
        }
      });

      // Event: Presets
      document.querySelectorAll<HTMLButtonElement>('.btn-lcm-preset').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-val');
          if (val && inputEl) {
            inputEl.value = val;
            if (staleNotice) staleNotice.classList.add('hidden');
            calculate();
          }
        });
      });

      // Copy Action
      btnCopy?.addEventListener('click', () => {
        const textToCopy = resLcmVal?.textContent || '';
        if (textToCopy) {
          navigator.clipboard.writeText(textToCopy).then(() => {
            const prev = btnCopy.innerHTML;
            btnCopy.innerHTML = '<span>✅</span> Copied!';
            setTimeout(() => {
              btnCopy.innerHTML = prev;
            }, 1500);
          });
        }
      });

      // Print Action
      btnPrint?.addEventListener('click', () => {
        const barPrintBtn = document.getElementById('btn-print-calc');
        if (barPrintBtn) {
          barPrintBtn.click();
        } else {
          window.print();
        }
      });

      // Note: Do NOT calculate automatically on initial page load!
      // The page starts clean with empty input and hidden results card.
    }

    // Run on initial load and Astro page transitions
    document.addEventListener('DOMContentLoaded', initLcmCalculator);
    document.addEventListener('astro:page-load', initLcmCalculator);
    if (document.readyState !== 'loading') {
      initLcmCalculator();
    }
  </script>
</CalculatorLayout>
