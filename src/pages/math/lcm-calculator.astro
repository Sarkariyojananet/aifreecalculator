import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const cakeMethodSteps = [
  { prime: "2", n1: "10", n2: "12", n3: "15", n4: "75", note: "Divides 10 and 12 evenly; bring down 15 and 75" },
  { prime: "3", n1: "5", n2: "6", n3: "15", n4: "75", note: "Divides 6, 15, and 75 evenly; bring down 5" },
  { prime: "5", n1: "5", n2: "2", n3: "5", n4: "25", note: "Divides 5, 5, and 25 evenly; bring down 2" },
  { prime: "—", n1: "1", n2: "2", n3: "1", n4: "5", note: "Final bottom row (no prime divides ≥ 2 numbers)" }
];

const divisionMethodSteps = [
  { prime: "2", n1: "10", n2: "18", n3: "25", note: "Divide by lowest prime 2 (divides 10, 18)" },
  { prime: "3", n1: "5", n2: "9", n3: "25", note: "Divide by 3 (divides 9)" },
  { prime: "3", n1: "5", n2: "3", n3: "25", note: "Divide by 3 (divides 3)" },
  { prime: "5", n1: "5", n2: "1", n3: "25", note: "Divide by 5 (divides 5, 25)" },
  { prime: "5", n1: "1", n2: "1", n3: "5", note: "Divide by 5 (divides 5)" },
  { prime: "—", n1: "1", n2: "1", n3: "1", note: "All quotients are 1; division complete" }
];

const methodsComparison = [
  {
    name: "Listing Multiples",
    bestFor: "2 to 3 small numbers (e.g. 6, 10)",
    speed: "Slow for large numbers",
    keyAdvantage: "Visual and intuitive; great for learning"
  },
  {
    name: "Prime Factorization & Exponents",
    bestFor: "Any number of integers of moderate size",
    speed: "Fast and systematic",
    keyAdvantage: "Guarantees exact minimal product of highest prime powers"
  },
  {
    name: "Greatest Common Factor (GCF) Formula",
    bestFor: "Two large numbers or fast iterative computation",
    speed: "Extremely fast (Euclidean algorithm)",
    keyAdvantage: "Avoids full prime factoring; computationally optimal"
  },
  {
    name: "Cake / Ladder Method",
    bestFor: "Classroom math and 3 to 5 numbers",
    speed: "Quick manual calculation",
    keyAdvantage: "Compact grid requiring only simple division"
  },
  {
    name: "Division Method",
    bestFor: "Systematic manual division for multiple numbers",
    speed: "Reliable and organized",
    keyAdvantage: "Stops cleanly when all numbers reach 1"
  },
  {
    name: "Venn Diagram",
    bestFor: "Visualizing 2 or 3 numbers",
    speed: "Conceptual / pedagogical",
    keyAdvantage: "Clear visual of shared factors (GCF) vs total union (LCM)"
  }
];
