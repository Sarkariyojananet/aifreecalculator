  const badgeX0 = document.getElementById('badge-x0-target') as HTMLSpanElement;
  const badgeRate = document.getElementById('badge-rate-target') as HTMLSpanElement;
  const badgeTime = document.getElementById('badge-time-target') as HTMLSpanElement;
  const badgeXt = document.getElementById('badge-xt-target') as HTMLSpanElement;

  const btnCalculate = document.getElementById('btn-calculate') as HTMLButtonElement;
  const btnClear = document.getElementById('btn-clear') as HTMLButtonElement;
  const growthError = document.getElementById('growth-error') as HTMLParagraphElement;

  const resultsPlaceholder = document.getElementById('results-placeholder') as HTMLDivElement;
  const resultsCard = document.getElementById('results-card') as HTMLDivElement;

  const resTargetLabel = document.getElementById('res-target-label') as HTMLSpanElement;
  const resPrimaryVal = document.getElementById('res-primary-val') as HTMLSpanElement;
  const resNatureBadge = document.getElementById('res-nature-badge') as HTMLSpanElement;
  const resDoublingTag = document.getElementById('res-doubling-tag') as HTMLSpanElement;
  const resSubtitle = document.getElementById('res-subtitle') as HTMLParagraphElement;

  const resFactor = document.getElementById('res-factor') as HTMLSpanElement;
  const resK = document.getElementById('res-k') as HTMLSpanElement;
  const resAbsChange = document.getElementById('res-abs-change') as HTMLSpanElement;

  const statX0 = document.getElementById('stat-x0') as HTMLDivElement;
  const statRate = document.getElementById('stat-rate') as HTMLDivElement;
  const statTime = document.getElementById('stat-time') as HTMLDivElement;
  const statPct = document.getElementById('stat-pct') as HTMLDivElement;

  const selectTimeUnit = document.getElementById('select-time-unit') as HTMLSelectElement;
  const unitLabelInput = document.getElementById('unit-label-input') as HTMLSpanElement;

  const resSteps = document.getElementById('res-steps') as HTMLOListElement;
  const tableBody = document.getElementById('table-body') as HTMLTableSectionElement;
  const tableBadgeRows = document.getElementById('table-badge-rows') as HTMLSpanElement;

  const svgPath = document.getElementById('svg-path') as unknown as SVGPathElement;
  const svgDotStart = document.getElementById('svg-dot-start') as unknown as SVGCircleElement;
  const svgDotEnd = document.getElementById('svg-dot-end') as unknown as SVGCircleElement;
  const curveRangeLabel = document.getElementById('curve-range-label') as HTMLSpanElement;
  const labelPlotStart = document.getElementById('label-plot-start') as HTMLSpanElement;
  const labelPlotEnd = document.getElementById('label-plot-end') as HTMLSpanElement;

  function updateTargetMode(target: SolveForTarget) {
    currentTarget = target;

    solveTabs.forEach((tab) => {
      const isTarget = tab.getAttribute('data-target') === target;
      if (isTarget) {
        tab.classList.add('active', 'border-t', 'border-x', 'border-slate-300/90', 'bg-white', 'text-slate-900', 'shadow-2xs', '-mb-px', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-white');
        tab.classList.remove('bg-blue-700/90', 'text-white', 'hover:bg-blue-800', 'dark:bg-blue-800', 'dark:hover:bg-blue-700');
      } else {
        tab.classList.remove('active', 'border-t', 'border-x', 'border-slate-300/90', 'bg-white', 'text-slate-900', 'shadow-2xs', '-mb-px', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-white');
        tab.classList.add('bg-blue-700/90', 'text-white', 'hover:bg-blue-800', 'dark:bg-blue-800', 'dark:hover:bg-blue-700');
      }
    });

    // Reset all 4 inputs to active style
    [inputX0, inputRate, inputTime, inputXt].forEach((inp) => {
      inp.disabled = false;
      inp.classList.remove('border-dashed', 'bg-slate-100/70', 'dark:bg-slate-900/60', 'cursor-not-allowed', 'text-slate-500');
      inp.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white');
    });

    badgeX0.textContent = 'baseline quantity at t = 0';
    badgeX0.className = 'text-xs font-medium text-slate-500 dark:text-slate-400';
    badgeRate.textContent = 'positive (+) for growth, negative (−) for decay';
    badgeRate.className = 'text-xs font-medium text-slate-500 dark:text-slate-400';
    badgeTime.textContent = 'elapsed duration';
    badgeTime.className = 'text-xs font-medium text-slate-500 dark:text-slate-400';
    badgeXt.textContent = 'accumulated quantity';
    badgeXt.className = 'text-xs font-medium text-slate-500 dark:text-slate-400';

    // Disable target input and mark with Target badge
    let targetInput: HTMLInputElement;
    let targetBadge: HTMLSpanElement;

    if (target === 'final') {
      targetInput = inputXt;
      targetBadge = badgeXt;
      solveModeSubtitle.textContent = 'Target: Solve for Final Quantity x(t)';
      resTargetLabel.textContent = 'Calculated Final Quantity x(t)';
      inputXt.placeholder = 'To be calculated';
      inputX0.placeholder = 'Enter initial value';
      inputRate.placeholder = 'e.g. 5 or -10';
      inputTime.placeholder = 'Enter periods';
    } else if (target === 'initial') {
      targetInput = inputX0;
      targetBadge = badgeX0;
      solveModeSubtitle.textContent = 'Target: Solve for Initial Quantity x₀';
      resTargetLabel.textContent = 'Calculated Initial Quantity x₀';
      inputX0.placeholder = 'To be calculated';
      inputXt.placeholder = 'Enter final quantity';
      inputRate.placeholder = 'e.g. 5 or -10';
      inputTime.placeholder = 'Enter periods';
    } else if (target === 'rate') {
      targetInput = inputRate;
      targetBadge = badgeRate;
      solveModeSubtitle.textContent = 'Target: Solve for Growth / Decay Rate (r)';
      resTargetLabel.textContent = 'Calculated Growth / Decay Rate (r)';
      inputRate.placeholder = 'To be calculated';
      inputX0.placeholder = 'Enter initial value';
      inputXt.placeholder = 'Enter final quantity';
      inputTime.placeholder = 'Enter periods';
    } else {
      targetInput = inputTime;
      targetBadge = badgeTime;
      solveModeSubtitle.textContent = 'Target: Solve for Time / Periods (t)';
      resTargetLabel.textContent = 'Calculated Time / Periods (t)';
      inputTime.placeholder = 'To be calculated';
      inputX0.placeholder = 'Enter initial value';
      inputXt.placeholder = 'Enter final quantity';
      inputRate.placeholder = 'e.g. 5 or -10';
    }

    targetInput.value = '';
    targetInput.disabled = true;
    targetInput.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white');
    targetInput.classList.add('border-dashed', 'bg-slate-100/70', 'dark:bg-slate-900/60', 'cursor-not-allowed', 'text-slate-500');

    targetBadge.textContent = 'Target to Solve';
    targetBadge.className = 'rounded-full bg-blue-100 px-2.5 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300';

    growthError.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');

    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');
  }

  solveTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-target') as SolveForTarget;
      if (target) updateTargetMode(target);
    });
  });

  // Unit dropdown update
  selectTimeUnit?.addEventListener('change', () => {
    unitLabelInput.textContent = selectTimeUnit.value;
    if (!resultsCard.classList.contains('hidden')) {
      runCalculation();
    }
  });

  // 2. Perform Calculation
  function runCalculation() {
    growthError.classList.add('hidden');
    growthError.textContent = '';
    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');

    const x0Val = inputX0.value.trim();
    const rateVal = inputRate.value.trim();
    const timeVal = inputTime.value.trim();
    const xtVal = inputXt.value.trim();

    // Check required fields based on current target
    if (currentTarget === 'final') {
      if (!x0Val) {
        growthError.textContent = 'Please enter the initial quantity (x₀).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputX0.focus();
        return;
      }
      if (!rateVal) {
        growthError.textContent = 'Please enter the growth/decay rate (r %).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputRate.focus();
        return;
      }
      if (!timeVal) {
        growthError.textContent = 'Please enter the time / number of periods (t).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputTime.focus();
        return;
      }
    } else if (currentTarget === 'initial') {
      if (!xtVal) {
        growthError.textContent = 'Please enter the final quantity x(t).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputXt.focus();
        return;
      }
      if (!rateVal) {
        growthError.textContent = 'Please enter the growth/decay rate (r %).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputRate.focus();
        return;
      }
      if (!timeVal) {
        growthError.textContent = 'Please enter the time / number of periods (t).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputTime.focus();
        return;
      }
    } else if (currentTarget === 'rate') {
      if (!x0Val) {
        growthError.textContent = 'Please enter the initial quantity (x₀).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputX0.focus();
        return;
      }
      if (!xtVal) {
        growthError.textContent = 'Please enter the final quantity x(t).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputXt.focus();
        return;
      }
      if (!timeVal) {
        growthError.textContent = 'Please enter the time / number of periods (t).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputTime.focus();
        return;
      }
    } else if (currentTarget === 'time') {
      if (!x0Val) {
        growthError.textContent = 'Please enter the initial quantity (x₀).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputX0.focus();
        return;
      }
      if (!xtVal) {
        growthError.textContent = 'Please enter the target/final quantity x(t).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputXt.focus();
        return;
      }
      if (!rateVal) {
        growthError.textContent = 'Please enter the growth/decay rate (r %).';
        growthError.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        resultsPlaceholder.classList.remove('hidden');
        inputRate.focus();
        return;
      }
    }

    try {
      const result = calculateExponentialGrowth({
        solveFor: currentTarget,
        initialQuantity: x0Val,
        growthRate: rateVal,
        timePeriods: timeVal,
        finalQuantity: xtVal,
      });

      // Write back solved value into target field
      if (currentTarget === 'final') inputXt.value = String(result.finalQuantity);
      else if (currentTarget === 'initial') inputX0.value = String(result.initialQuantity);
      else if (currentTarget === 'rate') inputRate.value = String(result.growthRatePercent);
      else if (currentTarget === 'time') inputTime.value = String(result.timePeriods);

      const timeUnit = selectTimeUnit.value;

      // Update primary banner
      if (currentTarget === 'final') {
        resPrimaryVal.textContent = formatNum(result.finalQuantity);
        resSubtitle.textContent = `Starting from ${formatNum(result.initialQuantity)} over ${formatNum(result.timePeriods)} ${timeUnit}`;
      } else if (currentTarget === 'initial') {
        resPrimaryVal.textContent = formatNum(result.initialQuantity);
        resSubtitle.textContent = `Required to reach ${formatNum(result.finalQuantity)} in ${formatNum(result.timePeriods)} ${timeUnit}`;
      } else if (currentTarget === 'rate') {
        resPrimaryVal.textContent = `${result.growthRatePercent > 0 ? '+' : ''}${formatNum(result.growthRatePercent, 4)}%`;
        resSubtitle.textContent = `Per ${timeUnit.slice(0, -1) || 'period'} to change from ${formatNum(result.initialQuantity)} to ${formatNum(result.finalQuantity)}`;
      } else {
        resPrimaryVal.textContent = `${formatNum(result.timePeriods, 4)} ${timeUnit}`;
        resSubtitle.textContent = `Time elapsed from ${formatNum(result.initialQuantity)} to ${formatNum(result.finalQuantity)} at ${formatNum(result.growthRatePercent)}%`;
      }

      // Badges
      if (result.isGrowth) {
        resNatureBadge.textContent = 'Exponential Growth ⚡';
        resNatureBadge.className = 'rounded-full bg-emerald-100 px-3.5 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300';
      } else if (result.isDecay) {
        resNatureBadge.textContent = 'Exponential Decay 📉';
        resNatureBadge.className = 'rounded-full bg-rose-100 px-3.5 py-1 text-xs font-bold text-rose-800 dark:bg-rose-950/80 dark:text-rose-300';
      } else if (result.isDepleted) {
        resNatureBadge.textContent = 'Total Depletion (-100%)';
        resNatureBadge.className = 'rounded-full bg-slate-200 px-3.5 py-1 text-xs font-bold text-slate-800 dark:bg-slate-800 dark:text-slate-200';
      } else {
        resNatureBadge.textContent = 'Zero Growth (Constant)';
        resNatureBadge.className = 'rounded-full bg-slate-100 px-3.5 py-1 text-xs font-bold text-slate-800 dark:bg-slate-800 dark:text-slate-300';
      }

      resDoublingTag.textContent = result.doublingTimeOrHalfLife.label;

      // Stats
      resFactor.textContent = formatNum(result.growthFactor, 5);
      resK.textContent = formatNum(result.continuousRateK, 5);
      resAbsChange.textContent = `${result.totalChange >= 0 ? '+' : ''}${formatNum(result.totalChange, 4)}`;

      statX0.textContent = formatNum(result.initialQuantity);
      statRate.textContent = `${result.growthRatePercent >= 0 ? '+' : ''}${formatNum(result.growthRatePercent, 2)}%`;
      statTime.textContent = `${formatNum(result.timePeriods, 2)} ${timeUnit}`;
      statPct.textContent = `${result.totalPercentageChange >= 0 ? '+' : ''}${formatNum(result.totalPercentageChange, 2)}%`;

      // Step by step
      resSteps.innerHTML = '';
      result.steps.forEach((step) => {
        const li = document.createElement('li');
        li.textContent = step;
        resSteps.appendChild(li);
      });

      // Table
      tableBody.innerHTML = '';
      result.table.forEach((row) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-900/60 transition-colors';
        tr.innerHTML = `
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">${row.period}</td>
          <td class="p-2.5 text-emerald-600 dark:text-emerald-400 font-bold">${row.quantityFormatted}</td>
          <td class="p-2.5 ${row.changeFromPrevious >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}">${row.changeFromPrevious >= 0 ? '+' : ''}${formatNum(row.changeFromPrevious)}</td>
          <td class="p-2.5 text-slate-500">${row.percentFromPrevious >= 0 ? '+' : ''}${row.percentFromPrevious}%</td>
        `;
        tableBody.appendChild(tr);
      });
      tableBadgeRows.textContent = `${result.table.length} rows`;

      // SVG Curve Plot
      renderSvgPlot(result);

      // Reveal Results Card and hide placeholder
      resultsPlaceholder.classList.add('hidden');
      resultsCard.classList.remove('hidden');

      // Reveal "Save or share this calculation" directly below the generated results
      const bar = document.getElementById('calc-action-bar-container');
      if (bar) bar.classList.remove('hidden');
    } catch (err: any) {
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      const bar = document.getElementById('calc-action-bar-container');
      if (bar) bar.classList.add('hidden');
      growthError.textContent = err?.message || 'Invalid input values.';
      growthError.classList.remove('hidden');
    }
  }

  function renderSvgPlot(res: any) {
    if (!res.svgPoints || res.svgPoints.length === 0) return;

    const points = res.svgPoints;
    const minX = points[0].x;
    const maxX = points[points.length - 1].x;
    let minY = Infinity;
    let maxY = -Infinity;

    points.forEach((p: { x: number; y: number }) => {
      if (p.y < minY) minY = p.y;
      if (p.y > maxY) maxY = p.y;
    });

    if (minY === maxY) {
      minY -= 1;
      maxY += 1;
    }

    const padY = (maxY - minY) * 0.1 || 1;
    const effMinY = minY - padY;
    const effMaxY = maxY + padY;

    const scaleX = (x: number) => ((x - minX) / (maxX - minX || 1)) * 480 + 10;
    const scaleY = (y: number) => 190 - ((y - effMinY) / (effMaxY - effMinY || 1)) * 170;

    let pathD = '';
    points.forEach((p: { x: number; y: number }, idx: number) => {
      const sx = scaleX(p.x);
      const sy = scaleY(p.y);
      if (idx === 0) pathD += `M ${sx.toFixed(1)} ${sy.toFixed(1)}`;
      else pathD += ` L ${sx.toFixed(1)} ${sy.toFixed(1)}`;
    });

    svgPath.setAttribute('d', pathD);
    svgPath.setAttribute('stroke', res.isDecay ? '#e11d48' : '#10b981');

    // Dots for start (t=0) and end (t=timePeriods)
    const dotStartX = scaleX(0);
    const dotStartY = scaleY(res.initialQuantity);
    svgDotStart.setAttribute('cx', String(dotStartX.toFixed(1)));
    svgDotStart.setAttribute('cy', String(dotStartY.toFixed(1)));

    const dotEndX = scaleX(res.timePeriods);
    const dotEndY = scaleY(res.finalQuantity);
    svgDotEnd.setAttribute('cx', String(dotEndX.toFixed(1)));
    svgDotEnd.setAttribute('cy', String(dotEndY.toFixed(1)));
    svgDotEnd.setAttribute('fill', res.isDecay ? '#e11d48' : '#10b981');

    const unit = selectTimeUnit.value;
    curveRangeLabel.textContent = `${formatNum(minX, 1)} to ${formatNum(maxX, 1)} ${unit}`;
    labelPlotStart.textContent = `t = 0 (x₀ = ${formatNum(res.initialQuantity)})`;
    labelPlotEnd.textContent = `t = ${formatNum(res.timePeriods, 1)} (x(t) = ${formatNum(res.finalQuantity)})`;
  }

  btnCalculate?.addEventListener('click', runCalculation);

  btnClear?.addEventListener('click', () => {
    inputX0.value = '';
    inputRate.value = '';
    inputTime.value = '';
    inputXt.value = '';
    growthError.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');
    if (currentTarget === 'final') inputX0.focus();
    else if (currentTarget === 'initial') inputXt.focus();
    else inputX0.focus();
  });

  // Enter key listener on inputs
  document.querySelectorAll('#growth-form input').forEach((inp) => {
    inp.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        btnCalculate?.click();
      }
    });
  });

  // INITIAL STATE: ALL INPUTS ARE EMPTY (value="").
  // RESULTS PLACEHOLDER IS VISIBLE. RESULTS CARD IS HIDDEN.
  // NO AUTO-CALCULATION ON LOAD!
</script>
