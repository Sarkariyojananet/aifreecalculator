<script>
  import {
    calculateExponentialGrowth,
    formatNum,
    type SolveForTarget,
  } from '../../lib/calculators/exponential-growth';

  // 1. Solve-For State & Tabs
  let currentTarget: SolveForTarget = 'final';

  const solveTabs = document.querySelectorAll('.solve-tab');
  const solveModeSubtitle = document.getElementById('solve-mode-subtitle') as HTMLSpanElement;

  const inputX0 = document.getElementById('input-x0') as HTMLInputElement;
  const inputRate = document.getElementById('input-rate') as HTMLInputElement;
