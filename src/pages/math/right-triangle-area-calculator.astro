  const triangleError = document.getElementById('triangle-error') as HTMLParagraphElement;

  const resultsPlaceholder = document.getElementById('results-placeholder') as HTMLDivElement;
  const resultsCard = document.getElementById('results-card') as HTMLDivElement;

  const resAreaVal = document.getElementById('res-area-val') as HTMLSpanElement;
  const resAreaUnit = document.getElementById('res-area-unit') as HTMLSpanElement;
  const resSpecialTag = document.getElementById('res-special-tag') as HTMLSpanElement;
  const resSubtitle = document.getElementById('res-subtitle') as HTMLParagraphElement;
  const resPerimeter = document.getElementById('res-perimeter') as HTMLSpanElement;
  const resHypotenuseStat = document.getElementById('res-hypotenuse-stat') as HTMLSpanElement;
  const resAltitude = document.getElementById('res-altitude') as HTMLSpanElement;

  const statLegA = document.getElementById('stat-leg-a') as HTMLSpanElement;
  const statLegB = document.getElementById('stat-leg-b') as HTMLSpanElement;
  const statAngleAlpha = document.getElementById('stat-angle-alpha') as HTMLSpanElement;
  const statAngleBeta = document.getElementById('stat-angle-beta') as HTMLSpanElement;

  const resSteps = document.getElementById('res-steps') as HTMLOListElement;
  const tableUnitsBody = document.getElementById('table-units-body') as HTMLTableSectionElement;

  // SVG elements
  const svgPoly = document.getElementById('svg-poly') as unknown as SVGPolygonElement;
  const svgRightBox = document.getElementById('svg-right-box') as unknown as SVGPathElement;
  const svgRightDot = document.getElementById('svg-right-dot') as unknown as SVGCircleElement;
  const svgLabelA = document.getElementById('svg-label-a') as unknown as SVGTextElement;
  const svgLabelB = document.getElementById('svg-label-b') as unknown as SVGTextElement;
  const svgLabelC = document.getElementById('svg-label-c') as unknown as SVGTextElement;
  const svgLabelAlpha = document.getElementById('svg-label-alpha') as unknown as SVGTextElement;
  const svgLabelBeta = document.getElementById('svg-label-beta') as unknown as SVGTextElement;

  // 2. Tab Switching
  function switchMode(mode: RightTriangleMode) {
    currentMode = mode;

    modeTabs.forEach((tab) => {
      const isTarget = tab.getAttribute('data-mode') === mode;
      if (isTarget) {
        tab.classList.add('active', 'border-t', 'border-x', 'border-slate-300/90', 'bg-white', 'text-slate-900', 'shadow-2xs', '-mb-px', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-white');
        tab.classList.remove('bg-blue-700/90', 'text-white', 'hover:bg-blue-800', 'dark:bg-blue-800', 'dark:hover:bg-blue-700');
      } else {
        tab.classList.remove('active', 'border-t', 'border-x', 'border-slate-300/90', 'bg-white', 'text-slate-900', 'shadow-2xs', '-mb-px', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-white');
        tab.classList.add('bg-blue-700/90', 'text-white', 'hover:bg-blue-800', 'dark:bg-blue-800', 'dark:hover:bg-blue-700');
      }
    });

    // Hide all mode rows initially
    rowLegA.classList.add('hidden');
    rowLegB.classList.add('hidden');
    rowLegChoice.classList.add('hidden');
    rowSingleLeg.classList.add('hidden');
    rowHypotenuse.classList.add('hidden');
    rowAngleType.classList.add('hidden');
    rowAngleVal.classList.add('hidden');
    wrapperAngleUnit.classList.add('hidden');

    if (mode === 'two_legs') {
      modeSubtitle.textContent = 'Known: Perpendicular Legs a and b';
      rowLegA.classList.remove('hidden');
      rowLegB.classList.remove('hidden');
    } else if (mode === 'leg_hypotenuse') {
      modeSubtitle.textContent = 'Known: One Leg (a or b) and Hypotenuse c';
      rowLegChoice.classList.remove('hidden');
      rowSingleLeg.classList.remove('hidden');
      rowHypotenuse.classList.remove('hidden');
      updateSingleLegLabel();
    } else if (mode === 'hypotenuse_angle') {
      modeSubtitle.textContent = 'Known: Hypotenuse c and Acute Angle (α or β)';
      rowHypotenuse.classList.remove('hidden');
      rowAngleType.classList.remove('hidden');
      rowAngleVal.classList.remove('hidden');
      wrapperAngleUnit.classList.remove('hidden');
      updateAngleLabel();
    } else if (mode === 'leg_angle') {
      modeSubtitle.textContent = 'Known: One Leg (a or b) and Acute Angle (α or β)';
      rowLegChoice.classList.remove('hidden');
      rowSingleLeg.classList.remove('hidden');
      rowAngleType.classList.remove('hidden');
      rowAngleVal.classList.remove('hidden');
      wrapperAngleUnit.classList.remove('hidden');
      updateSingleLegLabel();
      updateAngleLabel();
    }

    triangleError.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');

    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');
  }

  function getSelectedKnownLeg(): 'a' | 'b' {
    const checked = document.querySelector('input[name="known-leg"]:checked') as HTMLInputElement;
    return (checked?.value as 'a' | 'b') || 'a';
  }

  function getSelectedAngleType(): 'alpha' | 'beta' {
    const checked = document.querySelector('input[name="angle-type"]:checked') as HTMLInputElement;
    return (checked?.value as 'alpha' | 'beta') || 'alpha';
  }

  function updateSingleLegLabel() {
    const leg = getSelectedKnownLeg();
    labelSingleLeg.textContent = leg === 'a' ? 'Leg a (Base)' : 'Leg b (Height)';
    inputSingleLeg.placeholder = `Enter leg ${leg} length`;
  }

  function updateAngleLabel() {
    const type = getSelectedAngleType();
    labelAngleVal.textContent = type === 'alpha' ? 'Angle α (opp a)' : 'Angle β (opp b)';
  }

  modeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const mode = tab.getAttribute('data-mode') as RightTriangleMode;
      if (mode) switchMode(mode);
    });
  });

  document.querySelectorAll('input[name="known-leg"]').forEach((el) => {
    el.addEventListener('change', () => {
      updateSingleLegLabel();
      if (!resultsCard.classList.contains('hidden')) runCalculation();
    });
  });

  document.querySelectorAll('input[name="angle-type"]').forEach((el) => {
    el.addEventListener('change', () => {
      updateAngleLabel();
      if (!resultsCard.classList.contains('hidden')) runCalculation();
    });
  });

  selectUnit?.addEventListener('change', () => {
    const unit = selectUnit.value;
    unitBadges.forEach((b) => (b.textContent = unit));
    if (!resultsCard.classList.contains('hidden')) runCalculation();
  });

  selectAngleUnit?.addEventListener('change', () => {
    const isDeg = selectAngleUnit.value === 'deg';
    badgeAngleUnit.textContent = isDeg ? '°' : 'rad';
    if (!resultsCard.classList.contains('hidden')) runCalculation();
  });

  // 3. Calculation Execution
  function runCalculation() {
    triangleError.classList.add('hidden');
    triangleError.textContent = '';

    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');

    const unit = (selectUnit.value as LengthUnit) || 'cm';
    const angleUnit = (selectAngleUnit?.value as AngleUnit) || 'deg';

    try {
      let result;

      if (currentMode === 'two_legs') {
        const valA = inputLegA.value.trim();
        const valB = inputLegB.value.trim();

        if (!valA) {
          triangleError.textContent = 'Please enter a length for Leg a.';
          triangleError.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          inputLegA.focus();
          return;
        }
        if (!valB) {
          triangleError.textContent = 'Please enter a length for Leg b.';
          triangleError.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          inputLegB.focus();
          return;
        }

        result = calculateRightTriangleArea({
          mode: 'two_legs',
          legA: valA,
          legB: valB,
          unit,
        });

      } else if (currentMode === 'leg_hypotenuse') {
        const knownLeg = getSelectedKnownLeg();
        const valLeg = inputSingleLeg.value.trim();
        const valHyp = inputHypotenuse.value.trim();

        if (!valLeg) {
          triangleError.textContent = `Please enter the length of Leg ${knownLeg}.`;
          triangleError.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          inputSingleLeg.focus();
          return;
        }
        if (!valHyp) {
          triangleError.textContent = 'Please enter the length of Hypotenuse c.';
          triangleError.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          inputHypotenuse.focus();
          return;
        }

        result = calculateRightTriangleArea({
          mode: 'leg_hypotenuse',
          knownLeg,
          legValue: valLeg,
          hypotenuseC: valHyp,
          unit,
        });

      } else if (currentMode === 'hypotenuse_angle') {
        const valHyp = inputHypotenuse.value.trim();
        const valAngle = inputAngleVal.value.trim();
        const angleType = getSelectedAngleType();

        if (!valHyp) {
          triangleError.textContent = 'Please enter the length of Hypotenuse c.';
          triangleError.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          inputHypotenuse.focus();
          return;
        }
        if (!valAngle) {
          triangleError.textContent = `Please enter the measurement of acute angle ${angleType === 'alpha' ? 'α' : 'β'}.`;
          triangleError.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          inputAngleVal.focus();
          return;
        }

        result = calculateRightTriangleArea({
          mode: 'hypotenuse_angle',
          hypotenuseC: valHyp,
          angle: valAngle,
          angleType,
          angleUnit,
          unit,
        });

      } else {
        // leg_angle
        const knownLeg = getSelectedKnownLeg();
        const valLeg = inputSingleLeg.value.trim();
        const valAngle = inputAngleVal.value.trim();
        const angleType = getSelectedAngleType();

        if (!valLeg) {
          triangleError.textContent = `Please enter the length of Leg ${knownLeg}.`;
          triangleError.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          inputSingleLeg.focus();
          return;
        }
        if (!valAngle) {
          triangleError.textContent = `Please enter the measurement of acute angle ${angleType === 'alpha' ? 'α' : 'β'}.`;
          triangleError.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          inputAngleVal.focus();
          return;
        }

        result = calculateRightTriangleArea({
          mode: 'leg_angle',
          knownLeg,
          legValue: valLeg,
          angle: valAngle,
          angleType,
          angleUnit,
          unit,
        });
      }

      // Update Result UI
      resAreaVal.textContent = formatNum(result.area);
      resAreaUnit.textContent = result.areaUnit;
      resPerimeter.textContent = `${formatNum(result.perimeter)} ${result.unit}`;
      resHypotenuseStat.textContent = `${formatNum(result.hypotenuseC)} ${result.unit}`;
      resAltitude.textContent = `${formatNum(result.altitudeHypotenuse)} ${result.unit}`;

      statLegA.textContent = `${formatNum(result.legA)} ${result.unit}`;
      statLegB.textContent = `${formatNum(result.legB)} ${result.unit}`;
      statAngleAlpha.textContent = `${formatNum(result.angleAlphaDeg, 2)}°`;
      statAngleBeta.textContent = `${formatNum(result.angleBetaDeg, 2)}°`;

      if (result.isIsosceles) {
        resSpecialTag.classList.remove('hidden');
        resSubtitle.textContent = `Special 45°-45°-90° isosceles right triangle with equal legs a = b = ${formatNum(result.legA)} ${result.unit}`;
      } else {
        resSpecialTag.classList.add('hidden');
        resSubtitle.textContent = `Scalene right triangle (α = ${formatNum(result.angleAlphaDeg, 1)}°, β = ${formatNum(result.angleBetaDeg, 1)}°)`;
      }

      // Render step by step derivation
      resSteps.innerHTML = '';
      result.steps.forEach((step) => {
        const li = document.createElement('li');
        li.textContent = step;
        resSteps.appendChild(li);
      });

      // Render converted units table
      tableUnitsBody.innerHTML = '';
      (Object.keys(result.areaConversions) as LengthUnit[]).forEach((u) => {
        const tr = document.createElement('tr');
        const isCurrent = u === result.unit;
        tr.className = isCurrent
          ? 'bg-blue-50/60 font-bold dark:bg-blue-950/30'
          : 'hover:bg-slate-50 dark:hover:bg-slate-900/60';
        tr.innerHTML = `
          <td class="p-2 text-slate-800 dark:text-slate-200">${AREA_UNIT_NAMES[u]}</td>
          <td class="p-2 text-right ${isCurrent ? 'text-blue-600 dark:text-blue-400 font-black' : 'text-slate-900 dark:text-white'}">
            ${formatNum(result.areaConversions[u], 4)}
          </td>
        `;
        tableUnitsBody.appendChild(tr);
      });

      // Render SVG Preview
      renderSvgTriangle(result);

      // Reveal Results Card and Action Bar
      resultsPlaceholder.classList.add('hidden');
      resultsCard.classList.remove('hidden');

      if (bar) bar.classList.remove('hidden');

    } catch (err: any) {
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      if (bar) bar.classList.add('hidden');
      triangleError.textContent = err?.message || 'Invalid geometric values.';
      triangleError.classList.remove('hidden');
    }
  }

  function renderSvgTriangle(res: any) {
    const a = res.legA;
    const b = res.legB;
    const c = res.hypotenuseC;
    const unit = res.unit;

    // ViewBox is 360 x 220
    // Right angle at (60, 180)
    // Max available base width = 240, max available height = 140
    const maxW = 240;
    const maxH = 140;

    const scale = Math.min(maxW / (a || 1), maxH / (b || 1));
    const drawA = Math.max(40, Math.min(maxW, a * scale));
    const drawB = Math.max(40, Math.min(maxH, b * scale));

    const originX = 60;
    const originY = 180;
    const topX = originX;
    const topY = originY - drawB;
    const baseX = originX + drawA;
    const baseY = originY;

    // Polygon points: Top, Base, Origin
    svgPoly.setAttribute('points', `${topX},${topY} ${baseX},${baseY} ${originX},${originY}`);

    // Right angle square marker
    const boxSize = Math.min(18, Math.min(drawA, drawB) * 0.25);
    svgRightBox.setAttribute('d', `M ${originX} ${originY - boxSize} L ${originX + boxSize} ${originY - boxSize} L ${originX + boxSize} ${originY}`);
    svgRightDot.setAttribute('cx', String(originX + boxSize / 2));
    svgRightDot.setAttribute('cy', String(originY - boxSize / 2));

    // Side labels
    svgLabelA.setAttribute('x', String(originX + drawA / 2));
    svgLabelA.setAttribute('y', String(originY + 20));
    svgLabelA.textContent = `a = ${formatNum(a)} ${unit}`;

    svgLabelB.setAttribute('x', String(originX - 14));
    svgLabelB.setAttribute('y', String(originY - drawB / 2));
    svgLabelB.textContent = `b = ${formatNum(b)} ${unit}`;

    svgLabelC.setAttribute('x', String(originX + drawA / 2 + 15));
    svgLabelC.setAttribute('y', String(originY - drawB / 2 - 10));
    svgLabelC.textContent = `c = ${formatNum(c)} ${unit}`;

    svgLabelAlpha.setAttribute('x', String(baseX - 12));
    svgLabelAlpha.setAttribute('y', String(baseY - 8));
    svgLabelAlpha.textContent = `α (${formatNum(res.angleAlphaDeg, 1)}°)`;

    svgLabelBeta.setAttribute('x', String(topX + 12));
    svgLabelBeta.setAttribute('y', String(topY + 18));
    svgLabelBeta.textContent = `β (${formatNum(res.angleBetaDeg, 1)}°)`;
  }

  // 4. Buttons and Clear Handler
  btnCalculate?.addEventListener('click', runCalculation);

  btnClear?.addEventListener('click', () => {
    inputLegA.value = '';
    inputLegB.value = '';
    inputSingleLeg.value = '';
    inputHypotenuse.value = '';
    inputAngleVal.value = '';

    triangleError.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');

    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');

    if (currentMode === 'two_legs') inputLegA.focus();
    else if (currentMode === 'leg_hypotenuse') inputSingleLeg.focus();
    else if (currentMode === 'hypotenuse_angle') inputHypotenuse.focus();
    else inputSingleLeg.focus();
  });

  // Enter key trigger
  document.querySelectorAll('#triangle-form input').forEach((inp) => {
    inp.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        btnCalculate?.click();
      }
    });
  });

  // CRITICAL AUDIT: EVERY INPUT STARTS COMPLETELY EMPTY (value="").
  // NO NUMBERS PREFILLED. RESULTS ARE HIDDEN INITIALLY.
</script>
