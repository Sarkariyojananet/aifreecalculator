  const modeTabs = document.querySelectorAll('.btn-mode-tab');
  const panels = document.querySelectorAll('.calc-panel');

  function switchModeTab(targetTabId: string) {
    modeTabs.forEach((tab) => {
      const isTarget = tab.getAttribute('data-tab') === targetTabId;
      if (isTarget) {
        tab.classList.add('active', 'bg-blue-600', 'text-white');
        tab.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
      } else {
        tab.classList.remove('active', 'bg-blue-600', 'text-white');
        tab.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
      }
    });

    panels.forEach((panel) => {
      const panelId = panel.id.replace('panel-', 'tab-');
      if (panelId === targetTabId) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });
  }

  modeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');
      if (target) switchModeTab(target);
    });
  });

  // 2. Mode 1 (Solve) Elements
  let activeSolveForm: 'standard' | 'natural' = 'standard';
  const btnSolveFormStd = document.getElementById('btn-solve-form-std') as HTMLButtonElement;
  const btnSolveFormNat = document.getElementById('btn-solve-form-nat') as HTMLButtonElement;
  const solveX1 = document.getElementById('solve-x1') as HTMLInputElement;
  const solveY1 = document.getElementById('solve-y1') as HTMLInputElement;
  const solveX2 = document.getElementById('solve-x2') as HTMLInputElement;
  const solveY2 = document.getElementById('solve-y2') as HTMLInputElement;
  const btnCalcSolve = document.getElementById('btn-calc-solve') as HTMLButtonElement;
  const btnClearSolve = document.getElementById('btn-clear-solve') as HTMLButtonElement;
  const errSolve = document.getElementById('err-solve') as HTMLParagraphElement;
  const resSolveCard = document.getElementById('res-solve-card') as HTMLDivElement;
  const resSolveEq = document.getElementById('res-solve-equation') as HTMLDivElement;
  const badgeSolveBehavior = document.getElementById('badge-solve-behavior') as HTMLSpanElement;
  const btnCopySolveEq = document.getElementById('btn-copy-solve-eq') as HTMLButtonElement;
  const resSolveParamA = document.getElementById('res-solve-param-a') as HTMLSpanElement;
  const boxSolveParamB = document.getElementById('box-solve-param-b') as HTMLDivElement;
  const resSolveParamB = document.getElementById('res-solve-param-b') as HTMLSpanElement;
  const boxSolveParamC = document.getElementById('box-solve-param-c') as HTMLDivElement;
  const resSolveParamC = document.getElementById('res-solve-param-c') as HTMLSpanElement;
  const resSolveIntercept = document.getElementById('res-solve-intercept') as HTMLSpanElement;
  const verifyP1Text = document.getElementById('verify-p1-text') as HTMLDivElement;
  const verifyP2Text = document.getElementById('verify-p2-text') as HTMLDivElement;
  const resSolveSteps = document.getElementById('res-solve-steps') as HTMLOListElement;
  const solveCanvas = document.getElementById('solve-canvas') as HTMLCanvasElement;

  function setSolveForm(form: 'standard' | 'natural') {
    activeSolveForm = form;
    if (form === 'standard') {
      btnSolveFormStd.className = 'solve-form-btn rounded-lg bg-white px-3 py-1.5 text-blue-700 shadow-xs dark:bg-slate-900 dark:text-blue-400 cursor-pointer transition';
      btnSolveFormNat.className = 'solve-form-btn rounded-lg px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer transition';
      boxSolveParamB.classList.remove('hidden');
      boxSolveParamC.classList.add('hidden');
    } else {
      btnSolveFormNat.className = 'solve-form-btn rounded-lg bg-white px-3 py-1.5 text-blue-700 shadow-xs dark:bg-slate-900 dark:text-blue-400 cursor-pointer transition';
      btnSolveFormStd.className = 'solve-form-btn rounded-lg px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer transition';
      boxSolveParamB.classList.add('hidden');
      boxSolveParamC.classList.remove('hidden');
    }
  }

  btnSolveFormStd?.addEventListener('click', () => {
    setSolveForm('standard');
    runSolveCalculation();
  });

  btnSolveFormNat?.addEventListener('click', () => {
    setSolveForm('natural');
    runSolveCalculation();
  });

  // Canvas 2D Plotter helper
  function drawPlot(
    canvas: HTMLCanvasElement,
    fn: (x: number) => number,
    points: Array<{ x: number; y: number; label: string; color: string }>
  ) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    // Compute coordinate window
    let minX = -4;
    let maxX = 4;
    let minY = -2;
    let maxY = 10;

    if (points.length > 0) {
      const xs = points.map((p) => p.x);
      const ys = points.map((p) => p.y);
      minX = Math.min(...xs) - 2;
      maxX = Math.max(...xs) + 2;
      minY = Math.min(0, ...ys) - 2;
      maxY = Math.max(2, ...ys) + 3;
    }

    if (maxX <= minX) maxX = minX + 4;
    if (maxY <= minY) maxY = minY + 4;

    const scaleX = (w - 60) / (maxX - minX);
    const scaleY = (h - 60) / (maxY - minY);

    const toPx = (x: number) => 30 + (x - minX) * scaleX;
    const toPy = (y: number) => h - (30 + (y - minY) * scaleY);

    // Draw grid
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 1;

    const xStep = Math.max(1, Math.round((maxX - minX) / 8));
    for (let gx = Math.ceil(minX); gx <= Math.floor(maxX); gx += xStep) {
      const px = toPx(gx);
      ctx.beginPath();
      ctx.moveTo(px, 0);
      ctx.lineTo(px, h);
      ctx.stroke();

      ctx.fillStyle = '#64748b';
      ctx.font = '10px monospace';
      ctx.fillText(String(gx), px - 4, h - 10);
    }

    const yStep = Math.max(1, Math.round((maxY - minY) / 6));
    for (let gy = Math.ceil(minY); gy <= Math.floor(maxY); gy += yStep) {
      const py = toPy(gy);
      ctx.beginPath();
      ctx.moveTo(0, py);
      ctx.lineTo(w, py);
      ctx.stroke();

      ctx.fillStyle = '#64748b';
      ctx.font = '10px monospace';
      ctx.fillText(String(gy), 6, py + 3);
    }

    // Main Axes
    ctx.strokeStyle = '#475569';
    ctx.lineWidth = 1.5;
    if (minY <= 0 && maxY >= 0) {
      const py0 = toPy(0);
      ctx.beginPath();
      ctx.moveTo(0, py0);
      ctx.lineTo(w, py0);
      ctx.stroke();
    }
    if (minX <= 0 && maxX >= 0) {
      const px0 = toPx(0);
      ctx.beginPath();
      ctx.moveTo(px0, 0);
      ctx.lineTo(px0, h);
      ctx.stroke();
    }

    // Draw Exponential Curve
    ctx.strokeStyle = '#38bdf8';
    ctx.lineWidth = 2.5;
    ctx.beginPath();

    let started = false;
    const stepPx = 2;
    for (let px = 30; px <= w - 30; px += stepPx) {
      const x = minX + (px - 30) / scaleX;
      let y = 0;
      try {
        y = fn(x);
      } catch {
        continue;
      }

      if (typeof y === 'number' && isFinite(y)) {
        const py = toPy(y);
        // Clamp visually inside reasonable bounds
        if (py >= -20 && py <= h + 20) {
          if (!started) {
            ctx.moveTo(px, py);
            started = true;
          } else {
            ctx.lineTo(px, py);
          }
        } else {
          started = false;
        }
      } else {
        started = false;
      }
    }
    ctx.stroke();

    // Plot Points
    points.forEach((pt) => {
      const px = toPx(pt.x);
      const py = toPy(pt.y);

      // Outer glow
      ctx.fillStyle = pt.color;
      ctx.beginPath();
      ctx.arc(px, py, 6, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(px, py, 3, 0, Math.PI * 2);
      ctx.fill();

      // Label
      ctx.fillStyle = '#f8fafc';
      ctx.font = 'bold 11px monospace';
      ctx.fillText(pt.label, px + 8, py - 6);
    });
  }

  function runSolveCalculation() {
    errSolve.classList.add('hidden');
    errSolve.textContent = '';

    try {
      const x1 = solveX1.value;
      const y1 = solveY1.value;
      const x2 = solveX2.value;
      const y2 = solveY2.value;

      const res =
        activeSolveForm === 'natural'
          ? solveNaturalExponentialFromPoints(x1, y1, x2, y2)
          : solveStandardExponentialFromPoints(x1, y1, x2, y2);

      resSolveEq.textContent = res.equationUnicode;
      badgeSolveBehavior.textContent = res.behaviorLabel;

      resSolveParamA.textContent = formatFloat(res.a, 6);
      if (res.b !== undefined) resSolveParamB.textContent = formatFloat(res.b, 6);
      if (res.c !== undefined) resSolveParamC.textContent = formatFloat(res.c, 6);
      resSolveIntercept.textContent = `(0, ${formatFloat(res.a, 6)})`;

      verifyP1Text.textContent = `f(${res.verification.x1}) = ${formatFloat(res.verification.calculatedY1, 4)} (Expected: ${res.verification.expectedY1} ✓)`;
      verifyP2Text.textContent = `f(${res.verification.x2}) = ${formatFloat(res.verification.calculatedY2, 4)} (Expected: ${res.verification.expectedY2} ✓)`;

      resSolveSteps.innerHTML = '';
      res.steps.forEach((st) => {
        const li = document.createElement('li');
        li.textContent = st;
        resSolveSteps.appendChild(li);
      });

      // Render Plot
      if (res.form === 'natural' && res.c !== undefined) {
        drawPlot(
          solveCanvas,
          (x) => res.a * Math.exp(res.c! * x),
          [
            { x: res.point1.x, y: res.point1.y, label: `(${res.point1.x}, ${res.point1.y})`, color: '#38bdf8' },
            { x: res.point2.x, y: res.point2.y, label: `(${res.point2.x}, ${res.point2.y})`, color: '#f59e0b' },
          ]
        );
      } else {
        drawPlot(
          solveCanvas,
          (x) => res.a * Math.pow(res.b, x),
          [
            { x: res.point1.x, y: res.point1.y, label: `(${res.point1.x}, ${res.point1.y})`, color: '#38bdf8' },
            { x: res.point2.x, y: res.point2.y, label: `(${res.point2.x}, ${res.point2.y})`, color: '#f59e0b' },
          ]
        );
      }

      resSolveCard.classList.remove('hidden');
    } catch (err: any) {
      resSolveCard.classList.add('hidden');
      errSolve.textContent = err?.message || 'Invalid coordinates for exponential function.';
      errSolve.classList.remove('hidden');
    }
  }

  btnCalcSolve?.addEventListener('click', runSolveCalculation);

  btnClearSolve?.addEventListener('click', () => {
    solveX1.value = '0';
    solveY1.value = '';
    solveX2.value = '1';
    solveY2.value = '';
    errSolve.classList.add('hidden');
    resSolveCard.classList.add('hidden');
    solveY1.focus();
  });

  btnCopySolveEq?.addEventListener('click', () => {
    const text = resSolveEq.textContent || '';
    navigator.clipboard.writeText(text).then(() => {
      btnCopySolveEq.textContent = '✓ Copied!';
      setTimeout(() => {
        btnCopySolveEq.textContent = '📋 Copy';
      }, 2000);
    });
  });

  // 3. Mode 2 (Evaluate) Elements
  let activeEvalForm: 'standard' | 'natural' = 'standard';
  const btnEvalFormStd = document.getElementById('btn-eval-form-std') as HTMLButtonElement;
  const btnEvalFormNat = document.getElementById('btn-eval-form-nat') as HTMLButtonElement;
  const evalA = document.getElementById('eval-a') as HTMLInputElement;
  const evalB = document.getElementById('eval-b') as HTMLInputElement;
  const evalC = document.getElementById('eval-c') as HTMLInputElement;
  const evalX = document.getElementById('eval-x') as HTMLInputElement;
  const boxEvalB = document.getElementById('box-eval-b') as HTMLDivElement;
  const boxEvalC = document.getElementById('box-eval-c') as HTMLDivElement;
  const btnUseEBase = document.getElementById('btn-use-e-base') as HTMLButtonElement;
  const btnCalcEval = document.getElementById('btn-calc-eval') as HTMLButtonElement;
  const btnClearEval = document.getElementById('btn-clear-eval') as HTMLButtonElement;
  const errEval = document.getElementById('err-eval') as HTMLParagraphElement;
  const resEvalCard = document.getElementById('res-eval-card') as HTMLDivElement;
  const resEvalResult = document.getElementById('res-eval-result') as HTMLDivElement;
  const resEvalFullEq = document.getElementById('res-eval-full-eq') as HTMLDivElement;
  const badgeEvalBehavior = document.getElementById('badge-eval-behavior') as HTMLSpanElement;
  const resEvalSteps = document.getElementById('res-eval-steps') as HTMLOListElement;
  const evalCanvas = document.getElementById('eval-canvas') as HTMLCanvasElement;

  function setEvalForm(form: 'standard' | 'natural') {
    activeEvalForm = form;
    if (form === 'standard') {
      btnEvalFormStd.className = 'eval-form-btn rounded-lg bg-white px-3 py-1.5 text-blue-700 shadow-xs dark:bg-slate-900 dark:text-blue-400 cursor-pointer transition';
      btnEvalFormNat.className = 'eval-form-btn rounded-lg px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer transition';
      boxEvalB.classList.remove('hidden');
      boxEvalC.classList.add('hidden');
    } else {
      btnEvalFormNat.className = 'eval-form-btn rounded-lg bg-white px-3 py-1.5 text-blue-700 shadow-xs dark:bg-slate-900 dark:text-blue-400 cursor-pointer transition';
      btnEvalFormStd.className = 'eval-form-btn rounded-lg px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer transition';
      boxEvalB.classList.add('hidden');
      boxEvalC.classList.remove('hidden');
    }
  }

  btnEvalFormStd?.addEventListener('click', () => {
    setEvalForm('standard');
    runEvalCalculation();
  });

  btnEvalFormNat?.addEventListener('click', () => {
    setEvalForm('natural');
    runEvalCalculation();
  });

  btnUseEBase?.addEventListener('click', () => {
    evalB.value = 'e';
    runEvalCalculation();
  });

  function runEvalCalculation() {
    errEval.classList.add('hidden');
    errEval.textContent = '';

    try {
      const a = evalA.value;
      const x = evalX.value;

      const res =
        activeEvalForm === 'natural'
          ? evaluateNaturalExponential(a, evalC.value, x)
          : evaluateStandardExponential(a, evalB.value, x);

      resEvalResult.textContent = res.evaluatedEquation;
      resEvalFullEq.textContent = `${res.equationUnicode}`;
      badgeEvalBehavior.textContent = res.behaviorLabel;

      resEvalSteps.innerHTML = '';
      res.steps.forEach((st) => {
        const li = document.createElement('li');
        li.textContent = st;
        resEvalSteps.appendChild(li);
      });

      // Render Plot
      if (res.form === 'natural' && res.c !== undefined) {
        drawPlot(
          evalCanvas,
          (t) => res.a * Math.exp(res.c! * t),
          [
            { x: res.x, y: res.y, label: `(${formatFloat(res.x, 2)}, ${formatFloat(res.y, 2)})`, color: '#f59e0b' },
          ]
        );
      } else {
        drawPlot(
          evalCanvas,
          (t) => res.a * Math.pow(res.b!, t),
          [
            { x: res.x, y: res.y, label: `(${formatFloat(res.x, 2)}, ${formatFloat(res.y, 2)})`, color: '#f59e0b' },
          ]
        );
      }

      resEvalCard.classList.remove('hidden');
    } catch (err: any) {
      resEvalCard.classList.add('hidden');
      errEval.textContent = err?.message || 'Invalid parameters for evaluation.';
      errEval.classList.remove('hidden');
    }
  }

  btnCalcEval?.addEventListener('click', runEvalCalculation);

  btnClearEval?.addEventListener('click', () => {
    evalA.value = '1';
    evalB.value = '2';
    evalC.value = '1';
    evalX.value = '0';
    errEval.classList.add('hidden');
    resEvalCard.classList.add('hidden');
    evalA.focus();
  });

  // 4. Presets Click Handlers
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-mode');
      const form = btn.getAttribute('data-form') as 'standard' | 'natural';

      if (mode === 'solve') {
        switchModeTab('tab-solve');
        setSolveForm(form);
        solveX1.value = btn.getAttribute('data-x1') || '0';
        solveY1.value = btn.getAttribute('data-y1') || '2';
        solveX2.value = btn.getAttribute('data-x2') || '1';
        solveY2.value = btn.getAttribute('data-y2') || '4';
        runSolveCalculation();
      } else if (mode === 'eval') {
        switchModeTab('tab-evaluate');
        setEvalForm(form);
        evalA.value = btn.getAttribute('data-a') || '1';
        evalX.value = btn.getAttribute('data-x') || '0';
        if (form === 'standard') {
          evalB.value = btn.getAttribute('data-b') || '2';
        } else {
          evalC.value = btn.getAttribute('data-c') || '1';
        }
        runEvalCalculation();
      }
    });
  });

  // 5. Enter Key Listeners
  document.querySelectorAll('input').forEach((input) => {
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const form = input.closest('form');
        if (form) {
          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) submitBtn.click();
        }
      }
    });
  });

  // Initial Calculation on load
  runSolveCalculation();
</script>
