---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Exponential Function Calculator – Solve & Evaluate Functions"
  description="Solve an exponential function from two points (a · bˣ or a · eᶜˣ) or evaluate a function at any x-value with step-by-step mathematical solutions."
  category="Math"
  calculatorName="Exponential Function Calculator"
  slug="exponential-function-calculator"
  keywords={[
    'exponential function calculator',
    'exponential function solver',
    'exponential function from two points',
    'solve exponential function',
    'exponential equation calculator',
    'exponential function formula',
    'evaluate exponential function',
    'exponential growth calculator',
    'exponential decay calculator',
    'two points exponential curve',
    'natural exponential function'
  ]}
>
  <div class="space-y-6">

    <!-- MODE SELECTOR TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button
          type="button"
          class="btn-mode-tab active shrink-0 rounded-lg bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition"
          data-tab="tab-solve"
          id="tab-btn-solve"
        >
          📈 Mode 1: Solve Function from Two Points
        </button>
        <button
          type="button"
          class="btn-mode-tab shrink-0 rounded-lg border border-slate-300 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-tab="tab-evaluate"
          id="tab-btn-evaluate"
        >
          ⚡ Mode 2: Evaluate Function at x
        </button>
      </div>
    </div>

    <!-- QUICK EXAMPLE PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="solve" data-form="standard" data-x1="0" data-y1="2" data-x2="1" data-y2="4">(0, 2) & (1, 4) ➔ 2·2ˣ</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="solve" data-form="standard" data-x1="0" data-y1="4" data-x2="1" data-y2="12">(0, 4) & (1, 12) ➔ 4·3ˣ</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="solve" data-form="standard" data-x1="0" data-y1="-2" data-x2="1" data-y2="-6">(0, -2) & (1, -6) ➔ -2·3ˣ</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="solve" data-form="natural" data-x1="0" data-y1="2" data-x2="2" data-y2="5.43656">(0, 2) & (2, 2e) ➔ 2e^(0.5x)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="eval" data-form="standard" data-a="2" data-b="3" data-x="2">Eval 2·3² = 18</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="eval" data-form="standard" data-a="5" data-b="2" data-x="3">Eval 5·2³ = 40</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="eval" data-form="natural" data-a="4" data-c="0.5" data-x="2">Eval 4·e^(0.5·2)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">

      <!-- ======================================================== -->
      <!-- 1. MODE 1 PANEL: SOLVE FUNCTION FROM TWO POINTS          -->
      <!-- ======================================================== -->
      <div id="panel-solve" class="calc-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
                <span>📈</span> Solve Exponential Function from Two Known Points
              </h2>
              <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
                Determine parameters a, b, or c from coordinates (x₁, y₁) and (x₂, y₂) with verification and 2D curve plot.
              </p>
            </div>
            <!-- Function Form Selector -->
            <div class="flex items-center gap-1 rounded-xl bg-slate-200/70 p-1 dark:bg-slate-800 text-xs font-bold">
              <button
                type="button"
                id="btn-solve-form-std"
                class="solve-form-btn rounded-lg bg-white px-3 py-1.5 text-blue-700 shadow-xs dark:bg-slate-900 dark:text-blue-400 cursor-pointer transition"
                data-form="standard"
              >
                f(x) = a · bˣ
              </button>
              <button
                type="button"
                id="btn-solve-form-nat"
                class="solve-form-btn rounded-lg px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer transition"
                data-form="natural"
              >
                f(x) = a · eᶜˣ
              </button>
            </div>
          </div>
        </div>

        <form id="form-solve" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <!-- Point 1 -->
            <div class="rounded-2xl border border-blue-200/80 bg-blue-50/40 p-4 dark:border-blue-900/40 dark:bg-blue-950/20">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-extrabold text-blue-900 dark:text-blue-300 uppercase tracking-wider flex items-center gap-1">
                  <span>📍</span> Point 1: (x₁, y₁)
                </span>
                <span class="text-[11px] text-blue-600 dark:text-blue-400 font-medium">First Point</span>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="solve-x1" class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                    x₁ Coordinate
                  </label>
                  <input
                    type="text"
                    id="solve-x1"
                    value="0"
                    placeholder="e.g. 0"
                    class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                    autocomplete="off"
                  />
                </div>
                <div>
                  <label for="solve-y1" class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                    y₁ Coordinate
                  </label>
                  <input
                    type="text"
                    id="solve-y1"
                    value="2"
                    placeholder="e.g. 2"
                    class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                    autocomplete="off"
                  />
                </div>
              </div>
            </div>

            <!-- Point 2 -->
            <div class="rounded-2xl border border-emerald-200/80 bg-emerald-50/40 p-4 dark:border-emerald-900/40 dark:bg-emerald-950/20">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-extrabold text-emerald-900 dark:text-emerald-300 uppercase tracking-wider flex items-center gap-1">
                  <span>📍</span> Point 2: (x₂, y₂)
                </span>
                <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">Second Point</span>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="solve-x2" class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                    x₂ Coordinate
                  </label>
                  <input
                    type="text"
                    id="solve-x2"
                    value="1"
                    placeholder="e.g. 1"
                    class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-emerald-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                    autocomplete="off"
                  />
                </div>
                <div>
                  <label for="solve-y2" class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
                    y₂ Coordinate
                  </label>
                  <input
                    type="text"
                    id="solve-y2"
                    value="4"
                    placeholder="e.g. 4"
                    class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-emerald-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                    autocomplete="off"
                  />
                </div>
              </div>
            </div>

          </div>

          <!-- Buttons -->
          <div class="flex items-center gap-2 pt-1">
            <button
              type="submit"
              id="btn-calc-solve"
              class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
            >
              Solve Exponential Function →
            </button>
            <button
              type="button"
              id="btn-clear-solve"
              class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Clear
            </button>
          </div>
        </form>

        <!-- Error Banner -->
        <p id="err-solve" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/50 dark:bg-red-950/50 dark:text-red-300"></p>

        <!-- Solve Results Container -->
        <div id="res-solve-card" class="hidden space-y-4 pt-2">
          
          <!-- Primary Equation Display -->
          <div class="rounded-2xl border border-blue-200 bg-linear-to-r from-blue-500/10 via-indigo-500/10 to-blue-600/10 p-5 dark:border-blue-900/50 dark:from-blue-950/40 dark:to-indigo-950/40">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-blue-200/60 pb-3 dark:border-blue-800/60">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-900 dark:text-blue-300">
                Calculated Function Equation:
              </span>
              <div class="flex items-center gap-2">
                <span id="badge-solve-behavior" class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-[11px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
                  Exponential Growth
                </span>
                <button
                  type="button"
                  id="btn-copy-solve-eq"
                  class="rounded-lg border border-blue-300 bg-white px-2.5 py-1 text-[11px] font-bold text-blue-700 hover:bg-blue-50 dark:border-blue-700 dark:bg-slate-800 dark:text-blue-300 cursor-pointer transition"
                >
                  📋 Copy
                </button>
              </div>
            </div>

            <div class="mt-3 flex flex-wrap items-baseline gap-3">
              <div id="res-solve-equation" class="font-mono text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                f(x) = 2 · 2ˣ
              </div>
            </div>

            <!-- Parameters Grid -->
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
              <div class="rounded-xl border border-slate-200/80 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/80">
                <span class="text-slate-500 dark:text-slate-400 block font-medium">Initial Scale Factor (a):</span>
                <span id="res-solve-param-a" class="font-mono text-sm font-bold text-slate-900 dark:text-white">2</span>
              </div>
              <div id="box-solve-param-b" class="rounded-xl border border-slate-200/80 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/80">
                <span class="text-slate-500 dark:text-slate-400 block font-medium">Base (b):</span>
                <span id="res-solve-param-b" class="font-mono text-sm font-bold text-slate-900 dark:text-white">2</span>
              </div>
              <div id="box-solve-param-c" class="hidden rounded-xl border border-slate-200/80 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/80">
                <span class="text-slate-500 dark:text-slate-400 block font-medium">Continuous Rate (c):</span>
                <span id="res-solve-param-c" class="font-mono text-sm font-bold text-slate-900 dark:text-white">0.5</span>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/80 col-span-2 sm:col-span-1">
                <span class="text-slate-500 dark:text-slate-400 block font-medium">y-Intercept:</span>
                <span id="res-solve-intercept" class="font-mono text-sm font-bold text-slate-900 dark:text-white">(0, 2)</span>
              </div>
            </div>
          </div>

          <!-- Two-Point Verification Card -->
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50/50 p-4 dark:border-emerald-900/40 dark:bg-emerald-950/20">
            <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-900 dark:text-emerald-300 flex items-center gap-1.5">
              <span>✅</span> Two-Point Solution Verification
            </h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Confirming that the derived function passes exactly through both supplied coordinates:
            </p>
            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
              <div id="verify-box-p1" class="rounded-xl border border-emerald-200 bg-white p-2.5 dark:border-emerald-900/50 dark:bg-slate-900">
                <span class="font-bold text-slate-700 dark:text-slate-300">Point 1 Verification:</span>
                <div id="verify-p1-text" class="text-emerald-700 dark:text-emerald-400 font-bold mt-1">f(0) = 2 (Exact Match ✓)</div>
              </div>
              <div id="verify-box-p2" class="rounded-xl border border-emerald-200 bg-white p-2.5 dark:border-emerald-900/50 dark:bg-slate-900">
                <span class="font-bold text-slate-700 dark:text-slate-300">Point 2 Verification:</span>
                <div id="verify-p2-text" class="text-emerald-700 dark:text-emerald-400 font-bold mt-1">f(1) = 4 (Exact Match ✓)</div>
              </div>
            </div>
          </div>

          <!-- Step-by-Step Algebraic Derivation -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>📝</span> Step-by-Step Algebraic Derivation
            </h3>
            <ol id="res-solve-steps" class="mt-3 space-y-2 text-xs text-slate-700 dark:text-slate-300 list-decimal pl-5 font-mono leading-relaxed"></ol>
          </div>

          <!-- 2D Canvas Curve Plot -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>📊</span> Interactive 2D Function Curve &amp; Points Plot
              </h3>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">Cartesian Coordinates</span>
            </div>
            <div class="flex justify-center overflow-x-auto">
              <canvas id="solve-canvas" width="560" height="300" class="rounded-xl border border-slate-300 bg-slate-950 dark:border-slate-700 shadow-inner w-full max-w-140"></canvas>
            </div>
            <p class="mt-2 text-[11px] text-center text-slate-500 dark:text-slate-400">
              Blue curve represents f(x). Glowing cyan and amber dots highlight the given coordinates (x₁, y₁) and (x₂, y₂).
            </p>
          </div>

        </div>
      </div>

      <!-- ======================================================== -->
      <!-- 2. MODE 2 PANEL: EVALUATE FUNCTION AT X                  -->
      <!-- ======================================================== -->
      <div id="panel-evaluate" class="calc-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
                <span>⚡</span> Evaluate Exponential Function at Any x-Value
              </h2>
              <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
                Enter function parameters and an x-coordinate to calculate the corresponding output y = f(x).
              </p>
            </div>
            <!-- Function Form Selector -->
            <div class="flex items-center gap-1 rounded-xl bg-slate-200/70 p-1 dark:bg-slate-800 text-xs font-bold">
              <button
                type="button"
                id="btn-eval-form-std"
                class="eval-form-btn rounded-lg bg-white px-3 py-1.5 text-blue-700 shadow-xs dark:bg-slate-900 dark:text-blue-400 cursor-pointer transition"
                data-form="standard"
              >
                f(x) = a · bˣ
              </button>
              <button
                type="button"
                id="btn-eval-form-nat"
                class="eval-form-btn rounded-lg px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer transition"
                data-form="natural"
              >
                f(x) = a · eᶜˣ
              </button>
            </div>
          </div>
        </div>

        <form id="form-evaluate" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            
            <!-- Coefficient a -->
            <div>
              <label for="eval-a" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Coefficient (a)
              </label>
              <input
                type="text"
                id="eval-a"
                value="2"
                placeholder="e.g. 2, -1, 0.5"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                autocomplete="off"
              />
              <p class="mt-1 text-[10px] text-slate-500 dark:text-slate-400">Initial multiplier (a ≠ 0)</p>
            </div>

            <!-- Base b (Standard) OR Rate c (Natural) -->
            <div id="box-eval-b">
              <div class="flex items-center justify-between mb-1">
                <label for="eval-b" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                  Base (b)
                </label>
                <button type="button" id="btn-use-e-base" class="text-[10px] font-bold text-blue-600 dark:text-blue-400 hover:underline cursor-pointer">
                  Use e (2.718...)
                </button>
              </div>
              <input
                type="text"
                id="eval-b"
                value="3"
                placeholder="e.g. 3, 2, e"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                autocomplete="off"
              />
              <p class="mt-1 text-[10px] text-slate-500 dark:text-slate-400">Base constant (b &gt; 0)</p>
            </div>

            <div id="box-eval-c" class="hidden">
              <label for="eval-c" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Continuous Rate (c)
              </label>
              <input
                type="text"
                id="eval-c"
                value="0.5"
                placeholder="e.g. 0.5, -0.2"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                autocomplete="off"
              />
              <p class="mt-1 text-[10px] text-slate-500 dark:text-slate-400">Rate constant with base e</p>
            </div>

            <!-- Evaluation point x -->
            <div>
              <label for="eval-x" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Evaluate at x =
              </label>
              <input
                type="text"
                id="eval-x"
                value="2"
                placeholder="e.g. 2, -1, 3.5"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                autocomplete="off"
              />
              <p class="mt-1 text-[10px] text-slate-500 dark:text-slate-400">Exponent evaluation input</p>
            </div>

          </div>

          <!-- Buttons -->
          <div class="flex items-center gap-2 pt-1">
            <button
              type="submit"
              id="btn-calc-eval"
              class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
            >
              Evaluate Function at x →
            </button>
            <button
              type="button"
              id="btn-clear-eval"
