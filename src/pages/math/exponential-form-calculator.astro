<script>
  import {
    calculateWholeNumberExponentialForm,
    calculateLogToExponential,
    calculateExponentialToLog,
  } from '../../lib/calculators/exponential-form';

  // 1. Tab Switching
  const tabs = document.querySelectorAll('.btn-exp-tab');
  const panels = document.querySelectorAll('.exp-panel');

  function switchTab(targetId: string) {
    tabs.forEach((tab) => {
      const isTarget = tab.getAttribute('data-tab') === targetId;
      if (isTarget) {
        tab.classList.add('active', 'bg-blue-600', 'text-white');
        tab.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
      } else {
        tab.classList.remove('active', 'bg-blue-600', 'text-white');
        tab.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
      }
    });

    panels.forEach((panel) => {
      const panelId = panel.id.replace('panel-', 'tab-');
      if (panelId === targetId) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');
      if (target) switchTab(target);
    });
  });

  // 2. Mode A: Whole Number Calculations
  const inputWholeNum = document.getElementById('input-whole-num') as HTMLInputElement;
  const btnCalcWhole = document.getElementById('btn-calc-whole') as HTMLButtonElement;
  const btnClearWhole = document.getElementById('btn-clear-whole') as HTMLButtonElement;
  const errWhole = document.getElementById('err-whole') as HTMLParagraphElement;
  const resWholeCard = document.getElementById('res-whole-card') as HTMLDivElement;
  const resWholeExp = document.getElementById('res-whole-exp') as HTMLDivElement;
  const resWholeExpanded = document.getElementById('res-whole-expanded') as HTMLDivElement;
  const resWholeSteps = document.getElementById('res-whole-steps') as HTMLOListElement;
  const badgePrimeStatus = document.getElementById('badge-prime-status') as HTMLSpanElement;

  function runWholeNumberConversion() {
    errWhole.classList.add('hidden');
    errWhole.textContent = '';

    if (!inputWholeNum.value.trim()) {
      resWholeCard.classList.add('hidden');
      errWhole.textContent = 'Please enter a positive whole number.';
      errWhole.classList.remove('hidden');
      return;
    }

    try {
      const result = calculateWholeNumberExponentialForm(inputWholeNum.value);
      resWholeExp.textContent = result.exponentialFormUnicode;
      resWholeExpanded.textContent = `${result.originalNumber} = ${result.expandedFactorization}`;

      if (result.isPrime) {
        badgePrimeStatus.textContent = 'Prime Number ⚡';
        badgePrimeStatus.className = 'inline-flex items-center rounded-full bg-emerald-100 dark:bg-emerald-950/60 px-3 py-1 text-xs font-bold text-emerald-800 dark:text-emerald-300';
      } else if (result.originalNumber === 1) {
        badgePrimeStatus.textContent = 'Unit (Neither Prime nor Composite)';
        badgePrimeStatus.className = 'inline-flex items-center rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs font-bold text-slate-800 dark:text-slate-200';
      } else {
        badgePrimeStatus.textContent = 'Composite Number';
        badgePrimeStatus.className = 'inline-flex items-center rounded-full bg-blue-100 dark:bg-blue-950/60 px-3 py-1 text-xs font-bold text-blue-800 dark:text-blue-300';
      }

      resWholeSteps.innerHTML = '';
      result.steps.forEach((step) => {
        const li = document.createElement('li');
        li.textContent = step;
        resWholeSteps.appendChild(li);
      });

      resWholeCard.classList.remove('hidden');
    } catch (err: any) {
      resWholeCard.classList.add('hidden');
      errWhole.textContent = err?.message || 'Invalid whole number input.';
      errWhole.classList.remove('hidden');
    }
  }

  btnCalcWhole?.addEventListener('click', runWholeNumberConversion);
  btnClearWhole?.addEventListener('click', () => {
    inputWholeNum.value = '';
    errWhole.classList.add('hidden');
    resWholeCard.classList.add('hidden');
    inputWholeNum.focus();
  });

  // 3. Mode B: Log -> Exp Calculations
  const inputLogBase = document.getElementById('input-log-base') as HTMLInputElement;
  const inputLogArg = document.getElementById('input-log-arg') as HTMLInputElement;
  const inputLogVal = document.getElementById('input-log-val') as HTMLInputElement;
  const btnCalcLog = document.getElementById('btn-calc-log') as HTMLButtonElement;
  const btnClearLog = document.getElementById('btn-clear-log') as HTMLButtonElement;
  const btnUseEBase = document.getElementById('btn-use-e-base') as HTMLButtonElement;
  const errLog = document.getElementById('err-log') as HTMLParagraphElement;
  const resLogCard = document.getElementById('res-log-card') as HTMLDivElement;
  const resLogExp = document.getElementById('res-log-exp') as HTMLDivElement;
  const resLogIn = document.getElementById('res-log-in') as HTMLDivElement;
  const resLogSteps = document.getElementById('res-log-steps') as HTMLUListElement;

  btnUseEBase?.addEventListener('click', () => {
    inputLogBase.value = 'e';
  });

  function runLogToExponentialConversion() {
    errLog.classList.add('hidden');
    errLog.textContent = '';

    const baseVal = inputLogBase.value.trim();
    const argVal = inputLogArg.value.trim();
    const logVal = inputLogVal.value.trim();

    if (!baseVal) {
      resLogCard.classList.add('hidden');
      errLog.textContent = 'Please enter the base (b) for the logarithm.';
      errLog.classList.remove('hidden');
      return;
    }

    if (!argVal && !logVal) {
      resLogCard.classList.add('hidden');
      errLog.textContent = 'Please enter either the number/argument (c) or logarithm value (a).';
      errLog.classList.remove('hidden');
      return;
    }

    try {
      const result = calculateLogToExponential(
        baseVal,
        argVal,
        logVal
      );

      resLogExp.textContent = result.exponentialExpression;
      resLogIn.textContent = result.logExpression;
      inputLogArg.value = String(result.argument);
      inputLogVal.value = String(result.exponent);

      resLogSteps.innerHTML = '';
      result.steps.forEach((step) => {
        const li = document.createElement('li');
        li.textContent = step;
        resLogSteps.appendChild(li);
      });

      resLogCard.classList.remove('hidden');
    } catch (err: any) {
      resLogCard.classList.add('hidden');
      errLog.textContent = err?.message || 'Invalid logarithm input values.';
      errLog.classList.remove('hidden');
    }
  }

  inputLogArg?.addEventListener('input', () => {
    inputLogVal.value = '';
  });

  inputLogVal?.addEventListener('input', () => {
    inputLogArg.value = '';
  });

  btnCalcLog?.addEventListener('click', runLogToExponentialConversion);
  btnClearLog?.addEventListener('click', () => {
    inputLogBase.value = '';
    inputLogArg.value = '';
    inputLogVal.value = '';
    errLog.classList.add('hidden');
    resLogCard.classList.add('hidden');
    inputLogBase.focus();
  });

  // 4. Mode C: Exp -> Log Calculations
  const inputExpBase = document.getElementById('input-exp-base') as HTMLInputElement;
  const inputExpPower = document.getElementById('input-exp-power') as HTMLInputElement;
  const inputExpResult = document.getElementById('input-exp-result') as HTMLInputElement;
  const btnCalcExp = document.getElementById('btn-calc-exp') as HTMLButtonElement;
  const btnClearExp = document.getElementById('btn-clear-exp') as HTMLButtonElement;
  const btnUseEExp = document.getElementById('btn-use-e-exp') as HTMLButtonElement;
  const errExp = document.getElementById('err-exp') as HTMLParagraphElement;
  const resExpCard = document.getElementById('res-exp-card') as HTMLDivElement;
  const resExpLog = document.getElementById('res-exp-log') as HTMLDivElement;
  const resExpIn = document.getElementById('res-exp-in') as HTMLDivElement;
  const resExpSteps = document.getElementById('res-exp-steps') as HTMLUListElement;

  btnUseEExp?.addEventListener('click', () => {
    inputExpBase.value = 'e';
  });

  function runExponentialToLogConversion() {
    errExp.classList.add('hidden');
    errExp.textContent = '';

    const baseVal = inputExpBase.value.trim();
    const powerVal = inputExpPower.value.trim();
    const resultVal = inputExpResult.value.trim();

    if (!baseVal) {
      resExpCard.classList.add('hidden');
      errExp.textContent = 'Please enter the base (b) for the exponential expression.';
      errExp.classList.remove('hidden');
      return;
    }

    if (!powerVal && !resultVal) {
      resExpCard.classList.add('hidden');
      errExp.textContent = 'Please enter either the exponent (a) or the evaluated result (c).';
      errExp.classList.remove('hidden');
      return;
    }

    try {
      const result = calculateExponentialToLog(
        baseVal,
        powerVal,
        resultVal
      );

      resExpLog.textContent = result.logExpression;
      resExpIn.textContent = result.exponentialExpression;
      inputExpPower.value = String(result.exponent);
      inputExpResult.value = String(result.resultNumber);

      resExpSteps.innerHTML = '';
      result.steps.forEach((step) => {
        const li = document.createElement('li');
        li.textContent = step;
        resExpSteps.appendChild(li);
      });

      resExpCard.classList.remove('hidden');
    } catch (err: any) {
      resExpCard.classList.add('hidden');
      errExp.textContent = err?.message || 'Invalid exponential inputs.';
      errExp.classList.remove('hidden');
    }
  }

  inputExpPower?.addEventListener('input', () => {
    inputExpResult.value = '';
  });

  inputExpResult?.addEventListener('input', () => {
    inputExpPower.value = '';
  });

  btnCalcExp?.addEventListener('click', runExponentialToLogConversion);
  btnClearExp?.addEventListener('click', () => {
    inputExpBase.value = '';
    inputExpPower.value = '';
    inputExpResult.value = '';
    errExp.classList.add('hidden');
    resExpCard.classList.add('hidden');
    inputExpBase.focus();
  });

  // 5. Presets Click Handlers
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-mode');

      if (mode === 'whole') {
        switchTab('tab-whole');
        const val = btn.getAttribute('data-val');
        if (val && inputWholeNum) {
          inputWholeNum.value = val;
          runWholeNumberConversion();
        }
      } else if (mode === 'log-to-exp') {
        switchTab('tab-log-to-exp');
        const b = btn.getAttribute('data-base') || '';
        const arg = btn.getAttribute('data-arg') || '';
        const val = btn.getAttribute('data-val') || '';
        if (inputLogBase && inputLogArg && inputLogVal) {
          inputLogBase.value = b;
          inputLogArg.value = arg;
          inputLogVal.value = val;
          runLogToExponentialConversion();
        }
      } else if (mode === 'exp-to-log') {
        switchTab('tab-exp-to-log');
        const b = btn.getAttribute('data-base') || '';
        const exp = btn.getAttribute('data-exp') || '';
        const res = btn.getAttribute('data-res') || '';
        if (inputExpBase && inputExpPower && inputExpResult) {
          inputExpBase.value = b;
          inputExpPower.value = exp;
          inputExpResult.value = res;
          runExponentialToLogConversion();
        }
      }
    });
  });

  // 6. Enter Key Listeners on all inputs
  document.querySelectorAll('input').forEach((input) => {
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const form = input.closest('form');
        if (form) {
          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) submitBtn.click();
        }
      }
    });
  });
</script>
