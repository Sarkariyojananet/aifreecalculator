---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Scientific Calculator Online – Free Advanced Math & Engineering Tool"
  description="Use this online scientific calculator to perform basic arithmetic, trigonometric functions, logarithms, powers, roots, fractions, statistics, and other advanced mathematical calculations."
  category="Math"
  calculatorName="Scientific Calculator"
  slug="scientific-calculator"
  keywords={[
    'scientific calculator',
    'scientific calculator online',
    'online scientific calculator',
    'casio scientific calculator',
    'scientific calculator price',
    'scientific calculator casio',
    'desmos scientific calculator',
    'casio advanced scientific calculator fx-115es',
    'sharp 12-digit scientific calculator'
  ]}
>
  <div class="space-y-6">

    <!-- TOP TOOL NAVIGATION TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-sci-tab active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="tab-keypad">Scientific Keypad</button>
        <button type="button" class="btn-sci-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-stats">Statistics Mode</button>
        <button type="button" class="btn-sci-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-matrix">Matrix Suite</button>
        <button type="button" class="btn-sci-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-equations">Equation Solver</button>
        <button type="button" class="btn-sci-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-graph">Function Grapher 📈</button>
      </div>
    </div>

    <!-- QUICK EXAMPLE PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-keypad" data-expr="(25 + 75) / 4">🧮 (25 + 75) ÷ 4</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-keypad" data-expr="sin(30)">📐 sin(30°)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-keypad" data-expr="2^8">⚡ 2⁸</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-keypad" data-expr="sqrt(144)">√ √144</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-keypad" data-expr="log(1000)">📊 log(1000)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-keypad" data-expr="10 nCr 3">🎲 10 nCr 3</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-equations" data-qa="1" data-qb="-5" data-qc="6">✏️ x² − 5x + 6 = 0</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-graph" data-fn="sin(x)">📈 y = sin(x)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-4 sm:p-6 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20">

      <!-- 1. SCIENTIFIC KEYPAD PANEL -->
      <div id="panel-tab-keypad" class="sci-panel space-y-4">
        
        <!-- LCD Display -->
        <div class="relative overflow-hidden rounded-2xl border border-slate-700 bg-slate-950 p-4 sm:p-5 text-white shadow-2xl dark:border-slate-800">
          <div class="flex items-center justify-between text-[11px] font-mono font-bold text-slate-400 border-b border-slate-800 pb-1.5 mb-2">
            <div class="flex items-center gap-2">
              <span id="badge-angle-mode" class="rounded bg-blue-600/80 px-1.5 py-0.5 text-[10px] text-white">DEG</span>
              <span id="badge-mem" class="hidden rounded bg-emerald-600/80 px-1.5 py-0.5 text-[10px] text-white">M</span>
              <span id="badge-precision" class="text-slate-400">12-DIGIT</span>
            </div>
            <span class="text-slate-500">SCIENTIFIC ENGINE</span>
          </div>

          <!-- Upper Expression Line -->
          <div id="sci-expr-line" class="min-h-6 text-right font-mono text-sm sm:text-base text-slate-400 tracking-wide overflow-x-auto whitespace-nowrap scrollbar-none">
            &nbsp;
          </div>

          <!-- Main Result Line -->
          <div id="sci-result-line" class="mt-1 text-right font-mono text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white overflow-x-auto whitespace-nowrap scrollbar-none">
            0
          </div>
        </div>

        <!-- Controls Header: DEG/RAD/GRAD & Precision Format -->
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
          <!-- Angle Unit Mode Toggle -->
          <div class="flex items-center rounded-xl border border-slate-300 bg-white p-1 dark:border-slate-700 dark:bg-slate-800 font-bold">
            <button type="button" id="btn-mode-deg" class="rounded-lg bg-blue-600 px-2.5 py-1 text-white shadow-2xs cursor-pointer">DEG</button>
            <button type="button" id="btn-mode-rad" class="rounded-lg px-2.5 py-1 text-slate-700 hover:text-blue-600 dark:text-slate-300 cursor-pointer">RAD</button>
            <button type="button" id="btn-mode-grad" class="rounded-lg px-2.5 py-1 text-slate-700 hover:text-blue-600 dark:text-slate-300 cursor-pointer">GRAD</button>
          </div>

          <!-- Precision & Format Controls -->
          <div class="flex items-center gap-2">
            <select id="sel-sci-format" class="rounded-xl border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
              <option value="normal" selected>Normal Format</option>
              <option value="scientific">Scientific (1.25e+6)</option>
              <option value="engineering">Engineering Notation</option>
              <option value="12digit">12-Digit Display Mode</option>
            </select>
            <button type="button" id="btn-clear-entry" class="rounded-xl border border-slate-300 bg-white px-2.5 py-1 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">CE</button>
            <button type="button" id="btn-all-clear" class="rounded-xl bg-red-600 px-2.5 py-1 font-bold text-white hover:bg-red-700 shadow-2xs cursor-pointer">AC</button>
          </div>
        </div>

        <!-- 6-COLUMN RESPONSIVE SCIENTIFIC KEYPAD -->
        <div class="grid grid-cols-4 sm:grid-cols-6 gap-1.5 sm:gap-2 text-xs sm:text-sm font-bold select-none">
          
          <!-- ROW 1: Memory & Specials -->
          <button class="btn-key bg-slate-200/80 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-300" id="btn-mem-clear">MC</button>
          <button class="btn-key bg-slate-200/80 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-300" id="btn-mem-recall">MR</button>
          <button class="btn-key bg-slate-200/80 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-300" id="btn-mem-plus">M+</button>
          <button class="btn-key bg-slate-200/80 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-300" id="btn-mem-minus">M−</button>
          <button class="btn-key hidden sm:block bg-slate-200/80 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-300" data-insert="(">(</button>
          <button class="btn-key hidden sm:block bg-slate-200/80 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-300" data-insert=")">)</button>

          <!-- ROW 2: Trigonometry -->
          <button class="btn-key bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 p-2.5 rounded-xl hover:bg-blue-100" data-insert="sin(">sin</button>
          <button class="btn-key bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 p-2.5 rounded-xl hover:bg-blue-100" data-insert="cos(">cos</button>
          <button class="btn-key bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 p-2.5 rounded-xl hover:bg-blue-100" data-insert="tan(">tan</button>
          <button class="btn-key bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 p-2.5 rounded-xl hover:bg-blue-100" data-insert="asin(">sin⁻¹</button>
          <button class="btn-key hidden sm:block bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 p-2.5 rounded-xl hover:bg-blue-100" data-insert="acos(">cos⁻¹</button>
          <button class="btn-key hidden sm:block bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 p-2.5 rounded-xl hover:bg-blue-100" data-insert="atan(">tan⁻¹</button>

          <!-- ROW 3: Logs & Powers -->
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert="ln(">ln</button>
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert="log(">log</button>
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert="sqrt(">√x</button>
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert="^">xʸ</button>
          <button class="btn-key hidden sm:block bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert="^2">x²</button>
          <button class="btn-key hidden sm:block bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300 p-2.5 rounded-xl hover:bg-amber-200 text-base" data-insert="/">÷</button>

          <!-- ROW 4: Constants & Keypad Top -->
          <button class="btn-key bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 p-2.5 rounded-xl hover:bg-purple-100" data-insert="π">π</button>
          <button class="btn-key bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 p-2.5 rounded-xl hover:bg-purple-100" data-insert="e">e</button>
          <button class="btn-key bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="7">7</button>
          <button class="btn-key bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="8">8</button>
          <button class="btn-key hidden sm:block bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="9">9</button>
          <button class="btn-key hidden sm:block bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300 p-2.5 rounded-xl hover:bg-amber-200 text-base" data-insert="*">×</button>

          <!-- ROW 5: Combinatorics & Keypad Middle -->
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert="!">n!</button>
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert=" nCr ">nCr</button>
          <button class="btn-key bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="4">4</button>
          <button class="btn-key bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="5">5</button>
          <button class="btn-key hidden sm:block bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="6">6</button>
          <button class="btn-key hidden sm:block bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300 p-2.5 rounded-xl hover:bg-amber-200 text-base" data-insert="-">−</button>

          <!-- ROW 6: Keypad Lower -->
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" id="btn-backspace">⌫</button>
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert="%">%</button>
          <button class="btn-key bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="1">1</button>
          <button class="btn-key bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="2">2</button>
          <button class="btn-key hidden sm:block bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="3">3</button>
          <button class="btn-key hidden sm:block bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300 p-2.5 rounded-xl hover:bg-amber-200 text-base" data-insert="+">+</button>

          <!-- ROW 7: Bottom Action Row -->
          <button class="btn-key bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-200 p-2.5 rounded-xl hover:bg-slate-200" data-insert="(-)">±</button>
          <button class="btn-key bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert="0">0</button>
          <button class="btn-key bg-white border border-slate-300 dark:border-slate-700 dark:bg-slate-900 p-2.5 rounded-xl hover:bg-slate-50 text-base font-black" data-insert=".">.</button>
          <button class="btn-key col-span-1 sm:col-span-3 bg-blue-600 text-white p-2.5 rounded-xl text-lg font-black shadow-lg shadow-blue-600/30 hover:bg-blue-700 transition active:scale-[0.98] cursor-pointer" id="btn-calc-equal">=</button>
        </div>

      </div>

      <!-- 2. STATISTICS CALCULATOR PANEL -->
      <div id="panel-tab-stats" class="sci-panel hidden space-y-4">
        <div class="border-b border-slate-200 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>📊</span> Statistical Summary Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Enter dataset numbers separated by commas or spaces to compute descriptive statistics.
          </p>
        </div>

        <form id="form-sci-stats" class="space-y-4" novalidate onsubmit="return false;">
          <div>
            <label for="stats-input" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Dataset Values</label>
            <textarea id="stats-input" rows="3" class="mt-1.5 w-full rounded-2xl border border-slate-300 bg-white p-3 font-mono text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" placeholder="10, 15, 20, 25, 30">10, 15, 20, 25, 30</textarea>
          </div>

          <div class="flex items-center gap-2">
            <button type="submit" id="btn-stats-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate Statistics →
            </button>
            <button type="button" id="btn-stats-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <div id="res-stats-card" class="hidden space-y-3 rounded-3xl border border-blue-200 bg-white p-5 dark:border-blue-900/60 dark:bg-slate-900">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Descriptive Summary</span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
              <div class="rounded-xl border border-slate-200 p-2.5 dark:border-slate-800"><div class="text-slate-500">Sample Count (N)</div><div id="stat-count" class="text-base font-black text-slate-900 dark:text-white mt-1">5</div></div>
              <div class="rounded-xl border border-slate-200 p-2.5 dark:border-slate-800"><div class="text-slate-500">Mean (Average)</div><div id="stat-mean" class="text-base font-black text-blue-600 dark:text-blue-400 mt-1">20</div></div>
              <div class="rounded-xl border border-slate-200 p-2.5 dark:border-slate-800"><div class="text-slate-500">Median</div><div id="stat-median" class="text-base font-black text-emerald-600 dark:text-emerald-400 mt-1">20</div></div>
              <div class="rounded-xl border border-slate-200 p-2.5 dark:border-slate-800"><div class="text-slate-500">Std Deviation (s)</div><div id="stat-sd" class="text-base font-black text-purple-600 dark:text-purple-400 mt-1">7.9057</div></div>
            </div>
          </div>
        </form>
      </div>

      <!-- 3. MATRIX CALCULATOR PANEL -->
      <div id="panel-tab-matrix" class="sci-panel hidden space-y-4">
        <div class="border-b border-slate-200 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🏛️</span> 2×2 Matrix Operations & Determinant
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Compute determinants, matrix inversion, and transpose for standard square matrices.
          </p>
        </div>

        <form id="form-sci-matrix" class="space-y-4" novalidate onsubmit="return false;">
          <div class="flex items-center justify-center gap-3 py-2">
            <div class="grid grid-cols-2 gap-2 p-3 rounded-2xl border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 font-mono">
              <input type="number" id="m-00" value="4" class="w-16 rounded-xl border border-slate-300 p-2 text-center font-bold dark:border-slate-700 dark:bg-slate-800" />
              <input type="number" id="m-01" value="7" class="w-16 rounded-xl border border-slate-300 p-2 text-center font-bold dark:border-slate-700 dark:bg-slate-800" />
              <input type="number" id="m-10" value="2" class="w-16 rounded-xl border border-slate-300 p-2 text-center font-bold dark:border-slate-700 dark:bg-slate-800" />
              <input type="number" id="m-11" value="6" class="w-16 rounded-xl border border-slate-300 p-2 text-center font-bold dark:border-slate-700 dark:bg-slate-800" />
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button type="submit" id="btn-matrix-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Evaluate Matrix →
            </button>
            <button type="button" id="btn-matrix-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <div id="res-matrix-card" class="hidden space-y-3 rounded-3xl border border-blue-200 bg-white p-5 dark:border-blue-900/60 dark:bg-slate-900 text-xs">
            <div class="border-b border-slate-200 pb-2 dark:border-slate-800">
              <span class="font-bold text-slate-500">Determinant |A|:</span>
              <span id="mat-det" class="ml-2 text-xl font-black text-blue-600 dark:text-blue-400">10</span>
            </div>
            <div id="mat-inv" class="font-mono text-slate-700 dark:text-slate-300"></div>
          </div>
        </form>
      </div>

      <!-- 4. EQUATION SOLVER PANEL -->
