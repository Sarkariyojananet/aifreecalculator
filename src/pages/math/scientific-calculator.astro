<!-- CLIENT-SIDE INTERACTIVE CALCULATOR LOGIC -->
<script is:inline>
  // DOM Elements
  const sciExprLine = document.getElementById('sci-expr-line');
  const sciResultLine = document.getElementById('sci-result-line');
  const badgeAngleMode = document.getElementById('badge-angle-mode');
  const badgeMem = document.getElementById('badge-mem');
  const badgePrecision = document.getElementById('badge-precision');

  const btnModeDeg = document.getElementById('btn-mode-deg');
  const btnModeRad = document.getElementById('btn-mode-rad');
  const btnModeGrad = document.getElementById('btn-mode-grad');
  const selSciFormat = document.getElementById('sel-sci-format');

  const btnClearEntry = document.getElementById('btn-clear-entry');
  const btnAllClear = document.getElementById('btn-all-clear');
  const btnBackspace = document.getElementById('btn-backspace');
  const btnCalcEqual = document.getElementById('btn-calc-equal');

  const btnMemClear = document.getElementById('btn-mem-clear');
  const btnMemRecall = document.getElementById('btn-mem-recall');
  const btnMemPlus = document.getElementById('btn-mem-plus');
  const btnMemMinus = document.getElementById('btn-mem-minus');

  const sciHistoryBox = document.getElementById('sci-history-box');
  const sciHistoryList = document.getElementById('sci-history-list');
  const btnClearHistory = document.getElementById('btn-clear-history');

  // State
  let currentExpression = '';
  let angleMode = 'DEG'; // DEG, RAD, GRAD
  let memoryValue = 0;
  let hasMemory = false;
  let historyLogs = [];

  // Angle Mode Buttons
  function setAngleMode(mode) {
    angleMode = mode;
    badgeAngleMode.textContent = mode;
    [btnModeDeg, btnModeRad, btnModeGrad].forEach((b) => {
      b.className = 'rounded-lg px-2.5 py-1 text-slate-700 hover:text-blue-600 dark:text-slate-300 cursor-pointer';
    });
    if (mode === 'DEG') btnModeDeg.className = 'rounded-lg bg-blue-600 px-2.5 py-1 text-white shadow-2xs cursor-pointer';
    if (mode === 'RAD') btnModeRad.className = 'rounded-lg bg-blue-600 px-2.5 py-1 text-white shadow-2xs cursor-pointer';
    if (mode === 'GRAD') btnModeGrad.className = 'rounded-lg bg-blue-600 px-2.5 py-1 text-white shadow-2xs cursor-pointer';
  }

  btnModeDeg.addEventListener('click', () => setAngleMode('DEG'));
  btnModeRad.addEventListener('click', () => setAngleMode('RAD'));
  btnModeGrad.addEventListener('click', () => setAngleMode('GRAD'));

  // Format selection
  selSciFormat.addEventListener('change', () => {
    badgePrecision.textContent = selSciFormat.value.toUpperCase();
  });

  // Memory Buttons
  btnMemClear.addEventListener('click', () => {
    memoryValue = 0;
    hasMemory = false;
    badgeMem.classList.add('hidden');
  });

  btnMemRecall.addEventListener('click', () => {
    if (hasMemory) {
      currentExpression += String(memoryValue);
      updateDisplay();
    }
  });

  btnMemPlus.addEventListener('click', () => {
    const val = parseFloat(sciResultLine.textContent) || 0;
    memoryValue += val;
    hasMemory = true;
    badgeMem.classList.remove('hidden');
  });

  btnMemMinus.addEventListener('click', () => {
    const val = parseFloat(sciResultLine.textContent) || 0;
    memoryValue -= val;
    hasMemory = true;
    badgeMem.classList.remove('hidden');
  });

  // Display Updates
  function updateDisplay() {
    sciExprLine.textContent = currentExpression || '\u00A0';
  }

  // Keypad Inserts
  document.querySelectorAll('.btn-key[data-insert]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-insert');
      if (val === '(-)') {
        currentExpression += '-';
      } else {
        currentExpression += val;
      }
      updateDisplay();
    });
  });

  btnClearEntry.addEventListener('click', () => {
    currentExpression = '';
    updateDisplay();
  });

  btnAllClear.addEventListener('click', () => {
    currentExpression = '';
    sciExprLine.textContent = '\u00A0';
    sciResultLine.textContent = '0';
  });

  btnBackspace.addEventListener('click', () => {
    currentExpression = currentExpression.slice(0, -1);
    updateDisplay();
  });

  // Safe Math Evaluator
  function evaluateExpressionSafe(raw) {
    if (!raw.trim()) return 0;
    let s = raw
      .replace(/×/g, '*')
      .replace(/÷/g, '/')
      .replace(/π/g, `${Math.PI}`)
      .replace(/e(?![a-z])/gi, `${Math.E}`)
      .replace(/\^/g, '**');

    // Combinatorics: a nCr b ➔ combinations
    s = s.replace(/(\d+)\s*nCr\s*(\d+)/gi, (_, n, r) => {
      const fn = parseInt(n), fr = parseInt(r);
      let num = 1, den = 1;
      for (let i = 0; i < fr; i++) { num *= (fn - i); den *= (i + 1); }
      return String(Math.round(num / den));
    });

    // Factorial: n!
    s = s.replace(/(\d+)!/g, (_, n) => {
      const num = parseInt(n);
      let res = 1;
      for (let i = 2; i <= Math.min(num, 170); i++) res *= i;
      return String(res);
    });

    // Trigonometry conversions
    const toRad = (m) => {
      if (angleMode === 'DEG') return `((${m}) * Math.PI / 180)`;
      if (angleMode === 'GRAD') return `((${m}) * Math.PI / 200)`;
      return `(${m})`;
    };

    const fromRad = (m) => {
      if (angleMode === 'DEG') return `((${m}) * 180 / Math.PI)`;
      if (angleMode === 'GRAD') return `((${m}) * 200 / Math.PI)`;
      return `(${m})`;
    };

    s = s.replace(/asin\(([^)]+)\)/g, (_, m) => fromRad(`Math.asin(${m})`));
    s = s.replace(/acos\(([^)]+)\)/g, (_, m) => fromRad(`Math.acos(${m})`));
    s = s.replace(/atan\(([^)]+)\)/g, (_, m) => fromRad(`Math.atan(${m})`));

    s = s.replace(/sin\(([^)]+)\)/g, (_, m) => `Math.sin(${toRad(m)})`);
    s = s.replace(/cos\(([^)]+)\)/g, (_, m) => `Math.cos(${toRad(m)})`);
    s = s.replace(/tan\(([^)]+)\)/g, (_, m) => `Math.tan(${toRad(m)})`);

    s = s.replace(/ln\(/g, 'Math.log(');
    s = s.replace(/log\(/g, 'Math.log10(');
    s = s.replace(/sqrt\(/g, 'Math.sqrt(');

    // Only allow valid safe characters
    if (!/^[0-9+\-*/().\s,MathPIEpowsqrtsincotanlogasinacosatan]+$/.test(s)) {
      throw new Error('Invalid mathematical expression syntax.');
    }

    // Safe mathematical evaluation
    // eslint-disable-next-line no-new-func
    const val = Function(`"use strict"; return (${s});`)();
    if (typeof val !== 'number' || isNaN(val)) throw new Error('Mathematical domain error.');
    return val;
  }

  function formatOutput(val) {
    const fmt = selSciFormat.value;
    if (fmt === 'scientific') return val.toExponential(6);
    if (fmt === 'engineering') return val.toExponential(6).replace('e', 'E');
    if (fmt === '12digit') return Number(val.toPrecision(12)).toString();
    return Number(val.toFixed(8)).toString();
  }

  function executeScientificCalc() {
    if (!currentExpression.trim()) return;
    try {
      const val = evaluateExpressionSafe(currentExpression);
      const formatted = formatOutput(val);
      sciExprLine.textContent = `${currentExpression} =`;
      sciResultLine.textContent = formatted;

      // Add to history
      historyLogs.unshift(`${currentExpression} = ${formatted}`);
      if (historyLogs.length > 20) historyLogs.pop();
      renderHistory();

      currentExpression = formatted;
    } catch (e) {
      sciResultLine.textContent = 'Error';
    }
  }

  btnCalcEqual.addEventListener('click', executeScientificCalc);

  function renderHistory() {
    if (historyLogs.length === 0) {
      sciHistoryBox.classList.add('hidden');
      return;
    }
    sciHistoryBox.classList.remove('hidden');
    sciHistoryList.innerHTML = historyLogs
      .map(
        (log) => `
      <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200">
        ${log}
      </div>
    `
      )
      .join('');
  }

  btnClearHistory.addEventListener('click', () => {
    historyLogs = [];
    renderHistory();
  });

  // Tab Navigation
  const sciTabs = document.querySelectorAll('.btn-sci-tab');
  const sciPanels = document.querySelectorAll('.sci-panel');

  function switchSciTab(tabId) {
    sciTabs.forEach((btn) => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.className = 'btn-sci-tab active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-sci-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    sciPanels.forEach((panel) => {
      if (panel.id === `panel-${tabId}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    if (tabId === 'tab-graph') {
      plotGraph();
    }
  }

  sciTabs.forEach((btn) => {
    btn.addEventListener('click', () => switchSciTab(btn.getAttribute('data-tab')));
  });

  // ==========================================
  // 2. STATISTICS MODE
  // ==========================================
  const statsInput = document.getElementById('stats-input');
  const btnStatsCalc = document.getElementById('btn-stats-calc');
  const btnStatsClear = document.getElementById('btn-stats-clear');
  const resStatsCard = document.getElementById('res-stats-card');
  const statCount = document.getElementById('stat-count');
  const statMean = document.getElementById('stat-mean');
  const statMedian = document.getElementById('stat-median');
  const statSd = document.getElementById('stat-sd');

  btnStatsCalc.addEventListener('click', () => {
    const raw = statsInput.value.split(/[\s,]+/).map(parseFloat).filter((n) => !isNaN(n));
    if (raw.length === 0) return;
    raw.sort((a, b) => a - b);
    const count = raw.length;
    const sum = raw.reduce((a, b) => a + b, 0);
    const mean = sum / count;
    const mid = Math.floor(count / 2);
    const median = count % 2 === 0 ? (raw[mid - 1] + raw[mid]) / 2 : raw[mid];
    const variance = count > 1 ? raw.reduce((acc, v) => acc + Math.pow(v - mean, 2), 0) / (count - 1) : 0;
    const sd = Math.sqrt(variance);

    statCount.textContent = count;
    statMean.textContent = Number(mean.toFixed(4));
    statMedian.textContent = Number(median.toFixed(4));
    statSd.textContent = Number(sd.toFixed(4));
    resStatsCard.classList.remove('hidden');
  });

  btnStatsClear.addEventListener('click', () => {
    statsInput.value = '10, 15, 20, 25, 30';
    resStatsCard.classList.add('hidden');
  });

  // ==========================================
  // 3. MATRIX CALCULATOR
  // ==========================================
  const m00 = document.getElementById('m-00');
  const m01 = document.getElementById('m-01');
  const m10 = document.getElementById('m-10');
  const m11 = document.getElementById('m-11');
  const btnMatrixCalc = document.getElementById('btn-matrix-calc');
  const btnMatrixClear = document.getElementById('btn-matrix-clear');
  const resMatrixCard = document.getElementById('res-matrix-card');
  const matDet = document.getElementById('mat-det');
  const matInv = document.getElementById('mat-inv');

  btnMatrixCalc.addEventListener('click', () => {
    const a = parseFloat(m00.value) || 0;
    const b = parseFloat(m01.value) || 0;
    const c = parseFloat(m10.value) || 0;
    const d = parseFloat(m11.value) || 0;

    const det = a * d - b * c;
    matDet.textContent = det;

    if (Math.abs(det) > 1e-9) {
      matInv.innerHTML = `Inverse Matrix A⁻¹: <br/> [ ${(d/det).toFixed(3)}, ${(-b/det).toFixed(3)} ] <br/> [ ${(-c/det).toFixed(3)}, ${(a/det).toFixed(3)} ]`;
    } else {
      matInv.textContent = 'Inverse does not exist (Determinant = 0).';
    }
    resMatrixCard.classList.remove('hidden');
  });

  btnMatrixClear.addEventListener('click', () => {
    m00.value = '4'; m01.value = '7'; m10.value = '2'; m11.value = '6';
    resMatrixCard.classList.add('hidden');
  });

  // ==========================================
  // 4. QUADRATIC EQUATION SOLVER
  // ==========================================
  const quadA = document.getElementById('quad-a');
  const quadB = document.getElementById('quad-b');
  const quadC = document.getElementById('quad-c');
  const btnQuadCalc = document.getElementById('btn-quad-calc');
  const btnQuadClear = document.getElementById('btn-quad-clear');
  const resQuadCard = document.getElementById('res-quad-card');
  const quadRoots = document.getElementById('quad-roots');
  const quadStep = document.getElementById('quad-step');

  btnQuadCalc.addEventListener('click', () => {
    const a = parseFloat(quadA.value);
    const b = parseFloat(quadB.value);
    const c = parseFloat(quadC.value);

    if (isNaN(a) || isNaN(b) || isNaN(c) || a === 0) return;
    const disc = b * b - 4 * a * c;

    if (disc >= 0) {
      const r1 = (-b + Math.sqrt(disc)) / (2 * a);
      const r2 = (-b - Math.sqrt(disc)) / (2 * a);
      quadRoots.textContent = `x₁ = ${Number(r1.toFixed(4))},  x₂ = ${Number(r2.toFixed(4))}`;
      quadStep.textContent = `Discriminant Δ = ${disc}. Real distinct roots.`;
    } else {
      const real = (-b / (2 * a)).toFixed(3);
      const imag = (Math.sqrt(-disc) / (2 * a)).toFixed(3);
      quadRoots.textContent = `x = ${real} ± ${imag}i`;
      quadStep.textContent = `Discriminant Δ = ${disc} < 0 (Complex Conjugate Roots).`;
    }
    resQuadCard.classList.remove('hidden');
  });

  btnQuadClear.addEventListener('click', () => {
    quadA.value = '1'; quadB.value = '-5'; quadC.value = '6';
    resQuadCard.classList.add('hidden');
  });

  // ==========================================
  // 5. 2D FUNCTION PLOTTER CANVAS
  // ==========================================
  const graphCanvas = document.getElementById('graph-canvas');
  const graphCtx = graphCanvas.getContext('2d');
  const graphFnInput = document.getElementById('graph-fn-input');
  const btnPlotGraph = document.getElementById('btn-plot-graph');

  function plotGraph() {
    const w = graphCanvas.width;
    const h = graphCanvas.height;
    graphCtx.clearRect(0, 0, w, h);

    // Draw Axes & Grid
    graphCtx.strokeStyle = '#334155';
    graphCtx.lineWidth = 1;

    // Grid
    for (let x = 0; x < w; x += 40) {
      graphCtx.beginPath(); graphCtx.moveTo(x, 0); graphCtx.lineTo(x, h); graphCtx.stroke();
    }
    for (let y = 0; y < h; y += 40) {
      graphCtx.beginPath(); graphCtx.moveTo(0, y); graphCtx.lineTo(w, y); graphCtx.stroke();
    }

    // Main Axes
    graphCtx.strokeStyle = '#94a3b8';
    graphCtx.lineWidth = 1.5;
    graphCtx.beginPath(); graphCtx.moveTo(0, h / 2); graphCtx.lineTo(w, h / 2); graphCtx.stroke();
    graphCtx.beginPath(); graphCtx.moveTo(w / 2, 0); graphCtx.lineTo(w / 2, h); graphCtx.stroke();

    // Plot Curve
    const fnStr = graphFnInput.value.trim();
    graphCtx.strokeStyle = '#3b82f6';
    graphCtx.lineWidth = 2.5;
    graphCtx.beginPath();

    const scaleX = 30; // 30px per unit
    const scaleY = 30;
    const centerX = w / 2;
    const centerY = h / 2;

    let started = false;
    for (let px = 0; px < w; px += 2) {
      const x = (px - centerX) / scaleX;
      let y = 0;
      try {
        let expr = fnStr
          .replace(/sin\(/g, 'Math.sin(')
          .replace(/cos\(/g, 'Math.cos(')
          .replace(/tan\(/g, 'Math.tan(')
          .replace(/sqrt\(/g, 'Math.sqrt(')
          .replace(/x/g, `(${x})`)
          .replace(/\^/g, '**');
        // eslint-disable-next-line no-new-func
        y = Function(`"use strict"; return (${expr});`)();
      } catch {
        continue;
      }

      if (typeof y === 'number' && !isNaN(y)) {
        const py = centerY - y * scaleY;
        if (!started) {
          graphCtx.moveTo(px, py);
          started = true;
        } else {
          graphCtx.lineTo(px, py);
        }
      }
    }
    graphCtx.stroke();
  }

  btnPlotGraph.addEventListener('click', plotGraph);

  // Preset Buttons
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      switchSciTab(target);

      if (target === 'tab-keypad') {
        currentExpression = btn.getAttribute('data-expr');
        updateDisplay();
      } else if (target === 'tab-equations') {
        quadA.value = btn.getAttribute('data-qa');
        quadB.value = btn.getAttribute('data-qb');
        quadC.value = btn.getAttribute('data-qc');
      } else if (target === 'tab-graph') {
        graphFnInput.value = btn.getAttribute('data-fn');
        plotGraph();
      }
    });
  });

  // Keyboard Navigation Support
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if ('0123456789+-*/().^%'.includes(e.key)) {
      currentExpression += e.key;
      updateDisplay();
    } else if (e.key === 'Enter' || e.key === '=') {
      e.preventDefault();
      executeScientificCalc();
    } else if (e.key === 'Backspace') {
      currentExpression = currentExpression.slice(0, -1);
      updateDisplay();
    } else if (e.key === 'Escape') {
      currentExpression = '';
      updateDisplay();
    }
  });
</script>
