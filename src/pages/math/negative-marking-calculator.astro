          </li>
          <li>
            <strong>Do Not Panic Guess in the Final 10 Minutes:</strong>
            Aspirants who feel their attempt count is low often panic in the last few minutes and rapidly bubble random guesses. This almost always results in a cascade of negative deductions that pulls them below the cut-off.
          </li>
          <li>
            <strong>Audit Every Mock Test with an Error Log:</strong>
            After every mock exam, categorize each incorrect answer into one of three buckets: (a) <em>Lack of Knowledge</em>, (b) <em>Silly Reading Error</em>, or (c) <em>Flawed Elimination Guess</em>. Tracking these in our negative marking calculator will pinpoint your exact optimal attempt threshold.
          </li>
        </ol>
      </section>

    </article>
  </Fragment>

</CalculatorLayout>

<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  (function initNegativeMarkingCalculator() {
    // DOM Elements - Tab 1
    const inpTotalQ = document.getElementById('inp-total-q');
    const inpPosMarks = document.getElementById('inp-pos-marks');
    const inpCorrectQ = document.getElementById('inp-correct-q');
    const inpWrongQ = document.getElementById('inp-wrong-q');
    const selectNegFraction = document.getElementById('select-neg-fraction');
    const inpNegMarks = document.getElementById('inp-neg-marks');
    const negMarksBadge = document.getElementById('neg-marks-badge');
    const chkUnattempted = document.getElementById('chk-unattempted');
    const unattemptedValRow = document.getElementById('unattempted-val-row');
    const inpUnattPenalty = document.getElementById('inp-unatt-penalty');
    const scoreErr = document.getElementById('score-err');
    const activeExamBadge = document.getElementById('active-exam-badge');

    // Result DOM Elements
    const resNetScore = document.getElementById('res-net-score');
    const resMaxMarks = document.getElementById('res-max-marks');
    const resNetPercent = document.getElementById('res-net-percent');
    const resGrossMarks = document.getElementById('res-gross-marks');
    const resPenaltyMarks = document.getElementById('res-penalty-marks');
    const resAccuracyRate = document.getElementById('res-accuracy-rate');
    const resMarksLost = document.getElementById('res-marks-lost');
    const resAttemptedSummary = document.getElementById('res-attempted-summary');
    const badgeAccuracyPill = document.getElementById('badge-accuracy-pill');

    const barCorrect = document.getElementById('bar-correct');
    const barWrong = document.getElementById('bar-wrong');
    const barUnattempted = document.getElementById('bar-unattempted');
    const barLblC = document.getElementById('bar-lbl-c');
    const barLblW = document.getElementById('bar-lbl-w');
    const barLblU = document.getElementById('bar-lbl-u');
    const labelCorrectPct = document.getElementById('label-correct-pct');
    const labelWrongPct = document.getElementById('label-wrong-pct');

    // Tab buttons and panels
    const tabButtons = document.querySelectorAll('.btn-calc-tab');
    const panels = document.querySelectorAll('.calc-panel');
    const presetButtons = document.querySelectorAll('.btn-exam-preset');

    // 1. Tab Switching
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tabButtons.forEach(b => {
          b.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-xs');
          b.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
        });
        btn.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-xs');
        btn.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');

        const targetTab = btn.getAttribute('data-tab');
        panels.forEach(p => {
          if (p.id === 'panel-' + targetTab) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // 2. Preset Selection
    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        presetButtons.forEach(b => {
          b.classList.remove('active', 'border-blue-600', 'bg-blue-50', 'dark:bg-blue-950/60', 'text-blue-700', 'dark:text-blue-300', 'font-bold');
          b.classList.add('border-slate-300', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
        });
        btn.classList.add('active', 'border-blue-600', 'bg-blue-50', 'dark:bg-blue-950/60', 'text-blue-700', 'dark:text-blue-300', 'font-bold');
        btn.classList.remove('border-slate-300', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');

        const total = btn.getAttribute('data-total');
        const pos = btn.getAttribute('data-pos');
        const neg = btn.getAttribute('data-neg');
        const examName = btn.textContent.trim();

        if (total) inpTotalQ.value = total;
        if (pos) inpPosMarks.value = pos;
        if (neg) {
          inpNegMarks.value = Number(neg).toFixed(4).replace(/\.?0+$/, '');
        }

        activeExamBadge.textContent = examName;
        updateNegativeMarkFromFraction();
        calculateScore();
      });
    });

    // 3. Fraction to Decimal update
    function updateNegativeMarkFromFraction() {
      const fracVal = selectNegFraction.value;
      const posVal = parseFloat(inpPosMarks.value) || 0;

      if (fracVal !== 'custom') {
        const factor = parseFloat(fracVal);
        const calculatedNeg = factor >= 1.0 && fracVal === '1.0' ? 1.0 : (posVal * factor);
        inpNegMarks.value = calculatedNeg.toFixed(4).replace(/\.?0+$/, '');
      }

      const currentNeg = parseFloat(inpNegMarks.value) || 0;
      negMarksBadge.textContent = `-${currentNeg.toFixed(2)} pts`;
    }

    selectNegFraction.addEventListener('change', () => {
      updateNegativeMarkFromFraction();
      calculateScore();
    });

    inpPosMarks.addEventListener('input', () => {
      updateNegativeMarkFromFraction();
      calculateScore();
    });

    inpNegMarks.addEventListener('input', () => {
      const currentNeg = parseFloat(inpNegMarks.value) || 0;
      negMarksBadge.textContent = `-${currentNeg.toFixed(2)} pts`;
      selectNegFraction.value = 'custom';
      calculateScore();
    });

    // Toggle unattempted row
    chkUnattempted.addEventListener('change', () => {
      if (chkUnattempted.checked) {
        unattemptedValRow.classList.remove('hidden');
      } else {
        unattemptedValRow.classList.add('hidden');
        inpUnattPenalty.value = '0';
      }
      calculateScore();
    });

    inpUnattPenalty.addEventListener('input', calculateScore);

    // 4. Main Score Calculator
    function calculateScore() {
      const totalQ = Math.max(1, parseInt(inpTotalQ.value) || 0);
      const correctQ = Math.max(0, parseInt(inpCorrectQ.value) || 0);
      const wrongQ = Math.max(0, parseInt(inpWrongQ.value) || 0);
      const posMarks = Math.max(0.01, parseFloat(inpPosMarks.value) || 0);
      const negMarks = Math.max(0, parseFloat(inpNegMarks.value) || 0);
      const unattPenalty = chkUnattempted.checked ? Math.max(0, parseFloat(inpUnattPenalty.value) || 0) : 0;

      const attempted = correctQ + wrongQ;

      // Validation
      if (attempted > totalQ) {
        scoreErr.textContent = `Warning: Attempted questions (${attempted}) cannot exceed total questions (${totalQ}). Please verify your entries.`;
        scoreErr.classList.remove('hidden');
      } else {
        scoreErr.classList.add('hidden');
      }

      const unattempted = Math.max(0, totalQ - attempted);
      const gross = correctQ * posMarks;
      const penalty = wrongQ * negMarks + (unattempted * unattPenalty);
      const net = gross - penalty;
      const maxMarks = totalQ * posMarks;
      const netPct = maxMarks > 0 ? (net / maxMarks) * 100 : 0;
      const accuracy = attempted > 0 ? (correctQ / attempted) * 100 : 0;
      const marksLost = gross > 0 ? (penalty / gross) * 100 : 0;

      // Update Labels
      labelCorrectPct.textContent = attempted > 0 ? `(${((correctQ / attempted) * 100).toFixed(1)}%)` : '(0%)';
      labelWrongPct.textContent = attempted > 0 ? `(${((wrongQ / attempted) * 100).toFixed(1)}%)` : '(0%)';

      // Update DOM Text
      resNetScore.textContent = net.toFixed(2);
      resMaxMarks.textContent = `/ ${maxMarks.toFixed(0)}`;
      resNetPercent.textContent = `${netPct.toFixed(2)}%`;
      resGrossMarks.textContent = `+${gross.toFixed(2)}`;
      resPenaltyMarks.textContent = `-${penalty.toFixed(2)}`;
      resAccuracyRate.textContent = `${accuracy.toFixed(1)}%`;
      resMarksLost.textContent = `${marksLost.toFixed(1)}%`;
      resAttemptedSummary.textContent = `${attempted} / ${totalQ} Attempted (${unattempted} Unattempted)`;

      // Update Accuracy Pill
      badgeAccuracyPill.textContent = `${accuracy.toFixed(1)}% Accuracy`;
      if (accuracy >= 80) {
        badgeAccuracyPill.className = 'rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-extrabold';
      } else if (accuracy >= 65) {
        badgeAccuracyPill.className = 'rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30 px-2.5 py-0.5 text-[11px] font-extrabold';
      } else {
        badgeAccuracyPill.className = 'rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/30 px-2.5 py-0.5 text-[11px] font-extrabold';
      }

      // Update Segmented Bar
      const correctPct = (correctQ / totalQ) * 100;
      const wrongPct = (wrongQ / totalQ) * 100;
      const unattemptedPct = (unattempted / totalQ) * 100;

      barCorrect.style.width = `${correctPct}%`;
      barWrong.style.width = `${wrongPct}%`;
      barUnattempted.style.width = `${unattemptedPct}%`;

      barLblC.textContent = correctQ;
      barLblW.textContent = wrongQ;
      barLblU.textContent = unattempted;
    }

    [inpTotalQ, inpCorrectQ, inpWrongQ].forEach(el => {
      el.addEventListener('input', calculateScore);
    });

    document.getElementById('btn-calc-score').addEventListener('click', calculateScore);

    document.getElementById('btn-reset-score').addEventListener('click', () => {
      inpTotalQ.value = '100';
      inpPosMarks.value = '2';
      inpCorrectQ.value = '65';
      inpWrongQ.value = '20';
      selectNegFraction.value = '0.333333';
      updateNegativeMarkFromFraction();
      chkUnattempted.checked = false;
      unattemptedValRow.classList.add('hidden');
      calculateScore();
    });

    // Copy Scorecard Summary
    document.getElementById('btn-copy-scorecard').addEventListener('click', () => {
      const summaryText = `📊 Exam Scorecard Summary:
• Total Questions: ${inpTotalQ.value}
• Correct: ${inpCorrectQ.value} (+${resGrossMarks.textContent})
• Wrong: ${inpWrongQ.value} (${resPenaltyMarks.textContent})
• Final Net Score: ${resNetScore.textContent} ${resMaxMarks.textContent} (${resNetPercent.textContent})
• Accuracy Rate: ${resAccuracyRate.textContent}
• Calculated via AI Free Calculator (https://aifreecalculator.com/math/negative-marking-calculator/)`;

      navigator.clipboard.writeText(summaryText).then(() => {
        const btn = document.getElementById('btn-copy-scorecard');
        const prevText = btn.textContent;
        btn.textContent = '✓ Copied to Clipboard!';
        btn.classList.add('bg-emerald-600', 'text-white');
        setTimeout(() => {
          btn.textContent = prevText;
          btn.classList.remove('bg-emerald-600', 'text-white');
        }, 2000);
      });
    });

    // 5. Target Score Planner Tab
    const inpPlanTarget = document.getElementById('inp-plan-target');
    const inpPlanAccuracy = document.getElementById('inp-plan-accuracy');
    const inpPlanPos = document.getElementById('inp-plan-pos');
    const inpPlanNeg = document.getElementById('inp-plan-neg');
    const btnRunPlanner = document.getElementById('btn-run-planner');

    const planResAttempts = document.getElementById('plan-res-attempts');
    const planBadgeTarget = document.getElementById('plan-badge-target');
    const planResCorrect = document.getElementById('plan-res-correct');
    const planResWrong = document.getElementById('plan-res-wrong');
    const planResNet = document.getElementById('plan-res-net');

    function calculateTargetPlan() {
      const target = parseFloat(inpPlanTarget.value) || 0;
      const accPct = Math.min(100, Math.max(1, parseFloat(inpPlanAccuracy.value) || 75));
      const pos = Math.max(0.1, parseFloat(inpPlanPos.value) || 2);
      const neg = Math.max(0, parseFloat(inpPlanNeg.value) || 0.6667);

      const acc = accPct / 100;
      const scorePerAttempt = (acc * pos) - ((1 - acc) * neg);

      if (scorePerAttempt <= 0) {
        planResAttempts.textContent = 'Infeasible';
        planResCorrect.textContent = '0';
        planResWrong.textContent = '0';
        planResNet.textContent = '0';
        return;
      }

      const reqAttempts = Math.ceil(target / scorePerAttempt);
      const expCorrect = Math.round(reqAttempts * acc);
      const expWrong = reqAttempts - expCorrect;
      const expNet = (expCorrect * pos) - (expWrong * neg);

      planResAttempts.textContent = reqAttempts;
      planBadgeTarget.textContent = `${target} Marks`;
      planResCorrect.textContent = `${expCorrect} Qs (+${(expCorrect * pos).toFixed(1)} pts)`;
      planResWrong.textContent = `${expWrong} Qs (-${(expWrong * neg).toFixed(1)} pts)`;
      planResNet.textContent = `${expNet.toFixed(2)} pts`;
    }

    btnRunPlanner.addEventListener('click', calculateTargetPlan);

    // 6. Guessing EV Analyzer Tab
    const inpEvPos = document.getElementById('inp-ev-pos');
    const inpEvNeg = document.getElementById('inp-ev-neg');
    const btnCalcEv = document.getElementById('btn-calc-ev');

    const evVal2 = document.getElementById('ev-val-2');
    const evDesc2 = document.getElementById('ev-desc-2');
    const evVal3 = document.getElementById('ev-val-3');
    const evDesc3 = document.getElementById('ev-desc-3');
    const evVal4 = document.getElementById('ev-val-4');
    const evDesc4 = document.getElementById('ev-desc-4');

    function calculateEVs() {
      const pos = parseFloat(inpEvPos.value) || 2;
      const neg = parseFloat(inpEvNeg.value) || 0.6667;

      // 2 options (50% prob)
      const ev2 = (0.5 * pos) - (0.5 * neg);
      evVal2.textContent = `${ev2 >= 0 ? '+' : ''}${ev2.toFixed(2)} pts`;
      evDesc2.innerHTML = ev2 > 0
        ? `<strong>Highly Favorable!</strong> With 50% probability, guessing gains <strong>+${(ev2 * 10).toFixed(1)} marks</strong> over 10 questions.`
        : `Unfavorable. Avoid guessing.`;

      // 3 options (33.3% prob)
      const ev3 = ((1 / 3) * pos) - ((2 / 3) * neg);
      evVal3.textContent = `${ev3 >= 0 ? '+' : ''}${ev3.toFixed(2)} pts`;
      evDesc3.innerHTML = ev3 > 0
        ? `<strong>Favorable.</strong> Expected gain of <strong>+${(ev3 * 10).toFixed(1)} marks</strong> per 10 eliminated guesses.`
        : `<strong>Unfavorable.</strong> The penalty outweighs the 33% chance.`;

      // 4 options (25% prob)
      const ev4 = (0.25 * pos) - (0.75 * neg);
      evVal4.textContent = `${ev4 >= 0 ? '+' : ''}${ev4.toFixed(2)} pts`;
      evDesc4.innerHTML = ev4 === 0
        ? `<strong>Statistically Neutral (~0.00 pts).</strong> Random guessing neither adds nor subtracts score on average.`
        : (ev4 > 0 ? `Mild positive expected value.` : `<strong>Negative EV.</strong> Blind guessing will actively lower your rank.`);
    }

    btnCalcEv.addEventListener('click', calculateEVs);

    // Initial calculation on page load
    updateNegativeMarkFromFraction();
    calculateScore();
    calculateTargetPlan();
    calculateEVs();
  })();
</script>
