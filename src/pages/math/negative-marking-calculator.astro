---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { EXAM_PRESETS } from '../../lib/calculators/negative-marking';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
---

<CalculatorLayout
  title="Negative Marking Calculator – Competitive Exam Score & Penalty Estimator"
  description="Calculate your net score, negative marks penalty, accuracy rate, and cut-off safety for competitive exams like UPSC, SSC, JEE, NEET, GATE, and Bank PO."
  category="Math"
  calculatorName="Negative Marking Calculator"
  slug="negative-marking-calculator"
  keywords={[
    "negative marking calculator",
    "upsc negative marking calculator",
    "1/3 negative marking calculator",
    "0.25 negative marking calculator",
    "1/4 negative marking calculator",
    "exam negative marking calculator",
    "negative marking formula",
    "neet negative marking calculator",
    "jee negative marking calculator",
    "ssc negative marking calculator",
    "gate negative marks calculator",
    "competitive exam score calculator",
    "wrong answer penalty calculator",
    "exam marks deduction calculator",
    "cutoff score calculator"
  ]}
>
  <div class="space-y-6">

    <!-- QUICK PRESET CHIPS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
          <span>⚡</span> Quick Exam Presets:
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5 text-xs" id="preset-container">
        {EXAM_PRESETS.map((preset) => (
          <button
            type="button"
            class="btn-exam-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition text-left"
            data-total={preset.totalQuestions}
            data-pos={preset.positiveMarks}
            data-neg={preset.negativeMarks}
            data-id={preset.id}
          >
            {preset.name}
          </button>
        ))}
        <button
          type="button"
          class="btn-exam-preset active rounded-lg border border-blue-600 bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 px-2.5 py-1.5 font-bold cursor-pointer transition text-left"
          data-total="100"
          data-pos="2"
          data-neg="0.6667"
          data-id="custom"
        >
          Custom Exam
        </button>
      </div>
    </div>

    <!-- MODE TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button
          type="button"
          class="btn-calc-tab active shrink-0 rounded-xl bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition"
          data-tab="tab-score"
        >
          📊 Exam Score Calculator
        </button>
        <button
          type="button"
          class="btn-calc-tab shrink-0 rounded-xl border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-tab="tab-target"
        >
          🎯 Target Score &amp; Attempt Planner
        </button>
        <button
          type="button"
          class="btn-calc-tab shrink-0 rounded-xl border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          data-tab="tab-guessing"
        >
          🎲 Guessing Risk &amp; Expected Value (EV)
        </button>
      </div>
    </div>

    <!-- TAB 1: EXAM SCORE CALCULATOR -->
    <div id="panel-tab-score" class="calc-panel space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Input Form (Left 7 Cols) -->
        <div class="lg:col-span-7 rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-5">
          <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800 flex items-center justify-between">
            <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>✍️</span> Enter Your Attempted Questions
            </h2>
            <span id="active-exam-badge" class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
              UPSC CSE Prelims
            </span>
          </div>

          <form id="form-score" class="space-y-4" novalidate onsubmit="return false;">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Total Questions -->
              <div>
                <label for="inp-total-q" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                  Total Questions in Exam
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="inp-total-q"
                    min="1"
                    max="1000"
                    value="100"
                    class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute right-3.5 top-2.5 text-xs text-slate-400">Questions</span>
                </div>
              </div>

              <!-- Marks per Correct -->
              <div>
                <label for="inp-pos-marks" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                  Marks per Correct Answer (+)
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="inp-pos-marks"
                    min="0.1"
                    step="0.5"
                    value="2"
                    class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute right-3.5 top-2.5 text-xs text-slate-400">Marks</span>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Correct Answers -->
              <div>
                <label for="inp-correct-q" class="flex items-center justify-between text-xs font-bold text-emerald-700 dark:text-emerald-400 mb-1">
                  <span>Number of Correct Answers</span>
                  <span class="text-[11px] font-normal text-slate-500" id="label-correct-pct">(0%)</span>
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="inp-correct-q"
                    min="0"
                    value="65"
                    class="w-full rounded-xl border border-emerald-300 bg-emerald-50/20 px-3.5 py-2.5 text-sm font-bold text-emerald-900 focus:border-emerald-500 focus:outline-hidden focus:ring-2 focus:ring-emerald-500/20 dark:border-emerald-800/60 dark:bg-emerald-950/20 dark:text-emerald-200"
                  />
                  <span class="absolute right-3.5 top-2.5 text-xs font-bold text-emerald-600 dark:text-emerald-400">✓ Correct</span>
                </div>
              </div>

              <!-- Wrong Answers -->
              <div>
                <label for="inp-wrong-q" class="flex items-center justify-between text-xs font-bold text-rose-700 dark:text-rose-400 mb-1">
                  <span>Number of Wrong Answers</span>
                  <span class="text-[11px] font-normal text-slate-500" id="label-wrong-pct">(0%)</span>
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="inp-wrong-q"
                    min="0"
                    value="20"
                    class="w-full rounded-xl border border-rose-300 bg-rose-50/20 px-3.5 py-2.5 text-sm font-bold text-rose-900 focus:border-rose-500 focus:outline-hidden focus:ring-2 focus:ring-rose-500/20 dark:border-rose-800/60 dark:bg-rose-950/20 dark:text-rose-200"
                  />
                  <span class="absolute right-3.5 top-2.5 text-xs font-bold text-rose-600 dark:text-rose-400">✗ Wrong</span>
                </div>
              </div>
            </div>

            <!-- Negative Marking Scheme Selector -->
            <div>
              <label for="select-neg-fraction" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                Negative Marking Deduction per Incorrect Answer
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <select
                  id="select-neg-fraction"
                  class="rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                >
                  <option value="0.333333">1/3rd of Positive Mark (33.33%) [UPSC, GATE]</option>
                  <option value="0.25">1/4th of Positive Mark (25.0%) [SSC, Bank PO]</option>
                  <option value="0.5">1/2 of Positive Mark (50.0%)</option>
                  <option value="1.0">1.0 Mark Fixed [JEE, NEET]</option>
                  <option value="custom">Custom Negative Value</option>
                </select>

                <div class="relative" id="custom-neg-wrapper">
                  <input
                    type="number"
                    id="inp-neg-marks"
                    step="0.01"
                    min="0"
                    value="0.6667"
                    class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute right-3.5 top-2.5 text-xs text-rose-500 font-semibold" id="neg-marks-badge">-0.67 pts</span>
                </div>
              </div>
            </div>

            <!-- Optional Unattempted Question Penalty -->
            <div class="pt-1">
              <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-semibold text-slate-700 dark:text-slate-300">
                <input type="checkbox" id="chk-unattempted" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                <span>Include Penalty for Unattempted Questions (Advanced / Specialized Tests)</span>
              </label>
              <div id="unattempted-val-row" class="hidden mt-2">
                <label for="inp-unatt-penalty" class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">
                  Deduction per unattempted question
                </label>
                <input
                  type="number"
                  id="inp-unatt-penalty"
                  min="0"
                  step="0.1"
                  value="0"
                  class="w-48 rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
            </div>

            <!-- Error message container -->
            <div id="score-err" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs font-bold text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-300">
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 pt-2">
              <button
                type="button"
                id="btn-calc-score"
                class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-md shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
              >
                Calculate Net Score ⚡
              </button>
              <button
                type="button"
                id="btn-reset-score"
                class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
              >
                Reset
              </button>
            </div>

          </form>
        </div>

        <!-- Scorecard Results (Right 5 Cols) -->
        <div class="lg:col-span-5 space-y-4">
          
          <!-- Primary Score Card -->
          <div class="rounded-3xl border border-slate-200/90 bg-linear-to-br from-slate-900 via-slate-900 to-indigo-950 p-6 text-white shadow-xl dark:border-slate-800 relative overflow-hidden">
            <div class="absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-blue-500/10 blur-2xl"></div>

            <div class="flex items-center justify-between text-xs font-bold text-slate-400 mb-2">
              <span>FINAL EXAM RESULT</span>
              <span id="badge-accuracy-pill" class="rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-extrabold">
                76.47% Accuracy
              </span>
            </div>

            <div class="space-y-1 mb-5">
              <div class="text-4xl sm:text-5xl font-black tracking-tight text-white flex items-baseline gap-2">
                <span id="res-net-score">116.67</span>
                <span class="text-sm sm:text-base font-semibold text-slate-400" id="res-max-marks">/ 200</span>
              </div>
              <p class="text-xs text-slate-300 flex items-center gap-2">
                <span>Net Score Percentage:</span>
                <strong class="text-emerald-400 text-sm font-extrabold" id="res-net-percent">58.33%</strong>
              </p>
            </div>

            <!-- Visual Bar: Correct vs Wrong vs Unattempted -->
            <div class="space-y-1.5 mb-5">
              <div class="flex items-center justify-between text-[11px] text-slate-400">
                <span>Attempted Distribution</span>
                <span id="res-attempted-summary">85 / 100 Attempted</span>
              </div>
              <div class="w-full h-3.5 rounded-full bg-slate-800 flex overflow-hidden p-0.5 border border-slate-700">
                <div id="bar-correct" class="h-full bg-emerald-500 rounded-l-full transition-all duration-500" style="width: 65%;"></div>
                <div id="bar-wrong" class="h-full bg-rose-500 transition-all duration-500" style="width: 20%;"></div>
                <div id="bar-unattempted" class="h-full bg-slate-600 rounded-r-full transition-all duration-500" style="width: 15%;"></div>
              </div>
              <div class="flex items-center justify-between text-[10px] text-slate-400 pt-0.5">
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span> Correct: <strong class="text-white" id="bar-lbl-c">65</strong></span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-rose-500 inline-block"></span> Wrong: <strong class="text-white" id="bar-lbl-w">20</strong></span>
                <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-slate-500 inline-block"></span> Left: <strong class="text-white" id="bar-lbl-u">15</strong></span>
              </div>
            </div>

            <!-- Key Metrics Breakdown Grid -->
            <div class="grid grid-cols-2 gap-2.5 pt-3 border-t border-slate-800/80 text-xs">
              <div class="rounded-xl bg-slate-800/60 p-2.5">
                <span class="text-slate-400 block text-[11px]">Gross Marks (+)</span>
                <span class="text-emerald-400 font-bold text-base" id="res-gross-marks">+130.00</span>
              </div>
              <div class="rounded-xl bg-slate-800/60 p-2.5">
                <span class="text-slate-400 block text-[11px]">Negative Penalty (-)</span>
                <span class="text-rose-400 font-bold text-base" id="res-penalty-marks">-13.33</span>
              </div>
              <div class="rounded-xl bg-slate-800/60 p-2.5">
                <span class="text-slate-400 block text-[11px]">Accuracy Rate</span>
                <span class="text-white font-bold text-base" id="res-accuracy-rate">76.47%</span>
              </div>
              <div class="rounded-xl bg-slate-800/60 p-2.5">
                <span class="text-slate-400 block text-[11px]">Marks Lost to Penalty</span>
                <span class="text-amber-300 font-bold text-base" id="res-marks-lost">10.25%</span>
              </div>
            </div>

          </div>

          <!-- Quick Copy / Share Card -->
          <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900 flex items-center justify-between gap-3">
            <div class="text-xs text-slate-600 dark:text-slate-300">
              <span class="font-bold text-slate-900 dark:text-white block">Copy Scorecard Summary</span>
              Copy your net score and accuracy breakdown
            </div>
            <button
              type="button"
              id="btn-copy-scorecard"
              class="rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-100 px-3.5 py-2 text-xs font-bold transition cursor-pointer"
            >
              📋 Copy Summary
            </button>
          </div>

        </div>

      </div>
    </div>

    <!-- TAB 2: TARGET SCORE & ATTEMPT PLANNER -->
    <div id="panel-tab-target" class="calc-panel hidden space-y-6">
      <div class="rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-7 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-6">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🎯</span> Cut-off Target &amp; Safe Attempt Planner
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Determine exactly how many questions you must attempt at your realistic accuracy level to secure your target cut-off score.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label for="inp-plan-target" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Target Cut-off Score
            </label>
            <input
              type="number"
              id="inp-plan-target"
              value="110"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
          </div>

          <div>
            <label for="inp-plan-accuracy" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Expected Accuracy Rate (%)
            </label>
            <input
              type="number"
              id="inp-plan-accuracy"
              min="10"
              max="100"
              value="75"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
          </div>

          <div>
            <label for="inp-plan-pos" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Marks per Correct (+)
            </label>
            <input
              type="number"
              id="inp-plan-pos"
              value="2"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
          </div>

          <div>
            <label for="inp-plan-neg" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
              Penalty per Wrong (-)
            </label>
            <input
              type="number"
              id="inp-plan-neg"
              value="0.6667"
              step="0.01"
              class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
          </div>
        </div>

        <button
          type="button"
          id="btn-run-planner"
          class="rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-2.5 text-xs font-bold text-white shadow-xs transition cursor-pointer"
        >
          Compute Required Attempts 🎯
        </button>

        <!-- Planner Result Card -->
        <div id="planner-result-card" class="rounded-2xl border border-blue-200 bg-blue-50/50 p-5 dark:border-blue-900/60 dark:bg-blue-950/20 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <span class="text-xs font-bold text-blue-800 dark:text-blue-300 uppercase tracking-wider block">Recommended Strategy</span>
              <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
                Attempt at least <span id="plan-res-attempts" class="text-blue-600 dark:text-blue-400">83</span> questions
              </h3>
            </div>
            <span class="rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900/80 dark:text-blue-200 px-3 py-1 text-xs font-extrabold">
              Target: <span id="plan-badge-target">110 Marks</span>
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div class="rounded-xl bg-white p-3 shadow-2xs dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
              <span class="text-slate-500 dark:text-slate-400 block mb-1">Expected Correct (75%)</span>
              <strong class="text-emerald-600 dark:text-emerald-400 text-lg" id="plan-res-correct">62 Qs (+124 pts)</strong>
            </div>
            <div class="rounded-xl bg-white p-3 shadow-2xs dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
              <span class="text-slate-500 dark:text-slate-400 block mb-1">Permissible Wrong Cushion</span>
              <strong class="text-rose-600 dark:text-rose-400 text-lg" id="plan-res-wrong">21 Qs (-14 pts)</strong>
            </div>
            <div class="rounded-xl bg-white p-3 shadow-2xs dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
              <span class="text-slate-500 dark:text-slate-400 block mb-1">Projected Net Score</span>
              <strong class="text-blue-600 dark:text-blue-400 text-lg" id="plan-res-net">110.00 pts</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: GUESSING RISK & EXPECTED VALUE (EV) -->
    <div id="panel-tab-guessing" class="calc-panel hidden space-y-6">
      <div class="rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-7 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-6">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🎲</span> Should You Guess? Expected Value (EV) Analyzer
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Use mathematical probability to decide whether guessing after option elimination gives a net statistical advantage or risks penalty.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div>
            <label for="inp-ev-pos" class="block font-bold text-slate-700 dark:text-slate-300 mb-1">
              Marks for Correct Answer (+)
            </label>
            <input
              type="number"
              id="inp-ev-pos"
              value="2"
              class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
