---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Random Number Generator – Generate Random Numbers Instantly"
  description="Free random number generator (RNG). Generate single or multiple random numbers, unique numbers with no repeats, spin an interactive random wheel, or pick from custom lists."
  category="Math"
  calculatorName="Random Number Generator"
  slug="random-number-generator-calculator"
  keywords={[
    'random number generator',
    'random number generator wheel',
    'google random number generator',
    'random number generator no repeats',
    'random number picker',
    'wheel spinner random number',
    'online rng'
  ]}
>
  <div class="space-y-6">

    <!-- TOP CALCULATOR MODE TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-rng-tab active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="tab-single">Random Number</button>
        <button type="button" class="btn-rng-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-multiple">Multiple Numbers</button>
        <button type="button" class="btn-rng-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-no-repeats">No Repeats</button>
        <button type="button" class="btn-rng-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-wheel">Random Wheel 🎡</button>
        <button type="button" class="btn-rng-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-custom-list">Custom List Picker</button>
      </div>
    </div>

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-single" data-min="1" data-max="6">🎲 Dice Roll (1–6)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-custom-list" data-list="Heads, Tails">🪙 Coin Flip (Heads / Tails)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-single" data-min="1" data-max="100">🎯 Number 1–100</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-no-repeats" data-min="1" data-max="50" data-cnt="5">✨ 5 Unique (1–50)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-wheel" data-wmin="1" data-wmax="10">🎡 Wheel (1–10)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-custom-list" data-list="Team A, Team B, Team C, Team D">👥 Team Picker</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR PANELS CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- 1. SINGLE RANDOM NUMBER (GOOGLE RNG SIMPLICITY) -->
      <div id="panel-tab-single" class="rng-panel space-y-4">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🎲</span> Quick Random Number Generator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Set a minimum and maximum value, then generate a random number instantly.
          </p>
        </div>

        <form id="form-rng-single" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="single-min" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Minimum</label>
              <input type="number" id="single-min" value="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="single-max" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Maximum</label>
              <input type="number" id="single-max" value="100" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="single-type" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Number Type</label>
              <select id="single-type" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="integer" selected>Whole Numbers (Integers)</option>
                <option value="decimal_1">Decimal (1 Place, e.g. 4.5)</option>
                <option value="decimal_2">Decimal (2 Places, e.g. 4.56)</option>
                <option value="decimal_3">Decimal (3 Places, e.g. 4.567)</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-single-gen" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Generate Random Number →
            </button>
            <button type="button" id="btn-single-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-single" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

          <!-- Result Hero Card -->
          <div id="res-single-card" class="hidden text-center rounded-3xl border border-blue-200 bg-linear-to-b from-blue-50/60 to-white p-6 dark:border-blue-900/60 dark:from-slate-900 dark:to-slate-950 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">Random Result</span>
            <div id="res-single-val" class="my-3 text-5xl sm:text-6xl font-black tracking-tight text-blue-600 dark:text-blue-400">--</div>
            <div class="flex items-center justify-center gap-2 pt-2">
              <button type="button" id="btn-single-again" class="rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white hover:bg-blue-700 transition cursor-pointer">
                ↻ Generate Again
              </button>
              <button type="button" id="btn-single-copy" class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
                📋 Copy Result
              </button>
            </div>
            <span id="toast-single" class="hidden mt-2 inline-block text-[11px] font-bold text-emerald-600 dark:text-emerald-400">Copied!</span>
          </div>
        </form>
      </div>

      <!-- 2. MULTIPLE NUMBERS -->
      <div id="panel-tab-multiple" class="rng-panel hidden space-y-4">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🔢</span> Generate Multiple Random Numbers
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Generate a set of random numbers with customizable quantity and duplication options.
          </p>
        </div>

        <form id="form-rng-multi" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <div>
              <label for="multi-min" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Minimum</label>
              <input type="number" id="multi-min" value="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="multi-max" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Maximum</label>
              <input type="number" id="multi-max" value="50" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="multi-count" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">How Many Numbers?</label>
              <input type="number" id="multi-count" value="5" min="1" max="500" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="multi-repeats" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Allow Duplicates?</label>
              <select id="multi-repeats" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="yes" selected>Yes (Allow Repeats)</option>
                <option value="no">No (Unique Numbers Only)</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-multi-gen" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Generate Numbers →
            </button>
            <button type="button" id="btn-multi-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-multi" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

          <div id="res-multi-card" class="hidden rounded-3xl border border-blue-200 bg-white p-5 dark:border-blue-900/60 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Generated Number List</span>
              <div class="flex items-center gap-2">
                <button type="button" id="btn-multi-again" class="rounded-lg bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 hover:bg-blue-100 dark:bg-blue-950 dark:text-blue-300 cursor-pointer">↻ Again</button>
                <button type="button" id="btn-multi-copy" class="rounded-lg border border-slate-300 bg-white px-3 py-1 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">📋 Copy All</button>
              </div>
            </div>
            <div id="res-multi-grid" class="mt-4 flex flex-wrap gap-2.5">
              <!-- Rendered chips -->
            </div>
          </div>
        </form>
      </div>

      <!-- 3. NO REPEATS MODE -->
      <div id="panel-tab-no-repeats" class="rng-panel hidden space-y-4">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>✨</span> Random Number Generator No Repeats
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Generate completely unique random numbers without any duplicate values.
          </p>
        </div>

        <form id="form-rng-norepeat" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="nr-min" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Minimum Number</label>
              <input type="number" id="nr-min" value="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="nr-max" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Maximum Number</label>
              <input type="number" id="nr-max" value="20" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="nr-count" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Quantity of Unique Numbers</label>
              <input type="number" id="nr-count" value="5" min="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-nr-gen" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Generate Unique Numbers →
            </button>
            <button type="button" id="btn-nr-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-nr" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

          <div id="res-nr-card" class="hidden rounded-3xl border border-blue-200 bg-white p-5 dark:border-blue-900/60 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Unique Random Numbers</span>
              <div class="flex items-center gap-2">
                <button type="button" id="btn-nr-again" class="rounded-lg bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 hover:bg-blue-100 dark:bg-blue-950 dark:text-blue-300 cursor-pointer">↻ Again</button>
                <button type="button" id="btn-nr-copy" class="rounded-lg border border-slate-300 bg-white px-3 py-1 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">📋 Copy All</button>
              </div>
            </div>
            <div id="res-nr-grid" class="mt-4 flex flex-wrap gap-2.5">
              <!-- Rendered chips -->
            </div>
          </div>
        </form>
      </div>

      <!-- 4. RANDOM NUMBER WHEEL -->
      <div id="panel-tab-wheel" class="rng-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🎡</span> Random Number Generator Wheel
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Spin an interactive wheel to randomly select a number or custom item with optional no-repeat elimination.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 items-center">
          
          <!-- Wheel Canvas Display -->
          <div class="lg:col-span-6 flex flex-col items-center justify-center">
            <div class="relative flex items-center justify-center">
              <!-- Center Pointer -->
              <div class="absolute -top-3 z-20 text-2xl text-red-600 filter drop-shadow-md">▼</div>
              <canvas id="wheel-canvas" width="320" height="320" class="rounded-full shadow-xl shadow-slate-900/10 border-4 border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800"></canvas>
            </div>

            <!-- Spin Result Callout -->
            <div id="wheel-result-box" class="mt-4 text-center">
              <span class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Selected Value</span>
              <div id="wheel-selected-val" class="text-3xl font-black text-blue-600 dark:text-blue-400">Ready to Spin!</div>
            </div>
          </div>

          <!-- Wheel Controls & Settings -->
          <div class="lg:col-span-6 space-y-4">
            
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-3">
              <div>
                <label for="wheel-mode" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Wheel Items Source</label>
                <select id="wheel-mode" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="range" selected>Number Range (e.g. 1 to 10)</option>
                  <option value="custom">Custom List (Names, Teams, Prizes)</option>
                </select>
              </div>

              <!-- Range inputs -->
              <div id="wheel-range-inputs" class="grid grid-cols-2 gap-2">
                <div>
                  <label for="wheel-min" class="text-[11px] font-bold text-slate-500">Min Number</label>
                  <input type="number" id="wheel-min" value="1" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                  <label for="wheel-max" class="text-[11px] font-bold text-slate-500">Max Number</label>
                  <input type="number" id="wheel-max" value="10" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
              </div>

              <!-- Custom list input -->
              <div id="wheel-custom-inputs" class="hidden">
                <label for="wheel-custom-text" class="text-[11px] font-bold text-slate-500">Items (comma or line separated)</label>
                <textarea id="wheel-custom-text" rows="3" class="mt-1 w-full rounded-xl border border-slate-300 p-2 text-xs dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Option 1, Option 2, Option 3">Apple, Banana, Orange, Mango, Grape, Berry</textarea>
              </div>

              <!-- Remove selected toggle -->
              <div class="flex items-center justify-between pt-1 text-xs">
                <label class="flex items-center gap-2 font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
                  <input type="checkbox" id="chk-wheel-remove" class="h-4 w-4 rounded border-slate-300 accent-blue-600" />
                  <span>Remove Selected Value After Spin (No Repeats)</span>
                </label>
                <span id="wheel-remaining-badge" class="font-bold text-blue-600 dark:text-blue-400">10 Items</span>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button type="button" id="btn-wheel-spin" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
                🎡 Spin the Wheel!
              </button>
              <button type="button" id="btn-wheel-reset" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
                Reset Wheel
              </button>
            </div>

          </div>

        </div>
      </div>

      <!-- 5. CUSTOM LIST RANDOM PICKER -->
      <div id="panel-tab-custom-list" class="rng-panel hidden space-y-4">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>📋</span> Custom List Random Picker
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Paste names, items, or teams separated by commas or lines to make an unbiased random selection.
          </p>
        </div>

        <form id="form-rng-list" class="space-y-4" novalidate onsubmit="return false;">
          <div>
            <label for="list-items-text" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Enter Items (One per line or comma separated)</label>
