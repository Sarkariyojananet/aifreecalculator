<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // Cryptographically secure integer generator helper
  function getSecureInt(min, max) {
    const low = Math.min(min, max);
    const high = Math.max(min, max);
    const range = high - low + 1;
    if (range <= 0) return low;

    if (window.crypto && window.crypto.getRandomValues) {
      const maxUint32 = 0xffffffff;
      const limit = maxUint32 - (maxUint32 % range);
      const buffer = new Uint32Array(1);
      do {
        window.crypto.getRandomValues(buffer);
      } while (buffer[0] >= limit);
      return low + (buffer[0] % range);
    }
    return Math.floor(Math.random() * range) + low;
  }

  function getSecureDecimal(min, max, places) {
    const low = Math.min(min, max);
    const high = Math.max(min, max);
    const factor = Math.pow(10, places);
    const intVal = getSecureInt(0, Math.round((high - low) * factor));
    return (low + intVal / factor).toFixed(places);
  }

  // History state
  let recentHistory = [];
  const containerHistory = document.getElementById('container-history');
  const historyPills = document.getElementById('history-pills');
  const btnClearHistory = document.getElementById('btn-clear-history');

  function addHistory(val) {
    recentHistory.unshift(String(val));
    if (recentHistory.length > 10) recentHistory.pop();
    renderHistory();
  }

  function renderHistory() {
    if (recentHistory.length === 0) {
      containerHistory.classList.add('hidden');
      return;
    }
    containerHistory.classList.remove('hidden');
    historyPills.innerHTML = recentHistory
      .map(
        (v) => `
      <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
        ${v}
      </span>
    `
      )
      .join('');
  }

  btnClearHistory.addEventListener('click', () => {
    recentHistory = [];
    renderHistory();
  });

  // Tab Navigation
  const tabButtons = document.querySelectorAll('.btn-rng-tab');
  const rngPanels = document.querySelectorAll('.rng-panel');

  function switchTab(tabId) {
    tabButtons.forEach((btn) => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.className = 'btn-rng-tab active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-rng-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    rngPanels.forEach((panel) => {
      if (panel.id === `panel-${tabId}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    if (tabId === 'tab-wheel') {
      drawWheel();
    }
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      switchTab(btn.getAttribute('data-tab'));
    });
  });

  // ==========================================
  // 1. SINGLE RANDOM NUMBER
  // ==========================================
  const singleMin = document.getElementById('single-min');
  const singleMax = document.getElementById('single-max');
  const singleType = document.getElementById('single-type');
  const btnSingleGen = document.getElementById('btn-single-gen');
  const btnSingleClear = document.getElementById('btn-single-clear');
  const errSingle = document.getElementById('err-single');
  const resSingleCard = document.getElementById('res-single-card');
  const resSingleVal = document.getElementById('res-single-val');
  const btnSingleAgain = document.getElementById('btn-single-again');
  const btnSingleCopy = document.getElementById('btn-single-copy');
  const toastSingle = document.getElementById('toast-single');

  function generateSingle() {
    errSingle.classList.add('hidden');
    const min = parseFloat(singleMin.value);
    const max = parseFloat(singleMax.value);

    if (isNaN(min) || isNaN(max)) {
      errSingle.textContent = 'Please enter valid minimum and maximum numbers.';
      errSingle.classList.remove('hidden');
      return;
    }
    if (min > max) {
      errSingle.textContent = 'Maximum number must be greater than or equal to the minimum number.';
      errSingle.classList.remove('hidden');
      return;
    }

    let resultVal;
    if (singleType.value === 'integer') {
      resultVal = getSecureInt(min, max);
    } else {
      const places = parseInt(singleType.value.replace('decimal_', '')) || 2;
      resultVal = getSecureDecimal(min, max, places);
    }

    resSingleVal.textContent = resultVal;
    resSingleCard.classList.remove('hidden');
    addHistory(resultVal);
  }

  btnSingleGen.addEventListener('click', generateSingle);
  btnSingleAgain.addEventListener('click', generateSingle);

  btnSingleCopy.addEventListener('click', () => {
    navigator.clipboard.writeText(resSingleVal.textContent);
    toastSingle.classList.remove('hidden');
    setTimeout(() => toastSingle.classList.add('hidden'), 2000);
  });

  btnSingleClear.addEventListener('click', () => {
    singleMin.value = '1';
    singleMax.value = '100';
    singleType.value = 'integer';
    errSingle.classList.add('hidden');
    resSingleCard.classList.add('hidden');
  });

  // ==========================================
  // 2. MULTIPLE RANDOM NUMBERS
  // ==========================================
  const multiMin = document.getElementById('multi-min');
  const multiMax = document.getElementById('multi-max');
  const multiCount = document.getElementById('multi-count');
  const multiRepeats = document.getElementById('multi-repeats');
  const btnMultiGen = document.getElementById('btn-multi-gen');
  const btnMultiClear = document.getElementById('btn-multi-clear');
  const errMulti = document.getElementById('err-multi');
  const resMultiCard = document.getElementById('res-multi-card');
  const resMultiGrid = document.getElementById('res-multi-grid');
  const btnMultiAgain = document.getElementById('btn-multi-again');
  const btnMultiCopy = document.getElementById('btn-multi-copy');

  let currentMultiResults = [];

  function generateMulti() {
    errMulti.classList.add('hidden');
    const min = parseInt(multiMin.value);
    const max = parseInt(multiMax.value);
    const count = parseInt(multiCount.value);
    const allowDup = multiRepeats.value === 'yes';

    if (isNaN(min) || isNaN(max) || isNaN(count) || count <= 0) {
      errMulti.textContent = 'Please enter valid minimum, maximum, and count values.';
      errMulti.classList.remove('hidden');
      return;
    }
    if (min > max) {
      errMulti.textContent = 'Maximum number must be greater than or equal to minimum.';
      errMulti.classList.remove('hidden');
      return;
    }

    const range = max - min + 1;
    if (!allowDup && count > range) {
      errMulti.textContent = `You cannot generate ${count} unique whole numbers from a range containing only ${range} numbers.`;
      errMulti.classList.remove('hidden');
      return;
    }

    const results = [];
    const seen = new Set();
    let attempts = 0;

    while (results.length < count && attempts < 200000) {
      attempts++;
      const val = getSecureInt(min, max);
      if (allowDup || !seen.has(val)) {
        seen.add(val);
        results.push(val);
      }
    }

    currentMultiResults = results;
    resMultiGrid.innerHTML = results
      .map(
        (n) => `
      <div class="flex h-11 min-w-11 px-3 items-center justify-center rounded-xl bg-blue-600 text-sm font-black text-white shadow-xs">
        ${n}
      </div>
    `
      )
      .join('');

    resMultiCard.classList.remove('hidden');
    addHistory(`[${results.slice(0, 3).join(', ')}${results.length > 3 ? '...' : ''}]`);
  }

  btnMultiGen.addEventListener('click', generateMulti);
  btnMultiAgain.addEventListener('click', generateMulti);

  btnMultiCopy.addEventListener('click', () => {
    navigator.clipboard.writeText(currentMultiResults.join(', '));
    btnMultiCopy.textContent = '✓ Copied!';
    setTimeout(() => (btnMultiCopy.textContent = '📋 Copy All'), 2000);
  });

  btnMultiClear.addEventListener('click', () => {
    multiMin.value = '1';
    multiMax.value = '50';
    multiCount.value = '5';
    multiRepeats.value = 'yes';
    errMulti.classList.add('hidden');
    resMultiCard.classList.add('hidden');
  });

  // ==========================================
  // 3. NO REPEATS MODE
  // ==========================================
  const nrMin = document.getElementById('nr-min');
  const nrMax = document.getElementById('nr-max');
  const nrCount = document.getElementById('nr-count');
  const btnNrGen = document.getElementById('btn-nr-gen');
  const btnNrClear = document.getElementById('btn-nr-clear');
  const errNr = document.getElementById('err-nr');
  const resNrCard = document.getElementById('res-nr-card');
  const resNrGrid = document.getElementById('res-nr-grid');
  const btnNrAgain = document.getElementById('btn-nr-again');
  const btnNrCopy = document.getElementById('btn-nr-copy');

  let currentNrResults = [];

  function generateNoRepeats() {
    errNr.classList.add('hidden');
    const min = parseInt(nrMin.value);
    const max = parseInt(nrMax.value);
    const count = parseInt(nrCount.value);

    if (isNaN(min) || isNaN(max) || isNaN(count) || count <= 0) {
      errNr.textContent = 'Please enter valid numeric values.';
      errNr.classList.remove('hidden');
      return;
    }
    if (min > max) {
      errNr.textContent = 'Maximum number must be greater than or equal to minimum.';
      errNr.classList.remove('hidden');
      return;
    }

    const range = max - min + 1;
    if (count > range) {
      errNr.textContent = `Requested quantity (${count}) is greater than the number of unique values available in range (${range}).`;
      errNr.classList.remove('hidden');
      return;
    }

    const results = [];
    const seen = new Set();
    let attempts = 0;

    while (results.length < count && attempts < 200000) {
      attempts++;
      const val = getSecureInt(min, max);
      if (!seen.has(val)) {
        seen.add(val);
        results.push(val);
      }
    }

    currentNrResults = results;
    resNrGrid.innerHTML = results
      .map(
        (n) => `
      <div class="flex h-11 min-w-11 px-3 items-center justify-center rounded-xl bg-emerald-600 text-sm font-black text-white shadow-xs">
        ${n}
      </div>
    `
      )
      .join('');

    resNrCard.classList.remove('hidden');
    addHistory(`Unique: ${results.slice(0, 3).join(', ')}`);
  }

  btnNrGen.addEventListener('click', generateNoRepeats);
  btnNrAgain.addEventListener('click', generateNoRepeats);

  btnNrCopy.addEventListener('click', () => {
    navigator.clipboard.writeText(currentNrResults.join(', '));
    btnNrCopy.textContent = '✓ Copied!';
    setTimeout(() => (btnNrCopy.textContent = '📋 Copy All'), 2000);
  });

  btnNrClear.addEventListener('click', () => {
    nrMin.value = '1';
    nrMax.value = '20';
    nrCount.value = '5';
    errNr.classList.add('hidden');
    resNrCard.classList.add('hidden');
  });

  // ==========================================
  // 4. RANDOM NUMBER WHEEL
  // ==========================================
  const wheelCanvas = document.getElementById('wheel-canvas');
  const ctx = wheelCanvas.getContext('2d');
  const wheelMode = document.getElementById('wheel-mode');
  const wheelRangeInputs = document.getElementById('wheel-range-inputs');
  const wheelCustomInputs = document.getElementById('wheel-custom-inputs');
  const wheelMin = document.getElementById('wheel-min');
  const wheelMax = document.getElementById('wheel-max');
  const wheelCustomText = document.getElementById('wheel-custom-text');
  const chkWheelRemove = document.getElementById('chk-wheel-remove');
  const wheelRemainingBadge = document.getElementById('wheel-remaining-badge');
  const btnWheelSpin = document.getElementById('btn-wheel-spin');
  const btnWheelReset = document.getElementById('btn-wheel-reset');
  const wheelSelectedVal = document.getElementById('wheel-selected-val');

  let wheelItems = [];
  let currentWheelAngle = 0;
  let isSpinning = false;

  const wheelColors = [
    '#2563eb', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899',
    '#06b6d4', '#f97316', '#3b82f6', '#14b8a6', '#6366f1'
  ];

  function getWheelConfigItems() {
    if (wheelMode.value === 'range') {
      const min = parseInt(wheelMin.value) || 1;
      const max = parseInt(wheelMax.value) || 10;
      const items = [];
      // cap visible segments to 24 for clean UI
      const count = Math.min(24, Math.max(2, max - min + 1));
      for (let i = min; i <= Math.min(max, min + count - 1); i++) {
        items.push(String(i));
      }
      return items;
    } else {
      return wheelCustomText.value
        .split(/[\n,]+/)
        .map((s) => s.trim())
        .filter((s) => s.length > 0);
    }
  }

  function resetWheel() {
    wheelItems = getWheelConfigItems();
    wheelRemainingBadge.textContent = `${wheelItems.length} Items`;
    wheelSelectedVal.textContent = wheelItems.length > 0 ? 'Ready to Spin!' : 'No items';
    drawWheel();
  }

  wheelMode.addEventListener('change', () => {
    if (wheelMode.value === 'range') {
      wheelRangeInputs.classList.remove('hidden');
      wheelCustomInputs.classList.add('hidden');
    } else {
      wheelRangeInputs.classList.add('hidden');
      wheelCustomInputs.classList.remove('hidden');
    }
    resetWheel();
  });

  [wheelMin, wheelMax, wheelCustomText].forEach((el) => el.addEventListener('change', resetWheel));

  function drawWheel() {
    const num = wheelItems.length;
    const centerX = wheelCanvas.width / 2;
    const centerY = wheelCanvas.height / 2;
    const radius = centerX - 10;

    ctx.clearRect(0, 0, wheelCanvas.width, wheelCanvas.height);

    if (num === 0) {
      ctx.fillStyle = '#64748b';
      ctx.font = 'bold 14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('No Items Available', centerX, centerY);
      return;
    }

    const arc = (2 * Math.PI) / num;

    for (let i = 0; i < num; i++) {
      const angle = currentWheelAngle + i * arc;
      ctx.beginPath();
      ctx.fillStyle = wheelColors[i % wheelColors.length];
      ctx.moveTo(centerX, centerY);
      ctx.arc(centerX, centerY, radius, angle, angle + arc);
      ctx.lineTo(centerX, centerY);
      ctx.fill();
      ctx.stroke();

      // Text label
      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.rotate(angle + arc / 2);
      ctx.textAlign = 'right';
      ctx.fillStyle = '#ffffff';
      ctx.font = num > 12 ? 'bold 10px sans-serif' : 'bold 12px sans-serif';
      ctx.fillText(wheelItems[i], radius - 15, 4);
      ctx.restore();
    }

    // Center Hub
    ctx.beginPath();
    ctx.arc(centerX, centerY, 20, 0, 2 * Math.PI);
    ctx.fillStyle = '#ffffff';
    ctx.fill();
    ctx.strokeStyle = '#0f172a';
    ctx.lineWidth = 2;
    ctx.stroke();
  }

  function spinWheel() {
    if (isSpinning || wheelItems.length === 0) return;

    isSpinning = true;
    wheelSelectedVal.textContent = 'Spinning...';

    // Pick random winning index
    const winningIdx = getSecureInt(0, wheelItems.length - 1);
    const num = wheelItems.length;
    const arc = (2 * Math.PI) / num;

    // Pointer is at the top (-PI / 2)
    // To land winningIdx at -PI/2: (currentWheelAngle + winningIdx * arc + arc/2) % 2PI = -PI/2
    const targetAngleOnCircle = 3 * Math.PI / 2 - (winningIdx * arc + arc / 2);
    const extraRounds = 5 + getSecureInt(2, 5); // 5 to 10 full spins
    const targetTotalAngle = currentWheelAngle + (2 * Math.PI * extraRounds) + (targetAngleOnCircle - (currentWheelAngle % (2 * Math.PI)));

    const startTime = performance.now();
    const duration = 3000; // 3 seconds

    function animate(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(1, elapsed / duration);
      // Ease out cubic
      const ease = 1 - Math.pow(1 - progress, 3);
      currentWheelAngle = currentWheelAngle + (targetTotalAngle - currentWheelAngle) * ease;
      drawWheel();

      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        isSpinning = false;
        currentWheelAngle = targetTotalAngle % (2 * Math.PI);
        drawWheel();

        const pickedValue = wheelItems[winningIdx];
        wheelSelectedVal.textContent = `🎯 ${pickedValue}`;
        addHistory(`Wheel: ${pickedValue}`);

        // If remove selected is ON
        if (chkWheelRemove.checked) {
          wheelItems.splice(winningIdx, 1);
          wheelRemainingBadge.textContent = `${wheelItems.length} Items`;
          if (wheelItems.length === 0) {
            wheelSelectedVal.textContent = 'All items selected!';
          }
          drawWheel();
        }
      }
    }

    requestAnimationFrame(animate);
  }

  btnWheelSpin.addEventListener('click', spinWheel);
  btnWheelReset.addEventListener('click', resetWheel);

  // ==========================================
  // 5. CUSTOM LIST PICKER
  // ==========================================
  const listItemsText = document.getElementById('list-items-text');
  const listPickCount = document.getElementById('list-pick-count');
  const listAllowRepeats = document.getElementById('list-allow-repeats');
  const btnListPick = document.getElementById('btn-list-pick');
  const btnListClear = document.getElementById('btn-list-clear');
  const errList = document.getElementById('err-list');
  const resListCard = document.getElementById('res-list-card');
  const resListGrid = document.getElementById('res-list-grid');
  const btnListAgain = document.getElementById('btn-list-again');
  const btnListCopy = document.getElementById('btn-list-copy');

  let currentListResults = [];

  function pickFromList() {
    errList.classList.add('hidden');
    const items = listItemsText.value
      .split(/[\n,]+/)
      .map((s) => s.trim())
      .filter((s) => s.length > 0);

    const count = parseInt(listPickCount.value) || 1;
    const allowDup = listAllowRepeats.value === 'yes';

    if (items.length === 0) {
      errList.textContent = 'Please enter at least one item in the list.';
      errList.classList.remove('hidden');
      return;
    }

    if (!allowDup && count > items.length) {
      errList.textContent = `Requested count (${count}) exceeds available unique items (${items.length}).`;
      errList.classList.remove('hidden');
      return;
    }

    let results = [];
    if (!allowDup) {
      const shuffled = [...items];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = getSecureInt(0, i);
        const temp = shuffled[i];
        shuffled[i] = shuffled[j];
        shuffled[j] = temp;
      }
      results = shuffled.slice(0, count);
    } else {
      for (let i = 0; i < count; i++) {
        const idx = getSecureInt(0, items.length - 1);
        results.push(items[idx]);
      }
    }

    currentListResults = results;
    resListGrid.innerHTML = results
      .map(
        (it) => `
      <div class="flex px-3.5 py-2 items-center justify-center rounded-xl bg-blue-600 text-xs font-bold text-white shadow-xs">
        ${it}
      </div>
    `
      )
      .join('');

    resListCard.classList.remove('hidden');
    addHistory(`List: ${results.slice(0, 2).join(', ')}`);
  }

  btnListPick.addEventListener('click', pickFromList);
  btnListAgain.addEventListener('click', pickFromList);

  btnListCopy.addEventListener('click', () => {
    navigator.clipboard.writeText(currentListResults.join(', '));
    btnListCopy.textContent = '✓ Copied!';
    setTimeout(() => (btnListCopy.textContent = '📋 Copy All'), 2000);
  });

  btnListClear.addEventListener('click', () => {
    listItemsText.value = '';
    listPickCount.value = '1';
    errList.classList.add('hidden');
    resListCard.classList.add('hidden');
  });

  // ==========================================
  // PRESET CLICKS
  // ==========================================
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      switchTab(target);

      if (target === 'tab-single') {
        singleMin.value = btn.getAttribute('data-min');
        singleMax.value = btn.getAttribute('data-max');
        singleType.value = 'integer';
      } else if (target === 'tab-no-repeats') {
        nrMin.value = btn.getAttribute('data-min');
        nrMax.value = btn.getAttribute('data-max');
        nrCount.value = btn.getAttribute('data-cnt');
      } else if (target === 'tab-wheel') {
        wheelMode.value = 'range';
        wheelRangeInputs.classList.remove('hidden');
        wheelCustomInputs.classList.add('hidden');
        wheelMin.value = btn.getAttribute('data-wmin');
        wheelMax.value = btn.getAttribute('data-wmax');
        resetWheel();
      } else if (target === 'tab-custom-list') {
        listItemsText.value = btn.getAttribute('data-list');
        listPickCount.value = '1';
      }
    });
  });

  // Enter Key Handler
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, textarea').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && inp.tagName !== 'TEXTAREA') {
          e.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.click();
        }
      });
    });
  });

  // Initial wheel setup
  resetWheel();
</script>
