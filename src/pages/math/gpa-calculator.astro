---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="GPA Calculator – College, High School & Cumulative GPA"
  description="Calculate your GPA, cumulative GPA, weighted GPA, unweighted GPA, and percentage-to-GPA conversions with customizable grading scales."
  category="Math"
  calculatorName="GPA Calculator"
  slug="gpa-calculator"
  keywords={[
    'gpa calculator',
    'college gpa calculator',
    'gpa calculator college',
    'high school gpa calculator',
    'gpa calculator high school',
    'cumulative gpa calculator',
    'weighted gpa calculator',
    'unweighted gpa calculator',
    'vit gpa calculator',
    'mit gpa calculator',
    'percentage to gpa calculator',
    'gpa calculator vit'
  ]}
>
  <div class="space-y-6">

    <!-- CALCULATOR MODE SELECTOR TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-gpa-tab active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="tab-college">College GPA</button>
        <button type="button" class="btn-gpa-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-highschool">High School (Weighted)</button>
        <button type="button" class="btn-gpa-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-cumulative">Cumulative GPA</button>
        <button type="button" class="btn-gpa-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-percentage">Percentage to GPA</button>
        <button type="button" class="btn-gpa-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-goal">GPA Goal Planner</button>
      </div>
    </div>

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-college" data-p="college-std">🎓 Standard College (4 Courses)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-highschool" data-p="hs-weighted">🏫 Weighted HS (Honors & AP)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-cumulative" data-cgpa="3.45" data-ccr="60" data-ngpa="3.80" data-ncr="15">📊 Cumulative (3.45 + 3.80)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-percentage" data-pct="85" data-scale="4.0">🔢 85% on 4.0 Scale</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-goal" data-cgpa="3.20" data-ccr="60" data-tgpa="3.40" data-ucr="30">🎯 Goal (3.20 ➔ 3.40)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR PANELS CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- 1. COLLEGE GPA CALCULATOR -->
      <div id="panel-tab-college" class="gpa-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🎓</span> College GPA Calculator (Standard 4.0 Scale)
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Enter your semester courses, credit hours, and letter grades, then click <strong>Calculate GPA</strong>.
          </p>
        </div>

        <form id="form-college-gpa" class="space-y-4" novalidate onsubmit="return false;">
          
          <div class="space-y-2.5" id="college-courses-list">
            <!-- Rendered by JS -->
          </div>

          <div class="flex items-center gap-3 pt-1">
            <button type="button" id="btn-add-college-course" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
              <span>＋ Add Course</span>
            </button>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-college-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate GPA →
            </button>
            <button type="button" id="btn-college-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear All (✕)
            </button>
          </div>

          <p id="err-college" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>
      </div>

      <!-- 2. HIGH SCHOOL / WEIGHTED GPA CALCULATOR -->
      <div id="panel-tab-highschool" class="gpa-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🏫</span> High School & Weighted GPA Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Calculate both weighted and unweighted GPA with difficulty bonus points for Honors (+0.5) and AP / Advanced (+1.0) courses.
          </p>
        </div>

        <form id="form-hs-gpa" class="space-y-4" novalidate onsubmit="return false;">
          
          <div class="space-y-2.5" id="hs-courses-list">
            <!-- Rendered by JS -->
          </div>

          <div class="flex items-center gap-3 pt-1">
            <button type="button" id="btn-add-hs-course" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
              <span>＋ Add High School Course</span>
            </button>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-hs-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate Weighted GPA →
            </button>
            <button type="button" id="btn-hs-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear All (✕)
            </button>
          </div>

          <p id="err-hs" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>
      </div>

      <!-- 3. CUMULATIVE GPA CALCULATOR -->
      <div id="panel-tab-cumulative" class="gpa-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>📊</span> Cumulative GPA Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Combine your previous cumulative GPA and completed credits with your new semester GPA to calculate your updated standing.
          </p>
        </div>

        <form id="form-cumulative-gpa" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 space-y-3">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-400">Previous Academic History</span>
              <div>
                <label for="cum-prev-gpa" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Current Cumulative GPA</label>
                <input type="number" id="cum-prev-gpa" value="3.45" step="0.01" min="0" max="5" class="mt-1 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" />
              </div>
              <div>
                <label for="cum-prev-credits" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Completed Credit Hours</label>
                <input type="number" id="cum-prev-credits" value="60" step="1" min="0" class="mt-1 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" />
              </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 space-y-3">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-400">New Semester Performance</span>
              <div>
                <label for="cum-new-gpa" class="block text-xs font-bold text-slate-700 dark:text-slate-300">New Semester GPA</label>
                <input type="number" id="cum-new-gpa" value="3.80" step="0.01" min="0" max="5" class="mt-1 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" />
              </div>
              <div>
                <label for="cum-new-credits" class="block text-xs font-bold text-slate-700 dark:text-slate-300">New Semester Credit Hours</label>
                <input type="number" id="cum-new-credits" value="15" step="1" min="1" class="mt-1 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" />
              </div>
            </div>

          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-cum-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate Cumulative GPA →
            </button>
            <button type="button" id="btn-cum-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-cum" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>
      </div>

      <!-- 4. PERCENTAGE TO GPA CONVERTER -->
      <div id="panel-tab-percentage" class="gpa-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🔢</span> Percentage to GPA Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Convert an academic percentage score into an equivalent 4.0, 5.0, or 10.0 scale GPA.
          </p>
        </div>

        <form id="form-pct-gpa" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="pct-score" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Percentage Score (%)</label>
              <input type="number" id="pct-score" value="85" min="0" max="100" step="0.1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="pct-scale" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Maximum GPA Scale</label>
              <select id="pct-scale" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="4.0" selected>4.0 Scale (Standard US)</option>
                <option value="5.0">5.0 Scale (Weighted / Honors)</option>
                <option value="10.0">10.0 Scale (Indian CGPA / University)</option>
              </select>
            </div>
            <div>
              <label for="pct-method" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Conversion Method</label>
              <select id="pct-method" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="linear" selected>Simple Linear Scale</option>
                <option value="table">Standard Letter Bracket Mapping</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-pct-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Convert Percentage to GPA →
            </button>
            <button type="button" id="btn-pct-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-pct" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>
      </div>

      <!-- 5. GPA GOAL PLANNER -->
      <div id="panel-tab-goal" class="gpa-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🎯</span> Semester GPA Goal Planner
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Find out what GPA you need to average over your upcoming credit hours to hit your target cumulative GPA.
          </p>
        </div>

        <form id="form-goal-gpa" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <div>
              <label for="goal-cur-gpa" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Current Cumulative GPA</label>
              <input type="number" id="goal-cur-gpa" value="3.20" step="0.01" min="0" max="4.0" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="goal-comp-cr" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Completed Credits</label>
              <input type="number" id="goal-comp-cr" value="60" step="1" min="0" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="goal-target-gpa" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Target Cumulative GPA</label>
              <input type="number" id="goal-target-gpa" value="3.40" step="0.01" min="0" max="4.0" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="goal-up-cr" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Upcoming Credit Hours</label>
              <input type="number" id="goal-up-cr" value="30" step="1" min="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-goal-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate Required GPA →
            </button>
            <button type="button" id="btn-goal-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-goal" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>
      </div>

      <!-- RESULTS PRESENTATION CARD (Hidden initially) -->
      <div id="gpa-results-card" class="hidden mt-6 space-y-5">
        
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="res-gpa-title" class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Cumulative GPA (4.0 Scale)</span>
              <div class="mt-1 flex items-baseline gap-3">
                <span id="res-gpa-val" class="text-4xl sm:text-5xl font-black text-blue-600 dark:text-blue-400">3.76</span>
                <span id="res-weighted-val" class="hidden text-xl font-bold text-purple-600 dark:text-purple-400">(Weighted: 4.12)</span>
              </div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Letter Grade Equivalent:</span>
              <div id="res-letter-val" class="text-lg sm:text-xl font-bold text-emerald-600 dark:text-emerald-400">A- (Superior)</div>
            </div>
          </div>

          <div id="res-stats-grid" class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Credit Hours</div>
              <div id="res-stat-credits" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">14 Credits</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Quality Points</div>
              <div id="res-stat-points" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">52.7 Points</div>
            </div>
            <div class="col-span-2 sm:col-span-1 rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Courses Evaluated</div>
              <div id="res-stat-courses" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">4 Courses</div>
            </div>
          </div>
        </div>

        <!-- COURSE BREAKDOWN TABLE (Displayed for course modes) -->
        <div id="res-breakdown-card" class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-1.5">
            <span>📝</span> Detailed Course & Quality Points Breakdown
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold">
                <tr>
                  <th class="p-2.5 rounded-l-lg">Course</th>
                  <th class="p-2.5">Level</th>
