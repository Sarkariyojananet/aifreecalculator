<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  const gradePointsMap = {
    'A+': 4.0, 'A': 4.0, 'A-': 3.7, 'B+': 3.3, 'B': 3.0,
    'B-': 2.7, 'C+': 2.3, 'C': 2.0, 'C-': 1.7, 'D+': 1.3, 'D': 1.0, 'F': 0.0
  };

  // State
  let activeTab = 'tab-college';
  let collegeCourses = [
    { name: 'Mathematics', credits: 4, grade: 'A' },
    { name: 'Physics', credits: 4, grade: 'A-' },
    { name: 'Computer Science', credits: 3, grade: 'A+' },
    { name: 'English Literature', credits: 3, grade: 'B+' }
  ];

  let hsCourses = [
    { name: 'English Literature', credits: 1, grade: 'A', level: 'Honors' },
    { name: 'AP Calculus BC', credits: 1, grade: 'A', level: 'AP' },
    { name: 'US History', credits: 1, grade: 'B+', level: 'Regular' },
    { name: 'Chemistry', credits: 1, grade: 'A-', level: 'Honors' }
  ];

  // DOM Elements
  const gpaTabs = document.querySelectorAll('.btn-gpa-tab');
  const gpaPanels = document.querySelectorAll('.gpa-panel');

  const collegeList = document.getElementById('college-courses-list');
  const btnAddCollege = document.getElementById('btn-add-college-course');
  const btnCollegeCalc = document.getElementById('btn-college-calc');
  const btnCollegeClear = document.getElementById('btn-college-clear');
  const errCollege = document.getElementById('err-college');

  const hsList = document.getElementById('hs-courses-list');
  const btnAddHs = document.getElementById('btn-add-hs-course');
  const btnHsCalc = document.getElementById('btn-hs-calc');
  const btnHsClear = document.getElementById('btn-hs-clear');
  const errHs = document.getElementById('err-hs');

  const cumPrevGpa = document.getElementById('cum-prev-gpa');
  const cumPrevCredits = document.getElementById('cum-prev-credits');
  const cumNewGpa = document.getElementById('cum-new-gpa');
  const cumNewCredits = document.getElementById('cum-new-credits');
  const btnCumCalc = document.getElementById('btn-cum-calc');
  const btnCumClear = document.getElementById('btn-cum-clear');
  const errCum = document.getElementById('err-cum');

  const pctScore = document.getElementById('pct-score');
  const pctScale = document.getElementById('pct-scale');
  const pctMethod = document.getElementById('pct-method');
  const btnPctCalc = document.getElementById('btn-pct-calc');
  const btnPctClear = document.getElementById('btn-pct-clear');
  const errPct = document.getElementById('err-pct');

  const goalCurGpa = document.getElementById('goal-cur-gpa');
  const goalCompCr = document.getElementById('goal-comp-cr');
  const goalTargetGpa = document.getElementById('goal-target-gpa');
  const goalUpCr = document.getElementById('goal-up-cr');
  const btnGoalCalc = document.getElementById('btn-goal-calc');
  const btnGoalClear = document.getElementById('btn-goal-clear');
  const errGoal = document.getElementById('err-goal');

  // Result Displays
  const gpaResultsCard = document.getElementById('gpa-results-card');
  const resGpaTitle = document.getElementById('res-gpa-title');
  const resGpaVal = document.getElementById('res-gpa-val');
  const resWeightedVal = document.getElementById('res-weighted-val');
  const resLetterVal = document.getElementById('res-letter-val');
  const resStatsGrid = document.getElementById('res-stats-grid');
  const resStatCredits = document.getElementById('res-stat-credits');
  const resStatPoints = document.getElementById('res-stat-points');
  const resStatCourses = document.getElementById('res-stat-courses');
  const resBreakdownCard = document.getElementById('res-breakdown-card');
  const resBreakdownTbody = document.getElementById('res-breakdown-tbody');
  const resGoalCard = document.getElementById('res-goal-card');

  // Switch Tab
  function switchTab(tabId) {
    activeTab = tabId;
    gpaTabs.forEach((btn) => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.className = 'btn-gpa-tab active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-gpa-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    gpaPanels.forEach((panel) => {
      if (panel.id === `panel-${tabId}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });
  }

  gpaTabs.forEach((btn) => {
    btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab')));
  });

  // Render College Rows
  function renderCollegeRows() {
    collegeList.innerHTML = collegeCourses.map((c, idx) => `
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 text-xs">
        <input type="text" value="${c.name}" data-idx="${idx}" class="col-name flex-1 min-w-[140px] rounded-xl border border-slate-300 bg-white p-2.5 font-semibold dark:border-slate-700 dark:bg-slate-900" placeholder="Course Name" />
        <div class="flex items-center gap-2">
          <input type="number" value="${c.credits}" min="0.5" max="20" step="0.5" data-idx="${idx}" class="col-cr w-16 sm:w-20 rounded-xl border border-slate-300 bg-white p-2.5 text-center font-bold dark:border-slate-700 dark:bg-slate-900" placeholder="Credits" />
          <select data-idx="${idx}" class="col-gr w-24 rounded-xl border border-slate-300 bg-white p-2.5 font-bold dark:border-slate-700 dark:bg-slate-900 cursor-pointer">
            ${Object.keys(gradePointsMap).map(g => `<option value="${g}" ${g === c.grade ? 'selected' : ''}>${g} (${gradePointsMap[g].toFixed(1)})</option>`).join('')}
          </select>
          <button type="button" data-idx="${idx}" class="btn-col-del h-9 w-9 flex items-center justify-center rounded-xl border border-slate-200 text-slate-400 hover:text-red-600 hover:border-red-300 dark:border-slate-700 dark:hover:border-red-800 cursor-pointer">✕</button>
        </div>
      </div>
    `).join('');

    bindCollegeRowEvents();
  }

  function bindCollegeRowEvents() {
    collegeList.querySelectorAll('.col-name').forEach(el => el.addEventListener('input', e => {
      collegeCourses[e.target.getAttribute('data-idx')].name = e.target.value;
    }));
    collegeList.querySelectorAll('.col-cr').forEach(el => el.addEventListener('input', e => {
      collegeCourses[e.target.getAttribute('data-idx')].credits = parseFloat(e.target.value) || 0;
    }));
    collegeList.querySelectorAll('.col-gr').forEach(el => el.addEventListener('change', e => {
      collegeCourses[e.target.getAttribute('data-idx')].grade = e.target.value;
    }));
    collegeList.querySelectorAll('.btn-col-del').forEach(el => el.addEventListener('click', e => {
      const idx = parseInt(e.currentTarget.getAttribute('data-idx'));
      if (collegeCourses.length > 1) {
        collegeCourses.splice(idx, 1);
        renderCollegeRows();
      }
    }));
  }

  btnAddCollege.addEventListener('click', () => {
    collegeCourses.push({ name: `Course ${collegeCourses.length + 1}`, credits: 3, grade: 'A' });
    renderCollegeRows();
  });

  // Render High School Rows
  function renderHsRows() {
    hsList.innerHTML = hsCourses.map((c, idx) => `
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 text-xs">
        <input type="text" value="${c.name}" data-idx="${idx}" class="hs-name flex-1 min-w-[140px] rounded-xl border border-slate-300 bg-white p-2.5 font-semibold dark:border-slate-700 dark:bg-slate-900" placeholder="Subject Name" />
        <div class="flex items-center gap-2">
          <select data-idx="${idx}" class="hs-lvl w-24 rounded-xl border border-slate-300 bg-white p-2.5 font-bold dark:border-slate-700 dark:bg-slate-900 cursor-pointer">
            <option value="Regular" ${c.level === 'Regular' ? 'selected' : ''}>Regular (+0)</option>
            <option value="Honors" ${c.level === 'Honors' ? 'selected' : ''}>Honors (+0.5)</option>
            <option value="AP" ${c.level === 'AP' ? 'selected' : ''}>AP / IB (+1.0)</option>
          </select>
          <select data-idx="${idx}" class="hs-gr w-24 rounded-xl border border-slate-300 bg-white p-2.5 font-bold dark:border-slate-700 dark:bg-slate-900 cursor-pointer">
            ${Object.keys(gradePointsMap).map(g => `<option value="${g}" ${g === c.grade ? 'selected' : ''}>${g} (${gradePointsMap[g].toFixed(1)})</option>`).join('')}
          </select>
          <button type="button" data-idx="${idx}" class="btn-hs-del h-9 w-9 flex items-center justify-center rounded-xl border border-slate-200 text-slate-400 hover:text-red-600 hover:border-red-300 dark:border-slate-700 dark:hover:border-red-800 cursor-pointer">✕</button>
        </div>
      </div>
    `).join('');

    bindHsRowEvents();
  }

  function bindHsRowEvents() {
    hsList.querySelectorAll('.hs-name').forEach(el => el.addEventListener('input', e => {
      hsCourses[e.target.getAttribute('data-idx')].name = e.target.value;
    }));
    hsList.querySelectorAll('.hs-lvl').forEach(el => el.addEventListener('change', e => {
      hsCourses[e.target.getAttribute('data-idx')].level = e.target.value;
    }));
    hsList.querySelectorAll('.hs-gr').forEach(el => el.addEventListener('change', e => {
      hsCourses[e.target.getAttribute('data-idx')].grade = e.target.value;
    }));
    hsList.querySelectorAll('.btn-hs-del').forEach(el => el.addEventListener('click', e => {
      const idx = parseInt(e.currentTarget.getAttribute('data-idx'));
      if (hsCourses.length > 1) {
        hsCourses.splice(idx, 1);
        renderHsRows();
      }
    }));
  }

  btnAddHs.addEventListener('click', () => {
    hsCourses.push({ name: `Subject ${hsCourses.length + 1}`, credits: 1, grade: 'A', level: 'Regular' });
    renderHsRows();
  });

  // Calculate College GPA
  btnCollegeCalc.addEventListener('click', () => {
    errCollege.classList.add('hidden');
    let totCred = 0;
    let totPts = 0;
    const rows = [];

    collegeCourses.forEach((c, i) => {
      const cr = parseFloat(c.credits) || 0;
      const base = gradePointsMap[c.grade] ?? 0;
      const pts = cr * base;
      if (cr > 0) {
        totCred += cr;
        totPts += pts;
        rows.push({ name: c.name || `Course ${i+1}`, level: 'College', cr, gr: c.grade, base, pts });
      }
    });

    if (totCred === 0) {
      errCollege.textContent = 'Please enter at least one valid course with credit hours greater than 0.';
      errCollege.classList.remove('hidden');
      gpaResultsCard.classList.add('hidden');
      return;
    }

    const gpa = Number((totPts / totCred).toFixed(2));
    let letter = 'F';
    if (gpa >= 3.85) letter = 'A (Excellent)';
    else if (gpa >= 3.5) letter = 'A- (Superior)';
    else if (gpa >= 3.15) letter = 'B+ (Very Good)';
    else if (gpa >= 2.85) letter = 'B (Good)';
    else if (gpa >= 2.5) letter = 'B- (Above Average)';
    else if (gpa >= 2.0) letter = 'C (Satisfactory)';
    else letter = 'D/F (Needs Improvement)';

    resGpaTitle.textContent = 'College Semester GPA (4.0 Scale)';
    resGpaVal.textContent = gpa.toFixed(2);
    resWeightedVal.classList.add('hidden');
    resLetterVal.textContent = letter;

    resStatsGrid.classList.remove('hidden');
    resStatCredits.textContent = `${totCred} Credit Hours`;
    resStatPoints.textContent = `${totPts.toFixed(1)} Quality Points`;
    resStatCourses.textContent = `${rows.length} Courses`;

    resBreakdownTbody.innerHTML = rows.map(r => `
      <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
        <td class="p-2.5 font-bold text-slate-900 dark:text-white">${r.name}</td>
        <td class="p-2.5 text-slate-500">${r.level}</td>
        <td class="p-2.5 text-center font-bold">${r.cr}</td>
        <td class="p-2.5 text-center font-bold text-blue-600 dark:text-blue-400">${r.gr}</td>
        <td class="p-2.5 text-center text-slate-500">${r.base.toFixed(1)}</td>
        <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${r.pts.toFixed(1)}</td>
      </tr>
    `).join('') + `
      <tr class="bg-slate-50 dark:bg-slate-800 font-bold border-t-2 border-slate-200 dark:border-slate-700">
        <td class="p-2.5" colspan="2">Total / Cumulative GPA</td>
        <td class="p-2.5 text-center">${totCred}</td>
        <td class="p-2.5" colspan="2"></td>
        <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-black">${gpa.toFixed(2)}</td>
      </tr>
    `;

    resBreakdownCard.classList.remove('hidden');
    resGoalCard.classList.add('hidden');
    gpaResultsCard.classList.remove('hidden');
  });

  btnCollegeClear.addEventListener('click', () => {
    collegeCourses = [
      { name: 'Mathematics', credits: 4, grade: 'A' },
      { name: 'Physics', credits: 4, grade: 'A-' },
      { name: 'Computer Science', credits: 3, grade: 'A+' },
      { name: 'English Literature', credits: 3, grade: 'B+' }
    ];
    renderCollegeRows();
    errCollege.classList.add('hidden');
    gpaResultsCard.classList.add('hidden');
  });

  // Calculate High School / Weighted GPA
  btnHsCalc.addEventListener('click', () => {
    errHs.classList.add('hidden');
    let totCred = 0;
    let totUnweightedPts = 0;
    let totWeightedPts = 0;
    const rows = [];

    hsCourses.forEach((c, i) => {
      const cr = 1;
      const base = gradePointsMap[c.grade] ?? 0;
      let bonus = 0;
      if (base > 0) {
        if (c.level === 'Honors') bonus = 0.5;
        if (c.level === 'AP') bonus = 1.0;
      }
      const finalPts = (base + bonus) * cr;
      totCred += cr;
      totUnweightedPts += base * cr;
      totWeightedPts += finalPts;
      rows.push({ name: c.name || `Subject ${i+1}`, level: c.level, cr, gr: c.grade, base: base + bonus, pts: finalPts });
    });

    if (totCred === 0) {
      errHs.textContent = 'Please enter at least one subject.';
      errHs.classList.remove('hidden');
      gpaResultsCard.classList.add('hidden');
      return;
    }

    const unweightedGpa = Number((totUnweightedPts / totCred).toFixed(2));
    const weightedGpa = Number((totWeightedPts / totCred).toFixed(2));

    resGpaTitle.textContent = 'High School GPA Summary';
    resGpaVal.textContent = `${unweightedGpa.toFixed(2)} (Unweighted)`;
    resWeightedVal.textContent = `Weighted: ${weightedGpa.toFixed(2)}`;
    resWeightedVal.classList.remove('hidden');
    resLetterVal.textContent = unweightedGpa >= 3.5 ? 'A- / Superior' : unweightedGpa >= 3.0 ? 'B / Good' : 'Satisfactory';

    resStatsGrid.classList.remove('hidden');
    resStatCredits.textContent = `${totCred} Subjects`;
    resStatPoints.textContent = `${totWeightedPts.toFixed(1)} Weighted Points`;
    resStatCourses.textContent = `${rows.length} Courses`;

    resBreakdownTbody.innerHTML = rows.map(r => `
      <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
        <td class="p-2.5 font-bold text-slate-900 dark:text-white">${r.name}</td>
        <td class="p-2.5 text-purple-600 dark:text-purple-400 font-bold">${r.level}</td>
        <td class="p-2.5 text-center font-bold">${r.cr}</td>
        <td class="p-2.5 text-center font-bold text-blue-600 dark:text-blue-400">${r.gr}</td>
        <td class="p-2.5 text-center text-slate-500">${r.base.toFixed(1)}</td>
        <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${r.pts.toFixed(1)}</td>
      </tr>
    `).join('');

    resBreakdownCard.classList.remove('hidden');
    resGoalCard.classList.add('hidden');
    gpaResultsCard.classList.remove('hidden');
  });

  btnHsClear.addEventListener('click', () => {
    hsCourses = [
      { name: 'English Literature', credits: 1, grade: 'A', level: 'Honors' },
      { name: 'AP Calculus BC', credits: 1, grade: 'A', level: 'AP' },
      { name: 'US History', credits: 1, grade: 'B+', level: 'Regular' },
      { name: 'Chemistry', credits: 1, grade: 'A-', level: 'Honors' }
    ];
    renderHsRows();
    errHs.classList.add('hidden');
    gpaResultsCard.classList.add('hidden');
  });

  // Calculate Cumulative GPA
  btnCumCalc.addEventListener('click', () => {
    errCum.classList.add('hidden');
    const pGpa = parseFloat(cumPrevGpa.value) || 0;
    const pCr = parseFloat(cumPrevCredits.value) || 0;
    const nGpa = parseFloat(cumNewGpa.value) || 0;
    const nCr = parseFloat(cumNewCredits.value) || 0;

    if (nCr <= 0) {
      errCum.textContent = 'New semester credit hours must be greater than zero.';
      errCum.classList.remove('hidden');
      gpaResultsCard.classList.add('hidden');
      return;
    }

    const totPoints = pGpa * pCr + nGpa * nCr;
    const totCredits = pCr + nCr;
    const cumGpa = Number((totPoints / totCredits).toFixed(2));

    resGpaTitle.textContent = 'Updated Cumulative GPA';
    resGpaVal.textContent = cumGpa.toFixed(2);
    resWeightedVal.classList.add('hidden');
    resLetterVal.textContent = cumGpa >= 3.5 ? 'A- / Superior' : cumGpa >= 3.0 ? 'B / Good' : 'Passing';

    resStatsGrid.classList.remove('hidden');
    resStatCredits.textContent = `${totCredits} Total Credits`;
    resStatPoints.textContent = `${totPoints.toFixed(1)} Total Points`;
    resStatCourses.textContent = `2 Semesters`;

    resBreakdownCard.classList.add('hidden');
    resGoalCard.classList.add('hidden');
    gpaResultsCard.classList.remove('hidden');
  });

  btnCumClear.addEventListener('click', () => {
    cumPrevGpa.value = '3.45';
    cumPrevCredits.value = '60';
    cumNewGpa.value = '3.80';
    cumNewCredits.value = '15';
    errCum.classList.add('hidden');
    gpaResultsCard.classList.add('hidden');
  });

  // Calculate Percentage to GPA
  btnPctCalc.addEventListener('click', () => {
    errPct.classList.add('hidden');
    const pct = parseFloat(pctScore.value);
    const scale = parseFloat(pctScale.value);
    const method = pctMethod.value;

    if (isNaN(pct) || pct < 0 || pct > 100) {
      errPct.textContent = 'Please enter a percentage score between 0 and 100.';
      errPct.classList.remove('hidden');
      gpaResultsCard.classList.add('hidden');
      return;
    }

    let gpa = 0;
    let letter = 'F';
    if (method === 'linear') {
      gpa = Number(((pct / 100) * scale).toFixed(2));
      if (pct >= 90) letter = 'A (Excellent)';
      else if (pct >= 80) letter = 'B (Good)';
      else if (pct >= 70) letter = 'C (Satisfactory)';
      else letter = 'D/F';
    } else {
      if (pct >= 93) { gpa = 4.0; letter = 'A'; }
      else if (pct >= 90) { gpa = 3.7; letter = 'A-'; }
      else if (pct >= 87) { gpa = 3.3; letter = 'B+'; }
      else if (pct >= 83) { gpa = 3.0; letter = 'B'; }
      else if (pct >= 80) { gpa = 2.7; letter = 'B-'; }
      else if (pct >= 70) { gpa = 2.0; letter = 'C'; }
      else { gpa = 1.0; letter = 'D'; }
      if (scale === 5.0) gpa = Number((gpa * 1.25).toFixed(2));
      if (scale === 10.0) gpa = Number((gpa * 2.5).toFixed(2));
    }

    resGpaTitle.textContent = `Converted GPA (${scale.toFixed(1)} Scale)`;
    resGpaVal.textContent = gpa.toFixed(2);
    resWeightedVal.classList.add('hidden');
    resLetterVal.textContent = letter;

    resStatsGrid.classList.add('hidden');
    resBreakdownCard.classList.add('hidden');
    resGoalCard.classList.add('hidden');
    gpaResultsCard.classList.remove('hidden');
  });

  btnPctClear.addEventListener('click', () => {
    pctScore.value = '85';
    pctScale.value = '4.0';
    pctMethod.value = 'linear';
    errPct.classList.add('hidden');
    gpaResultsCard.classList.add('hidden');
  });

  // Calculate GPA Goal
  btnGoalCalc.addEventListener('click', () => {
    errGoal.classList.add('hidden');
    const curGpa = parseFloat(goalCurGpa.value) || 0;
    const compCr = parseFloat(goalCompCr.value) || 0;
    const tgtGpa = parseFloat(goalTargetGpa.value) || 0;
    const upCr = parseFloat(goalUpCr.value) || 0;

    if (upCr <= 0) {
      errGoal.textContent = 'Upcoming credit hours must be greater than zero.';
      errGoal.classList.remove('hidden');
      gpaResultsCard.classList.add('hidden');
      return;
    }

    const curPts = curGpa * compCr;
    const totCr = compCr + upCr;
    const tgtPts = tgtGpa * totCr;
    const reqPts = tgtPts - curPts;
    const reqGpa = Number((reqPts / upCr).toFixed(2));

    resGpaTitle.textContent = 'Required Future Semester GPA';
    resGpaVal.textContent = reqGpa > 4.0 ? `${reqGpa.toFixed(2)} (Exceeds 4.0)` : reqGpa.toFixed(2);
    resWeightedVal.classList.add('hidden');
    resLetterVal.textContent = reqGpa <= 4.0 ? 'Achievable Goal' : 'Needs More Credits';

    resStatsGrid.classList.add('hidden');
    resBreakdownCard.classList.add('hidden');

    resGoalCard.innerHTML = `
      <div class="font-bold text-slate-900 dark:text-white mb-1">Goal Feasibility Analysis:</div>
      ${reqGpa > 4.0 ? 
        `To reach a cumulative GPA of ${tgtGpa.toFixed(2)}, you would need to average a ${reqGpa.toFixed(2)} GPA across your next ${upCr} credits, which exceeds the standard 4.0 maximum. Try increasing your upcoming credit hours or setting an intermediate target.` :
        `You need to average a <strong>${reqGpa.toFixed(2)} GPA</strong> across your upcoming ${upCr} credit hours to reach your target cumulative GPA of <strong>${tgtGpa.toFixed(2)}</strong>.`
      }
    `;
    resGoalCard.classList.remove('hidden');
    gpaResultsCard.classList.remove('hidden');
  });

  btnGoalClear.addEventListener('click', () => {
    goalCurGpa.value = '3.20';
    goalCompCr.value = '60';
    goalTargetGpa.value = '3.40';
    goalUpCr.value = '30';
    errGoal.classList.add('hidden');
    gpaResultsCard.classList.add('hidden');
  });

  // Preset Clicks
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      switchTab(target);

      if (target === 'tab-cumulative') {
        cumPrevGpa.value = btn.getAttribute('data-cgpa');
        cumPrevCredits.value = btn.getAttribute('data-ccr');
        cumNewGpa.value = btn.getAttribute('data-ngpa');
        cumNewCredits.value = btn.getAttribute('data-ncr');
      } else if (target === 'tab-percentage') {
        pctScore.value = btn.getAttribute('data-pct');
        pctScale.value = btn.getAttribute('data-scale');
      } else if (target === 'tab-goal') {
        goalCurGpa.value = btn.getAttribute('data-cgpa');
        goalCompCr.value = btn.getAttribute('data-ccr');
        goalTargetGpa.value = btn.getAttribute('data-tgpa');
        goalUpCr.value = btn.getAttribute('data-ucr');
      }
    });
  });

  // Enter Key Support
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.click();
        }
      });
    });
  });

  // Initialize
  renderCollegeRows();
  renderHsRows();
</script>
