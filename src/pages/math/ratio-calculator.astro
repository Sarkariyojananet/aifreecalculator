  <!-- CLIENT-SIDE CALCULATION ENGINE SCRIPT -->
  <script>
    // Safe numeric parser supporting decimals, scientific e-notation, and fractional expressions
    function parseNum(val: string): number | null {
      if (!val) return null;
      const clean = val.trim();
      if (!clean) return null;

      if (clean.includes('/')) {
        const parts = clean.split('/');
        if (parts.length === 2) {
          const num = parseFloat(parts[0]);
          const den = parseFloat(parts[1]);
          if (!isNaN(num) && !isNaN(den) && den !== 0) {
            return num / den;
          }
        }
      }

      const num = Number(clean);
      return isNaN(num) ? null : num;
    }

    // Euclidean Greatest Common Divisor for integers
    function gcdInt(a: number, b: number): number {
      let x = Math.abs(Math.round(a));
      let y = Math.abs(Math.round(b));
      while (y) {
        const t = y;
        y = x % y;
        x = t;
      }
      return x || 1;
    }

    // GCD for 3 integers
    function gcd3Int(a: number, b: number, c: number): number {
      return gcdInt(gcdInt(a, b), c);
    }

    // Convert decimal numbers to whole numbers by multiplying by power of 10
    function getDecimalScale(numbers: number[]): number {
      let maxDecimals = 0;
      for (const n of numbers) {
        if (!Number.isFinite(n)) continue;
        const s = n.toString();
        if (s.includes('e-')) {
          const exp = parseInt(s.split('e-')[1], 10);
          if (exp > maxDecimals) maxDecimals = Math.min(exp, 6);
        } else if (s.includes('.')) {
          const dec = s.split('.')[1].length;
          if (dec > maxDecimals) maxDecimals = Math.min(dec, 6);
        }
      }
      return Math.pow(10, maxDecimals);
    }

    // Simplify 2 terms
    function simplifyRatio2(a: number, b: number): { a: number; b: number; gcd: number } {
      if (a === 0 && b === 0) return { a: 0, b: 0, gcd: 1 };
      const scale = getDecimalScale([a, b]);
      const intA = Math.round(a * scale);
      const intB = Math.round(b * scale);
      const g = gcdInt(intA, intB);
      return { a: intA / g, b: intB / g, gcd: g / scale };
    }

    // Simplify 3 terms
    function simplifyRatio3(a: number, b: number, c: number): { a: number; b: number; c: number; gcd: number } {
      const scale = getDecimalScale([a, b, c]);
      const intA = Math.round(a * scale);
      const intB = Math.round(b * scale);
      const intC = Math.round(c * scale);
      const g = gcd3Int(intA, intB, intC);
      return { a: intA / g, b: intB / g, c: intC / g, gcd: g / scale };
    }

    // Format number nicely
    function fmt(n: number, maxDec = 4): string {
      if (!Number.isFinite(n)) return '0';
      if (Number.isInteger(n)) return n.toLocaleString('en-US');
      const rounded = parseFloat(n.toFixed(maxDec));
      return rounded.toLocaleString('en-US', { maximumFractionDigits: maxDec });
    }

    // Show result and smooth scroll
    function revealResult() {
      const res = document.getElementById('ratio-result-section');
      if (res) {
        res.classList.remove('hidden');
        res.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Update Visual Proportional Bar
    function updateVisualBar(parts: { label: string; value: number; color: string }[]) {
      const bar = document.getElementById('res-visual-bar');
      const legend = document.getElementById('res-visual-legend');
      const sumEl = document.getElementById('res-total-sum');
      if (!bar || !legend) return;

      bar.innerHTML = '';
      legend.innerHTML = '';

      const total = parts.reduce((acc, p) => acc + (p.value > 0 ? p.value : 0), 0);
      if (sumEl) sumEl.textContent = `Total Sum: ${fmt(total)}`;

      if (total <= 0) return;

      parts.forEach((p) => {
        if (p.value <= 0) return;
        const pct = (p.value / total) * 100;

        // Bar segment
        const seg = document.createElement('div');
        seg.className = `h-full ${p.color} transition-all duration-300 flex items-center justify-center text-[10px] font-bold text-white px-1 overflow-hidden`;
        seg.style.width = `${pct}%`;
        if (pct >= 8) {
          seg.textContent = `${pct.toFixed(1)}%`;
        }
        bar.appendChild(seg);

        // Legend item
        const leg = document.createElement('div');
        leg.className = 'flex items-center gap-1.5';
        leg.innerHTML = `
          <span class="w-3 h-3 rounded-full ${p.color}"></span>
          <span class="text-slate-700 dark:text-slate-300 font-bold">${p.label}:</span>
          <span class="text-slate-500 font-mono">${fmt(p.value)} (${pct.toFixed(1)}%)</span>
        `;
        legend.appendChild(leg);
      });
    }

    // Mode Switcher Handler
    function setMode(modeId: string) {
      const dropdown = document.getElementById('mode-dropdown') as HTMLSelectElement | null;
      if (dropdown && dropdown.value !== modeId) {
        dropdown.value = modeId;
      }

      // Update pill buttons
      document.querySelectorAll('.mode-tab-btn').forEach((btn) => {
        const b = btn as HTMLButtonElement;
        if (b.dataset.mode === modeId) {
          b.className = 'mode-tab-btn active rounded-xl border border-blue-600 bg-blue-50 px-2 py-2 text-center text-xs font-bold text-blue-700 shadow-xs dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer';
        } else {
          b.className = 'mode-tab-btn rounded-xl border border-transparent bg-slate-50 px-2 py-2 text-center text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer';
        }
      });

      // Show matching panel
      document.querySelectorAll('.calc-panel').forEach((p) => {
        const panel = p as HTMLElement;
        if (panel.id === `panel-${modeId}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    // 1. Calculate Proportion (A:B = C:D)
    function calcProp2() {
      const aVal = parseNum((document.getElementById('inp-p2-a') as HTMLInputElement).value);
      const bVal = parseNum((document.getElementById('inp-p2-b') as HTMLInputElement).value);
      const cVal = parseNum((document.getElementById('inp-p2-c') as HTMLInputElement).value);
      const dVal = parseNum((document.getElementById('inp-p2-d') as HTMLInputElement).value);

      const count = [aVal, bVal, cVal, dVal].filter((v) => v !== null).length;

      let solvedA = aVal;
      let solvedB = bVal;
      let solvedC = cVal;
      let solvedD = dVal;
      let targetFound = '';
      let steps: string[] = [];

      if (count === 3) {
        // Solve for missing 4th value
        if (aVal === null && bVal !== null && cVal !== null && dVal !== null) {
          if (dVal === 0) return alert('Division by zero: D cannot be 0.');
          solvedA = (bVal * cVal) / dVal;
          targetFound = 'A';
          steps = [
            `Proportion Equation: A / B = C / D &rArr; A &times; D = B &times; C`,
            `Solve for A: A = (B &times; C) &divide; D`,
            `Substitution: A = (${bVal} &times; ${cVal}) &divide; ${dVal}`,
            `Calculation: A = ${bVal * cVal} &divide; ${dVal} = ${fmt(solvedA)}`
          ];
        } else if (bVal === null && aVal !== null && cVal !== null && dVal !== null) {
          if (cVal === 0) return alert('Division by zero: C cannot be 0.');
          solvedB = (aVal * dVal) / cVal;
          targetFound = 'B';
          steps = [
            `Proportion Equation: A / B = C / D &rArr; B &times; C = A &times; D`,
            `Solve for B: B = (A &times; D) &divide; C`,
            `Substitution: B = (${aVal} &times; ${dVal}) &divide; ${cVal}`,
            `Calculation: B = ${aVal * dVal} &divide; ${cVal} = ${fmt(solvedB)}`
          ];
        } else if (cVal === null && aVal !== null && bVal !== null && dVal !== null) {
          if (bVal === 0) return alert('Division by zero: B cannot be 0.');
          solvedC = (aVal * dVal) / bVal;
          targetFound = 'C';
          steps = [
            `Proportion Equation: A / B = C / D &rArr; B &times; C = A &times; D`,
            `Solve for C: C = D &times; (A &divide; B) or (A &times; D) &divide; B`,
            `Substitution: C = (${aVal} &times; ${dVal}) &divide; ${bVal}`,
            `Calculation: C = ${aVal * dVal} &divide; ${bVal} = ${fmt(solvedC)}`
          ];
        } else if (dVal === null && aVal !== null && bVal !== null && cVal !== null) {
          if (aVal === 0) return alert('Division by zero: A cannot be 0.');
          solvedD = (bVal * cVal) / aVal;
          targetFound = 'D';
          steps = [
            `Proportion Equation: A / B = C / D &rArr; A &times; D = B &times; C`,
            `Solve for D: D = C &times; (B &divide; A) or (B &times; C) &divide; A`,
            `Substitution: D = (${bVal} &times; ${cVal}) &divide; ${aVal}`,
            `Calculation: D = ${bVal * cVal} &divide; ${aVal} = ${fmt(solvedD)}`
          ];
        }
      } else if (count === 4 && aVal !== null && bVal !== null && cVal !== null && dVal !== null) {
        // Test Equivalence
        const left = aVal / bVal;
        const right = cVal / dVal;
        const crossL = aVal * dVal;
        const crossR = bVal * cVal;
        const isEq = Math.abs(crossL - crossR) < 1e-7;

        steps = [
          `Cross Multiplication: A &times; D vs B &times; C`,
          `${aVal} &times; ${dVal} = ${fmt(crossL)}`,
          `${bVal} &times; ${cVal} = ${fmt(crossR)}`,
          `Fractions: ${aVal}/${bVal} = ${fmt(left, 5)} | ${cVal}/${dVal} = ${fmt(right, 5)}`,
          isEq
            ? `Conclusion: Cross products are equal. The ratios are EQUIVALENT (${aVal}:${bVal} = ${cVal}:${dVal})`
            : crossL > crossR
            ? `Conclusion: Cross product A&times;D > B&times;C. Ratio A:B is GREATER THAN C:D (${aVal}:${bVal} > ${cVal}:${dVal})`
            : `Conclusion: Cross product A&times;D < B&times;C. Ratio A:B is LESS THAN C:D (${aVal}:${bVal} < ${cVal}:${dVal})`
        ];
        targetFound = isEq ? 'Equivalent (=)' : crossL > crossR ? 'A:B > C:D' : 'A:B < C:D';
      } else if (count === 2 && aVal !== null && bVal !== null) {
        // Simplify 2 terms
        const simp = simplifyRatio2(aVal, bVal);
        targetFound = `${simp.a} : ${simp.b}`;
        steps = [
          `Simplify Ratio ${aVal} : ${bVal}`,
          `Find Greatest Common Divisor: GCD(${aVal}, ${bVal}) = ${fmt(simp.gcd)}`,
          `Divide each term by GCD: ${aVal} &divide; ${fmt(simp.gcd)} = ${simp.a}, and ${bVal} &divide; ${fmt(simp.gcd)} = ${simp.b}`,
          `Simplified Ratio: ${simp.a} : ${simp.b}`,
          `Equivalent Multiplied: ${simp.a * 2} : ${simp.b * 2}`
        ];
        solvedC = simp.a;
        solvedD = simp.b;
      } else {
        return alert('Please enter at least 2 values to simplify, or 3 values to find the missing 4th.');
      }

      const resPrimary = document.getElementById('res-primary-val');
      const resPrimarySub = document.getElementById('res-primary-sub');
      const resLowest = document.getElementById('res-lowest-val');
      const resLowestGcd = document.getElementById('res-lowest-gcd');
      const resUnit = document.getElementById('res-unit-val');
      const resUnitSub = document.getElementById('res-unit-sub');
      const stepsEl = document.getElementById('res-steps-content');

      const a = solvedA ?? aVal ?? 1;
      const b = solvedB ?? bVal ?? 1;
      const simp = simplifyRatio2(a, b);

      if (resPrimary) resPrimary.textContent = targetFound ? `${targetFound} = ${fmt(solvedD ?? solvedC ?? solvedB ?? solvedA ?? 0)}` : `${fmt(a)} : ${fmt(b)}`;
      if (resPrimarySub) resPrimarySub.textContent = `${fmt(a)} : ${fmt(b)} = ${fmt(solvedC ?? 0)} : ${fmt(solvedD ?? 0)}`;
      if (resLowest) resLowest.textContent = `${simp.a} : ${simp.b}`;
      if (resLowestGcd) resLowestGcd.textContent = `GCD = ${fmt(simp.gcd)}`;
      if (resUnit) resUnit.textContent = `1 : ${fmt(b / (a || 1))}`;
      if (resUnitSub) resUnitSub.textContent = `or ${fmt(a / (b || 1))} : 1`;

      if (stepsEl) {
        stepsEl.innerHTML = steps.map((s, i) => `<div><span class="text-blue-500 font-bold">${i + 1}.</span> ${s}</div>`).join('');
      }

      updateVisualBar([
        { label: 'Part A', value: Math.abs(a), color: 'bg-blue-600' },
        { label: 'Part B', value: Math.abs(b), color: 'bg-emerald-600' }
      ]);

      revealResult();
    }

    // 2. Calculate 3-Term Proportion (A:B:C = D:E:F)
    function calcProp3() {
      const a = parseNum((document.getElementById('inp-p3-a') as HTMLInputElement).value);
      const b = parseNum((document.getElementById('inp-p3-b') as HTMLInputElement).value);
      const c = parseNum((document.getElementById('inp-p3-c') as HTMLInputElement).value);

      const dInp = parseNum((document.getElementById('inp-p3-d') as HTMLInputElement).value);
      const eInp = parseNum((document.getElementById('inp-p3-e') as HTMLInputElement).value);
      const fInp = parseNum((document.getElementById('inp-p3-f') as HTMLInputElement).value);

      if (a === null || b === null || c === null) {
        return alert('Please enter all three terms of the base ratio A : B : C.');
      }

      // Find scaling factor from D, E, or F
      let scale = 1;
      let refUsed = '';
      if (dInp !== null && a !== 0) {
        scale = dInp / a;
        refUsed = `D (${dInp}) / A (${a})`;
      } else if (eInp !== null && b !== 0) {
        scale = eInp / b;
        refUsed = `E (${eInp}) / B (${b})`;
      } else if (fInp !== null && c !== 0) {
        scale = fInp / c;
        refUsed = `F (${fInp}) / C (${c})`;
      } else {
        return alert('Please enter at least one target quantity in D, E, or F to scale the ratio.');
      }

      const d = a * scale;
      const e = b * scale;
      const f = c * scale;

      const simp = simplifyRatio3(a, b, c);

      const resPrimary = document.getElementById('res-primary-val');
      const resPrimarySub = document.getElementById('res-primary-sub');
      const resLowest = document.getElementById('res-lowest-val');
      const resLowestGcd = document.getElementById('res-lowest-gcd');
      const resUnit = document.getElementById('res-unit-val');
      const resUnitSub = document.getElementById('res-unit-sub');
      const stepsEl = document.getElementById('res-steps-content');

      if (resPrimary) resPrimary.textContent = `${fmt(d)} : ${fmt(e)} : ${fmt(f)}`;
      if (resPrimarySub) resPrimarySub.textContent = `Scaled from ${fmt(a)} : ${fmt(b)} : ${fmt(c)} (Scale Multiplier k = ${fmt(scale)})`;
      if (resLowest) resLowest.textContent = `${simp.a} : ${simp.b} : ${simp.c}`;
      if (resLowestGcd) resLowestGcd.textContent = `GCD = ${fmt(simp.gcd)}`;
      if (resUnit) resUnit.textContent = `1 : ${fmt(b / a)} : ${fmt(c / a)}`;
      if (resUnitSub) resUnitSub.textContent = `Scale Factor: ${fmt(scale)}×`;

      const steps = [
        `Base Ratio Given: A : B : C = ${a} : ${b} : ${c}`,
        `Determine Common Scale Factor (k): k = ${refUsed} = ${fmt(scale)}`,
        `Compute D: D = A &times; k = ${a} &times; ${fmt(scale)} = ${fmt(d)}`,
        `Compute E: E = B &times; k = ${b} &times; ${fmt(scale)} = ${fmt(e)}`,
        `Compute F: F = C &times; k = ${c} &times; ${fmt(scale)} = ${fmt(f)}`,
        `Final Proportion: ${a}:${b}:${c} = ${fmt(d)}:${fmt(e)}:${fmt(f)}`
      ];

      if (stepsEl) {
        stepsEl.innerHTML = steps.map((s, i) => `<div><span class="text-blue-500 font-bold">${i + 1}.</span> ${s}</div>`).join('');
      }

      updateVisualBar([
        { label: 'Part A (Cement)', value: Math.abs(d), color: 'bg-blue-600' },
        { label: 'Part B (Sand)', value: Math.abs(e), color: 'bg-emerald-600' },
        { label: 'Part C (Gravel)', value: Math.abs(f), color: 'bg-amber-600' }
      ]);

      revealResult();
    }

    // 3. Calculate Scale 2-Term (Scale A:B)
    function calcScale2() {
      const a = parseNum((document.getElementById('inp-sc2-a') as HTMLInputElement).value);
      const b = parseNum((document.getElementById('inp-sc2-b') as HTMLInputElement).value);
      const op = (document.getElementById('sel-sc2-op') as HTMLSelectElement).value;
      const factor = parseNum((document.getElementById('inp-sc2-factor') as HTMLInputElement).value);

      if (a === null || b === null || factor === null) {
        return alert('Please enter both ratio terms and the scale factor.');
      }
      if (factor === 0 && op === 'divide') {
        return alert('Cannot divide by zero scale factor.');
      }

      const resA = op === 'multiply' ? a * factor : a / factor;
      const resB = op === 'multiply' ? b * factor : b / factor;

      const simp = simplifyRatio2(resA, resB);

      const resPrimary = document.getElementById('res-primary-val');
      const resPrimarySub = document.getElementById('res-primary-sub');
      const resLowest = document.getElementById('res-lowest-val');
      const resLowestGcd = document.getElementById('res-lowest-gcd');
      const resUnit = document.getElementById('res-unit-val');
      const resUnitSub = document.getElementById('res-unit-sub');
      const stepsEl = document.getElementById('res-steps-content');

      if (resPrimary) resPrimary.textContent = `${fmt(resA)} : ${fmt(resB)}`;
      if (resPrimarySub) resPrimarySub.textContent = `Original: ${fmt(a)} : ${fmt(b)} ${op === 'multiply' ? 'scaled up ×' : 'shrunk down ÷'} ${factor}`;
      if (resLowest) resLowest.textContent = `${simp.a} : ${simp.b}`;
      if (resLowestGcd) resLowestGcd.textContent = `GCD = ${fmt(simp.gcd)}`;
      if (resUnit) resUnit.textContent = `1 : ${fmt(resB / (resA || 1))}`;
      if (resUnitSub) resUnitSub.textContent = `or ${fmt(resA / (resB || 1))} : 1`;

      const steps = [
        `Original Ratio: ${a} : ${b}`,
        `Action: ${op === 'multiply' ? `Multiply each term by ${factor}` : `Divide each term by ${factor}`}`,
        `Scaled A = ${a} ${op === 'multiply' ? '×' : '÷'} ${factor} = ${fmt(resA)}`,
        `Scaled B = ${b} ${op === 'multiply' ? '×' : '÷'} ${factor} = ${fmt(resB)}`,
        `Resulting Ratio: ${fmt(resA)} : ${fmt(resB)} (Simplified: ${simp.a} : ${simp.b})`
      ];

      if (stepsEl) {
        stepsEl.innerHTML = steps.map((s, i) => `<div><span class="text-blue-500 font-bold">${i + 1}.</span> ${s}</div>`).join('');
      }

      updateVisualBar([
        { label: 'Part A', value: Math.abs(resA), color: 'bg-purple-600' },
        { label: 'Part B', value: Math.abs(resB), color: 'bg-indigo-600' }
      ]);

      revealResult();
    }

    // 4. Calculate Scale 3-Term (Scale A:B:C / Recipes)
    function calcScale3() {
      const a = parseNum((document.getElementById('inp-sc3-a') as HTMLInputElement).value);
      const b = parseNum((document.getElementById('inp-sc3-b') as HTMLInputElement).value);
      const c = parseNum((document.getElementById('inp-sc3-c') as HTMLInputElement).value);
      const op = (document.getElementById('sel-sc3-op') as HTMLSelectElement).value;
      const factor = parseNum((document.getElementById('inp-sc3-factor') as HTMLInputElement).value);

      if (a === null || b === null || c === null || factor === null) {
        return alert('Please enter all three terms of the ratio and the scale factor.');
      }
      if (factor === 0 && op === 'divide') {
        return alert('Cannot divide by zero scale factor.');
      }

      const resA = op === 'multiply' ? a * factor : a / factor;
      const resB = op === 'multiply' ? b * factor : b / factor;
      const resC = op === 'multiply' ? c * factor : c / factor;

      const simp = simplifyRatio3(resA, resB, resC);

      const resPrimary = document.getElementById('res-primary-val');
      const resPrimarySub = document.getElementById('res-primary-sub');
      const resLowest = document.getElementById('res-lowest-val');
      const resLowestGcd = document.getElementById('res-lowest-gcd');
      const resUnit = document.getElementById('res-unit-val');
      const resUnitSub = document.getElementById('res-unit-sub');
      const stepsEl = document.getElementById('res-steps-content');

      if (resPrimary) resPrimary.textContent = `${fmt(resA)} : ${fmt(resB)} : ${fmt(resC)}`;
      if (resPrimarySub) resPrimarySub.textContent = `Recipe scaled from ${fmt(a)} : ${fmt(b)} : ${fmt(c)} by factor of ${factor}×`;
      if (resLowest) resLowest.textContent = `${simp.a} : ${simp.b} : ${simp.c}`;
      if (resLowestGcd) resLowestGcd.textContent = `GCD = ${fmt(simp.gcd)}`;
      if (resUnit) resUnit.textContent = `1 : ${fmt(resB / resA)} : ${fmt(resC / resA)}`;
      if (resUnitSub) resUnitSub.textContent = `Total Batch = ${fmt(resA + resB + resC)}`;

      const steps = [
        `Base Recipe Specification: A : B : C = ${a} : ${b} : ${c}`,
        `Scaling Operation: ${op === 'multiply' ? `Multiply each ingredient by ${factor}` : `Divide each ingredient by ${factor}`}`,
        `Ingredient 1: ${a} ${op === 'multiply' ? '×' : '÷'} ${factor} = ${fmt(resA)}`,
        `Ingredient 2: ${b} ${op === 'multiply' ? '×' : '÷'} ${factor} = ${fmt(resB)}`,
        `Ingredient 3: ${c} ${op === 'multiply' ? '×' : '÷'} ${factor} = ${fmt(resC)}`,
        `Scaled Yield: ${fmt(resA)} : ${fmt(resB)} : ${fmt(resC)}`
      ];

      if (stepsEl) {
        stepsEl.innerHTML = steps.map((s, i) => `<div><span class="text-blue-500 font-bold">${i + 1}.</span> ${s}</div>`).join('');
      }

      updateVisualBar([
        { label: 'Ingredient 1 (Macaroni)', value: Math.abs(resA), color: 'bg-amber-600' },
        { label: 'Ingredient 2 (Milk)', value: Math.abs(resB), color: 'bg-blue-600' },
        { label: 'Ingredient 3 (Cheese)', value: Math.abs(resC), color: 'bg-emerald-600' }
      ]);

      revealResult();
    }

    // 5. Calculate Simplifier & Fraction Converter
    function calcSimplify() {
      const a = parseNum((document.getElementById('inp-sim-a') as HTMLInputElement).value);
      const b = parseNum((document.getElementById('inp-sim-b') as HTMLInputElement).value);
      const c = parseNum((document.getElementById('inp-sim-c') as HTMLInputElement).value);

      if (a === null || b === null) {
        return alert('Please enter at least terms A and B.');
      }

      const resPrimary = document.getElementById('res-primary-val');
      const resPrimarySub = document.getElementById('res-primary-sub');
      const resLowest = document.getElementById('res-lowest-val');
      const resLowestGcd = document.getElementById('res-lowest-gcd');
      const resUnit = document.getElementById('res-unit-val');
      const resUnitSub = document.getElementById('res-unit-sub');
      const stepsEl = document.getElementById('res-steps-content');

      if (c === null) {
        // 2-term
        const simp = simplifyRatio2(a, b);
        const total = a + b;
        const fracA = a / total;
        const fracB = b / total;

        if (resPrimary) resPrimary.textContent = `${simp.a} : ${simp.b}`;
        if (resPrimarySub) resPrimarySub.textContent = `Part-to-Whole Fractions: ${simp.a}/${simp.a + simp.b} and ${simp.b}/${simp.a + simp.b}`;
        if (resLowest) resLowest.textContent = `${simp.a} : ${simp.b}`;
        if (resLowestGcd) resLowestGcd.textContent = `GCD = ${fmt(simp.gcd)}`;
        if (resUnit) resUnit.textContent = `1 : ${fmt(b / a)}`;
        if (resUnitSub) resUnitSub.textContent = `or ${fmt(a / b)} : 1`;

        const steps = [
          `Original Input: ${a} : ${b}`,
          `Find Greatest Common Divisor: GCD(${a}, ${b}) = ${fmt(simp.gcd)}`,
          `Divide terms by GCD: ${a} &divide; ${fmt(simp.gcd)} = ${simp.a}, and ${b} &divide; ${fmt(simp.gcd)} = ${simp.b}`,
          `Reduced Lowest Terms: ${simp.a} : ${simp.b}`,
          `Total Parts Sum = ${a} + ${b} = ${total}`,
          `Part A Fraction of Whole: ${a}/${total} = ${(fracA * 100).toFixed(2)}%`,
          `Part B Fraction of Whole: ${b}/${total} = ${(fracB * 100).toFixed(2)}%`
        ];

        if (stepsEl) {
          stepsEl.innerHTML = steps.map((s, i) => `<div><span class="text-blue-500 font-bold">${i + 1}.</span> ${s}</div>`).join('');
        }

        updateVisualBar([
          { label: 'Part A', value: Math.abs(a), color: 'bg-indigo-600' },
          { label: 'Part B', value: Math.abs(b), color: 'bg-teal-600' }
        ]);
      } else {
        // 3-term
        const simp = simplifyRatio3(a, b, c);
        const total = a + b + c;

        if (resPrimary) resPrimary.textContent = `${simp.a} : ${simp.b} : ${simp.c}`;
        const simpSum = simp.a + simp.b + simp.c;
        if (resPrimarySub) resPrimarySub.textContent = `Fractions: ${simp.a}/${simpSum}, ${simp.b}/${simpSum}, ${simp.c}/${simpSum}`;
        if (resLowest) resLowest.textContent = `${simp.a} : ${simp.b} : ${simp.c}`;
        if (resLowestGcd) resLowestGcd.textContent = `GCD = ${fmt(simp.gcd)}`;
        if (resUnit) resUnit.textContent = `1 : ${fmt(b / a)} : ${fmt(c / a)}`;
        if (resUnitSub) resUnitSub.textContent = `Sum = ${fmt(total)}`;

        const steps = [
          `Original Input: ${a} : ${b} : ${c}`,
          `Find Greatest Common Divisor: GCD = ${fmt(simp.gcd)}`,
          `Divide terms by GCD: ${simp.a} : ${simp.b} : ${simp.c}`,
          `Total Parts Sum = ${a} + ${b} + ${c} = ${total}`,
          `Part A Share: ${a}/${total} = ${((a / total) * 100).toFixed(2)}%`,
          `Part B Share: ${b}/${total} = ${((b / total) * 100).toFixed(2)}%`,
          `Part C Share: ${c}/${total} = ${((c / total) * 100).toFixed(2)}%`
        ];

        if (stepsEl) {
          stepsEl.innerHTML = steps.map((s, i) => `<div><span class="text-blue-500 font-bold">${i + 1}.</span> ${s}</div>`).join('');
        }

        updateVisualBar([
          { label: 'Part A', value: Math.abs(a), color: 'bg-blue-600' },
          { label: 'Part B', value: Math.abs(b), color: 'bg-emerald-600' },
          { label: 'Part C', value: Math.abs(c), color: 'bg-amber-600' }
        ]);
      }

      revealResult();
    }

    // 6. Calculate Aspect Ratio & Screen Resolution
    function calcAspect() {
      const w = parseNum((document.getElementById('inp-ar-w') as HTMLInputElement).value);
      const h = parseNum((document.getElementById('inp-ar-h') as HTMLInputElement).value);

      if (w === null || h === null || w <= 0 || h <= 0) {
        return alert('Please enter positive integer pixel width and height.');
      }

      const simp = simplifyRatio2(w, h);
      const decimalRatio = w / h;
      const megapixels = (w * h) / 1000000;

      const resPrimary = document.getElementById('res-primary-val');
      const resPrimarySub = document.getElementById('res-primary-sub');
      const resLowest = document.getElementById('res-lowest-val');
      const resLowestGcd = document.getElementById('res-lowest-gcd');
      const resUnit = document.getElementById('res-unit-val');
      const resUnitSub = document.getElementById('res-unit-sub');
      const stepsEl = document.getElementById('res-steps-content');

      if (resPrimary) resPrimary.textContent = `${simp.a} : ${simp.b}`;
      if (resPrimarySub) resPrimarySub.textContent = `${w} &times; ${h} pixels (${megapixels.toFixed(2)} Megapixels)`;
      if (resLowest) resLowest.textContent = `${simp.a} : ${simp.b}`;
      if (resLowestGcd) resLowestGcd.textContent = `GCD = ${simp.gcd}`;
      if (resUnit) resUnit.textContent = `${decimalRatio.toFixed(2)} : 1`;
      if (resUnitSub) resUnitSub.textContent = `or 1 : ${(h / w).toFixed(2)}`;

      const steps = [
        `Resolution Input: ${w} pixels wide &times; ${h} pixels tall`,
        `Calculate Greatest Common Divisor: GCD(${w}, ${h}) = ${simp.gcd}`,
        `Divide dimensions: ${w} &divide; ${simp.gcd} = ${simp.a}, and ${h} &divide; ${simp.gcd} = ${simp.b}`,
        `Standard Aspect Ratio: ${simp.a} : ${simp.b}`,
        `Decimal Aspect Ratio: ${w} &divide; ${h} = ${decimalRatio.toFixed(4)} : 1`,
        `Total Pixel Count = ${w * h} (${megapixels.toFixed(2)} MP)`
      ];

      if (stepsEl) {
        stepsEl.innerHTML = steps.map((s, i) => `<div><span class="text-blue-500 font-bold">${i + 1}.</span> ${s}</div>`).join('');
      }

      updateVisualBar([
        { label: `Width (${w}px)`, value: w, color: 'bg-rose-600' },
        { label: `Height (${h}px)`, value: h, color: 'bg-slate-700' }
      ]);

      revealResult();
    }

    // Initialize Event Listeners
    function init() {
      // Mode dropdown listener
      document.getElementById('mode-dropdown')?.addEventListener('change', (e) => {
        const val = (e.target as HTMLSelectElement).value;
        setMode(val);
      });

      // Mode tab buttons
      document.querySelectorAll('.mode-tab-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const mode = (e.currentTarget as HTMLButtonElement).dataset.mode || 'prop2';
          setMode(mode);
        });
      });

      // Calculate buttons
      document.getElementById('btn-calc-prop2')?.addEventListener('click', calcProp2);
      document.getElementById('btn-calc-prop3')?.addEventListener('click', calcProp3);
      document.getElementById('btn-calc-scale2')?.addEventListener('click', calcScale2);
      document.getElementById('btn-calc-scale3')?.addEventListener('click', calcScale3);
      document.getElementById('btn-calc-simplify')?.addEventListener('click', calcSimplify);
      document.getElementById('btn-calc-aspect')?.addEventListener('click', calcAspect);

      // Clear buttons
      document.getElementById('btn-clear-prop2')?.addEventListener('click', () => {
        (document.getElementById('inp-p2-a') as HTMLInputElement).value = '';
        (document.getElementById('inp-p2-b') as HTMLInputElement).value = '';
        (document.getElementById('inp-p2-c') as HTMLInputElement).value = '';
        (document.getElementById('inp-p2-d') as HTMLInputElement).value = '';
        document.getElementById('ratio-result-section')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-prop3')?.addEventListener('click', () => {
        (document.getElementById('inp-p3-a') as HTMLInputElement).value = '';
        (document.getElementById('inp-p3-b') as HTMLInputElement).value = '';
        (document.getElementById('inp-p3-c') as HTMLInputElement).value = '';
        (document.getElementById('inp-p3-d') as HTMLInputElement).value = '';
        (document.getElementById('inp-p3-e') as HTMLInputElement).value = '';
        (document.getElementById('inp-p3-f') as HTMLInputElement).value = '';
        document.getElementById('ratio-result-section')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-scale2')?.addEventListener('click', () => {
        (document.getElementById('inp-sc2-a') as HTMLInputElement).value = '';
        (document.getElementById('inp-sc2-b') as HTMLInputElement).value = '';
        (document.getElementById('inp-sc2-factor') as HTMLInputElement).value = '1';
        document.getElementById('ratio-result-section')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-scale3')?.addEventListener('click', () => {
        (document.getElementById('inp-sc3-a') as HTMLInputElement).value = '';
        (document.getElementById('inp-sc3-b') as HTMLInputElement).value = '';
        (document.getElementById('inp-sc3-c') as HTMLInputElement).value = '';
        (document.getElementById('inp-sc3-factor') as HTMLInputElement).value = '1';
        document.getElementById('ratio-result-section')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-simplify')?.addEventListener('click', () => {
        (document.getElementById('inp-sim-a') as HTMLInputElement).value = '';
        (document.getElementById('inp-sim-b') as HTMLInputElement).value = '';
        (document.getElementById('inp-sim-c') as HTMLInputElement).value = '';
        document.getElementById('ratio-result-section')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-aspect')?.addEventListener('click', () => {
        (document.getElementById('inp-ar-w') as HTMLInputElement).value = '1920';
        (document.getElementById('inp-ar-h') as HTMLInputElement).value = '1080';
        document.getElementById('ratio-result-section')?.classList.add('hidden');
      });

      // Quick preset buttons
      document.querySelectorAll('.btn-quick-preset').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const b = e.currentTarget as HTMLButtonElement;
          const mode = b.dataset.mode || 'prop2';
          setMode(mode);

          if (mode === 'prop2') {
            (document.getElementById('inp-p2-a') as HTMLInputElement).value = b.dataset.a || '';
            (document.getElementById('inp-p2-b') as HTMLInputElement).value = b.dataset.b || '';
            (document.getElementById('inp-p2-c') as HTMLInputElement).value = b.dataset.c || '';
            (document.getElementById('inp-p2-d') as HTMLInputElement).value = b.dataset.d || '';
            calcProp2();
          } else if (mode === 'prop3') {
            (document.getElementById('inp-p3-a') as HTMLInputElement).value = b.dataset.a || '';
            (document.getElementById('inp-p3-b') as HTMLInputElement).value = b.dataset.b || '';
            (document.getElementById('inp-p3-c') as HTMLInputElement).value = b.dataset.c || '';
            (document.getElementById('inp-p3-d') as HTMLInputElement).value = b.dataset.d || '';
            (document.getElementById('inp-p3-e') as HTMLInputElement).value = b.dataset.e || '';
            (document.getElementById('inp-p3-f') as HTMLInputElement).value = b.dataset.f || '';
            calcProp3();
          } else if (mode === 'scale2') {
            (document.getElementById('inp-sc2-a') as HTMLInputElement).value = b.dataset.a || '';
            (document.getElementById('inp-sc2-b') as HTMLInputElement).value = b.dataset.b || '';
            (document.getElementById('sel-sc2-op') as HTMLSelectElement).value = b.dataset.op || 'divide';
            (document.getElementById('inp-sc2-factor') as HTMLInputElement).value = b.dataset.factor || '1';
            calcScale2();
          } else if (mode === 'scale3') {
            (document.getElementById('inp-sc3-a') as HTMLInputElement).value = b.dataset.a || '';
            (document.getElementById('inp-sc3-b') as HTMLInputElement).value = b.dataset.b || '';
            (document.getElementById('inp-sc3-c') as HTMLInputElement).value = b.dataset.c || '';
            (document.getElementById('sel-sc3-op') as HTMLSelectElement).value = b.dataset.op || 'multiply';
            (document.getElementById('inp-sc3-factor') as HTMLInputElement).value = b.dataset.factor || '1';
            calcScale3();
          } else if (mode === 'simplify') {
            (document.getElementById('inp-sim-a') as HTMLInputElement).value = b.dataset.a || '';
            (document.getElementById('inp-sim-b') as HTMLInputElement).value = b.dataset.b || '';
            (document.getElementById('inp-sim-c') as HTMLInputElement).value = '';
            calcSimplify();
          } else if (mode === 'aspect') {
            (document.getElementById('inp-ar-w') as HTMLInputElement).value = b.dataset.w || '1920';
            (document.getElementById('inp-ar-h') as HTMLInputElement).value = b.dataset.h || '1080';
            calcAspect();
          }
        });
      });

      // Aspect resolution quick pills
      document.querySelectorAll('.btn-res-pill').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const b = e.currentTarget as HTMLButtonElement;
          (document.getElementById('inp-ar-w') as HTMLInputElement).value = b.dataset.w || '1920';
          (document.getElementById('inp-ar-h') as HTMLInputElement).value = b.dataset.h || '1080';
          calcAspect();
        });
      });

      // Copy result button
      document.getElementById('btn-copy-result')?.addEventListener('click', () => {
        const val = document.getElementById('res-primary-val')?.textContent || '';
        const sub = document.getElementById('res-primary-sub')?.textContent || '';
        navigator.clipboard.writeText(`${val} (${sub})`).then(() => {
          const btn = document.getElementById('btn-copy-result');
          if (btn) {
            const original = btn.innerHTML;
            btn.innerHTML = '<span>✅</span> Copied!';
            setTimeout(() => { btn.innerHTML = original; }, 2000);
          }
        });
      });

      // Print button
      document.getElementById('btn-print-ratio')?.addEventListener('click', () => {
        window.print();
      });

      // Set default mode
      setMode('prop2');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</CalculatorLayout>
