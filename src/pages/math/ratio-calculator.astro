---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';


const screenResolutions = [
  { name: "480p (SD)", ratio: "3:2", w: 720, h: 480, category: "Legacy & Broadcast" },
  { name: "576p (PAL)", ratio: "5:4", w: 720, h: 576, category: "Broadcast" },
  { name: "SVGA", ratio: "4:3", w: 800, h: 600, category: "Classic PC" },
  { name: "WSVGA", ratio: "~17:10", w: 1024, h: 600, category: "Netbooks" },
  { name: "XGA", ratio: "4:3", w: 1024, h: 768, category: "Classic PC" },
  { name: "XGA+", ratio: "4:3", w: 1152, h: 864, category: "Monitors" },
  { name: "720p (HD)", ratio: "16:9", w: 1280, h: 720, category: "High Definition" },
  { name: "WXGA", ratio: "5:3", w: 1280, h: 768, category: "Displays" },
  { name: "WXGA (16:10)", ratio: "16:10", w: 1280, h: 800, category: "Laptops" },
  { name: "SXGA (UVGA)", ratio: "4:3", w: 1280, h: 960, category: "Monitors" },
  { name: "SXGA", ratio: "5:4", w: 1280, h: 1024, category: "Classic LCD" },
  { name: "HD", ratio: "~16:9", w: 1366, h: 768, category: "Budget Laptops" },
  { name: "SXGA+", ratio: "4:3", w: 1400, h: 1050, category: "Laptops" },
  { name: "WXGA+", ratio: "16:10", w: 1440, h: 900, category: "Desktop" },
  { name: "HD+", ratio: "16:9", w: 1600, h: 900, category: "Desktops" },
  { name: "UXGA", ratio: "4:3", w: 1600, h: 1200, category: "Medical / CRT" },
  { name: "WSXGA+", ratio: "16:10", w: 1680, h: 1050, category: "Widescreen" },
  { name: "1080p (FHD)", ratio: "16:9", w: 1920, h: 1080, category: "Full HD" },
  { name: "WUXGA", ratio: "16:10", w: 1920, h: 1200, category: "Professional" },
  { name: "QWXGA", ratio: "16:9", w: 2048, h: 1152, category: "Specialty" },
  { name: "WQHD (2K)", ratio: "16:9", w: 2560, h: 1440, category: "Gaming / Work" },
  { name: "WQXGA", ratio: "16:10", w: 2560, h: 1600, category: "Retina / Laptops" },
  { name: "2160p (4K UHD)", ratio: "16:9", w: 3840, h: 2160, category: "Ultra HD" },
  { name: "4320p (8K UHD)", ratio: "16:9", w: 7680, h: 4320, category: "Super Hi-Vision" },
  { name: "8640p (16K)", ratio: "16:9", w: 15360, h: 8640, category: "Next-Gen Extreme" },
];
---

<CalculatorLayout
  title="Ratio Calculator – Solve Proportions, Scale & Simplify Ratios"
  description="Free online ratio calculator to simplify ratios, solve missing proportion values (A:B = C:D, A:B:C = D:E:F), scale recipes and mixes up or down, and convert ratios to fractions with step-by-step proofs."
  category="Math"
  calculatorName="Ratio Calculator"
  slug="ratio-calculator"
  keywords={[
    "ratio calculator",
    "proportion calculator",
    "ratio solver",
    "simplify ratio calculator",
    "scale ratio calculator",
    "equivalent ratio calculator",
    "3 term ratio calculator",
    "recipe scaling calculator",
    "concrete mix ratio calculator",
    "aspect ratio calculator",
    "ratio to fraction",
    "ratio scaling calculator"
  ]}
>
  <div class="space-y-6">

    <!-- HERO HEADER & DESCRIPTION -->
    <div class="rounded-3xl border border-slate-200/90 bg-linear-to-r from-blue-50/70 via-indigo-50/40 to-white p-5 sm:p-6 shadow-xs dark:border-slate-800 dark:from-slate-900 dark:via-blue-950/20 dark:to-slate-900">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-blue-100/80 px-3 py-1 text-xs font-bold text-blue-800 dark:bg-blue-900/60 dark:text-blue-300 mb-2">
            <span>⚖️</span> Universal Proportion, Scaling &amp; Simplification Solver
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
            Ratio Calculator
          </h1>
          <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
            Simplifies ratios, solves missing proportion terms (<strong>A : B = C : D</strong> &amp; <strong>A : B : C = D : E : F</strong>), checks equivalence, scales culinary recipes or construction mixtures, and calculates aspect ratios with instant step-by-step mathematical proofs.
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2 rounded-2xl border border-slate-200/80 bg-white/90 p-3 shadow-2xs dark:border-slate-800 dark:bg-slate-950/80 text-xs">
          <span class="font-bold text-slate-700 dark:text-slate-300">Format:</span>
          <span class="rounded-lg bg-blue-50 px-2 py-1 font-semibold text-blue-700 dark:bg-blue-900/50 dark:text-blue-300">
            Decimals &amp; Fractions Allowed
          </span>
        </div>
      </div>

      <!-- QUICK PRESETS -->
      <div class="mt-4 pt-3 border-t border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="prop2" data-a="3" data-b="4" data-c="600" data-d="">📐 3 : 4 = 600 : D</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="prop3" data-a="1" data-b="2" data-c="3" data-d="" data-e="7" data-f="">🏗️ Concrete 1:2:3 (Sand = 7)</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="scale3" data-a="1" data-b="2.5" data-c="6.5" data-op="multiply" data-factor="3">🧀 Grandma's Recipe (×3 Scale)</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="scale2" data-a="250" data-b="280" data-op="divide" data-factor="2.5">📉 Shrink 250 : 280 (÷ 2.5)</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="aspect" data-w="1920" data-h="1080">📺 1920 × 1080 (16:9 Aspect)</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="simplify" data-a="24" data-b="36">✨ Simplify 24 : 36</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="prop2" data-a="5" data-b="4" data-c="" data-d="">🥗 Salad 5 : 4 Parts</button>
      </div>
    </div>

    <!-- CALCULATOR MODE SELECTOR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-2.5 dark:border-slate-800">
        <label for="mode-dropdown" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
          <span>⚙️</span> Select Calculation Mode:
        </label>
        <div class="w-full sm:w-auto">
          <select id="mode-dropdown" class="w-full sm:w-80 rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-xs font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer focus:ring-2 focus:ring-blue-500">
            <option value="prop2" selected>Solve: A:B = C:D (2-Term Proportion)</option>
            <option value="prop3">Solve: A:B:C = D:E:F (3-Term Proportion / Mix)</option>
            <option value="scale2">Scale: A:B (Grow / Shrink 2 Terms)</option>
            <option value="scale3">Scale: A:B:C (Grow / Shrink 3 Terms / Recipe)</option>
            <option value="simplify">Ratio Simplifier &amp; Fraction Converter</option>
            <option value="aspect">Aspect Ratio &amp; Screen Resolution</option>
          </select>
        </div>
      </div>

      <!-- Pill Nav Tabs for Desktop -->
      <div class="hidden md:grid grid-cols-6 gap-1.5 pt-2.5" id="mode-tab-buttons">
        <button type="button" data-mode="prop2" class="mode-tab-btn active rounded-xl border border-blue-600 bg-blue-50 px-2 py-2 text-center text-xs font-bold text-blue-700 shadow-xs dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer">
          A:B = C:D
        </button>
        <button type="button" data-mode="prop3" class="mode-tab-btn rounded-xl border border-transparent bg-slate-50 px-2 py-2 text-center text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer">
          A:B:C = D:E:F
        </button>
        <button type="button" data-mode="scale2" class="mode-tab-btn rounded-xl border border-transparent bg-slate-50 px-2 py-2 text-center text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer">
          Scale A:B
        </button>
        <button type="button" data-mode="scale3" class="mode-tab-btn rounded-xl border border-transparent bg-slate-50 px-2 py-2 text-center text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer">
          Scale A:B:C
        </button>
        <button type="button" data-mode="simplify" class="mode-tab-btn rounded-xl border border-transparent bg-slate-50 px-2 py-2 text-center text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer">
          Simplifier &amp; Parts
        </button>
        <button type="button" data-mode="aspect" class="mode-tab-btn rounded-xl border border-transparent bg-slate-50 px-2 py-2 text-center text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer">
          Aspect Ratio
        </button>
      </div>
    </div>

    <!-- MAIN INTERACTIVE FORM CARDS -->
    <div class="rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-7 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-6">

      <!-- ========================================================================= -->
      <!-- PANEL 1: PROPORTION 2-TERM (A:B = C:D) -->
      <!-- ========================================================================= -->
      <div id="panel-prop2" class="calc-panel space-y-5">
        <div class="border-b border-slate-100 pb-3 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
              <span>📐</span> Solve Proportion: A : B = C : D
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Provide any 3 values to find the missing 4th, or enter all 4 to test equivalence.
            </p>
          </div>
          <span class="text-xs font-semibold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/60 px-2.5 py-1 rounded-lg">
            Cross-Multiplication Solver
          </span>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 sm:p-6 dark:border-slate-800 dark:bg-slate-950/40">
          <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-center">
            <!-- A -->
            <div class="flex flex-col items-center">
              <label for="inp-p2-a" class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">A</label>
              <input type="text" id="inp-p2-a" value="3" placeholder="e.g. 3" class="w-20 sm:w-24 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-sm sm:text-base font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
            </div>

            <span class="text-xl sm:text-2xl font-black text-slate-400 self-end mb-2">:</span>

            <!-- B -->
            <div class="flex flex-col items-center">
              <label for="inp-p2-b" class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">B</label>
              <input type="text" id="inp-p2-b" value="4" placeholder="e.g. 4" class="w-20 sm:w-24 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-sm sm:text-base font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
            </div>

            <span class="text-xl sm:text-2xl font-black text-blue-600 dark:text-blue-400 self-end mb-2">=</span>

            <!-- C -->
            <div class="flex flex-col items-center">
              <label for="inp-p2-c" class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">C</label>
              <input type="text" id="inp-p2-c" value="600" placeholder="e.g. 600" class="w-20 sm:w-24 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-sm sm:text-base font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
            </div>

            <span class="text-xl sm:text-2xl font-black text-slate-400 self-end mb-2">:</span>

            <!-- D -->
            <div class="flex flex-col items-center">
              <label for="inp-p2-d" class="text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">D (Missing)</label>
              <input type="text" id="inp-p2-d" value="" placeholder="Leave blank" class="w-20 sm:w-24 rounded-xl border-2 border-dashed border-blue-400 bg-white p-2.5 text-center text-sm sm:text-base font-bold text-blue-700 shadow-2xs dark:border-blue-600 dark:bg-slate-900 dark:text-blue-300" />
            </div>
          </div>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <button type="button" id="btn-calc-prop2" class="flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition cursor-pointer">
              <span>Calculate</span> <span>▶</span>
            </button>
            <button type="button" id="btn-clear-prop2" class="rounded-xl bg-slate-200 px-5 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition cursor-pointer">
              Clear
            </button>
          </div>
        </div>
      </div>

      <!-- ========================================================================= -->
      <!-- PANEL 2: PROPORTION 3-TERM (A:B:C = D:E:F) -->
      <!-- ========================================================================= -->
      <div id="panel-prop3" class="calc-panel hidden space-y-5">
        <div class="border-b border-slate-100 pb-3 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
              <span>🏗️</span> 3-Term Ratio: A : B : C = D : E : F
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Ideal for concrete mixes (cement:sand:gravel) and multi-ingredient culinary scaling.
            </p>
          </div>
          <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-1 rounded-lg">
            Multi-Term Mix Solver
          </span>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 sm:p-6 dark:border-slate-800 dark:bg-slate-950/40 space-y-4">
          <!-- Reference Ratio Row -->
          <div class="text-center">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-2">Base Reference Ratio (A : B : C)</span>
            <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
              <input type="text" id="inp-p3-a" value="1" placeholder="A" class="w-18 sm:w-20 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              <span class="text-lg font-bold text-slate-400">:</span>
              <input type="text" id="inp-p3-b" value="2" placeholder="B" class="w-18 sm:w-20 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              <span class="text-lg font-bold text-slate-400">:</span>
              <input type="text" id="inp-p3-c" value="3" placeholder="C" class="w-18 sm:w-20 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
            </div>
          </div>

          <!-- Equals divider -->
          <div class="flex items-center justify-center gap-2 text-blue-600 dark:text-blue-400 font-black text-xl">
            <span>=</span>
          </div>

          <!-- Target Ratio Row -->
          <div class="text-center">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-2">Target Quantities (D : E : F) &mdash; Enter at least one known value</span>
            <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
              <input type="text" id="inp-p3-d" value="" placeholder="D" class="w-18 sm:w-20 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              <span class="text-lg font-bold text-slate-400">:</span>
              <input type="text" id="inp-p3-e" value="7" placeholder="E" class="w-18 sm:w-20 rounded-xl border-2 border-emerald-500 bg-white p-2 text-center text-sm font-bold text-emerald-700 shadow-2xs dark:border-emerald-600 dark:bg-slate-900 dark:text-emerald-300" />
              <span class="text-lg font-bold text-slate-400">:</span>
              <input type="text" id="inp-p3-f" value="" placeholder="F" class="w-18 sm:w-20 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
            </div>
          </div>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <button type="button" id="btn-calc-prop3" class="flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition cursor-pointer">
              <span>Calculate</span> <span>▶</span>
            </button>
            <button type="button" id="btn-clear-prop3" class="rounded-xl bg-slate-200 px-5 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition cursor-pointer">
              Clear
            </button>
          </div>
        </div>
      </div>

      <!-- ========================================================================= -->
      <!-- PANEL 3: SCALE 2-TERM RATIO (SCALE A:B) -->
      <!-- ========================================================================= -->
      <div id="panel-scale2" class="calc-panel hidden space-y-5">
        <div class="border-b border-slate-100 pb-3 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
              <span>📈</span> Scale Ratio: A : B
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Grow (multiply) or shrink (divide) a ratio by a specific scale factor.
            </p>
          </div>
          <span class="text-xs font-semibold text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-950/60 px-2.5 py-1 rounded-lg">
            Ratio Scaler
          </span>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 sm:p-6 dark:border-slate-800 dark:bg-slate-950/40">
          <div class="flex flex-wrap items-center justify-center gap-3 text-center">
            <input type="text" id="inp-sc2-a" value="250" placeholder="A" class="w-20 sm:w-24 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-sm sm:text-base font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
            <span class="text-xl font-black text-slate-400">:</span>
            <input type="text" id="inp-sc2-b" value="280" placeholder="B" class="w-20 sm:w-24 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-sm sm:text-base font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />

            <div class="flex items-center gap-1.5 ml-2">
              <select id="sel-sc2-op" class="rounded-xl border border-slate-300 bg-white px-2.5 py-2 text-xs font-bold text-slate-800 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                <option value="multiply">Grow (Multiply ×)</option>
                <option value="divide" selected>Shrink (Divide ÷)</option>
              </select>
              <input type="text" id="inp-sc2-factor" value="2.5" placeholder="Factor" class="w-18 sm:w-20 rounded-xl border border-slate-300 bg-white p-2 text-center text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              <span class="text-xs font-semibold text-slate-600 dark:text-slate-400">times</span>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <button type="button" id="btn-calc-scale2" class="flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition cursor-pointer">
              <span>Calculate</span> <span>▶</span>
