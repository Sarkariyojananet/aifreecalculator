---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us - AI Free Calculator"
  description="Get in touch with the AI Free Calculator team. Submit feedback, report calculation bugs, request new custom calculators, or discuss partnerships directly with support@aifreecalculator.com."
>
  <!-- Hero Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-slate-50 via-white to-slate-50 px-4 py-16 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1 text-xs font-bold text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/50 dark:text-blue-300 shadow-xs">
        <span>💬</span> We’d Love to Hear From You
      </div>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Contact &amp; Support Desk
      </h1>
      <p class="mt-4 text-base font-normal text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        Have a question, noticed a formula discrepancy, or want to request a new custom calculator? Send a message directly to our engineering desk at <strong class="text-blue-600 dark:text-blue-400 font-semibold">support@aifreecalculator.com</strong>.
      </p>
    </div>
  </div>

  <main class="mx-auto max-w-5xl px-4 py-12 sm:py-16 space-y-16">
    
    <!-- Quick Contact Cards Grid -->
    <div class="grid gap-5 sm:grid-cols-3">
      
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl text-blue-600 dark:bg-blue-950 dark:text-blue-400">
          💡
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">Request a Calculator</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Need a specific civil formula, financial model, or metric tool added? Tell us and our engineering team will build it.
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600 dark:bg-amber-950 dark:text-amber-400">
          🐛
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">Report a Bug / Math Fix</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Found a calculation error or UI glitch? Share the parameters and we will investigate and patch it immediately.
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400">
          🤝
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">Partnership &amp; Media</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Interested in API integrations, ad sponsorships, or referencing our tools in publications and academic materials?
        </p>
      </div>

    </div>

    <!-- Main Contact Form + Details Section -->
    <div class="grid gap-10 lg:grid-cols-12 items-start">
      
      <!-- Contact Info Sidebar (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/60 space-y-5">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white text-sm">Official Support Email</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Our support inbox is monitored every day:</p>
            <div class="mt-2.5 flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-800">
              <a href="mailto:support@aifreecalculator.com" class="font-mono text-xs font-bold text-blue-600 hover:underline dark:text-blue-400 truncate">
                support@aifreecalculator.com
              </a>
              <button
                type="button"
                id="btn-copy-email"
                class="shrink-0 rounded-lg bg-slate-100 px-2 py-1 text-[11px] font-bold text-slate-700 hover:bg-blue-600 hover:text-white transition cursor-pointer dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-blue-600"
                title="Copy email to clipboard"
              >
                Copy
              </button>
            </div>
          </div>

          <div class="border-t border-slate-200 pt-4 dark:border-slate-800">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm">Response Time</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
              We strive to respond to all inquiries and feedback within <strong>24 to 48 business hours</strong>.
            </p>
          </div>

          <div class="border-t border-slate-200 pt-4 dark:border-slate-800">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm">Direct Mail Client</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
              Prefer writing from your favorite email software? Click below to compose directly:
            </p>
            <a
              href="mailto:support@aifreecalculator.com?subject=AI%20Free%20Calculator%20Inquiry"
              class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 hover:underline dark:text-blue-400"
            >
              <span>✉️</span> Open in Default Email Client →
            </a>
          </div>
        </div>

        <div class="rounded-3xl border border-blue-200 bg-blue-50/60 p-5 dark:border-blue-900/50 dark:bg-blue-950/30 text-xs leading-relaxed text-blue-900 dark:text-blue-300">
          <strong>🔒 Privacy Guarantee:</strong> We never share or sell your email address. It is used strictly to answer your inquiry.
        </div>
      </div>

      <!-- Contact Form (8 Cols) -->
      <div class="lg:col-span-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <form id="contact-form" class="space-y-6" novalidate>
          
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Your Full Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="e.g. Alex Sharma"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="e.g. alex@example.com"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="contact-category" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Inquiry Topic <span class="text-red-500">*</span>
              </label>
              <select
                id="contact-category"
                name="category"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-medium text-slate-900 outline-none transition focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              >
                <option value="Calculator Request">Request a New Calculator</option>
                <option value="Bug Report">Report Math Discrepancy / Bug</option>
                <option value="General Feedback">General Feedback &amp; Suggestion</option>
                <option value="Partnership">Business &amp; Advertising Inquiry</option>
                <option value="Other">Other Inquiry</option>
              </select>
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Subject <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-subject"
                name="subject"
                required
                placeholder="e.g. Question about RCC Slab Calculator"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>
          </div>

          <!-- Anti-Spam Honeypot Field (Safely hidden from humans and autofill) -->
          <input
            type="text"
            id="website_url_check"
            name="website_url_check"
            tabindex="-1"
            autocomplete="new-password"
            aria-hidden="true"
            style="display:none !important; position:absolute; left:-9999px; width:0; height:0;"
          />

          <div>
            <label for="contact-message" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Your Message / Details <span class="text-red-500">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Describe your suggestion, formula details, or question with as much detail as possible..."
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-3 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            ></textarea>
          </div>

          <div id="contact-status-msg" class="hidden rounded-xl p-3.5 text-xs font-semibold" role="alert"></div>

          <button
            type="submit"
            id="btn-submit-contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-8 py-3 text-xs font-bold text-white shadow-md shadow-blue-500/20 hover:bg-blue-700 active:scale-[0.98] transition cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span>📨</span>
            <span id="btn-submit-text">Send Message to Support Desk</span>
          </button>
        </form>
      </div>

    </div>

    <!-- Frequently Asked Questions Accordion -->
    <section class="space-y-6 border-t border-slate-200 pt-12 dark:border-slate-800">
      <div class="text-center max-w-2xl mx-auto space-y-1.5">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white sm:text-2xl">
          Frequently Asked Questions
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Quick answers to common questions about AI Free Calculator tools.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 text-xs leading-relaxed">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <h3 class="font-bold text-slate-900 dark:text-white">Are all 42+ calculators completely free?</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Yes, 100%. Every single calculator is free to use with unlimited calculations and no registration or subscription requirements.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <h3 class="font-bold text-slate-900 dark:text-white">Is my financial data saved anywhere?</h3>
          <p class="text-slate-600 dark:text-slate-400">
            No. All math computations run locally inside your browser using client-side JavaScript. We never store or transmit your financial calculations.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <h3 class="font-bold text-slate-900 dark:text-white">Can I request a custom calculation tool?</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Absolutely. Submit your requested formula or parameters via the form above and our developers will review and add it to the platform.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <h3 class="font-bold text-slate-900 dark:text-white">How accurate are the construction and tax formulas?</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Our algorithms follow standard building codes (IS / ASTM) and official tax slabs, though certified professional consultation is always recommended for binding legal and construction decisions.
          </p>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script is:inline>
  // Copy Email Button
  const btnCopy = document.getElementById('btn-copy-email');
  btnCopy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('support@aifreecalculator.com');
      const originalText = btnCopy.textContent;
      btnCopy.textContent = 'Copied! ✓';
      btnCopy.classList.add('bg-emerald-600', 'text-white');
      setTimeout(() => {
        btnCopy.textContent = originalText;
        btnCopy.classList.remove('bg-emerald-600', 'text-white');
      }, 2000);
    } catch {
      prompt('Copy email:', 'support@aifreecalculator.com');
    }
  });

  // Form Submission
  const contactForm = document.getElementById('contact-form');
  const statusMsg   = document.getElementById('contact-status-msg');
  const btnSubmit   = document.getElementById('btn-submit-contact');
  const btnText     = document.getElementById('btn-submit-text');

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('contact-name')?.value.trim();
    const email = document.getElementById('contact-email')?.value.trim();
    const category = document.getElementById('contact-category')?.value;
    const subject = document.getElementById('contact-subject')?.value.trim();
    const message = document.getElementById('contact-message')?.value.trim();
    const honeypot = document.getElementById('website_url_check')?.value.trim();

    if (!name || !email || !subject || !message) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3.5 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300';
        statusMsg.textContent = 'Please fill out all required fields before submitting.';
        statusMsg.classList.remove('hidden');
      }
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3.5 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300';
        statusMsg.textContent = 'Please enter a valid email address.';
        statusMsg.classList.remove('hidden');
      }
      return;
    }

    if (btnSubmit) btnSubmit.disabled = true;
    if (btnText) btnText.textContent = 'Sending to support@aifreecalculator.com...';
    if (statusMsg) {
      statusMsg.className = 'rounded-xl p-3.5 text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300';
      statusMsg.textContent = 'Delivering your message to our support desk...';
      statusMsg.classList.remove('hidden');
    }

    let isSuccess = false;
    let refId = `msg_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;

    // 1. Primary Attempt: Internal Contact API
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          category,
          subject,
          message,
          website_url_check: honeypot,
        }),
      });

      if (res.ok) {
        const data = await res.json().catch(() => ({}));
        if (data && data.success) {
          isSuccess = true;
          if (data.messageId) refId = data.messageId;
        }
      }
    } catch (apiErr) {
      console.warn('API route fallback:', apiErr);
    }

    // 2. Secondary Direct Fallback: Client-Side FormSubmit Relay to support@aifreecalculator.com
    if (!isSuccess) {
      try {
        const fsRes = await fetch('https://formsubmit.co/ajax/support@aifreecalculator.com', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({
            name,
            email,
            _subject: `[AIFreeCalculator] ${subject} (${category})`,
            _replyto: email,
            category,
            subject,
            message,
            ref_id: refId,
            _template: 'table',
          }),
        });

        if (fsRes.ok) {
          const fsData = await fsRes.json().catch(() => null);
          if (fsData && (fsData.success === 'true' || fsData.success === true || fsData.message)) {
            isSuccess = true;
          }
        }
      } catch (fsErr) {
        console.warn('FormSubmit client fallback failed:', fsErr);
      }
    }

    // Render Result
    if (isSuccess) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-4 text-xs font-semibold bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 space-y-1.5';
        statusMsg.innerHTML = `
          <div class="font-bold text-sm flex items-center gap-1.5">
            <span>✅</span> Message Delivered Successfully!
          </div>
          <div>Thank you, <strong>${name}</strong>. Your inquiry regarding "<em>${subject}</em>" has been submitted directly to <strong>support@aifreecalculator.com</strong>. Our team will review and reply to <strong>${email}</strong> within 24-48 hours.</div>
          <div class="text-[11px] opacity-80 mt-1 font-mono">Reference ID: ${refId}</div>
        `;
        statusMsg.classList.remove('hidden');
      }
      contactForm.reset();
      if (btnText) btnText.textContent = 'Message Sent ✓';
      setTimeout(() => {
        if (btnSubmit) btnSubmit.disabled = false;
        if (btnText) btnText.textContent = 'Send Another Message';
      }, 2000);
    } else {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-4 text-xs font-semibold bg-amber-50 text-amber-900 dark:bg-amber-950/50 dark:text-amber-300 space-y-2';
        statusMsg.innerHTML = `
          <div><strong>Notice:</strong> Network delivery could not be verified automatically.</div>
          <div>Please click below to send your email directly:</div>
          <a
            href="mailto:support@aifreecalculator.com?subject=${encodeURIComponent(subject || 'Inquiry')}&body=${encodeURIComponent(`Name: ${name}\nEmail: ${email}\nCategory: ${category}\n\nMessage:\n${message}`)}"
            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-3 py-2 text-xs font-bold text-white hover:bg-blue-700 transition"
          >
            <span>✉️</span> Click to Send via Email App (support@aifreecalculator.com)
          </a>
        `;
        statusMsg.classList.remove('hidden');
      }
      if (btnSubmit) btnSubmit.disabled = false;
      if (btnText) btnText.textContent = 'Try Again';
    }
  });
</script>
