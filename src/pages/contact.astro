---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us - AI Free Calculator"
  description="Get in touch with the AI Free Calculator team. Submit feedback, report calculation bugs, request new custom calculators, or discuss partnerships."
>
  <!-- Hero Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-slate-50 via-white to-slate-50 px-4 py-16 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1 text-xs font-bold text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/50 dark:text-blue-300 shadow-xs">
        <span>💬</span> We’d Love to Hear From You
      </div>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Contact &amp; Support
      </h1>
      <p class="mt-4 text-base font-normal text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        Have a question, noticed a formula discrepancy, or want to suggest a new calculator? Reach out directly to our engineering and support team.
      </p>
    </div>
  </div>

  <main class="mx-auto max-w-5xl px-4 py-12 sm:py-16 space-y-16">
    
    <!-- Quick Contact Cards Grid -->
    <div class="grid gap-5 sm:grid-cols-3">
      
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl text-blue-600 dark:bg-blue-950 dark:text-blue-400">
          💡
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">Request a Calculator</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Need a specific civil formula, financial model, or metric tool added? Tell us and we will build it.
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600 dark:bg-amber-950 dark:text-amber-400">
          🐛
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">Report a Bug / Math Fix</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Found a calculation error or UI glitch? Share the details and our team will patch it immediately.
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400">
          🤝
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">Partnership &amp; Media</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Interested in API integrations, ad partnerships, or referencing our tools in publications?
        </p>
      </div>

    </div>

    <!-- Main Contact Form + Details Section -->
    <div class="grid gap-10 lg:grid-cols-12 items-start">
      
      <!-- Contact Info Sidebar (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/60 space-y-5">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white text-sm">Direct Email</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Our support inbox is monitored daily:</p>
            <a href="mailto:support@aifreecalculator.com" class="mt-2 block font-mono text-xs font-bold text-blue-600 hover:underline dark:text-blue-400">
              support@aifreecalculator.com
            </a>
          </div>

          <div class="border-t border-slate-200 pt-4 dark:border-slate-800">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm">Response Time</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
              We strive to respond to all inquiries and feedback within <strong>24 to 48 business hours</strong>.
            </p>
          </div>

          <div class="border-t border-slate-200 pt-4 dark:border-slate-800">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm">Open Feedback</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
              Have GitHub issues or feature tickets? You can also report issues at our project repository.
            </p>
          </div>
        </div>

        <div class="rounded-3xl border border-blue-200 bg-blue-50/60 p-5 dark:border-blue-900/50 dark:bg-blue-950/30 text-xs leading-relaxed text-blue-900 dark:text-blue-300">
          <strong>🔒 Privacy Guarantee:</strong> We never share or sell your email address. It is used solely to respond to your support request.
        </div>
      </div>

      <!-- Contact Form (8 Cols) -->
      <div class="lg:col-span-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <form id="contact-form" class="space-y-6" novalidate>
          
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Your Full Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                required
                placeholder="e.g. Alex Sharma"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                required
                placeholder="e.g. alex@example.com"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="contact-category" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Inquiry Topic <span class="text-red-500">*</span>
              </label>
              <select
                id="contact-category"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-medium text-slate-900 outline-none transition focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              >
                <option value="calculator_request">Request a New Calculator</option>
                <option value="bug_report">Report Math Discrepancy / Bug</option>
                <option value="feedback">General Feedback &amp; Suggestion</option>
                <option value="partnership">Business &amp; Advertising Inquiry</option>
                <option value="other">Other Inquiry</option>
              </select>
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Subject <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-subject"
                required
                placeholder="e.g. New RCC Beam Shear Rebar Calculator"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Your Message / Details <span class="text-red-500">*</span>
            </label>
            <textarea
              id="contact-message"
              rows="5"
              required
              placeholder="Describe your suggestion, formula details, or question with as much detail as possible..."
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-3 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            ></textarea>
          </div>

          <div id="contact-status-msg" class="hidden rounded-xl p-3 text-xs font-semibold" role="alert"></div>

          <button
            type="submit"
            id="btn-submit-contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-8 py-3 text-xs font-bold text-white shadow-md shadow-blue-500/20 hover:bg-blue-700 active:scale-[0.98] transition cursor-pointer"
          >
            <span>📨</span>
            <span id="btn-submit-text">Send Message</span>
          </button>
        </form>
      </div>

    </div>

    <!-- Frequently Asked Questions Accordion -->
    <section class="space-y-6 border-t border-slate-200 pt-12 dark:border-slate-800">
      <div class="text-center max-w-2xl mx-auto space-y-1.5">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white sm:text-2xl">
          Frequently Asked Questions
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Quick answers to common questions about AI Free Calculator tools.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 text-xs leading-relaxed">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <h3 class="font-bold text-slate-900 dark:text-white">Are all 42+ calculators completely free?</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Yes, 100%. Every single calculator is free to use with unlimited calculations and no subscription requirements.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <h3 class="font-bold text-slate-900 dark:text-white">Is my financial data saved anywhere?</h3>
          <p class="text-slate-600 dark:text-slate-400">
            No. All math runs locally inside your browser using client-side JavaScript. We never store or transmit your calculations.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <h3 class="font-bold text-slate-900 dark:text-white">Can I request a custom calculation tool?</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Absolutely. Submit your requested formula or parameters via the form above and our developers will review and add it.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <h3 class="font-bold text-slate-900 dark:text-white">How accurate are the construction and tax formulas?</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Our algorithms follow standard building codes (IS / ASTM) and official tax brackets, though certified professional consultation is always recommended for binding projects.
          </p>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const statusMsg   = document.getElementById('contact-status-msg');
  const btnSubmit   = document.getElementById('btn-submit-contact');
  const btnText     = document.getElementById('btn-submit-text');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('contact-name')?.value.trim();
    const email = document.getElementById('contact-email')?.value.trim();
    const subject = document.getElementById('contact-subject')?.value.trim();
    const message = document.getElementById('contact-message')?.value.trim();

    if (!name || !email || !subject || !message) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300';
        statusMsg.textContent = 'Please fill out all required fields before submitting.';
        statusMsg.classList.remove('hidden');
      }
      return;
    }

    if (btnSubmit) btnSubmit.disabled = true;
    if (btnText) btnText.textContent = 'Sending...';

    setTimeout(() => {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-4 text-xs font-semibold bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 space-y-1';
        statusMsg.innerHTML = `
          <div class="font-bold text-sm flex items-center gap-1.5">
            <span>✅</span> Message Received!
          </div>
          <div>Thank you, <strong>${name}</strong>. Your inquiry regarding "<em>${subject}</em>" has been submitted. Our team will review and reply to <strong>${email}</strong> within 24-48 hours.</div>
        `;
        statusMsg.classList.remove('hidden');
      }
      contactForm.reset();
      if (btnSubmit) btnSubmit.disabled = false;
      if (btnText) btnText.textContent = 'Send Another Message';
    }, 600);
  });
</script>
