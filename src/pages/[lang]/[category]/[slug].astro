---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import { getTranslatedCalculatorStaticPaths } from '../../../i18n/registry';
import type { Locale } from '../../../i18n/config';
import type { CalculatorTranslation } from '../../../i18n/types';

import BmiEngine from '../../../components/calculators/BmiEngine.astro';
import EmiEngine from '../../../components/calculators/EmiEngine.astro';
import SipEngine from '../../../components/calculators/SipEngine.astro';
import AgeEngine from '../../../components/calculators/AgeEngine.astro';
import CalorieEngine from '../../../components/calculators/CalorieEngine.astro';
import RccSlabEngine from '../../../components/calculators/RccSlabEngine.astro';

export function getStaticPaths() {
  return getTranslatedCalculatorStaticPaths();
}

interface Props {
  lang: Locale;
  category: string;
  slug: string;
  calculator: any;
  translation: CalculatorTranslation;
}

const { lang, category, slug, calculator, translation } = Astro.props;

// Build Schema.org FAQPage structured data
const faqSchema = translation.faqs && translation.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: translation.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;
---

<CalculatorLayout
  title={translation.metaTitle}
  description={translation.metaDescription}
  category={calculator.category}
  calculatorName={translation.name}
  slug={slug}
  lang={lang}
>
  {faqSchema && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </Fragment>
  )}

  <div class="space-y-8">
    <!-- 1. Interactive Calculation Tool Card -->
    <div class="calculator-engine-wrapper">
      {slug === 'bmi-calculator' && <BmiEngine lang={lang} ui={translation.ui} />}
      {slug === 'emi-calculator' && <EmiEngine lang={lang} ui={translation.ui} />}
      {slug === 'sip-calculator' && <SipEngine lang={lang} ui={translation.ui} />}
      {slug === 'age-calculator' && <AgeEngine lang={lang} ui={translation.ui} />}
      {slug === 'calorie-calculator' && <CalorieEngine lang={lang} ui={translation.ui} />}
      {slug === 'rcc-slab-steel-calculator' && <RccSlabEngine lang={lang} ui={translation.ui} />}
    </div>

    <!-- 2. Formula & Mathematical Methodology -->
    {translation.formulaEquation && (
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-bold tracking-wider text-blue-700 dark:border-blue-900/50 dark:bg-blue-950/60 dark:text-blue-400 mb-3">
          <span>📐</span>
          <span>FORMULA & CALCULATION METHOD</span>
        </div>

        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
          {translation.formulaTitle}
        </h2>

        {translation.formulaDescription && (
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {translation.formulaDescription}
          </p>
        )}

        <!-- Formula Equation Highlight Box -->
        <div class="mt-4 rounded-2xl border border-blue-100 bg-linear-to-r from-blue-50 via-indigo-50 to-blue-50 p-4 sm:p-5 text-center dark:border-blue-900/40 dark:from-slate-950 dark:via-blue-950/30 dark:to-slate-950">
          <div class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-1">
            Mathematical Equation
          </div>
          <code class="font-mono text-base sm:text-lg font-black text-blue-900 dark:text-blue-200">
            {translation.formulaEquation}
          </code>
        </div>

        <!-- Variables Breakdown Table -->
        {translation.variables && translation.variables.length > 0 && (
          <div class="mt-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3">
              Variables & Definitions
            </h3>
            <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
              <table class="min-w-full divide-y divide-slate-200 text-left text-xs dark:divide-slate-800">
                <thead class="bg-slate-50 dark:bg-slate-800/60 font-bold text-slate-700 dark:text-slate-300">
                  <tr>
                    <th scope="col" class="px-4 py-3">Symbol</th>
                    <th scope="col" class="px-4 py-3">Variable</th>
                    <th scope="col" class="px-4 py-3">Description</th>
                    <th scope="col" class="px-4 py-3">Unit</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-900">
                  {translation.variables.map((v) => (
                    <tr>
                      <td class="px-4 py-3 font-mono font-bold text-blue-600 dark:text-blue-400">{v.symbol}</td>
                      <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">{v.label}</td>
                      <td class="px-4 py-3 text-slate-600 dark:text-slate-400">{v.description}</td>
                      <td class="px-4 py-3 font-mono text-slate-500 dark:text-slate-400">{v.unit}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </section>
    )}

    <!-- 3. Step-by-Step Instructions -->
    {translation.stepByStep && translation.stepByStep.length > 0 && (
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-6">
          How to Calculate: Step-by-Step Instructions
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {translation.stepByStep.map((step) => (
            <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-800/40">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-blue-600 font-bold text-sm text-white shadow-xs">
                {step.stepNumber}
              </span>
              <div>
                <h3 class="font-bold text-sm text-slate-900 dark:text-white">
                  {step.title}
                </h3>
                <p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                  {step.instruction}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 4. Worked Real-World Example -->
    {translation.workedExample && (
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-bold tracking-wider text-emerald-700 dark:border-emerald-900/50 dark:bg-emerald-950/60 dark:text-emerald-400 mb-3">
          <span>💡</span>
          <span>PRACTICAL WORKED EXAMPLE</span>
        </div>

        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
          {translation.workedExample.title}
        </h2>

        <div class="mt-4 space-y-3 rounded-2xl border border-emerald-100 bg-emerald-50/40 p-5 dark:border-emerald-900/40 dark:bg-emerald-950/20 text-xs sm:text-sm">
          <div>
            <strong class="text-slate-900 dark:text-white">Scenario:</strong>
            <span class="text-slate-600 dark:text-slate-300 ml-1">{translation.workedExample.scenario}</span>
          </div>
          <div>
            <strong class="text-slate-900 dark:text-white">Calculation:</strong>
            <div class="mt-1 rounded-xl bg-white p-3 font-mono text-xs font-semibold text-slate-800 dark:bg-slate-900 dark:text-slate-200 border border-emerald-200/60 dark:border-emerald-900/40">
              {translation.workedExample.calculation}
            </div>
          </div>
          <div class="pt-1">
            <strong class="text-slate-900 dark:text-white">Final Result:</strong>
            <span class="font-bold text-emerald-700 dark:text-emerald-400 ml-1">{translation.workedExample.result}</span>
          </div>
        </div>
      </section>
    )}

    <!-- 5. Frequently Asked Questions (FAQ) -->
    {translation.faqs && translation.faqs.length > 0 && (
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-6">
          Frequently Asked Questions
        </h2>

        <div class="space-y-4">
          {translation.faqs.map((faq) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-5 dark:border-slate-800 dark:bg-slate-800/30">
              <h3 class="font-bold text-sm text-slate-900 dark:text-white">
                {faq.question}
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</CalculatorLayout>
