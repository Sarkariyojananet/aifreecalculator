---
import { getTranslatedCalculatorStaticPaths, isCalculatorTranslated } from '../../../i18n/registry';
import { getLocalizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';

export function getStaticPaths() {
  return getTranslatedCalculatorStaticPaths();
}

const { lang, category, slug } = Astro.params as { lang: Locale; category: string; slug: string };

// Guard against untranslated requests (returns 404)
if (lang !== 'en' && !isCalculatorTranslated(slug, lang)) {
  return Astro.redirect(getLocalizedPath('/404/', lang));
}

// Known 301 redirect calculators
if (category === 'general' && slug === 'percentage-calculator') {
  return Astro.redirect(getLocalizedPath('/math/percentage-calculator/', lang), 301);
}
if (slug === 'date-difference-calculator') {
  return Astro.redirect(getLocalizedPath('/general/time-calculator/', lang), 301);
}
if (slug === 'standard-deviation-calculator') {
  return Astro.redirect(getLocalizedPath('/math/scientific-calculator/', lang), 301);
}
if (category === 'free-online-tools') {
  const pdfSlugs = ['pdf-merge', 'pdf-split', 'pdf-compress', 'pdf-to-image', 'image-to-pdf'];
  if (pdfSlugs.includes(slug)) {
    return Astro.redirect(getLocalizedPath(`/pdf-tools/${slug}/`, lang), 301);
  }
}
if (category === 'image-tools') {
  const imageSlugs = ['image-compressor', 'image-resizer', 'jpg-to-png', 'png-to-jpg'];
  if (imageSlugs.includes(slug)) {
    return Astro.redirect(getLocalizedPath(`/free-online-tools/${slug}/`, lang), 301);
  }
}
if (category === 'time-table-tools') {
  const timetableRedirectMap: Record<string, string> = {
    'exam-timetable-maker': 'study-timetable-maker',
    'student-timetable-maker': 'study-timetable-maker',
    'school-timetable-maker': 'study-timetable-maker',
    'college-timetable-maker': 'study-timetable-maker',
    'university-timetable-maker': 'study-timetable-maker',
    'class-timetable-generator': 'study-timetable-maker',
    'class-schedule-maker': 'study-timetable-maker',
    'teacher-timetable-maker': 'study-timetable-maker',
    'kids-timetable-maker': 'daily-timetable-maker',
    'kids-daily-routine-planner': 'daily-timetable-maker',
    'boys-daily-routine-planner': 'daily-timetable-maker',
    'girls-daily-routine-planner': 'daily-timetable-maker',
    'personal-timetable-maker': 'daily-timetable-maker',
    'home-routine-planner': 'weekly-timetable-maker',
    'employee-work-timetable': 'work-shift-schedule-maker',
    'printable-timetable-maker': 'timetable-maker',
    'smart-timetable-generator': 'timetable-maker',
  };
  if (timetableRedirectMap[slug]) {
    return Astro.redirect(getLocalizedPath(`/time-table-tools/${timetableRedirectMap[slug]}/`, lang), 301);
  }
}

const calculatorModules = import.meta.glob<any>('../../**/*.astro');
const directKey = `../../${category}/${slug}.astro`;
const fallbackKey = `../../free-online-tools/${slug}.astro`;
const loader = calculatorModules[directKey] || calculatorModules[fallbackKey];

if (!loader) {
  return Astro.redirect(getLocalizedPath('/404/', lang));
}

const mod = await loader();
const CalculatorComponent = mod.default;
---

<CalculatorComponent />
