---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslatedStaticPagePaths } from '../../i18n/registry';
import { categories, calculators } from '../../data/calculators';
import { getLocalizedPath } from '../../i18n/utils';
import { getCommonTranslations } from '../../i18n/translations/common';
import type { Locale } from '../../i18n/config';

export function getStaticPaths() {
  return getTranslatedStaticPagePaths('about');
}

const { lang } = Astro.params as { lang: Locale };
const { pageData } = Astro.props;
const tCommon = getCommonTranslations(lang);
---

<BaseLayout
  title={`${pageData.metaTitle} | AI Free Calculator`}
  description={pageData.metaDescription}
  lang={lang}
>
  <!-- Hero Section -->
  <div class="border-b border-slate-200 bg-linear-to-b from-blue-50/50 via-white to-slate-50 px-4 py-16 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-24">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Breadcrumb -->
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', lang)} class="hover:text-blue-600 dark:hover:text-blue-400">
          {tCommon.nav.home}
        </a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">{pageData.name}</span>
      </nav>

      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1 text-xs font-bold text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/50 dark:text-blue-300 shadow-xs">
        <span>🚀</span> Accurate • Instant • 100% Free
      </div>

      <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
        {pageData.h1}
      </h1>

      <p class="mt-6 text-base font-normal leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl mx-auto sm:text-lg">
        {pageData.intro}
      </p>

      <!-- Key KPI Stats -->
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 max-w-3xl mx-auto">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/90">
          <div class="text-3xl font-black text-blue-600 dark:text-blue-400">{calculators.length}+</div>
          <div class="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">Active Tools</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/90">
          <div class="text-3xl font-black text-emerald-600 dark:text-emerald-400">{categories.length}</div>
          <div class="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">Categories</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/90">
          <div class="text-3xl font-black text-indigo-600 dark:text-indigo-400">100%</div>
          <div class="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">Free Access</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/90">
          <div class="text-3xl font-black text-amber-600 dark:text-amber-400">0</div>
          <div class="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">Signups</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Sections -->
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8 space-y-8">
    {pageData.missionTitle && (
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-2xl">
          {pageData.missionTitle}
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
          {pageData.missionBody}
        </p>
      </section>
    )}

    {pageData.privacyTitle && (
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-2xl">
          {pageData.privacyTitle}
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
          {pageData.privacyBody}
        </p>
      </section>
    )}

    {pageData.sections?.map((sec: any) => (
      <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-2xl">
          {sec.title}
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
          {sec.content}
        </p>
      </section>
    ))}
  </div>
</BaseLayout>
