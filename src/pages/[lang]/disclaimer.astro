---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslatedStaticPagePaths } from '../../i18n/registry';
import { getLocalizedPath } from '../../i18n/utils';
import { COMMON_TRANSLATIONS } from '../../i18n/translations/common';
import type { Locale } from '../../i18n/config';

export function getStaticPaths() {
  return getTranslatedStaticPagePaths('disclaimer');
}

const { lang } = Astro.params as { lang: Locale };
const { pageData } = Astro.props;
const tCommon = COMMON_TRANSLATIONS[lang] || COMMON_TRANSLATIONS.en;
---

<BaseLayout
  title={`${pageData.metaTitle} | AI Free Calculator`}
  description={pageData.metaDescription}
  lang={lang}
>
  <div class="border-b border-slate-200 bg-linear-to-b from-slate-50 via-white to-white px-4 py-12 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-16">
    <div class="mx-auto max-w-4xl text-center">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', lang)} class="hover:text-blue-600 dark:hover:text-blue-400">
          {tCommon.nav.home}
        </a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">{pageData.name}</span>
      </nav>

      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        {pageData.h1}
      </h1>

      <p class="mt-4 text-sm text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        {pageData.intro}
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 space-y-8">
    {pageData.sections?.map((sec: any) => (
      <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white sm:text-xl">
          {sec.title}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          {sec.content}
        </p>
      </div>
    ))}
  </div>
</BaseLayout>
