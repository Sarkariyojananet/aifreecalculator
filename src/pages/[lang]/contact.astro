---

<BaseLayout
  title={`${pageData.metaTitle} | AI Free Calculator`}
  description={pageData.metaDescription}
  lang={lang}
>
  <!-- Hero Header -->
  <div class="border-b border-slate-200 bg-linear-to-b from-blue-50/50 via-white to-slate-50 px-4 py-14 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', lang)} class="hover:text-blue-600 dark:hover:text-blue-400">
          {tCommon.nav.home}
        </a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">{contactName}</span>
      </nav>

      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1 text-xs font-bold text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/50 dark:text-blue-300 shadow-xs mb-3">
        <span>💬</span> {ui.supportDesk}
      </div>

      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        {pageData.h1}
      </h1>

      <p class="mt-4 text-base text-slate-600 dark:text-slate-300 max-w-xl mx-auto">
        {pageData.intro}
      </p>
    </div>
  </div>

  <main class="mx-auto max-w-5xl px-4 py-12 sm:py-16 space-y-16">
    <!-- Quick Contact Cards Grid -->
    <div class="grid gap-5 sm:grid-cols-3">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl text-blue-600 dark:bg-blue-950 dark:text-blue-400">
          💡
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">{ui.cardRequestTitle}</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          {ui.cardRequestDesc}
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600 dark:bg-amber-950 dark:text-amber-400">
          🐛
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">{ui.cardBugTitle}</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          {ui.cardBugDesc}
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400">
          🤝
        </div>
        <h3 class="mt-4 font-bold text-slate-900 dark:text-white text-sm">{ui.cardCollabTitle}</h3>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          {ui.cardCollabDesc}
        </p>
      </div>
    </div>

    <!-- Main Contact Form + Details Section -->
    <div class="grid gap-10 lg:grid-cols-12 items-start">
      <!-- Contact Info Sidebar (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/60 space-y-5">
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white text-sm">{ui.officialEmail}</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{ui.inboxMonitored}</p>
            <div class="mt-2.5 flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white p-2.5 dark:border-slate-700 dark:bg-slate-800">
              <a href="mailto:support@aifreecalculator.com" class="font-mono text-xs font-bold text-blue-600 hover:underline dark:text-blue-400 truncate">
                support@aifreecalculator.com
              </a>
              <button
                type="button"
                id="btn-copy-email"
                class="shrink-0 rounded-lg bg-slate-100 px-2 py-1 text-[11px] font-bold text-slate-700 hover:bg-blue-600 hover:text-white transition cursor-pointer dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-blue-600"
                title="Copy email to clipboard"
              >
                {ui.copy}
              </button>
            </div>
          </div>

          <div class="border-t border-slate-200 pt-4 dark:border-slate-800">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm">{ui.responseTime}</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
              {ui.responseTimeVal}
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-900/40 dark:text-slate-400">
          {ui.privacyNotice}
        </div>
      </div>

      <!-- Contact Form (8 Cols) -->
      <div class="lg:col-span-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <!-- Context Banner for Calculator-Specific Issues -->
        <div id="calculator-context-banner" class="hidden mb-6 rounded-2xl border border-blue-200 bg-blue-50/80 p-4 dark:border-blue-900/60 dark:bg-blue-950/40 text-xs">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 text-blue-950 dark:text-blue-200 font-medium">
              <span class="text-base">🧮</span>
              <span>
                {ui.contextTitle} <strong id="calc-context-name" class="font-bold text-blue-700 dark:text-blue-300">Calculator</strong>
              </span>
            </div>
            <a href={getLocalizedPath('/contact/', lang)} class="text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 text-[11px] underline font-semibold">
              {ui.clearContext}
            </a>
          </div>
        </div>

        <form id="contact-form" class="space-y-6" novalidate>
          <input type="hidden" id="contact-calc-slug" name="calculatorSlug" value="" />
          <input type="hidden" id="contact-calc-name" name="calculatorName" value="" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                {ui.fullName} <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                minlength="2"
                maxlength="100"
                placeholder={ui.namePlaceholder}
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                {ui.emailAddress} <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                maxlength="254"
                placeholder={ui.emailPlaceholder}
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="contact-category" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                {ui.topic} <span class="text-red-500">*</span>
              </label>
              <select
                id="contact-category"
                name="category"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-medium text-slate-900 outline-none transition focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              >
                <option value="Bug Report">{ui.topicBug}</option>
                <option value="Calculator Request">{ui.topicRequest}</option>
                <option value="General Feedback">{ui.topicFeedback}</option>
                <option value="Other">{ui.topicOther}</option>
              </select>
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                {ui.subject} <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-subject"
                name="subject"
                required
                minlength="3"
                maxlength="200"
                placeholder={ui.subjectPlaceholder}
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>
          </div>

          <!-- Anti-Spam Honeypot Field -->
          <input
            type="text"
            id="website_url_check"
            name="website_url_check"
            tabindex="-1"
            autocomplete="new-password"
            aria-hidden="true"
            style="display:none !important; position:absolute; left:-9999px; width:0; height:0;"
          />

          <div>
            <label for="contact-message" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              {ui.message} <span class="text-red-500">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              minlength="10"
              maxlength="5000"
              placeholder={ui.messagePlaceholder}
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-3 text-xs text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            ></textarea>
          </div>

          <div id="contact-status-msg" class="hidden rounded-xl p-3.5 text-xs font-semibold" role="alert"></div>

          <button
            type="submit"
            id="btn-submit-contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-8 py-3 text-xs font-bold text-white shadow-md shadow-blue-500/20 hover:bg-blue-700 active:scale-[0.98] transition cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span>📨</span>
            <span id="btn-submit-text">{ui.sendBtn}</span>
          </button>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  // Copy Email Button
  const btnCopy = document.getElementById('btn-copy-email');
  btnCopy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('support@aifreecalculator.com');
      const originalText = btnCopy.textContent;
      btnCopy.textContent = 'Copied! ✓';
      btnCopy.classList.add('bg-emerald-600', 'text-white');
      setTimeout(() => {
        btnCopy.textContent = originalText;
        btnCopy.classList.remove('bg-emerald-600', 'text-white');
      }, 2000);
    } catch {
      prompt('Copy email:', 'support@aifreecalculator.com');
    }
  });

  // Pre-fill Calculator Context & Instant URL Canonicalization
  try {
    // If URL has query parameters (e.g. ?calc=...&type=bug), instantly rewrite to # hash
    if (window.location.search && (window.location.search.includes('calc=') || window.location.search.includes('type=bug'))) {
      const cleanSearch = window.location.search.replace(/^\?/, '');
      const cleanPath = window.location.pathname.endsWith('/') ? window.location.pathname : `${window.location.pathname}/`;
      history.replaceState(null, '', `${cleanPath}#${cleanSearch}`);
    }

    const hashParams = new URLSearchParams(window.location.hash ? window.location.hash.replace(/^#/, '') : '');
    const searchParams = new URLSearchParams(window.location.search ? window.location.search.replace(/^\?/, '') : '');
    const calcSlug = hashParams.get('calc') || searchParams.get('calc') || '';
    const calcName = hashParams.get('name') || searchParams.get('name') || '';
    const reqType = hashParams.get('type') || searchParams.get('type') || '';

    if (calcSlug || calcName) {
      const banner = document.getElementById('calculator-context-banner');
      const nameEl = document.getElementById('calc-context-name');
      const slugInput = document.getElementById('contact-calc-slug');
      const nameInput = document.getElementById('contact-calc-name');
      const categorySelect = document.getElementById('contact-category');
      const subjectInput = document.getElementById('contact-subject');

      const displayName = calcName || calcSlug.replace(/-/g, ' ');
      if (nameEl) nameEl.textContent = displayName;
      if (banner) banner.classList.remove('hidden');
      if (slugInput) slugInput.value = calcSlug;
      if (nameInput) nameInput.value = displayName;

      if (categorySelect && (reqType === 'bug' || !categorySelect.value)) {
        categorySelect.value = 'Bug Report';
      }
      if (subjectInput && !subjectInput.value) {
        subjectInput.value = `[Issue Report] ${displayName}`;
      }
    }
  } catch {}

  // Form Submission
  const contactForm = document.getElementById('contact-form');
  const statusMsg   = document.getElementById('contact-status-msg');
  const btnSubmit   = document.getElementById('btn-submit-contact');
  const btnText     = document.getElementById('btn-submit-text');

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('contact-name')?.value.trim();
    const email = document.getElementById('contact-email')?.value.trim();
    const category = document.getElementById('contact-category')?.value;
    const subject = document.getElementById('contact-subject')?.value.trim();
    const message = document.getElementById('contact-message')?.value.trim();
    const honeypot = document.getElementById('website_url_check')?.value.trim();

    const calculatorSlug = document.getElementById('contact-calc-slug')?.value.trim() || undefined;
    const calculatorName = document.getElementById('contact-calc-name')?.value.trim() || undefined;

    if (honeypot) return;

    if (!name || !email || !subject || !message) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl bg-red-50 p-3.5 text-xs font-semibold text-red-700 dark:bg-red-950/50 dark:text-red-300 border border-red-200 dark:border-red-900/50';
        statusMsg.textContent = 'Please fill out all required fields.';
        statusMsg.classList.remove('hidden');
      }
      return;
    }

    if (btnSubmit) btnSubmit.disabled = true;
    if (btnText) btnText.textContent = 'Sending...';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          category,
          subject,
          message,
          calculatorSlug,
          calculatorName,
        }),
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        if (statusMsg) {
          statusMsg.className = 'rounded-xl bg-emerald-50 p-3.5 text-xs font-semibold text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/50';
          statusMsg.textContent = data.message || 'Thank you! Your message has been sent successfully.';
          statusMsg.classList.remove('hidden');
        }
        contactForm.reset();
      } else {
        if (statusMsg) {
          statusMsg.className = 'rounded-xl bg-red-50 p-3.5 text-xs font-semibold text-red-700 dark:bg-red-950/50 dark:text-red-300 border border-red-200 dark:border-red-900/50';
          statusMsg.textContent = data.error || 'Failed to send message. Please email support@aifreecalculator.com directly.';
          statusMsg.classList.remove('hidden');
        }
      }
    } catch {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl bg-red-50 p-3.5 text-xs font-semibold text-red-700 dark:bg-red-950/50 dark:text-red-300 border border-red-200 dark:border-red-900/50';
        statusMsg.textContent = 'Network error. Please email support@aifreecalculator.com directly.';
        statusMsg.classList.remove('hidden');
      }
    } finally {
      if (btnSubmit) btnSubmit.disabled = false;
      if (btnText) btnText.textContent = 'Send Message to Support Desk';
    }
  });
</script>
