---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslatedStaticPagePaths } from '../../i18n/registry';
import { getLocalizedPath } from '../../i18n/utils';
import { getCommonTranslations } from '../../i18n/translations/common';
import type { Locale } from '../../i18n/config';

export function getStaticPaths() {
  return getTranslatedStaticPagePaths('contact');
}

const { lang } = Astro.params as { lang: Locale };
const { pageData } = Astro.props;
const tCommon = getCommonTranslations(lang);
---

<BaseLayout
  title={`${pageData.metaTitle} | AI Free Calculator`}
  description={pageData.metaDescription}
  lang={lang}
>
  <div class="border-b border-slate-200 bg-linear-to-b from-blue-50/50 via-white to-slate-50 px-4 py-14 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', lang)} class="hover:text-blue-600 dark:hover:text-blue-400">
          {tCommon.nav.home}
        </a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">{pageData.name}</span>
      </nav>

      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        {pageData.h1}
      </h1>

      <p class="mt-4 text-base text-slate-600 dark:text-slate-300 max-w-xl mx-auto">
        {pageData.intro}
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8 space-y-10">
    {pageData.sections?.map((sec: any) => (
      <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">
          {sec.title}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          {sec.content}
        </p>
      </div>
    ))}

    <div class="rounded-3xl border border-blue-200 bg-blue-50/60 p-6 sm:p-8 dark:border-blue-900/40 dark:bg-blue-950/20 text-center">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white">Need a custom tool or calculation formula?</h3>
      <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        We actively add new civil engineering, health, and finance formulas requested by users.
      </p>
      <a
        href="mailto:contact@aifreecalculator.com"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-xs transition hover:bg-blue-700"
      >
        <span>✉️</span> Email Support
      </a>
    </div>
  </div>
</BaseLayout>
