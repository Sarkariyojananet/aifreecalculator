      boxBbsTable.classList.remove('hidden');
    } else {
      btnModeNorm.classList.add('bg-white', 'text-blue-700', 'dark:bg-blue-600', 'dark:text-white', 'font-bold');
      btnModeNorm.classList.remove('text-slate-600', 'font-semibold');
      btnModeAdv.classList.remove('bg-white', 'text-blue-700', 'dark:bg-blue-600', 'dark:text-white', 'font-bold');
      btnModeAdv.classList.add('text-slate-600', 'font-semibold');

      sectionNormInputs.classList.remove('hidden');
      sectionAdvInputs.classList.add('hidden');
      boxBbsTable.classList.add('hidden');
    }
    calculate();
  }

  // Check depth for side face reinforcement auto-warning
  function checkDepthSkin() {
    const rawD = parseFloat(bmD.value) || 0;
    const depthMm = currentDimensionUnit === 'ft' ? rawD * 25.4 : rawD;
    if (depthMm > 750) {
      badgeSideFaceAlert.classList.remove('hidden');
      checkSideFace.checked = true;
      sectionSideFaceInputs.classList.remove('hidden');
    } else {
      badgeSideFaceAlert.classList.add('hidden');
    }
  }

  if (checkSideFace) {
    checkSideFace.addEventListener('change', () => {
      if (checkSideFace.checked) {
        sectionSideFaceInputs.classList.remove('hidden');
      } else {
        sectionSideFaceInputs.classList.add('hidden');
      }
      calculate();
    });
  }

  if (stirrupMode) {
    stirrupMode.addEventListener('change', () => {
      if (stirrupMode.value === 'uniform') {
        boxStirrupSpacingUniform.classList.remove('hidden');
        boxStirrupSpacingTwozone.classList.add('hidden');
      } else {
        boxStirrupSpacingUniform.classList.add('hidden');
        boxStirrupSpacingTwozone.classList.remove('hidden');
      }
      calculate();
    });
  }

  if (selNormType) {
    selNormType.addEventListener('change', () => {
      if (selNormType.value === 'custom') {
        boxNormCustomRate.classList.remove('hidden');
      } else {
        boxNormCustomRate.classList.add('hidden');
      }
      calculate();
    });
  }

  // --- SVG DIAGRAM DRAWING ---
  function drawCrossSection(Bmm, Dmm, coverMm, topN, topDmm, botN, botDmm, sideN, sideDmm, stirrupDmm) {
    if (!svgCross) return;
    const W = 280, H = 240;
    const maxDim = Math.max(Bmm, Dmm);
    const scale = 140 / maxDim;
    const w = Bmm * scale;
    const h = Dmm * scale;
    const ox = (W - w) / 2;
    const oy = (H - h) / 2;
    const c = Math.max(4, coverMm * scale);

    let circles = '';
    // Top bars
    const topSpacing = (w - 2 * c) / (topN - 1 || 1);
    for (let i = 0; i < topN; i++) {
      const cx = ox + c + i * topSpacing;
      const cy = oy + c + 4;
      circles += `<circle cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" r="4" fill="#2563eb" stroke="#1e40af" stroke-width="1.5" />`;
    }

    // Bottom bars
    const botSpacing = (w - 2 * c) / (botN - 1 || 1);
    for (let i = 0; i < botN; i++) {
      const cx = ox + c + i * botSpacing;
      const cy = oy + h - c - 4;
      circles += `<circle cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" r="5" fill="#059669" stroke="#047857" stroke-width="1.5" />`;
    }

    // Side face bars
    if (sideN > 0) {
      const sideStep = (h - 2 * c - 16) / (sideN + 1);
      for (let i = 1; i <= sideN; i++) {
        const cy = oy + c + 8 + i * sideStep;
        circles += `<circle cx="${(ox + c + 2).toFixed(1)}" cy="${cy.toFixed(1)}" r="3.5" fill="#9333ea" stroke="#7e22ce" stroke-width="1.5" />`;
        circles += `<circle cx="${(ox + w - c - 2).toFixed(1)}" cy="${cy.toFixed(1)}" r="3.5" fill="#9333ea" stroke="#7e22ce" stroke-width="1.5" />`;
      }
    }

    svgCross.innerHTML = `
      <rect x="${ox.toFixed(1)}" y="${oy.toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}" rx="4" fill="#f1f5f9" stroke="#94a3b8" stroke-width="2" />
      <rect x="${(ox + c).toFixed(1)}" y="${(oy + c).toFixed(1)}" width="${(w - 2 * c).toFixed(1)}" height="${(h - 2 * c).toFixed(1)}" rx="3" fill="none" stroke="#d97706" stroke-width="2" stroke-dasharray="4,2" />
      ${circles}
      <!-- Dimensions -->
      <line x1="${ox.toFixed(1)}" y1="${(oy + h + 14).toFixed(1)}" x2="${(ox + w).toFixed(1)}" y2="${(oy + h + 14).toFixed(1)}" stroke="#64748b" stroke-width="1.5" marker-start="url(#dot)" marker-end="url(#dot)" />
      <text x="${(ox + w / 2).toFixed(1)}" y="${(oy + h + 26).toFixed(1)}" text-anchor="middle" font-size="10" font-weight="bold" fill="#334155">B = ${Math.round(Bmm)} mm</text>
      <text x="${(ox - 8).toFixed(1)}" y="${(oy + h / 2).toFixed(1)}" text-anchor="middle" transform="rotate(-90 ${(ox - 8).toFixed(1)} ${(oy + h / 2).toFixed(1)})" font-size="10" font-weight="bold" fill="#334155">D = ${Math.round(Dmm)} mm</text>
    `;

    if (lblCrossCaption) {
      lblCrossCaption.innerHTML = `Top: <strong class="text-blue-600">${topN} Nos × ${topDmm}mm</strong> | Bottom: <strong class="text-emerald-600">${botN} Nos × ${botDmm}mm</strong> | Stirrup: <strong class="text-amber-600">${stirrupDmm}mm Ring</strong>`;
    }
  }

  function drawElevation(spanM, supWmm, Dmm, isTwoZone, supSpacingMm, midSpacingMm) {
    if (!svgElevation) return;
    const W = 420, H = 220;
    const colW = 35;
    const beamW = W - 2 * colW - 30;
    const startX = colW + 15;
    const beamH = 65;
    const beamY = 70;

    let stirrupTicks = '';
    const zoneLen = isTwoZone ? beamW * 0.25 : beamW;
    if (isTwoZone) {
      // Left zone
      const numL = 6;
      for (let i = 0; i < numL; i++) {
        const x = startX + (i * zoneLen) / numL;
        stirrupTicks += `<line x1="${x.toFixed(1)}" y1="${beamY + 5}" x2="${x.toFixed(1)}" y2="${beamY + beamH - 5}" stroke="#d97706" stroke-width="1.5" />`;
      }
      // Mid zone
      const midLen = beamW * 0.5;
      const numM = 5;
      for (let i = 1; i < numM; i++) {
        const x = startX + zoneLen + (i * midLen) / numM;
        stirrupTicks += `<line x1="${x.toFixed(1)}" y1="${beamY + 5}" x2="${x.toFixed(1)}" y2="${beamY + beamH - 5}" stroke="#f59e0b" stroke-width="1" stroke-dasharray="3,1" />`;
      }
      // Right zone
      for (let i = 0; i <= numL; i++) {
        const x = startX + zoneLen + midLen + (i * zoneLen) / numL;
        stirrupTicks += `<line x1="${x.toFixed(1)}" y1="${beamY + 5}" x2="${x.toFixed(1)}" y2="${beamY + beamH - 5}" stroke="#d97706" stroke-width="1.5" />`;
      }
    } else {
      const num = 14;
      for (let i = 0; i <= num; i++) {
        const x = startX + (i * beamW) / num;
        stirrupTicks += `<line x1="${x.toFixed(1)}" y1="${beamY + 5}" x2="${x.toFixed(1)}" y2="${beamY + beamH - 5}" stroke="#d97706" stroke-width="1.5" />`;
      }
    }

    svgElevation.innerHTML = `
      <!-- Columns -->
      <rect x="15" y="30" width="${colW}" height="150" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
      <text x="${15 + colW / 2}" y="110" text-anchor="middle" font-size="9" font-weight="bold" fill="#64748b" transform="rotate(-90 ${15 + colW / 2} 110)">COLUMN</text>
      <rect x="${startX + beamW}" y="30" width="${colW}" height="150" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
      <text x="${startX + beamW + colW / 2}" y="110" text-anchor="middle" font-size="9" font-weight="bold" fill="#64748b" transform="rotate(-90 ${startX + beamW + colW / 2} 110)">COLUMN</text>

      <!-- Beam Concrete Body -->
      <rect x="${startX}" y="${beamY}" width="${beamW}" height="${beamH}" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2" />

      <!-- Top Main Bar with 90° bends -->
      <path d="M ${startX - 15} ${beamY + 22} L ${startX - 15} ${beamY + 8} L ${startX + beamW + 15} ${beamY + 8} L ${startX + beamW + 15} ${beamY + 22}" fill="none" stroke="#2563eb" stroke-width="2.5" />
      <!-- Bottom Main Bar with 90° bends -->
      <path d="M ${startX - 15} ${beamY + beamH - 22} L ${startX - 15} ${beamY + beamH - 8} L ${startX + beamW + 15} ${beamY + beamH - 8} L ${startX + beamW + 15} ${beamY + beamH - 22}" fill="none" stroke="#059669" stroke-width="3" />

      <!-- Top Extra Support Bars (Hogging @ L/4) -->
      <path d="M ${startX - 12} ${beamY + 20} L ${startX - 12} ${beamY + 14} L ${startX + beamW * 0.25} ${beamY + 14}" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-dasharray="4,2" />
      <path d="M ${startX + beamW - beamW * 0.25} ${beamY + 14} L ${startX + beamW + 12} ${beamY + 14} L ${startX + beamW + 12} ${beamY + 20}" fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-dasharray="4,2" />

      <!-- Stirrup Ticks -->
      ${stirrupTicks}

      <!-- Labels & Zone indicators -->
      ${isTwoZone ? `
        <rect x="${startX}" y="${beamY + beamH + 4}" width="${beamW * 0.25}" height="14" fill="#fef3c7" rx="3" />
        <text x="${startX + beamW * 0.125}" y="${beamY + beamH + 15}" text-anchor="middle" font-size="8" font-weight="bold" fill="#92400e">L/4 @ ${supSpacingMm}mm</text>
        <rect x="${startX + beamW * 0.25}" y="${beamY + beamH + 4}" width="${beamW * 0.5}" height="14" fill="#f1f5f9" rx="3" />
        <text x="${startX + beamW * 0.5}" y="${beamY + beamH + 15}" text-anchor="middle" font-size="8" font-weight="bold" fill="#475569">Mid-Span @ ${midSpacingMm}mm</text>
        <rect x="${startX + beamW * 0.75}" y="${beamY + beamH + 4}" width="${beamW * 0.25}" height="14" fill="#fef3c7" rx="3" />
        <text x="${startX + beamW * 0.875}" y="${beamY + beamH + 15}" text-anchor="middle" font-size="8" font-weight="bold" fill="#92400e">L/4 @ ${supSpacingMm}mm</text>
      ` : `
        <rect x="${startX}" y="${beamY + beamH + 4}" width="${beamW}" height="14" fill="#fef3c7" rx="3" />
        <text x="${startX + beamW * 0.5}" y="${beamY + beamH + 15}" text-anchor="middle" font-size="8" font-weight="bold" fill="#92400e">Uniform Spacing @ ${supSpacingMm}mm c/c</text>
      `}

      <!-- Span Dimension -->
      <line x1="${startX}" y1="20" x2="${startX + beamW}" y2="20" stroke="#0284c7" stroke-width="1.5" />
      <text x="${startX + beamW / 2}" y="15" text-anchor="middle" font-size="10" font-weight="bold" fill="#0369a1">Clear Span L = ${spanM.toFixed(2)} m</text>
    `;

    if (lblElevationCaption) {
      lblElevationCaption.innerHTML = isTwoZone
        ? `IS 13920 Ductile Detailing: <strong class="text-amber-700">Support Zones (L/4) @ ${supSpacingMm}mm</strong> | <strong class="text-slate-700">Mid-Span @ ${midSpacingMm}mm</strong>`
        : `Uniform Spacing: <strong class="text-amber-700">@ ${supSpacingMm}mm c/c throughout span</strong>`;
    }
  }

  // --- MAIN CALCULATION FUNCTION ---
  function calculate() {
    checkDepthSkin();

    const rawL = parseFloat(bmL.value) || 0;
    const rawSupW = parseFloat(bmSupportW.value) || 230;
    const rawW = parseFloat(bmW.value) || 230;
    const rawD = parseFloat(bmD.value) || 450;
    const rawCover = parseFloat(bmCover.value) || 25;
    const rawN = Math.max(1, parseInt(bmCount.value) || 1);

    if (rawL <= 0) {
      resTotalSteel.textContent = '0.0 kg';
      resTotalSteelOther.textContent = '(0.00 Quintals | 0.000 Tonnes)';
      resConc.textContent = '0.00 m³';
      resShuttering.textContent = 'Formwork: 0.00 m²';
      try { document.dispatchEvent(new CustomEvent('calculator:updated')); } catch (e) {}
      return;
    }

    // Convert to metric standard meters & mm for calculations
    const lengthM = currentDimensionUnit === 'ft' ? rawL * 0.3048 : rawL;
    const supportWidthM = currentDimensionUnit === 'ft' ? (rawSupW * 25.4) / 1000 : rawSupW / 1000;
    const widthMm = currentDimensionUnit === 'ft' ? rawW * 25.4 : rawW;
    const depthMm = currentDimensionUnit === 'ft' ? rawD * 25.4 : rawD;
    const coverMm = currentDimensionUnit === 'ft' ? rawCover * 25.4 : rawCover;

    const totalLengthM = lengthM + 2 * supportWidthM;
    const B = widthMm / 1000;
    const D = depthMm / 1000;
    const singleBeamVol = lengthM * B * D;
    const totalConcreteVol = singleBeamVol * rawN;
    const totalConcreteCuft = totalConcreteVol * 35.3147;

    // Costs inputs
    const rateSteel = parseFloat(costSteel.value) || 75;
    const rateConc = parseFloat(costConc.value) || 4800;
    const rateShut = parseFloat(costShut.value) || 350;
    const rateWire = parseFloat(costWire.value) || 100;

    let totalSteelKg = 0;
    let baseSteelKg = 0;
    let wastageKg = 0;
    let bbsList = [];
    let diaSummaryMap = new Map();

    if (currentCalculationMode === 'norm') {
      // NORMAL THUMB RULE MODE
      let steelRate = 120;
      const type = selNormType.value;
      if (type === 'light') steelRate = 80;
      else if (type === 'standard') steelRate = 120;
      else if (type === 'heavy') steelRate = 160;
      else if (type === 'custom') steelRate = parseFloat(inputNormCustomRate.value) || 120;

      baseSteelKg = totalConcreteVol * steelRate;
      wastageKg = baseSteelKg * 0.03;
      totalSteelKg = baseSteelKg + wastageKg;

      const normDia = parseInt(selNormDia.value) || 16;
      const uWt = getBarUnitWeight(normDia);
      const totLen = totalSteelKg / uWt;
      const stock12m = Math.ceil(totLen / 12);
      const bSize = BARS_PER_BUNDLE_MAP[normDia] || 3;
      const bundles = Math.ceil(stock12m / bSize);

      diaSummaryMap.set(normDia, { totalLen: totLen, totalWt: totalSteelKg, stock12m, bSize, bundles });

      // Concrete Grade Mix
      renderBOQ(totalConcreteVol, selNormConcrete.value);
    } else {
      // ADVANCED BBS MODE
      const wastagePct = parseFloat(inputWastage.value) || 3;
      const endAnchor = selEndAnchoring.value;

      function getHook(dia) {
        return endAnchor === 'deep_ld' ? (48 * dia) / 1000 : Math.max(0.15, (12 * dia) / 1000);
      }
      const endCoverM = Math.max(0.015, coverMm / 1000);
      const bearingEmbedM = Math.max(0.08, supportWidthM - endCoverM);

      // 1. Top Main Through Bars
      const nTop = Math.max(2, parseInt(topC.value) || 2);
      const dTop = parseInt(topD.value) || 12;
      const hookTop = getHook(dTop);
      const cutTop = Math.max(0.5, lengthM + 2 * bearingEmbedM + 2 * hookTop - (4 * dTop) / 1000);
      const totTopCount = nTop * rawN;
      const totTopLen = totTopCount * cutTop;
      const wtTop = totTopLen * getBarUnitWeight(dTop);
      bbsList.push({ mark: '01', desc: 'Top Main Straight Through Bars', dia: dTop, shape: 'L-HOOK (90° Both Ends)', count: totTopCount, cutLen: cutTop, totLen: totTopLen, uWt: getBarUnitWeight(dTop), totWt: wtTop });

      // 2. Top Extra Support Bars (Hogging @ L/4)
      const nTopEx = Math.max(0, parseInt(topExC.value) || 0);
      const dTopEx = parseInt(topExD.value) || 12;
      if (nTopEx > 0) {
        const hookTopEx = getHook(dTopEx);
        const cutTopEx = Math.max(0.3, lengthM * 0.25 + bearingEmbedM + hookTopEx - (2 * dTopEx) / 1000);
        const totTopExCount = nTopEx * 2 * rawN; // 2 supports
        const totTopExLen = totTopExCount * cutTopEx;
        const wtTopEx = totTopExLen * getBarUnitWeight(dTopEx);
        bbsList.push({ mark: '02', desc: 'Top Extra Support Bars (Hogging @ L/4)', dia: dTopEx, shape: 'ONE-HOOK (90° into Col)', count: totTopExCount, cutLen: cutTopEx, totLen: totTopExLen, uWt: getBarUnitWeight(dTopEx), totWt: wtTopEx });
      }

      // 3. Bottom Main Through Bars
      const nBot = Math.max(2, parseInt(botC.value) || 3);
      const dBot = parseInt(botD.value) || 16;
      const hookBot = getHook(dBot);
      const cutBot = Math.max(0.5, lengthM + 2 * bearingEmbedM + 2 * hookBot - (4 * dBot) / 1000);
      const totBotCount = nBot * rawN;
      const totBotLen = totBotCount * cutBot;
      const wtBot = totBotLen * getBarUnitWeight(dBot);
      bbsList.push({ mark: '03', desc: 'Bottom Main Tension Bars (Full Span)', dia: dBot, shape: 'L-HOOK (90° Both Ends)', count: totBotCount, cutLen: cutBot, totLen: totBotLen, uWt: getBarUnitWeight(dBot), totWt: wtBot });

      // 4. Bottom Extra Mid-Span Bars (Sagging @ 0.75L)
      const nBotEx = Math.max(0, parseInt(botExC.value) || 0);
      const dBotEx = parseInt(botExD.value) || 16;
      if (nBotEx > 0) {
        const cutBotEx = Math.max(0.4, lengthM * 0.75);
        const totBotExCount = nBotEx * rawN;
        const totBotExLen = totBotExCount * cutBotEx;
        const wtBotEx = totBotExLen * getBarUnitWeight(dBotEx);
        bbsList.push({ mark: '04', desc: 'Bottom Extra Mid-Span Bars (Sagging 0.75L)', dia: dBotEx, shape: 'STRAIGHT (Curtailed)', count: totBotExCount, cutLen: cutBotEx, totLen: totBotExLen, uWt: getBarUnitWeight(dBotEx), totWt: wtBotEx });
      }

      // 5. Side Face Reinforcement
      if (checkSideFace.checked || depthMm > 750) {
        const nSide = Math.max(1, parseInt(bmSideC.value) || 1);
        const dSide = parseInt(bmSideD.value) || 10;
        const cutSide = Math.max(0.5, lengthM + 2 * bearingEmbedM + 0.2 - 0.04);
        const totSideCount = nSide * 2 * rawN;
        const totSideLen = totSideCount * cutSide;
        const wtSide = totSideLen * getBarUnitWeight(dSide);
        bbsList.push({ mark: '05', desc: 'Side Face Skin Reinforcement (IS 456)', dia: dSide, shape: 'L-HOOK (Skin Rebar)', count: totSideCount, cutLen: cutSide, totLen: totSideLen, uWt: getBarUnitWeight(dSide), totWt: wtSide });
      }

      // 6. Stirrups
      const dStirrup = parseInt(stirrupD.value) || 8;
      const nLegs = parseInt(stirrupLegs.value) || 2;
      const coreW = Math.max(50, widthMm - 2 * coverMm);
      const coreD = Math.max(50, depthMm - 2 * coverMm);
      const hookStirrupMm = Math.max(75, 10 * dStirrup);
      let cutStirrupMm = 2 * (coreW + coreD) + 2 * hookStirrupMm - 12 * dStirrup;
      if (nLegs === 4) cutStirrupMm += coreD + 2 * hookStirrupMm - 6 * dStirrup;
      const cutStirrupM = Math.max(0.4, cutStirrupMm / 1000);

      let stirrupsPerBeam = 0;
      let stirrupDesc = '';
      if (stirrupMode.value === 'two_zone') {
        const sSup = currentDimensionUnit === 'ft' ? (parseFloat(stirrupSpacingSup.value) || 4) * 25.4 : parseFloat(stirrupSpacingSup.value) || 100;
        const sMid = currentDimensionUnit === 'ft' ? (parseFloat(stirrupSpacingMid.value) || 6) * 25.4 : parseFloat(stirrupSpacingMid.value) || 150;
        const zoneLenM = Math.min(lengthM * 0.25, Math.max(0.5, 2 * D));
        const midLenM = Math.max(0, lengthM - 2 * zoneLenM);
        const ringsSup = Math.floor((zoneLenM * 1000) / sSup) + 1;
        const ringsMid = sMid > 0 && midLenM > 0 ? Math.floor((midLenM * 1000) / sMid) : 0;
        stirrupsPerBeam = ringsSup * 2 + ringsMid;
        stirrupDesc = `2-Zone Stirrups (${nLegs}-Legged @ ${Math.round(sSup)}mm & ${Math.round(sMid)}mm)`;
      } else {
        const sUni = currentDimensionUnit === 'ft' ? (parseFloat(stirrupSpacingUniform.value) || 6) * 25.4 : parseFloat(stirrupSpacingUniform.value) || 150;
        stirrupsPerBeam = Math.floor((lengthM * 1000) / sUni) + 1;
        stirrupDesc = `Uniform Stirrups (${nLegs}-Legged @ ${Math.round(sUni)}mm c/c)`;
      }

      const totStirrupCount = stirrupsPerBeam * rawN;
      const totStirrupLen = totStirrupCount * cutStirrupM;
      const wtStirrup = totStirrupLen * getBarUnitWeight(dStirrup);
      bbsList.push({ mark: '06', desc: stirrupDesc, dia: dStirrup, shape: 'RING-135° (Seismic Ties)', count: totStirrupCount, cutLen: cutStirrupM, totLen: totStirrupLen, uWt: getBarUnitWeight(dStirrup), totWt: wtStirrup });

      // Sum totals
      baseSteelKg = bbsList.reduce((acc, it) => acc + it.totWt, 0);
      wastageKg = baseSteelKg * (wastagePct / 100);
      totalSteelKg = baseSteelKg + wastageKg;

      // Group diameter breakdown
      for (const it of bbsList) {
        const cur = diaSummaryMap.get(it.dia) || { totalLen: 0, totalWt: 0 };
        cur.totalLen += it.totLen;
        cur.totalWt += it.totWt;
        diaSummaryMap.set(it.dia, cur);
      }
      for (const [dia, val] of diaSummaryMap.entries()) {
        val.stock12m = Math.ceil(val.totalLen / 12);
        val.bSize = BARS_PER_BUNDLE_MAP[dia] || 3;
        val.bundles = Math.ceil(val.stock12m / val.bSize);
      }

      renderBBS(bbsList);
      renderBOQ(totalConcreteVol, selConcreteGrade.value);

      // Draw SVG diagrams
      drawCrossSection(widthMm, depthMm, coverMm, nTop, dTop, nBot, dBot, (checkSideFace.checked ? parseInt(bmSideC.value) : 0), (checkSideFace.checked ? parseInt(bmSideD.value) : 0), dStirrup);
      const isTwo = stirrupMode.value === 'two_zone';
      const s1 = currentDimensionUnit === 'ft' ? Math.round((parseFloat(stirrupSpacingSup.value) || 4) * 25.4) : Math.round(parseFloat(stirrupSpacingSup.value) || 100);
      const s2 = currentDimensionUnit === 'ft' ? Math.round((parseFloat(stirrupSpacingMid.value) || 6) * 25.4) : Math.round(parseFloat(stirrupSpacingMid.value) || 150);
      drawElevation(lengthM, supportWidthM * 1000, depthMm, isTwo, s1, s2);
    }

    renderDiameterSummary(diaSummaryMap);

    // Formwork Shuttering: bottom soffit + 2 vertical sides = (2D + B) * L
    const singleShutteringSqm = lengthM * (2 * D + B);
    const totalShutteringSqm = singleShutteringSqm * rawN;
    const totalShutteringSqft = totalShutteringSqm * 10.7639;

    // Binding wire ~1% of steel weight
    const bindingWireKg = Math.max(1, Math.round((totalSteelKg * 0.01) * 10) / 10);

    // Hero Takeaway Displays
    resTotalSteel.textContent = `${totalSteelKg.toFixed(1)} kg`;
    resTotalSteelOther.textContent = `(${(totalSteelKg / 100).toFixed(2)} Quintals | ${(totalSteelKg / 1000).toFixed(3)} Tonnes)`;
    resConc.textContent = `${totalConcreteVol.toFixed(2)} m³ (${totalConcreteCuft.toFixed(1)} cu ft)`;
    resShuttering.textContent = `Formwork: ${totalShutteringSqm.toFixed(1)} m² (${totalShutteringSqft.toFixed(1)} sq ft)`;

    resGeomDim.textContent = `${Math.round(widthMm)} × ${Math.round(depthMm)} mm (${(widthMm / 25.4).toFixed(0)}" × ${(depthMm / 25.4).toFixed(0)}")`;
    resGeomLength.textContent = `${(lengthM * rawN).toFixed(1)} m span (${rawN} Beam${rawN > 1 ? 's' : ''})`;
    const intensity = totalConcreteVol > 0 ? (totalSteelKg / totalConcreteVol).toFixed(1) : '0';
    resIntensityVol.textContent = `${intensity} kg/m³`;

    // Costs Calculation
    const costSteelAmt = Math.round(totalSteelKg * rateSteel);
    const costConcAmt = Math.round(totalConcreteVol * rateConc);
    const costShutAmt = Math.round(totalShutteringSqm * rateShut);
    const costWireAmt = Math.round(bindingWireKg * rateWire);
    const totalCostAmt = costSteelAmt + costConcAmt + costShutAmt + costWireAmt;

    resCostTotal.textContent = `₹ ${totalCostAmt.toLocaleString('en-IN')}`;
    resCostSteelQty.textContent = `${totalSteelKg.toFixed(1)} kg`;
    resCostSteelRate.textContent = `₹ ${rateSteel}/kg`;
    resCostSteelAmt.textContent = `₹ ${costSteelAmt.toLocaleString('en-IN')}`;

    resCostConcQty.textContent = `${totalConcreteVol.toFixed(2)} m³`;
    resCostConcRate.textContent = `₹ ${rateConc}/m³`;
    resCostConcAmt.textContent = `₹ ${costConcAmt.toLocaleString('en-IN')}`;

    resCostShutQty.textContent = `${totalShutteringSqm.toFixed(1)} m²`;
    resCostShutRate.textContent = `₹ ${rateShut}/m²`;
    resCostShutAmt.textContent = `₹ ${costShutAmt.toLocaleString('en-IN')}`;

    resCostWireQty.textContent = `${bindingWireKg.toFixed(1)} kg`;
    resCostWireRate.textContent = `₹ ${rateWire}/kg`;
    resCostWireAmt.textContent = `₹ ${costWireAmt.toLocaleString('en-IN')}`;
    resCostGrandAmt.textContent = `₹ ${totalCostAmt.toLocaleString('en-IN')}`;

    // Ancillaries
    resBoqShuttering.textContent = `${totalShutteringSqm.toFixed(1)} m² (${totalShutteringSqft.toFixed(1)} sq ft)`;
    resBoqWire.textContent = `${bindingWireKg.toFixed(1)} kg (18 Gauge GI Wire)`;

    try { document.dispatchEvent(new CustomEvent('calculator:updated')); } catch (e) {}
  }

  function renderBBS(items) {
    if (!tbodyBBS) return;
    let html = '';
    for (const it of items) {
      html += `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
          <td class="p-2.5 font-bold text-blue-600 dark:text-blue-400">${it.mark}</td>
          <td class="p-2.5 font-semibold text-slate-900 dark:text-white">${it.desc}</td>
          <td class="p-2.5 text-center font-bold font-mono">${it.dia}</td>
          <td class="p-2.5 text-slate-600 dark:text-slate-400 font-mono text-[11px]">${it.shape}</td>
          <td class="p-2.5 text-center font-bold">${it.count}</td>
          <td class="p-2.5 text-right font-mono">${it.cutLen.toFixed(2)}</td>
          <td class="p-2.5 text-right font-mono">${it.totLen.toFixed(1)}</td>
          <td class="p-2.5 text-right font-mono text-slate-500">${it.uWt.toFixed(3)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${it.totWt.toFixed(1)}</td>
        </tr>
      `;
    }
    tbodyBBS.innerHTML = html;
  }

  function renderDiameterSummary(diaMap) {
    if (!tbodyDiaSummary) return;
    let html = '';
    const sorted = Array.from(diaMap.keys()).sort((a, b) => a - b);
    for (const dia of sorted) {
      const data = diaMap.get(dia);
      html += `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
          <td class="p-2 font-bold text-blue-600 dark:text-blue-400">${dia} mm</td>
          <td class="p-2 text-right font-mono">${data.totalLen.toFixed(1)} m</td>
          <td class="p-2 text-right font-bold text-slate-900 dark:text-white">${data.totalWt.toFixed(1)} kg</td>
          <td class="p-2 text-center font-bold text-emerald-600 dark:text-emerald-400">${data.stock12m} Rods</td>
          <td class="p-2 text-center font-semibold text-slate-700 dark:text-slate-300">${data.bundles} Bndl (${data.bSize}/bndl)</td>
        </tr>
      `;
    }
    tbodyDiaSummary.innerHTML = html;
  }

  function renderBOQ(volumeM3, grade) {
    const dryVol = volumeM3 * 1.54;
    let cementRatio = 1, sandRatio = 1.5, aggRatio = 3;
    if (grade === 'M25') { cementRatio = 1; sandRatio = 1; aggRatio = 2; }
    else if (grade === 'M15') { cementRatio = 1; sandRatio = 2; aggRatio = 4; }
    const totalRatio = cementRatio + sandRatio + aggRatio;

    const cementM3 = dryVol * (cementRatio / totalRatio);
    const cementKg = cementM3 * 1440;
    const cementBags = Math.ceil(cementKg / 50);

    const sandM3 = dryVol * (sandRatio / totalRatio);
    const sandCft = sandM3 * 35.3147;

    const aggM3 = dryVol * (aggRatio / totalRatio);
    const aggCft = aggM3 * 35.3147;

    if (resBoqCement) resBoqCement.textContent = `${cementBags} Bags (${cementKg.toFixed(0)} kg)`;
    if (resBoqSand) resBoqSand.textContent = `${sandCft.toFixed(1)} cft (${sandM3.toFixed(2)} m³)`;
    if (resBoqAggregate) resBoqAggregate.textContent = `${aggCft.toFixed(1)} cft (${aggM3.toFixed(2)} m³)`;
  }

  // --- BUTTON EVENT LISTENERS ---
  const btnCalc = document.getElementById('btn-calc-beam');
  const btnClear = document.getElementById('btn-clear-beam');

  if (btnCalc) {
    btnCalc.addEventListener('click', () => {
      calculate();
      const card = document.getElementById('results-card');
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const orig = btnCalc.innerHTML;
      btnCalc.innerHTML = '<span>✅ Calculated!</span>';
      setTimeout(() => { btnCalc.innerHTML = orig; }, 1200);
    });
  }

  if (btnClear) {
    btnClear.addEventListener('click', () => {
      bmL.value = '';
      bmL.focus();
      calculate();
      const orig = btnClear.innerHTML;
      btnClear.innerHTML = '<span>✓ Cleared</span>';
      setTimeout(() => { btnClear.innerHTML = orig; }, 1000);
    });
  }

  if (btnModeAdv) btnModeAdv.addEventListener('click', () => setMode('adv'));
  if (btnModeNorm) btnModeNorm.addEventListener('click', () => setMode('norm'));
  if (btnUnitM) btnUnitM.addEventListener('click', () => setUnit('m'));
  if (btnUnitFt) btnUnitFt.addEventListener('click', () => setUnit('ft'));

  // Preset buttons handler
  document.querySelectorAll('.btn-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const u = btn.getAttribute('data-unit') || 'm';
      setUnit(u);
      setMode('adv');

      if (btn.hasAttribute('data-span')) bmL.value = btn.getAttribute('data-span');
      if (btn.hasAttribute('data-support')) bmSupportW.value = btn.getAttribute('data-support');
      if (btn.hasAttribute('data-w')) bmW.value = btn.getAttribute('data-w');
      if (btn.hasAttribute('data-d')) bmD.value = btn.getAttribute('data-d');

      if (btn.hasAttribute('data-top-c')) topC.value = btn.getAttribute('data-top-c');
      if (btn.hasAttribute('data-top-d')) topD.value = btn.getAttribute('data-top-d');
      if (btn.hasAttribute('data-top-ex-c')) topExC.value = btn.getAttribute('data-top-ex-c');

      if (btn.hasAttribute('data-bot-c')) botC.value = btn.getAttribute('data-bot-c');
      if (btn.hasAttribute('data-bot-d')) botD.value = btn.getAttribute('data-bot-d');
      if (btn.hasAttribute('data-bot-ex-c')) botExC.value = btn.getAttribute('data-bot-ex-c');

      if (btn.getAttribute('data-side') === 'true') {
        checkSideFace.checked = true;
        sectionSideFaceInputs.classList.remove('hidden');
        if (btn.hasAttribute('data-side-c')) bmSideC.value = btn.getAttribute('data-side-c');
        if (btn.hasAttribute('data-side-d')) bmSideD.value = btn.getAttribute('data-side-d');
      } else {
        checkSideFace.checked = false;
        sectionSideFaceInputs.classList.add('hidden');
      }

      if (btn.hasAttribute('data-stirrup-d')) stirrupD.value = btn.getAttribute('data-stirrup-d');
      if (btn.hasAttribute('data-stirrup-mode')) {
        stirrupMode.value = btn.getAttribute('data-stirrup-mode');
        if (stirrupMode.value === 'uniform') {
          boxStirrupSpacingUniform.classList.remove('hidden');
          boxStirrupSpacingTwozone.classList.add('hidden');
          if (btn.hasAttribute('data-stirrup-s')) stirrupSpacingUniform.value = btn.getAttribute('data-stirrup-s');
        } else {
          boxStirrupSpacingUniform.classList.add('hidden');
          boxStirrupSpacingTwozone.classList.remove('hidden');
          if (btn.hasAttribute('data-stirrup-sup')) stirrupSpacingSup.value = btn.getAttribute('data-stirrup-sup');
          if (btn.hasAttribute('data-stirrup-mid')) stirrupSpacingMid.value = btn.getAttribute('data-stirrup-mid');
        }
      }

      calculate();
    });
  });

  // Table Copy, CSV, Print
  const btnCopyBbs = document.getElementById('btn-copy-bbs');
  if (btnCopyBbs) {
    btnCopyBbs.addEventListener('click', () => {
      let tsv = 'Mark\tDescription\tDia(mm)\tShape Code\tCount\tCut Len(m)\tTot Len(m)\tUnit Wt(kg/m)\tTot Wt(kg)\n';
      document.querySelectorAll('#tbody-bbs tr').forEach(row => {
        const cols = Array.from(row.querySelectorAll('td')).map(td => td.textContent.trim());
        tsv += cols.join('\t') + '\n';
      });
      navigator.clipboard.writeText(tsv).then(() => {
        const orig = btnCopyBbs.textContent;
        btnCopyBbs.textContent = '✅ Copied!';
        setTimeout(() => { btnCopyBbs.textContent = orig; }, 1500);
      });
    });
  }

  const btnDownloadCsv = document.getElementById('btn-download-csv');
  if (btnDownloadCsv) {
    btnDownloadCsv.addEventListener('click', () => {
      let csv = 'Mark,Description,Dia(mm),Shape Code,Count,Cut Len(m),Tot Len(m),Unit Wt(kg/m),Tot Wt(kg)\n';
      document.querySelectorAll('#tbody-bbs tr').forEach(row => {
        const cols = Array.from(row.querySelectorAll('td')).map(td => `"${td.textContent.trim().replace(/"/g, '""')}"`);
        csv += cols.join(',') + '\n';
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'RCC_Beam_Steel_BBS.csv';
      link.click();
    });
  }

  const btnPrintBbs = document.getElementById('btn-print-bbs');
  if (btnPrintBbs) {
    btnPrintBbs.addEventListener('click', () => {
      window.print();
    });
  }

  // Live input events
  // Live Diagram Update (Diagram updates in real-time as user types without computing result numbers)
  function updateLiveDiagrams() {
    let B = parseFloat(bmW.value) || 230;
    let D = parseFloat(bmD.value) || 450;
    let L = parseFloat(bmL.value) || 4.0;
    let supW = parseFloat(bmSupportW.value) || 230;
    let cover = parseFloat(bmCover.value) || 25;

    if (currentDimensionUnit === 'ft') {
      B *= 25.4;
      D *= 25.4;
      L *= 0.3048;
      supW *= 25.4;
      cover *= 25.4;
    }

    const nTop = (currentCalculationMode === 'norm' ? (parseInt(topCNorm?.value) || 2) : (parseInt(topC?.value) || 2));
    const dTop = (currentCalculationMode === 'norm' ? (parseInt(topDNorm?.value) || 12) : (parseInt(topD?.value) || 12));
    const nBot = (currentCalculationMode === 'norm' ? (parseInt(botCNorm?.value) || 3) : (parseInt(botC?.value) || 3));
    const dBot = (currentCalculationMode === 'norm' ? (parseInt(botDNorm?.value) || 16) : (parseInt(botD?.value) || 16));
    const nSide = (checkSideFace && checkSideFace.checked) ? (parseInt(bmSideC?.value) || 0) : 0;
    const dSide = (checkSideFace && checkSideFace.checked) ? (parseInt(bmSideD?.value) || 0) : 0;
    const dStirrup = (currentCalculationMode === 'norm' ? (parseInt(stirrupDNorm?.value) || 8) : (parseInt(stirrupD?.value) || 8));

    drawCrossSection(B, D, cover, nTop, dTop, nBot, dBot, nSide, dSide, dStirrup);

    const isTwo = stirrupMode && stirrupMode.value === 'two_zone';
    const s1 = currentDimensionUnit === 'ft' ? Math.round((parseFloat(stirrupSpacingSup?.value) || 4) * 25.4) : Math.round(parseFloat(stirrupSpacingSup?.value) || 100);
    const s2 = currentDimensionUnit === 'ft' ? Math.round((parseFloat(stirrupSpacingMid?.value) || 6) * 25.4) : Math.round(parseFloat(stirrupSpacingMid?.value) || 150);
    drawElevation(L, supW, D, isTwo, s1, s2);
  }

  const liveInputs = [
    bmL, bmSupportW, bmW, bmD, bmCover, bmCount,
    selConcreteGrade, selEndAnchoring, inputWastage,
    topC, topD, topExC, topExD,
    botC, botD, botExC, botExD,
    bmSideC, bmSideD,
    stirrupD, stirrupLegs, stirrupSpacingUniform, stirrupSpacingSup, stirrupSpacingMid,
    selNormType, inputNormCustomRate, selNormDia, selNormConcrete,
    costSteel, costConc, costShut, costWire
  ];

  liveInputs.forEach(el => {
    if (el) {
      el.addEventListener('input', updateLiveDiagrams);
      el.addEventListener('change', updateLiveDiagrams);
    }
  });

  // Initial calculation on page load
  calculate();
</script>

