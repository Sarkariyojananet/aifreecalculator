---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import {
  STANDARD_REBAR_WEIGHTS,
  BARS_PER_BUNDLE,
  CONCRETE_MIX_PROPORTIONS,
} from '../../lib/calculators/rcc-beam-steel';
---

<CalculatorLayout
  title="RCC Beam Steel Calculator – Normal & Advanced BBS Rebar Estimator"
  description="Free RCC beam steel calculator with Normal (CPWD thumb rule) and Advanced BBS engineering modes. Calculates top & bottom main rebars, support extra bars, 2-zone shear stirrups (IS 13920), 12m commercial rebar bundles, shuttering, and concrete mix BOQ."
  category="Construction"
  calculatorName="RCC Beam Steel Calculator"
  slug="rcc-beam-steel-calculator"
  keywords={[
    'rcc beam steel',
    'rcc beam steel calculator',
    'beam bbs',
    'beam bar bending schedule',
    'stirrups cutting length',
    'beam rebar weight',
    'beam concrete volume',
    'is 13920 beam detailing',
    'beam thumb rule steel',
    'beam shuttering area',
    'beam rebar 12m rods'
  ]}
>
  <div class="space-y-6">

    <!-- SAFETY & ENGINEERING DISCLAIMER BANNER -->
    <div class="rounded-2xl border border-amber-200/90 bg-amber-50/70 p-4 text-xs text-amber-900 shadow-2xs dark:border-amber-900/50 dark:bg-amber-950/30 dark:text-amber-200">
      <div class="flex items-start gap-2.5">
        <span class="text-base leading-none">⚠️</span>
        <div class="leading-relaxed">
          <strong class="font-bold text-amber-950 dark:text-amber-100">Civil Engineering Notice:</strong>
          This calculator provides both <strong>Normal Site Thumb-Rule Estimation</strong> (CPWD / IS 456 preliminary rate: 1.0%–2.0% steel or 80–160 kg/m³) and <strong>Advanced Bar Bending Schedule (BBS) Detailing</strong> (IS 456 & IS 13920:2016 ductile earthquake detailing with 2-zone shear stirrups, top negative hogging support bars, bottom mid-span extra bars, and standard 12m stock commercial rebar takeoff). Always verify final structural drawings with a licensed structural engineer before bar fabrication.
        </div>
      </div>
    </div>

    <!-- QUICK EXAMPLE PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-span="4.0" data-support="230" data-w="230" data-d="230" data-top-c="2" data-top-d="12" data-top-ex-c="0" data-bot-c="2" data-bot-d="12" data-bot-ex-c="0" data-stirrup-d="8" data-stirrup-mode="uniform" data-stirrup-s="150">Plinth Beam (230×230 mm / 9"×9")</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-span="4.5" data-support="230" data-w="230" data-d="380" data-top-c="2" data-top-d="12" data-top-ex-c="2" data-bot-c="3" data-bot-d="16" data-bot-ex-c="0" data-stirrup-d="8" data-stirrup-mode="two_zone" data-stirrup-sup="100" data-stirrup-mid="150">Floor Beam (230×380 mm / 9"×15")</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-span="5.0" data-support="230" data-w="230" data-d="450" data-top-c="2" data-top-d="12" data-top-ex-c="2" data-bot-c="3" data-bot-d="16" data-bot-ex-c="1" data-stirrup-d="8" data-stirrup-mode="two_zone" data-stirrup-sup="100" data-stirrup-mid="150">Standard RCC Beam (230×450 mm / 9"×18")</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-span="6.0" data-support="300" data-w="300" data-d="600" data-top-c="3" data-top-d="16" data-top-ex-c="2" data-bot-c="4" data-bot-d="20" data-bot-ex-c="2" data-stirrup-d="8" data-stirrup-mode="two_zone" data-stirrup-sup="100" data-stirrup-mid="150">Heavy Commercial (300×600 mm / 12"×24")</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-span="7.0" data-support="300" data-w="300" data-d="800" data-top-c="3" data-top-d="20" data-top-ex-c="2" data-bot-c="4" data-bot-d="25" data-bot-ex-c="2" data-side="true" data-side-c="1" data-side-d="12" data-stirrup-d="10" data-stirrup-mode="two_zone" data-stirrup-sup="100" data-stirrup-mid="150">Deep Beam (300×800 mm with Side Bars)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- HEADER & MODE TOGGLER -->
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🏗️</span> RCC Beam Steel & Material Takeoff
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Calculate rebar weight, BBS cutting length, stirrups, 12m stock bars, and concrete mix quantities.
            </p>
          </div>
          
          <!-- CALCULATION METHOD SWITCHER PILLS -->
          <div class="inline-flex rounded-xl bg-slate-200/80 p-1 dark:bg-slate-800/80 self-start sm:self-center">
            <button
              type="button"
              id="btn-mode-adv"
              class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-700 shadow-xs dark:bg-blue-600 dark:text-white transition cursor-pointer"
            >
              📐 Advanced BBS Mode
            </button>
            <button
              type="button"
              id="btn-mode-norm"
              class="rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition cursor-pointer"
            >
              ⚡ Normal (Thumb Rule)
            </button>
          </div>
        </div>
      </div>

      <form id="form-rcc-beam" class="mt-5 space-y-5" novalidate onsubmit="return false;">
        
        <!-- SECTION 1: BEAM DIMENSIONS & GEOMETRY (COMMON) -->
        <div>
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>1.</span> Beam Dimensions & Support Geometry
            </h3>
            <div class="flex items-center gap-1 text-xs">
              <span class="text-slate-500 dark:text-slate-400 font-semibold mr-1">Unit:</span>
              <button type="button" id="btn-unit-m" class="btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer" data-unit="m">Metric (m / mm)</button>
              <button type="button" id="btn-unit-ft" class="btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft">Imperial (ft / in)</button>
            </div>
          </div>

          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            <div>
              <label for="bm-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Clear Span L (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="bm-len"
                value="5.0"
                step="0.1"
                min="0.1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="bm-support-width" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Support Bearing (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="bm-support-width"
                value="230"
                step="10"
                min="50"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="bm-width" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Beam Width B (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="bm-width"
                value="230"
                step="10"
                min="50"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="bm-depth" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Beam Depth D (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="bm-depth"
                value="450"
                step="10"
                min="50"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="bm-cover" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Clear Cover (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="bm-cover"
                value="25"
                step="5"
                min="15"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="bm-count" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                No. of Beams
              </label>
              <input
                type="number"
                id="bm-count"
                value="1"
                step="1"
                min="1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- ADVANCED MODE CONTAINER -->
        <!-- ========================================================= -->
        <div id="section-adv-inputs" class="space-y-4">
          
          <!-- CONFIG & REBAR DETAILING SPECIFICATIONS -->
          <div class="rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/80">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-100 dark:border-slate-800">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                2. Rebar Detailing Standard & Concrete Mix
              </h3>
              <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                IS 456:2000 & IS 13920:2016
              </span>
            </div>

            <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div>
                <label for="select-concrete-grade" class="block font-bold text-slate-700 dark:text-slate-300">
                  Concrete Mix Grade
                </label>
                <select id="select-concrete-grade" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="M20" selected>M20 (1 : 1.5 : 3) – Standard Floor Beam</option>
                  <option value="M25">M25 (1 : 1 : 2) – Heavy Load / High-Rise Beam</option>
                  <option value="M15">M15 (1 : 2 : 4) – Low Load / Plinth Tie Beam</option>
                </select>
              </div>

              <div>
                <label for="select-end-anchoring" class="block font-bold text-slate-700 dark:text-slate-300">
                  End Anchorage & Bend
                </label>
                <select id="select-end-anchoring" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="standard_90" selected>Standard 90° L-Bend (12d Hook)</option>
                  <option value="deep_ld">Full Development Length Ld (48d)</option>
                </select>
              </div>

              <div>
                <label for="input-wastage" class="block font-bold text-slate-700 dark:text-slate-300">
                  Cutting & Site Wastage (%)
                </label>
                <input
                  type="number"
                  id="input-wastage"
                  value="3"
                  min="0"
                  max="15"
                  step="0.5"
                  class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
            </div>
          </div>

          <!-- TOP & BOTTOM REINFORCEMENT SPECIFICATIONS -->
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            
            <!-- TOP REINFORCEMENT CARD -->
            <div class="rounded-2xl border border-blue-200 bg-blue-50/40 p-4 dark:border-blue-950 dark:bg-slate-900/70">
              <div class="flex items-center justify-between pb-2 border-b border-blue-200/60 dark:border-slate-800">
                <h4 class="text-xs font-bold uppercase tracking-wider text-blue-900 dark:text-blue-300 flex items-center gap-1.5">
                  <span>A.</span> Top Reinforcement (Compression & Hogging)
                </h4>
                <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
                  Top Face
                </span>
              </div>

              <div class="mt-3 space-y-3 text-xs">
                <div>
                  <span class="font-bold text-slate-700 dark:text-slate-300">Continuous Through Bars:</span>
                  <div class="mt-1 flex gap-2">
                    <div class="w-1/2">
                      <label for="bm-top-count" class="text-[11px] text-slate-500 dark:text-slate-400">Number of Bars</label>
                      <input type="number" id="bm-top-count" value="2" min="2" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                    <div class="w-1/2">
                      <label for="bm-top-dia" class="text-[11px] text-slate-500 dark:text-slate-400">Bar Diameter</label>
                      <select id="bm-top-dia" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                        <option value="10">10 mm</option>
                        <option value="12" selected>12 mm</option>
                        <option value="16">16 mm</option>
                        <option value="20">20 mm</option>
                        <option value="25">25 mm</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="pt-2 border-t border-blue-200/60 dark:border-slate-800">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-700 dark:text-slate-300">Support Extra Bars (Hogging @ L/4):</span>
                    <span class="text-[11px] text-blue-600 dark:text-blue-400 font-medium">Left & Right Supports</span>
                  </div>
                  <div class="mt-1 flex gap-2">
                    <div class="w-1/2">
                      <label for="bm-top-extra-count" class="text-[11px] text-slate-500 dark:text-slate-400">Extra Bars / Support</label>
                      <input type="number" id="bm-top-extra-count" value="2" min="0" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                    <div class="w-1/2">
                      <label for="bm-top-extra-dia" class="text-[11px] text-slate-500 dark:text-slate-400">Extra Bar Dia</label>
                      <select id="bm-top-extra-dia" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                        <option value="10">10 mm</option>
                        <option value="12" selected>12 mm</option>
                        <option value="16">16 mm</option>
                        <option value="20">20 mm</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- BOTTOM REINFORCEMENT CARD -->
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50/40 p-4 dark:border-emerald-950 dark:bg-slate-900/70">
              <div class="flex items-center justify-between pb-2 border-b border-emerald-200/60 dark:border-slate-800">
                <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-900 dark:text-emerald-300 flex items-center gap-1.5">
                  <span>B.</span> Bottom Reinforcement (Main Tension & Sagging)
                </h4>
                <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                  Bottom Face
                </span>
              </div>

              <div class="mt-3 space-y-3 text-xs">
                <div>
                  <span class="font-bold text-slate-700 dark:text-slate-300">Continuous Tension Bars:</span>
                  <div class="mt-1 flex gap-2">
                    <div class="w-1/2">
                      <label for="bm-bot-count" class="text-[11px] text-slate-500 dark:text-slate-400">Number of Bars</label>
                      <input type="number" id="bm-bot-count" value="3" min="2" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                    <div class="w-1/2">
                      <label for="bm-bot-dia" class="text-[11px] text-slate-500 dark:text-slate-400">Bar Diameter</label>
                      <select id="bm-bot-dia" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                        <option value="12">12 mm</option>
                        <option value="16" selected>16 mm</option>
                        <option value="20">20 mm</option>
                        <option value="25">25 mm</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="pt-2 border-t border-emerald-200/60 dark:border-slate-800">
                  <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-700 dark:text-slate-300">Mid-Span Extra Bars (Sagging @ 0.75L):</span>
                    <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">Curtailed Midspan</span>
                  </div>
                  <div class="mt-1 flex gap-2">
                    <div class="w-1/2">
                      <label for="bm-bot-extra-count" class="text-[11px] text-slate-500 dark:text-slate-400">Extra Mid Bars</label>
                      <input type="number" id="bm-bot-extra-count" value="0" min="0" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                    </div>
                    <div class="w-1/2">
                      <label for="bm-bot-extra-dia" class="text-[11px] text-slate-500 dark:text-slate-400">Extra Bar Dia</label>
                      <select id="bm-bot-extra-dia" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                        <option value="12">12 mm</option>
                        <option value="16" selected>16 mm</option>
                        <option value="20">20 mm</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SIDE FACE SKIN REINFORCEMENT (IS 456 CL. 26.5.1.6) -->
          <div id="box-side-face" class="rounded-2xl border border-purple-200 bg-purple-50/40 p-4 dark:border-purple-950 dark:bg-slate-900/70">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-2 border-b border-purple-200/60 dark:border-slate-800">
              <div class="flex items-center gap-2">
                <input type="checkbox" id="check-side-face" class="h-4 w-4 rounded-md border-purple-300 text-purple-600 focus:ring-purple-500 cursor-pointer" />
                <label for="check-side-face" class="text-xs font-bold uppercase tracking-wider text-purple-900 dark:text-purple-300 cursor-pointer">
                  Side Face Skin Reinforcement (Required when Beam Depth D &gt; 750 mm)
                </label>
              </div>
              <span id="badge-side-face-alert" class="hidden rounded-md bg-purple-100 px-2 py-0.5 text-[10px] font-bold text-purple-800 dark:bg-purple-950 dark:text-purple-300">
                ⚠️ IS 456 Cl. 26.5.1.6 Active
              </span>
            </div>

            <div id="section-side-face-inputs" class="hidden mt-3 grid grid-cols-2 gap-3 text-xs">
              <div>
                <label for="bm-side-count" class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Bars per Side Face</label>
                <input type="number" id="bm-side-count" value="1" min="1" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
              </div>
              <div>
