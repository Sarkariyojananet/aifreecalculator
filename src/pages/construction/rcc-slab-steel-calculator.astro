---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import {
  STANDARD_REBAR_WEIGHTS,
  BARS_PER_BUNDLE,
  CONCRETE_MIX_PROPORTIONS,
} from '../../lib/calculators/rcc-slab-steel';
---

<CalculatorLayout
  title="RCC Slab Steel Calculator – Normal & Advanced BBS Slab Rebar Estimator"
  description="Free RCC slab steel calculator with Normal (CPWD thumb rule) and Advanced BBS engineering modes. Calculates One-Way vs Two-Way slabs, straight & cranked bent-up bars, 12m rebar bundles, and concrete BOQ."
  category="Construction"
  calculatorName="RCC Slab Steel Calculator"
  slug="rcc-slab-steel-calculator"
  keywords={[
    'rcc slab steel',
    'rcc slab steel calculator',
    'slab rebar calculator',
    'bar bending schedule slab',
    'one way slab steel calculation',
    'two way slab steel calculation',
    'cranked bar length slab',
    'bent up bar slab formula',
    'slab steel weight thumb rule',
    'd2 162 formula',
    'slab concrete boq'
  ]}
>
  <div class="space-y-6">

    <!-- SAFETY & ENGINEERING DISCLAIMER BANNER -->
    <div class="rounded-2xl border border-amber-200/90 bg-amber-50/70 p-4 text-xs text-amber-900 shadow-2xs dark:border-amber-900/50 dark:bg-amber-950/30 dark:text-amber-200">
      <div class="flex items-start gap-2.5">
        <span class="text-base leading-none">⚠️</span>
        <div class="leading-relaxed">
          <strong class="font-bold text-amber-950 dark:text-amber-100">Civil Engineering Notice:</strong>
          This calculator supports both <strong>Normal Site Thumb-Rule Estimation</strong> (CPWD / IS 456 preliminary rate) and <strong>Advanced Bar Bending Schedule (BBS) Detailing</strong> (One-Way / Two-Way span moments, cranked/bent-up bars, top negative support steel, and commercial 12m rebar procurement). Always verify final structural drawings with a licensed structural engineer before construction.
        </div>
      </div>
    </div>

    <!-- QUICK EXAMPLE PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft" data-len="12" data-width="10" data-thick="5" data-thick-u="in" data-cover="0.6" data-main-dia="10" data-main-sp="6" data-dist-dia="8" data-dist-sp="8">10 ft × 12 ft (Room - Two Way)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft" data-len="20" data-width="15" data-thick="5" data-thick-u="in" data-cover="0.6" data-main-dia="10" data-main-sp="6" data-dist-dia="8" data-dist-sp="7">15 ft × 20 ft (Hall - Two Way)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft" data-len="30" data-width="12" data-thick="5" data-thick-u="in" data-cover="0.75" data-main-dia="10" data-main-sp="6" data-dist-dia="8" data-dist-sp="8">12 ft × 30 ft (Verandah - One Way)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-len="6" data-width="5" data-thick="125" data-thick-u="mm" data-cover="15" data-main-dia="10" data-main-sp="150" data-dist-dia="8" data-dist-sp="200">5 m × 6 m (Metric Standard)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- HEADER & MODE TOGGLER -->
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🏗️</span> RCC Slab Steel & Material Takeoff
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Calculate rebar weight, cutting length, bar bending schedule (BBS), and concrete mix quantities.
            </p>
          </div>
          
          <!-- CALCULATION METHOD SWITCHER PILLS -->
          <div class="inline-flex rounded-xl bg-slate-200/80 p-1 dark:bg-slate-800/80 self-start sm:self-center">
            <button
              type="button"
              id="btn-mode-adv"
              class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-700 shadow-xs dark:bg-blue-600 dark:text-white transition cursor-pointer"
            >
              📐 Advanced BBS Mode
            </button>
            <button
              type="button"
              id="btn-mode-norm"
              class="rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition cursor-pointer"
            >
              ⚡ Normal (Thumb Rule)
            </button>
          </div>
        </div>
      </div>

      <form id="form-rcc" class="mt-5 space-y-5" novalidate onsubmit="return false;">
        
        <!-- SECTION 1: SLAB DIMENSIONS (COMMON) -->
        <div>
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>1.</span> Slab Dimensions & Geometry
            </h3>
            <div class="flex items-center gap-1 text-xs">
              <span class="text-slate-500 dark:text-slate-400 font-semibold mr-1">Unit:</span>
              <button type="button" id="btn-unit-m" class="btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer" data-unit="m">Meters (m)</button>
              <button type="button" id="btn-unit-ft" class="btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft">Feet (ft)</button>
            </div>
          </div>

          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-4">
            <div>
              <label for="input-slab-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Slab Length (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="input-slab-len"
                value="6.0"
                step="0.1"
                min="0.1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="input-slab-width" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Slab Width (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="input-slab-width"
                value="4.0"
                step="0.1"
                min="0.1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="input-slab-thick" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Slab Thickness (<span id="lbl-thick-unit">mm</span>)
              </label>
              <input
                type="number"
                id="input-slab-thick"
                value="125"
                step="1"
                min="1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div id="wrapper-clear-cover">
              <label for="input-slab-cover" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Clear Cover (<span id="lbl-cover-unit">mm</span>)
              </label>
              <input
                type="number"
                id="input-slab-cover"
                value="15"
                step="1"
                min="0"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- DYNAMIC SPAN RATIO & SLAB CLASSIFICATION BANNER (ADVANCED MODE) -->
        <div id="box-slab-type-banner" class="rounded-2xl border border-blue-200 bg-blue-50/70 p-3.5 text-xs text-blue-950 dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-200">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div class="flex items-center gap-2">
              <span id="badge-slab-type" class="rounded-lg bg-blue-600 px-2.5 py-1 text-[11px] font-black text-white shrink-0">
                Two-Way Slab (Ly/Lx &lt; 2.0)
              </span>
              <span id="text-slab-type-desc" class="font-semibold">
                Span ratio Ly / Lx = <strong>1.50</strong> &lt; 2.0. Both directions carry primary bending moments (IS 456 Cl. 24.4).
              </span>
            </div>
            <div class="flex items-center gap-1.5 self-end sm:self-auto">
              <label for="select-slab-type-override" class="text-[11px] font-bold text-slate-600 dark:text-slate-400">Classification:</label>
              <select id="select-slab-type-override" class="rounded-lg border border-blue-300 bg-white px-2 py-1 text-xs font-bold text-blue-900 dark:border-slate-700 dark:bg-slate-800 dark:text-blue-300 cursor-pointer">
                <option value="auto" selected>Auto Detect</option>
                <option value="two_way">Force Two-Way</option>
                <option value="one_way">Force One-Way</option>
              </select>
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- ADVANCED MODE CONTAINER -->
        <!-- ========================================================= -->
        <div id="section-adv-inputs" class="space-y-4">
          
          <!-- BAR PROFILE & REBAR DETAILING CONFIG -->
          <div class="rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/80">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-100 dark:border-slate-800">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                2. Rebar Profile & Detailing Standard
              </h3>
              <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                IS 2502 / SP 34 Detailing
              </span>
            </div>

            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div>
                <label for="select-bar-profile" class="block font-bold text-slate-700 dark:text-slate-300">
                  Bar Bending Profile
                </label>
                <select id="select-bar-profile" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="straight" selected>Straight Mesh Bars (Standard Modern Mesh)</option>
                  <option value="cranked">Alternate Cranked / Bent-Up Bars (45° Crank @ L/4)</option>
                </select>
                <p id="lbl-crank-info" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
                  ⚡ Cranked bars add +0.42×H extra length per bend to resist negative support shear.
                </p>
              </div>

              <div>
                <label for="select-concrete-grade" class="block font-bold text-slate-700 dark:text-slate-300">
                  Concrete Mix Grade
                </label>
                <select id="select-concrete-grade" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="M20" selected>M20 (1 : 1.5 : 3) – Standard Roof Slab</option>
                  <option value="M25">M25 (1 : 1 : 2) – Heavy Load / Commercial Slab</option>
                  <option value="M15">M15 (1 : 2 : 4) – Low Load / Cantilever Porch</option>
                </select>
              </div>
            </div>
          </div>

          <!-- REINFORCEMENT SPECIFICATIONS (SHORT & LONG SPAN) -->
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            
            <!-- SHORT SPAN (MAIN TENSION STEEL) -->
            <div class="rounded-2xl border border-blue-200 bg-blue-50/40 p-4 dark:border-blue-950 dark:bg-slate-900/70">
              <div class="flex items-center justify-between pb-2 border-b border-blue-200/60 dark:border-slate-800">
                <h4 class="text-xs font-bold uppercase tracking-wider text-blue-900 dark:text-blue-300 flex items-center gap-1.5">
                  <span>A.</span> Short Span Reinforcement
                </h4>
                <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
                  Primary Tension Steel
                </span>
              </div>

              <div class="mt-3 grid grid-cols-2 gap-3 text-xs">
                <div>
                  <label for="select-main-dia" class="block font-bold text-slate-700 dark:text-slate-300">Bar Diameter</label>
                  <select id="select-main-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                    <option value="6">6 mm</option>
                    <option value="8">8 mm</option>
                    <option value="10" selected>10 mm</option>
                    <option value="12">12 mm</option>
                    <option value="16">16 mm</option>
                    <option value="20">20 mm</option>
                    <option value="custom">Custom mm</option>
                  </select>
                  <input type="number" id="input-main-dia-custom" placeholder="Custom dia" class="hidden mt-1 w-full rounded-xl border border-slate-300 bg-white p-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="10" />
                </div>

                <div>
                  <label for="input-main-spacing" class="block font-bold text-slate-700 dark:text-slate-300">
                    Spacing c/c (<span class="lbl-spacing-unit">mm</span>)
                  </label>
                  <input
                    type="number"
                    id="input-main-spacing"
                    value="150"
                    step="5"
                    min="1"
                    class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>

                <div class="col-span-2">
                  <div class="rounded-xl border border-blue-200/80 bg-white/70 p-2 text-xs text-blue-950 dark:border-slate-800 dark:bg-slate-800/70 dark:text-blue-200">
                    📐 <strong>Position:</strong> Bottom outer layer along shorter span for maximum structural effective depth (<span class="font-mono">d</span>).
                  </div>
                </div>
              </div>
            </div>

            <!-- LONG SPAN (MAIN OR DISTRIBUTION STEEL) -->
            <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="flex items-center justify-between pb-2 border-b border-slate-200/60 dark:border-slate-800">
                <h4 id="lbl-long-span-title" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                  <span>B.</span> Long Span Reinforcement
                </h4>
                <span id="badge-long-span-role" class="rounded-md bg-slate-200 px-2 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  Two-Way Main Steel
                </span>
              </div>

              <div class="mt-3 grid grid-cols-2 gap-3 text-xs">
                <div>
                  <label for="select-dist-dia" class="block font-bold text-slate-700 dark:text-slate-300">Bar Diameter</label>
                  <select id="select-dist-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                    <option value="6">6 mm</option>
                    <option value="8" selected>8 mm</option>
                    <option value="10">10 mm</option>
                    <option value="12">12 mm</option>
                    <option value="16">16 mm</option>
                    <option value="20">20 mm</option>
                    <option value="custom">Custom mm</option>
                  </select>
                  <input type="number" id="input-dist-dia-custom" placeholder="Custom dia" class="hidden mt-1 w-full rounded-xl border border-slate-300 bg-white p-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="8" />
                </div>

                <div>
                  <label for="input-dist-spacing" class="block font-bold text-slate-700 dark:text-slate-300">
                    Spacing c/c (<span class="lbl-spacing-unit">mm</span>)
                  </label>
                  <input
                    type="number"
                    id="input-dist-spacing"
                    value="150"
                    step="5"
                    min="1"
                    class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>

                <div class="col-span-2">
                  <div id="lbl-long-span-desc" class="rounded-xl border border-dashed border-slate-300 bg-white/70 p-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300">
                    ⚡ Placed perpendicular to short span bars, resting on top of short span steel.
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- SECTION 3: ADVANCED STRUCTURAL ALLOWANCES ACCORDION -->
          <details class="group rounded-2xl border border-slate-200/90 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/90">
            <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              <span class="flex items-center gap-1.5">
                <span>⚙️</span> Laps, Top Support Negative Steel & Site Wastage
              </span>
              <span class="text-blue-600 dark:text-blue-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>

            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-4 text-xs pt-3 border-t border-slate-100 dark:border-slate-800">
              <div>
                <label for="select-layers" class="block font-bold text-slate-700 dark:text-slate-300">Reinforcement Mesh Layers</label>
                <select id="select-layers" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="1" selected>Single Mesh (Bottom Layer)</option>
                  <option value="2">Double Mesh (Top + Bottom Layers)</option>
                </select>
              </div>

              <div>
                <label for="input-extra-top" class="block font-bold text-slate-700 dark:text-slate-300">Top Support Extra Steel (%)</label>
                <input type="number" id="input-extra-top" value="10" min="0" max="50" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="text-[10px] text-slate-400">Over support beams (L/4 zone)</span>
              </div>

              <div>
                <label for="input-laps" class="block font-bold text-slate-700 dark:text-slate-300">Laps & Anchorage (%)</label>
                <input type="number" id="input-laps" value="5" min="0" max="25" step="0.5" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="text-[10px] text-slate-400">Splice laps & beam anchorage</span>
              </div>

              <div>
                <label for="input-wastage" class="block font-bold text-slate-700 dark:text-slate-300">Cutting Wastage (%)</label>
                <input type="number" id="input-wastage" value="3" min="0" max="25" step="0.5" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="text-[10px] text-slate-400">Site offcuts & trimming</span>
              </div>
            </div>
          </details>

        </div>

        <!-- ========================================================= -->
        <!-- NORMAL / THUMB RULE MODE CONTAINER -->
        <!-- ========================================================= -->
        <div id="section-norm-inputs" class="hidden space-y-4">
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50/40 p-4 dark:border-emerald-950 dark:bg-slate-900/70">
            <div class="flex items-center justify-between pb-3 border-b border-emerald-200/60 dark:border-slate-800">
              <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-900 dark:text-emerald-300 flex items-center gap-1.5">
                <span>⚡</span> Normal Civil Thumb-Rule Configuration
              </h3>
              <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                CPWD / IS 456 Rates
              </span>
            </div>

            <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div>
                <label for="select-norm-type" class="block font-bold text-slate-700 dark:text-slate-300">
                  Structure / Slab Type
                </label>
                <select id="select-norm-type" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="residential" selected>Standard Residential Slab (80 kg/m³ / ~1% vol)</option>
                  <option value="commercial">Commercial / Heavy Load Slab (100 kg/m³ / ~1.2% vol)</option>
                  <option value="light">Light Slab / Porch / Sunshade (70 kg/m³ / ~0.8% vol)</option>
                  <option value="custom">Custom Steel Rate (kg/m³)</option>
                </select>
              </div>

              <div id="wrapper-norm-custom-rate" class="hidden">
                <label for="input-norm-custom-rate" class="block font-bold text-slate-700 dark:text-slate-300">
