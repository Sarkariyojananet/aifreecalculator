---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { STANDARD_REBAR_WEIGHTS } from '../../lib/calculators/rcc-slab-steel';
---

<CalculatorLayout
  title="RCC Slab Steel Calculator – Calculate Slab Reinforcement Steel Quantity"
  description="Free RCC slab steel calculator. Estimate reinforcement bar count, cutting length, main & distribution rebar weight in kg, quintals, tonnes, and concrete volume with BBS steps."
  category="Construction"
  calculatorName="RCC Slab Steel Calculator"
  slug="rcc-slab-steel-calculator"
  keywords={[
    'rcc slab steel',
    'rcc slab steel calculator',
    'slab rebar calculator',
    'bar bending schedule slab',
    'slab steel weight',
    'rebar quantity slab',
    'main reinforcement slab',
    'distribution reinforcement slab',
    'steel bar weight formula',
    'd2 162 formula'
  ]}
>
  <div class="space-y-6">

    <!-- SAFETY & ENGINEERING DISCLAIMER BANNER -->
    <div class="rounded-2xl border border-amber-200/90 bg-amber-50/70 p-4 text-xs text-amber-900 shadow-2xs dark:border-amber-900/50 dark:bg-amber-950/30 dark:text-amber-200">
      <div class="flex items-start gap-2.5">
        <span class="text-base leading-none">⚠️</span>
        <div class="leading-relaxed">
          <strong class="font-bold text-amber-950 dark:text-amber-100">Engineering Safety Notice:</strong>
          This calculator is intended for <strong>preliminary material estimation and budgeting</strong> only. Final reinforcement details (bar sizes, spacing, clear cover, lap lengths, development anchorage, and structural capacity) must be designed, calculated, and stamped by a licensed structural engineer in accordance with applicable building codes (e.g., IS 456, ACI 318, Eurocode 2).
        </div>
      </div>
    </div>

    <!-- QUICK EXAMPLE PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Example Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft" data-len="12" data-width="10" data-thick="5" data-thick-u="in" data-cover="0.6" data-cover-u="in" data-main-dia="10" data-main-sp="6" data-main-sp-u="in" data-dist-dia="8" data-dist-sp="8" data-dist-sp-u="in">10 ft × 12 ft (Room)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft" data-len="20" data-width="15" data-thick="5" data-thick-u="in" data-cover="0.6" data-cover-u="in" data-main-dia="10" data-main-sp="6" data-main-sp-u="in" data-dist-dia="8" data-dist-sp="7" data-dist-sp-u="in">15 ft × 20 ft (Hall)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft" data-len="30" data-width="20" data-thick="6" data-thick-u="in" data-cover="0.75" data-cover-u="in" data-main-dia="12" data-main-sp="6" data-main-sp-u="in" data-dist-dia="10" data-dist-sp="8" data-dist-sp-u="in">20 ft × 30 ft (Floor)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-len="6" data-width="5" data-thick="125" data-thick-u="mm" data-cover="15" data-cover-u="mm" data-main-dia="10" data-main-sp="150" data-main-sp-u="mm" data-dist-dia="8" data-dist-sp="200" data-dist-sp-u="mm">5 m × 6 m (Metric)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🏗️</span> RCC Slab Steel Estimator
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Enter slab dimensions and reinforcement details, then click <strong>Calculate Steel</strong>.
            </p>
          </div>
          <span class="rounded-full bg-blue-100 px-3 py-1 text-[11px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
            IS 456 / BBS Formula
          </span>
        </div>
      </div>

      <form id="form-rcc" class="mt-5 space-y-5" novalidate onsubmit="return false;">
        
        <!-- SECTION 1: SLAB DIMENSIONS -->
        <div>
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              1. Slab Dimensions & Geometry
            </h3>
            <div class="flex items-center gap-1 text-xs">
              <span class="text-slate-500 dark:text-slate-400 font-semibold mr-1">Unit:</span>
              <button type="button" id="btn-unit-m" class="btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer" data-unit="m">Meters (m)</button>
              <button type="button" id="btn-unit-ft" class="btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft">Feet (ft)</button>
            </div>
          </div>

          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-4">
            <div>
              <label for="input-slab-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Length (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="input-slab-len"
                value="6.0"
                step="0.1"
                min="0.1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="input-slab-width" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Width (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="input-slab-width"
                value="4.0"
                step="0.1"
                min="0.1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="input-slab-thick" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Thickness (<span id="lbl-thick-unit">mm</span>)
              </label>
              <input
                type="number"
                id="input-slab-thick"
                value="125"
                step="1"
                min="1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="input-slab-cover" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Clear Cover (<span id="lbl-cover-unit">mm</span>)
              </label>
              <input
                type="number"
                id="input-slab-cover"
                value="15"
                step="1"
                min="0"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- SECTION 2: REINFORCEMENT DETAILS -->
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 pt-2 border-t border-slate-200/80 dark:border-slate-800">
          
          <!-- MAIN REINFORCEMENT -->
          <div class="rounded-2xl border border-blue-200 bg-blue-50/40 p-4 dark:border-blue-950 dark:bg-slate-900/70">
            <div class="flex items-center justify-between pb-2 border-b border-blue-200/60 dark:border-slate-800">
              <h4 class="text-xs font-bold uppercase tracking-wider text-blue-900 dark:text-blue-300">
                A. Main Reinforcement
              </h4>
              <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
                Primary Tension
              </span>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-3 text-xs">
              <div>
                <label for="select-main-dia" class="block font-bold text-slate-700 dark:text-slate-300">Bar Diameter</label>
                <select id="select-main-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="6">6 mm</option>
                  <option value="8">8 mm</option>
                  <option value="10" selected>10 mm</option>
                  <option value="12">12 mm</option>
                  <option value="16">16 mm</option>
                  <option value="20">20 mm</option>
                  <option value="custom">Custom mm</option>
                </select>
                <input type="number" id="input-main-dia-custom" placeholder="Custom dia" class="hidden mt-1 w-full rounded-xl border border-slate-300 bg-white p-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="10" />
              </div>

              <div>
                <label for="input-main-spacing" class="block font-bold text-slate-700 dark:text-slate-300">
                  Spacing c/c (<span class="lbl-spacing-unit">mm</span>)
                </label>
                <input
                  type="number"
                  id="input-main-spacing"
                  value="150"
                  step="5"
                  min="1"
                  class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>

              <div class="col-span-2">
                <label for="select-main-dir" class="block font-bold text-slate-700 dark:text-slate-300">Main Bar Direction</label>
                <select id="select-main-dir" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="short_span" selected>Along Short Span (Recommended for max moment)</option>
                  <option value="long_span">Along Long Span</option>
                </select>
              </div>
            </div>
          </div>

          <!-- DISTRIBUTION REINFORCEMENT -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200/60 dark:border-slate-800">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                B. Distribution Reinforcement
              </h4>
              <span class="rounded-md bg-slate-200 px-2 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                Perpendicular
              </span>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-3 text-xs">
              <div>
                <label for="select-dist-dia" class="block font-bold text-slate-700 dark:text-slate-300">Bar Diameter</label>
                <select id="select-dist-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="6">6 mm</option>
                  <option value="8" selected>8 mm</option>
                  <option value="10">10 mm</option>
                  <option value="12">12 mm</option>
                  <option value="16">16 mm</option>
                  <option value="20">20 mm</option>
                  <option value="custom">Custom mm</option>
                </select>
                <input type="number" id="input-dist-dia-custom" placeholder="Custom dia" class="hidden mt-1 w-full rounded-xl border border-slate-300 bg-white p-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="8" />
              </div>

              <div>
                <label for="input-dist-spacing" class="block font-bold text-slate-700 dark:text-slate-300">
                  Spacing c/c (<span class="lbl-spacing-unit">mm</span>)
                </label>
                <input
                  type="number"
                  id="input-dist-spacing"
                  value="200"
                  step="5"
                  min="1"
                  class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>

              <div class="col-span-2">
                <label class="block font-bold text-slate-500 dark:text-slate-400">Distribution Bar Direction</label>
                <div class="mt-1 rounded-xl border border-dashed border-slate-300 bg-white/70 p-2 text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300">
                  ⚡ Auto-oriented perpendicular to Main Reinforcement
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- SECTION 3: ADVANCED REINFORCEMENT OPTIONS (Expandable Accordion) -->
        <details class="group rounded-2xl border border-slate-200/90 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/90">
          <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            <span class="flex items-center gap-1.5">
              <span>⚙️</span> Advanced Reinforcement & Wastage Options (Optional)
            </span>
            <span class="text-blue-600 dark:text-blue-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>

          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-4 text-xs pt-3 border-t border-slate-100 dark:border-slate-800">
            <div>
              <label for="select-layers" class="block font-bold text-slate-700 dark:text-slate-300">Reinforcement Mesh Layers</label>
              <select id="select-layers" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="1" selected>Single Mesh (Bottom Layer)</option>
                <option value="2">Double Mesh (Top + Bottom Layers)</option>
              </select>
            </div>

            <div>
              <label for="input-wastage" class="block font-bold text-slate-700 dark:text-slate-300">Cutting Wastage (%)</label>
              <input type="number" id="input-wastage" value="0" min="0" max="25" step="0.5" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>

            <div>
              <label for="input-laps" class="block font-bold text-slate-700 dark:text-slate-300">Laps & Anchorage Allowance (%)</label>
              <input type="number" id="input-laps" value="0" min="0" max="25" step="0.5" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>

            <div>
              <label for="input-extra-top" class="block font-bold text-slate-700 dark:text-slate-300">Extra Top Support Steel (%)</label>
              <input type="number" id="input-extra-top" value="0" min="0" max="50" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>
        </details>

        <!-- ACTION BUTTONS -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button
            type="submit"
            id="btn-calc-steel"
            class="flex-1 min-w-[200px] inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
          >
            <span>Calculate Steel Quantity</span>
            <span>→</span>
          </button>
          <button
            type="button"
            id="btn-clear-rcc"
            class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
          >
            Clear (✕)
          </button>
        </div>

        <p id="err-rcc" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

      </form>
    </div>

    <!-- INITIAL PLACEHOLDER (Hidden when results are shown) -->
    <div id="results-placeholder" class="rounded-3xl border border-dashed border-slate-300 bg-slate-50/50 p-8 text-center dark:border-slate-800 dark:bg-slate-900/30">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400">
        📐
      </div>
      <p class="mt-3 text-sm font-semibold text-slate-600 dark:text-slate-400">
        Enter slab dimensions and reinforcement details, then click <strong>Calculate Steel</strong>.
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-500">
        Results will display bar counts, cutting lengths, weight in kg/quintals/tonnes, and concrete volume.
      </p>
    </div>

    <!-- CALCULATION RESULTS CONTAINER (Hidden initially) -->
    <div id="results-card" class="hidden space-y-5">
      
      <!-- HIGHLIGHT SUMMARY CARD -->
      <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/30 to-blue-100/40 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
        
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-blue-200/80 pb-4 dark:border-slate-800">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">
              RCC Slab Steel Calculation Results
            </span>
            <div class="mt-1 flex flex-wrap items-baseline gap-2">
              <span id="res-total-steel-kg" class="text-3xl sm:text-4xl font-black text-blue-600 dark:text-blue-400">-- kg</span>
              <span id="res-total-steel-other" class="text-sm sm:text-base font-bold text-slate-600 dark:text-slate-300">(-- Quintals | -- Tonnes)</span>
            </div>
          </div>
          <div class="text-left sm:text-right">
            <span class="text-xs text-slate-500 dark:text-slate-400">Concrete Volume:</span>
            <div id="res-concrete-vol-full" class="text-base font-black text-slate-900 dark:text-white">-- m³ (-- sqft)</div>
          </div>
        </div>

        <!-- Slab Geometry & Steel Intensity Indicators -->
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 text-xs">
          <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">Slab Dimensions</div>
            <div id="res-geom-dim" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">--</div>
          </div>
          <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">Slab Surface Area</div>
            <div id="res-geom-area" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">--</div>
          </div>
          <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">Steel per Area</div>
            <div id="res-intensity-area" class="mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400">--</div>
          </div>
          <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">Steel per Concrete Vol</div>
            <div id="res-intensity-vol" class="mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400">--</div>
          </div>
        </div>
      </div>

      <!-- MAIN & DISTRIBUTION BREAKDOWN CARDS -->
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        
        <!-- Main Reinforcement Card -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
            <h4 class="text-sm font-black text-slate-900 dark:text-white flex items-center gap-1.5">
              <span>🔹</span> Main Reinforcement
            </h4>
            <span id="res-main-subtotal-badge" class="rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-extrabold text-blue-700 dark:bg-blue-950 dark:text-blue-300">-- kg</span>
          </div>

          <div class="mt-3 space-y-2 text-xs">
            <div class="flex justify-between py-1 border-b border-slate-50 dark:border-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400">Bar Diameter & Spacing:</span>
              <span id="res-main-spec" class="font-bold text-slate-900 dark:text-white">--</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-50 dark:border-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400">Direction:</span>
              <span id="res-main-direction" class="font-semibold text-slate-700 dark:text-slate-300">--</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-50 dark:border-slate-800/50">
