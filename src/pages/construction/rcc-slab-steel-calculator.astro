<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  let currentDimensionUnit = 'm'; // 'm' or 'ft'

  // DOM Elements
  const btnUnitM = document.getElementById('btn-unit-m');
  const btnUnitFt = document.getElementById('btn-unit-ft');
  const lblDimUnits = document.querySelectorAll('.lbl-dim-unit');
  const lblThickUnit = document.getElementById('lbl-thick-unit');
  const lblCoverUnit = document.getElementById('lbl-cover-unit');
  const lblSpacingUnits = document.querySelectorAll('.lbl-spacing-unit');

  const inputSlabLen = document.getElementById('input-slab-len');
  const inputSlabWidth = document.getElementById('input-slab-width');
  const inputSlabThick = document.getElementById('input-slab-thick');
  const inputSlabCover = document.getElementById('input-slab-cover');

  const selectMainDia = document.getElementById('select-main-dia');
  const inputMainDiaCustom = document.getElementById('input-main-dia-custom');
  const inputMainSpacing = document.getElementById('input-main-spacing');
  const selectMainDir = document.getElementById('select-main-dir');

  const selectDistDia = document.getElementById('select-dist-dia');
  const inputDistDiaCustom = document.getElementById('input-dist-dia-custom');
  const inputDistSpacing = document.getElementById('input-dist-spacing');

  const selectLayers = document.getElementById('select-layers');
  const inputWastage = document.getElementById('input-wastage');
  const inputLaps = document.getElementById('input-laps');
  const inputExtraTop = document.getElementById('input-extra-top');

  const btnCalcSteel = document.getElementById('btn-calc-steel');
  const btnClearRcc = document.getElementById('btn-clear-rcc');
  const errRcc = document.getElementById('err-rcc');

  const resultsPlaceholder = document.getElementById('results-placeholder');
  const resultsCard = document.getElementById('results-card');

  // Results display fields
  const resTotalSteelKg = document.getElementById('res-total-steel-kg');
  const resTotalSteelOther = document.getElementById('res-total-steel-other');
  const resConcreteVolFull = document.getElementById('res-concrete-vol-full');
  const resGeomDim = document.getElementById('res-geom-dim');
  const resGeomArea = document.getElementById('res-geom-area');
  const resIntensityArea = document.getElementById('res-intensity-area');
  const resIntensityVol = document.getElementById('res-intensity-vol');

  const resMainSubtotalBadge = document.getElementById('res-main-subtotal-badge');
  const resMainSpec = document.getElementById('res-main-spec');
  const resMainDirection = document.getElementById('res-main-direction');
  const resMainBarsCount = document.getElementById('res-main-bars-count');
  const resMainCutLen = document.getElementById('res-main-cut-len');
  const resMainTotalLen = document.getElementById('res-main-total-len');
  const resMainUnitWt = document.getElementById('res-main-unit-wt');

  const resDistSubtotalBadge = document.getElementById('res-dist-subtotal-badge');
  const resDistSpec = document.getElementById('res-dist-spec');
  const resDistDirection = document.getElementById('res-dist-direction');
  const resDistBarsCount = document.getElementById('res-dist-bars-count');
  const resDistCutLen = document.getElementById('res-dist-cut-len');
  const resDistTotalLen = document.getElementById('res-dist-total-len');
  const resDistUnitWt = document.getElementById('res-dist-unit-wt');

  const resStepsContent = document.getElementById('res-steps-content');

  // Custom Dia toggle
  selectMainDia.addEventListener('change', () => {
    if (selectMainDia.value === 'custom') {
      inputMainDiaCustom.classList.remove('hidden');
    } else {
      inputMainDiaCustom.classList.add('hidden');
    }
  });

  selectDistDia.addEventListener('change', () => {
    if (selectDistDia.value === 'custom') {
      inputDistDiaCustom.classList.remove('hidden');
    } else {
      inputDistDiaCustom.classList.add('hidden');
    }
  });

  // Unit Switcher
  function setUnit(unit) {
    if (currentDimensionUnit === unit) return;
    currentDimensionUnit = unit;

    if (unit === 'ft') {
      btnUnitFt.className = 'btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
      btnUnitM.className = 'btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      lblDimUnits.forEach((el) => (el.textContent = 'ft'));
      lblThickUnit.textContent = 'in';
      lblCoverUnit.textContent = 'in';
      lblSpacingUnits.forEach((el) => (el.textContent = 'in'));

      // Convert default values to imperial
      const curL = parseFloat(inputSlabLen.value) || 6;
      const curW = parseFloat(inputSlabWidth.value) || 4;
      inputSlabLen.value = (curL * 3.28084).toFixed(1);
      inputSlabWidth.value = (curW * 3.28084).toFixed(1);
      inputSlabThick.value = '5.0';
      inputSlabCover.value = '0.6';
      inputMainSpacing.value = '6.0';
      inputDistSpacing.value = '8.0';
    } else {
      btnUnitM.className = 'btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
      btnUnitFt.className = 'btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      lblDimUnits.forEach((el) => (el.textContent = 'm'));
      lblThickUnit.textContent = 'mm';
      lblCoverUnit.textContent = 'mm';
      lblSpacingUnits.forEach((el) => (el.textContent = 'mm'));

      const curL = parseFloat(inputSlabLen.value) || 20;
      const curW = parseFloat(inputSlabWidth.value) || 13;
      inputSlabLen.value = (curL * 0.3048).toFixed(1);
      inputSlabWidth.value = (curW * 0.3048).toFixed(1);
      inputSlabThick.value = '125';
      inputSlabCover.value = '15';
      inputMainSpacing.value = '150';
      inputDistSpacing.value = '200';
    }

    errRcc.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
  }

  btnUnitM.addEventListener('click', () => setUnit('m'));
  btnUnitFt.addEventListener('click', () => setUnit('ft'));

  // Preset buttons
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const u = btn.getAttribute('data-unit');
      setUnit(u);

      inputSlabLen.value = btn.getAttribute('data-len');
      inputSlabWidth.value = btn.getAttribute('data-width');
      inputSlabThick.value = btn.getAttribute('data-thick');
      inputSlabCover.value = btn.getAttribute('data-cover');

      selectMainDia.value = btn.getAttribute('data-main-dia');
      inputMainDiaCustom.classList.add('hidden');
      inputMainSpacing.value = btn.getAttribute('data-main-sp');

      selectDistDia.value = btn.getAttribute('data-dist-dia');
      inputDistDiaCustom.classList.add('hidden');
      inputDistSpacing.value = btn.getAttribute('data-dist-sp');

      executeCalculation();
    });
  });

  // Calculation Logic
  function executeCalculation() {
    const rawLen = parseFloat(inputSlabLen.value);
    const rawWidth = parseFloat(inputSlabWidth.value);
    const rawThick = parseFloat(inputSlabThick.value);
    const rawCover = parseFloat(inputSlabCover.value);

    if (isNaN(rawLen) || isNaN(rawWidth) || rawLen <= 0 || rawWidth <= 0) {
      errRcc.textContent = 'Please enter valid slab Length and Width greater than zero.';
      errRcc.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    if (isNaN(rawThick) || rawThick <= 0) {
      errRcc.textContent = 'Please enter a valid slab thickness greater than zero.';
      errRcc.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    // Convert inputs to metric for uniform BBS engine
    const isFt = currentDimensionUnit === 'ft';
    const lengthM = isFt ? rawLen * 0.3048 : rawLen;
    const widthM = isFt ? rawWidth * 0.3048 : rawWidth;
    const thicknessMm = isFt ? rawThick * 25.4 : rawThick;
    const coverMm = isFt ? rawCover * 25.4 : rawCover;
    const coverM = coverMm / 1000;

    // Check if cover exceeds slab thickness
    if (coverMm * 2 >= thicknessMm) {
      errRcc.textContent = 'Clear cover from both sides exceeds total slab thickness. Please check cover values.';
      errRcc.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    // Main bar diameter & spacing
    let mainDia = selectMainDia.value === 'custom' ? parseFloat(inputMainDiaCustom.value) : parseFloat(selectMainDia.value);
    let mainSpacingMm = isFt ? (parseFloat(inputMainSpacing.value) || 6) * 25.4 : (parseFloat(inputMainSpacing.value) || 150);

    if (isNaN(mainDia) || mainDia <= 0) mainDia = 10;
    if (isNaN(mainSpacingMm) || mainSpacingMm <= 0) mainSpacingMm = 150;

    // Dist bar diameter & spacing
    let distDia = selectDistDia.value === 'custom' ? parseFloat(inputDistDiaCustom.value) : parseFloat(selectDistDia.value);
    let distSpacingMm = isFt ? (parseFloat(inputDistSpacing.value) || 8) * 25.4 : (parseFloat(inputDistSpacing.value) || 200);

    if (isNaN(distDia) || distDia <= 0) distDia = 8;
    if (isNaN(distSpacingMm) || distSpacingMm <= 0) distSpacingMm = 200;

    errRcc.classList.add('hidden');

    const longSpanM = Math.max(lengthM, widthM);
    const shortSpanM = Math.min(lengthM, widthM);
    const isShortMain = selectMainDir.value === 'short_span';

    const mainSpanM = isShortMain ? shortSpanM : longSpanM;
    const mainDistributeSpanM = isShortMain ? longSpanM : shortSpanM;

    const distSpanM = isShortMain ? longSpanM : shortSpanM;
    const distDistributeSpanM = isShortMain ? shortSpanM : longSpanM;

    // Unit weights (D² / 162)
    const mainUnitWt = (mainDia * mainDia) / 162;
    const distUnitWt = (distDia * distDia) / 162;

    // Main bars
    const mainAvailDistM = Math.max(0, mainDistributeSpanM - 2 * coverM);
    const mainBarsCount = Math.ceil((mainAvailDistM * 1000) / mainSpacingMm) + 1;
    const mainHookLengthM = 2 * (9 * mainDia / 1000);
    const mainCutLenM = Math.max(0, mainSpanM - 2 * coverM + mainHookLengthM);
    const mainTotalLenM = mainBarsCount * mainCutLenM;
    const mainTotalWtKg = mainTotalLenM * mainUnitWt;

    // Distribution bars
    const distAvailDistM = Math.max(0, distDistributeSpanM - 2 * coverM);
    const distBarsCount = Math.ceil((distAvailDistM * 1000) / distSpacingMm) + 1;
    const distHookLengthM = 2 * (9 * distDia / 1000);
    const distCutLenM = Math.max(0, distSpanM - 2 * coverM + distHookLengthM);
    const distTotalLenM = distBarsCount * distCutLenM;
    const distTotalWtKg = distTotalLenM * distUnitWt;

    // Advanced additions
    const layers = parseInt(selectLayers.value, 10) || 1;
    const baseSteelKg = (mainTotalWtKg + distTotalWtKg) * layers;
    const extraTopPct = parseFloat(inputExtraTop.value) || 0;
    const lapsPct = parseFloat(inputLaps.value) || 0;
    const wastagePct = parseFloat(inputWastage.value) || 0;

    const extraTopKg = baseSteelKg * (Math.max(0, extraTopPct) / 100);
    const lapsKg = baseSteelKg * (Math.max(0, lapsPct) / 100);
    const subtotalKg = baseSteelKg + extraTopKg + lapsKg;
    const wastageKg = subtotalKg * (Math.max(0, wastagePct) / 100);
    const finalTotalSteelKg = subtotalKg + wastageKg;

    // Slab area & concrete volume
    const slabAreaSqm = lengthM * widthM;
    const slabAreaSqft = slabAreaSqm * 10.7639;
    const concreteVolCum = slabAreaSqm * (thicknessMm / 1000);

    const steelPerSqm = slabAreaSqm > 0 ? (finalTotalSteelKg / slabAreaSqm).toFixed(2) : '0';
    const steelPerSqft = slabAreaSqft > 0 ? (finalTotalSteelKg / slabAreaSqft).toFixed(3) : '0';
    const steelPerCum = concreteVolCum > 0 ? (finalTotalSteelKg / concreteVolCum).toFixed(1) : '0';

    // Populate Results Display
    resTotalSteelKg.textContent = `${finalTotalSteelKg.toFixed(1)} kg`;
    resTotalSteelOther.textContent = `(${(finalTotalSteelKg / 100).toFixed(2)} Quintals | ${(finalTotalSteelKg / 1000).toFixed(3)} Tonnes)`;
    resConcreteVolFull.textContent = `${concreteVolCum.toFixed(2)} m³ (${slabAreaSqft.toFixed(0)} sq ft area)`;

    resGeomDim.textContent = isFt ? `${rawLen} ft × ${rawWidth} ft (${thicknessMm.toFixed(0)} mm / ${rawThick} in thick)` : `${lengthM.toFixed(2)} m × ${widthM.toFixed(2)} m (${thicknessMm.toFixed(0)} mm thick)`;
    resGeomArea.textContent = `${slabAreaSqm.toFixed(2)} m² (${slabAreaSqft.toFixed(0)} sqft)`;
    resIntensityArea.textContent = `${steelPerSqm} kg/m² (${steelPerSqft} kg/sqft)`;
    resIntensityVol.textContent = `${steelPerCum} kg/m³ of concrete`;

    // Main Reinforcement card
    resMainSubtotalBadge.textContent = `${mainTotalWtKg.toFixed(1)} kg`;
    resMainSpec.textContent = `${mainDia} mm dia @ ${mainSpacingMm.toFixed(0)} mm c/c`;
    resMainDirection.textContent = isShortMain ? 'Along Short Span' : 'Along Long Span';
    resMainBarsCount.textContent = `${mainBarsCount} Bars`;
    resMainCutLen.textContent = `${mainCutLenM.toFixed(2)} m (${(mainCutLenM * 3.28084).toFixed(2)} ft)`;
    resMainTotalLen.textContent = `${mainTotalLenM.toFixed(1)} m`;
    resMainUnitWt.textContent = `${mainUnitWt.toFixed(3)} kg/m`;

    // Distribution Reinforcement card
    resDistSubtotalBadge.textContent = `${distTotalWtKg.toFixed(1)} kg`;
    resDistSpec.textContent = `${distDia} mm dia @ ${distSpacingMm.toFixed(0)} mm c/c`;
    resDistDirection.textContent = isShortMain ? 'Along Long Span' : 'Along Short Span';
    resDistBarsCount.textContent = `${distBarsCount} Bars`;
    resDistCutLen.textContent = `${distCutLenM.toFixed(2)} m (${(distCutLenM * 3.28084).toFixed(2)} ft)`;
    resDistTotalLen.textContent = `${distTotalLenM.toFixed(1)} m`;
    resDistUnitWt.textContent = `${distUnitWt.toFixed(3)} kg/m`;

    // Worked Steps Content
    resStepsContent.innerHTML = `
      <div class="text-blue-600 dark:text-blue-400 font-bold mb-2">--- 1. Main Reinforcement (${mainDia} mm dia) ---</div>
      <div>• Distribution Span = ${mainDistributeSpanM.toFixed(3)} m - 2 × (${coverMm} mm / 1000) = ${mainAvailDistM.toFixed(3)} m (${(mainAvailDistM * 1000).toFixed(0)} mm)</div>
      <div>• Number of Bars = ⌈${(mainAvailDistM * 1000).toFixed(0)} mm ÷ ${mainSpacingMm.toFixed(0)} mm⌉ + 1 = ${mainBarsCount} Bars</div>
      <div>• Cutting Length = ${mainSpanM.toFixed(3)} m - 2 × (${coverMm} mm / 1000) + 2 × (9 × ${mainDia} mm / 1000) = ${mainCutLenM.toFixed(3)} m</div>
      <div>• Total Length = ${mainBarsCount} Bars × ${mainCutLenM.toFixed(3)} m = ${mainTotalLenM.toFixed(2)} m</div>
      <div>• Unit Weight = ${mainDia}² ÷ 162 = ${mainUnitWt.toFixed(3)} kg/m</div>
      <div>• Main Steel Weight = ${mainTotalLenM.toFixed(2)} m × ${mainUnitWt.toFixed(3)} kg/m = ${mainTotalWtKg.toFixed(2)} kg</div>

      <div class="text-emerald-600 dark:text-emerald-400 font-bold mt-3 mb-2">--- 2. Distribution Reinforcement (${distDia} mm dia) ---</div>
      <div>• Distribution Span = ${distDistributeSpanM.toFixed(3)} m - 2 × (${coverMm} mm / 1000) = ${distAvailDistM.toFixed(3)} m (${(distAvailDistM * 1000).toFixed(0)} mm)</div>
      <div>• Number of Bars = ⌈${(distAvailDistM * 1000).toFixed(0)} mm ÷ ${distSpacingMm.toFixed(0)} mm⌉ + 1 = ${distBarsCount} Bars</div>
      <div>• Cutting Length = ${distSpanM.toFixed(3)} m - 2 × (${coverMm} mm / 1000) + 2 × (9 × ${distDia} mm / 1000) = ${distCutLenM.toFixed(3)} m</div>
      <div>• Total Length = ${distBarsCount} Bars × ${distCutLenM.toFixed(3)} m = ${distTotalLenM.toFixed(2)} m</div>
      <div>• Unit Weight = ${distDia}² ÷ 162 = ${distUnitWt.toFixed(3)} kg/m</div>
      <div>• Distribution Steel Weight = ${distTotalLenM.toFixed(2)} m × ${distUnitWt.toFixed(3)} kg/m = ${distTotalWtKg.toFixed(2)} kg</div>

      <div class="text-purple-600 dark:text-purple-400 font-bold mt-3 mb-2">--- 3. Total Steel & Allowances ---</div>
      <div>• Base Steel (Single Mesh) = ${mainTotalWtKg.toFixed(2)} kg + ${distTotalWtKg.toFixed(2)} kg = ${(mainTotalWtKg + distTotalWtKg).toFixed(2)} kg</div>
      ${layers > 1 ? `<div>• Mesh Multiplier (${layers} layers) = ${(mainTotalWtKg + distTotalWtKg).toFixed(2)} × ${layers} = ${baseSteelKg.toFixed(2)} kg</div>` : ''}
      ${extraTopPct > 0 ? `<div>• Extra Top Steel (${extraTopPct}%) = +${extraTopKg.toFixed(2)} kg</div>` : ''}
      ${lapsPct > 0 ? `<div>• Lapping / Anchorage (${lapsPct}%) = +${lapsKg.toFixed(2)} kg</div>` : ''}
      ${wastagePct > 0 ? `<div>• Cutting Wastage (${wastagePct}%) = +${wastageKg.toFixed(2)} kg</div>` : ''}
      <div class="font-bold text-slate-900 dark:text-white pt-1">👉 Final Estimated Total Steel = ${finalTotalSteelKg.toFixed(2)} kg (${(finalTotalSteelKg / 100).toFixed(2)} Quintals / ${(finalTotalSteelKg / 1000).toFixed(3)} Tonnes)</div>
    `;

    resultsPlaceholder.classList.add('hidden');
    resultsCard.classList.remove('hidden');
  }

  btnCalcSteel.addEventListener('click', (e) => {
    e.preventDefault();
    executeCalculation();
  });

  [inputSlabLen, inputSlabWidth, inputSlabThick, inputSlabCover, inputMainSpacing, inputDistSpacing, inputMainDiaCustom, inputDistDiaCustom, inputWastage, inputLaps, inputExtraTop].forEach((inp) => {
    inp.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeCalculation();
      }
    });
  });

  btnClearRcc.addEventListener('click', () => {
    if (currentDimensionUnit === 'm') {
      inputSlabLen.value = '6.0';
      inputSlabWidth.value = '4.0';
      inputSlabThick.value = '125';
      inputSlabCover.value = '15';
      inputMainSpacing.value = '150';
      inputDistSpacing.value = '200';
    } else {
      inputSlabLen.value = '20.0';
      inputSlabWidth.value = '13.0';
      inputSlabThick.value = '5.0';
      inputSlabCover.value = '0.6';
      inputMainSpacing.value = '6.0';
      inputDistSpacing.value = '8.0';
    }

    selectMainDia.value = '10';
    inputMainDiaCustom.classList.add('hidden');
    selectDistDia.value = '8';
    inputDistDiaCustom.classList.add('hidden');
    selectMainDir.value = 'short_span';
    selectLayers.value = '1';
    inputWastage.value = '0';
    inputLaps.value = '0';
    inputExtraTop.value = '0';

    errRcc.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
    inputSlabLen.focus();
  });
</script>
