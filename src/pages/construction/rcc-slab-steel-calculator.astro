      boxSlabTypeBanner.classList.remove('hidden');
      wrapperClearCover.classList.remove('hidden');
      resAdvCards.classList.remove('hidden');
      resModeBadge.textContent = 'BBS Detailing';
      updateSlabTypeBadge();
    } else {
      btnModeNorm.className = 'rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-emerald-700 shadow-xs dark:bg-emerald-600 dark:text-white transition cursor-pointer';
      btnModeAdv.className = 'rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition cursor-pointer';
      sectionAdvInputs.classList.add('hidden');
      sectionNormInputs.classList.remove('hidden');
      boxSlabTypeBanner.classList.add('hidden');
      wrapperClearCover.classList.add('hidden');
      resAdvCards.classList.add('hidden');
      resModeBadge.textContent = 'Normal Thumb-Rule';
    }

    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
    errRcc.classList.add('hidden');
  }

  btnModeAdv.addEventListener('click', () => setCalculationMode('adv'));
  btnModeNorm.addEventListener('click', () => setCalculationMode('norm'));

  // Custom Dia Toggles
  selectMainDia.addEventListener('change', () => {
    inputMainDiaCustom.classList.toggle('hidden', selectMainDia.value !== 'custom');
  });
  selectDistDia.addEventListener('change', () => {
    inputDistDiaCustom.classList.toggle('hidden', selectDistDia.value !== 'custom');
  });

  // Normal mode custom rate toggle
  selectNormType.addEventListener('change', () => {
    wrapperNormCustomRate.classList.toggle('hidden', selectNormType.value !== 'custom');
  });

  // Unit Switcher
  function setUnit(unit) {
    if (currentDimensionUnit === unit) return;
    currentDimensionUnit = unit;

    if (unit === 'ft') {
      btnUnitFt.className = 'btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
      btnUnitM.className = 'btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      lblDimUnits.forEach((el) => (el.textContent = 'ft'));
      lblThickUnit.textContent = 'in';
      lblCoverUnit.textContent = 'in';
      lblSpacingUnits.forEach((el) => (el.textContent = 'in'));

      const curL = parseFloat(inputSlabLen.value) || 6;
      const curW = parseFloat(inputSlabWidth.value) || 4;
      inputSlabLen.value = (curL * 3.28084).toFixed(1);
      inputSlabWidth.value = (curW * 3.28084).toFixed(1);
      inputSlabThick.value = '5.0';
      inputSlabCover.value = '0.6';
      inputMainSpacing.value = '6.0';
      inputDistSpacing.value = '6.0';
    } else {
      btnUnitM.className = 'btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
      btnUnitFt.className = 'btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      lblDimUnits.forEach((el) => (el.textContent = 'm'));
      lblThickUnit.textContent = 'mm';
      lblCoverUnit.textContent = 'mm';
      lblSpacingUnits.forEach((el) => (el.textContent = 'mm'));

      const curL = parseFloat(inputSlabLen.value) || 20;
      const curW = parseFloat(inputSlabWidth.value) || 13;
      inputSlabLen.value = (curL * 0.3048).toFixed(1);
      inputSlabWidth.value = (curW * 0.3048).toFixed(1);
      inputSlabThick.value = '125';
      inputSlabCover.value = '15';
      inputMainSpacing.value = '150';
      inputDistSpacing.value = '150';
    }

    updateSlabTypeBadge();
    errRcc.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
  }

  btnUnitM.addEventListener('click', () => setUnit('m'));
  btnUnitFt.addEventListener('click', () => setUnit('ft'));

  // Quick Preset Buttons
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      setUnit(btn.getAttribute('data-unit'));
      inputSlabLen.value = btn.getAttribute('data-len');
      inputSlabWidth.value = btn.getAttribute('data-width');
      inputSlabThick.value = btn.getAttribute('data-thick');
      inputSlabCover.value = btn.getAttribute('data-cover');

      selectMainDia.value = btn.getAttribute('data-main-dia');
      inputMainDiaCustom.classList.add('hidden');
      inputMainSpacing.value = btn.getAttribute('data-main-sp');

      selectDistDia.value = btn.getAttribute('data-dist-dia');
      inputDistDiaCustom.classList.add('hidden');
      inputDistSpacing.value = btn.getAttribute('data-dist-sp');

      updateSlabTypeBadge();
      executeCalculation();
    });
  });

  // CORE CALCULATION ENGINE
  function executeCalculation() {
    const rawLen = parseFloat(inputSlabLen.value);
    const rawWidth = parseFloat(inputSlabWidth.value);
    const rawThick = parseFloat(inputSlabThick.value);
    const rawCover = parseFloat(inputSlabCover.value);

    if (isNaN(rawLen) || isNaN(rawWidth) || rawLen <= 0 || rawWidth <= 0) {
      errRcc.textContent = 'Please enter valid positive numbers for slab Length and Width.';
      errRcc.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    if (isNaN(rawThick) || rawThick <= 0) {
      errRcc.textContent = 'Please enter a valid positive slab thickness.';
      errRcc.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    const isFt = currentDimensionUnit === 'ft';
    const lengthM = isFt ? rawLen * 0.3048 : rawLen;
    const widthM = isFt ? rawWidth * 0.3048 : rawWidth;
    const thicknessMm = isFt ? rawThick * 25.4 : rawThick;
    const coverMm = isFt ? rawCover * 25.4 : rawCover;
    const coverM = coverMm / 1000;

    const slabAreaSqm = lengthM * widthM;
    const slabAreaSqft = slabAreaSqm * 10.7639;
    const concreteVolCum = slabAreaSqm * (thicknessMm / 1000);
    const concreteVolCuft = concreteVolCum * 35.3147;

    // Shuttering
    const soffitAreaSqm = slabAreaSqm;
    const sideFormworkSqm = 2 * (lengthM + widthM) * (thicknessMm / 1000);
    const totalShutteringSqm = soffitAreaSqm + sideFormworkSqm;
    const totalShutteringSqft = totalShutteringSqm * 10.7639;

    errRcc.classList.add('hidden');

    if (currentCalculationMode === 'norm') {
      // -------------------------------------------------------------
      // NORMAL / THUMB RULE CALCULATION
      // -------------------------------------------------------------
      let steelRate = 80;
      const type = selectNormType.value;
      if (type === 'residential') steelRate = 80;
      else if (type === 'commercial') steelRate = 100;
      else if (type === 'light') steelRate = 70;
      else if (type === 'custom') steelRate = Math.max(10, parseFloat(inputNormCustomRate.value) || 80);

      const wastagePct = parseFloat(inputNormWastage.value) || 0;
      const baseSteelKg = concreteVolCum * steelRate;
      const wastageKg = baseSteelKg * (Math.max(0, wastagePct) / 100);
      const totalSteelKg = baseSteelKg + wastageKg;
      const primaryDia = parseInt(selectNormBarDia.value, 10) || 10;
      const unitWt = getBarUnitWeight(primaryDia);
      const wt12m = unitWt * 12;
      const rods12m = wt12m > 0 ? Math.ceil(totalSteelKg / wt12m) : 0;
      const bundlePacking = BARS_PER_BUNDLE[primaryDia] || 7;
      const bundles = (rods12m / bundlePacking).toFixed(1);
      const bindingWireKg = Math.max(1, totalSteelKg * 0.01);

      // Mix BOQ (Exact dry factor 1.54 & nominal ratio calculation)
      const mixGrade = selectNormMix.value;
      const mixBreakup = calculateMixBreakup(concreteVolCum, mixGrade, 1.54);
      const cementBags = mixBreakup.cementBags;
      const sandCum = mixBreakup.sandVolumeM3;
      const sandCuft = mixBreakup.sandVolumeCft;
      const aggCum = mixBreakup.aggVolumeM3;
      const aggCuft = mixBreakup.aggVolumeCft;

      // Populate Highlights
      resTotalSteelKg.textContent = `${totalSteelKg.toFixed(1)} kg`;
      resTotalSteelOther.textContent = `(${(totalSteelKg / 100).toFixed(2)} Quintals | ${(totalSteelKg / 1000).toFixed(3)} Tonnes)`;
      resConcreteVolFull.textContent = `${concreteVolCum.toFixed(2)} m³ (${concreteVolCuft.toFixed(1)} cu ft)`;
      resShutteringTopBadge.textContent = `Shuttering: ${totalShutteringSqm.toFixed(1)} m² (${totalShutteringSqft.toFixed(0)} sq ft)`;

      resGeomDim.textContent = isFt ? `${rawLen} ft × ${rawWidth} ft (${thicknessMm.toFixed(0)} mm thick)` : `${lengthM.toFixed(2)} m × ${widthM.toFixed(2)} m (${thicknessMm.toFixed(0)} mm thick)`;
      resGeomArea.textContent = `${slabAreaSqm.toFixed(2)} m² (${slabAreaSqft.toFixed(0)} sq ft)`;
      resIntensityArea.textContent = `${(totalSteelKg / slabAreaSqm).toFixed(2)} kg/m² (${(totalSteelKg / slabAreaSqft).toFixed(3)} kg/sqft)`;
      resIntensityVol.textContent = `${steelRate.toFixed(0)} kg/m³ of concrete`;

      // Procurement Table for Normal mode
      tbodyProcurement.innerHTML = `
        <tr>
          <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">${primaryDia} mm TMT Rebar</td>
          <td class="py-2.5 px-3 font-bold">${totalSteelKg.toFixed(1)} kg</td>
          <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">${rods12m} Rods (12m each)</td>
          <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">${bundlePacking} bars / bundle</td>
          <td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">${bundles} Bundles</td>
        </tr>
      `;
      resBindingWire.textContent = `${bindingWireKg.toFixed(1)} kg`;

      // BOQ
      resBoqCement.textContent = `${cementBags} Bags`;
      resBoqSand.textContent = `${sandCum.toFixed(2)} m³`;
      resBoqSandCft.textContent = `${sandCuft.toFixed(1)} cft (Dry mix)`;
      resBoqAgg.textContent = `${aggCum.toFixed(2)} m³`;
      resBoqAggCft.textContent = `${aggCuft.toFixed(1)} cft (Coarse 20mm)`;
      resBoqShuttering.textContent = `${totalShutteringSqm.toFixed(1)} m²`;
      resBoqShutteringSqft.textContent = `${totalShutteringSqft.toFixed(1)} sq ft (Soffit + Edges)`;

      // Worked Steps
      resStepsContent.innerHTML = `
        <div class="text-emerald-600 dark:text-emerald-400 font-bold mb-2">--- Normal Site Thumb-Rule Calculation (CPWD / IS 456) ---</div>
        <div>• Slab Surface Area = ${lengthM.toFixed(3)} m × ${widthM.toFixed(3)} m = ${slabAreaSqm.toFixed(3)} m² (${slabAreaSqft.toFixed(2)} sq ft)</div>
        <div>• Wet Concrete Volume = ${slabAreaSqm.toFixed(3)} m² × (${thicknessMm.toFixed(0)} mm / 1000) = ${concreteVolCum.toFixed(3)} m³ (${concreteVolCuft.toFixed(2)} cu ft)</div>
        <div>• Steel Rate = ${steelRate} kg per m³ of concrete (${type === 'residential' ? 'Standard residential slab' : type})</div>
        <div>• Base Steel Required = ${concreteVolCum.toFixed(3)} m³ × ${steelRate} kg/m³ = ${baseSteelKg.toFixed(2)} kg</div>
        ${wastagePct > 0 ? `<div>• Cutting Wastage (${wastagePct}%) = +${wastageKg.toFixed(2)} kg</div>` : ''}
        <div class="font-bold text-slate-900 dark:text-white pt-1">👉 Total Estimated Steel = ${totalSteelKg.toFixed(2)} kg (${(totalSteelKg / 100).toFixed(2)} Quintals / ${(totalSteelKg / 1000).toFixed(3)} Tonnes)</div>
        <div class="mt-2 text-blue-600 dark:text-blue-400 font-bold">• Commercial Takeoff (${primaryDia} mm bars):</div>
        <div>• Weight of one 12m standard rod = ${primaryDia}² ÷ 162 × 12m = ${wt12m.toFixed(2)} kg</div>
        <div>• Total 12-meter Rods = ⌈${totalSteelKg.toFixed(2)} kg ÷ ${wt12m.toFixed(2)} kg⌉ = ${rods12m} Commercial Rods (${bundles} bundles @ ${bundlePacking} bars/bundle)</div>
        <div>• Binding Wire = approx 1% of steel = ${bindingWireKg.toFixed(1)} kg</div>
        <div class="mt-2 text-amber-600 dark:text-amber-400 font-bold">• Concrete Mix BOQ (${mixBreakup.mixLabel}):</div>
        <div>• Dry Concrete Volume = ${concreteVolCum.toFixed(3)} m³ × 1.54 = ${mixBreakup.dryVolumeM3.toFixed(3)} m³</div>
        <div>• Total Mix Ratio = ${mixBreakup.totalRatio}</div>
        <div>• Cement Volume = ${mixBreakup.dryVolumeM3.toFixed(3)} m³ × (1 ÷ ${mixBreakup.totalRatio}) = ${mixBreakup.cementVolumeM3.toFixed(3)} m³</div>
        <div>• Cement Weight = ${mixBreakup.cementVolumeM3.toFixed(3)} m³ × 1440 kg/m³ = ${mixBreakup.cementWeightKg.toFixed(1)} kg</div>
        <div>• Cement Bags (50kg) = ⌈${mixBreakup.cementWeightKg.toFixed(1)} kg ÷ 50 kg⌉ = ${cementBags} Bags (${mixBreakup.cementBagsExact.toFixed(1)} bags exact)</div>
        <div>• Sand (Fine Agg) = ${sandCum.toFixed(2)} m³ (${sandCuft.toFixed(1)} cu ft) | Coarse Agg = ${aggCum.toFixed(2)} m³ (${aggCuft.toFixed(1)} cu ft)</div>
      `;

    } else {
      // -------------------------------------------------------------
      // ADVANCED BBS ENGINEERING CALCULATION
      // -------------------------------------------------------------
      if (coverMm * 2 >= thicknessMm) {
        errRcc.textContent = 'Clear cover from top & bottom exceeds slab thickness. Please check cover & thickness.';
        errRcc.classList.remove('hidden');
        resultsCard.classList.add('hidden');
        return;
      }

      const longSpanM = Math.max(lengthM, widthM);
      const shortSpanM = Math.min(lengthM, widthM);
      const ratio = shortSpanM > 0 ? longSpanM / shortSpanM : 1;

      const override = selectSlabTypeOverride.value;
      let isTwoWay = ratio < 2.0;
      if (override === 'two_way') isTwoWay = true;
      if (override === 'one_way') isTwoWay = false;

      const barProfile = selectBarProfile.value; // 'straight' or 'cranked'

      // Main Bar (Short Span)
      let mainDia = selectMainDia.value === 'custom' ? parseFloat(inputMainDiaCustom.value) : parseFloat(selectMainDia.value);
      let mainSpacingMm = isFt ? (parseFloat(inputMainSpacing.value) || 6) * 25.4 : (parseFloat(inputMainSpacing.value) || 150);
      if (isNaN(mainDia) || mainDia <= 0) mainDia = 10;
      if (isNaN(mainSpacingMm) || mainSpacingMm <= 0) mainSpacingMm = 150;

      // Long Span Bar
      let distDia = selectDistDia.value === 'custom' ? parseFloat(inputDistDiaCustom.value) : parseFloat(selectDistDia.value);
      let distSpacingMm = isFt ? (parseFloat(inputDistSpacing.value) || 6) * 25.4 : (parseFloat(inputDistSpacing.value) || 150);
      if (isNaN(distDia) || distDia <= 0) distDia = 8;
      if (isNaN(distSpacingMm) || distSpacingMm <= 0) distSpacingMm = 150;

      const effH_Mm = Math.max(0, thicknessMm - 2 * coverMm - mainDia);
      const crankExtraLenM = (0.42 * effH_Mm) / 1000; // per crank

      // Short Span Bars (Distributed across Long Span)
      const shortDistributeMm = Math.max(0, longSpanM * 1000 - 2 * coverMm);
      const shortBarsCount = Math.ceil(shortDistributeMm / mainSpacingMm) + 1;
      const shortHookM = 2 * (9 * (mainDia / 1000));
      const shortStraightCutM = Math.max(0, shortSpanM - 2 * coverM + shortHookM);
      const shortCrankedCutM = shortStraightCutM + (barProfile === 'cranked' ? 2 * crankExtraLenM : 0);

      let shortStraightBars = shortBarsCount;
      let shortCrankedBars = 0;
      if (barProfile === 'cranked') {
        shortCrankedBars = Math.floor(shortBarsCount / 2);
        shortStraightBars = shortBarsCount - shortCrankedBars;
      }
      const shortTotalLenM = shortStraightBars * shortStraightCutM + shortCrankedBars * shortCrankedCutM;
      const shortUnitWt = getBarUnitWeight(mainDia);
      const shortTotalWtKg = shortTotalLenM * shortUnitWt;

      // Long Span Bars (Distributed across Short Span)
      const distDistributeMm = Math.max(0, shortSpanM * 1000 - 2 * coverMm);
      const longBarsCount = Math.ceil(distDistributeMm / distSpacingMm) + 1;
      const longHookM = 2 * (9 * (distDia / 1000));
      const longStraightCutM = Math.max(0, longSpanM - 2 * coverM + longHookM);
      const longCrankedCutM = longStraightCutM + (barProfile === 'cranked' ? 2 * crankExtraLenM : 0);

      let longStraightBars = longBarsCount;
      let longCrankedBars = 0;
      if (barProfile === 'cranked') {
        longCrankedBars = Math.floor(longBarsCount / 2);
        longStraightBars = longBarsCount - longCrankedBars;
      }
      const longTotalLenM = longStraightBars * longStraightCutM + longCrankedBars * longCrankedCutM;
      const distUnitWt = getBarUnitWeight(distDia);
      const longTotalWtKg = longTotalLenM * distUnitWt;

      // Allowances
      const layers = parseInt(selectLayers.value, 10) || 1;
      const baseSteelKg = (shortTotalWtKg + longTotalWtKg) * layers;
      const extraTopPct = parseFloat(inputExtraTop.value) || 0;
      const lapsPct = parseFloat(inputLaps.value) || 0;
      const wastagePct = parseFloat(inputWastage.value) || 0;

      const extraTopKg = baseSteelKg * (Math.max(0, extraTopPct) / 100);
      const lapsKg = baseSteelKg * (Math.max(0, lapsPct) / 100);
      const subtotalKg = baseSteelKg + extraTopKg + lapsKg;
      const wastageKg = subtotalKg * (Math.max(0, wastagePct) / 100);
      const totalSteelKg = subtotalKg + wastageKg;

      // Highlights
      resTotalSteelKg.textContent = `${totalSteelKg.toFixed(1)} kg`;
      resTotalSteelOther.textContent = `(${(totalSteelKg / 100).toFixed(2)} Quintals | ${(totalSteelKg / 1000).toFixed(3)} Tonnes)`;
      resConcreteVolFull.textContent = `${concreteVolCum.toFixed(2)} m³ (${concreteVolCuft.toFixed(1)} cu ft)`;
      resShutteringTopBadge.textContent = `Shuttering: ${totalShutteringSqm.toFixed(1)} m² (${totalShutteringSqft.toFixed(0)} sq ft)`;

      resGeomDim.textContent = isFt ? `${rawLen} ft × ${rawWidth} ft (${thicknessMm.toFixed(0)} mm thick)` : `${lengthM.toFixed(2)} m × ${widthM.toFixed(2)} m (${thicknessMm.toFixed(0)} mm thick)`;
      resGeomArea.textContent = `${slabAreaSqm.toFixed(2)} m² (${slabAreaSqft.toFixed(0)} sq ft)`;
      resIntensityArea.textContent = `${(totalSteelKg / slabAreaSqm).toFixed(2)} kg/m² (${(totalSteelKg / slabAreaSqft).toFixed(3)} kg/sqft)`;
      resIntensityVol.textContent = `${(totalSteelKg / concreteVolCum).toFixed(1)} kg/m³ of concrete`;

      // Short Span Card
      resShortSubtotalBadge.textContent = `${shortTotalWtKg.toFixed(1)} kg`;
      resShortSpec.textContent = `${mainDia} mm dia @ ${mainSpacingMm.toFixed(0)} mm c/c`;
      resShortBarsCount.textContent = `${shortBarsCount} Bars`;
      resShortBarTypes.textContent = barProfile === 'cranked' ? `${shortStraightBars} Straight + ${shortCrankedBars} Cranked` : `${shortBarsCount} Straight Mesh Bars`;
      resShortCutLen.textContent = barProfile === 'cranked' ? `Str: ${shortStraightCutM.toFixed(2)}m / Crk: ${shortCrankedCutM.toFixed(2)}m` : `${shortStraightCutM.toFixed(2)} m (${(shortStraightCutM * 3.28084).toFixed(2)} ft)`;
      resShortTotalLen.textContent = `${shortTotalLenM.toFixed(1)} m`;
      resShortUnitWt.textContent = `${shortUnitWt.toFixed(3)} kg/m`;

      // Long Span Card
      resLongCardTitle.innerHTML = isTwoWay ? '<span>🔸</span> Long Span Main Reinforcement' : '<span>🔸</span> Long Span Distribution Steel';
      resLongSubtotalBadge.textContent = `${longTotalWtKg.toFixed(1)} kg`;
      resLongSpec.textContent = `${distDia} mm dia @ ${distSpacingMm.toFixed(0)} mm c/c`;
      resLongBarsCount.textContent = `${longBarsCount} Bars`;
      resLongBarTypes.textContent = barProfile === 'cranked' ? `${longStraightBars} Straight + ${longCrankedBars} Cranked` : `${longBarsCount} Straight Mesh Bars`;
      resLongCutLen.textContent = barProfile === 'cranked' ? `Str: ${longStraightCutM.toFixed(2)}m / Crk: ${longCrankedCutM.toFixed(2)}m` : `${longStraightCutM.toFixed(2)} m (${(longStraightCutM * 3.28084).toFixed(2)} ft)`;
      resLongTotalLen.textContent = `${longTotalLenM.toFixed(1)} m`;
      resLongUnitWt.textContent = `${distUnitWt.toFixed(3)} kg/m`;

      // BBS Table construction
      let bbsRows = '';
      if (barProfile === 'straight') {
        bbsRows += `
          <tr>
            <td class="py-2 px-2.5 font-bold text-blue-600 dark:text-blue-400">B1</td>
            <td class="py-2 px-2.5 font-semibold">Short Span Main Bottom Bars</td>
            <td class="py-2 px-2.5">${mainDia} mm</td>
            <td class="py-2 px-2.5">Straight with 90° hooks</td>
            <td class="py-2 px-2.5 font-bold">${shortBarsCount}</td>
            <td class="py-2 px-2.5 font-mono">${shortStraightCutM.toFixed(2)} m</td>
            <td class="py-2 px-2.5 font-mono">${shortTotalLenM.toFixed(1)} m</td>
            <td class="py-2 px-2.5 font-bold text-slate-900 dark:text-white">${shortTotalWtKg.toFixed(1)} kg</td>
          </tr>
          <tr>
            <td class="py-2 px-2.5 font-bold text-slate-600 dark:text-slate-400">B2</td>
            <td class="py-2 px-2.5 font-semibold">${isTwoWay ? 'Long Span Main Bottom Bars' : 'Long Span Distribution Bars'}</td>
            <td class="py-2 px-2.5">${distDia} mm</td>
            <td class="py-2 px-2.5">Straight with 90° hooks</td>
            <td class="py-2 px-2.5 font-bold">${longBarsCount}</td>
            <td class="py-2 px-2.5 font-mono">${longStraightCutM.toFixed(2)} m</td>
            <td class="py-2 px-2.5 font-mono">${longTotalLenM.toFixed(1)} m</td>
            <td class="py-2 px-2.5 font-bold text-slate-900 dark:text-white">${longTotalWtKg.toFixed(1)} kg</td>
          </tr>
        `;
      } else {
        bbsRows += `
          <tr>
            <td class="py-2 px-2.5 font-bold text-blue-600 dark:text-blue-400">B1-S</td>
            <td class="py-2 px-2.5 font-semibold">Short Span Straight Bars</td>
            <td class="py-2 px-2.5">${mainDia} mm</td>
            <td class="py-2 px-2.5">Straight (90° hooks)</td>
            <td class="py-2 px-2.5 font-bold">${shortStraightBars}</td>
            <td class="py-2 px-2.5 font-mono">${shortStraightCutM.toFixed(2)} m</td>
            <td class="py-2 px-2.5 font-mono">${(shortStraightBars * shortStraightCutM).toFixed(1)} m</td>
            <td class="py-2 px-2.5 font-bold text-slate-900 dark:text-white">${(shortStraightBars * shortStraightCutM * shortUnitWt).toFixed(1)} kg</td>
          </tr>
          <tr>
            <td class="py-2 px-2.5 font-bold text-blue-600 dark:text-blue-400">B1-C</td>
            <td class="py-2 px-2.5 font-semibold">Short Span Cranked Bars (Bent-up @ 45°)</td>
            <td class="py-2 px-2.5">${mainDia} mm</td>
            <td class="py-2 px-2.5">Double Cranked (45°)</td>
            <td class="py-2 px-2.5 font-bold">${shortCrankedBars}</td>
            <td class="py-2 px-2.5 font-mono">${shortCrankedCutM.toFixed(2)} m</td>
            <td class="py-2 px-2.5 font-mono">${(shortCrankedBars * shortCrankedCutM).toFixed(1)} m</td>
            <td class="py-2 px-2.5 font-bold text-slate-900 dark:text-white">${(shortCrankedBars * shortCrankedCutM * shortUnitWt).toFixed(1)} kg</td>
          </tr>
          <tr>
            <td class="py-2 px-2.5 font-bold text-slate-600 dark:text-slate-400">B2-S</td>
            <td class="py-2 px-2.5 font-semibold">${isTwoWay ? 'Long Span Straight Bars' : 'Long Span Dist Straight'}</td>
            <td class="py-2 px-2.5">${distDia} mm</td>
            <td class="py-2 px-2.5">Straight (90° hooks)</td>
            <td class="py-2 px-2.5 font-bold">${longStraightBars}</td>
            <td class="py-2 px-2.5 font-mono">${longStraightCutM.toFixed(2)} m</td>
            <td class="py-2 px-2.5 font-mono">${(longStraightBars * longStraightCutM).toFixed(1)} m</td>
            <td class="py-2 px-2.5 font-bold text-slate-900 dark:text-white">${(longStraightBars * longStraightCutM * distUnitWt).toFixed(1)} kg</td>
          </tr>
          <tr>
            <td class="py-2 px-2.5 font-bold text-slate-600 dark:text-slate-400">B2-C</td>
            <td class="py-2 px-2.5 font-semibold">${isTwoWay ? 'Long Span Cranked Bars (Bent-up @ 45°)' : 'Long Span Dist Cranked'}</td>
            <td class="py-2 px-2.5">${distDia} mm</td>
            <td class="py-2 px-2.5">Double Cranked (45°)</td>
            <td class="py-2 px-2.5 font-bold">${longCrankedBars}</td>
            <td class="py-2 px-2.5 font-mono">${longCrankedCutM.toFixed(2)} m</td>
            <td class="py-2 px-2.5 font-mono">${(longCrankedBars * longCrankedCutM).toFixed(1)} m</td>
            <td class="py-2 px-2.5 font-bold text-slate-900 dark:text-white">${(longCrankedBars * longCrankedCutM * distUnitWt).toFixed(1)} kg</td>
          </tr>
        `;
      }

      if (extraTopKg > 0) {
        bbsRows += `
          <tr>
            <td class="py-2 px-2.5 font-bold text-purple-600 dark:text-purple-400">T-EXT</td>
            <td class="py-2 px-2.5 font-semibold">Top Support Negative Extra Steel (L/4 Zone)</td>
            <td class="py-2 px-2.5">${mainDia} mm</td>
            <td class="py-2 px-2.5">Top Extra Curtailment</td>
            <td class="py-2 px-2.5 font-bold">--</td>
            <td class="py-2 px-2.5 font-mono">L/4 = ${(shortSpanM / 4).toFixed(2)} m</td>
            <td class="py-2 px-2.5 font-mono">${(extraTopKg / shortUnitWt).toFixed(1)} m</td>
            <td class="py-2 px-2.5 font-bold text-slate-900 dark:text-white">${extraTopKg.toFixed(1)} kg</td>
          </tr>
        `;
      }
      tbodyBbsItems.innerHTML = bbsRows;

      // Procurement Table (By Diameter)
      const diaMap = new Map();
      diaMap.set(mainDia, (diaMap.get(mainDia) || 0) + shortTotalWtKg + extraTopKg);
      diaMap.set(distDia, (diaMap.get(distDia) || 0) + longTotalWtKg);

      const grossRatio = baseSteelKg > 0 ? totalSteelKg / baseSteelKg : 1.0;
      let procRows = '';
      diaMap.forEach((baseWt, d) => {
        const grossWt = baseWt * grossRatio;
        const uWt = getBarUnitWeight(d);
        const wt12 = uWt * 12;
        const rods = wt12 > 0 ? Math.ceil(grossWt / wt12) : 0;
        const pack = BARS_PER_BUNDLE[d] || 7;
        const bndl = (rods / pack).toFixed(1);
        procRows += `
          <tr>
            <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">${d} mm TMT Rebar</td>
            <td class="py-2.5 px-3 font-bold">${grossWt.toFixed(1)} kg</td>
            <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">${rods} Rods (12m each)</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">${pack} bars / bundle</td>
            <td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">${bndl} Bundles</td>
          </tr>
        `;
      });
      tbodyProcurement.innerHTML = procRows;
      resBindingWire.textContent = `${(Math.max(1, totalSteelKg * 0.01)).toFixed(1)} kg`;

      // BOQ (Exact dry factor 1.54 & nominal ratio calculation)
      const mixGrade = selectConcreteGrade.value;
      const mixBreakup = calculateMixBreakup(concreteVolCum, mixGrade, 1.54);
      const cementBags = mixBreakup.cementBags;
      const sandCum = mixBreakup.sandVolumeM3;
      const sandCuft = mixBreakup.sandVolumeCft;
      const aggCum = mixBreakup.aggVolumeM3;
      const aggCuft = mixBreakup.aggVolumeCft;

      resBoqCement.textContent = `${cementBags} Bags`;
      resBoqSand.textContent = `${sandCum.toFixed(2)} m³`;
      resBoqSandCft.textContent = `${sandCuft.toFixed(1)} cft (Dry mix)`;
      resBoqAgg.textContent = `${aggCum.toFixed(2)} m³`;
      resBoqAggCft.textContent = `${aggCuft.toFixed(1)} cft (Coarse 20mm)`;
      resBoqShuttering.textContent = `${totalShutteringSqm.toFixed(1)} m²`;
      resBoqShutteringSqft.textContent = `${totalShutteringSqft.toFixed(1)} sq ft (Soffit + Edges)`;

      // Worked Steps
      resStepsContent.innerHTML = `
        <div class="text-blue-600 dark:text-blue-400 font-bold mb-1">--- 1. Structural Classification (IS 456 Cl. 24) ---</div>
        <div>• Span Ratio = Ly / Lx = ${longSpanM.toFixed(3)} m ÷ ${shortSpanM.toFixed(3)} m = ${ratio.toFixed(2)}</div>
        <div>• Slab Type = ${isTwoWay ? 'Two-Way Slab (Ly/Lx < 2.0) – Bending active in both directions' : 'One-Way Slab (Ly/Lx ≥ 2.0) – Primary bending along short span'}</div>
        <div>• Bar Profile = ${barProfile === 'cranked' ? `Alternate Cranked (45° Bent-up @ L/4, extra length = 2 × 0.42 × ${effH_Mm.toFixed(0)}mm = ${(2 * crankExtraLenM).toFixed(3)}m)` : 'Straight Mesh Bars with 90° Hooks'}</div>

        <div class="text-blue-600 dark:text-blue-400 font-bold mt-3 mb-1">--- 2. Short Span Reinforcement (${mainDia} mm dia @ ${mainSpacingMm.toFixed(0)} mm c/c) ---</div>
        <div>• Distribution Span = ${longSpanM.toFixed(3)} m - 2 × (${coverMm} mm / 1000) = ${(shortDistributeMm / 1000).toFixed(3)} m</div>
        <div>• Number of Bars = ⌈${shortDistributeMm.toFixed(0)} mm ÷ ${mainSpacingMm.toFixed(0)} mm⌉ + 1 = ${shortBarsCount} Bars</div>
        <div>• Straight Cutting Length = ${shortSpanM.toFixed(3)} m - 2 × (${coverMm} / 1000) + 2 × (9 × ${mainDia} / 1000) = ${shortStraightCutM.toFixed(3)} m</div>
        ${barProfile === 'cranked' ? `<div>• Cranked Cutting Length = ${shortStraightCutM.toFixed(3)} m + ${(2 * crankExtraLenM).toFixed(3)} m = ${shortCrankedCutM.toFixed(3)} m</div>` : ''}
        <div>• Total Length = ${shortTotalLenM.toFixed(2)} m | Weight = ${shortTotalLenM.toFixed(2)} m × ${shortUnitWt.toFixed(3)} kg/m = ${shortTotalWtKg.toFixed(2)} kg</div>

        <div class="text-emerald-600 dark:text-emerald-400 font-bold mt-3 mb-1">--- 3. Long Span Reinforcement (${distDia} mm dia @ ${distSpacingMm.toFixed(0)} mm c/c) ---</div>
        <div>• Distribution Span = ${shortSpanM.toFixed(3)} m - 2 × (${coverMm} mm / 1000) = ${(distDistributeMm / 1000).toFixed(3)} m</div>
        <div>• Number of Bars = ⌈${distDistributeMm.toFixed(0)} mm ÷ ${distSpacingMm.toFixed(0)} mm⌉ + 1 = ${longBarsCount} Bars</div>
        <div>• Cutting Length = ${longSpanM.toFixed(3)} m - 2 × (${coverMm} / 1000) + 2 × (9 × ${distDia} / 1000) = ${longStraightCutM.toFixed(3)} m</div>
        <div>• Total Length = ${longTotalLenM.toFixed(2)} m | Weight = ${longTotalLenM.toFixed(2)} m × ${distUnitWt.toFixed(3)} kg/m = ${longTotalWtKg.toFixed(2)} kg</div>

        <div class="text-purple-600 dark:text-purple-400 font-bold mt-3 mb-1">--- 4. Allowances & Total Steel Takeoff ---</div>
        <div>• Base Mesh Steel (${layers} layer${layers > 1 ? 's' : ''}) = ${baseSteelKg.toFixed(2)} kg</div>
        ${extraTopPct > 0 ? `<div>• Top Support Extra Negative Steel (${extraTopPct}%) = +${extraTopKg.toFixed(2)} kg</div>` : ''}
        ${lapsPct > 0 ? `<div>• Lapping & Anchorage Allowance (${lapsPct}%) = +${lapsKg.toFixed(2)} kg</div>` : ''}
        ${wastagePct > 0 ? `<div>• Cutting Wastage (${wastagePct}%) = +${wastageKg.toFixed(2)} kg</div>` : ''}
        <div class="font-bold text-slate-900 dark:text-white pt-1">👉 Final Total Steel Required = ${totalSteelKg.toFixed(2)} kg (${(totalSteelKg / 100).toFixed(2)} Quintals / ${(totalSteelKg / 1000).toFixed(3)} Tonnes)</div>

        <div class="text-amber-600 dark:text-amber-400 font-bold mt-3 mb-1">--- 5. Concrete Mix Material Breakdown (${mixBreakup.mixLabel}) ---</div>
        <div>• Wet Concrete Volume = ${concreteVolCum.toFixed(3)} m³</div>
        <div>• Dry Volume = Wet Volume × 1.54 = ${mixBreakup.dryVolumeM3.toFixed(3)} m³</div>
        <div>• Total Mix Ratio = ${mixBreakup.totalRatio}</div>
        <div>• Cement Volume = ${mixBreakup.dryVolumeM3.toFixed(3)} m³ × (1 ÷ ${mixBreakup.totalRatio}) = ${mixBreakup.cementVolumeM3.toFixed(3)} m³</div>
        <div>• Cement Weight = ${mixBreakup.cementVolumeM3.toFixed(3)} m³ × 1440 kg/m³ = ${mixBreakup.cementWeightKg.toFixed(1)} kg</div>
        <div>• Cement Bags (50kg) = ⌈${mixBreakup.cementWeightKg.toFixed(1)} kg ÷ 50 kg⌉ = ${cementBags} Bags (${mixBreakup.cementBagsExact.toFixed(1)} bags exact)</div>
        <div>• Sand (Fine Agg) = ${sandCum.toFixed(2)} m³ (${sandCuft.toFixed(1)} cu ft) | Coarse Agg = ${aggCum.toFixed(2)} m³ (${aggCuft.toFixed(1)} cu ft)</div>
      `;
    }

    resultsPlaceholder.classList.add('hidden');
    resultsCard.classList.remove('hidden');
    resultsCard.scrollIntoView({ behavior: 'smooth', block: 'start' });

    // DISPATCH EVENT FOR CALCULATOR ACTION BAR (Copy, CSV, Preview, Save)
    document.dispatchEvent(new CustomEvent('calculator:updated'));
  }

  // Calculate Button
  btnCalcSteel.addEventListener('click', (e) => {
    e.preventDefault();
    executeCalculation();
  });

  // Enter Key Handler
  [inputSlabLen, inputSlabWidth, inputSlabThick, inputSlabCover, inputMainSpacing, inputDistSpacing, inputMainDiaCustom, inputDistDiaCustom, inputWastage, inputLaps, inputExtraTop, inputNormCustomRate, inputNormWastage].forEach((inp) => {
    inp.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeCalculation();
      }
    });
  });

  // Clear Button
  btnClearRcc.addEventListener('click', () => {
    if (currentDimensionUnit === 'm') {
      inputSlabLen.value = '6.0';
      inputSlabWidth.value = '4.0';
      inputSlabThick.value = '125';
      inputSlabCover.value = '15';
      inputMainSpacing.value = '150';
      inputDistSpacing.value = '150';
    } else {
      inputSlabLen.value = '20.0';
      inputSlabWidth.value = '13.0';
      inputSlabThick.value = '5.0';
      inputSlabCover.value = '0.6';
      inputMainSpacing.value = '6.0';
      inputDistSpacing.value = '6.0';
    }

    selectMainDia.value = '10';
    inputMainDiaCustom.classList.add('hidden');
    selectDistDia.value = '8';
    inputDistDiaCustom.classList.add('hidden');
    selectBarProfile.value = 'straight';
    selectSlabTypeOverride.value = 'auto';
    selectLayers.value = '1';
    inputExtraTop.value = '10';
    inputLaps.value = '5';
    inputWastage.value = '3';

    selectNormType.value = 'residential';
    wrapperNormCustomRate.classList.add('hidden');
    inputNormCustomRate.value = '80';
    selectNormBarDia.value = '10';
    inputNormWastage.value = '3';

    updateSlabTypeBadge();
    errRcc.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
    inputSlabLen.focus();

    document.dispatchEvent(new CustomEvent('calculator:updated'));
  });

  // Run initial preview setup on DOM load
  document.addEventListener('DOMContentLoaded', () => {
    updateSlabTypeBadge();
  });
  updateSlabTypeBadge();
</script>
