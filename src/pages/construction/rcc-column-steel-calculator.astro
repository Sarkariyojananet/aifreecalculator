---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import {
  STANDARD_REBAR_WEIGHTS,
  BARS_PER_BUNDLE,
  CONCRETE_MIX_PROPORTIONS,
} from '../../lib/calculators/rcc-column-steel';
---

<CalculatorLayout
  title="RCC Column Steel Calculator – Normal & Advanced BBS Rebar Estimator"
  description="Free RCC column steel calculator with Normal (CPWD thumb rule) and Advanced BBS engineering modes. Calculates vertical main bars, lap length, 135° seismic tie rings, inner diamond/cross links (IS 456), 2-zone ductile confinement (IS 13920), circular columns, 12m commercial rebar bundles, shuttering, and concrete mix BOQ."
  category="Construction"
  calculatorName="RCC Column Steel Calculator"
  slug="rcc-column-steel-calculator"
  keywords={[
    'rcc column steel',
    'rcc column steel calculator',
    'column bbs',
    'column bar bending schedule',
    'column tie rings',
    'column stirrups cutting length',
    'vertical rebar column',
    'circular column rebar',
    'is 13920 column detailing',
    'column thumb rule steel',
    'column shuttering area',
    'column rebar 12m rods'
  ]}
>
  <div class="space-y-6">

    <!-- SAFETY & ENGINEERING DISCLAIMER BANNER -->
    <div class="rounded-2xl border border-amber-200/90 bg-amber-50/70 p-4 text-xs text-amber-900 shadow-2xs dark:border-amber-900/50 dark:bg-amber-950/30 dark:text-amber-200">
      <div class="flex items-start gap-2.5">
        <span class="text-base leading-none">⚠️</span>
        <div class="leading-relaxed">
          <strong class="font-bold text-amber-950 dark:text-amber-100">Civil Engineering Notice:</strong>
          This calculator provides both <strong>Normal Site Thumb-Rule Estimation</strong> (CPWD / IS 456 rate: 1.5%–3.5% steel or 120–275 kg/m³) and <strong>Advanced Bar Bending Schedule (BBS) Detailing</strong> (IS 456 & IS 13920:2016 ductile earthquake detailing with top/bottom confinement zones L₀, inner diamond ties/cross links, lap joggles, circular hoops, and commercial 12m stock rebar takeoff). Always verify final structural drawings with a licensed structural engineer before rebar cutting.
        </div>
      </div>
    </div>

    <!-- QUICK EXAMPLE PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-shape="rectangular" data-h="3.0" data-w="230" data-d="230" data-main-c="4" data-main-d="12" data-tie-d="8" data-tie-mode="uniform" data-tie-uni="150" data-inner="false">9" × 9" Residential (4 bars 12mm)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-shape="rectangular" data-h="3.0" data-w="230" data-d="300" data-main-c="6" data-main-d="16" data-tie-d="8" data-tie-mode="two_zone" data-tie-conf="100" data-tie-mid="150" data-inner="true">9" × 12" Standard G+1 (6 bars 16mm)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-shape="rectangular" data-h="3.2" data-w="300" data-d="300" data-main-c="8" data-main-d="16" data-tie-d="8" data-tie-mode="two_zone" data-tie-conf="100" data-tie-mid="150" data-inner="true">12" × 12" Square (8 bars 16mm + Diamond)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-shape="rectangular" data-h="3.5" data-w="300" data-d="450" data-main-c="8" data-main-d="20" data-tie-d="8" data-tie-mode="two_zone" data-tie-conf="100" data-tie-mid="150" data-inner="true">12" × 18" Heavy (8 bars 20mm + Diamond)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-shape="circular" data-h="3.0" data-w="300" data-d="300" data-main-c="6" data-main-d="16" data-tie-d="8" data-tie-mode="two_zone" data-tie-conf="100" data-tie-mid="150" data-inner="false">12" (300mm) Circular (6 bars 16mm)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="m" data-shape="circular" data-h="3.5" data-w="450" data-d="450" data-main-c="8" data-main-d="20" data-tie-d="8" data-tie-mode="two_zone" data-tie-conf="100" data-tie-mid="150" data-inner="false">18" (450mm) Circular (8 bars 20mm)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- HEADER & MODE TOGGLER -->
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🏛️</span> RCC Column Steel & Material Takeoff
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Calculate longitudinal rebars, lap length, lateral ties, commercial 12m bundles, and concrete mix quantities.
            </p>
          </div>
          
          <!-- CALCULATION METHOD SWITCHER PILLS -->
          <div class="inline-flex rounded-xl bg-slate-200/80 p-1 dark:bg-slate-800/80 self-start sm:self-center">
            <button
              type="button"
              id="btn-mode-adv"
              class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-700 shadow-xs dark:bg-blue-600 dark:text-white transition cursor-pointer"
            >
              📐 Advanced BBS Mode
            </button>
            <button
              type="button"
              id="btn-mode-norm"
              class="rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition cursor-pointer"
            >
              ⚡ Normal (Thumb Rule)
            </button>
          </div>
        </div>
      </div>

      <form id="form-rcc-column" class="mt-5 space-y-5" novalidate onsubmit="return false;">
        
        <!-- SECTION 1: COLUMN SHAPE & GEOMETRY (COMMON) -->
        <div>
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>1.</span> Column Shape & Dimensions
            </h3>
            <div class="flex items-center gap-1 text-xs">
              <span class="text-slate-500 dark:text-slate-400 font-semibold mr-1">Unit:</span>
              <button type="button" id="btn-unit-m" class="btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer" data-unit="m">Metric (m / mm)</button>
              <button type="button" id="btn-unit-ft" class="btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft">Imperial (ft / in)</button>
            </div>
          </div>

          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            <div>
              <label for="col-shape" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Column Shape
              </label>
              <select id="col-shape" class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer">
                <option value="rectangular" selected>Rectangular / Square</option>
                <option value="circular">Circular (Round)</option>
              </select>
            </div>

            <div>
              <label for="col-height" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Floor Height H (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="col-height"
                value="3.0"
                step="0.1"
                min="0.5"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="col-w" id="lbl-col-w" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Width B (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="col-w"
                value="300"
                step="25"
                min="100"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div id="box-col-d">
              <label for="col-d" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Depth D (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="col-d"
                value="300"
                step="25"
                min="100"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="col-cover" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Clear Cover (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="col-cover"
                value="40"
                step="5"
                min="20"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="col-count" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                No. of Columns
              </label>
              <input
                type="number"
                id="col-count"
                value="1"
                step="1"
                min="1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- ADVANCED MODE CONTAINER -->
        <!-- ========================================================= -->
        <div id="section-adv-inputs" class="space-y-4">
          
          <!-- CONFIG & REBAR DETAILING SPECIFICATIONS -->
          <div class="rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/80">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-100 dark:border-slate-800">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                2. Rebar Detailing Standard & Concrete Mix
              </h3>
              <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                IS 456:2000 & IS 13920:2016
              </span>
            </div>

            <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div>
                <label for="select-concrete-grade" class="block font-bold text-slate-700 dark:text-slate-300">
                  Concrete Mix Grade
                </label>
                <select id="select-concrete-grade" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="M20" selected>M20 (1 : 1.5 : 3) – Standard Column</option>
                  <option value="M25">M25 (1 : 1 : 2) – Heavy Load / Commercial Column</option>
                  <option value="M15">M15 (1 : 2 : 4) – Low Load / Boundary Post</option>
                </select>
              </div>

              <div>
                <label for="select-floor-condition" class="block font-bold text-slate-700 dark:text-slate-300">
                  Floor Level Condition
                </label>
                <select id="select-floor-condition" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="floor_lap" selected>Standard Intermediate Floor (50d Lap)</option>
                  <option value="ground_starter">Ground / Footing Starter (+300mm L-Bend)</option>
                  <option value="top_roof">Top Roof Floor (Anchored into Roof Beam)</option>
                </select>
              </div>

              <div>
                <label for="input-wastage" class="block font-bold text-slate-700 dark:text-slate-300">
                  Cutting & Site Wastage (%)
                </label>
                <input
                  type="number"
                  id="input-wastage"
                  value="3"
                  min="0"
                  max="15"
                  step="0.5"
                  class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
            </div>
          </div>

          <!-- VERTICAL MAIN REINFORCEMENT & LATERAL TIES -->
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            
            <!-- MAIN VERTICAL BARS CARD -->
            <div class="rounded-2xl border border-blue-200 bg-blue-50/40 p-4 dark:border-blue-950 dark:bg-slate-900/70">
              <div class="flex items-center justify-between pb-2 border-b border-blue-200/60 dark:border-slate-800">
                <h4 class="text-xs font-bold uppercase tracking-wider text-blue-900 dark:text-blue-300 flex items-center gap-1.5">
                  <span>A.</span> Main Longitudinal Vertical Rebar
                </h4>
                <span id="badge-min-bars-rule" class="rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
                  Min 4 Bars (Rect) / 6 (Circ)
                </span>
              </div>

              <div class="mt-3 grid grid-cols-2 gap-3 text-xs">
                <div>
                  <label for="col-main-count" class="block font-bold text-slate-700 dark:text-slate-300">Number of Vertical Bars</label>
                  <select id="col-main-count" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                    <option value="4" selected>4 Bars (Corner Only)</option>
                    <option value="6">6 Bars (Standard Rect / Circ)</option>
                    <option value="8">8 Bars (Heavy / Square)</option>
                    <option value="10">10 Bars</option>
                    <option value="12">12 Bars (Heavy Commercial)</option>
                  </select>
                </div>

                <div>
                  <label for="col-main-dia" class="block font-bold text-slate-700 dark:text-slate-300">Bar Diameter (mm)</label>
                  <select id="col-main-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                    <option value="12">12 mm (Light Residential)</option>
                    <option value="16" selected>16 mm (Standard)</option>
                    <option value="20">20 mm (High Load)</option>
                    <option value="25">25 mm (Heavy Column)</option>
                    <option value="32">32 mm</option>
                  </select>
                </div>

                <div class="col-span-2">
                  <div class="rounded-xl border border-blue-200/80 bg-white/70 p-2 text-xs text-blue-950 dark:border-slate-800 dark:bg-slate-800/70 dark:text-blue-200">
                    📐 <strong>IS 456 Cl. 26.5.3.1:</strong> Longitudinal steel shall be not less than <strong>0.8%</strong> nor more than <strong>4.0%</strong> of gross concrete cross-sectional area.
                  </div>
                </div>
              </div>
            </div>

            <!-- LATERAL TIES / STIRRUPS DETAILING -->
            <div class="rounded-2xl border border-amber-200 bg-amber-50/40 p-4 dark:border-amber-950 dark:bg-slate-900/70">
              <div class="flex items-center justify-between pb-2 border-b border-amber-200/60 dark:border-slate-800">
                <h4 class="text-xs font-bold uppercase tracking-wider text-amber-900 dark:text-amber-300 flex items-center gap-1.5">
                  <span>B.</span> Lateral Ties (Rings & Inner Links)
                </h4>
                <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                  135° Seismic Hooks
                </span>
              </div>

              <div class="mt-3 space-y-3 text-xs">
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="col-tie-dia" class="block font-bold text-slate-700 dark:text-slate-300">Tie Ring Dia</label>
                    <select id="col-tie-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                      <option value="8" selected>8 mm (Standard)</option>
                      <option value="10">10 mm (Heavy)</option>
                    </select>
                  </div>

                  <div>
                    <label for="col-tie-mode" class="block font-bold text-slate-700 dark:text-slate-300">Spacing Detailing</label>
                    <select id="col-tie-mode" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                      <option value="two_zone" selected>2-Zone Ductile (IS 13920)</option>
                      <option value="uniform">Uniform Throughout</option>
                    </select>
                  </div>
                </div>

                <div id="box-tie-spacing-uniform" class="hidden">
                  <label for="col-tie-spacing-uniform" class="block font-bold text-slate-700 dark:text-slate-300">Tie Spacing (<span class="lbl-sec-unit">mm</span>)</label>
                  <input type="number" id="col-tie-spacing-uniform" value="150" step="10" min="50" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>

                <div id="box-tie-spacing-twozone" class="grid grid-cols-2 gap-2">
                  <div>
                    <label for="col-tie-spacing-conf" class="block font-bold text-slate-700 dark:text-slate-300">Confinement L₀ (Top & Bot)</label>
                    <input type="number" id="col-tie-spacing-conf" value="100" step="10" min="50" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                  </div>
                  <div>
                    <label for="col-tie-spacing-mid" class="block font-bold text-slate-700 dark:text-slate-300">Middle Zone Spacing</label>
                    <input type="number" id="col-tie-spacing-mid" value="150" step="10" min="50" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                  </div>
                </div>

                <!-- INNER TIES / DIAMOND LINKS (FOR 6, 8, 12 BARS) -->
                <div id="box-inner-ties" class="pt-2 border-t border-amber-200/60 dark:border-slate-800">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" id="check-inner-ties" checked class="h-4 w-4 rounded-md border-amber-300 text-amber-600 focus:ring-amber-500 cursor-pointer" />
                      <label for="check-inner-ties" class="font-bold text-slate-700 dark:text-slate-300 cursor-pointer">
                        Include Inner Diamond Tie / Cross Links
                      </label>
                    </div>
                    <span class="text-[10px] text-amber-700 dark:text-amber-300 font-semibold">IS 456 Cl. 26.5.3.2</span>
                  </div>
                  <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
                    Required when &gt; 4 bars are present to provide lateral restraint against bar buckling.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- NORMAL / THUMB RULE MODE CONTAINER -->
        <!-- ========================================================= -->
        <div id="section-norm-inputs" class="hidden space-y-4">
          <div class="rounded-2xl border border-blue-200 bg-blue-50/50 p-4 text-xs text-blue-900 dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-200">
            <strong>⚡ CPWD / IS 456 Preliminary Thumb-Rule Mode:</strong>
            Instant material takeoff based on standard structural column steel consumption rates without needing detailed bar placements.
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/80 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div>
                <label for="select-norm-type" class="block font-bold text-slate-700 dark:text-slate-300">
                  Column Type & Steel Rate
                </label>
                <select id="select-norm-type" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="light">Light / 1-Story Residential (1.5% = 120 kg/m³)</option>
                  <option value="standard" selected>Standard G+1 / G+2 Column (2.5% = 195 kg/m³)</option>
                  <option value="heavy">Heavy Commercial / Multi-Story (3.5% = 275 kg/m³)</option>
                  <option value="custom">Custom Rate (kg/m³)</option>
                </select>
              </div>

              <div id="box-norm-custom-rate" class="hidden">
                <label for="input-norm-custom-rate" class="block font-bold text-slate-700 dark:text-slate-300">
                  Custom Steel Rate (kg/m³)
                </label>
