    color: #0f172a;
  }

  .rcc-column-steel-content h2:first-child {
    margin-top: 0;
  }

  .rcc-column-steel-content h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.625rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: #1e293b;
  }

  .rcc-column-steel-content p {
    margin: 0 0 1rem;
    line-height: 1.75;
    color: #475569;
  }

  .rcc-column-steel-content ul,
  .rcc-column-steel-content ol {
    margin: 0.75rem 0 1.5rem;
    padding-left: 1.5rem;
  }

  .rcc-column-steel-content ul {
    list-style: disc;
  }

  .rcc-column-steel-content ol {
    list-style: decimal;
