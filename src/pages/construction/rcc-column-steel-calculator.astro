  function drawCrossSection(shape, Wmm, Dmm, coverMm, barCount, barDia, tieDia, hasInner) {
    if (!svgCross) return;
    const W = 280, H = 240;
    const barR = Math.max(3.5, Math.min(8.5, 3 + (barDia / 32) * 5.5));
    const tieStroke = Math.max(1.8, Math.min(3.5, 1.5 + (tieDia / 12) * 1.5));

    let shapeSvg = '';
    let tiesSvg = '';
    let barsSvg = '';
    let dimSvg = '';

    if (shape === 'circular') {
      const cx = 140, cy = 110;
      const baseD = 350;
      const r = Math.max(45, Math.min(78, 62 * Math.sqrt(Wmm / baseD)));
      const c = Math.max(6, Math.min(20, (coverMm / Wmm) * (2 * r)));
      const coreR = Math.max(20, r - c);

      shapeSvg = `<circle cx="${cx}" cy="${cy}" r="${r.toFixed(1)}" fill="#f8fafc" stroke="#64748b" stroke-width="2.5" />`;
      tiesSvg = `<circle cx="${cx}" cy="${cy}" r="${coreR.toFixed(1)}" fill="none" stroke="#d97706" stroke-width="${tieStroke.toFixed(1)}" stroke-dasharray="5,2.5" />`;

      const n = Math.max(6, barCount);
      for (let i = 0; i < n; i++) {
        const angle = (i * 2 * Math.PI) / n - Math.PI / 2;
        const bx = cx + (coreR - barR) * Math.cos(angle);
        const by = cy + (coreR - barR) * Math.sin(angle);
        barsSvg += `
          <circle cx="${bx.toFixed(1)}" cy="${by.toFixed(1)}" r="${barR.toFixed(1)}" fill="#2563eb" stroke="#1e3a8a" stroke-width="1.5" />
          <circle cx="${(bx - barR * 0.3).toFixed(1)}" cy="${(by - barR * 0.3).toFixed(1)}" r="${(barR * 0.35).toFixed(1)}" fill="#93c5fd" opacity="0.8" />
        `;
      }

      dimSvg = `
        <text x="${cx}" y="${(cy + r + 24).toFixed(1)}" text-anchor="middle" font-size="11" font-weight="bold" fill="#1e293b">⌀ ${Math.round(Wmm)} mm Round</text>
        <text x="${cx}" y="${(cy + r + 38).toFixed(1)}" text-anchor="middle" font-size="9.5" font-weight="600" fill="#64748b">Clear Cover = ${Math.round(coverMm)} mm</text>
      `;
    } else {
      const maxDim = Math.max(Wmm, Dmm);
      const scale = Math.min(145 / maxDim, 0.45);
      let w = Math.max(65, Math.min(170, Wmm * scale));
      let h = Math.max(65, Math.min(155, Dmm * scale));
      if (Math.abs(Wmm - Dmm) < 5) {
        const squareSide = Math.max(75, Math.min(145, 110 * Math.sqrt(Wmm / 300)));
        w = squareSide;
        h = squareSide;
      }

      const c = Math.max(6, Math.min(20, (coverMm / Math.min(Wmm, Dmm)) * Math.min(w, h)));
      const ox = (W - w) / 2;
      const oy = 110 - h / 2;
      const coreW = w - 2 * c;
      const coreH = h - 2 * c;

      shapeSvg = `<rect x="${ox.toFixed(1)}" y="${oy.toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}" rx="6" fill="#f8fafc" stroke="#64748b" stroke-width="2.5" />`;
      tiesSvg = `<rect x="${(ox + c).toFixed(1)}" y="${(oy + c).toFixed(1)}" width="${coreW.toFixed(1)}" height="${coreH.toFixed(1)}" rx="4" fill="none" stroke="#d97706" stroke-width="${tieStroke.toFixed(1)}" stroke-dasharray="5,2.5" />`;

      // 4 Corner Bars
      const corners = [
        [ox + c + barR, oy + c + barR],
        [ox + w - c - barR, oy + c + barR],
        [ox + c + barR, oy + h - c - barR],
        [ox + w - c - barR, oy + h - c - barR],
      ];
      let barCoords = [...corners];

      if (barCount === 6) {
        if (h >= w) {
          barCoords.push([ox + c + barR, oy + h / 2]);
          barCoords.push([ox + w - c - barR, oy + h / 2]);
          if (hasInner) {
            tiesSvg += `<line x1="${(ox + c).toFixed(1)}" y1="${(oy + h / 2).toFixed(1)}" x2="${(ox + w - c).toFixed(1)}" y2="${(oy + h / 2).toFixed(1)}" stroke="#d97706" stroke-width="1.8" stroke-dasharray="3,2" />`;
          }
        } else {
          barCoords.push([ox + w / 2, oy + c + barR]);
          barCoords.push([ox + w / 2, oy + h - c - barR]);
          if (hasInner) {
            tiesSvg += `<line x1="${(ox + w / 2).toFixed(1)}" y1="${(oy + c).toFixed(1)}" x2="${(ox + w / 2).toFixed(1)}" y2="${(oy + h - c).toFixed(1)}" stroke="#d97706" stroke-width="1.8" stroke-dasharray="3,2" />`;
          }
        }
      } else if (barCount === 8) {
        barCoords.push([ox + w / 2, oy + c + barR]);
        barCoords.push([ox + w / 2, oy + h - c - barR]);
        barCoords.push([ox + c + barR, oy + h / 2]);
        barCoords.push([ox + w - c - barR, oy + h / 2]);
        if (hasInner) {
          const pTop = `${(ox + w / 2).toFixed(1)},${(oy + c).toFixed(1)}`;
          const pRight = `${(ox + w - c).toFixed(1)},${(oy + h / 2).toFixed(1)}`;
          const pBot = `${(ox + w / 2).toFixed(1)},${(oy + h - c).toFixed(1)}`;
          const pLeft = `${(ox + c).toFixed(1)},${(oy + h / 2).toFixed(1)}`;
          tiesSvg += `<polygon points="${pTop} ${pRight} ${pBot} ${pLeft}" fill="none" stroke="#d97706" stroke-width="1.8" stroke-dasharray="4,2" />`;
        }
      } else if (barCount === 10) {
        const stepY = coreH / 3;
        barCoords.push([ox + c + barR, oy + c + stepY]);
        barCoords.push([ox + c + barR, oy + c + 2 * stepY]);
        barCoords.push([ox + w - c - barR, oy + c + stepY]);
        barCoords.push([ox + w - c - barR, oy + c + 2 * stepY]);
        barCoords.push([ox + w / 2, oy + c + barR]);
        barCoords.push([ox + w / 2, oy + h - c - barR]);
        if (hasInner) {
          tiesSvg += `
            <line x1="${(ox + c).toFixed(1)}" y1="${(oy + c + stepY).toFixed(1)}" x2="${(ox + w - c).toFixed(1)}" y2="${(oy + c + stepY).toFixed(1)}" stroke="#d97706" stroke-width="1.5" stroke-dasharray="3,2" />
            <line x1="${(ox + c).toFixed(1)}" y1="${(oy + c + 2 * stepY).toFixed(1)}" x2="${(ox + w - c).toFixed(1)}" y2="${(oy + c + 2 * stepY).toFixed(1)}" stroke="#d97706" stroke-width="1.5" stroke-dasharray="3,2" />
          `;
        }
      } else if (barCount >= 12) {
        const stepY = coreH / 3;
        const stepX = coreW / 3;
        barCoords.push([ox + c + barR, oy + c + stepY]);
        barCoords.push([ox + c + barR, oy + c + 2 * stepY]);
        barCoords.push([ox + w - c - barR, oy + c + stepY]);
        barCoords.push([ox + w - c - barR, oy + c + 2 * stepY]);
        barCoords.push([ox + c + stepX, oy + c + barR]);
        barCoords.push([ox + c + 2 * stepX, oy + c + barR]);
        barCoords.push([ox + c + stepX, oy + h - c - barR]);
        barCoords.push([ox + c + 2 * stepX, oy + h - c - barR]);
        if (hasInner) {
          tiesSvg += `
            <line x1="${(ox + c).toFixed(1)}" y1="${(oy + c + stepY).toFixed(1)}" x2="${(ox + w - c).toFixed(1)}" y2="${(oy + c + stepY).toFixed(1)}" stroke="#d97706" stroke-width="1.5" stroke-dasharray="3,2" />
            <line x1="${(ox + c).toFixed(1)}" y1="${(oy + c + 2 * stepY).toFixed(1)}" x2="${(ox + w - c).toFixed(1)}" y2="${(oy + c + 2 * stepY).toFixed(1)}" stroke="#d97706" stroke-width="1.5" stroke-dasharray="3,2" />
          `;
        }
      }

      barCoords.forEach(([bx, by]) => {
        barsSvg += `
          <circle cx="${bx.toFixed(1)}" cy="${by.toFixed(1)}" r="${barR.toFixed(1)}" fill="#2563eb" stroke="#1e3a8a" stroke-width="1.5" />
          <circle cx="${(bx - barR * 0.3).toFixed(1)}" cy="${(by - barR * 0.3).toFixed(1)}" r="${(barR * 0.35).toFixed(1)}" fill="#93c5fd" opacity="0.8" />
        `;
      });

      dimSvg = `
        <line x1="${ox.toFixed(1)}" y1="${(oy + h + 14).toFixed(1)}" x2="${(ox + w).toFixed(1)}" y2="${(oy + h + 14).toFixed(1)}" stroke="#0284c7" stroke-width="1.5" />
        <text x="${(ox + w / 2).toFixed(1)}" y="${(oy + h + 26).toFixed(1)}" text-anchor="middle" font-size="10.5" font-weight="bold" fill="#0369a1">${Math.round(Wmm)} mm</text>
        <line x1="${(ox - 12).toFixed(1)}" y1="${oy.toFixed(1)}" x2="${(ox - 12).toFixed(1)}" y2="${(oy + h).toFixed(1)}" stroke="#0284c7" stroke-width="1.5" />
        <text x="${(ox - 16).toFixed(1)}" y="${(oy + h / 2).toFixed(1)}" text-anchor="middle" transform="rotate(-90 ${(ox - 16).toFixed(1)} ${(oy + h / 2).toFixed(1)})" font-size="10.5" font-weight="bold" fill="#0369a1">${Math.round(Dmm)} mm</text>
        <text x="${W / 2}" y="22" text-anchor="middle" font-size="9" font-weight="600" fill="#64748b">Clear Cover = ${Math.round(coverMm)} mm</text>
      `;
    }

    svgCross.innerHTML = `
      ${shapeSvg}
      ${tiesSvg}
      ${barsSvg}
      ${dimSvg}
    `;

    if (lblCrossCaption) {
      lblCrossCaption.innerHTML = `Vertical: <strong class="text-blue-600">${barCount} Nos × ${barDia}mm</strong> | Ties: <strong class="text-amber-600">${tieDia}mm Outer Ring</strong> ${hasInner && barCount > 4 ? '+ Inner Links' : ''}`;
    }
  }

  function drawElevation(Hmeters, Wmm, Dmm, isTwoZone, confSpacingMm, midSpacingMm, floorCond, dMain, dTie) {
    if (!svgElevation) return;
    const W = 340, H = 240;
    const colH = Math.max(105, Math.min(160, 85 + (Hmeters / 3.5) * 50));
    const colY = (H - colH) / 2 + 10;
    const colW = Math.max(40, Math.min(75, 36 + (Wmm / 500) * 28));
    const colX = (W - colW) / 2 - 14;

    const barThickness = Math.max(2, Math.min(4, 1.8 + (dMain / 32) * 2.2));
    const tieStroke = Math.max(1.2, Math.min(2.5, 1.0 + (dTie / 12) * 1.5));

    let tieTicks = '';
    const l0M = Math.max(Wmm / 1000, Dmm / 1000, Hmeters / 6, 0.45);
    const l0CanvasH = Math.min(colH * 0.38, (l0M / Hmeters) * colH);

    if (isTwoZone) {
      const nBot = Math.max(3, Math.min(8, Math.round((l0M * 1000) / confSpacingMm)));
      for (let i = 0; i < nBot; i++) {
        const y = colY + colH - (i * l0CanvasH) / Math.max(1, nBot - 1);
        tieTicks += `<line x1="${colX + 3}" y1="${y.toFixed(1)}" x2="${colX + colW - 3}" y2="${y.toFixed(1)}" stroke="#d97706" stroke-width="${tieStroke}" />`;
      }
      const midM = Math.max(0.2, Hmeters - 2 * l0M);
      const nMid = Math.max(2, Math.min(7, Math.round((midM * 1000) / midSpacingMm)));
      const midCanvasH = colH - 2 * l0CanvasH;
      for (let i = 1; i <= nMid; i++) {
        const y = colY + colH - l0CanvasH - (i * midCanvasH) / (nMid + 1);
        tieTicks += `<line x1="${colX + 3}" y1="${y.toFixed(1)}" x2="${colX + colW - 3}" y2="${y.toFixed(1)}" stroke="#f59e0b" stroke-width="${tieStroke}" stroke-dasharray="3,1.5" />`;
      }
      const nTop = nBot;
      for (let i = 0; i < nTop; i++) {
        const y = colY + (i * l0CanvasH) / Math.max(1, nTop - 1);
        tieTicks += `<line x1="${colX + 3}" y1="${y.toFixed(1)}" x2="${colX + colW - 3}" y2="${y.toFixed(1)}" stroke="#d97706" stroke-width="${tieStroke}" />`;
      }
    } else {
      const nUni = Math.max(6, Math.min(18, Math.round((Hmeters * 1000) / confSpacingMm)));
      for (let i = 0; i <= nUni; i++) {
        const y = colY + (i * colH) / nUni;
        tieTicks += `<line x1="${colX + 3}" y1="${y.toFixed(1)}" x2="${colX + colW - 3}" y2="${y.toFixed(1)}" stroke="#d97706" stroke-width="${tieStroke}" />`;
      }
    }

    let bottomDetailSvg = '';
    let topDetailSvg = '';
    let lapZoneSvg = '';

    if (floorCond === 'ground_starter') {
      bottomDetailSvg = `
        <rect x="${colX - 35}" y="${colY + colH}" width="${colW + 70}" height="26" rx="3" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
        <text x="${colX + colW / 2}" y="${colY + colH + 16}" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#475569">FOOTING RAFT MESH</text>
        <path d="M ${colX + 8} ${colY + colH} L ${colX + 8} ${colY + colH + 18} L ${colX - 18} ${colY + colH + 18} M ${colX + colW - 8} ${colY + colH} L ${colX + colW - 8} ${colY + colH + 18} L ${colX + colW + 18} ${colY + colH + 18}" stroke="#2563eb" stroke-width="${barThickness}" fill="none" stroke-linecap="round" />
      `;
      topDetailSvg = `
        <rect x="${colX - 25}" y="${colY - 18}" width="${colW + 50}" height="18" rx="2" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
        <text x="${colX + colW / 2}" y="${colY - 6}" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#475569">FLOOR BEAM</text>
        <line x1="${colX + 8}" y1="${colY - 10}" x2="${colX + 8}" y2="${colY + colH}" stroke="#2563eb" stroke-width="${barThickness}" />
        <line x1="${colX + colW - 8}" y1="${colY - 10}" x2="${colX + colW - 8}" y2="${colY + colH}" stroke="#2563eb" stroke-width="${barThickness}" />
      `;
    } else if (floorCond === 'top_roof') {
      topDetailSvg = `
        <rect x="${colX - 25}" y="${colY - 22}" width="${colW + 50}" height="22" rx="2" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
        <text x="${colX + colW / 2}" y="${colY - 8}" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#475569">ROOF BEAM / SLAB</text>
        <path d="M ${colX + 8} ${colY + colH} L ${colX + 8} ${colY - 10} L ${colX + 24} ${colY - 10} M ${colX + colW - 8} ${colY + colH} L ${colX + colW - 8} ${colY - 10} L ${colX + colW - 24} ${colY - 10}" stroke="#2563eb" stroke-width="${barThickness}" fill="none" stroke-linecap="round" />
      `;
      bottomDetailSvg = `
        <rect x="${colX - 25}" y="${colY + colH}" width="${colW + 50}" height="18" rx="2" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
        <text x="${colX + colW / 2}" y="${colY + colH + 13}" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#475569">LOWER COLUMN</text>
      `;
    } else {
      topDetailSvg = `
        <rect x="${colX - 25}" y="${colY - 18}" width="${colW + 50}" height="18" rx="2" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
        <text x="${colX + colW / 2}" y="${colY - 6}" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#475569">FLOOR BEAM</text>
        <line x1="${colX + 8}" y1="${colY - 12}" x2="${colX + 8}" y2="${colY + colH + 12}" stroke="#2563eb" stroke-width="${barThickness}" />
        <line x1="${colX + colW - 8}" y1="${colY - 12}" x2="${colX + colW - 8}" y2="${colY + colH + 12}" stroke="#2563eb" stroke-width="${barThickness}" />
      `;
      bottomDetailSvg = `
        <rect x="${colX - 25}" y="${colY + colH}" width="${colW + 50}" height="18" rx="2" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
        <text x="${colX + colW / 2}" y="${colY + colH + 13}" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#475569">LOWER COLUMN</text>
      `;
      const lapZoneY = colY + colH * 0.35;
      const lapZoneH = colH * 0.30;
      lapZoneSvg = `
        <rect x="${colX + 2}" y="${lapZoneY.toFixed(1)}" width="${colW - 4}" height="${lapZoneH.toFixed(1)}" fill="#dbeafe" opacity="0.45" stroke="#93c5fd" stroke-width="1" stroke-dasharray="2,2" />
        <text x="${colX + colW / 2}" y="${(lapZoneY + lapZoneH / 2 + 3).toFixed(1)}" text-anchor="middle" font-size="7.5" font-weight="bold" fill="#1e40af">SEISMIC LAP ZONE</text>
      `;
    }

    svgElevation.innerHTML = `
      ${topDetailSvg}
      ${bottomDetailSvg}
      <rect x="${colX}" y="${colY}" width="${colW}" height="${colH}" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2" rx="2" />
      ${lapZoneSvg}
      ${tieTicks}
      ${isTwoZone ? `
        <line x1="${colX + colW + 8}" y1="${colY}" x2="${colX + colW + 8}" y2="${(colY + l0CanvasH).toFixed(1)}" stroke="#b45309" stroke-width="2" />
        <text x="${colX + colW + 12}" y="${(colY + l0CanvasH / 2 + 3).toFixed(1)}" font-size="8" font-weight="bold" fill="#b45309">Top L₀</text>

        <line x1="${colX + colW + 8}" y1="${(colY + colH - l0CanvasH).toFixed(1)}" x2="${colX + colW + 8}" y2="${colY + colH}" stroke="#b45309" stroke-width="2" />
        <text x="${colX + colW + 12}" y="${(colY + colH - l0CanvasH / 2 + 3).toFixed(1)}" font-size="8" font-weight="bold" fill="#b45309">Bot L₀</text>
      ` : ''}
      <line x1="${colX - 10}" y1="${colY}" x2="${colX - 10}" y2="${colY + colH}" stroke="#0284c7" stroke-width="1.5" />
      <text x="${colX - 15}" y="${colY + colH / 2}" text-anchor="middle" transform="rotate(-90 ${colX - 15} ${colY + colH / 2})" font-size="9" font-weight="bold" fill="#0369a1">H = ${Hmeters.toFixed(1)} m</text>
    `;

    if (lblElevationCaption) {
      lblElevationCaption.innerHTML = isTwoZone
        ? `IS 13920 Confinement L₀ = <strong>${(l0M).toFixed(2)}m</strong> (@ ${confSpacingMm}mm) | Mid-Zone (@ ${midSpacingMm}mm)`
        : `Uniform Ties Spaced @ ${confSpacingMm}mm c/c throughout height`;
    }
  }

  // --- MAIN CALCULATION FUNCTION ---
  function calculate() {
    updateShapeUI();

    const rawH = parseFloat(colH.value) || 0;
    const rawW = parseFloat(colW.value) || 0;
    const rawD = parseFloat(colD.value) || 0;
    const rawCover = parseFloat(colCover.value) || 40;
    const rawN = Math.max(1, parseInt(colCount.value) || 1);
    const shape = colShape.value;

    const heightM = currentDimensionUnit === 'ft' ? rawH * 0.3048 : rawH;
    const widthMm = currentDimensionUnit === 'ft' ? rawW * 25.4 : rawW;
    const depthMm = shape === 'circular' ? widthMm : (currentDimensionUnit === 'ft' ? rawD * 25.4 : rawD);
    const coverMm = currentDimensionUnit === 'ft' ? rawCover * 25.4 : rawCover;

    if (heightM <= 0 || widthMm <= 0 || (shape !== 'circular' && depthMm <= 0)) {
      resetOutputs();
      return;
    }

    const Wm = widthMm / 1000;
    const Dm = depthMm / 1000;

    let singleVol = 0;
    let singleShut = 0;

    if (shape === 'circular') {
      const radius = Wm / 2;
      singleVol = Math.PI * radius * radius * heightM;
      singleShut = Math.PI * Wm * heightM;
    } else {
      singleVol = Wm * Dm * heightM;
      singleShut = 2 * (Wm + Dm) * heightM;
    }

    const totalConcreteVol = singleVol * rawN;
    const totalConcreteCuft = totalConcreteVol * 35.3147;

    const rateSteel = parseFloat(costSteel.value) || 75;
    const rateConc = parseFloat(costConc.value) || 4800;
    const rateShut = parseFloat(costShut.value) || 350;
    const rateWire = parseFloat(costWire.value) || 100;

    let totalSteelKg = 0;
    let baseSteelKg = 0;
    let wastageKg = 0;
    let bbsList = [];
    let diaSummaryMap = new Map();

    if (currentCalculationMode === 'norm') {
      // NORMAL THUMB RULE MODE
      let steelRate = 195;
      const type = selNormType.value;
      if (type === 'light') steelRate = 120;
      else if (type === 'standard') steelRate = 195;
      else if (type === 'heavy') steelRate = 275;
      else if (type === 'custom') steelRate = parseFloat(inputNormCustomRate.value) || 195;

      baseSteelKg = totalConcreteVol * steelRate;
      wastageKg = baseSteelKg * 0.03;
      totalSteelKg = baseSteelKg + wastageKg;

      const normDia = parseInt(selNormDia.value) || 16;
      const uWt = getBarUnitWeight(normDia);
      const totLen = totalSteelKg / uWt;
      const stock12m = Math.ceil(totLen / 12);
      const bSize = BARS_PER_BUNDLE_MAP[normDia] || 3;
      const bundles = Math.ceil(stock12m / bSize);

      diaSummaryMap.set(normDia, { totalLen: totLen, totalWt: totalSteelKg, stock12m, bSize, bundles });
      renderBOQ(totalConcreteVol, selNormConcrete.value);

      // Estimate rebar count for normal mode visualisation:
      const singleColSteelKg = totalSteelKg / rawN;
      const estBarLenM = heightM + 50 * (normDia / 1000);
      const estBarCount = Math.max(shape === 'circular' ? 6 : 4, Math.round(singleColSteelKg / (estBarLenM * uWt)));
      let visualBarCount = Math.min(12, Math.max(shape === 'circular' ? 6 : 4, Math.ceil(estBarCount / 2) * 2));

      drawCrossSection(shape, widthMm, depthMm, coverMm, visualBarCount, normDia, 8, visualBarCount > 6);
      drawElevation(heightM, widthMm, depthMm, false, 150, 150, 'intermediate', normDia, 8);
    } else {
      // ADVANCED BBS MODE
      const wastagePct = parseFloat(inputWastage.value) || 3;
      const floorCond = selFloorCondition.value;

      // 1. Vertical Main Bars
      const nMain = Math.max(shape === 'circular' ? 6 : 4, parseInt(mainC.value) || 4);
      const dMain = parseInt(mainD.value) || 16;
      let lapM = (50 * dMain) / 1000;
      let crankM = 0.08;
      let starterM = 0;

      if (floorCond === 'ground_starter') {
        starterM = 0.30; // 300mm starter bend into footing
      } else if (floorCond === 'top_roof') {
        lapM = 0;
        crankM = 0;
        starterM = Math.max(0.2, (16 * dMain) / 1000);
      }

      const cutMainM = Number((heightM + lapM + crankM + starterM).toFixed(3));
      const totMainCount = nMain * rawN;
      const totMainLen = totMainCount * cutMainM;
      const wtMain = totMainLen * getBarUnitWeight(dMain);

      bbsList.push({
        mark: '01',
        desc: `Vertical Main Longitudinal Bars (${floorCond.replace('_', ' ').toUpperCase()})`,
        dia: dMain,
        shape: floorCond === 'ground_starter' ? 'STARTER-BEND' : (floorCond === 'top_roof' ? 'TOP-HOOK' : 'CRANK-LAP'),
        count: totMainCount,
        cutLen: cutMainM,
        totLen: totMainLen,
        uWt: getBarUnitWeight(dMain),
        totWt: wtMain,
      });

      // 2. Lateral Ties
      const dTie = parseInt(tieD.value) || 8;
      const uWtTie = getBarUnitWeight(dTie);
      const isTwoZone = tieMode.value === 'two_zone';

      const sConf = currentDimensionUnit === 'ft' ? (parseFloat(tieSpacingConf.value) || 4) * 25.4 : parseFloat(tieSpacingConf.value) || 100;
      const sMid = currentDimensionUnit === 'ft' ? (parseFloat(tieSpacingMid.value) || 6) * 25.4 : parseFloat(tieSpacingMid.value) || 150;
      const sUni = currentDimensionUnit === 'ft' ? (parseFloat(tieSpacingUniform.value) || 6) * 25.4 : parseFloat(tieSpacingUniform.value) || 150;

      let tiesPerCol = 0;
      let tieDesc = '';

      if (isTwoZone) {
        const l0M = Math.max(Wm, Dm, heightM / 6, 0.45);
        const midM = Math.max(0, heightM - 2 * l0M);
        const ringsL0 = Math.floor((l0M * 1000) / sConf) + 1;
        const ringsMid = sMid > 0 && midM > 0 ? Math.floor((midM * 1000) / sMid) : 0;
        tiesPerCol = ringsL0 * 2 + ringsMid;
        tieDesc = `Outer Ties (2-Zone Ductile: L0 @ ${Math.round(sConf)}mm, Mid @ ${Math.round(sMid)}mm)`;
      } else {
        tiesPerCol = Math.floor((heightM * 1000) / sUni) + 1;
        tieDesc = `Outer Ties (Uniform @ ${Math.round(sUni)}mm c/c)`;
      }

      let cutTieMm = 0;
      if (shape === 'circular') {
        const coreDia = Math.max(50, widthMm - 2 * coverMm);
        const hookLen = Math.max(75, 10 * dTie);
        cutTieMm = Math.PI * coreDia + 2 * hookLen;
      } else {
        const coreW = Math.max(50, widthMm - 2 * coverMm);
        const coreD = Math.max(50, depthMm - 2 * coverMm);
        const hookLen = Math.max(75, 10 * dTie);
        cutTieMm = 2 * (coreW + coreD) + 2 * hookLen - 12 * dTie;
      }
      const cutTieM = Math.max(0.3, cutTieMm / 1000);
      const totTieCount = tiesPerCol * rawN;
      const totTieLen = totTieCount * cutTieM;
      const wtTie = totTieLen * uWtTie;

      bbsList.push({
        mark: '02',
        desc: tieDesc,
        dia: dTie,
        shape: shape === 'circular' ? 'CIRC-HOOP (135° Hook)' : 'RING-135° (Seismic Outer Ring)',
        count: totTieCount,
        cutLen: cutTieM,
        totLen: totTieLen,
        uWt: uWtTie,
        totWt: wtTie,
      });

      // 3. Inner Ties (for 6, 8, 10, 12 bars)
      const hasInner = checkInnerTies.checked && shape === 'rectangular' && nMain > 4;
      if (hasInner) {
        const coreW = Math.max(50, widthMm - 2 * coverMm);
        const coreD = Math.max(50, depthMm - 2 * coverMm);
        const hookLen = Math.max(75, 10 * dTie);
        let innerCutMm = 0;
        let innerDesc = '';
        let innerShape = '';

        if (nMain === 8) {
          const diagSide = Math.sqrt(Math.pow(coreW / 2, 2) + Math.pow(coreD / 2, 2));
          innerCutMm = 4 * diagSide + 2 * hookLen - 8 * dTie;
          innerDesc = 'Inner Diamond Tie Ring (Restrains 4 side bars)';
          innerShape = 'DIAMOND-TIE';
        } else {
          innerCutMm = coreD + 2 * hookLen - 4 * dTie;
          innerDesc = 'Inner Cross Link / J-Tie (Restrains mid bars)';
          innerShape = 'CROSS-LINK';
        }

        const innerCutM = Math.max(0.2, innerCutMm / 1000);
        const totInnerCount = tiesPerCol * rawN;
        const totInnerLen = totInnerCount * innerCutM;
        const wtInner = totInnerLen * uWtTie;

        bbsList.push({
          mark: '03',
          desc: innerDesc,
          dia: dTie,
          shape: innerShape,
          count: totInnerCount,
          cutLen: innerCutM,
          totLen: totInnerLen,
          uWt: uWtTie,
          totWt: wtInner,
        });
      }

      // Sum totals
      baseSteelKg = bbsList.reduce((acc, it) => acc + it.totWt, 0);
      wastageKg = baseSteelKg * (wastagePct / 100);
      totalSteelKg = baseSteelKg + wastageKg;

      // Group diameter breakdown
      for (const it of bbsList) {
        const cur = diaSummaryMap.get(it.dia) || { totalLen: 0, totalWt: 0 };
        cur.totalLen += it.totLen;
        cur.totalWt += it.totWt;
        diaSummaryMap.set(it.dia, cur);
      }
      for (const [dia, val] of diaSummaryMap.entries()) {
        val.stock12m = Math.ceil(val.totalLen / 12);
        val.bSize = BARS_PER_BUNDLE_MAP[dia] || 3;
        val.bundles = Math.ceil(val.stock12m / val.bSize);
      }

      renderBBS(bbsList);
      renderBOQ(totalConcreteVol, selConcreteGrade.value);

      // Draw SVG diagrams
      drawCrossSection(shape, widthMm, depthMm, coverMm, nMain, dMain, dTie, hasInner);
      const confSpacingDisp = isTwoZone ? Math.round(sConf) : Math.round(sUni);
      const midSpacingDisp = isTwoZone ? Math.round(sMid) : Math.round(sUni);
      drawElevation(heightM, widthMm, depthMm, isTwoZone, confSpacingDisp, midSpacingDisp, floorCond, dMain, dTie);
    }

    renderDiameterSummary(diaSummaryMap);

    // Formwork
    const totalShutteringSqm = singleShut * rawN;
    const totalShutteringSqft = totalShutteringSqm * 10.7639;

    // Binding Wire ~1%
    const bindingWireKg = Math.max(1, Math.round((totalSteelKg * 0.01) * 10) / 10);

    // Hero Displays
    resTotalSteel.textContent = `${totalSteelKg.toFixed(1)} kg`;
    resTotalSteelOther.textContent = `(${(totalSteelKg / 100).toFixed(2)} Quintals | ${(totalSteelKg / 1000).toFixed(3)} Tonnes)`;
    resConc.textContent = `${totalConcreteVol.toFixed(3)} m³ (${totalConcreteCuft.toFixed(1)} cu ft)`;
    resShuttering.textContent = `Formwork: ${totalShutteringSqm.toFixed(1)} m² (${totalShutteringSqft.toFixed(1)} sq ft)`;

    resGeomDim.textContent = shape === 'circular'
      ? `⌀ ${Math.round(widthMm)} mm Round (${(widthMm / 25.4).toFixed(0)}" dia)`
      : `${Math.round(widthMm)} × ${Math.round(depthMm)} mm (${(widthMm / 25.4).toFixed(0)}" × ${(depthMm / 25.4).toFixed(0)}")`;
    resGeomHeight.textContent = `${(heightM * rawN).toFixed(1)} m total (${rawN} Column${rawN > 1 ? 's' : ''})`;
    const intensity = totalConcreteVol > 0 ? (totalSteelKg / totalConcreteVol).toFixed(1) : '0';
    const pct = totalConcreteVol > 0 ? ((parseFloat(intensity) / 7850) * 100).toFixed(2) : '0';
    resIntensityVol.textContent = `${pct}% (${intensity} kg/m³)`;

    // Costs
    const costSteelAmt = Math.round(totalSteelKg * rateSteel);
    const costConcAmt = Math.round(totalConcreteVol * rateConc);
    const costShutAmt = Math.round(totalShutteringSqm * rateShut);
    const costWireAmt = Math.round(bindingWireKg * rateWire);
    const totalCostAmt = costSteelAmt + costConcAmt + costShutAmt + costWireAmt;

    resCostTotal.textContent = `₹ ${totalCostAmt.toLocaleString('en-IN')}`;
    resCostSteelQty.textContent = `${totalSteelKg.toFixed(1)} kg`;
    resCostSteelRate.textContent = `₹ ${rateSteel}/kg`;
    resCostSteelAmt.textContent = `₹ ${costSteelAmt.toLocaleString('en-IN')}`;

    resCostConcQty.textContent = `${totalConcreteVol.toFixed(3)} m³`;
    resCostConcRate.textContent = `₹ ${rateConc}/m³`;
    resCostConcAmt.textContent = `₹ ${costConcAmt.toLocaleString('en-IN')}`;

    resCostShutQty.textContent = `${totalShutteringSqm.toFixed(1)} m²`;
    resCostShutRate.textContent = `₹ ${rateShut}/m²`;
    resCostShutAmt.textContent = `₹ ${costShutAmt.toLocaleString('en-IN')}`;

    resCostWireQty.textContent = `${bindingWireKg.toFixed(1)} kg`;
    resCostWireRate.textContent = `₹ ${rateWire}/kg`;
    resCostWireAmt.textContent = `₹ ${costWireAmt.toLocaleString('en-IN')}`;
    resCostGrandAmt.textContent = `₹ ${totalCostAmt.toLocaleString('en-IN')}`;

    resBoqShuttering.textContent = `${totalShutteringSqm.toFixed(1)} m² (${totalShutteringSqft.toFixed(1)} sq ft)`;
    resBoqWire.textContent = `${bindingWireKg.toFixed(1)} kg (18 Gauge GI Wire)`;

    try { document.dispatchEvent(new CustomEvent('calculator:updated')); } catch (e) {}
  }

  function renderBBS(items) {
    if (!tbodyBBS) return;
    let html = '';
    for (const it of items) {
      html += `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
          <td class="p-2.5 font-bold text-blue-600 dark:text-blue-400">${it.mark}</td>
          <td class="p-2.5 font-semibold text-slate-900 dark:text-white">${it.desc}</td>
          <td class="p-2.5 text-center font-bold font-mono">${it.dia}</td>
          <td class="p-2.5 text-slate-600 dark:text-slate-400 font-mono text-[11px]">${it.shape}</td>
          <td class="p-2.5 text-center font-bold">${it.count}</td>
          <td class="p-2.5 text-right font-mono">${it.cutLen.toFixed(2)}</td>
          <td class="p-2.5 text-right font-mono">${it.totLen.toFixed(1)}</td>
          <td class="p-2.5 text-right font-mono text-slate-500">${it.uWt.toFixed(3)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${it.totWt.toFixed(1)}</td>
        </tr>
      `;
    }
    tbodyBBS.innerHTML = html;
  }

  function renderDiameterSummary(diaMap) {
    if (!tbodyDiaSummary) return;
    let html = '';
    const sorted = Array.from(diaMap.keys()).sort((a, b) => a - b);
    for (const dia of sorted) {
      const data = diaMap.get(dia);
      html += `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
          <td class="p-2 font-bold text-blue-600 dark:text-blue-400">${dia} mm</td>
          <td class="p-2 text-right font-mono">${data.totalLen.toFixed(1)} m</td>
          <td class="p-2 text-right font-bold text-slate-900 dark:text-white">${data.totalWt.toFixed(1)} kg</td>
          <td class="p-2 text-center font-bold text-emerald-600 dark:text-emerald-400">${data.stock12m} Rods</td>
          <td class="p-2 text-center font-semibold text-slate-700 dark:text-slate-300">${data.bundles} Bndl (${data.bSize}/bndl)</td>
        </tr>
      `;
    }
    tbodyDiaSummary.innerHTML = html;
  }

  function renderBOQ(volumeM3, grade) {
    const dryVol = volumeM3 * 1.54;
    let cementRatio = 1, sandRatio = 1.5, aggRatio = 3;
    if (grade === 'M25') { cementRatio = 1; sandRatio = 1; aggRatio = 2; }
    else if (grade === 'M15') { cementRatio = 1; sandRatio = 2; aggRatio = 4; }
    const totalRatio = cementRatio + sandRatio + aggRatio;

    const cementM3 = dryVol * (cementRatio / totalRatio);
    const cementKg = cementM3 * 1440;
    const cementBags = Math.ceil(cementKg / 50);

    const sandM3 = dryVol * (sandRatio / totalRatio);
    const sandCft = sandM3 * 35.3147;

    const aggM3 = dryVol * (aggRatio / totalRatio);
    const aggCft = aggM3 * 35.3147;

    if (resBoqCement) resBoqCement.textContent = `${cementBags} Bags (${cementKg.toFixed(0)} kg)`;
    if (resBoqSand) resBoqSand.textContent = `${sandCft.toFixed(1)} cft (${sandM3.toFixed(2)} m³)`;
    if (resBoqAggregate) resBoqAggregate.textContent = `${aggCft.toFixed(1)} cft (${aggM3.toFixed(2)} m³)`;
  }

  // --- BUTTON EVENT LISTENERS ---
  const btnCalc = document.getElementById('btn-calc-column');
  const btnClear = document.getElementById('btn-clear-column');

  if (btnCalc) {
    btnCalc.addEventListener('click', () => {
      calculate();
      const card = document.getElementById('results-card');
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const orig = btnCalc.innerHTML;
      btnCalc.innerHTML = '<span>✅ Calculated!</span>';
      setTimeout(() => { btnCalc.innerHTML = orig; }, 1200);
    });
  }

  if (btnClear) {
    btnClear.addEventListener('click', () => {
      colH.value = '';
      colW.value = '';
      colD.value = '';
      colH.focus();
      resetOutputs();
      const orig = btnClear.innerHTML;
      btnClear.innerHTML = '<span>✓ Cleared</span>';
      setTimeout(() => { btnClear.innerHTML = orig; }, 1000);
    });
  }

  if (btnModeAdv) btnModeAdv.addEventListener('click', () => setMode('adv'));
  if (btnModeNorm) btnModeNorm.addEventListener('click', () => setMode('norm'));
  if (btnUnitM) btnUnitM.addEventListener('click', () => setUnit('m'));
  if (btnUnitFt) btnUnitFt.addEventListener('click', () => setUnit('ft'));

  // Preset Buttons
  document.querySelectorAll('.btn-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const u = btn.getAttribute('data-unit') || 'm';
      setUnit(u);
      setMode('adv');

      if (btn.hasAttribute('data-shape')) colShape.value = btn.getAttribute('data-shape');
      updateShapeUI();

      if (btn.hasAttribute('data-h')) colH.value = btn.getAttribute('data-h');
      if (btn.hasAttribute('data-w')) colW.value = btn.getAttribute('data-w');
      if (btn.hasAttribute('data-d')) colD.value = btn.getAttribute('data-d');

      if (btn.hasAttribute('data-main-c')) mainC.value = btn.getAttribute('data-main-c');
      if (btn.hasAttribute('data-main-d')) mainD.value = btn.getAttribute('data-main-d');

      if (btn.hasAttribute('data-tie-d')) tieD.value = btn.getAttribute('data-tie-d');
      if (btn.hasAttribute('data-tie-mode')) {
        tieMode.value = btn.getAttribute('data-tie-mode');
        if (tieMode.value === 'uniform') {
          boxTieSpacingUniform.classList.remove('hidden');
          boxTieSpacingTwozone.classList.add('hidden');
          if (btn.hasAttribute('data-tie-uni')) tieSpacingUniform.value = btn.getAttribute('data-tie-uni');
        } else {
          boxTieSpacingUniform.classList.add('hidden');
          boxTieSpacingTwozone.classList.remove('hidden');
          if (btn.hasAttribute('data-tie-conf')) tieSpacingConf.value = btn.getAttribute('data-tie-conf');
          if (btn.hasAttribute('data-tie-mid')) tieSpacingMid.value = btn.getAttribute('data-tie-mid');
        }
      }

      if (btn.getAttribute('data-inner') === 'true') {
        checkInnerTies.checked = true;
      } else {
        checkInnerTies.checked = false;
      }

      calculate();
    });
  });

  // Table Copy, CSV, Print
  const btnCopyBbs = document.getElementById('btn-copy-bbs');
  if (btnCopyBbs) {
    btnCopyBbs.addEventListener('click', () => {
      let tsv = 'Mark\tDescription\tDia(mm)\tShape Code\tCount\tCut Len(m)\tTot Len(m)\tUnit Wt(kg/m)\tTot Wt(kg)\n';
      document.querySelectorAll('#tbody-bbs tr').forEach(row => {
        const cols = Array.from(row.querySelectorAll('td')).map(td => td.textContent.trim());
        tsv += cols.join('\t') + '\n';
      });
      navigator.clipboard.writeText(tsv).then(() => {
        const orig = btnCopyBbs.textContent;
        btnCopyBbs.textContent = '✅ Copied!';
        setTimeout(() => { btnCopyBbs.textContent = orig; }, 1500);
      });
    });
  }

  const btnDownloadCsv = document.getElementById('btn-download-csv');
  if (btnDownloadCsv) {
    btnDownloadCsv.addEventListener('click', () => {
      let csv = 'Mark,Description,Dia(mm),Shape Code,Count,Cut Len(m),Tot Len(m),Unit Wt(kg/m),Tot Wt(kg)\n';
      document.querySelectorAll('#tbody-bbs tr').forEach(row => {
        const cols = Array.from(row.querySelectorAll('td')).map(td => `"${td.textContent.trim().replace(/"/g, '""')}"`);
        csv += cols.join(',') + '\n';
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'RCC_Column_Steel_BBS.csv';
      link.click();
    });
  }

  const btnPrintBbs = document.getElementById('btn-print-bbs');
  if (btnPrintBbs) {
    btnPrintBbs.addEventListener('click', () => {
      window.print();
    });
  }

  // Live Diagram Update (Diagram updates in real-time as user types without re-computing results)
  function updateLiveDiagrams() {
    const shape = colShape?.value || 'rectangular';
    let W = parseFloat(colW?.value) || 300;
    let D = parseFloat(colD?.value) || 300;
    let H = parseFloat(colH?.value) || 3.0;
    let cover = parseFloat(colCover?.value) || 40;

    if (currentDimensionUnit === 'ft') {
      W *= 25.4;
      D *= 25.4;
      H *= 0.3048;
      cover *= 25.4;
    }

    const nMain = (currentCalculationMode === 'norm' ? (parseInt(mainCNorm?.value) || 4) : (parseInt(mainC?.value) || 4));
    const dMain = (currentCalculationMode === 'norm' ? (parseInt(mainDNorm?.value) || 16) : (parseInt(mainD?.value) || 16));
    const dTie = (currentCalculationMode === 'norm' ? (parseInt(tieDNorm?.value) || 8) : (parseInt(tieD?.value) || 8));
    const hasInner = checkInnerTies ? checkInnerTies.checked : false;

    drawCrossSection(shape, W, D, cover, nMain, dMain, dTie, hasInner);

    const isTwo = tieMode && tieMode.value === 'two_zone';
    const sConf = currentDimensionUnit === 'ft' ? Math.round((parseFloat(tieSpacingConf?.value) || 4) * 25.4) : Math.round(parseFloat(tieSpacingConf?.value) || 100);
    const sMid = currentDimensionUnit === 'ft' ? Math.round((parseFloat(tieSpacingMid?.value) || 8) * 25.4) : Math.round(parseFloat(tieSpacingMid?.value) || 200);
    const floorCond = selFloorCondition?.value || 'ground_starter';
    drawElevation(H, W, D, isTwo, sConf, sMid, floorCond, dMain, dTie);
  }

  // Live input events for Real-time Visual Diagram Updating
  const liveInputs = [
    colShape, colH, colW, colD, colCover, colCount,
    selConcreteGrade, selFloorCondition, inputWastage,
    mainC, mainD, tieD, tieMode, tieSpacingUniform, tieSpacingConf, tieSpacingMid, checkInnerTies,
    selNormType, inputNormCustomRate, selNormDia, selNormConcrete,
    costSteel, costConc, costShut, costWire
  ];

  liveInputs.forEach(el => {
    if (el) {
      el.addEventListener('input', updateLiveDiagrams);
      el.addEventListener('change', updateLiveDiagrams);
    }
  });

  // Initial calculation on page load
  calculate();
</script>

