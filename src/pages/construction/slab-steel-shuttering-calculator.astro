---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import {
  STANDARD_PLY_SHEET_SQFT,
  STANDARD_STEEL_PLATE_SQFT,
  SHUTTERING_OIL_COVERAGE_SQM,
  BARS_PER_BUNDLE,
} from '../../lib/calculators/slab-steel-shuttering';
---

<CalculatorLayout
  title="Slab Steel & Shuttering Calculator – Formwork, Props & Steel Estimator"
  description="Free Slab Steel & Shuttering Calculator with Normal (Contractor Thumb Rule) and Advanced (BBS & Staging Grid) modes. Calculates bottom soffit area, side edge formwork, 8x4 ply sheets, Acrow props, steel rebar bundles, and concrete BOQ."
  category="Construction"
  calculatorName="Slab Steel & Shuttering Calculator"
  slug="slab-steel-shuttering-calculator"
  keywords={[
    'slab steel and shuttering calculator',
    'slab shuttering calculator',
    'formwork area calculator',
    'slab formwork calculation',
    'acrow props calculator',
    'plywood sheets for slab',
    'bottom soffit shuttering',
    'side shuttering area',
    'slab centering calculation',
    'slab steel estimate',
    'shuttering oil calculation'
  ]}
>
  <div class="space-y-6">

    <!-- SAFETY & PRELIMINARY ESTIMATION NOTICE -->
    <div class="rounded-2xl border border-amber-200/90 bg-amber-50/70 p-4 text-xs leading-relaxed text-amber-900 shadow-2xs dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
      <div class="flex items-start gap-2.5">
        <span class="text-base shrink-0">⚠️</span>
        <div>
          <strong class="font-bold">Quantity Estimation & Safety Notice:</strong>
          This calculator supports both <strong>Normal Contractor Site Takeoff</strong> (CPWD thumb rule rates for rapid procurement) and <strong>Advanced Engineering Detailing</strong> (BBS, Acrow staging props grid, opening edge shuttering, and concrete mix BOQ). Final formwork stability, staging propping schedules, and rebar detailing must be verified by a qualified structural engineer in accordance with local building standards (e.g. IS 456, IS 14687, BS 5975).
        </div>
      </div>
    </div>

    <!-- QUICK EXAMPLE PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-l="10" data-u="m" data-w="9" data-t="125" data-tu="mm" data-pl="1.2" data-pw="1.2">10 m × 9 m Slab (125 mm)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-l="20" data-u="ft" data-w="30" data-t="5" data-tu="in" data-pl="4" data-pw="4">20 ft × 30 ft Slab (5 in)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-l="6" data-u="m" data-w="5" data-t="150" data-tu="mm" data-pl="1.0" data-pw="1.0">5 m × 6 m Slab (150 mm)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-l="12" data-u="m" data-w="10" data-t="125" data-tu="mm" data-pl="1.0" data-pw="1.0">10 m × 12 m (1.0m Prop Grid)</button>
      </div>
    </div>

    <!-- MAIN FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- HEADER & MODE TOGGLER -->
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>📐</span> Slab Shuttering, Props & Steel Estimator
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Calculate bottom soffit & side formwork area, 8x4 plywood sheets, Acrow staging props, and steel reinforcement.
            </p>
          </div>

          <!-- CALCULATION METHOD SWITCHER PILLS -->
          <div class="inline-flex rounded-xl bg-slate-200/80 p-1 dark:bg-slate-800/80 self-start sm:self-center">
            <button
              type="button"
              id="btn-mode-norm"
              class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-700 shadow-xs dark:bg-blue-600 dark:text-white transition cursor-pointer"
            >
              ⚡ Normal (Contractor Takeoff)
            </button>
            <button
              type="button"
              id="btn-mode-adv"
              class="rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition cursor-pointer"
            >
              📐 Advanced (BBS & Staging)
            </button>
          </div>
        </div>
      </div>

      <form id="form-slab-shuttering" class="mt-5 space-y-6" novalidate onsubmit="return false;">

        <!-- 1. BASIC SLAB DIMENSIONS (COMMON) -->
        <div>
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-black uppercase tracking-wider text-blue-700 dark:text-blue-400 flex items-center gap-1.5">
              <span>1️⃣</span> Slab Geometry & Dimensions
            </h3>
            <div class="flex items-center gap-1 text-xs">
              <span class="text-slate-500 dark:text-slate-400 font-semibold mr-1">Unit:</span>
              <button type="button" id="btn-unit-m" class="btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer" data-unit="m">Meters (m)</button>
              <button type="button" id="btn-unit-ft" class="btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft">Feet (ft)</button>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <!-- Length -->
            <div>
              <label for="input-slab-len" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Slab Length (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="input-slab-len"
                value="10.0"
                step="0.1"
                min="0.1"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <!-- Width -->
            <div>
              <label for="input-slab-width" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Slab Width (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="input-slab-width"
                value="9.0"
                step="0.1"
                min="0.1"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <!-- Thickness -->
            <div>
              <label for="input-slab-thick" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Slab Thickness (<span id="lbl-thick-unit">mm</span>)
              </label>
              <input
                type="number"
                id="input-slab-thick"
                value="125"
                step="1"
                min="1"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- DYNAMIC SPAN RATIO & SLAB CLASSIFICATION (ADVANCED MODE ONLY) -->
        <div id="box-slab-type-banner" class="hidden rounded-2xl border border-blue-200 bg-blue-50/70 p-3.5 text-xs text-blue-950 dark:border-blue-900/60 dark:bg-blue-950/30 dark:text-blue-200">
          <div class="flex items-center gap-2">
            <span id="badge-slab-type" class="rounded-lg bg-emerald-600 px-2.5 py-1 text-[11px] font-black text-white shrink-0">
              Two-Way Slab (Ly/Lx &lt; 2.0)
            </span>
            <span id="text-slab-type-desc" class="font-semibold">
              Span ratio Ly / Lx = <strong>1.11</strong> &lt; 2.0. Both directions carry primary moments.
            </span>
          </div>
        </div>

        <!-- 2. SHUTTERING & FORMWORK SETTINGS -->
        <div class="rounded-2xl border border-slate-200/90 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/90">
          <h3 class="text-xs font-black uppercase tracking-wider text-blue-700 dark:text-blue-400 mb-3 flex items-center gap-1.5">
            <span>2️⃣</span> Shuttering & Formwork Inclusions
          </h3>
          
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 items-center">
            
            <!-- Bottom Soffit Toggle -->
            <label class="flex items-center gap-2.5 text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer">
              <input type="checkbox" id="chk-bottom-soffit" checked class="h-4 w-4 rounded border-slate-300 accent-blue-600 cursor-pointer" />
              <span>Bottom Soffit Shuttering (L × W)</span>
            </label>

            <!-- Side Shuttering Toggle -->
            <label class="flex items-center gap-2.5 text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer">
              <input type="checkbox" id="chk-side-shuttering" checked class="h-4 w-4 rounded border-slate-300 accent-blue-600 cursor-pointer" />
              <span>Side Edge Shuttering (2(L+W) × T)</span>
            </label>

            <!-- Opening Deduction -->
            <div>
              <label for="input-opening-area" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Opening / Cutout Deduction (<span class="lbl-area-unit">m²</span>)
              </label>
              <input
                type="number"
                id="input-opening-area"
                value="0"
                step="0.1"
                min="0"
                placeholder="0"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
              <span class="text-[10px] text-slate-400">Staircase / duct cutouts</span>
            </div>

          </div>
        </div>

        <!-- 3. STAGING ACROW PROPS SETTINGS -->
        <div class="rounded-2xl border border-slate-200/90 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/90">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-xs font-black uppercase tracking-wider text-blue-700 dark:text-blue-400 flex items-center gap-1.5">
              <span>3️⃣</span> Acrow Props Staging Grid Settings
            </h3>
            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">
              Standard Staging Spacing: 1.0 m – 1.2 m (3.3 ft – 4.0 ft)
            </span>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label for="input-prop-len" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Prop Spacing Along Length (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="input-prop-len"
                value="1.2"
                step="0.1"
                min="0.3"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="input-prop-width" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Prop Spacing Along Width (<span class="lbl-dim-unit">m</span>)
              </label>
              <input
                type="number"
                id="input-prop-width"
                value="1.2"
                step="0.1"
                min="0.3"
                class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- NORMAL MODE SPECIFIC SETTINGS -->
        <!-- ========================================================= -->
        <div id="section-norm-inputs" class="rounded-2xl border border-emerald-200 bg-emerald-50/40 p-4 dark:border-emerald-950 dark:bg-slate-900/70 space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-emerald-200/60 dark:border-slate-800">
            <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-900 dark:text-emerald-300 flex items-center gap-1.5">
              <span>⚡</span> Normal Steel & Concrete Mix Takeoff (Thumb Rule)
            </h3>
            <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
              CPWD Standard
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div>
              <label for="select-norm-steel-rate" class="block font-bold text-slate-700 dark:text-slate-300">
                Steel Estimation Basis
              </label>
              <select id="select-norm-steel-rate" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="80" selected>Residential Slab (80 kg/m³ of concrete)</option>
                <option value="100">Commercial Slab (100 kg/m³ of concrete)</option>
                <option value="70">Light Slab / Porch (70 kg/m³ of concrete)</option>
                <option value="area_10">Area Based (10 kg/m² / ~1 kg/sq.ft)</option>
              </select>
            </div>

            <div>
              <label for="select-norm-dia" class="block font-bold text-slate-700 dark:text-slate-300">
                Primary Bar Dia (For 12m Commercial Rods)
              </label>
              <select id="select-norm-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="8">8 mm (Weight: 4.74 kg / 12m rod)</option>
                <option value="10" selected>10 mm (Weight: 7.41 kg / 12m rod)</option>
                <option value="12">12 mm (Weight: 10.67 kg / 12m rod)</option>
              </select>
            </div>

            <div>
              <label for="select-norm-mix" class="block font-bold text-slate-700 dark:text-slate-300">
                Concrete Mix Grade
              </label>
              <select id="select-norm-mix" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="M20" selected>M20 (1 : 1.5 : 3) – Standard Slab</option>
                <option value="M25">M25 (1 : 1 : 2) – Heavy Load</option>
                <option value="M15">M15 (1 : 2 : 4) – Lean Mix</option>
              </select>
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- ADVANCED MODE SPECIFIC SETTINGS -->
        <!-- ========================================================= -->
        <div id="section-adv-inputs" class="hidden rounded-2xl border border-blue-200 bg-blue-50/40 p-4 dark:border-blue-950 dark:bg-slate-900/70 space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-blue-200/60 dark:border-slate-800">
            <h3 class="text-xs font-bold uppercase tracking-wider text-blue-900 dark:text-blue-300 flex items-center gap-1.5">
              <span>📐</span> Advanced BBS Reinforcement Detailing
            </h3>
            <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
              IS 2502 / SP 34
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            
            <!-- Short Span Main Steel -->
            <div class="rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800">
              <span class="font-bold text-slate-900 dark:text-white">Short Span Main Reinforcement</span>
              <div class="mt-2 grid grid-cols-2 gap-2">
                <div>
                  <label for="adv-main-dia" class="text-slate-500">Bar Diameter</label>
                  <select id="adv-main-dia" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                    <option value="8">8 mm</option>
                    <option value="10" selected>10 mm</option>
                    <option value="12">12 mm</option>
                    <option value="16">16 mm</option>
                  </select>
                </div>
                <div>
                  <label for="adv-main-spacing" class="text-slate-500">Spacing (<span class="lbl-spacing-unit">mm</span>)</label>
                  <input type="number" id="adv-main-spacing" value="150" min="50" step="10" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
              </div>
            </div>

            <!-- Long Span Reinforcement -->
            <div class="rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800">
              <span class="font-bold text-slate-900 dark:text-white">Long Span Reinforcement</span>
              <div class="mt-2 grid grid-cols-2 gap-2">
                <div>
                  <label for="adv-dist-dia" class="text-slate-500">Bar Diameter</label>
                  <select id="adv-dist-dia" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                    <option value="8" selected>8 mm</option>
                    <option value="10">10 mm</option>
                    <option value="12">12 mm</option>
                  </select>
                </div>
                <div>
                  <label for="adv-dist-spacing" class="text-slate-500">Spacing (<span class="lbl-spacing-unit">mm</span>)</label>
                  <input type="number" id="adv-dist-spacing" value="150" min="50" step="10" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-1.5 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
              </div>
            </div>

          </div>

          <!-- Advanced Detailing Options -->
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs pt-2">
            <div>
              <label for="adv-clear-cover" class="block font-bold text-slate-700 dark:text-slate-300">Clear Cover (<span id="lbl-cover-unit">mm</span>)</label>
              <input type="number" id="adv-clear-cover" value="15" min="10" max="50" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>

            <div>
              <label for="adv-extra-top" class="block font-bold text-slate-700 dark:text-slate-300">Top Extra Steel (%)</label>
              <input type="number" id="adv-extra-top" value="10" min="0" max="40" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>

            <div>
              <label for="adv-laps" class="block font-bold text-slate-700 dark:text-slate-300">Laps & Anchorage (%)</label>
              <input type="number" id="adv-laps" value="5" min="0" max="25" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>

            <div>
              <label for="adv-wastage" class="block font-bold text-slate-700 dark:text-slate-300">Cutting Wastage (%)</label>
              <input type="number" id="adv-wastage" value="3" min="0" max="20" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button
            type="submit"
            id="btn-calc-shuttering"
            class="flex-1 min-w-[200px] inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
          >
            <span>Calculate Formwork & Steel</span>
            <span>→</span>
          </button>
          <button
            type="button"
            id="btn-clear-shuttering"
            class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
          >
            Clear (✕)
          </button>
        </div>

        <p id="err-shuttering" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

      </form>
    </div>

    <!-- INITIAL PLACEHOLDER -->
    <div id="results-placeholder" class="rounded-3xl border border-dashed border-slate-300 bg-slate-50/50 p-8 text-center dark:border-slate-800 dark:bg-slate-900/30">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400">
        🏗️
      </div>
      <p class="mt-3 text-sm font-semibold text-slate-600 dark:text-slate-400">
        Enter slab dimensions and click <strong>Calculate Formwork & Steel</strong>.
      </p>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-500">
        Instant results: Formwork area, 8x4 ply sheets, Acrow props, steel rebar bundles, and concrete mix BOQ.
      </p>
    </div>

    <!-- CALCULATION RESULTS CONTAINER -->
    <div id="results-card" class="hidden space-y-5">
      
      <!-- PRIMARY HEADLINE RESULT CARD -->
