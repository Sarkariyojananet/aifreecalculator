  const advDistSpacing = document.getElementById('adv-dist-spacing');
  const advClearCover = document.getElementById('adv-clear-cover');
  const advExtraTop = document.getElementById('adv-extra-top');
  const advLaps = document.getElementById('adv-laps');
  const advWastage = document.getElementById('adv-wastage');

  // Action Buttons & Containers
  const btnCalcShuttering = document.getElementById('btn-calc-shuttering');
  const btnClearShuttering = document.getElementById('btn-clear-shuttering');
  const errShuttering = document.getElementById('err-shuttering');
  const resultsPlaceholder = document.getElementById('results-placeholder');
  const resultsCard = document.getElementById('results-card');

  // Output Displays
  const resTotalShutteringSqft = document.getElementById('res-total-shuttering-sqft');
  const resTotalShutteringSqm = document.getElementById('res-total-shuttering-sqm');
  const resConcreteVolFull = document.getElementById('res-concrete-vol-full');
  const resBottomArea = document.getElementById('res-bottom-area');
  const resSideArea = document.getElementById('res-side-area');
  const resSteelWeight = document.getElementById('res-steel-weight');
  const resPropsCount = document.getElementById('res-props-count');

  const resPlySheets = document.getElementById('res-ply-sheets');
  const resSteelPlates = document.getElementById('res-steel-plates');
  const resTimberRunners = document.getElementById('res-timber-runners');
  const resTimberRunnersM = document.getElementById('res-timber-runners-m');
  const resShutteringOil = document.getElementById('res-shuttering-oil');

  const tbodyProcurement = document.getElementById('tbody-procurement');
  const resBindingWire = document.getElementById('res-binding-wire');

  const resBoqCement = document.getElementById('res-boq-cement');
  const resBoqCementExact = document.getElementById('res-boq-cement-exact');
  const resBoqSand = document.getElementById('res-boq-sand');
  const resBoqSandCft = document.getElementById('res-boq-sand-cft');
  const resBoqAgg = document.getElementById('res-boq-agg');
  const resBoqAggCft = document.getElementById('res-boq-agg-cft');
  const resStepsContent = document.getElementById('res-steps-content');

  // Standard Commercial Bundle Packing
  const BARS_PER_BUNDLE = { 6: 15, 8: 10, 10: 7, 12: 5, 16: 3, 20: 2, 25: 1 };

  // Concrete Mix Proportions & Safe Numeric Engine
  const MIX_CONFIG = {
    M20: { cement: 1, sand: 1.5, aggregate: 3, label: 'M20 (1 : 1.5 : 3)' },
    M25: { cement: 1, sand: 1, aggregate: 2, label: 'M25 (1 : 1 : 2)' },
    M15: { cement: 1, sand: 2, aggregate: 4, label: 'M15 (1 : 2 : 4)' },
  };

  function calculateMixBreakup(volume, grade) {
    const wetVolume = Number(volume);
    const dryFactor = 1.54;

    const mix = MIX_CONFIG[grade] || MIX_CONFIG.M20;
    const cementRatio = Number(mix.cement);
    const sandRatio = Number(mix.sand);
    const aggRatio = Number(mix.aggregate);
    const totalRatio = cementRatio + sandRatio + aggRatio;

    if (
      !Number.isFinite(wetVolume) ||
      wetVolume <= 0 ||
      !Number.isFinite(dryFactor) ||
      dryFactor <= 0 ||
      !Number.isFinite(cementRatio) ||
      !Number.isFinite(totalRatio) ||
      totalRatio <= 0
    ) {
      return {
        dryVolumeM3: 0,
        cementVolumeM3: 0,
        cementWeightKg: 0,
        cementBags: 0,
        cementBagsExact: 0,
        sandVolumeM3: 0,
        sandVolumeCft: 0,
        aggVolumeM3: 0,
        aggVolumeCft: 0,
        mixLabel: mix.label,
        totalRatio: 5.5,
      };
    }

    const dryVolumeM3 = wetVolume * dryFactor;
    const cementVolumeM3 = dryVolumeM3 * (cementRatio / totalRatio);
    const cementWeightKg = cementVolumeM3 * 1440;
    const cementBagsExact = cementWeightKg / 50;
    const cementBags = Math.ceil(cementBagsExact);

    const sandVolumeM3 = dryVolumeM3 * (sandRatio / totalRatio);
    const sandVolumeCft = sandVolumeM3 * 35.3147;

    const aggVolumeM3 = dryVolumeM3 * (aggRatio / totalRatio);
    const aggVolumeCft = aggVolumeM3 * 35.3147;

    return {
      dryVolumeM3: Number(dryVolumeM3.toFixed(3)),
      cementVolumeM3: Number(cementVolumeM3.toFixed(3)),
      cementWeightKg: Number(cementWeightKg.toFixed(1)),
      cementBags: Number.isFinite(cementBags) ? cementBags : 0,
      cementBagsExact: Number(cementBagsExact.toFixed(2)),
      sandVolumeM3: Number(sandVolumeM3.toFixed(2)),
      sandVolumeCft: Number(sandVolumeCft.toFixed(1)),
      aggVolumeM3: Number(aggVolumeM3.toFixed(2)),
      aggVolumeCft: Number(aggVolumeCft.toFixed(1)),
      mixLabel: mix.label,
      totalRatio,
    };
  }

  function getBarUnitWeight(d) {
    if (!d || d <= 0) return 0;
    return (d * d) / 162.28;
  }

  function updateSlabTypeBadge() {
    const rawL = parseFloat(inputSlabLen.value) || 0;
    const rawW = parseFloat(inputSlabWidth.value) || 0;
    if (rawL <= 0 || rawW <= 0) return;

    const longSpan = Math.max(rawL, rawW);
    const shortSpan = Math.min(rawL, rawW);
    const ratio = shortSpan > 0 ? longSpan / shortSpan : 1;
    const isTwoWay = ratio < 2.0;

    if (isTwoWay) {
      badgeSlabType.className = 'rounded-lg bg-emerald-600 px-2.5 py-1 text-[11px] font-black text-white shrink-0';
      badgeSlabType.textContent = 'Two-Way Slab (Ly/Lx < 2.0)';
      textSlabTypeDesc.innerHTML = `Span ratio Ly / Lx = <strong>${ratio.toFixed(2)}</strong> &lt; 2.0. Both directions carry primary bending moments.`;
    } else {
      badgeSlabType.className = 'rounded-lg bg-blue-600 px-2.5 py-1 text-[11px] font-black text-white shrink-0';
      badgeSlabType.textContent = 'One-Way Slab (Ly/Lx ≥ 2.0)';
      textSlabTypeDesc.innerHTML = `Span ratio Ly / Lx = <strong>${ratio.toFixed(2)}</strong> ≥ 2.0. Short span carries main bending moment.`;
    }
  }

  inputSlabLen.addEventListener('input', updateSlabTypeBadge);
  inputSlabWidth.addEventListener('input', updateSlabTypeBadge);

  function setMode(mode) {
    currentCalculationMode = mode;
    if (mode === 'norm') {
      btnModeNorm.className = 'rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-700 shadow-xs dark:bg-blue-600 dark:text-white transition cursor-pointer';
      btnModeAdv.className = 'rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition cursor-pointer';
      sectionNormInputs.classList.remove('hidden');
      sectionAdvInputs.classList.add('hidden');
      boxSlabTypeBanner.classList.add('hidden');
    } else {
      btnModeAdv.className = 'rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-700 shadow-xs dark:bg-blue-600 dark:text-white transition cursor-pointer';
      btnModeNorm.className = 'rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition cursor-pointer';
      sectionAdvInputs.classList.remove('hidden');
      sectionNormInputs.classList.add('hidden');
      boxSlabTypeBanner.classList.remove('hidden');
      updateSlabTypeBadge();
    }

    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
    errShuttering.classList.add('hidden');
  }

  btnModeNorm.addEventListener('click', () => setMode('norm'));
  btnModeAdv.addEventListener('click', () => setMode('adv'));

  function setUnit(unit) {
    if (currentDimensionUnit === unit) return;
    currentDimensionUnit = unit;

    if (unit === 'ft') {
      btnUnitFt.className = 'btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
      btnUnitM.className = 'btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      lblDimUnits.forEach((el) => (el.textContent = 'ft'));
      lblThickUnit.textContent = 'in';
      lblAreaUnits.forEach((el) => (el.textContent = 'sq.ft'));
      lblSpacingUnits.forEach((el) => (el.textContent = 'in'));
      if (lblCoverUnit) lblCoverUnit.textContent = 'in';

      const curL = parseFloat(inputSlabLen.value) || 10;
      const curW = parseFloat(inputSlabWidth.value) || 9;
      inputSlabLen.value = (curL * 3.28084).toFixed(1);
      inputSlabWidth.value = (curW * 3.28084).toFixed(1);
      inputSlabThick.value = '5.0';
      inputPropLen.value = '4.0';
      inputPropWidth.value = '4.0';
      if (advClearCover) advClearCover.value = '0.6';
      if (advMainSpacing) advMainSpacing.value = '6.0';
      if (advDistSpacing) advDistSpacing.value = '6.0';
    } else {
      btnUnitM.className = 'btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
      btnUnitFt.className = 'btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      lblDimUnits.forEach((el) => (el.textContent = 'm'));
      lblThickUnit.textContent = 'mm';
      lblAreaUnits.forEach((el) => (el.textContent = 'm²'));
      lblSpacingUnits.forEach((el) => (el.textContent = 'mm'));
      if (lblCoverUnit) lblCoverUnit.textContent = 'mm';

      const curL = parseFloat(inputSlabLen.value) || 30;
      const curW = parseFloat(inputSlabWidth.value) || 20;
      inputSlabLen.value = (curL * 0.3048).toFixed(1);
      inputSlabWidth.value = (curW * 0.3048).toFixed(1);
      inputSlabThick.value = '125';
      inputPropLen.value = '1.2';
      inputPropWidth.value = '1.2';
      if (advClearCover) advClearCover.value = '15';
      if (advMainSpacing) advMainSpacing.value = '150';
      if (advDistSpacing) advDistSpacing.value = '150';
    }

    updateSlabTypeBadge();
    errShuttering.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
  }

  btnUnitM.addEventListener('click', () => setUnit('m'));
  btnUnitFt.addEventListener('click', () => setUnit('ft'));

  // Quick Preset Buttons
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      setUnit(btn.getAttribute('data-u'));
      inputSlabLen.value = btn.getAttribute('data-l');
      inputSlabWidth.value = btn.getAttribute('data-w');
      inputSlabThick.value = btn.getAttribute('data-t');
      inputPropLen.value = btn.getAttribute('data-pl');
      inputPropWidth.value = btn.getAttribute('data-pw');
      updateSlabTypeBadge();
      executeCalculation();
    });
  });

  // CORE CALCULATION EXECUTION
  function executeCalculation() {
    errShuttering.classList.add('hidden');

    const rawL = parseFloat(inputSlabLen.value);
    const rawW = parseFloat(inputSlabWidth.value);
    const rawT = parseFloat(inputSlabThick.value);

    if (isNaN(rawL) || isNaN(rawW) || rawL <= 0 || rawW <= 0 || isNaN(rawT) || rawT <= 0) {
      errShuttering.textContent = 'Please enter valid positive numbers for length, width, and thickness.';
      errShuttering.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    const isFt = currentDimensionUnit === 'ft';
    const L = isFt ? rawL * 0.3048 : rawL;
    const W = isFt ? rawW * 0.3048 : rawW;
    const thicknessMm = isFt ? rawT * 25.4 : rawT;
    const T = thicknessMm / 1000;

    const grossAreaSqm = L * W;
    const grossAreaSqft = grossAreaSqm * 10.7639;

    let rawOpening = parseFloat(inputOpeningArea.value) || 0;
    let openingSqm = isFt ? rawOpening / 10.7639 : rawOpening;
    if (openingSqm >= grossAreaSqm) {
      errShuttering.textContent = 'Opening cutout area cannot be greater than or equal to total slab area.';
      errShuttering.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    const netSlabAreaSqm = grossAreaSqm - openingSqm;
    const netSlabAreaSqft = netSlabAreaSqm * 10.7639;
    const perimeterM = 2 * (L + W);
    const perimeterFt = perimeterM * 3.28084;

    const concreteVolCum = netSlabAreaSqm * T;
    const concreteVolCuft = concreteVolCum * 35.3147;

    // 1. Shuttering Area
    const incBottom = chkBottomSoffit.checked;
    const incSide = chkSideShuttering.checked;

    const bottomSqm = incBottom ? netSlabAreaSqm : 0;
    const bottomSqft = bottomSqm * 10.7639;

    const sideSqm = incSide ? perimeterM * T : 0;
    const sideSqft = sideSqm * 10.7639;

    const totalSqm = bottomSqm + sideSqm;
    const totalSqft = totalSqm * 10.7639;

    // Formwork Materials Takeoff
    // Standard 8x4 ply sheet = 32 sq.ft (2.973 m²), with 5% cutting wastage
    const plySheetsCount = Math.ceil((totalSqft / 32) * 1.05);
    // Standard 3x2 steel plate = 6 sq.ft
    const steelPlatesCount = Math.ceil(totalSqft / 6);
    // Timber runners placed at ~0.5m (20 inches) spacing
    const runnerRows = Math.ceil(L / 0.5) + 1;
    const timberRunnersRmt = runnerRows * W;
    const timberRunnersRft = timberRunnersRmt * 3.28084;
    // Shuttering release oil: 1 Liter per 28 m²
    const shutteringOilL = Math.max(0.5, totalSqm / 28);

    // 2. Acrow Staging Props Grid
    const rawPL = parseFloat(inputPropLen.value) || 1.2;
    const rawPW = parseFloat(inputPropWidth.value) || 1.2;
    const propSpL = isFt ? rawPL * 0.3048 : rawPL;
    const propSpW = isFt ? rawPW * 0.3048 : rawPW;

    const rowsAlongL = Math.ceil(L / Math.max(0.3, propSpL)) + 1;
    const rowsAlongW = Math.ceil(W / Math.max(0.3, propSpW)) + 1;
    const totalPropsCount = rowsAlongL * rowsAlongW;

    // 3. Steel Reinforcement & BOQ
    let totalSteelKg = 0;
    let procRows = '';
    let steelStepsHTML = '';
    let concreteGrade = 'M20';

    if (currentCalculationMode === 'norm') {
      // Normal Mode
      const steelRateChoice = selectNormSteelRate.value;
      if (steelRateChoice === 'area_10') {
        totalSteelKg = netSlabAreaSqm * 10;
      } else {
        const rateKgCum = parseFloat(steelRateChoice) || 80;
        totalSteelKg = concreteVolCum * rateKgCum;
      }

      const primaryDia = parseInt(selectNormDia.value, 10) || 10;
      const unitWt = getBarUnitWeight(primaryDia);
      const wt12m = unitWt * 12;
      const rods12m = wt12m > 0 ? Math.ceil(totalSteelKg / wt12m) : 0;
      const pack = BARS_PER_BUNDLE[primaryDia] || 7;
      const bundles = (rods12m / pack).toFixed(1);

      procRows = `
        <tr>
          <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">${primaryDia} mm TMT Rebar</td>
          <td class="py-2.5 px-3 font-bold">${totalSteelKg.toFixed(1)} kg</td>
          <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">${rods12m} Rods (12m each)</td>
          <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">${pack} bars / bundle</td>
          <td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">${bundles} Bundles</td>
        </tr>
      `;

      concreteGrade = selectNormMix.value;
      steelStepsHTML = `
        <div class="text-blue-600 dark:text-blue-400 font-bold mb-1">• Steel Estimation (CPWD Thumb Rule):</div>
        <div>• Slab Wet Volume = ${concreteVolCum.toFixed(3)} m³ | Net Area = ${netSlabAreaSqm.toFixed(2)} m²</div>
        <div>• Total Steel Weight = ${totalSteelKg.toFixed(1)} kg (${(totalSteelKg / 100).toFixed(2)} Quintals / ${(totalSteelKg / 1000).toFixed(3)} Tonnes)</div>
        <div>• Standard 12m Rods (${primaryDia} mm) = ⌈${totalSteelKg.toFixed(1)} kg ÷ ${wt12m.toFixed(2)} kg⌉ = ${rods12m} Rods (${bundles} Bundles)</div>
      `;
    } else {
      // Advanced BBS Mode
      const longSpanM = Math.max(L, W);
      const shortSpanM = Math.min(L, W);
      const coverMm = isFt ? (parseFloat(advClearCover.value) || 0.6) * 25.4 : (parseFloat(advClearCover.value) || 15);
      const coverM = coverMm / 1000;

      const mainDia = parseInt(advMainDia.value, 10) || 10;
      const mainSpMm = isFt ? (parseFloat(advMainSpacing.value) || 6) * 25.4 : (parseFloat(advMainSpacing.value) || 150);
      const mainDistMm = Math.max(0, longSpanM * 1000 - 2 * coverMm);
      const shortBarsCount = Math.ceil(mainDistMm / mainSpMm) + 1;
      const shortHookM = 2 * (9 * (mainDia / 1000));
      const shortCutLenM = Math.max(0, shortSpanM - 2 * coverM + shortHookM);
      const shortTotalLenM = shortBarsCount * shortCutLenM;
      const shortUnitWt = getBarUnitWeight(mainDia);
      const shortTotalWtKg = shortTotalLenM * shortUnitWt;

      const distDia = parseInt(advDistDia.value, 10) || 8;
      const distSpMm = isFt ? (parseFloat(advDistSpacing.value) || 6) * 25.4 : (parseFloat(advDistSpacing.value) || 150);
      const distDistMm = Math.max(0, shortSpanM * 1000 - 2 * coverMm);
      const longBarsCount = Math.ceil(distDistMm / distSpMm) + 1;
      const longHookM = 2 * (9 * (distDia / 1000));
      const longCutLenM = Math.max(0, longSpanM - 2 * coverM + longHookM);
      const longTotalLenM = longBarsCount * longCutLenM;
      const distUnitWt = getBarUnitWeight(distDia);
      const longTotalWtKg = longTotalLenM * distUnitWt;

      const baseSteelKg = shortTotalWtKg + longTotalWtKg;
      const extraTopPct = parseFloat(advExtraTop.value) || 0;
      const extraTopKg = baseSteelKg * (Math.max(0, extraTopPct) / 100);
      const lapsPct = parseFloat(advLaps.value) || 0;
      const lapsKg = baseSteelKg * (Math.max(0, lapsPct) / 100);
      const subtotalKg = baseSteelKg + extraTopKg + lapsKg;
      const wastagePct = parseFloat(advWastage.value) || 0;
      const wastageKg = subtotalKg * (Math.max(0, wastagePct) / 100);
      totalSteelKg = subtotalKg + wastageKg;

      // Group by dia
      const diaMap = new Map();
      diaMap.set(mainDia, (diaMap.get(mainDia) || 0) + shortTotalWtKg + extraTopKg);
      diaMap.set(distDia, (diaMap.get(distDia) || 0) + longTotalWtKg);

      const grossRatio = baseSteelKg > 0 ? totalSteelKg / baseSteelKg : 1.0;
      diaMap.forEach((baseWt, d) => {
        const grossWt = baseWt * grossRatio;
        const uWt = getBarUnitWeight(d);
        const wt12 = uWt * 12;
        const rods = wt12 > 0 ? Math.ceil(grossWt / wt12) : 0;
        const pack = BARS_PER_BUNDLE[d] || 7;
        const bndl = (rods / pack).toFixed(1);
        procRows += `
          <tr>
            <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">${d} mm TMT Rebar</td>
            <td class="py-2.5 px-3 font-bold">${grossWt.toFixed(1)} kg</td>
            <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">${rods} Rods (12m each)</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">${pack} bars / bundle</td>
            <td class="py-2.5 px-3 font-bold text-emerald-600 dark:text-emerald-400">${bndl} Bundles</td>
          </tr>
        `;
      });

      concreteGrade = 'M20';
      steelStepsHTML = `
        <div class="text-blue-600 dark:text-blue-400 font-bold mb-1">• Advanced BBS Reinforcement Detailing:</div>
        <div>• Short Span Bars (${mainDia}mm @ ${mainSpMm.toFixed(0)}mm c/c): ${shortBarsCount} Bars × ${shortCutLenM.toFixed(2)}m = ${shortTotalLenM.toFixed(1)}m × ${shortUnitWt.toFixed(3)} kg/m = ${shortTotalWtKg.toFixed(1)} kg</div>
        <div>• Long Span Bars (${distDia}mm @ ${distSpMm.toFixed(0)}mm c/c): ${longBarsCount} Bars × ${longCutLenM.toFixed(2)}m = ${longTotalLenM.toFixed(1)}m × ${distUnitWt.toFixed(3)} kg/m = ${longTotalWtKg.toFixed(1)} kg</div>
        ${extraTopKg > 0 ? `<div>• Top Support Extra Steel (${extraTopPct}%): +${extraTopKg.toFixed(1)} kg</div>` : ''}
        ${lapsKg > 0 ? `<div>• Laps & Anchorage (${lapsPct}%): +${lapsKg.toFixed(1)} kg</div>` : ''}
        ${wastageKg > 0 ? `<div>• Cutting Wastage (${wastagePct}%): +${wastageKg.toFixed(1)} kg</div>` : ''}
        <div class="font-bold text-slate-900 dark:text-white pt-0.5">👉 Total Calculated Steel = ${totalSteelKg.toFixed(1)} kg (${(totalSteelKg / 100).toFixed(2)} Quintals / ${(totalSteelKg / 1000).toFixed(3)} Tonnes)</div>
      `;
    }

    // Concrete Mix Breakup
    const mixBreakup = calculateMixBreakup(concreteVolCum, concreteGrade, 1.54);

    // Populate Results Displays
    resTotalShutteringSqft.textContent = `${totalSqft.toFixed(1)} sq.ft`;
    resTotalShutteringSqm.textContent = `(${totalSqm.toFixed(2)} m²)`;
    resConcreteVolFull.textContent = `${concreteVolCum.toFixed(2)} m³ (${concreteVolCuft.toFixed(1)} cu ft)`;

    resBottomArea.textContent = `${bottomSqft.toFixed(1)} sq.ft (${bottomSqm.toFixed(2)} m²)`;
    resSideArea.textContent = `${sideSqft.toFixed(1)} sq.ft (${sideSqm.toFixed(2)} m²)`;
    resSteelWeight.textContent = `${totalSteelKg.toFixed(0)} kg (${(totalSteelKg / 1000).toFixed(2)} Tonnes)`;
    resPropsCount.textContent = `${totalPropsCount} Props`;

    resPlySheets.textContent = `${plySheetsCount} Sheets`;
    resSteelPlates.textContent = `${steelPlatesCount} Plates`;
    resTimberRunners.textContent = `${timberRunnersRft.toFixed(0)} R.ft`;
    resTimberRunnersM.textContent = `${timberRunnersRmt.toFixed(1)} R.mt (@ 0.5m c/c)`;
    resShutteringOil.textContent = `${shutteringOilL.toFixed(1)} Liters`;

    tbodyProcurement.innerHTML = procRows;
    resBindingWire.textContent = `${Math.max(1, totalSteelKg * 0.01).toFixed(1)} kg`;

    resBoqCement.textContent = `${mixBreakup.cementBags} Bags`;
    resBoqCementExact.textContent = `${mixBreakup.cementBagsExact.toFixed(1)} exact bags (50kg)`;
    resBoqSand.textContent = `${mixBreakup.sandVolumeM3.toFixed(2)} m³`;
    resBoqSandCft.textContent = `${mixBreakup.sandVolumeCft.toFixed(1)} cu.ft (Dry mix)`;
    resBoqAgg.textContent = `${mixBreakup.aggVolumeM3.toFixed(2)} m³`;
    resBoqAggCft.textContent = `${mixBreakup.aggVolumeCft.toFixed(1)} cu.ft (Coarse 20mm)`;

    // Worked steps
    resStepsContent.innerHTML = `
      <div class="text-blue-600 dark:text-blue-400 font-bold">• Slab Dimensions: ${L.toFixed(2)} m × ${W.toFixed(2)} m × ${thicknessMm.toFixed(0)} mm (${(L*3.28084).toFixed(1)} ft × ${(W*3.28084).toFixed(1)} ft)</div>
      <div>• Gross Slab Area = ${L.toFixed(2)} m × ${W.toFixed(2)} m = ${grossAreaSqm.toFixed(2)} m² (${grossAreaSqft.toFixed(1)} sq.ft)</div>
      ${openingSqm > 0 ? `<div>• Opening Cutout Deducted = -${openingSqm.toFixed(2)} m² (-${openingSqft.toFixed(1)} sq.ft)</div>` : ''}
      <div>• Bottom Soffit Shuttering = ${bottomSqm.toFixed(2)} m² (${bottomSqft.toFixed(1)} sq.ft)</div>
      <div>• Slab Perimeter = 2 × (${L.toFixed(2)} + ${W.toFixed(2)}) = ${perimeterM.toFixed(2)} m (${perimeterFt.toFixed(1)} ft)</div>
      <div>• Side Edge Formwork = ${perimeterM.toFixed(2)} m × ${T.toFixed(3)} m = ${sideSqm.toFixed(2)} m² (${sideSqft.toFixed(1)} sq.ft)</div>
      <div class="font-bold text-slate-900 dark:text-white pt-0.5">👉 Total Shuttering Area = ${bottomSqm.toFixed(2)} + ${sideSqm.toFixed(2)} = ${totalSqm.toFixed(2)} m² (${totalSqft.toFixed(1)} sq.ft)</div>

      <div class="pt-2 text-amber-600 dark:text-amber-400 font-bold">• Formwork Procurement Takeoff:</div>
      <div>• Commercial 8×4 ft Plywood Sheets = ⌈(${totalSqft.toFixed(1)} sq.ft ÷ 32 sq.ft) × 1.05⌉ = ${plySheetsCount} Sheets</div>
      <div>• Steel Shuttering Plates (3×2 ft) = ⌈${totalSqft.toFixed(1)} sq.ft ÷ 6 sq.ft⌉ = ${steelPlatesCount} Plates</div>
      <div>• Timber Runners (Joists @ 0.5m spacing) = ${timberRunnersRmt.toFixed(1)} R.mt (${timberRunnersRft.toFixed(0)} R.ft)</div>
      <div>• Shuttering Release Oil = ${totalSqm.toFixed(2)} m² ÷ 28 m²/L = ${shutteringOilL.toFixed(1)} Liters</div>

      <div class="pt-2 text-purple-600 dark:text-purple-400 font-bold">• Acrow Props Staging Grid (Spacing: ${rawPL}${isFt ? 'ft' : 'm'} × ${rawPW}${isFt ? 'ft' : 'm'}):</div>
      <div>• Rows along Length = ⌈${L.toFixed(2)} ÷ ${propSpL.toFixed(2)}⌉ + 1 = ${rowsAlongL} rows</div>
      <div>• Rows along Width = ⌈${W.toFixed(2)} ÷ ${propSpW.toFixed(2)}⌉ + 1 = ${rowsAlongW} rows</div>
      <div class="font-bold text-slate-900 dark:text-white pt-0.5">👉 Total Staging Props = ${rowsAlongL} × ${rowsAlongW} = ${totalPropsCount} Props (with ${totalPropsCount} Base Sole Plates)</div>

      <div class="pt-2">${steelStepsHTML}</div>

      <div class="pt-2 text-emerald-600 dark:text-emerald-400 font-bold">• Concrete Mix BOQ (${mixBreakup.mixLabel}):</div>
      <div>• Wet Concrete Volume = ${concreteVolCum.toFixed(3)} m³ (${concreteVolCuft.toFixed(1)} cu.ft)</div>
      <div>• Dry Concrete Volume = ${concreteVolCum.toFixed(3)} m³ × 1.54 = ${mixBreakup.dryVolumeM3.toFixed(3)} m³</div>
      <div>• Cement Volume = ${mixBreakup.dryVolumeM3.toFixed(3)} m³ × (1 ÷ ${mixBreakup.totalRatio}) = ${mixBreakup.cementVolumeM3.toFixed(3)} m³</div>
      <div>• Cement Weight = ${mixBreakup.cementVolumeM3.toFixed(3)} m³ × 1440 kg/m³ = ${mixBreakup.cementWeightKg.toFixed(1)} kg</div>
      <div>• Cement Bags (50kg) = ⌈${mixBreakup.cementWeightKg.toFixed(1)} kg ÷ 50 kg⌉ = ${mixBreakup.cementBags} Bags (${mixBreakup.cementBagsExact.toFixed(1)} exact)</div>
      <div>• Sand = ${mixBreakup.sandVolumeM3.toFixed(2)} m³ (${mixBreakup.sandVolumeCft.toFixed(1)} cu.ft) | Aggregate = ${mixBreakup.aggVolumeM3.toFixed(2)} m³ (${mixBreakup.aggVolumeCft.toFixed(1)} cu.ft)</div>
    `;

    resultsPlaceholder.classList.add('hidden');
    resultsCard.classList.remove('hidden');

    // DISPATCH ACTION BAR SYNC EVENT
    document.dispatchEvent(new CustomEvent('calculator:updated'));
  }

  btnCalcShuttering.addEventListener('click', (e) => {
    e.preventDefault();
    executeCalculation();
  });

  btnClearShuttering.addEventListener('click', () => {
    if (currentDimensionUnit === 'm') {
      inputSlabLen.value = '10.0';
      inputSlabWidth.value = '9.0';
      inputSlabThick.value = '125';
      inputPropLen.value = '1.2';
      inputPropWidth.value = '1.2';
      if (advClearCover) advClearCover.value = '15';
      if (advMainSpacing) advMainSpacing.value = '150';
      if (advDistSpacing) advDistSpacing.value = '150';
    } else {
      inputSlabLen.value = '30.0';
      inputSlabWidth.value = '20.0';
      inputSlabThick.value = '5.0';
      inputPropLen.value = '4.0';
      inputPropWidth.value = '4.0';
      if (advClearCover) advClearCover.value = '0.6';
      if (advMainSpacing) advMainSpacing.value = '6.0';
      if (advDistSpacing) advDistSpacing.value = '6.0';
    }

    chkBottomSoffit.checked = true;
    chkSideShuttering.checked = true;
    inputOpeningArea.value = '0';
    selectNormSteelRate.value = '80';
    selectNormDia.value = '10';
    selectNormMix.value = 'M20';

    if (advMainDia) advMainDia.value = '10';
    if (advDistDia) advDistDia.value = '8';
    if (advExtraTop) advExtraTop.value = '10';
    if (advLaps) advLaps.value = '5';
    if (advWastage) advWastage.value = '3';

    updateSlabTypeBadge();
    errShuttering.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
    inputSlabLen.focus();

    document.dispatchEvent(new CustomEvent('calculator:updated'));
  });

  // Enter Key Handler
  document.querySelectorAll('input').forEach((inp) => {
    inp.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeCalculation();
      }
    });
  });

  document.addEventListener('DOMContentLoaded', updateSlabTypeBadge);
  updateSlabTypeBadge();
</script>
