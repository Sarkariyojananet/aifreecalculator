<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // DOM Elements
  const inputSlabLen = document.getElementById('input-slab-len');
  const unitSlabLen = document.getElementById('unit-slab-len');
  const inputSlabWidth = document.getElementById('input-slab-width');
  const unitSlabWidth = document.getElementById('unit-slab-width');
  const inputSlabThick = document.getElementById('input-slab-thick');
  const unitSlabThick = document.getElementById('unit-slab-thick');

  const chkBottomSoffit = document.getElementById('chk-bottom-soffit');
  const chkSideShuttering = document.getElementById('chk-side-shuttering');
  const inputOpeningArea = document.getElementById('input-opening-area');
  const unitOpeningArea = document.getElementById('unit-opening-area');

  // Steel Modes
  let steelMode = 'simple';
  const btnSteelModeSimple = document.getElementById('btn-steel-mode-simple');
  const btnSteelModeDetailed = document.getElementById('btn-steel-mode-detailed');
  const containerSteelSimple = document.getElementById('container-steel-simple');
  const containerSteelDetailed = document.getElementById('container-steel-detailed');

  const inputSteelRate = document.getElementById('input-steel-rate');
  const unitSteelRate = document.getElementById('unit-steel-rate');

  const detB1Dia = document.getElementById('det-b1-dia');
  const detB1Spacing = document.getElementById('det-b1-spacing');
  const detB2Dia = document.getElementById('det-b2-dia');
  const detB2Spacing = document.getElementById('det-b2-spacing');
  const chkTopSteel = document.getElementById('chk-top-steel');
  const detWastage = document.getElementById('det-wastage');

  // Props
  const inputPropLen = document.getElementById('input-prop-len');
  const unitPropLen = document.getElementById('unit-prop-len');
  const inputPropWidth = document.getElementById('input-prop-width');
  const unitPropWidth = document.getElementById('unit-prop-width');

  // Buttons & Alerts
  const btnCalcShuttering = document.getElementById('btn-calc-shuttering');
  const btnClearShuttering = document.getElementById('btn-clear-shuttering');
  const errShuttering = document.getElementById('err-shuttering');

  // Results Displays
  const resultsPlaceholder = document.getElementById('results-placeholder');
  const resultsCard = document.getElementById('results-card');
  const resTotalShutteringSqft = document.getElementById('res-total-shuttering-sqft');
  const resTotalShutteringSqm = document.getElementById('res-total-shuttering-sqm');
  const resBottomArea = document.getElementById('res-bottom-area');
  const resSideArea = document.getElementById('res-side-area');
  const resSteelWeight = document.getElementById('res-steel-weight');
  const resPropsCount = document.getElementById('res-props-count');
  const resStepsContent = document.getElementById('res-steps-content');

  // Switch Steel Mode
  btnSteelModeSimple.addEventListener('click', () => {
    steelMode = 'simple';
    btnSteelModeSimple.className = 'rounded-lg bg-blue-600 px-3 py-1 font-bold text-white shadow-xs cursor-pointer';
    btnSteelModeDetailed.className = 'rounded-lg px-3 py-1 font-semibold text-slate-700 hover:text-blue-600 dark:text-slate-300 cursor-pointer';
    containerSteelSimple.classList.remove('hidden');
    containerSteelDetailed.classList.add('hidden');
  });

  btnSteelModeDetailed.addEventListener('click', () => {
    steelMode = 'detailed';
    btnSteelModeDetailed.className = 'rounded-lg bg-blue-600 px-3 py-1 font-bold text-white shadow-xs cursor-pointer';
    btnSteelModeSimple.className = 'rounded-lg px-3 py-1 font-semibold text-slate-700 hover:text-blue-600 dark:text-slate-300 cursor-pointer';
    containerSteelDetailed.classList.remove('hidden');
    containerSteelSimple.classList.add('hidden');
  });

  // Calculate Function
  function executeCalculation() {
    errShuttering.classList.add('hidden');

    // Unit Normalization to SI (Meters, mm, m²)
    let rawL = parseFloat(inputSlabLen.value);
    let rawW = parseFloat(inputSlabWidth.value);
    let rawT = parseFloat(inputSlabThick.value);

    if (isNaN(rawL) || rawL <= 0 || isNaN(rawW) || rawW <= 0 || isNaN(rawT) || rawT <= 0) {
      errShuttering.textContent = 'Please enter valid positive dimensions for length, width, and thickness.';
      errShuttering.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    const L = unitSlabLen.value === 'ft' ? rawL * 0.3048 : rawL;
    const W = unitSlabWidth.value === 'ft' ? rawW * 0.3048 : rawW;
    const T = unitSlabThick.value === 'in' ? (rawT * 25.4) / 1000 : rawT / 1000;

    const grossAreaSqm = L * W;
    const grossAreaSqft = grossAreaSqm * 10.7639;

    let rawOpening = parseFloat(inputOpeningArea.value) || 0;
    let openingSqm = unitOpeningArea.value === 'sqft' ? rawOpening / 10.7639 : rawOpening;

    if (openingSqm >= grossAreaSqm) {
      errShuttering.textContent = 'Opening area cannot be greater than or equal to the total slab area.';
      errShuttering.classList.remove('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      return;
    }

    const netSlabAreaSqm = grossAreaSqm - openingSqm;
    const netSlabAreaSqft = netSlabAreaSqm * 10.7639;
    const perimeterM = 2 * (L + W);

    // 1. Shuttering Area
    const incBottom = chkBottomSoffit.checked;
    const incSide = chkSideShuttering.checked;

    const bottomSqm = incBottom ? netSlabAreaSqm : 0;
    const bottomSqft = bottomSqm * 10.7639;

    const sideSqm = incSide ? perimeterM * T : 0;
    const sideSqft = sideSqm * 10.7639;

    const totalSqm = bottomSqm + sideSqm;
    const totalSqft = totalSqm * 10.7639;

    // 2. Steel Weight
    let totalSteelKg = 0;
    let steelBreakdownHTML = '';

    if (steelMode === 'simple') {
      const rawRate = parseFloat(inputSteelRate.value) || 0;
      const rateSqm = unitSteelRate.value === 'kg_sqft' ? rawRate * 10.7639 : rawRate;
      totalSteelKg = netSlabAreaSqm * rateSqm;
      steelBreakdownHTML = `
        <div class="text-blue-600 dark:text-blue-400 font-bold">• Steel Estimation (User-Provided Rate):</div>
        <div>• Area = ${netSlabAreaSqm.toFixed(2)} m² × ${rawRate} ${unitSteelRate.value === 'kg_sqft' ? 'kg/sq.ft' : 'kg/m²'} = ${totalSteelKg.toFixed(1)} kg (${(totalSteelKg/1000).toFixed(3)} MT)</div>
      `;
    } else {
      // Detailed BBS
      const b1Dia = parseFloat(detB1Dia.value);
      const b1Spacing = parseFloat(detB1Spacing.value) / 1000;
      const b1Count = Math.ceil(L / b1Spacing) + 1;
      const b1TotalLen = b1Count * W;
      const b1UnitWt = (b1Dia * b1Dia) / 162.28;
      const b1Wt = b1TotalLen * b1UnitWt;

      const b2Dia = parseFloat(detB2Dia.value);
      const b2Spacing = parseFloat(detB2Spacing.value) / 1000;
      const b2Count = Math.ceil(W / b2Spacing) + 1;
      const b2TotalLen = b2Count * L;
      const b2UnitWt = (b2Dia * b2Dia) / 162.28;
      const b2Wt = b2TotalLen * b2UnitWt;

      let topWt = 0;
      let topHtml = '';
      if (chkTopSteel.checked) {
        const t1Count = Math.ceil(L / 0.2) + 1;
        const t1TotalLen = t1Count * W;
        const t1Wt = t1TotalLen * ((8 * 8) / 162.28);

        const t2Count = Math.ceil(W / 0.2) + 1;
        const t2TotalLen = t2Count * L;
        const t2Wt = t2TotalLen * ((8 * 8) / 162.28);
        topWt = t1Wt + t2Wt;
        topHtml = `<div>• Top Reinforcement (8mm @ 200mm c/c) = ${topWt.toFixed(1)} kg</div>`;
      }

      const baseSteel = b1Wt + b2Wt + topWt;
      const wastagePct = parseFloat(detWastage.value) || 0;
      const wastageKg = baseSteel * (wastagePct / 100);
      totalSteelKg = baseSteel + wastageKg;

      steelBreakdownHTML = `
        <div class="text-blue-600 dark:text-blue-400 font-bold">• Detailed Reinforcement (D²/162.28):</div>
        <div>• Bottom Main Bars (Ø${b1Dia} mm @ ${b1Spacing*1000}mm): ${b1Count} bars × ${W.toFixed(2)}m = ${b1TotalLen.toFixed(1)}m × ${b1UnitWt.toFixed(3)} kg/m = ${b1Wt.toFixed(1)} kg</div>
        <div>• Bottom Dist. Bars (Ø${b2Dia} mm @ ${b2Spacing*1000}mm): ${b2Count} bars × ${L.toFixed(2)}m = ${b2TotalLen.toFixed(1)}m × ${b2UnitWt.toFixed(3)} kg/m = ${b2Wt.toFixed(1)} kg</div>
        ${topHtml}
        ${wastagePct > 0 ? `<div>• Wastage Allowance (${wastagePct}%): +${wastageKg.toFixed(1)} kg</div>` : ''}
        <div class="font-bold text-slate-900 dark:text-white pt-0.5">👉 Total Calculated Steel = ${totalSteelKg.toFixed(1)} kg (${(totalSteelKg/1000).toFixed(3)} MT)</div>
      `;
    }

    // 3. Acrow Props
    let rawPL = parseFloat(inputPropLen.value) || 1.2;
    let rawPW = parseFloat(inputPropWidth.value) || 1.2;
    const propSpL = unitPropLen.value === 'ft' ? rawPL * 0.3048 : rawPL;
    const propSpW = unitPropWidth.value === 'ft' ? rawPW * 0.3048 : rawPW;

    const rowsL = Math.ceil(L / propSpL) + 1;
    const rowsW = Math.ceil(W / propSpW) + 1;
    const totalProps = rowsL * rowsW;

    // Populate Results
    resTotalShutteringSqft.textContent = `${totalSqft.toFixed(1)} sq.ft`;
    resTotalShutteringSqm.textContent = `(${totalSqm.toFixed(2)} m²)`;

    resBottomArea.textContent = `${bottomSqft.toFixed(1)} sq.ft (${bottomSqm.toFixed(2)} m²)`;
    resSideArea.textContent = `${sideSqft.toFixed(1)} sq.ft (${sideSqm.toFixed(2)} m²)`;
    resSteelWeight.textContent = `${totalSteelKg.toFixed(0)} kg (${(totalSteelKg/1000).toFixed(2)} MT)`;
    resPropsCount.textContent = `${totalProps} Props`;

    resStepsContent.innerHTML = `
      <div class="text-blue-600 dark:text-blue-400 font-bold">• Slab Dimensions: ${L.toFixed(2)} m × ${W.toFixed(2)} m × ${(T*1000).toFixed(0)} mm (${(L*3.28084).toFixed(1)} ft × ${(W*3.28084).toFixed(1)} ft)</div>
      <div>• Gross Slab Area = ${L.toFixed(2)} m × ${W.toFixed(2)} m = ${grossAreaSqm.toFixed(2)} m² (${grossAreaSqft.toFixed(1)} sq.ft)</div>
      ${openingSqm > 0 ? `<div>• Opening Cutout Deducted = -${openingSqm.toFixed(2)} m² (${(openingSqm*10.7639).toFixed(1)} sq.ft)</div>` : ''}
      <div>• Bottom Soffit Area = ${bottomSqm.toFixed(2)} m² (${bottomSqft.toFixed(1)} sq.ft)</div>
      <div>• Slab Perimeter = 2 × (${L.toFixed(2)} + ${W.toFixed(2)}) = ${perimeterM.toFixed(2)} m</div>
      <div>• Side Shuttering Area = ${perimeterM.toFixed(2)} m × ${T.toFixed(3)} m = ${sideSqm.toFixed(2)} m² (${sideSqft.toFixed(1)} sq.ft)</div>
      <div class="font-bold text-slate-900 dark:text-white pt-1">👉 Total Shuttering Area = ${bottomSqm.toFixed(2)} + ${sideSqm.toFixed(2)} = ${totalSqm.toFixed(2)} m² (${totalSqft.toFixed(1)} sq.ft)</div>
      <div class="pt-2">${steelBreakdownHTML}</div>
      <div class="pt-2 text-blue-600 dark:text-blue-400 font-bold">• Acrow Props Grid (Spacing: ${rawPL}${unitPropLen.value} × ${rawPW}${unitPropWidth.value}):</div>
      <div>• Rows along Length = Ceiling(${L.toFixed(2)} ÷ ${propSpL.toFixed(2)}) + 1 = ${rowsL} rows</div>
      <div>• Rows along Width = Ceiling(${W.toFixed(2)} ÷ ${propSpW.toFixed(2)}) + 1 = ${rowsW} rows</div>
      <div class="font-bold text-slate-900 dark:text-white pt-0.5">👉 Total Staging Props = ${rowsL} × ${rowsW} = ${totalProps} Props</div>
    `;

    resultsPlaceholder.classList.add('hidden');
    resultsCard.classList.remove('hidden');
  }

  btnCalcShuttering.addEventListener('click', (e) => {
    e.preventDefault();
    executeCalculation();
  });

  // Preset Buttons
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      inputSlabLen.value = btn.getAttribute('data-l');
      unitSlabLen.value = btn.getAttribute('data-lu');
      inputSlabWidth.value = btn.getAttribute('data-w');
      unitSlabWidth.value = btn.getAttribute('data-wu');
      inputSlabThick.value = btn.getAttribute('data-t');
      unitSlabThick.value = btn.getAttribute('data-tu');
      inputPropLen.value = btn.getAttribute('data-pl');
      inputPropWidth.value = btn.getAttribute('data-pw');
      executeCalculation();
    });
  });

  // Clear Button
  btnClearShuttering.addEventListener('click', () => {
    inputSlabLen.value = '10';
    unitSlabLen.value = 'm';
    inputSlabWidth.value = '9';
    unitSlabWidth.value = 'm';
    inputSlabThick.value = '125';
    unitSlabThick.value = 'mm';

    chkBottomSoffit.checked = true;
    chkSideShuttering.checked = true;
    inputOpeningArea.value = '0';
    unitOpeningArea.value = 'sqm';

    steelMode = 'simple';
    btnSteelModeSimple.className = 'rounded-lg bg-blue-600 px-3 py-1 font-bold text-white shadow-xs cursor-pointer';
    btnSteelModeDetailed.className = 'rounded-lg px-3 py-1 font-semibold text-slate-700 hover:text-blue-600 dark:text-slate-300 cursor-pointer';
    containerSteelSimple.classList.remove('hidden');
    containerSteelDetailed.classList.add('hidden');
    inputSteelRate.value = '10';
    unitSteelRate.value = 'kg_sqm';

    inputPropLen.value = '1.2';
    unitPropLen.value = 'm';
    inputPropWidth.value = '1.2';
    unitPropWidth.value = 'm';

    errShuttering.classList.add('hidden');
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
  });

  // Enter Key Handler
  document.querySelectorAll('input').forEach((inp) => {
    inp.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeCalculation();
      }
    });
  });
</script>
