---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="RCC Footing Steel & Concrete Calculator - Foundation Mesh BBS"
  description="Calculate isolated pad and sloped footing reinforcement steel weight, bar cutting length with L-bends, column starter dowels, BBS schedule, concrete volume, and excavation pit size."
  category="Construction"
  calculatorName="RCC Footing Steel Calculator"
  slug="rcc-footing-steel-calculator"
  keywords={[
    'rcc footing steel calculator',
    'footing bbs bar bending schedule',
    'foundation mesh rebar weight',
    'isolated pad footing concrete volume',
    'sloped footing calculation',
    'column starter dowels footing',
    'footing excavation pcc boq'
  ]}
>
  <div class="space-y-6">
    
    <!-- TOP TOOLBAR: PRESET BUTTONS & MODE SWITCHER -->
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-100 pb-4 dark:border-slate-800">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-blue-600 dark:text-blue-400">IS 456:2000 & ACI 318 Foundation Takeoff</span>
          <h2 class="text-lg font-black text-slate-900 dark:text-white sm:text-xl">
            RCC Isolated Pad & Sloped Footing BBS Calculator
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Calculate orthogonal rebar mesh, end L-bends, column starter dowels, concrete volume, commercial 12m bundles, PCC blinding, and cost.
          </p>
        </div>
        
        <!-- CALCULATION METHOD SWITCHER PILLS -->
        <div class="inline-flex rounded-xl bg-slate-200/80 p-1 dark:bg-slate-800/80 self-start sm:self-center">
          <button
            type="button"
            id="btn-mode-adv"
            class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-700 shadow-xs dark:bg-blue-600 dark:text-white transition cursor-pointer"
          >
            📐 Advanced BBS Mode
          </button>
          <button
            type="button"
            id="btn-mode-norm"
            class="rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition cursor-pointer"
          >
            ⚡ Normal (Thumb Rule)
          </button>
        </div>
      </div>

      <!-- QUICK ENGINEERING PRESETS -->
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 mr-1">Quick Presets:</span>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer"
          data-type="flat" data-l="1200" data-b="1200" data-d="300" data-dia="10" data-sp="150" data-dowels="4" data-doweldia="12" data-unit="m"
        >
          🏡 1.2m Pad (Residential)
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer"
          data-type="flat" data-l="1500" data-b="1500" data-d="350" data-dia="12" data-sp="150" data-dowels="4" data-doweldia="16" data-unit="m"
        >
          🏢 1.5m Standard Isolated
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer"
          data-type="flat" data-l="1800" data-b="1800" data-d="450" data-dia="12" data-sp="125" data-dowels="6" data-doweldia="16" data-unit="m"
        >
          🏗️ 1.8m Heavy Commercial
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer"
          data-type="sloped" data-l="2400" data-b="2400" data-d="600" data-d1="200" data-pedl="450" data-pedb="450" data-dia="16" data-sp="100" data-dowels="8" data-doweldia="20" data-unit="m"
        >
          🏛️ 2.4m High-Rise Sloped Footing
        </button>
        <button
          type="button"
          class="btn-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700 dark:border-slate-800 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer"
          data-type="flat" data-l="5.0" data-b="5.0" data-d="16" data-dia="12" data-sp="6" data-dowels="4" data-doweldia="16" data-unit="ft"
        >
          🇺🇸 5ft × 5ft US Pad (#4 @ 6")
        </button>
      </div>

      <form id="form-rcc-footing" class="mt-5 space-y-5" novalidate onsubmit="return false;">
        
        <!-- SECTION 1: FOOTING GEOMETRY & UNIT CONTROLS -->
        <div>
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>1.</span> Footing Geometry & Configuration
            </h3>
            <div class="flex items-center gap-1 text-xs">
              <span class="text-slate-500 dark:text-slate-400 font-semibold mr-1">Unit:</span>
              <button type="button" id="btn-unit-m" class="btn-unit active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer" data-unit="m">Metric (m / mm)</button>
              <button type="button" id="btn-unit-ft" class="btn-unit rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-unit="ft">Imperial (ft / in)</button>
            </div>
          </div>

          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <label for="ft-type" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Footing Geometry Type</label>
              <select id="ft-type" class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer">
                <option value="flat" selected>Flat Isolated Pad Footing</option>
                <option value="sloped">Trapezoidal / Sloped Footing</option>
              </select>
            </div>

            <div>
              <label for="ft-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Footing Length L (<span class="lbl-dim-unit">mm</span>)
              </label>
              <input
                type="number"
                id="ft-len"
                value="1500"
                step="50"
                min="300"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="ft-width" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Footing Width B (<span class="lbl-dim-unit">mm</span>)
              </label>
              <input
                type="number"
                id="ft-width"
                value="1500"
                step="50"
                min="300"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div>
              <label for="ft-depth" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Total Footing Depth D (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="ft-depth"
                value="350"
                step="25"
                min="100"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <!-- SLOPED FOOTING SPECIFIC PARAMETERS -->
            <div id="box-sloped-d1" class="hidden">
              <label for="ft-d1" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Base Vertical Edge Depth D₁ (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="ft-d1"
                value="150"
                step="25"
                min="100"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>

            <div id="box-sloped-ped" class="hidden sm:col-span-2">
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="ft-ped-l" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                    Pedestal Top Length a (<span class="lbl-sec-unit">mm</span>)
                  </label>
                  <input
                    type="number"
                    id="ft-ped-l"
                    value="400"
                    step="25"
                    min="200"
                    class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                  />
                </div>
                <div>
                  <label for="ft-ped-w" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                    Pedestal Top Width b (<span class="lbl-sec-unit">mm</span>)
                  </label>
                  <input
                    type="number"
                    id="ft-ped-w"
                    value="400"
                    step="25"
                    min="200"
                    class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                  />
                </div>
              </div>
            </div>

            <div>
              <label for="ft-cover" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Clear Cover (<span class="lbl-sec-unit">mm</span>)
              </label>
              <input
                type="number"
                id="ft-cover"
                value="50"
                step="5"
                min="25"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
              <span class="text-[10px] text-slate-500 dark:text-slate-400">IS 456 Cl 26.4.2.2: Min 50mm for footings</span>
            </div>

            <div>
              <label for="ft-count" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Number of Footings</label>
              <input
                type="number"
                id="ft-count"
                value="1"
                min="1"
                step="1"
                class="mt-1 w-full rounded-xl border-2 border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- SECTION 2A: ADVANCED BBS REBAR DETAILING (SHOWN IN ADVANCED MODE) -->
        <div id="section-adv-inputs" class="space-y-4">
          <div class="flex items-center justify-between border-t border-slate-200/80 pt-4 dark:border-slate-800">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>2.</span> Bottom Reinforcement Mesh & Rebar Specifications
            </h3>
            <span class="text-[11px] font-semibold text-blue-600 dark:text-blue-400">IS 2502 & IS 456 Compliant</span>
          </div>

          <!-- BOTTOM MESH X & Y GRID -->
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <!-- X-Direction Rebars -->
            <div class="rounded-2xl border border-blue-100 bg-blue-50/50 p-4 dark:border-blue-950/40 dark:bg-blue-950/20">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-blue-900 dark:text-blue-200 flex items-center gap-1.5">
                  <span>↔️</span> X-Direction Bottom Mesh (Parallel to Length L)
                </h4>
                <span class="text-[10px] font-bold rounded-md bg-blue-100 px-2 py-0.5 text-blue-800 dark:bg-blue-900 dark:text-blue-200">Main Mat</span>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-3 text-xs">
                <div>
                  <label for="ft-dia-x" class="block font-bold text-slate-700 dark:text-slate-300">Bar Diameter</label>
                  <select id="ft-dia-x" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                    <option value="8">8 mm</option>
                    <option value="10">10 mm</option>
                    <option value="12" selected>12 mm (Standard)</option>
                    <option value="16">16 mm (Heavy Load)</option>
                    <option value="20">20 mm</option>
                    <option value="25">25 mm</option>
                  </select>
                </div>
                <div>
                  <label for="ft-sp-x" class="block font-bold text-slate-700 dark:text-slate-300">
                    Spacing c/c (<span class="lbl-sec-unit">mm</span>)
                  </label>
                  <input type="number" id="ft-sp-x" value="150" step="10" min="50" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
              </div>
            </div>

            <!-- Y-Direction Rebars -->
            <div class="rounded-2xl border border-emerald-100 bg-emerald-50/50 p-4 dark:border-emerald-950/40 dark:bg-emerald-950/20">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-emerald-900 dark:text-emerald-200 flex items-center gap-1.5">
                  <span>↕️</span> Y-Direction Bottom Mesh (Parallel to Width B)
                </h4>
                <span class="text-[10px] font-bold rounded-md bg-emerald-100 px-2 py-0.5 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200">Main Mat</span>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-3 text-xs">
                <div>
                  <label for="ft-dia-y" class="block font-bold text-slate-700 dark:text-slate-300">Bar Diameter</label>
                  <select id="ft-dia-y" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                    <option value="8">8 mm</option>
                    <option value="10">10 mm</option>
                    <option value="12" selected>12 mm (Standard)</option>
                    <option value="16">16 mm (Heavy Load)</option>
                    <option value="20">20 mm</option>
                    <option value="25">25 mm</option>
                  </select>
                </div>
                <div>
                  <label for="ft-sp-y" class="block font-bold text-slate-700 dark:text-slate-300">
                    Spacing c/c (<span class="lbl-sec-unit">mm</span>)
                  </label>
                  <input type="number" id="ft-sp-y" value="150" step="10" min="50" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
              </div>
            </div>
          </div>

          <!-- END ANCHORAGE BEND-UPS & COLUMN STARTER DOWELS -->
          <div class="rounded-2xl border border-slate-200/80 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-950/60 space-y-4">
            
            <div class="flex flex-wrap items-center justify-between gap-3">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="check-bend-up" checked class="h-4 w-4 rounded-md border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
                <span class="text-xs font-bold text-slate-800 dark:text-slate-200">
                  Include 90° Vertical End Bend-ups (L-hooks) on Mesh Ends
                </span>
              </label>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">Leg = Depth − 2×Cover (IS 2502 Bend Deduction Applied)</span>
            </div>

            <!-- COLUMN STARTER DOWELS -->
            <div class="border-t border-slate-200/60 pt-3 dark:border-slate-800">
              <div class="flex items-center justify-between">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="check-dowels" checked class="h-4 w-4 rounded-md border-amber-300 text-amber-600 focus:ring-amber-500 cursor-pointer" />
                  <span class="text-xs font-bold text-slate-800 dark:text-slate-200">
                    Include Column Starter Dowel Rebars Anchored into Footing
                  </span>
                </label>
                <span class="text-[10px] font-bold text-amber-800 dark:text-amber-300 bg-amber-100 dark:bg-amber-950/60 px-2 py-0.5 rounded-md">Critical for Foundation BBS</span>
              </div>

              <div id="box-dowel-details" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3 text-xs">
                <div>
                  <label for="ft-dowel-count" class="block font-semibold text-slate-700 dark:text-slate-300">Number of Dowels</label>
                  <select id="ft-dowel-count" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                    <option value="4" selected>4 Dowels (Corner)</option>
                    <option value="6">6 Dowels</option>
                    <option value="8">8 Dowels (Heavy Column)</option>
                    <option value="12">12 Dowels</option>
                  </select>
                </div>
                <div>
                  <label for="ft-dowel-dia" class="block font-semibold text-slate-700 dark:text-slate-300">Dowel Bar Diameter</label>
                  <select id="ft-dowel-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                    <option value="12">12 mm</option>
                    <option value="16" selected>16 mm (Standard)</option>
                    <option value="20">20 mm</option>
                    <option value="25">25 mm</option>
                  </select>
                </div>
                <div>
                  <label for="ft-dowel-lap" class="block font-semibold text-slate-700 dark:text-slate-300">
                    Lap / Projection (<span class="lbl-sec-unit">mm</span>)
                  </label>
                  <input type="number" id="ft-dowel-lap" value="800" step="50" min="300" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                  <span class="text-[10px] text-slate-500">IS 456 Cl 26.2: 50d = 800mm + 300mm foot</span>
                </div>
              </div>
            </div>

            <!-- OPTIONAL TOP MESH MAT -->
            <div class="border-t border-slate-200/60 pt-3 dark:border-slate-800">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="check-top-mesh" class="h-4 w-4 rounded-md border-indigo-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
                <span class="text-xs font-bold text-slate-800 dark:text-slate-200">
                  Include Top Mesh Mat (For Raft / Heavy Dual-Mesh Footings)
                </span>
              </label>

              <div id="box-top-mesh-details" class="hidden mt-3">
                <div class="grid grid-cols-2 gap-3 text-xs">
                  <div>
                    <label for="ft-top-dia" class="block font-semibold text-slate-700 dark:text-slate-300">Top Bar Diameter</label>
                    <select id="ft-top-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                      <option value="8">8 mm</option>
                      <option value="10" selected>10 mm</option>
                      <option value="12">12 mm</option>
                      <option value="16">16 mm</option>
                    </select>
                  </div>
                  <div>
                    <label for="ft-top-sp" class="block font-semibold text-slate-700 dark:text-slate-300">
                      Top Spacing c/c (<span class="lbl-sec-unit">mm</span>)
                    </label>
                    <input type="number" id="ft-top-sp" value="150" step="10" min="50" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- PCC BLINDING & PIT EXCAVATION SPECIFICATIONS -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="select-concrete-grade" class="block text-xs font-bold text-slate-700 dark:text-slate-300">RCC Concrete Grade</label>
              <select id="select-concrete-grade" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="M20" selected>M20 (1 : 1.5 : 3) - Standard</option>
                <option value="M25">M25 (1 : 1 : 2) - Heavy / Coastal</option>
                <option value="M15">M15 (1 : 2 : 4) - Light Footing</option>
                <option value="M30">M30 (Design Mix)</option>
              </select>
            </div>

            <div>
              <label for="ft-pcc-thick" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                PCC Blinding Bed (<span class="lbl-sec-unit">mm</span>)
              </label>
              <select id="ft-pcc-thick" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="75">75 mm (3 inches)</option>
                <option value="100" selected>100 mm (4 inches) - Standard</option>
                <option value="150">150 mm (6 inches)</option>
