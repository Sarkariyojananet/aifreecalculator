  function drawPlanView(Lmm, Bmm, coverMm, diaX, spX, diaY, spY, dowelCount, dowelDia, isSloped, pedLMm, pedWMm) {
    if (!svgPlan) return;
    const W = 280, H = 240;
    const maxDim = Math.max(Lmm, Bmm);
    const scale = Math.min(150 / maxDim, 0.42);

    let w = Math.max(70, Math.min(170, Lmm * scale));
    let h = Math.max(70, Math.min(150, Bmm * scale));

    if (Math.abs(Lmm - Bmm) < 10) {
      const sq = Math.max(80, Math.min(145, 110 * Math.sqrt(Lmm / 1500)));
      w = sq;
      h = sq;
    }

    const c = Math.max(6, Math.min(18, (coverMm / Math.min(Lmm, Bmm)) * Math.min(w, h)));
    const ox = (W - w) / 2;
    const oy = 110 - h / 2;

    const coreW = w - 2 * c;
    const coreH = h - 2 * c;

    // Number of visual mesh lines (bounded between 4 and 10 for clean look)
    const nMeshX = Math.max(4, Math.min(10, Math.round(Bmm / Math.max(50, spX))));
    const nMeshY = Math.max(4, Math.min(10, Math.round(Lmm / Math.max(50, spY))));

    let meshXLines = '';
    for (let i = 0; i <= nMeshX; i++) {
      const y = oy + c + (i * coreH) / nMeshX;
      meshXLines += `<line x1="${(ox + c).toFixed(1)}" y1="${y.toFixed(1)}" x2="${(ox + w - c).toFixed(1)}" y2="${y.toFixed(1)}" stroke="#2563eb" stroke-width="1.8" />`;
    }

    let meshYLines = '';
    for (let j = 0; j <= nMeshY; j++) {
      const x = ox + c + (j * coreW) / nMeshY;
      meshYLines += `<line x1="${x.toFixed(1)}" y1="${(oy + c).toFixed(1)}" x2="${x.toFixed(1)}" y2="${(oy + h - c).toFixed(1)}" stroke="#059669" stroke-width="1.8" />`;
    }

    // Column Pedestal / Starter Dowels outline at center
    const colPedScaleW = Math.max(26, Math.min(50, (pedLMm || 400) * scale));
    const colPedScaleH = Math.max(26, Math.min(50, (pedWMm || 400) * scale));
    const colX = (W - colPedScaleW) / 2;
    const colY = 110 - colPedScaleH / 2;

    let dowelDots = '';
    if (dowelCount >= 4) {
      const dotCoords = [
        [colX + 5, colY + 5],
        [colX + colPedScaleW - 5, colY + 5],
        [colX + 5, colY + colPedScaleH - 5],
        [colX + colPedScaleW - 5, colY + colPedScaleH - 5]
      ];
      if (dowelCount >= 6) {
        dotCoords.push([colX + 5, colY + colPedScaleH / 2]);
        dotCoords.push([colX + colPedScaleW - 5, colY + colPedScaleH / 2]);
      }
      if (dowelCount >= 8) {
        dotCoords.push([colX + colPedScaleW / 2, colY + 5]);
        dotCoords.push([colX + colPedScaleW / 2, colY + colPedScaleH - 5]);
      }
      dotCoords.forEach(([dx, dy]) => {
        dowelDots += `<circle cx="${dx.toFixed(1)}" cy="${dy.toFixed(1)}" r="3" fill="#b45309" stroke="#78350f" stroke-width="1" />`;
      });
    }

    // Sloped footing trapezoid projection lines
    let slopedLines = '';
    if (isSloped) {
      slopedLines = `
        <line x1="${ox.toFixed(1)}" y1="${oy.toFixed(1)}" x2="${colX.toFixed(1)}" y2="${colY.toFixed(1)}" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="3,2" />
        <line x1="${(ox + w).toFixed(1)}" y1="${oy.toFixed(1)}" x2="${(colX + colPedScaleW).toFixed(1)}" y2="${colY.toFixed(1)}" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="3,2" />
        <line x1="${ox.toFixed(1)}" y1="${(oy + h).toFixed(1)}" x2="${colX.toFixed(1)}" y2="${(colY + colPedScaleH).toFixed(1)}" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="3,2" />
        <line x1="${(ox + w).toFixed(1)}" y1="${(oy + h).toFixed(1)}" x2="${(colX + colPedScaleW).toFixed(1)}" y2="${(colY + colPedScaleH).toFixed(1)}" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="3,2" />
      `;
    }

    svgPlan.innerHTML = `
      <!-- Footing Base Outline -->
      <rect x="${ox.toFixed(1)}" y="${oy.toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}" rx="6" fill="#f8fafc" stroke="#64748b" stroke-width="2.2" />

      <!-- Clear Cover Boundary -->
      <rect x="${(ox + c).toFixed(1)}" y="${(oy + c).toFixed(1)}" width="${coreW.toFixed(1)}" height="${coreH.toFixed(1)}" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-dasharray="4,2" />

      ${slopedLines}

      <!-- Rebar Mesh Lines -->
      ${meshXLines}
      ${meshYLines}

      <!-- Central Column Pedestal -->
      <rect x="${colX.toFixed(1)}" y="${colY.toFixed(1)}" width="${colPedScaleW.toFixed(1)}" height="${colPedScaleH.toFixed(1)}" rx="3" fill="#fef3c7" stroke="#d97706" stroke-width="1.8" />
      <text x="${(W / 2).toFixed(1)}" y="${(110 + 3).toFixed(1)}" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#92400e">COLUMN</text>
      ${dowelDots}

      <!-- Dimension Lines -->
      <line x1="${ox.toFixed(1)}" y1="${(oy + h + 14).toFixed(1)}" x2="${(ox + w).toFixed(1)}" y2="${(oy + h + 14).toFixed(1)}" stroke="#0284c7" stroke-width="1.5" />
      <text x="${(ox + w / 2).toFixed(1)}" y="${(oy + h + 26).toFixed(1)}" text-anchor="middle" font-size="10.5" font-weight="bold" fill="#0369a1">L = ${Math.round(Lmm)} mm</text>

      <line x1="${(ox - 12).toFixed(1)}" y1="${oy.toFixed(1)}" x2="${(ox - 12).toFixed(1)}" y2="${(oy + h).toFixed(1)}" stroke="#0284c7" stroke-width="1.5" />
      <text x="${(ox - 16).toFixed(1)}" y="${(oy + h / 2).toFixed(1)}" text-anchor="middle" transform="rotate(-90 ${(ox - 16).toFixed(1)} ${(oy + h / 2).toFixed(1)})" font-size="10.5" font-weight="bold" fill="#0369a1">B = ${Math.round(Bmm)} mm</text>

      <text x="${(W / 2).toFixed(1)}" y="22" text-anchor="middle" font-size="9" font-weight="600" fill="#64748b">Clear Cover = ${Math.round(coverMm)} mm</text>
    `;

    if (lblPlanCaption) {
      lblPlanCaption.innerHTML = `Bottom Mesh: <strong class="text-blue-600">${diaX}mm X-Bars @ ${Math.round(spX)}mm</strong> & <strong class="text-emerald-600">${diaY}mm Y-Bars @ ${Math.round(spY)}mm</strong> ${dowelCount > 0 ? `| <strong class="text-amber-600">${dowelCount} Nos × ${dowelDia}mm Dowels</strong>` : ''}`;
    }
  }

  function drawSectionalElevation(Lmm, Bmm, Dmm, D1mm, isSloped, coverMm, pccThickMm, dowelCount, dowelDia, includeBendUp) {
    if (!svgElevation) return;
    const W = 340, H = 240;
    const ftBaseW = Math.max(140, Math.min(220, 150 + (Lmm / 2000) * 50));
    const ftX = (W - ftBaseW) / 2;

    // Depth scaling
    const ftTotalH = Math.max(45, Math.min(85, 40 + (Dmm / 600) * 35));
    const pccH = Math.max(8, Math.min(16, (pccThickMm / 100) * 12));
    const pccOffset = 12;

    const baseLineY = 185;
    const pccTopY = baseLineY - pccH;
    const ftTopY = pccTopY - ftTotalH;

    const colW = 44;
    const colX = (W - colW) / 2;
    const colH = 65;
    const colTopY = ftTopY - colH;

    let concreteFootingPath = '';
    if (isSloped) {
      const d1ScaleH = Math.max(18, Math.min(ftTotalH * 0.6, (D1mm / Dmm) * ftTotalH));
      const d1TopY = pccTopY - d1ScaleH;
      concreteFootingPath = `
        <polygon points="
          ${ftX},${pccTopY}
          ${ftX},${d1TopY}
          ${colX - 6},${ftTopY}
          ${colX + colW + 6},${ftTopY}
          ${ftX + ftBaseW},${d1TopY}
          ${ftX + ftBaseW},${pccTopY}
        " fill="#f8fafc" stroke="#64748b" stroke-width="2" />
      `;
    } else {
      concreteFootingPath = `
        <rect x="${ftX}" y="${ftTopY}" width="${ftBaseW}" height="${ftTotalH}" fill="#f8fafc" stroke="#64748b" stroke-width="2" rx="2" />
      `;
    }

    // Bottom Mesh with L-bend end hooks
    const meshY = pccTopY - 8;
    const hookH = includeBendUp ? Math.max(12, Math.min(ftTotalH - 12, ftTotalH * 0.7)) : 0;
    const meshX1 = ftX + 8;
    const meshX2 = ftX + ftBaseW - 8;

    let meshSvg = '';
    if (includeBendUp) {
      meshSvg = `
        <path d="M ${meshX1} ${(meshY - hookH).toFixed(1)} L ${meshX1} ${meshY} L ${meshX2} ${meshY} L ${meshX2} ${(meshY - hookH).toFixed(1)}" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" />
      `;
    } else {
      meshSvg = `
        <line x1="${meshX1}" y1="${meshY}" x2="${meshX2}" y2="${meshY}" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" />
      `;
    }

    // Cross rebar dots along bottom mesh
    let crossDots = '';
    const nDots = 8;
    for (let k = 1; k < nDots; k++) {
      const kx = meshX1 + (k * (meshX2 - meshX1)) / nDots;
      crossDots += `<circle cx="${kx.toFixed(1)}" cy="${meshY}" r="2.2" fill="#059669" />`;
    }

    // Column starter dowels
    let dowelSvg = '';
    if (dowelCount > 0) {
      const footBendLen = 22;
      dowelSvg = `
        <!-- Left Dowel -->
        <path d="M ${colX + 8} ${colTopY} L ${colX + 8} ${meshY - 2} L ${colX + 8 - footBendLen} ${meshY - 2}" fill="none" stroke="#b45309" stroke-width="2.2" stroke-linecap="round" />
        <!-- Right Dowel -->
        <path d="M ${colX + colW - 8} ${colTopY} L ${colX + colW - 8} ${meshY - 2} L ${colX + colW - 8 + footBendLen} ${meshY - 2}" fill="none" stroke="#b45309" stroke-width="2.2" stroke-linecap="round" />
      `;
    }

    svgElevation.innerHTML = `
      <!-- Natural Ground Level -->
      <line x1="15" y1="${colTopY + 25}" x2="${W - 15}" y2="${colTopY + 25}" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4,2" />
      <text x="25" y="${colTopY + 20}" font-size="8.5" font-weight="bold" fill="#64748b">GROUND LEVEL</text>

      <!-- Excavation Pit Profile -->
      <path d="M 30 ${colTopY + 25} L ${ftX - pccOffset - 8} ${baseLineY} L ${ftX + ftBaseW + pccOffset + 8} ${baseLineY} L ${W - 30} ${colTopY + 25}" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-dasharray="4,3" />

      <!-- PCC Blinding Bed Layer -->
      <rect x="${ftX - pccOffset}" y="${pccTopY}" width="${ftBaseW + 2 * pccOffset}" height="${pccH}" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
      <text x="${(W / 2).toFixed(1)}" y="${(baseLineY - pccH / 2 + 3).toFixed(1)}" text-anchor="middle" font-size="8" font-weight="bold" fill="#475569">PCC BLINDING BED (100mm)</text>

      <!-- Concrete Footing Body -->
      ${concreteFootingPath}

      <!-- Column Stem -->
      <rect x="${colX}" y="${colTopY}" width="${colW}" height="${colH}" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.8" />
      <text x="${(W / 2).toFixed(1)}" y="${(colTopY + colH / 2 + 3).toFixed(1)}" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#64748b">COLUMN</text>

      <!-- Rebars -->
      ${meshSvg}
      ${crossDots}
      ${dowelSvg}

      <!-- Dimension Lines -->
      <line x1="${ftX - pccOffset - 10}" y1="${ftTopY}" x2="${ftX - pccOffset - 10}" y2="${pccTopY}" stroke="#0284c7" stroke-width="1.5" />
      <text x="${ftX - pccOffset - 15}" y="${(ftTopY + ftTotalH / 2).toFixed(1)}" text-anchor="middle" transform="rotate(-90 ${ftX - pccOffset - 15} ${ftTopY + ftTotalH / 2})" font-size="9" font-weight="bold" fill="#0369a1">D = ${Math.round(Dmm)}mm</text>

      <line x1="${ftX}" y1="${baseLineY + 12}" x2="${ftX + ftBaseW}" y2="${baseLineY + 12}" stroke="#0284c7" stroke-width="1.5" />
      <text x="${(W / 2).toFixed(1)}" y="${baseLineY + 24}" text-anchor="middle" font-size="9.5" font-weight="bold" fill="#0369a1">L = ${Math.round(Lmm)} mm</text>
    `;

    if (lblElevationCaption) {
      lblElevationCaption.innerHTML = `${isSloped ? `Sloped Footing: Total D = <strong>${Math.round(Dmm)}mm</strong>, Edge D₁ = <strong>${Math.round(D1mm)}mm</strong>` : `Flat Pad Depth D = <strong>${Math.round(Dmm)}mm</strong>`} | PCC = <strong>${Math.round(pccThickMm)}mm</strong>`;
    }
  }

  // --- MAIN CALCULATION FUNCTION ---
  function calculate() {
    updateFootingTypeUI();

    const rawL = parseFloat(ftL.value) || 0;
    const rawB = parseFloat(ftB.value) || 0;
    const rawD = parseFloat(ftD.value) || 0;
    const rawD1 = parseFloat(ftD1.value) || 150;
    const rawPedL = parseFloat(ftPedL.value) || 400;
    const rawPedW = parseFloat(ftPedW.value) || 400;
    const rawCover = parseFloat(ftCover.value) || 50;
    const rawN = Math.max(1, parseInt(ftCnt.value) || 1);
    const type = ftType.value;

    const lengthMm = currentDimensionUnit === 'ft' ? rawL * 304.8 : rawL;
    const widthMm = currentDimensionUnit === 'ft' ? rawB * 304.8 : rawB;
    const depthMm = currentDimensionUnit === 'ft' ? rawD * 25.4 : rawD;
    const d1Mm = currentDimensionUnit === 'ft' ? rawD1 * 25.4 : rawD1;
    const pedLMm = currentDimensionUnit === 'ft' ? rawPedL * 25.4 : rawPedL;
    const pedWMm = currentDimensionUnit === 'ft' ? rawPedW * 25.4 : rawPedW;
    const coverMm = currentDimensionUnit === 'ft' ? rawCover * 25.4 : rawCover;

    if (lengthMm <= 0 || widthMm <= 0 || depthMm <= 0) {
      resetOutputs();
      return;
    }

    const lengthM = lengthMm / 1000;
    const widthM = widthMm / 1000;
    const depthM = depthMm / 1000;
    const coverM = coverMm / 1000;

    // Concrete volume
    let singleFootingVol = 0;
    let singleFormworkArea = 0;

    if (type === 'sloped') {
      const D1 = Math.min(depthM, Math.max(0.1, d1Mm / 1000));
      const hTrap = Math.max(0, depthM - D1);
      const vBase = lengthM * widthM * D1;

      const a = (pedLMm || 400) / 1000;
      const b = (pedWMm || 400) / 1000;
      const A1 = lengthM * widthM;
      const A2 = a * b;

      const vTrap = hTrap > 0 ? (hTrap / 3) * (A1 + A2 + Math.sqrt(A1 * A2)) : 0;
      singleFootingVol = vBase + vTrap;
      singleFormworkArea = 2 * (lengthM + widthM) * D1;
    } else {
      singleFootingVol = lengthM * widthM * depthM;
      singleFormworkArea = 2 * (lengthM + widthM) * depthM;
    }

    const totalConcreteVol = singleFootingVol * rawN;
    const totalConcreteCuft = totalConcreteVol * 35.3147;

    // PCC Bed & Pit Excavation
    const pccThickVal = parseFloat(ftPccThick.value) || 100;
    const pccThickM = pccThickVal / 1000;
    const pccL = lengthM + 0.2;
    const pccB = widthM + 0.2;
    const totalPccVol = pccThickM > 0 ? pccL * pccB * pccThickM * rawN : 0;

    const excavDepthVal = parseFloat(ftExcavDepth.value) || 1.5;
    const excavDepthM = currentDimensionUnit === 'ft' ? excavDepthVal * 0.3048 : excavDepthVal;
    const pitL = lengthM + 0.6;
    const pitB = widthM + 0.6;
    const totalExcavVol = pitL * pitB * Math.max(depthM + pccThickM, excavDepthM) * rawN;

    const totalFormworkSqm = singleFormworkArea * rawN;

    // Pricing rates
    const rateSteel = parseFloat(costSteel.value) || 75;
    const rateConc = parseFloat(costConc.value) || 4800;
    const ratePcc = parseFloat(costPcc.value) || 3800;
    const rateShut = parseFloat(costShut.value) || 300;
    const rateExcav = parseFloat(costExcav.value) || 180;
    const rateWire = parseFloat(costWire.value) || 100;

    let totalSteelKg = 0;
    let bbsList = [];
    let diaSummaryMap = new Map();

    if (currentCalculationMode === 'norm') {
      // NORMAL THUMB RULE MODE
      let rateKgM3 = 75;
      const t = selNormType.value;
      if (t === 'light') rateKgM3 = 55;
      else if (t === 'standard') rateKgM3 = 75;
      else if (t === 'heavy') rateKgM3 = 100;
      else if (t === 'custom') rateKgM3 = parseFloat(inputNormCustomRate.value) || 75;

      const baseSteel = totalConcreteVol * rateKgM3;
      totalSteelKg = baseSteel * 1.03;

      const normDia = parseInt(selNormDia.value) || 12;
      const uWt = getBarUnitWeight(normDia);
      const totLen = totalSteelKg / uWt;
      const stock12m = Math.ceil(totLen / 12);
      const bSize = BARS_PER_BUNDLE_MAP[normDia] || 5;
      const bundles = Math.ceil(stock12m / bSize);

      diaSummaryMap.set(normDia, { totalLen: totLen, totalWt: totalSteelKg, stock12m, bSize, bundles });
      renderBOQ(totalConcreteVol, selNormConcrete.value);

      // Live SVG for normal mode
      drawPlanView(lengthMm, widthMm, coverMm, normDia, 150, normDia, 150, 4, 16, type === 'sloped', pedLMm, pedWMm);
      drawSectionalElevation(lengthMm, widthMm, depthMm, d1Mm, type === 'sloped', coverMm, pccThickVal, 4, 16, true);
    } else {
      // ADVANCED BBS MODE
      const dX = parseInt(ftDiaX.value) || 12;
      const dY = parseInt(ftDiaY.value) || 12;
      const sXMm = currentDimensionUnit === 'ft' ? (parseFloat(ftSpX.value) || 6) * 25.4 : parseFloat(ftSpX.value) || 150;
      const sYMm = currentDimensionUnit === 'ft' ? (parseFloat(ftSpY.value) || 6) * 25.4 : parseFloat(ftSpY.value) || 150;
      const isBendUp = checkBendUp.checked;

      // X-Bars (Span L, along width B)
      const netSpanB = Math.max(0.1, widthM - 2 * coverM);
      const countXPerFt = Math.floor((netSpanB * 1000) / sXMm) + 1;
      const totCountX = countXPerFt * rawN;

      const legHeightX = isBendUp ? Math.max(0.1, depthM - 2 * coverM) : 0;
      const bendDeductX = isBendUp ? (4 * dX) / 1000 : 0;
      const cutLenX = Math.max(0.2, Number((lengthM - 2 * coverM + 2 * legHeightX - bendDeductX).toFixed(3)));
      const totLenX = totCountX * cutLenX;
      const uWtX = getBarUnitWeight(dX);
      const totWtX = totLenX * uWtX;

      bbsList.push({
        mark: '01',
        desc: `Bottom Mesh Rebars (X-Direction, along Length L)`,
        dia: dX,
        shape: isBendUp ? 'U-MESH (90° End Bend-ups)' : 'STRAIGHT (Flat Mesh)',
        count: totCountX,
        cutLen: cutLenX,
        totLen: totLenX,
        uWt: uWtX,
        totWt: totWtX,
      });

      // Y-Bars (Span B, along length L)
      const netSpanL = Math.max(0.1, lengthM - 2 * coverM);
      const countYPerFt = Math.floor((netSpanL * 1000) / sYMm) + 1;
      const totCountY = countYPerFt * rawN;

      const legHeightY = isBendUp ? Math.max(0.1, depthM - 2 * coverM) : 0;
      const bendDeductY = isBendUp ? (4 * dY) / 1000 : 0;
      const cutLenY = Math.max(0.2, Number((widthM - 2 * coverM + 2 * legHeightY - bendDeductY).toFixed(3)));
      const totLenY = totCountY * cutLenY;
      const uWtY = getBarUnitWeight(dY);
      const totWtY = totLenY * uWtY;

      bbsList.push({
        mark: '02',
        desc: `Bottom Mesh Rebars (Y-Direction, along Width B)`,
        dia: dY,
        shape: isBendUp ? 'U-MESH (90° End Bend-ups)' : 'STRAIGHT (Flat Mesh)',
        count: totCountY,
        cutLen: cutLenY,
        totLen: totLenY,
        uWt: uWtY,
        totWt: totWtY,
      });

      // Top Mesh (Optional)
      if (checkTopMesh.checked) {
        const topD = parseInt(ftTopDia.value) || 10;
        const topSpMm = currentDimensionUnit === 'ft' ? (parseFloat(ftTopSp.value) || 6) * 25.4 : parseFloat(ftTopSp.value) || 150;
        const uWtTop = getBarUnitWeight(topD);

        const countTopX = Math.floor((netSpanB * 1000) / topSpMm) + 1;
        const totTopX = countTopX * rawN;
        const cutLenTopX = Math.max(0.2, Number((lengthM - 2 * coverM).toFixed(3)));
        const totLenTopX = totTopX * cutLenTopX;
        const totWtTopX = totLenTopX * uWtTop;

        bbsList.push({
          mark: '03',
          desc: `Top Mesh Rebars (X-Direction)`,
          dia: topD,
          shape: 'STRAIGHT (Top Mat)',
          count: totTopX,
          cutLen: cutLenTopX,
          totLen: totLenTopX,
          uWt: uWtTop,
          totWt: totWtTopX,
        });

        const countTopY = Math.floor((netSpanL * 1000) / topSpMm) + 1;
        const totTopY = countTopY * rawN;
        const cutLenTopY = Math.max(0.2, Number((widthM - 2 * coverM).toFixed(3)));
        const totLenTopY = totTopY * cutLenTopY;
        const totWtTopY = totLenTopY * uWtTop;

        bbsList.push({
          mark: '04',
          desc: `Top Mesh Rebars (Y-Direction)`,
          dia: topD,
          shape: 'STRAIGHT (Top Mat)',
          count: totTopY,
          cutLen: cutLenTopY,
          totLen: totLenTopY,
          uWt: uWtTop,
          totWt: totWtTopY,
        });
      }

      // Column Starter Dowel Rebars
      let dDowel = 0, nDowel = 0;
      if (checkDowels.checked) {
        nDowel = parseInt(ftDowelCount.value) || 4;
        dDowel = parseInt(ftDowelDia.value) || 16;
        const uWtDowel = getBarUnitWeight(dDowel);

        const lapM = currentDimensionUnit === 'ft'
          ? (parseFloat(ftDowelLap.value) || 30) * 0.0254
          : (parseFloat(ftDowelLap.value) || 800) / 1000;
        const embedM = Math.max(0.2, depthM - coverM);
        const footM = 0.30; // 300mm standard foot tied to mesh
        const dowelBendDeduct = (2 * dDowel) / 1000;

        const cutLenDowel = Math.max(0.5, Number((lapM + embedM + footM - dowelBendDeduct).toFixed(3)));
        const totDowelCount = nDowel * rawN;
        const totDowelLen = totDowelCount * cutLenDowel;
        const totDowelWt = totDowelLen * uWtDowel;

        bbsList.push({
          mark: checkTopMesh.checked ? '05' : '03',
          desc: `Column Starter Dowel Rebars (${dDowel}mm Lap + Embedment + 300mm Foot Bend)`,
          dia: dDowel,
          shape: 'L-DOWEL (Starter Bar)',
          count: totDowelCount,
          cutLen: cutLenDowel,
          totLen: totDowelLen,
          uWt: uWtDowel,
          totWt: totDowelWt,
        });
      }

      const baseSteel = bbsList.reduce((acc, it) => acc + it.totWt, 0);
      totalSteelKg = baseSteel * 1.03; // 3% standard site wastage

      // Diameter Breakdown
      for (const it of bbsList) {
        const cur = diaSummaryMap.get(it.dia) || { totalLen: 0, totalWt: 0 };
        cur.totalLen += it.totLen;
        cur.totalWt += it.totWt;
        diaSummaryMap.set(it.dia, cur);
      }
      for (const [dia, val] of diaSummaryMap.entries()) {
        val.stock12m = Math.ceil((val.totalLen * 1.03) / 12);
        val.bSize = BARS_PER_BUNDLE_MAP[dia] || 5;
        val.bundles = Math.ceil(val.stock12m / val.bSize);
      }

      renderBBS(bbsList);
      renderBOQ(totalConcreteVol, selConcreteGrade.value);

      // Draw SVG Detailing
      drawPlanView(lengthMm, widthMm, coverMm, dX, sXMm, dY, sYMm, checkDowels.checked ? nDowel : 0, dDowel, type === 'sloped', pedLMm, pedWMm);
      drawSectionalElevation(lengthMm, widthMm, depthMm, d1Mm, type === 'sloped', coverMm, pccThickVal, checkDowels.checked ? nDowel : 0, dDowel, isBendUp);
    }

    renderDiameterSummary(diaSummaryMap);

    // Hero displays
    const bindingWireKg = Math.max(1, Math.round(totalSteelKg * 0.01 * 10) / 10);
    const sym = currentCurrency === 'INR' ? '₹' : '$';

    resTotalSteel.textContent = `${totalSteelKg.toFixed(1)} kg`;
    resTotalSteelOther.textContent = `(${(totalSteelKg / 100).toFixed(2)} Quintals | ${(totalSteelKg / 1000).toFixed(3)} Tonnes | ${(totalSteelKg * 2.20462).toFixed(1)} lbs)`;
    resConc.textContent = `${totalConcreteVol.toFixed(3)} m³ (${totalConcreteCuft.toFixed(1)} cu ft)`;
    resShuttering.textContent = `Formwork: ${totalFormworkSqm.toFixed(1)} m² (${(totalFormworkSqm * 10.7639).toFixed(1)} sq ft)`;

    resGeomDim.textContent = `${Math.round(lengthMm)} × ${Math.round(widthMm)} × ${Math.round(depthMm)} mm (${rawN} Footing${rawN > 1 ? 's' : ''})`;
    resPccVolume.textContent = `${totalPccVol.toFixed(3)} m³`;
    resExcavVolume.textContent = `${totalExcavVol.toFixed(2)} m³`;

    // Costs
    const costSteelAmt = Math.round(totalSteelKg * rateSteel);
    const costConcAmt = Math.round(totalConcreteVol * rateConc);
    const costPccAmt = Math.round(totalPccVol * ratePcc);
    const costShutAmt = Math.round(totalFormworkSqm * rateShut);
    const costExcavAmt = Math.round(totalExcavVol * rateExcav);
    const costWireAmt = Math.round(bindingWireKg * rateWire);
    const totalCostAmt = costSteelAmt + costConcAmt + costPccAmt + costShutAmt + costExcavAmt + costWireAmt;

    resCostTotal.textContent = `${sym} ${totalCostAmt.toLocaleString(currentCurrency === 'INR' ? 'en-IN' : 'en-US')}`;
    resCostSteelQty.textContent = `${totalSteelKg.toFixed(1)} kg`;
    resCostSteelRate.textContent = `${sym} ${rateSteel}/kg`;
    resCostSteelAmt.textContent = `${sym} ${costSteelAmt.toLocaleString()}`;

    resCostConcQty.textContent = `${totalConcreteVol.toFixed(3)} m³`;
    resCostConcRate.textContent = `${sym} ${rateConc}/m³`;
    resCostConcAmt.textContent = `${sym} ${costConcAmt.toLocaleString()}`;

    resCostPccQty.textContent = `${totalPccVol.toFixed(3)} m³`;
    resCostPccRate.textContent = `${sym} ${ratePcc}/m³`;
    resCostPccAmt.textContent = `${sym} ${costPccAmt.toLocaleString()}`;

    resCostShutQty.textContent = `${totalFormworkSqm.toFixed(1)} m²`;
    resCostShutRate.textContent = `${sym} ${rateShut}/m²`;
    resCostShutAmt.textContent = `${sym} ${costShutAmt.toLocaleString()}`;

    resCostExcavQty.textContent = `${totalExcavVol.toFixed(2)} m³`;
    resCostExcavRate.textContent = `${sym} ${rateExcav}/m³`;
    resCostExcavAmt.textContent = `${sym} ${costExcavAmt.toLocaleString()}`;

    resCostWireQty.textContent = `${bindingWireKg.toFixed(1)} kg`;
    resCostWireRate.textContent = `${sym} ${rateWire}/kg`;
    resCostWireAmt.textContent = `${sym} ${costWireAmt.toLocaleString()}`;

    resCostGrandAmt.textContent = `${sym} ${totalCostAmt.toLocaleString(currentCurrency === 'INR' ? 'en-IN' : 'en-US')}`;

    resBoqShuttering.textContent = `${totalFormworkSqm.toFixed(1)} m² (${(totalFormworkSqm * 10.7639).toFixed(1)} sq ft)`;
    resBoqWire.textContent = `${bindingWireKg.toFixed(1)} kg (18 Gauge GI Wire)`;

    try { document.dispatchEvent(new CustomEvent('calculator:updated')); } catch (e) {}
  }

  function renderBBS(items) {
    if (!tbodyBBS) return;
    let html = '';
    for (const it of items) {
      html += `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
          <td class="p-2.5 font-bold text-blue-600 dark:text-blue-400">${it.mark}</td>
          <td class="p-2.5 font-semibold text-slate-900 dark:text-white">${it.desc}</td>
          <td class="p-2.5 text-center font-bold font-mono">${it.dia}</td>
          <td class="p-2.5 text-slate-600 dark:text-slate-400 font-mono text-[11px]">${it.shape}</td>
          <td class="p-2.5 text-center font-bold">${it.count}</td>
          <td class="p-2.5 text-right font-mono">${it.cutLen.toFixed(2)}</td>
          <td class="p-2.5 text-right font-mono">${it.totLen.toFixed(1)}</td>
          <td class="p-2.5 text-right font-mono text-slate-500">${it.uWt.toFixed(3)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${it.totWt.toFixed(1)}</td>
        </tr>
      `;
    }
    tbodyBBS.innerHTML = html;
  }

  function renderDiameterSummary(diaMap) {
    if (!tbodyDiaSummary) return;
    let html = '';
    const sorted = Array.from(diaMap.keys()).sort((a, b) => a - b);
    for (const dia of sorted) {
      const data = diaMap.get(dia);
      html += `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
          <td class="p-2 font-bold text-blue-600 dark:text-blue-400">${dia} mm</td>
          <td class="p-2 text-right font-mono">${data.totalLen.toFixed(1)} m</td>
          <td class="p-2 text-right font-bold text-slate-900 dark:text-white">${data.totalWt.toFixed(1)} kg</td>
          <td class="p-2 text-center font-bold text-emerald-600 dark:text-emerald-400">${data.stock12m} Rods</td>
          <td class="p-2 text-center font-semibold text-slate-700 dark:text-slate-300">${data.bundles} Bndl (${data.bSize}/bndl)</td>
        </tr>
      `;
    }
    tbodyDiaSummary.innerHTML = html;
  }

  function renderBOQ(volumeM3, grade) {
    const dryVol = volumeM3 * 1.54;
    let cementRatio = 1, sandRatio = 1.5, aggRatio = 3;
    if (grade === 'M25') { cementRatio = 1; sandRatio = 1; aggRatio = 2; }
    else if (grade === 'M15') { cementRatio = 1; sandRatio = 2; aggRatio = 4; }
    const totalRatio = cementRatio + sandRatio + aggRatio;

    const cementM3 = dryVol * (cementRatio / totalRatio);
    const cementKg = cementM3 * 1440;
    const cementBags = Math.ceil(cementKg / 50);

    const sandM3 = dryVol * (sandRatio / totalRatio);
    const sandCft = sandM3 * 35.3147;

    const aggM3 = dryVol * (aggRatio / totalRatio);
    const aggCft = aggM3 * 35.3147;

    if (resBoqCement) resBoqCement.textContent = `${cementBags} Bags (${cementKg.toFixed(0)} kg)`;
    if (resBoqSand) resBoqSand.textContent = `${sandCft.toFixed(1)} cft (${sandM3.toFixed(2)} m³)`;
    if (resBoqAggregate) resBoqAggregate.textContent = `${aggCft.toFixed(1)} cft (${aggM3.toFixed(2)} m³)`;
  }

  // Button Handlers
  const btnCalcFooting = document.getElementById('btn-calc-footing');
  const btnClearFooting = document.getElementById('btn-clear-footing');

  if (btnCalcFooting) {
    btnCalcFooting.addEventListener('click', () => {
      calculate();
      const card = document.getElementById('results-card');
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const orig = btnCalcFooting.innerHTML;
      btnCalcFooting.innerHTML = '<span>✅ Calculated!</span>';
      setTimeout(() => { btnCalcFooting.innerHTML = orig; }, 1200);
    });
  }

  if (btnClearFooting) {
    btnClearFooting.addEventListener('click', () => {
      ftL.value = '';
      ftB.value = '';
      ftD.value = '';
      ftL.focus();
      resetOutputs();
      const orig = btnClearFooting.innerHTML;
      btnClearFooting.innerHTML = '<span>✓ Cleared</span>';
      setTimeout(() => { btnClearFooting.innerHTML = orig; }, 1000);
    });
  }

  if (btnModeAdv) btnModeAdv.addEventListener('click', () => setMode('adv'));
  if (btnModeNorm) btnModeNorm.addEventListener('click', () => setMode('norm'));
  if (btnUnitM) btnUnitM.addEventListener('click', () => setUnit('m'));
  if (btnUnitFt) btnUnitFt.addEventListener('click', () => setUnit('ft'));
  if (btnCurrInr) btnCurrInr.addEventListener('click', () => setCurrency('INR'));
  if (btnCurrUsd) btnCurrUsd.addEventListener('click', () => setCurrency('USD'));

  // Preset Buttons
  document.querySelectorAll('.btn-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const u = btn.getAttribute('data-unit') || 'm';
      setUnit(u);
      setMode('adv');

      if (btn.hasAttribute('data-type')) ftType.value = btn.getAttribute('data-type');
      updateFootingTypeUI();

      if (btn.hasAttribute('data-l')) ftL.value = btn.getAttribute('data-l');
      if (btn.hasAttribute('data-b')) ftB.value = btn.getAttribute('data-b');
      if (btn.hasAttribute('data-d')) ftD.value = btn.getAttribute('data-d');
      if (btn.hasAttribute('data-d1')) ftD1.value = btn.getAttribute('data-d1');
      if (btn.hasAttribute('data-pedl')) ftPedL.value = btn.getAttribute('data-pedl');
      if (btn.hasAttribute('data-pedb')) ftPedW.value = btn.getAttribute('data-pedb');

      if (btn.hasAttribute('data-dia')) {
        ftDiaX.value = btn.getAttribute('data-dia');
        ftDiaY.value = btn.getAttribute('data-dia');
      }
      if (btn.hasAttribute('data-sp')) {
        ftSpX.value = btn.getAttribute('data-sp');
        ftSpY.value = btn.getAttribute('data-sp');
      }
      if (btn.hasAttribute('data-dowels')) {
        checkDowels.checked = true;
        boxDowelDetails.classList.remove('hidden');
        ftDowelCount.value = btn.getAttribute('data-dowels');
        if (btn.hasAttribute('data-doweldia')) ftDowelDia.value = btn.getAttribute('data-doweldia');
      }

      calculate();
    });
  });

  // Table Copy, CSV, Print
  const btnCopyBbs = document.getElementById('btn-copy-bbs');
  if (btnCopyBbs) {
    btnCopyBbs.addEventListener('click', () => {
      let tsv = 'Mark\tDescription\tDia(mm)\tShape Code\tCount\tCut Len(m)\tTot Len(m)\tUnit Wt(kg/m)\tTot Wt(kg)\n';
      document.querySelectorAll('#tbody-bbs tr').forEach(row => {
        const cols = Array.from(row.querySelectorAll('td')).map(td => td.textContent.trim());
        tsv += cols.join('\t') + '\n';
      });
      navigator.clipboard.writeText(tsv).then(() => {
        const orig = btnCopyBbs.textContent;
        btnCopyBbs.textContent = '✅ Copied!';
        setTimeout(() => { btnCopyBbs.textContent = orig; }, 1500);
      });
    });
  }

  const btnDownloadCsv = document.getElementById('btn-download-csv');
  if (btnDownloadCsv) {
    btnDownloadCsv.addEventListener('click', () => {
      let csv = 'Mark,Description,Dia(mm),Shape Code,Count,Cut Len(m),Tot Len(m),Unit Wt(kg/m),Tot Wt(kg)\n';
      document.querySelectorAll('#tbody-bbs tr').forEach(row => {
        const cols = Array.from(row.querySelectorAll('td')).map(td => `"${td.textContent.trim().replace(/"/g, '""')}"`);
        csv += cols.join(',') + '\n';
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'RCC_Footing_Steel_BBS.csv';
      link.click();
    });
  }

  const btnPrintBbs = document.getElementById('btn-print-bbs');
  if (btnPrintBbs) {
    btnPrintBbs.addEventListener('click', () => {
      window.print();
    });
  }

  // Live Diagram Update (Diagram updates in real-time as user types without computing result numbers)
  function updateLiveDiagrams() {
    const isSloped = ftType && ftType.value === 'sloped';
    let L = parseFloat(ftL?.value) || 1.8;
    let B = parseFloat(ftB?.value) || 1.8;
    let D = parseFloat(ftD?.value) || 450;
    let D1 = isSloped ? (parseFloat(ftD1?.value) || 200) : D;
    let cover = parseFloat(ftCover?.value) || 50;
    let pedL = parseFloat(ftPedL?.value) || 400;
    let pedW = parseFloat(ftPedW?.value) || 400;

    if (currentDimensionUnit === 'ft') {
      L *= 0.3048 * 1000;
      B *= 0.3048 * 1000;
      D *= 25.4;
      D1 *= 25.4;
      cover *= 25.4;
      pedL *= 25.4;
      pedW *= 25.4;
    } else {
      L *= 1000;
      B *= 1000;
    }

    const diaX = (currentCalculationMode === 'norm' ? (parseInt(ftDiaXNorm?.value) || 12) : (parseInt(ftDiaX?.value) || 12));
    const spX = currentDimensionUnit === 'ft' ? Math.round((parseFloat(ftSpX?.value) || 6) * 25.4) : Math.round(parseFloat(ftSpX?.value) || 150);
    const diaY = (currentCalculationMode === 'norm' ? (parseInt(ftDiaYNorm?.value) || 12) : (parseInt(ftDiaY?.value) || 12));
    const spY = currentDimensionUnit === 'ft' ? Math.round((parseFloat(ftSpY?.value) || 6) * 25.4) : Math.round(parseFloat(ftSpY?.value) || 150);

    const hasDowels = checkDowels ? checkDowels.checked : true;
    const dowelCnt = hasDowels ? (parseInt(ftDowelCount?.value) || 4) : 0;
    const dowelDia = parseInt(ftDowelDia?.value) || 16;
    const hasTop = checkTopMesh ? checkTopMesh.checked : false;

    drawPlanView(L, B, cover, diaX, spX, diaY, spY, dowelCnt, dowelDia, isSloped, pedL, pedW);
    drawElevationView(L, D, D1, cover, hasDowels, dowelDia, isSloped, pedL, hasTop);
  }

  // Live input events for Real-time Visual Diagram Updating
  const liveInputs = [
    ftType, ftL, ftB, ftD, ftD1, ftPedL, ftPedW, ftCover, ftCnt,
    ftDiaX, ftSpX, ftDiaY, ftSpY, checkBendUp, checkDowels, ftDowelCount, ftDowelDia, ftDowelLap,
    checkTopMesh, ftTopDia, ftTopSp, selConcreteGrade, ftPccThick, ftExcavDepth,
    selNormType, inputNormCustomRate, selNormDia, selNormConcrete,
    costSteel, costConc, costPcc, costShut, costExcav, costWire
  ];

  liveInputs.forEach(el => {
    if (el) {
      el.addEventListener('input', updateLiveDiagrams);
      el.addEventListener('change', updateLiveDiagrams);
    }
  });

  // Initial calculation on page load
  calculate();
</script>

