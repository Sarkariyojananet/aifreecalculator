    resTotalSteel.textContent = '0.0 kg';
    resTotalSteelOther.textContent = '(0.00 Quintals | 0.000 Tonnes)';
    resConc.textContent = '0.000 m³';
    resShuttering.textContent = 'Formwork: 0.00 m²';
    resGeomDim.textContent = '--';
    resPccVolume.textContent = '0.00 m³';
    resExcavVolume.textContent = '0.00 m³';

    if (tbodyBBS) {
      tbodyBBS.innerHTML = '<tr><td colspan="9" class="p-4 text-center text-slate-400 font-medium">Enter footing dimensions to calculate Bar Bending Schedule.</td></tr>';
    }
    if (tbodyDiaSummary) {
      tbodyDiaSummary.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-slate-400 font-medium">No rebar calculated yet.</td></tr>';
    }

    if (resBoqCement) resBoqCement.textContent = '0 Bags (0 kg)';
    if (resBoqSand) resBoqSand.textContent = '0.0 cft (0.00 m³)';
    if (resBoqAggregate) resBoqAggregate.textContent = '0.0 cft (0.00 m³)';
    if (resBoqShuttering) resBoqShuttering.textContent = '0.0 m²';
    if (resBoqWire) resBoqWire.textContent = '0.0 kg';

    const sym = currentCurrency === 'INR' ? '₹' : '$';
    resCostTotal.textContent = `${sym} 0`;
    resCostSteelQty.textContent = '0.0 kg'; resCostSteelAmt.textContent = `${sym} 0`;
    resCostConcQty.textContent = '0.000 m³'; resCostConcAmt.textContent = `${sym} 0`;
    resCostPccQty.textContent = '0.000 m³'; resCostPccAmt.textContent = `${sym} 0`;
    resCostShutQty.textContent = '0.0 m²'; resCostShutAmt.textContent = `${sym} 0`;
    resCostExcavQty.textContent = '0.00 m³'; resCostExcavAmt.textContent = `${sym} 0`;
    resCostWireQty.textContent = '0.0 kg'; resCostWireAmt.textContent = `${sym} 0`;
    resCostGrandAmt.textContent = `${sym} 0`;

    drawEmptyDiagrams();
    try { document.dispatchEvent(new CustomEvent('calculator:updated')); } catch (e) {}
