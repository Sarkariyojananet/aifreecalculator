---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="RCC Footing Steel & Concrete Calculator - Foundation Mesh BBS"
  description="Calculate RCC isolated pad footing mesh reinforcement steel weight, bar cutting length, total steel length, concrete volume, and pit excavation."
  category="Construction"
  calculatorName="RCC Footing Steel Calculator"
  slug="rcc-footing-steel-calculator"
  keywords={['rcc footing steel', 'footing bbs', 'foundation mesh rebar', 'footing concrete volume', 'footing excavation', 'pad footing calculation']}
>
  <div class="space-y-6">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div>
        <label for="ft-len" class="text-xs font-bold uppercase text-slate-700 dark:text-slate-300">Footing Length L (mm)</label>
        <input type="number" id="ft-len" value="1500" min="100" step="50" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
      </div>
      <div>
        <label for="ft-width" class="text-xs font-bold uppercase text-slate-700 dark:text-slate-300">Footing Width B (mm)</label>
        <input type="number" id="ft-width" value="1500" min="100" step="50" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
      </div>
      <div>
        <label for="ft-depth" class="text-xs font-bold uppercase text-slate-700 dark:text-slate-300">Footing Depth D (mm)</label>
        <input type="number" id="ft-depth" value="300" min="50" step="25" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
      </div>

      <div>
        <label for="ft-dia" class="text-xs font-bold uppercase text-slate-700 dark:text-slate-300">Mesh Rebar Diameter (mm)</label>
        <select id="ft-dia" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white cursor-pointer">
          <option value="8">8 mm</option>
          <option value="10">10 mm</option>
          <option value="12" selected>12 mm</option>
          <option value="16">16 mm</option>
          <option value="20">20 mm</option>
          <option value="25">25 mm</option>
        </select>
      </div>
      <div>
        <label for="ft-spacing" class="text-xs font-bold uppercase text-slate-700 dark:text-slate-300">Mesh Spacing c/c (mm)</label>
        <input type="number" id="ft-spacing" value="150" min="25" step="10" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
      </div>
      <div>
        <label for="ft-count" class="text-xs font-bold uppercase text-slate-700 dark:text-slate-300">Number of Footings</label>
        <input type="number" id="ft-count" value="1" min="1" step="1" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
      </div>
    </div>

    <!-- ACTION BUTTONS: CALCULATE & CLEAR -->
    <div class="flex flex-wrap items-center gap-3 pt-1">
      <button
        type="button"
        id="btn-calc-footing"
        class="flex-1 min-w-[200px] inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 px-6 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-blue-500/25 transition active:scale-[0.98] cursor-pointer"
      >
        <span>⚡ Calculate Footing Steel & Concrete</span>
        <span>→</span>
      </button>
      <button
        type="button"
        id="btn-clear-footing"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3.5 text-sm font-bold text-slate-700 hover:bg-slate-100 hover:text-red-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 dark:hover:text-red-400 transition cursor-pointer"
        title="Reset or Clear Inputs"
      >
        <span>🔄 Clear / Reset</span>
      </button>
    </div>

    <!-- Output Box -->
    <div id="results-card" class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-800 dark:bg-slate-950">
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Steel for All Footings</span>
          <div id="res-ft-total-steel" class="mt-1 text-3xl font-black text-blue-600 dark:text-blue-400">-- kg</div>
        </div>
        <div class="text-left sm:text-right">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Concrete:</span>
          <div id="res-ft-concrete" class="mt-1 text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400">-- m³</div>
        </div>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5 text-xs">
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Steel Per Footing</div>
          <div id="res-ft-single-steel" class="mt-1 text-base font-bold text-slate-900 dark:text-white">--</div>
        </div>
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Mesh Bar Cut Length</div>
          <div id="res-ft-cut-len" class="mt-1 text-base font-bold text-emerald-600 dark:text-emerald-400">--</div>
        </div>
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Bars Per Footing (X+Y)</div>
          <div id="res-ft-bars-count" class="mt-1 text-base font-bold text-slate-900 dark:text-white">-- Bars</div>
        </div>
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Steel Length / Footing</div>
          <div id="res-ft-total-len" class="mt-1 text-base font-bold text-blue-600 dark:text-blue-400">-- m</div>
        </div>
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60 col-span-2 sm:col-span-1">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Pit Excavation</div>
          <div id="res-ft-excavation" class="mt-1 text-base font-bold text-slate-900 dark:text-white">-- m³</div>
        </div>
      </div>
    </div>
  </div>

  <Fragment slot="content">
    <h2>Isolated Pad Footing Steel & Concrete Calculation</h2>
    <p>
      An isolated pad footing supports a single column and distributes concentrated loads to the soil bed. Accurate quantification of footing concrete volume, excavation pit size, and steel rebar mesh weight ensures proper site budgeting and zero material wastage.
    </p>

    <h3>1. Footing Concrete Volume Formula</h3>
    <p>
      All footing dimensions entered in millimeters (mm) are converted to meters (m) to calculate volume in cubic meters (m³):
    </p>
    <ul>
      <li><code>Length (m) = L (mm) ÷ 1000</code></li>
      <li><code>Width (m) = B (mm) ÷ 1000</code></li>
      <li><code>Depth (m) = D (mm) ÷ 1000</code></li>
      <li><code>Concrete Volume per Footing = Length (m) × Width (m) × Depth (m)</code></li>
      <li><code>Total Concrete = Volume per Footing × Number of Footings</code></li>
    </ul>

    <h3>2. Mesh Rebar Count (X and Y Directions)</h3>
    <p>
      The number of bottom mesh reinforcement bars is calculated using center-to-center spacing:
    </p>
    <ul>
      <li><code>Bars in X Direction = ceil(Width ÷ Spacing) + 1</code></li>
      <li><code>Bars in Y Direction = ceil(Length ÷ Spacing) + 1</code></li>
      <li><code>Total Bars per Footing = Bars in X Direction + Bars in Y Direction</code></li>
    </ul>

    <h3>3. Mesh Bar Cutting Length & Steel Weight</h3>
    <p>
      For standard isolated footings:
    </p>
    <ul>
      <li><code>Bar Length in X Direction = Length (m)</code></li>
      <li><code>Bar Length in Y Direction = Width (m)</code></li>
      <li><code>Total Steel Length per Footing = (Bars X × Length X) + (Bars Y × Length Y)</code></li>
      <li><code>Unit Weight of Rebar (kg/m) = (d² ÷ 162)</code>, where <code>d</code> is rebar diameter in mm</li>
      <li><code>Steel Weight per Footing (kg) = Total Steel Length × Unit Weight</code></li>
      <li><code>Total Steel for All Footings (kg) = Steel per Footing × Number of Footings</code></li>
    </ul>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-4 text-xs sm:text-sm">
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800" open>
        <summary class="font-bold text-slate-900 dark:text-white cursor-pointer flex justify-between items-center">
          What units should I enter for footing dimensions?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">
          All dimensions (Length L, Width B, Depth D, Mesh Spacing, and Rebar Diameter) should be entered in millimeters (mm). The calculator automatically converts them to meters for volume and steel length computations.
        </p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="font-bold text-slate-900 dark:text-white cursor-pointer flex justify-between items-center">
          How is the rebar unit weight calculated?
          <span class="group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">
          The standard standard civil engineering formula <code>(d² / 162)</code> is used, where <code>d</code> is the rebar diameter in mm. For example, 12 mm rebar weighs <code>(12 × 12) ÷ 162 = 0.889 kg/m</code>.
        </p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<script is:inline>
  const ftL = document.getElementById('ft-len');
  const ftB = document.getElementById('ft-width');
  const ftD = document.getElementById('ft-depth');
  const ftDia = document.getElementById('ft-dia');
  const ftSp = document.getElementById('ft-spacing');
  const ftCnt = document.getElementById('ft-count');

  const resTotal = document.getElementById('res-ft-total-steel');
  const resConc = document.getElementById('res-ft-concrete');
  const resSingle = document.getElementById('res-ft-single-steel');
  const resCutLen = document.getElementById('res-ft-cut-len');
  const resBarsCnt = document.getElementById('res-ft-bars-count');
  const resTotalLen = document.getElementById('res-ft-total-len');
  const resExcavation = document.getElementById('res-ft-excavation');

  function calculate() {
    const rawL = ftL.value.trim();
    const rawB = ftB.value.trim();
    const rawD = ftD.value.trim();

    if (rawL === '' && rawB === '' && rawD === '') {
      if (resTotal) resTotal.textContent = '0.00 kg (0.00 q)';
      if (resConc) resConc.textContent = '0.000 m³';
      if (resSingle) resSingle.textContent = '0.00 kg';
      if (resCutLen) resCutLen.textContent = '0.00 m';
      if (resBarsCnt) resBarsCnt.textContent = '0 Bars';
      if (resTotalLen) resTotalLen.textContent = '0.0 m';
      if (resExcavation) resExcavation.textContent = '0.00 m³';
      try { document.dispatchEvent(new CustomEvent('calculator:updated')); } catch (e) {}
      return;
    }

    // 1. Raw user inputs in millimeters
    const lengthMm = Math.max(0, parseFloat(ftL.value) || 0);
    const widthMm = Math.max(0, parseFloat(ftB.value) || 0);
    const depthMm = Math.max(0, parseFloat(ftD.value) || 0);
    const spacingMm = Math.max(1, parseFloat(ftSp.value) || 150);
    const rebarDiaMm = parseFloat(ftDia.value) || 12;
    const count = Math.max(1, parseInt(ftCnt.value) || 1);

    // 2. Convert to meters for volume and length calculations
    const lengthM = lengthMm / 1000;
    const widthM = widthMm / 1000;
    const depthM = depthMm / 1000;
    const spacingM = spacingMm / 1000;

    // 3. Concrete Volume Formula (m³)
    const volumePerFooting = lengthM * widthM * depthM;
    const totalConcrete = volumePerFooting * count;

    // 4. Mesh Bar Calculation (bars in X direction span B, bars in Y direction span L)
    const barsX = spacingMm > 0 && widthMm > 0 ? Math.ceil(widthMm / spacingMm) + 1 : 0;
    const barsY = spacingMm > 0 && lengthMm > 0 ? Math.ceil(lengthMm / spacingMm) + 1 : 0;
    const totalBarsPerFooting = barsX + barsY;

    // 5. Mesh Bar Cut Length in meters
    const lengthX = lengthM;
    const lengthY = widthM;

    // 6. Total Steel Length in meters
    const totalSteelLengthPerFooting = (barsX * lengthX) + (barsY * lengthY);
    const totalSteelLengthAllFootings = totalSteelLengthPerFooting * count;

    // 7. Rebar Unit Weight (d² / 162)
    const unitWeight = (rebarDiaMm * rebarDiaMm) / 162;

    // 8. Total Steel Weight (kg)
    const steelPerFooting = totalSteelLengthPerFooting * unitWeight;
    const totalSteelAllFootings = steelPerFooting * count;

    // 9. Total Pit Excavation Volume (m³)
    // Allowance: 0.3m working space each side (+0.6m) and +1.0m extra pit depth
    const excavation = (lengthM + 0.6) * (widthM + 0.6) * (depthM + 1.0) * count;

    // 10. Update UI Results
    if (resTotal) resTotal.textContent = `${totalSteelAllFootings.toFixed(2)} kg (${(totalSteelAllFootings / 100).toFixed(2)} q)`;
    if (resConc) resConc.textContent = `${totalConcrete.toFixed(3)} m³ (${count} Unit${count === 1 ? '' : 's'})`;
    if (resSingle) resSingle.textContent = `${steelPerFooting.toFixed(2)} kg`;
    if (resCutLen) resCutLen.textContent = lengthX === lengthY ? `${lengthX.toFixed(2)} m` : `${lengthX.toFixed(2)} m (X) / ${lengthY.toFixed(2)} m (Y)`;
    if (resBarsCnt) resBarsCnt.textContent = `${totalBarsPerFooting} Bars (${barsX}X + ${barsY}Y)`;
    if (resTotalLen) resTotalLen.textContent = `${totalSteelLengthPerFooting.toFixed(1)} m`;
    if (resExcavation) resExcavation.textContent = `${excavation.toFixed(2)} m³`;

    try { document.dispatchEvent(new CustomEvent('calculator:updated')); } catch (e) {}
  }

  const btnCalcFooting = document.getElementById('btn-calc-footing');
  const btnClearFooting = document.getElementById('btn-clear-footing');

  if (btnCalcFooting) {
    btnCalcFooting.addEventListener('click', () => {
      if (!ftL.value) ftL.value = '1500';
      if (!ftB.value) ftB.value = '1500';
      if (!ftD.value) ftD.value = '300';
      calculate();
      const card = document.getElementById('results-card');
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const orig = btnCalcFooting.innerHTML;
      btnCalcFooting.innerHTML = '<span>✅ Calculated!</span>';
      setTimeout(() => { btnCalcFooting.innerHTML = orig; }, 1200);
    });
  }

  if (btnClearFooting) {
    btnClearFooting.addEventListener('click', () => {
      ftL.value = '';
      ftB.value = '';
      ftD.value = '';
      ftSp.value = '';
      calculate();
      ftL.focus();
      const orig = btnClearFooting.innerHTML;
      btnClearFooting.innerHTML = '<span>✓ Cleared</span>';
      setTimeout(() => { btnClearFooting.innerHTML = orig; }, 1000);
    });
  }

  [ftL, ftB, ftD, ftDia, ftSp, ftCnt].forEach((el) => {
    if (!el) return;
    el.addEventListener('input', calculate);
    el.addEventListener('change', calculate);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        calculate();
      }
    });
  });

  calculate();
</script>
