        divWaterCtrl.classList.add("opacity-40", "pointer-events-none");
      }
      invalidateResults();
    });

    // Mode Tab Switching
    modeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetMode = btn.getAttribute("data-mode") as ConcreteMode;
        if (!targetMode) return;

        currentMode = targetMode;

        modeButtons.forEach((b) => {
          b.classList.remove(
            "active",
            "border-blue-600",
            "bg-blue-50",
            "text-blue-700",
            "dark:border-blue-500",
            "dark:bg-blue-950/60",
            "dark:text-blue-300",
          );
          b.classList.add(
            "border-transparent",
            "bg-white",
            "text-slate-700",
            "dark:bg-slate-800",
            "dark:text-slate-300",
          );
        });

        btn.classList.add(
          "active",
          "border-blue-600",
          "bg-blue-50",
          "text-blue-700",
          "dark:border-blue-500",
          "dark:bg-blue-950/60",
          "dark:text-blue-300",
        );
        btn.classList.remove(
          "border-transparent",
          "bg-white",
          "text-slate-700",
          "dark:bg-slate-800",
          "dark:text-slate-300",
        );

        // Hide all mode input sections
        sectionConcreteVolume.classList.add("hidden");
        sectionSlab.classList.add("hidden");
        sectionBeam.classList.add("hidden");
        sectionColumn.classList.add("hidden");
        sectionFooting.classList.add("hidden");
        sectionCustom.classList.add("hidden");

        // Show selected mode section
        if (targetMode === "concrete_volume") {
          sectionConcreteVolume.classList.remove("hidden");
          btnCalculate.innerHTML = "<span>🚀</span> Calculate Concrete Materials →";
        } else if (targetMode === "slab") {
          sectionSlab.classList.remove("hidden");
          btnCalculate.innerHTML = "<span>🚀</span> Calculate Slab Concrete →";
        } else if (targetMode === "beam") {
          sectionBeam.classList.remove("hidden");
          btnCalculate.innerHTML = "<span>🚀</span> Calculate Beam Concrete →";
        } else if (targetMode === "column") {
          sectionColumn.classList.remove("hidden");
          btnCalculate.innerHTML = "<span>🚀</span> Calculate Column Concrete →";
        } else if (targetMode === "footing") {
          sectionFooting.classList.remove("hidden");
          btnCalculate.innerHTML = "<span>🚀</span> Calculate Footing Concrete →";
        } else if (targetMode === "custom_dimensions") {
          sectionCustom.classList.remove("hidden");
          btnCalculate.innerHTML = "<span>🚀</span> Calculate Custom Concrete →";
        }

        invalidateResults();
      });
    });

    // Invalidate results when user edits any input field
    const allInputs = document.querySelectorAll("input, select");
    allInputs.forEach((el) => {
      el.addEventListener("input", () => {
        if (!resultsSection?.classList.contains("hidden")) {
          invalidateResults();
        }
      });
      el.addEventListener("change", () => {
        if (!resultsSection?.classList.contains("hidden")) {
          invalidateResults();
        }
      });
    });

    // Enter Key Handler for instant calculation
    document.querySelectorAll("input").forEach((inp) => {
      inp.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          performCalculation();
        }
      });
    });

    function performCalculation() {
      clearError();

      try {
        // 1. Determine Mix Ratio
        let cPart = 1;
        let sPart = 2;
        let aPart = 4;
        let mixName = "1 : 2 : 4";

        if (inpMixPreset.value === "custom") {
          cPart = parseFloat(inpCustomC.value);
          sPart = parseFloat(inpCustomS.value);
          aPart = parseFloat(inpCustomA.value);
          if (
            isNaN(cPart) ||
            cPart <= 0 ||
            isNaN(sPart) ||
            sPart <= 0 ||
            isNaN(aPart) ||
            aPart <= 0
          ) {
            return showError(
              "Please enter valid positive numbers for all parts of the custom mix ratio.",
            );
          }
          mixName = `${cPart} : ${sPart} : ${aPart}`;
        } else {
          const found = CONCRETE_MIX_PRESETS.find(
            (p) => p.id === inpMixPreset.value,
          );
          if (found) {
            cPart = found.cement;
            sPart = found.sand;
            aPart = found.aggregate;
            mixName = `${found.name} (${found.gradeLabel})`;
          }
        }

        // 2. Dry Factor, Bag Size, Wastage, Water
        const dryFactor = parseFloat(inpDryFactor.value);
        if (isNaN(dryFactor) || dryFactor <= 0) {
          return showError(
            "Please enter a valid positive Dry Volume Factor (default is 1.54).",
          );
        }

        let bagSize = 50;
        if (inpBagSize.value === "custom") {
          bagSize = parseFloat(inpCustomBagWeight.value);
          if (isNaN(bagSize) || bagSize <= 0) {
            return showError("Please enter a valid custom cement bag weight.");
          }
        } else {
          bagSize = parseFloat(inpBagSize.value) || 50;
        }

        let wastage = 5;
        if (inpWastage.value === "custom") {
          wastage = parseFloat(inpCustomWastageVal.value);
          if (isNaN(wastage) || wastage < 0) {
            return showError(
              "Please enter a valid non-negative wastage percentage.",
            );
          }
        } else {
          wastage = parseFloat(inpWastage.value) || 0;
        }

        const enableWater = chkEnableWater.checked;
        const wcRatio = parseFloat(inpWcRatio.value) || 0.5;

        let res: any = null;

        if (currentMode === "concrete_volume") {
          const v = parseFloat(inpVolVal.value);
          const u = inpVolUnit.value as VolumeUnit;
          if (isNaN(v) || v <= 0) {
            return showError("Please enter a valid positive Concrete Volume.");
          }

          res = calculateConcreteMaterial({
            mode: "concrete_volume",
            volumeValue: v,
            volumeUnit: u,
            cementPart: cPart,
            sandPart: sPart,
            aggregatePart: aPart,
            dryVolumeFactor: dryFactor,
            cementBagSizeKg: bagSize,
            wastagePercent: wastage,
            enableWater,
            waterCementRatio: wcRatio,
          });
        } else if (currentMode === "slab") {
          const l = parseFloat(inpSlabLen.value);
          const w = parseFloat(inpSlabWid.value);
          const t = parseFloat(inpSlabThick.value);
          const qty = parseInt(inpSlabQty.value, 10);

          if (
            isNaN(l) ||
            l <= 0 ||
            isNaN(w) ||
            w <= 0 ||
            isNaN(t) ||
            t <= 0 ||
            isNaN(qty) ||
            qty < 1
          ) {
            return showError(
              "Please enter valid positive dimensions and quantity for the slab.",
            );
          }

          res = calculateConcreteMaterial({
            mode: "slab",
            length: l,
            lengthUnit: inpSlabLenU.value as DimensionUnit,
            width: w,
            widthUnit: inpSlabWidU.value as DimensionUnit,
            heightOrDepth: t,
            heightOrDepthUnit: inpSlabThickU.value as DimensionUnit,
            quantity: qty,
            cementPart: cPart,
            sandPart: sPart,
            aggregatePart: aPart,
            dryVolumeFactor: dryFactor,
            cementBagSizeKg: bagSize,
            wastagePercent: wastage,
            enableWater,
            waterCementRatio: wcRatio,
          });
        } else if (currentMode === "beam") {
          const l = parseFloat(inpBeamLen.value);
          const w = parseFloat(inpBeamWid.value);
          const d = parseFloat(inpBeamDepth.value);
          const qty = parseInt(inpBeamQty.value, 10);

          if (
            isNaN(l) ||
            l <= 0 ||
            isNaN(w) ||
            w <= 0 ||
            isNaN(d) ||
            d <= 0 ||
            isNaN(qty) ||
            qty < 1
          ) {
            return showError(
              "Please enter valid positive dimensions and quantity for the beam.",
            );
          }

          res = calculateConcreteMaterial({
            mode: "beam",
            length: l,
            lengthUnit: inpBeamLenU.value as DimensionUnit,
            width: w,
            widthUnit: inpBeamWidU.value as DimensionUnit,
            heightOrDepth: d,
            heightOrDepthUnit: inpBeamDepthU.value as DimensionUnit,
            quantity: qty,
            cementPart: cPart,
            sandPart: sPart,
            aggregatePart: aPart,
            dryVolumeFactor: dryFactor,
            cementBagSizeKg: bagSize,
            wastagePercent: wastage,
            enableWater,
            waterCementRatio: wcRatio,
          });
        } else if (currentMode === "column") {
          const l = parseFloat(inpColLen.value);
          const w = parseFloat(inpColWid.value);
          const h = parseFloat(inpColHt.value);
          const qty = parseInt(inpColQty.value, 10);

          if (
            isNaN(l) ||
            l <= 0 ||
            isNaN(w) ||
            w <= 0 ||
            isNaN(h) ||
            h <= 0 ||
            isNaN(qty) ||
            qty < 1
          ) {
            return showError(
              "Please enter valid positive dimensions and quantity for the column.",
            );
          }

          res = calculateConcreteMaterial({
            mode: "column",
            length: l,
            lengthUnit: inpColLenU.value as DimensionUnit,
            width: w,
            widthUnit: inpColWidU.value as DimensionUnit,
            heightOrDepth: h,
            heightOrDepthUnit: inpColHtU.value as DimensionUnit,
            quantity: qty,
            cementPart: cPart,
            sandPart: sPart,
            aggregatePart: aPart,
            dryVolumeFactor: dryFactor,
            cementBagSizeKg: bagSize,
            wastagePercent: wastage,
            enableWater,
            waterCementRatio: wcRatio,
          });
        } else if (currentMode === "footing") {
          const l = parseFloat(inpFtLen.value);
          const w = parseFloat(inpFtWid.value);
          const d = parseFloat(inpFtDepth.value);
          const qty = parseInt(inpFtQty.value, 10);

          if (
            isNaN(l) ||
            l <= 0 ||
            isNaN(w) ||
            w <= 0 ||
            isNaN(d) ||
            d <= 0 ||
            isNaN(qty) ||
            qty < 1
          ) {
            return showError(
              "Please enter valid positive dimensions and quantity for the footing.",
            );
          }

          res = calculateConcreteMaterial({
            mode: "footing",
            length: l,
            lengthUnit: inpFtLenU.value as DimensionUnit,
            width: w,
            widthUnit: inpFtWidU.value as DimensionUnit,
            heightOrDepth: d,
            heightOrDepthUnit: inpFtDepthU.value as DimensionUnit,
            quantity: qty,
            cementPart: cPart,
            sandPart: sPart,
            aggregatePart: aPart,
            dryVolumeFactor: dryFactor,
            cementBagSizeKg: bagSize,
            wastagePercent: wastage,
            enableWater,
            waterCementRatio: wcRatio,
          });
        } else if (currentMode === "custom_dimensions") {
          const l = parseFloat(inpCdLen.value);
          const w = parseFloat(inpCdWid.value);
          const h = parseFloat(inpCdHt.value);
          const qty = parseInt(inpCdQty.value, 10);

          if (
            isNaN(l) ||
            l <= 0 ||
            isNaN(w) ||
            w <= 0 ||
            isNaN(h) ||
            h <= 0 ||
            isNaN(qty) ||
            qty < 1
          ) {
            return showError(
              "Please enter valid positive custom dimensions and quantity.",
            );
          }

          res = calculateConcreteMaterial({
            mode: "custom_dimensions",
            length: l,
            lengthUnit: inpCdLenU.value as DimensionUnit,
            width: w,
            widthUnit: inpCdWidU.value as DimensionUnit,
            heightOrDepth: h,
            heightOrDepthUnit: inpCdHtU.value as DimensionUnit,
            quantity: qty,
            cementPart: cPart,
            sandPart: sPart,
            aggregatePart: aPart,
            dryVolumeFactor: dryFactor,
            cementBagSizeKg: bagSize,
            wastagePercent: wastage,
            enableWater,
            waterCementRatio: wcRatio,
          });
        }

        if (!res) return;

        lastResultData = {
          modeTitle: getModeTitle(currentMode),
          mixName,
          ...res,
        };

        // Render Hero Card
        lblHeroTag.textContent = "ESTIMATED CONCRETE MATERIAL REQUIREMENT";
        badgeCalcMode.textContent = getModeTitle(currentMode);
        resHeroMain.textContent = `${res.cementBags.toLocaleString()} Bags (${res.cementBagSizeKg}kg)`;
        resHeroSub.textContent = `Total Wet Volume: ${res.totalWetVolumeCum.toLocaleString()} m³ (${res.totalWetVolumeCft.toLocaleString()} CFT) | Dry Volume: ${res.finalDryVolumeCum.toLocaleString()} m³ (${res.wastagePercent}% Wastage) | Mix Ratio: ${res.mixRatioLabel}`;

        // Render Metric Grid
        gridResultMetrics.innerHTML = `
          <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">Cement Required</div>
            <div class="mt-1 text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400">${Math.round(res.cementWeightKg).toLocaleString()} kg <span class="text-xs font-normal text-slate-500">(${res.cementWeightTons} MT)</span></div>
          </div>
          <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">Sand (Fine Agg)</div>
            <div class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">${res.sandVolumeCft.toLocaleString()} CFT <span class="text-xs font-normal text-slate-500">(${res.sandVolumeCum} m³)</span></div>
          </div>
          <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">Coarse Aggregate</div>
            <div class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">${res.aggVolumeCft.toLocaleString()} CFT <span class="text-xs font-normal text-slate-500">(${res.aggVolumeCum} m³)</span></div>
          </div>
          <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">${res.waterEnabled ? "Water Estimated" : "Dry Volume (1.54)"}</div>
            <div class="mt-1 text-sm sm:text-base font-bold ${res.waterEnabled ? "text-cyan-600 dark:text-cyan-400" : "text-slate-900 dark:text-white"}">${res.waterEnabled ? `${res.waterLiters.toLocaleString()} Liters` : `${res.finalDryVolumeCum} m³`} <span class="text-xs font-normal text-slate-500">${res.waterEnabled ? `(${res.waterGallons} Gal)` : `(${res.finalDryVolumeCft} CFT)`}</span></div>
          </div>
        `;

        // Render Material Breakdown Table
        tbodyMaterialBreakdown.innerHTML = res.tableBreakdown
          .map(
            (row: any) => `
            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
              <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">${row.material}</td>
              <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">${row.baseVolumeCum} m³ <span class="text-xs text-slate-400">(${row.baseVolumeCft} CFT)</span></td>
              <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">${row.wastageVolumeCum} m³ <span class="text-xs text-slate-400">(${row.wastageVolumeCft} CFT)</span></td>
              <td class="py-2.5 px-3 font-semibold text-slate-900 dark:text-white">${row.finalVolumeCum} m³ <span class="text-xs text-slate-400">(${row.finalVolumeCft} CFT)</span></td>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">${row.practicalDisplay}</td>
            </tr>
          `,
          )
          .join("");

        // Render Step-by-Step Mathematical Details
        txtCalcDetails.innerHTML = res.stepDetails
          .map((line: string) => `<div>${line}</div>`)
          .join("");

        // Render Concrete Mix Comparison Table
        tbodyMixComparison.innerHTML = res.comparisonTable
          .map(
            (cRow: any) => `
            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition ${cRow.presetId === inpMixPreset.value ? "bg-blue-50/40 dark:bg-blue-950/20 font-semibold" : ""}">
              <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">${cRow.name} <span class="text-xs font-normal text-blue-600 dark:text-blue-400">(${cRow.gradeLabel})</span></td>
              <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">${cRow.name}</td>
              <td class="py-2.5 px-3 text-slate-600 dark:text-slate-300">${cRow.totalParts}</td>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">${cRow.cementBags} Bags <span class="text-xs font-normal text-slate-500">(${cRow.cementKg.toLocaleString()} kg)</span></td>
              <td class="py-2.5 px-3 font-semibold text-emerald-600 dark:text-emerald-400">${cRow.sandCft} CFT <span class="text-xs font-normal text-slate-500">(${cRow.sandCum} m³)</span></td>
              <td class="py-2.5 px-3 text-slate-800 dark:text-slate-200">${cRow.aggCft} CFT <span class="text-xs font-normal text-slate-500">(${cRow.aggCum} m³)</span></td>
            </tr>
          `,
          )
          .join("");

        resultsSection.classList.remove("hidden");
        resultsSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } catch (err: any) {
        showError(
          err.message ||
            "An unexpected error occurred during calculation. Please check your inputs.",
        );
      }
    }

    function getModeTitle(m: ConcreteMode): string {
      switch (m) {
        case "concrete_volume":
          return "Concrete Volume";
        case "slab":
          return "Slab Element";
        case "beam":
          return "Beam Element";
        case "column":
          return "Column Element";
        case "footing":
          return "Footing Element";
        case "custom_dimensions":
          return "Custom Dimensions";
        default:
          return "Concrete Material";
      }
    }

    function performClearAll() {
      // 1. Reset Volume
      inpVolVal.value = "10";
      inpVolUnit.value = "cum";

      // 2. Reset Slab
      inpSlabLen.value = "10";
      inpSlabLenU.value = "meter";
      inpSlabWid.value = "5";
      inpSlabWidU.value = "meter";
      inpSlabThick.value = "150";
      inpSlabThickU.value = "mm";
      inpSlabQty.value = "1";

      // 3. Reset Beam
      inpBeamLen.value = "6";
      inpBeamLenU.value = "meter";
      inpBeamWid.value = "300";
      inpBeamWidU.value = "mm";
      inpBeamDepth.value = "450";
      inpBeamDepthU.value = "mm";
      inpBeamQty.value = "4";

      // 4. Reset Column
      inpColLen.value = "300";
      inpColLenU.value = "mm";
      inpColWid.value = "300";
      inpColWidU.value = "mm";
      inpColHt.value = "3.0";
      inpColHtU.value = "meter";
      inpColQty.value = "6";

      // 5. Reset Footing
      inpFtLen.value = "1.5";
      inpFtLenU.value = "meter";
      inpFtWid.value = "1.5";
      inpFtWidU.value = "meter";
      inpFtDepth.value = "500";
      inpFtDepthU.value = "mm";
      inpFtQty.value = "6";

      // 6. Reset Custom
      inpCdLen.value = "5";
      inpCdLenU.value = "meter";
      inpCdWid.value = "2";
      inpCdWidU.value = "meter";
      inpCdHt.value = "0.5";
      inpCdHtU.value = "meter";
      inpCdQty.value = "2";

      // 7. Reset Mix Settings
      inpMixPreset.value = "1:2:4";
      divCustomMixRatio.classList.add("hidden");
      inpCustomC.value = "1";
      inpCustomS.value = "2";
      inpCustomA.value = "4";

      inpDryFactor.value = "1.54";
      inpBagSize.value = "50";
      divCustomBagWeight.classList.add("hidden");
      inpCustomBagWeight.value = "50";

      inpWastage.value = "5";
      divCustomWastage.classList.add("hidden");
      inpCustomWastageVal.value = "5";

      chkEnableWater.checked = true;
      divWaterCtrl.classList.remove("opacity-40", "pointer-events-none");
      inpWcRatio.value = "0.50";

      // Reset Tab to Concrete Volume
      modeButtons[0].click();
      invalidateResults();
    }

    btnCalculate.addEventListener("click", performCalculation);
    btnClearAll.addEventListener("click", performClearAll);

    // PDF Export Generation
    if (btnDownloadPdf) {
      btnDownloadPdf.addEventListener("click", async () => {
        if (!lastResultData) return;

        const txtBtn = document.getElementById("txt-btn-pdf");
        if (txtBtn) txtBtn.textContent = "Generating PDF...";

        try {
          let jsPDFModule = (window as any).jspdf;
          if (!jsPDFModule) {
            const script1 = document.createElement("script");
            script1.src = "https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js";
            await new Promise((resolve, reject) => {
              script1.onload = resolve;
              script1.onerror = reject;
              document.head.appendChild(script1);
            });
            const script2 = document.createElement("script");
            script2.src = "https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js";
            await new Promise((resolve, reject) => {
              script2.onload = resolve;
              script2.onerror = reject;
              document.head.appendChild(script2);
            });
            jsPDFModule = (window as any).jspdf;
          } else if (!(window as any).jspdf?.plugin?.autotable && !(window as any).autoTable) {
            const script2 = document.createElement("script");
            script2.src = "https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js";
            await new Promise((resolve, reject) => {
              script2.onload = resolve;
              script2.onerror = reject;
              document.head.appendChild(script2);
            });
          }

          const { jsPDF } = jsPDFModule;
          const doc = new jsPDF({ unit: "pt", format: "a4" });

          const primaryColor = [37, 99, 235]; // #2563eb
          const darkColor = [15, 23, 42]; // #0f172a
          const slateColor = [100, 116, 139]; // #64748b
          const lightBg = [248, 250, 252]; // #f8fafc

          const pageWidth = doc.internal.pageSize.getWidth();
          const pageHeight = doc.internal.pageSize.getHeight();
          const margin = 40;
          let y = 45;

          // Top Header Branding
          doc.setFont("helvetica", "bold");
          doc.setFontSize(18);
          doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
          doc.text("AIFreecalculator.com", margin, y);

          doc.setFont("helvetica", "normal");
          doc.setFontSize(9);
          doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
          doc.text("Free Online Calculator Tools", margin, y + 13);

          const now = new Date();
          const dateStr = now.toISOString().split("T")[0];
          doc.text(`Generated: ${dateStr}`, pageWidth - margin, y + 5, {
            align: "right",
          });

          y += 28;
          doc.setDrawColor(226, 232, 240);
          doc.line(margin, y, pageWidth - margin, y);
          y += 24;

          // Mode Title
          doc.setFont("helvetica", "bold");
          doc.setFontSize(14);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text(
            `Concrete Material Breakup Calculation (${lastResultData.modeTitle})`,
            margin,
            y,
          );
          y += 18;

          // Summary Box
          doc.setFillColor(lightBg[0], lightBg[1], lightBg[2]);
          doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, "F");
          doc.setDrawColor(203, 213, 225);
          doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, "D");

          doc.setFont("helvetica", "bold");
          doc.setFontSize(10);
          doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
          doc.text(
            lblHeroTag.textContent || "ESTIMATED MATERIAL REQUIREMENT",
            margin + 14,
            y + 18,
          );

          doc.setFontSize(14);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text(resHeroMain.textContent || "", margin + 14, y + 36);

          y += 68;

          const paramRows: Array<[string, string]> = [
            ["Calculation Mode", lastResultData.modeTitle],
            [
              "Total Wet Concrete Volume",
              `${lastResultData.totalWetVolumeCum} m3 (${lastResultData.totalWetVolumeCft} CFT / ${lastResultData.totalWetVolumeCyd} yd3)`,
            ],
            [
              "Dry Volume Multiplier Factor",
              `${lastResultData.dryVolumeFactor}`,
            ],
            [
              "Base Dry Volume",
              `${lastResultData.baseDryVolumeCum} m3 (${lastResultData.baseDryVolumeCft} CFT)`,
            ],
            ["Wastage Allowance", `${lastResultData.wastagePercent}%`],
            [
              "Final Dry Mix Volume",
              `${lastResultData.finalDryVolumeCum} m3 (${lastResultData.finalDryVolumeCft} CFT)`,
            ],
            [
              "Concrete Mix Ratio",
              `${lastResultData.mixRatioLabel} (Total Parts: ${lastResultData.totalRatioParts})`,
            ],
            [
              "Cement Required",
              `${lastResultData.cementBags} Bags (${lastResultData.cementBagSizeKg}kg) / ${Math.round(lastResultData.cementWeightKg).toLocaleString()} kg (${lastResultData.cementWeightTons} MT)`,
            ],
            [
              "Sand Required (Fine Aggregate)",
              `${lastResultData.sandVolumeCft} CFT / ${lastResultData.sandVolumeCum} m3 (${lastResultData.sandWeightTons} MT)`,
            ],
            [
              "Coarse Aggregate Required",
              `${lastResultData.aggVolumeCft} CFT / ${lastResultData.aggVolumeCum} m3 (${lastResultData.aggWeightTons} MT)`,
            ],
          ];

          if (lastResultData.waterEnabled && lastResultData.waterLiters > 0) {
            paramRows.push([
              "Estimated Water Quantity",
              `${lastResultData.waterLiters.toLocaleString()} Liters (${lastResultData.waterGallons.toLocaleString()} Gallons, W/C: ${lastResultData.waterCementRatio})`,
            ]);
          }

          // Render Parameter Table with autoTable (clean line wrapping & no overflow)
          (doc as any).autoTable({
            startY: y,
            head: [["Calculation Parameter / Metric", "Value & Specification"]],
            body: paramRows,
            theme: "striped",
            headStyles: { fillColor: [37, 99, 235], textColor: 255, fontStyle: "bold", fontSize: 9 },
            columnStyles: {
              0: { cellWidth: 200, fontStyle: "bold" },
              1: { cellWidth: "auto" },
            },
            margin: { left: margin, right: margin, top: 40, bottom: 40 },
            styles: { fontSize: 8.5, cellPadding: 4, overflow: "linebreak" },
            pageBreak: "auto",
          });

          y = (doc as any).lastAutoTable.finalY + 16;

          // Material Table Section
          (doc as any).autoTable({
            startY: y,
            head: [["Material Component", "Procurement Requirement"]],
            body: lastResultData.tableBreakdown.map((item: any) => [
              item.material.replace(/[³²×÷₹]/g, ' '),
              item.practicalDisplay.replace(/[³²×÷₹]/g, ' ')
            ]),
            theme: "striped",
            headStyles: { fillColor: [15, 23, 42], textColor: 255, fontStyle: "bold", fontSize: 9 },
            columnStyles: {
              0: { cellWidth: 180, fontStyle: "bold" },
              1: { cellWidth: "auto" },
            },
            margin: { left: margin, right: margin, top: 40, bottom: 40 },
            styles: { fontSize: 8.5, cellPadding: 4, overflow: "linebreak" },
            pageBreak: "auto",
          });

          // Footer on every page
          const totalPages = (doc.internal as any).getNumberOfPages();
          for (let i = 1; i <= totalPages; i++) {
            doc.setPage(i);
            doc.setFont("helvetica", "normal");
            doc.setFontSize(8);
            doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
            doc.text(
              "Generated using AIFreecalculator.com",
              margin,
              pageHeight - 20,
            );
            doc.text(
              `Page ${i} of ${totalPages}`,
              pageWidth - margin,
              pageHeight - 20,
              { align: "right" },
            );
          }

          const fileName = `concrete-material-breakup-${dateStr}.pdf`;
          doc.save(fileName);
        } catch (e) {
          console.error("PDF generation error:", e);
        } finally {
          if (txtBtn) txtBtn.textContent = "Download PDF";
        }
      });
    }
  </script>
</CalculatorLayout>
