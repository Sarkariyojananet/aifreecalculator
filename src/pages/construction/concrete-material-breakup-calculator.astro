            >
            <input
              type="number"
              id="inp-beam-qty"
              value="4"
              min="1"
              step="1"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="4"
            />
          </div>
        </div>
      </div>

      <!-- ========================================================= -->
      <!-- 4. COLUMN INPUTS -->
      <!-- ========================================================= -->
      <div id="section-input-column" class="hidden space-y-4">
        <div class="border-b border-slate-200/80 pb-2 dark:border-slate-800">
          <h2
            class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"
