---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";

const faqs = [
  {
    q: "What is a concrete material breakup calculator?",
    a: "A concrete material breakup calculator estimates the approximate quantity of cement, sand, coarse aggregate, and other materials required for a given volume of concrete. The calculation is based on the entered concrete volume or dimensions, selected mix ratio, dry volume assumption, cement bag size, and wastage allowance.",
  },
  {
    q: "How is the quantity of cement calculated for concrete?",
    a: "The calculator estimates the dry volume of concrete and divides it according to the selected cement, sand, and aggregate mix ratio. The cement portion is then converted into weight and an estimated number of bags based on the selected cement bag size and any assumptions used by the calculator.",
  },
  {
    q: "How do I calculate sand and aggregate required for concrete?",
    a: "After estimating the dry volume, the sand and aggregate quantities are calculated according to their proportion in the selected mix ratio. For example, in a 1:2:4 ratio, the dry volume is divided into seven total parts, with two parts allocated to sand and four parts to coarse aggregate.",
  },
  {
    q: "What is the dry volume factor in concrete calculation?",
    a: "The dry volume factor is an estimation adjustment used to account for the difference between the final compacted concrete volume and the combined volume of dry materials. The appropriate factor can vary depending on the calculation method and project assumptions, so this calculator displays the factor being used.",
  },
  {
    q: "Can I calculate cement bags with this calculator?",
    a: "Yes. After estimating the required cement quantity, the calculator divides the cement weight by the selected bag size to estimate the number of cement bags required. You can choose a preset bag size or enter a custom size where supported.",
  },
  {
    q: "Can I calculate concrete materials for a slab, beam, column, or footing?",
    a: "Yes. You can enter the dimensions of common structural elements such as slabs, beams, columns, and footings. The calculator first estimates the total concrete volume and then provides an approximate material breakup based on the selected mix ratio and calculation assumptions.",
  },
  {
    q: "Are the concrete material calculations exact?",
    a: "No. The results are estimates based on the dimensions, mix ratio, dry volume factor, wastage, material assumptions, and other values entered. Actual quantities can vary because of moisture content, compaction, material properties, workmanship, mix design, and project specifications.",
  },
];
---

<CalculatorLayout
  title="Concrete Material Breakup Calculator – Cement, Sand & Aggregate Quantity | AI Free Calculator"
  description="Calculate the approximate quantity of cement, sand, aggregate, water, and cement bags required for a given volume of concrete."
  category="Construction"
  calculatorName="Concrete Material Breakup Calculator"
  slug="concrete-material-breakup-calculator"
  keywords={[
    "concrete material breakup",
    "concrete material breakup calculator",
    "cement sand aggregate calculator",
    "concrete calculator",
    "concrete mix ratio",
    "how many cement bags in 1m3",
    "concrete volume calculator",
    "slab concrete calculator",
    "beam concrete calculator",
    "column concrete calculator",
    "footing concrete calculator",
    "dry volume factor concrete",
    "m20 concrete mix ratio",
    "m15 concrete mix ratio",
    "concrete quantity estimator",
  ]}
>
  <div class="space-y-6">
    <!-- Mode Selector Tabs -->
    <div
      class="rounded-2xl border border-slate-200/80 bg-slate-50/60 p-1.5 dark:border-slate-800 dark:bg-slate-900/50"
    >
      <div
        class="grid grid-cols-2 gap-1.5 sm:grid-cols-3 lg:grid-cols-6"
        id="mode-tabs"
      >
        <button
          type="button"
          data-mode="concrete_volume"
          class="mode-btn active flex items-center justify-center gap-1.5 rounded-xl border border-blue-600 bg-blue-50 px-2.5 py-2 text-xs font-bold text-blue-700 shadow-xs transition dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer"
        >
          <span>📦</span> Concrete Volume
        </button>
        <button
          type="button"
          data-mode="slab"
          class="mode-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>🏗️</span> Slab
        </button>
        <button
          type="button"
          data-mode="beam"
          class="mode-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>📏</span> Beam
        </button>
        <button
          type="button"
          data-mode="column"
          class="mode-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>🏛️</span> Column
        </button>
        <button
          type="button"
          data-mode="footing"
          class="mode-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>⛏️</span> Footing
        </button>
        <button
          type="button"
          data-mode="custom_dimensions"
          class="mode-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-white px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>⚙️</span> Custom
        </button>
      </div>
    </div>

    <!-- Error Banner -->
    <div
      id="error-box"
      class="hidden rounded-xl border border-red-200 bg-red-50/90 p-4 text-xs sm:text-sm font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/50 dark:text-red-300"
    >
    </div>

    <!-- Calculator Input Form Container -->
    <div
