              <input
                type="number"
                id="inp-beam-wid"
                value="300"
                min="1"
                step="any"
                class="w-2/3 rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                placeholder="300"
              />
              <select
                id="inp-beam-wid-u"
                class="w-1/3 rounded-xl border border-slate-300 bg-white p-2 text-[11px] font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
              >
                <option value="mm" selected>mm</option>
                <option value="cm">cm</option>
                <option value="inches">in</option>
                <option value="meter">m</option>
              </select>
            </div>
          </div>

          <div>
            <label
              for="inp-beam-depth"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
