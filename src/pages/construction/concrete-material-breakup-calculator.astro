      <!-- ========================================================= -->
      <!-- 5. FOOTING INPUTS -->
      <!-- ========================================================= -->
      <div id="section-input-footing" class="hidden space-y-4">
        <div class="border-b border-slate-200/80 pb-2 dark:border-slate-800">
          <h2
