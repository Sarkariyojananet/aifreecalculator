      currentCurrency = curr;

      if (curr === 'INR') {
        btnCurrInr.className = 'rounded-lg px-2.5 py-1.5 font-bold transition cursor-pointer bg-emerald-600 text-white shadow-xs';
        btnCurrUsd.className = 'rounded-lg px-2.5 py-1.5 font-bold transition cursor-pointer text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white';
        document.querySelectorAll('.lbl-curr-sym').forEach(el => el.textContent = '₹');
        inputUnitPrice.value = currentUnitSystem === 'metric' ? '72' : '33';
      } else {
        btnCurrUsd.className = 'rounded-lg px-2.5 py-1.5 font-bold transition cursor-pointer bg-emerald-600 text-white shadow-xs';
        btnCurrInr.className = 'rounded-lg px-2.5 py-1.5 font-bold transition cursor-pointer text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white';
        document.querySelectorAll('.lbl-curr-sym').forEach(el => el.textContent = '$');
        inputUnitPrice.value = currentUnitSystem === 'metric' ? '1.20' : '0.55';
      }

      markInputsStale();
    }

    btnUnitMetric.addEventListener('click', () => setUnitSystem('metric'));
    btnUnitImperial.addEventListener('click', () => setUnitSystem('imperial'));
    btnCurrInr.addEventListener('click', () => setCurrency('INR'));
    btnCurrUsd.addEventListener('click', () => setCurrency('USD'));

    // ---------------------------------------------------------------------------
    // STALE RESULT HANDLING
    // ---------------------------------------------------------------------------
    function markInputsStale() {
      drawVisualDiagrams(); // Dynamic visual diagrams always update live
      if (hasCalculated) {
        staleWarning.classList.remove('hidden');
        resultsCard.classList.add('opacity-80');
      }
    }

    if (btnRecalculateStale) {
      btnRecalculateStale.addEventListener('click', () => {
        executeCalculation();
      });
    }

    // ---------------------------------------------------------------------------
    // SHAPE SELECTION VISIBILITY
    // ---------------------------------------------------------------------------
    function updateShapeForm() {
      const type = selectSteelType.value;

      [inputsRebar, inputsRound, inputsSquare, inputsHex, inputsPlate, inputsPipe, inputsHollow, inputsAngle, inputsBeamChannel].forEach(el => el?.classList.add('hidden'));

      if (type === 'rebar') {
        inputsRebar.classList.remove('hidden');
        materialSelectorCol.classList.add('hidden');
      } else {
        materialSelectorCol.classList.remove('hidden');

        if (type === 'round_bar' || type === 'ss_round') {
          inputsRound.classList.remove('hidden');
          if (type === 'ss_round') selectMaterial.value = 'ss_304';
        } else if (type === 'square_bar') {
          inputsSquare.classList.remove('hidden');
        } else if (type === 'hex_bar') {
          inputsHex.classList.remove('hidden');
        } else if (type === 'plate' || type === 'ss_plate') {
          inputsPlate.classList.remove('hidden');
          if (type === 'ss_plate') selectMaterial.value = 'ss_304';
        } else if (type === 'pipe' || type === 'ss_pipe') {
          inputsPipe.classList.remove('hidden');
          if (type === 'ss_pipe') selectMaterial.value = 'ss_304';
        } else if (type === 'shs' || type === 'rhs') {
          inputsHollow.classList.remove('hidden');
          const colH = document.getElementById('col-hollow-h');
          if (colH) {
            if (type === 'shs') {
              colH.classList.add('hidden');
            } else {
              colH.classList.remove('hidden');
            }
          }
        } else if (type === 'angle') {
          inputsAngle.classList.remove('hidden');
        } else if (type === 'channel' || type === 'beam') {
          inputsBeamChannel.classList.remove('hidden');
        }
      }

      markInputsStale();
    }

    selectSteelType.addEventListener('change', updateShapeForm);

    selectRebarDia.addEventListener('change', () => {
      if (selectRebarDia.value === 'custom') {
        inputRebarCustom.classList.remove('hidden');
      } else {
        inputRebarCustom.classList.add('hidden');
      }
      markInputsStale();
    });

    selectRebarMode.addEventListener('change', () => {
      const m = selectRebarMode.value;
      const lenUnit = currentUnitSystem === 'metric' ? 'm' : 'ft';
      const wtUnit = currentUnitSystem === 'metric' ? 'kg' : 'lb';

      if (m === 'bars') {
        lblRebarQty.textContent = 'Quantity (Number of Standard 12m Bars)';
      } else if (m === 'length') {
        lblRebarQty.textContent = `Total Linear Length (${lenUnit})`;
      } else {
        lblRebarQty.textContent = `Target Total Weight (${wtUnit})`;
      }
      markInputsStale();
    });

