---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { STANDARD_REBAR_SIZES } from '../../lib/calculators/steel-weight-calculator';

const faqs = [
  {
    q: 'How do I calculate steel weight?',
    a: 'Multiply the material volume (Cross-Sectional Area × Length) by the material density (7,850 kg/m³ for mild steel). For rebar, use the standard civil engineering formula: Weight = (D² / 162.28) × Length in meters.',
  },
  {
    q: 'How do I calculate steel weight in kg?',
    a: 'Calculate the geometric volume in cubic meters (m³) and multiply by the steel density of 7,850 kg/m³. For flat steel plates, use: Length (m) × Width (m) × Thickness (mm) × 7.85.',
  },
  {
    q: 'What is the formula for steel bar weight?',
    a: 'The standard unit weight formula for steel rebar is: Weight per meter (kg/m) = D² ÷ 162.28, where D is the nominal bar diameter in millimeters (mm).',
  },
  {
    q: 'Why is D² / 162 used for rebar weight?',
    a: 'It is mathematically derived from the volume of a circular cylinder of steel (π × D² / 4) multiplied by the standard density of mild structural steel (7,850 kg/m³).',
  },
  {
    q: 'How much does a 12 mm steel bar weigh?',
    a: 'A 12 mm TMT rebar weighs 0.889 kg per meter. A standard 12-meter commercial length bar weighs approximately 10.67 kg.',
  },
  {
    q: 'How is steel pipe weight calculated?',
    a: 'Weight (kg) = (Outer Diameter - Wall Thickness) × Wall Thickness × 0.02466 × Length in meters, where dimensions are in millimeters and density is 7,850 kg/m³.',
  },
  {
    q: 'How do I calculate stainless steel weight?',
    a: 'Use standard cross-sectional geometric formulas multiplied by the specific stainless steel alloy density: 7,930 kg/m³ for SS 304 and 8,000 kg/m³ for SS 316.',
  },
  {
    q: 'How many 12m steel bars are in 1 metric ton?',
    a: 'It depends on the diameter: 8mm (~211 bars), 10mm (~135 bars), 12mm (~94 bars), 16mm (~53 bars), 20mm (~34 bars), 25mm (~22 bars), and 32mm (~13 bars).',
  },
  {
    q: 'Can I download my steel weight calculation as a PDF?',
    a: 'Yes. After clicking Calculate Weight, you can download a branded PDF summary containing all entered dimensions, unit weights, itemized calculations, and worked formulas.',
  },
];
---

<CalculatorLayout
  title="Steel Weight Calculator – Calculate Steel Weight in KG | AI Free Calculator"
  description="Free steel weight calculator in kg and tonnes. Calculate rebar weight (D²/162), round bars, steel plates, pipes, hollow sections, structural steel, and stainless steel."
  category="Construction"
  calculatorName="Steel Weight Calculator"
  slug="steel-weight-calculator"
  keywords={[
    'steel weight calculator',
    'steel weight calculator in kg',
    'structural steel weight calculator',
    'stainless steel weight calculator',
    'rebar weight calculator',
    'd2 162 formula',
    'tmt bar weight',
    'steel plate weight calculator',
    'steel pipe weight calculator',
    'round bar weight calculator',
    'weight of steel bar 12m',
    'ms steel weight calculator',
  ]}
>
  <div class="space-y-6">

    <!-- QUICK EXAMPLE PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="rebar" data-dia="12" data-mode="bars" data-qty="50">50 Bars 12mm Rebar</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="rebar" data-dia="16" data-mode="length" data-qty="100">100m 16mm Rebar</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="plate" data-mat="mild_steel" data-w="1000" data-t="10" data-l="2" data-qty="1">Steel Plate (1000×10mm, 2m)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="pipe" data-mat="mild_steel" data-od="114.3" data-t="4.5" data-l="6" data-qty="1">Pipe (OD 114.3, Wall 4.5mm, 6m)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="shs" data-mat="mild_steel" data-w="100" data-t="5" data-l="6" data-qty="1">SHS Box (100×100×5mm, 6m)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="round_bar" data-mat="ss_304" data-dia="25" data-l="3" data-qty="2">SS 304 Round Bar (Ø25mm, 3m)</button>
      </div>
    </div>

    <!-- MAIN STEEL CALCULATOR CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🔩</span> Universal Steel Weight Calculator
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Select steel type, enter dimensions, and click <strong>Calculate Weight</strong>.
            </p>
          </div>
          <span class="rounded-full bg-blue-100 px-3 py-1 text-[11px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
            Rebar & Structural
          </span>
        </div>
      </div>

      <form id="form-steel" class="mt-5 space-y-5" novalidate onsubmit="return false;">
        
        <!-- ROW 1: STEEL TYPE & MATERIAL SELECTION -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="select-steel-type" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              1. Steel Type / Shape
            </label>
            <select
              id="select-steel-type"
              class="mt-1.5 w-full rounded-xl border-2 border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer"
            >
              <optgroup label="Rebar / Reinforcement">
                <option value="rebar" selected>Rebar / TMT Bar (D²/162 formula)</option>
              </optgroup>
              <optgroup label="Solid Structural Shapes">
                <option value="round_bar">Round Bar (Solid Cylindrical)</option>
                <option value="square_bar">Square Bar (Solid Square)</option>
                <option value="plate">Flat Bar / Plate / Sheet</option>
              </optgroup>
              <optgroup label="Hollow & Tubular Sections">
                <option value="pipe">Steel Pipe / Round Tube (Hollow)</option>
                <option value="shs">Hollow Square Section (SHS)</option>
                <option value="rhs">Hollow Rectangular Section (RHS)</option>
              </optgroup>
              <optgroup label="Structural Profiles">
                <option value="angle">Angle (Equal / Unequal L-Section)</option>
                <option value="channel">C-Channel Profile</option>
                <option value="beam">I-Beam / H-Beam Profile</option>
              </optgroup>
              <optgroup label="Stainless Steel (SS 304 / SS 316)">
                <option value="ss_round">Stainless Steel Round Bar</option>
                <option value="ss_plate">Stainless Steel Plate / Sheet</option>
                <option value="ss_pipe">Stainless Steel Pipe</option>
              </optgroup>
            </select>
          </div>

          <div id="material-selector-col">
            <label for="select-material" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              2. Steel Material & Density
            </label>
            <select
              id="select-material"
              class="mt-1.5 w-full rounded-xl border-2 border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer"
            >
              <option value="mild_steel" selected>Mild Steel / Carbon Steel (7,850 kg/m³)</option>
              <option value="ss_304">Stainless Steel 304 (7,930 kg/m³)</option>
              <option value="ss_316">Stainless Steel 316 (8,000 kg/m³)</option>
              <option value="generic_ss">Generic Stainless Steel (7,900 kg/m³)</option>
              <option value="cast_iron">Cast Iron (7,200 kg/m³)</option>
              <option value="aluminium">Aluminium 6061 (2,700 kg/m³)</option>
            </select>
          </div>
        </div>

        <!-- DYNAMIC DIMENSIONS INPUT FIELDS -->
        <div class="rounded-2xl border border-slate-200/90 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50">
          
          <!-- A. REBAR INPUTS -->
          <div id="inputs-rebar" class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div>
                <label for="select-rebar-dia" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Bar Diameter (mm)
                </label>
                <select id="select-rebar-dia" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer">
                  <option value="6">6 mm (0.222 kg/m)</option>
                  <option value="8">8 mm (0.395 kg/m)</option>
                  <option value="10">10 mm (0.617 kg/m)</option>
                  <option value="12" selected>12 mm (0.889 kg/m)</option>
                  <option value="16">16 mm (1.580 kg/m)</option>
                  <option value="20">20 mm (2.469 kg/m)</option>
                  <option value="25">25 mm (3.858 kg/m)</option>
                  <option value="28">28 mm (4.834 kg/m)</option>
                  <option value="32">32 mm (6.313 kg/m)</option>
                  <option value="36">36 mm (7.990 kg/m)</option>
                  <option value="40">40 mm (9.865 kg/m)</option>
                  <option value="custom">Custom Diameter (mm)</option>
                </select>
                <input
                  type="number"
                  id="input-rebar-custom"
                  placeholder="Enter Diameter in mm"
                  min="1"
                  step="0.1"
                  class="mt-2 hidden w-full rounded-xl border border-blue-400 bg-white p-2 text-sm font-bold dark:border-blue-600 dark:bg-slate-900 dark:text-white"
                />
              </div>

              <div>
                <label for="select-rebar-mode" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Calculation Input Mode
                </label>
                <select id="select-rebar-mode" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer">
                  <option value="bars" selected>Number of 12-Meter Bars (Nos)</option>
                  <option value="length">Total Length (Meters)</option>
                  <option value="weight">Target Total Weight (kg)</option>
                </select>
              </div>

              <div>
                <label id="lbl-rebar-qty" for="input-rebar-qty" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Quantity (Number of 12m Bars)
                </label>
                <input
                  type="number"
                  id="input-rebar-qty"
                  value="50"
                  min="0.1"
                  step="any"
                  class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                />
              </div>
            </div>
          </div>

          <!-- B. ROUND BAR INPUTS -->
          <div id="inputs-round" class="hidden space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div>
                <label for="input-round-dia" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Diameter (mm)</label>
                <input type="number" id="input-round-dia" value="25" min="1" step="0.5" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-round-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Length per Piece (m)</label>
                <input type="number" id="input-round-len" value="3" min="0.1" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-round-qty" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quantity (Pieces)</label>
                <input type="number" id="input-round-qty" value="1" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
            </div>
          </div>

          <!-- C. SQUARE BAR INPUTS -->
          <div id="inputs-square" class="hidden space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div>
                <label for="input-square-side" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Side Width (mm)</label>
                <input type="number" id="input-square-side" value="20" min="1" step="0.5" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-square-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Length per Piece (m)</label>
                <input type="number" id="input-square-len" value="3" min="0.1" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-square-qty" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quantity (Pieces)</label>
                <input type="number" id="input-square-qty" value="1" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
            </div>
          </div>

          <!-- D. FLAT BAR / PLATE INPUTS -->
          <div id="inputs-plate" class="hidden space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
              <div>
                <label for="input-plate-w" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Width (mm)</label>
                <input type="number" id="input-plate-w" value="500" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-plate-t" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Thickness (mm)</label>
                <input type="number" id="input-plate-t" value="10" min="0.5" step="0.5" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-plate-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Length (m)</label>
                <input type="number" id="input-plate-len" value="1" min="0.1" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-plate-qty" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quantity (Pieces)</label>
                <input type="number" id="input-plate-qty" value="1" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
            </div>
          </div>

          <!-- E. STEEL PIPE INPUTS -->
          <div id="inputs-pipe" class="hidden space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
              <div>
                <label for="input-pipe-od" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Outer Diameter OD (mm)</label>
                <input type="number" id="input-pipe-od" value="114.3" min="1" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-pipe-t" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Wall Thickness (mm)</label>
                <input type="number" id="input-pipe-t" value="4.5" min="0.5" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-pipe-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Length (m)</label>
                <input type="number" id="input-pipe-len" value="6" min="0.1" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-pipe-qty" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quantity (Pieces)</label>
                <input type="number" id="input-pipe-qty" value="1" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
            </div>
          </div>

          <!-- F. HOLLOW BOX SHS/RHS INPUTS -->
          <div id="inputs-hollow" class="hidden space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-5">
              <div>
                <label for="input-hollow-w" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Width (mm)</label>
                <input type="number" id="input-hollow-w" value="100" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div id="col-hollow-h">
                <label for="input-hollow-h" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Height (mm)</label>
                <input type="number" id="input-hollow-h" value="100" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-hollow-t" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Wall Thickness (mm)</label>
                <input type="number" id="input-hollow-t" value="5" min="0.5" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-hollow-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Length (m)</label>
                <input type="number" id="input-hollow-len" value="6" min="0.1" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-hollow-qty" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quantity (Pieces)</label>
                <input type="number" id="input-hollow-qty" value="1" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
            </div>
          </div>

          <!-- G. ANGLE INPUTS -->
          <div id="inputs-angle" class="hidden space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-5">
              <div>
                <label for="input-angle-l1" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Leg 1 Width (mm)</label>
                <input type="number" id="input-angle-l1" value="50" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-angle-l2" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Leg 2 Width (mm)</label>
                <input type="number" id="input-angle-l2" value="50" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-angle-t" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Thickness (mm)</label>
                <input type="number" id="input-angle-t" value="5" min="0.5" step="0.5" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
                <label for="input-angle-len" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Length (m)</label>
                <input type="number" id="input-angle-len" value="6" min="0.1" step="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div>
