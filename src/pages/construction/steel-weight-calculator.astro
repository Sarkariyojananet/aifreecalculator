    // Attach real-time input change listeners for dynamic SVG visual only
    const allInputs = [
      selectSteelType, selectMaterial, selectWastage, inputUnitPrice,
      selectRebarDia, inputRebarCustom, selectRebarMode, inputRebarQty,
      inputRoundDia, inputRoundLen, inputRoundQty,
      inputSquareSide, inputSquareLen, inputSquareQty,
