              <h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">
                <span class="text-sm sm:text-base">
                  {index + 1}. {faq.q}
                </span>
                <span class="ml-2 text-slate-400 transition-transform duration-200 group-open:rotate-180">
                  ▼
                </span>
              </h3>
            </summary>
            <p class="mt-2.5 text-slate-600 dark:text-slate-300 leading-relaxed">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </Fragment>

  <!-- FAQPage & WebApplication JSON-LD Schema -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebApplication",
          name: "Steel Weight Calculator",
          url: "https://aifreecalculator.com/construction/steel-weight-calculator/",
          applicationCategory: "ConstructionApplication",
          operatingSystem: "All",
          description:
            "Free steel weight calculator in kg and tonnes. Calculate rebar weight (D²/162), round bars, steel plates, pipes, hollow sections, structural steel, and stainless steel.",
        },
        {
          "@type": "FAQPage",
          mainEntity: faqs.map((faq) => ({
            "@type": "Question",
            name: faq.q,
            acceptedAnswer: {
              "@type": "Answer",
              text: faq.a,
            },
          })),
        },
      ],
    })}
  />

  <!-- CLIENT-SIDE SCRIPT LOGIC -->
  <script>
    // DOM Elements
    const selectSteelType = document.getElementById('select-steel-type') as HTMLSelectElement;
    const selectMaterial = document.getElementById('select-material') as HTMLSelectElement;
    const materialSelectorCol = document.getElementById('material-selector-col')!;

    // Input Containers
    const inputsRebar = document.getElementById('inputs-rebar')!;
    const inputsRound = document.getElementById('inputs-round')!;
    const inputsSquare = document.getElementById('inputs-square')!;
    const inputsPlate = document.getElementById('inputs-plate')!;
    const inputsPipe = document.getElementById('inputs-pipe')!;
    const inputsHollow = document.getElementById('inputs-hollow')!;
    const inputsAngle = document.getElementById('inputs-angle')!;
    const inputsBeamChannel = document.getElementById('inputs-beam-channel')!;

    // Input Fields
    const selectRebarDia = document.getElementById('select-rebar-dia') as HTMLSelectElement;
    const inputRebarCustom = document.getElementById('input-rebar-custom') as HTMLInputElement;
    const selectRebarMode = document.getElementById('select-rebar-mode') as HTMLSelectElement;
    const inputRebarQty = document.getElementById('input-rebar-qty') as HTMLInputElement;
    const lblRebarQty = document.getElementById('lbl-rebar-qty')!;

    const inputRoundDia = document.getElementById('input-round-dia') as HTMLInputElement;
    const inputRoundLen = document.getElementById('input-round-len') as HTMLInputElement;
    const inputRoundQty = document.getElementById('input-round-qty') as HTMLInputElement;

    const inputSquareSide = document.getElementById('input-square-side') as HTMLInputElement;
    const inputSquareLen = document.getElementById('input-square-len') as HTMLInputElement;
    const inputSquareQty = document.getElementById('input-square-qty') as HTMLInputElement;

    const inputPlateW = document.getElementById('input-plate-w') as HTMLInputElement;
    const inputPlateT = document.getElementById('input-plate-t') as HTMLInputElement;
    const inputPlateLen = document.getElementById('input-plate-len') as HTMLInputElement;
    const inputPlateQty = document.getElementById('input-plate-qty') as HTMLInputElement;

    const inputPipeOd = document.getElementById('input-pipe-od') as HTMLInputElement;
    const inputPipeT = document.getElementById('input-pipe-t') as HTMLInputElement;
    const inputPipeLen = document.getElementById('input-pipe-len') as HTMLInputElement;
    const inputPipeQty = document.getElementById('input-pipe-qty') as HTMLInputElement;

    const inputHollowW = document.getElementById('input-hollow-w') as HTMLInputElement;
    const inputHollowH = document.getElementById('input-hollow-h') as HTMLInputElement;
    const inputHollowT = document.getElementById('input-hollow-t') as HTMLInputElement;
    const inputHollowLen = document.getElementById('input-hollow-len') as HTMLInputElement;
    const inputHollowQty = document.getElementById('input-hollow-qty') as HTMLInputElement;

    const inputAngleL1 = document.getElementById('input-angle-l1') as HTMLInputElement;
    const inputAngleL2 = document.getElementById('input-angle-l2') as HTMLInputElement;
    const inputAngleT = document.getElementById('input-angle-t') as HTMLInputElement;
    const inputAngleLen = document.getElementById('input-angle-len') as HTMLInputElement;
    const inputAngleQty = document.getElementById('input-angle-qty') as HTMLInputElement;

    const inputBeamH = document.getElementById('input-beam-h') as HTMLInputElement;
    const inputBeamB = document.getElementById('input-beam-b') as HTMLInputElement;
    const inputBeamTw = document.getElementById('input-beam-tw') as HTMLInputElement;
    const inputBeamTf = document.getElementById('input-beam-tf') as HTMLInputElement;
    const inputBeamLen = document.getElementById('input-beam-len') as HTMLInputElement;
    const inputBeamQty = document.getElementById('input-beam-qty') as HTMLInputElement;

    // Buttons & alerts
    const btnCalcSteel = document.getElementById('btn-calc-steel') as HTMLButtonElement;
    const btnClearSteel = document.getElementById('btn-clear-steel') as HTMLButtonElement;
    const btnDownloadPdf = document.getElementById('btn-download-pdf') as HTMLButtonElement;
    const errSteel = document.getElementById('err-steel')!;

    let lastResultData: any = null;

    // Results displays
    const resultsPlaceholder = document.getElementById('results-placeholder')!;
    const resultsCard = document.getElementById('results-card')!;
    const resTotalWtKg = document.getElementById('res-total-wt-kg')!;
    const resTotalWtOther = document.getElementById('res-total-wt-other')!;
    const resMatInfo = document.getElementById('res-mat-info')!;

    const resRebarGrid = document.getElementById('res-rebar-grid')!;
    const resRebarUnitWt = document.getElementById('res-rebar-unit-wt')!;
    const resRebarWt12m = document.getElementById('res-rebar-wt-12m')!;
    const resRebarTotalLen = document.getElementById('res-rebar-total-len')!;
    const resRebarBarsTon = document.getElementById('res-rebar-bars-ton')!;

    const resStructuralGrid = document.getElementById('res-structural-grid')!;
    const resStructArea = document.getElementById('res-struct-area')!;
    const resStructWtM = document.getElementById('res-struct-wt-m')!;
    const resStructWtPiece = document.getElementById('res-struct-wt-piece')!;
    const resStructTotalQty = document.getElementById('res-struct-total-qty')!;

    const resStepsContent = document.getElementById('res-steps-content')!;

    // Material densities map
    const densities: Record<string, { name: string; d: number }> = {
      mild_steel: { name: 'Mild Steel / Carbon Steel', d: 7850 },
      ss_304: { name: 'Stainless Steel 304', d: 7930 },
      ss_316: { name: 'Stainless Steel 316', d: 8000 },
      generic_ss: { name: 'Generic Stainless Steel', d: 7900 },
      cast_iron: { name: 'Cast Iron', d: 7200 },
      aluminium: { name: 'Aluminium 6061', d: 2700 },
    };

    // Switch Shape Visibility
    function updateShapeForm() {
      const type = selectSteelType.value;

      // Hide all containers
      [inputsRebar, inputsRound, inputsSquare, inputsPlate, inputsPipe, inputsHollow, inputsAngle, inputsBeamChannel].forEach((el) => el.classList.add('hidden'));

      if (type === 'rebar') {
        inputsRebar.classList.remove('hidden');
        materialSelectorCol.classList.add('hidden');
      } else {
        materialSelectorCol.classList.remove('hidden');

        if (type === 'round_bar' || type === 'ss_round') {
          inputsRound.classList.remove('hidden');
          if (type === 'ss_round') selectMaterial.value = 'ss_304';
        } else if (type === 'square_bar') {
          inputsSquare.classList.remove('hidden');
        } else if (type === 'plate' || type === 'ss_plate') {
          inputsPlate.classList.remove('hidden');
          if (type === 'ss_plate') selectMaterial.value = 'ss_304';
        } else if (type === 'pipe' || type === 'ss_pipe') {
          inputsPipe.classList.remove('hidden');
          if (type === 'ss_pipe') selectMaterial.value = 'ss_304';
        } else if (type === 'shs' || type === 'rhs') {
          inputsHollow.classList.remove('hidden');
          const colH = document.getElementById('col-hollow-h');
          if (colH) {
            if (type === 'shs') {
              colH.classList.add('hidden');
            } else {
              colH.classList.remove('hidden');
            }
          }
        } else if (type === 'angle') {
          inputsAngle.classList.remove('hidden');
        } else if (type === 'channel' || type === 'beam') {
          inputsBeamChannel.classList.remove('hidden');
        }
      }
    }

    selectSteelType.addEventListener('change', updateShapeForm);

    selectRebarDia.addEventListener('change', () => {
      if (selectRebarDia.value === 'custom') {
        inputRebarCustom.classList.remove('hidden');
      } else {
        inputRebarCustom.classList.add('hidden');
      }
    });

    selectRebarMode.addEventListener('change', () => {
      const m = selectRebarMode.value;
      if (m === 'bars') {
        lblRebarQty.textContent = 'Quantity (Number of 12m Bars)';
      } else if (m === 'length') {
        lblRebarQty.textContent = 'Total Length (Meters)';
      } else {
        lblRebarQty.textContent = 'Target Weight (Kilograms)';
      }
    });

    function executeCalculation() {
      const type = selectSteelType.value;
      const matKey = selectMaterial.value;
      const mat = densities[matKey] || densities.mild_steel;

      errSteel.classList.add('hidden');

      if (type === 'rebar') {
        let d = selectRebarDia.value === 'custom' ? parseFloat(inputRebarCustom.value) : parseFloat(selectRebarDia.value);
        const mode = selectRebarMode.value;
        const q = parseFloat(inputRebarQty.value);

        if (isNaN(d) || d <= 0) {
          errSteel.textContent = 'Please enter a valid rebar diameter greater than zero.';
          errSteel.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          return;
        }

        if (isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter a valid positive quantity.';
          errSteel.classList.remove('hidden');
          resultsCard.classList.add('hidden');
          resultsPlaceholder.classList.remove('hidden');
          return;
        }

        const unitWt = (d * d) / 162.28;
        const wt12m = unitWt * 12;
        const barsPerTon = Math.floor(1000 / wt12m);

        let totalWt = 0;
        let totalBars = 0;
        let totalLen = 0;

        if (mode === 'bars') {
          totalBars = q;
          totalLen = q * 12;
          totalWt = totalLen * unitWt;
        } else if (mode === 'length') {
          totalLen = q;
          totalBars = q / 12;
          totalWt = q * unitWt;
        } else {
          totalWt = q;
          totalLen = unitWt > 0 ? q / unitWt : 0;
          totalBars = totalLen / 12;
        }

        // Populate Result
        resTotalWtKg.textContent = `${totalWt.toFixed(1)} kg`;
        resTotalWtOther.textContent = `(${(totalWt / 1000).toFixed(3)} MT | ${(totalWt / 100).toFixed(2)} Quintals)`;
        resMatInfo.textContent = `TMT Rebar (Fe 500 / Fe 550, 7850 kg/m³)`;

        resRebarGrid.classList.remove('hidden');
        resStructuralGrid.classList.add('hidden');

        resRebarUnitWt.textContent = `${unitWt.toFixed(3)} kg/m`;
        resRebarWt12m.textContent = `${wt12m.toFixed(2)} kg`;
        resRebarTotalLen.textContent = `${totalLen.toFixed(1)} m`;
        resRebarBarsTon.textContent = `${barsPerTon} Bars`;

        resStepsContent.innerHTML = `
          <div class="text-blue-600 dark:text-blue-400 font-bold">• Rebar Diameter: ${d} mm | Input Mode: ${mode} (${q})</div>
          <div>• Unit Weight per Meter = D² ÷ 162.28 = ${d}² ÷ 162.28 = ${unitWt.toFixed(4)} kg/m</div>
          <div>• Weight of 1 Commercial 12m Bar = ${unitWt.toFixed(4)} kg/m × 12 m = ${wt12m.toFixed(2)} kg</div>
          <div>• Total Length = ${totalLen.toFixed(2)} meters (~${totalBars.toFixed(1)} bars of 12m)</div>
          <div class="font-bold text-slate-900 dark:text-white pt-1">👉 Total Steel Weight = ${totalLen.toFixed(2)} m × ${unitWt.toFixed(4)} kg/m = ${totalWt.toFixed(2)} kg (${(totalWt / 1000).toFixed(3)} Metric Tonnes)</div>
        `;

        lastResultData = {
          isRebar: true,
          shapeLabel: `TMT Rebar (Ø${d} mm)`,
          matName: 'TMT High-Yield Steel (Fe 500 / 550)',
          matDensity: 7850,
          diameter: d,
          unitWtKgM: unitWt,
          wt12mBarKg: wt12m,
          barsPerTon,
          totalLengthM: totalLen,
          totalBars,
          totalWtKg: totalWt,
          totalWtMT: totalWt / 1000,
          totalWtQuintals: totalWt / 100,
          paramRows: [
            ['Steel Type', 'TMT Deformed Rebar'],
            ['Nominal Diameter', `${d} mm`],
            ['Input Mode & Quantity', `${mode} (${q})`],
            ['Unit Weight per Meter (D²/162.28)', `${unitWt.toFixed(4)} kg/m`],
            ['Weight of 1 Commercial Bar (12m)', `${wt12m.toFixed(2)} kg`],
            ['Total Linear Meters', `${totalLen.toFixed(2)} m`],
            ['Estimated Commercial Bars (12m)', `${totalBars.toFixed(1)} Nos`],
            ['Bars per Metric Ton (1000kg)', `${barsPerTon} Nos`],
          ],
          stepDetails: [
            `• Rebar Diameter: ${d} mm | Input Mode: ${mode} (${q})`,
            `• Unit Weight per Meter = D² ÷ 162.28 = ${d}² ÷ 162.28 = ${unitWt.toFixed(4)} kg/m`,
            `• Weight of 1 Commercial 12m Bar = ${unitWt.toFixed(4)} kg/m × 12 m = ${wt12m.toFixed(2)} kg`,
            `• Total Length = ${totalLen.toFixed(2)} meters (~${totalBars.toFixed(1)} bars of 12m)`,
            `• Total Steel Weight = ${totalLen.toFixed(2)} m × ${unitWt.toFixed(4)} kg/m = ${totalWt.toFixed(2)} kg (${(totalWt / 1000).toFixed(3)} MT)`,
          ],
        };
      } else {
        // Structural Steel / Shapes Calculation
        let areaMm2 = 0;
        let lenM = 0;
        let qty = 1;
        let shapeLabel = '';
        let stepFormula = '';

        if (type === 'round_bar' || type === 'ss_round') {
          const dia = parseFloat(inputRoundDia.value);
          lenM = parseFloat(inputRoundLen.value);
          qty = parseFloat(inputRoundQty.value) || 1;
          if (isNaN(dia) || dia <= 0 || isNaN(lenM) || lenM <= 0) {
            errSteel.textContent = 'Please enter valid diameter and length greater than zero.';
            errSteel.classList.remove('hidden');
            resultsCard.classList.add('hidden');
            resultsPlaceholder.classList.remove('hidden');
            return;
          }
          areaMm2 = Math.PI * Math.pow(dia / 2, 2);
          shapeLabel = `Round Bar (Ø${dia} mm)`;
          stepFormula = `Area = π × (${dia}/2)² = ${areaMm2.toFixed(2)} mm²`;
        } else if (type === 'square_bar') {
          const side = parseFloat(inputSquareSide.value);
          lenM = parseFloat(inputSquareLen.value);
          qty = parseFloat(inputSquareQty.value) || 1;
          if (isNaN(side) || side <= 0 || isNaN(lenM) || lenM <= 0) {
            errSteel.textContent = 'Please enter valid side width and length.';
            errSteel.classList.remove('hidden');
            resultsCard.classList.add('hidden');
            resultsPlaceholder.classList.remove('hidden');
            return;
          }
          areaMm2 = side * side;
          shapeLabel = `Square Bar (${side} × ${side} mm)`;
          stepFormula = `Area = ${side} × ${side} = ${areaMm2.toFixed(2)} mm²`;
        } else if (type === 'plate' || type === 'ss_plate') {
          const w = parseFloat(inputPlateW.value);
          const t = parseFloat(inputPlateT.value);
          lenM = parseFloat(inputPlateLen.value);
          qty = parseFloat(inputPlateQty.value) || 1;
          if (isNaN(w) || w <= 0 || isNaN(t) || t <= 0 || isNaN(lenM) || lenM <= 0) {
            errSteel.textContent = 'Please enter valid width, thickness, and length.';
            errSteel.classList.remove('hidden');
            resultsCard.classList.add('hidden');
            resultsPlaceholder.classList.remove('hidden');
            return;
          }
          areaMm2 = w * t;
          shapeLabel = `Plate / Sheet (${w} × ${t} mm)`;
          stepFormula = `Area = Width (${w}) × Thickness (${t}) = ${areaMm2.toFixed(2)} mm²`;
        } else if (type === 'pipe' || type === 'ss_pipe') {
          const od = parseFloat(inputPipeOd.value);
          const t = parseFloat(inputPipeT.value);
          lenM = parseFloat(inputPipeLen.value);
          qty = parseFloat(inputPipeQty.value) || 1;
          if (isNaN(od) || od <= 0 || isNaN(t) || t <= 0 || t * 2 >= od || isNaN(lenM) || lenM <= 0) {
            errSteel.textContent = 'Outer diameter must be greater than twice the wall thickness.';
            errSteel.classList.remove('hidden');
            resultsCard.classList.add('hidden');
            resultsPlaceholder.classList.remove('hidden');
            return;
          }
          areaMm2 = Math.PI * (od - t) * t;
          shapeLabel = `Steel Pipe (OD ${od} mm, Wall ${t} mm)`;
          stepFormula = `Area = π × (OD - T) × T = π × (${od} - ${t}) × ${t} = ${areaMm2.toFixed(2)} mm²`;
        } else if (type === 'shs' || type === 'rhs') {
          const w = parseFloat(inputHollowW.value);
          const h = type === 'shs' ? w : parseFloat(inputHollowH.value);
          const t = parseFloat(inputHollowT.value);
          lenM = parseFloat(inputHollowLen.value);
          qty = parseFloat(inputHollowQty.value) || 1;
          if (isNaN(w) || w <= 0 || isNaN(h) || h <= 0 || isNaN(t) || t <= 0 || t * 2 >= Math.min(w, h)) {
            errSteel.textContent = 'Outer dimensions must be greater than twice the wall thickness.';
            errSteel.classList.remove('hidden');
            resultsCard.classList.add('hidden');
            resultsPlaceholder.classList.remove('hidden');
            return;
          }
          areaMm2 = (w * h) - ((w - 2 * t) * (h - 2 * t));
          shapeLabel = type === 'shs' ? `SHS (${w}×${w}×${t} mm)` : `RHS (${w}×${h}×${t} mm)`;
          stepFormula = `Area = (${w}×${h}) - (${w - 2 * t}×${h - 2 * t}) = ${areaMm2.toFixed(2)} mm²`;
        } else if (type === 'angle') {
          const l1 = parseFloat(inputAngleL1.value);
          const l2 = parseFloat(inputAngleL2.value);
          const t = parseFloat(inputAngleT.value);
          lenM = parseFloat(inputAngleLen.value);
          qty = parseFloat(inputAngleQty.value) || 1;
          if (isNaN(l1) || l1 <= 0 || isNaN(l2) || l2 <= 0 || isNaN(t) || t <= 0 || t >= Math.min(l1, l2)) {
            errSteel.textContent = 'Leg dimensions must be greater than thickness.';
            errSteel.classList.remove('hidden');
            resultsCard.classList.add('hidden');
            resultsPlaceholder.classList.remove('hidden');
            return;
          }
          areaMm2 = t * (l1 + l2 - t);
          shapeLabel = `Angle (${l1} × ${l2} × ${t} mm)`;
          stepFormula = `Area = T × (L1 + L2 - T) = ${t} × (${l1} + ${l2} - ${t}) = ${areaMm2.toFixed(2)} mm²`;
        } else if (type === 'channel' || type === 'beam') {
          const h = parseFloat(inputBeamH.value);
          const b = parseFloat(inputBeamB.value);
          const tw = parseFloat(inputBeamTw.value);
          const tf = parseFloat(inputBeamTf.value);
          lenM = parseFloat(inputBeamLen.value);
          qty = parseFloat(inputBeamQty.value) || 1;
          if (isNaN(h) || h <= 0 || isNaN(b) || b <= 0 || isNaN(tw) || tw <= 0 || isNaN(tf) || tf <= 0) {
            errSteel.textContent = 'Please enter valid positive profile dimensions.';
            errSteel.classList.remove('hidden');
            resultsCard.classList.add('hidden');
            resultsPlaceholder.classList.remove('hidden');
            return;
          }
          if (type === 'channel') {
            areaMm2 = (h - 2 * tf) * tw + 2 * (b * tf);
            shapeLabel = `Channel (${h} × ${b} mm)`;
          } else {
            areaMm2 = 2 * (b * tf) + (h - 2 * tf) * tw;
            shapeLabel = `Beam (${h} × ${b} mm)`;
          }
          stepFormula = `Area = 2×(${b}×${tf}) + (${h} - 2×${tf})×${tw} = ${areaMm2.toFixed(2)} mm²`;
        }

        const areaM2 = areaMm2 / 1000000;
        const wtPerMeter = areaM2 * mat.d;
        const wtPerPiece = wtPerMeter * lenM;
        const totalWt = wtPerPiece * qty;

        resTotalWtKg.textContent = `${totalWt.toFixed(2)} kg`;
        resTotalWtOther.textContent = `(${(totalWt / 1000).toFixed(3)} MT | ${(totalWt / 100).toFixed(2)} Quintals)`;
        resMatInfo.textContent = `${mat.name} (${mat.d.toLocaleString()} kg/m³)`;

        resRebarGrid.classList.add('hidden');
        resStructuralGrid.classList.remove('hidden');

        resStructArea.textContent = `${areaMm2.toFixed(1)} mm² (${(areaMm2 / 100).toFixed(2)} cm²)`;
        resStructWtM.textContent = `${wtPerMeter.toFixed(3)} kg/m`;
        resStructWtPiece.textContent = `${wtPerPiece.toFixed(2)} kg`;
        resStructTotalQty.textContent = `${qty} Nos × ${lenM} m (${(qty * lenM).toFixed(1)} m total)`;

        resStepsContent.innerHTML = `
          <div class="text-blue-600 dark:text-blue-400 font-bold">• Profile: ${shapeLabel} | Material: ${mat.name} (${mat.d} kg/m³)</div>
          <div>• Cross-Sectional ${stepFormula}</div>
          <div>• Area in m² = ${areaMm2.toFixed(2)} ÷ 1,000,000 = ${areaM2.toFixed(6)} m²</div>
          <div>• Unit Weight per Meter = Area (m²) × Density = ${areaM2.toFixed(6)} × ${mat.d} = ${wtPerMeter.toFixed(3)} kg/m</div>
          <div>• Weight per Piece (${lenM} m) = ${wtPerMeter.toFixed(3)} kg/m × ${lenM} m = ${wtPerPiece.toFixed(2)} kg</div>
          <div class="font-bold text-slate-900 dark:text-white pt-1">👉 Total Weight (${qty} pcs) = ${wtPerPiece.toFixed(2)} kg × ${qty} = ${totalWt.toFixed(2)} kg (${(totalWt / 1000).toFixed(3)} MT)</div>
        `;

        lastResultData = {
          isRebar: false,
          shapeLabel,
          matName: mat.name,
          matDensity: mat.d,
          areaMm2,
          areaM2,
          lenM,
          qty,
          wtPerMeter,
          wtPerPiece,
          totalWtKg: totalWt,
          totalWtMT: totalWt / 1000,
          totalWtQuintals: totalWt / 100,
          paramRows: [
            ['Steel Profile / Shape', shapeLabel],
            ['Material Grade & Density', `${mat.name} (${mat.d.toLocaleString()} kg/m³)`],
            ['Cross-Sectional Area', `${areaMm2.toFixed(1)} mm² (${(areaMm2 / 100).toFixed(2)} cm²)`],
            ['Unit Weight per Meter', `${wtPerMeter.toFixed(3)} kg/m`],
            ['Unit Length per Piece', `${lenM} m`],
            ['Weight per Piece', `${wtPerPiece.toFixed(2)} kg`],
            ['Total Quantity', `${qty} Nos`],
            ['Total Linear Meters', `${(qty * lenM).toFixed(2)} m`],
          ],
          stepDetails: [
            `• Profile: ${shapeLabel} | Material: ${mat.name} (${mat.d} kg/m³)`,
            `• Cross-Sectional ${stepFormula}`,
            `• Area in m² = ${areaMm2.toFixed(2)} ÷ 1,000,000 = ${areaM2.toFixed(6)} m²`,
            `• Unit Weight per Meter = Area (m²) × Density = ${areaM2.toFixed(6)} × ${mat.d} = ${wtPerMeter.toFixed(3)} kg/m`,
            `• Weight per Piece (${lenM} m) = ${wtPerMeter.toFixed(3)} kg/m × ${lenM} m = ${wtPerPiece.toFixed(2)} kg`,
            `• Total Weight (${qty} pcs) = ${wtPerPiece.toFixed(2)} kg × ${qty} = ${totalWt.toFixed(2)} kg (${(totalWt / 1000).toFixed(3)} MT)`,
          ],
        };
      }

      resultsPlaceholder.classList.add('hidden');
      resultsCard.classList.remove('hidden');
    }

    btnCalcSteel.addEventListener('click', (e) => {
      e.preventDefault();
      executeCalculation();
    });

    document.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeCalculation();
        }
      });
    });

    // Preset Buttons
    document.querySelectorAll('.btn-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-type');
        if (!type) return;
        selectSteelType.value = type;
        updateShapeForm();

        if (type === 'rebar') {
          selectRebarDia.value = btn.getAttribute('data-dia') || '12';
          inputRebarCustom.classList.add('hidden');
          selectRebarMode.value = btn.getAttribute('data-mode') || 'bars';
          inputRebarQty.value = btn.getAttribute('data-qty') || '50';
        } else if (type === 'plate') {
          selectMaterial.value = btn.getAttribute('data-mat') || 'mild_steel';
          inputPlateW.value = btn.getAttribute('data-w') || '500';
          inputPlateT.value = btn.getAttribute('data-t') || '10';
          inputPlateLen.value = btn.getAttribute('data-l') || '1';
          inputPlateQty.value = btn.getAttribute('data-qty') || '1';
        } else if (type === 'pipe') {
          selectMaterial.value = btn.getAttribute('data-mat') || 'mild_steel';
          inputPipeOd.value = btn.getAttribute('data-od') || '114.3';
          inputPipeT.value = btn.getAttribute('data-t') || '4.5';
          inputPipeLen.value = btn.getAttribute('data-l') || '6';
          inputPipeQty.value = btn.getAttribute('data-qty') || '1';
        } else if (type === 'shs') {
          selectMaterial.value = btn.getAttribute('data-mat') || 'mild_steel';
          inputHollowW.value = btn.getAttribute('data-w') || '100';
          inputHollowH.value = btn.getAttribute('data-w') || '100';
          inputHollowT.value = btn.getAttribute('data-t') || '5';
          inputHollowLen.value = btn.getAttribute('data-l') || '6';
          inputHollowQty.value = btn.getAttribute('data-qty') || '1';
        } else if (type === 'round_bar') {
          selectMaterial.value = btn.getAttribute('data-mat') || 'mild_steel';
          inputRoundDia.value = btn.getAttribute('data-dia') || '25';
          inputRoundLen.value = btn.getAttribute('data-l') || '3';
          inputRoundQty.value = btn.getAttribute('data-qty') || '1';
        }

        executeCalculation();
      });
    });

    // Clear Button
    btnClearSteel.addEventListener('click', () => {
      selectSteelType.value = 'rebar';
      selectMaterial.value = 'mild_steel';
      selectRebarDia.value = '12';
      inputRebarCustom.classList.add('hidden');
      selectRebarMode.value = 'bars';
      inputRebarQty.value = '50';
      lblRebarQty.textContent = 'Quantity (Number of 12m Bars)';

      inputRoundDia.value = '25';
      inputRoundLen.value = '3';
      inputRoundQty.value = '1';

      inputSquareSide.value = '20';
      inputSquareLen.value = '3';
      inputSquareQty.value = '1';

      inputPlateW.value = '500';
      inputPlateT.value = '10';
      inputPlateLen.value = '1';
      inputPlateQty.value = '1';

      inputPipeOd.value = '114.3';
      inputPipeT.value = '4.5';
      inputPipeLen.value = '6';
      inputPipeQty.value = '1';

      inputHollowW.value = '100';
      inputHollowH.value = '100';
      inputHollowT.value = '5';
      inputHollowLen.value = '6';
      inputHollowQty.value = '1';

      inputAngleL1.value = '50';
      inputAngleL2.value = '50';
      inputAngleT.value = '5';
      inputAngleLen.value = '6';
      inputAngleQty.value = '1';

      inputBeamH.value = '150';
      inputBeamB.value = '75';
      inputBeamTw.value = '5';
      inputBeamTf.value = '8';
      inputBeamLen.value = '6';
      inputBeamQty.value = '1';

      updateShapeForm();
      errSteel.classList.add('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      lastResultData = null;
    });

    // Enter Key Handler
    document.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeCalculation();
        }
      });
    });

    // PDF Export Generation
    if (btnDownloadPdf) {
      btnDownloadPdf.addEventListener('click', async () => {
        if (!lastResultData) return;

        const txtBtn = document.getElementById('txt-btn-pdf');
        if (txtBtn) txtBtn.textContent = 'Generating PDF...';

        try {
          let jsPDFModule = (window as any).jspdf;
          if (!jsPDFModule) {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
            await new Promise((resolve, reject) => {
              script.onload = resolve;
              script.onerror = reject;
              document.head.appendChild(script);
            });
            jsPDFModule = (window as any).jspdf;
          }

          const { jsPDF } = jsPDFModule;
          const doc = new jsPDF({ unit: 'pt', format: 'a4' });

          const primaryColor = [37, 99, 235]; // #2563eb
          const darkColor = [15, 23, 42]; // #0f172a
          const slateColor = [100, 116, 139]; // #64748b
          const lightBg = [248, 250, 252]; // #f8fafc

          const pageWidth = doc.internal.pageSize.getWidth();
          const pageHeight = doc.internal.pageSize.getHeight();
          const margin = 40;
          let y = 45;

          // Top Header Branding
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(18);
          doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
          doc.text('AIFreecalculator.com', margin, y);

          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9);
          doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
          doc.text('Free Online Calculator Tools', margin, y + 13);

          const now = new Date();
          const dateStr = now.toISOString().split('T')[0];
          doc.text(`Generated: ${dateStr}`, pageWidth - margin, y + 5, { align: 'right' });

          y += 28;
          doc.setDrawColor(226, 232, 240);
          doc.line(margin, y, pageWidth - margin, y);
          y += 24;

          // Document Title
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(15);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text(`Steel Weight Calculation Report`, margin, y);
          y += 18;

          // Summary Card Box
          doc.setFillColor(lightBg[0], lightBg[1], lightBg[2]);
          doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, 'F');
          doc.setDrawColor(203, 213, 225);
          doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, 'D');

          doc.setFont('helvetica', 'bold');
          doc.setFontSize(10);
          doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
          doc.text(lastResultData.shapeLabel.toUpperCase(), margin + 14, y + 18);

          doc.setFontSize(15);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text(`${lastResultData.totalWtKg.toFixed(2)} kg  (${lastResultData.totalWtMT.toFixed(3)} Metric Tonnes)`, margin + 14, y + 37);

          y += 72;

          // Parameters Table
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(11);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text('Profile Specifications & Parameters', margin, y);
          y += 14;

          lastResultData.paramRows.forEach(([label, val]: [string, string], idx: number) => {
            const rowY = y + idx * 20;
            doc.setFillColor(idx % 2 === 0 ? 255 : 248, idx % 2 === 0 ? 255 : 250, idx % 2 === 0 ? 255 : 252);
            doc.rect(margin, rowY - 11, pageWidth - margin * 2, 20, 'F');
            doc.setDrawColor(241, 245, 249);
            doc.line(margin, rowY + 9, pageWidth - margin * 2, rowY + 9);

            doc.setFont('helvetica', 'bold');
            doc.setFontSize(8.5);
            doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
            doc.text(label, margin + 8, rowY + 2);

            doc.setFont('helvetica', 'normal');
            doc.text(val, pageWidth - margin - 8, rowY + 2, { align: 'right' });
          });

          y += lastResultData.paramRows.length * 20 + 20;

          // Worked Equations Section
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(11);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text('Worked Calculation Steps', margin, y);
          y += 14;

          lastResultData.stepDetails.forEach((step: string, idx: number) => {
            const rowY = y + idx * 18;
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(8.5);
            doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
            doc.text(step, margin + 8, rowY + 2);
          });

          // Footers on every page
          const totalPages = (doc.internal as any).getNumberOfPages();
          for (let i = 1; i <= totalPages; i++) {
            doc.setPage(i);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(8);
            doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
            doc.text('Generated using AIFreecalculator.com', margin, pageHeight - 20);
            doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, pageHeight - 20, { align: 'right' });
          }

          const fileName = `steel-weight-${dateStr}.pdf`;
          doc.save(fileName);
        } catch (e) {
          console.error('PDF generation error:', e);
        } finally {
          if (txtBtn) txtBtn.textContent = 'Download PDF';
        }
      });
    }

    // Init
    updateShapeForm();
  </script>
</CalculatorLayout>
