    // ---------------------------------------------------------------------------
    // CORE CALCULATION ENGINE EXECUTION (ON BUTTON CLICK ONLY)
    // ---------------------------------------------------------------------------
    function executeCalculation() {
      errSteel.classList.add('hidden');
      staleWarning.classList.add('hidden');
      resultsCard.classList.remove('opacity-80');

      const shapeType = selectSteelType.value;
      const matKey = selectMaterial.value;
      const wastagePercent = parseFloat(selectWastage.value) || 0;
      const pricePerUnit = parseFloat(inputUnitPrice.value) || 0;

      let calcInput: any = {
        shapeType: shapeType as any,
        materialKey: matKey,
        unitSystem: currentUnitSystem,
        wastagePercent,
        pricePerUnitWeight: pricePerUnit,
        currency: currentCurrency,
      };

      if (shapeType === 'rebar') {
        const d = selectRebarDia.value === 'custom' ? parseFloat(inputRebarCustom.value) : parseFloat(selectRebarDia.value);
        const mode = selectRebarMode.value;
        const q = parseFloat(inputRebarQty.value);

        if (isNaN(d) || d <= 0) {
          errSteel.textContent = 'Please enter a valid rebar diameter greater than zero.';
          errSteel.classList.remove('hidden');
          return;
        }
        if (isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter a valid positive quantity.';
          errSteel.classList.remove('hidden');
          return;
        }

        calcInput.diameter = d;
        calcInput.rebarMode = mode;
        calcInput.rebarQuantity = q;

      } else if (shapeType === 'round_bar' || shapeType === 'ss_round') {
        calcInput.shapeType = 'round_bar';
        const d = parseFloat(inputRoundDia.value);
        const len = parseFloat(inputRoundLen.value);
        const q = parseFloat(inputRoundQty.value);
        if (isNaN(d) || d <= 0 || isNaN(len) || len <= 0 || isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter valid positive dimensions, length, and quantity.';
          errSteel.classList.remove('hidden');
          return;
        }
        calcInput.diameter = d; calcInput.length = len; calcInput.quantity = q;

      } else if (shapeType === 'square_bar') {
        const s = parseFloat(inputSquareSide.value);
        const len = parseFloat(inputSquareLen.value);
        const q = parseFloat(inputSquareQty.value);
        if (isNaN(s) || s <= 0 || isNaN(len) || len <= 0 || isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter valid positive side width, length, and quantity.';
          errSteel.classList.remove('hidden');
          return;
        }
        calcInput.side = s; calcInput.length = len; calcInput.quantity = q;

      } else if (shapeType === 'hex_bar') {
        const s = parseFloat(inputHexSide.value);
        const len = parseFloat(inputHexLen.value);
        const q = parseFloat(inputHexQty.value);
        if (isNaN(s) || s <= 0 || isNaN(len) || len <= 0 || isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter valid across-flats dimension, length, and quantity.';
          errSteel.classList.remove('hidden');
          return;
        }
        calcInput.side = s; calcInput.length = len; calcInput.quantity = q;

      } else if (shapeType === 'plate' || shapeType === 'ss_plate') {
        calcInput.shapeType = 'plate';
        const w = parseFloat(inputPlateW.value);
        const t = parseFloat(inputPlateT.value);
        const len = parseFloat(inputPlateLen.value);
        const q = parseFloat(inputPlateQty.value);
        if (isNaN(w) || w <= 0 || isNaN(t) || t <= 0 || isNaN(len) || len <= 0 || isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter valid width, thickness, length, and quantity.';
          errSteel.classList.remove('hidden');
          return;
        }
        calcInput.width = w; calcInput.thickness = t; calcInput.length = len; calcInput.quantity = q;

      } else if (shapeType === 'pipe' || shapeType === 'ss_pipe') {
        calcInput.shapeType = 'pipe';
        const od = parseFloat(inputPipeOd.value);
        const t = parseFloat(inputPipeT.value);
        const len = parseFloat(inputPipeLen.value);
        const q = parseFloat(inputPipeQty.value);
        if (isNaN(od) || od <= 0 || isNaN(t) || t <= 0 || isNaN(len) || len <= 0 || isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter valid pipe outer diameter, thickness, and length.';
          errSteel.classList.remove('hidden');
          return;
        }
        if (t * 2 >= od) {
          errSteel.textContent = 'Pipe wall thickness cannot exceed half of the outer diameter.';
          errSteel.classList.remove('hidden');
          return;
        }
        calcInput.outerDiameter = od; calcInput.thickness = t; calcInput.length = len; calcInput.quantity = q;

      } else if (shapeType === 'shs' || shapeType === 'rhs') {
        const w = parseFloat(inputHollowW.value);
        const h = shapeType === 'shs' ? w : parseFloat(inputHollowH.value);
        const t = parseFloat(inputHollowT.value);
        const len = parseFloat(inputHollowLen.value);
        const q = parseFloat(inputHollowQty.value);
        if (isNaN(w) || w <= 0 || isNaN(h) || h <= 0 || isNaN(t) || t <= 0 || isNaN(len) || len <= 0 || isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter valid positive dimensions, thickness, and length.';
          errSteel.classList.remove('hidden');
          return;
        }
        if (t * 2 >= Math.min(w, h)) {
          errSteel.textContent = 'Wall thickness must be less than half the smaller outer dimension.';
          errSteel.classList.remove('hidden');
          return;
        }
        calcInput.width = w; calcInput.height = h; calcInput.thickness = t; calcInput.length = len; calcInput.quantity = q;

      } else if (shapeType === 'angle') {
        const l1 = parseFloat(inputAngleL1.value);
        const l2 = parseFloat(inputAngleL2.value);
        const t = parseFloat(inputAngleT.value);
        const len = parseFloat(inputAngleLen.value);
        const q = parseFloat(inputAngleQty.value);
        if (isNaN(l1) || l1 <= 0 || isNaN(l2) || l2 <= 0 || isNaN(t) || t <= 0 || isNaN(len) || len <= 0 || isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter valid positive angle leg widths, thickness, and length.';
          errSteel.classList.remove('hidden');
          return;
        }
        if (t >= Math.min(l1, l2)) {
          errSteel.textContent = 'Angle thickness must be less than both leg widths.';
          errSteel.classList.remove('hidden');
          return;
        }
        calcInput.leg1 = l1; calcInput.leg2 = l2; calcInput.thickness = t; calcInput.length = len; calcInput.quantity = q;

      } else if (shapeType === 'channel' || shapeType === 'beam') {
        const h = parseFloat(inputBeamH.value);
        const b = parseFloat(inputBeamB.value);
        const tw = parseFloat(inputBeamTw.value);
        const tf = parseFloat(inputBeamTf.value);
        const len = parseFloat(inputBeamLen.value);
        const q = parseFloat(inputBeamQty.value);
        if (isNaN(h) || h <= 0 || isNaN(b) || b <= 0 || isNaN(tw) || tw <= 0 || isNaN(tf) || tf <= 0 || isNaN(len) || len <= 0 || isNaN(q) || q <= 0) {
          errSteel.textContent = 'Please enter valid positive profile height, flange, web, and length.';
          errSteel.classList.remove('hidden');
          return;
        }
        if (tf * 2 >= h) {
          errSteel.textContent = 'Total flange thickness (2 × Tf) cannot exceed overall profile depth H.';
          errSteel.classList.remove('hidden');
          return;
        }
        calcInput.height = h; calcInput.flangeWidth = b; calcInput.webThickness = tw; calcInput.flangeThickness = tf; calcInput.length = len; calcInput.quantity = q;
      }

      // Execute Universal Calculation
      const res = calculateUniversalSteelWeight(calcInput);
      lastResultData = res;
      hasCalculated = true;

      // Populate Primary Results Card
      resTotalWtKg.textContent = `${res.totalWeightKg.toLocaleString()} kg`;
      resTotalWtOther.textContent = `(${res.totalWeightTonnes.toFixed(3)} MT | ${res.totalWeightQuintals.toFixed(2)} Quintals | ${res.totalWeightLb.toLocaleString()} lbs / ${res.totalWeightUSTons.toFixed(3)} US Tons)`;
      resMatInfo.textContent = `${res.materialName} (${res.materialDensityKgM3.toLocaleString()} kg/m³ / ${(res.materialDensityKgM3 * 0.062428).toFixed(1)} lb/ft³)`;

      // Specific metrics grid
      if (shapeType === 'rebar') {
        resRebarGrid.classList.remove('hidden');
        resStructuralGrid.classList.add('hidden');

        resRebarUnitWt.textContent = `${res.unitWeightKgM.toFixed(3)} kg/m (${res.unitWeightLbFt.toFixed(3)} lb/ft)`;
        resRebarWt12m.textContent = `${res.weightPerPieceKg.toFixed(2)} kg (${res.weightPerPieceLb.toFixed(2)} lb)`;
        resRebarTotalLen.textContent = `${res.totalLengthM.toFixed(1)} m (${res.totalLengthFt.toFixed(1)} ft)`;
        resRebarBarsTon.textContent = `${res.weightPerPieceKg > 0 ? Math.floor(1000 / res.weightPerPieceKg) : 0} Bars`;
      } else {
        resRebarGrid.classList.add('hidden');
        resStructuralGrid.classList.remove('hidden');

        resStructArea.textContent = `${res.areaMm2.toFixed(1)} mm² (${res.areaCm2.toFixed(2)} cm² / ${res.areaIn2.toFixed(3)} in²)`;
        resStructWtM.textContent = `${res.unitWeightKgM.toFixed(3)} kg/m (${res.unitWeightLbFt.toFixed(3)} lb/ft)`;
        resStructWtPiece.textContent = `${res.weightPerPieceKg.toFixed(2)} kg (${res.weightPerPieceLb.toFixed(2)} lb)`;
        resStructTotalQty.textContent = `${res.totalPieces} pcs × ${res.lengthM.toFixed(2)}m (${res.totalLengthM.toFixed(1)}m total)`;
      }

      // Takeoff & Commercial Summary
      resTakeoff12m.textContent = `${res.standard12mBars} Bars`;
      resTakeoffBundles.textContent = `${res.bundleCount} Bundles (${res.barsPerBundle} bars/bdl)`;
      resTakeoffWastage.textContent = `${res.wastageWeightKg.toFixed(1)} kg (${res.wastageWeightLb.toFixed(1)} lb)`;
      resCostGrandTotal.textContent = `${res.currencySymbol} ${res.totalCost.toLocaleString()}`;

      // Cost Breakdown Table
      const curUnit = currentUnitSystem === 'metric' ? 'kg' : 'lb';
      resCostBaseQty.textContent = currentUnitSystem === 'metric' ? `${res.baseWeightKg.toFixed(1)} kg` : `${res.baseWeightLb.toFixed(1)} lb`;
      resCostBaseRate.textContent = `${res.currencySymbol} ${res.pricePerUnit} / ${curUnit}`;
      resCostBaseAmt.textContent = `${res.currencySymbol} ${res.baseCost.toLocaleString()}`;

      resCostWasteQty.textContent = currentUnitSystem === 'metric' ? `${res.wastageWeightKg.toFixed(1)} kg` : `${res.wastageWeightLb.toFixed(1)} lb`;
      resCostWasteRate.textContent = `${res.currencySymbol} ${res.pricePerUnit} / ${curUnit}`;
      resCostWasteAmt.textContent = `${res.currencySymbol} ${res.wastageCost.toLocaleString()}`;

      resCostTotalQty.textContent = currentUnitSystem === 'metric' ? `${res.totalWeightKg.toFixed(1)} kg` : `${res.totalWeightLb.toFixed(1)} lb`;
      resCostFinalAmt.textContent = `${res.currencySymbol} ${res.totalCost.toLocaleString()}`;

      // Worked Equations Content
      let stepsHtml = `<div class="text-blue-600 dark:text-blue-400 font-bold">• Profile: ${res.shapeName} | Material: ${res.materialName}</div>`;
      res.workedSteps.forEach(step => {
        stepsHtml += `<div>${step}</div>`;
      });
      resStepsContent.innerHTML = stepsHtml;

      resultsPlaceholder.classList.add('hidden');
      resultsCard.classList.remove('hidden');
      resultsCard.scrollIntoView({ behavior: 'smooth', block: 'start' });

      try {
        document.dispatchEvent(new CustomEvent('calculator:updated'));
      } catch (e) {}
    }

    btnCalcSteel.addEventListener('click', (e) => {
      e.preventDefault();
      executeCalculation();
    });

    document.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeCalculation();
        }
      });
    });

    // ---------------------------------------------------------------------------
    // PRESET BUTTONS HANDLER
    // ---------------------------------------------------------------------------
    document.querySelectorAll('.btn-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const u = btn.getAttribute('data-unit') || 'metric';
        setUnitSystem(u as any);

        const type = btn.getAttribute('data-type');
        if (!type) return;
        selectSteelType.value = type;
        updateShapeForm();

        if (type === 'rebar') {
          selectRebarDia.value = btn.getAttribute('data-dia') || '12';
          inputRebarCustom.classList.add('hidden');
          selectRebarMode.value = btn.getAttribute('data-mode') || 'bars';
          inputRebarQty.value = btn.getAttribute('data-qty') || '50';
        } else if (type === 'plate') {
          selectMaterial.value = btn.getAttribute('data-mat') || 'mild_steel';
          inputPlateW.value = btn.getAttribute('data-w') || '500';
          inputPlateT.value = btn.getAttribute('data-t') || '10';
          inputPlateLen.value = btn.getAttribute('data-l') || '1';
          inputPlateQty.value = btn.getAttribute('data-qty') || '1';
        } else if (type === 'pipe') {
          selectMaterial.value = btn.getAttribute('data-mat') || 'mild_steel';
          inputPipeOd.value = btn.getAttribute('data-od') || '114.3';
          inputPipeT.value = btn.getAttribute('data-t') || '4.5';
          inputPipeLen.value = btn.getAttribute('data-l') || '6';
          inputPipeQty.value = btn.getAttribute('data-qty') || '1';
        } else if (type === 'shs') {
          selectMaterial.value = btn.getAttribute('data-mat') || 'mild_steel';
          inputHollowW.value = btn.getAttribute('data-w') || '100';
          inputHollowH.value = btn.getAttribute('data-w') || '100';
          inputHollowT.value = btn.getAttribute('data-t') || '5';
          inputHollowLen.value = btn.getAttribute('data-l') || '6';
          inputHollowQty.value = btn.getAttribute('data-qty') || '1';
        } else if (type === 'round_bar') {
          selectMaterial.value = btn.getAttribute('data-mat') || 'mild_steel';
          inputRoundDia.value = btn.getAttribute('data-dia') || '25';
          inputRoundLen.value = btn.getAttribute('data-l') || '3';
          inputRoundQty.value = btn.getAttribute('data-qty') || '1';
        }

        executeCalculation();
      });
    });

    // ---------------------------------------------------------------------------
    // CLEAR / RESET BUTTON
    // ---------------------------------------------------------------------------
    btnClearSteel.addEventListener('click', () => {
      selectSteelType.value = 'rebar';
      selectMaterial.value = 'mild_steel';
      selectRebarDia.value = '12';
      inputRebarCustom.classList.add('hidden');
      selectRebarMode.value = 'bars';
      inputRebarQty.value = '50';
      lblRebarQty.textContent = 'Quantity (Number of Standard 12m Bars)';

      inputRoundDia.value = '25'; inputRoundLen.value = '3'; inputRoundQty.value = '1';
      inputSquareSide.value = '20'; inputSquareLen.value = '3'; inputSquareQty.value = '1';
      inputHexSide.value = '25'; inputHexLen.value = '3'; inputHexQty.value = '1';
      inputPlateW.value = '500'; inputPlateT.value = '10'; inputPlateLen.value = '1'; inputPlateQty.value = '1';
      inputPipeOd.value = '114.3'; inputPipeT.value = '4.5'; inputPipeLen.value = '6'; inputPipeQty.value = '1';
      inputHollowW.value = '100'; inputHollowH.value = '100'; inputHollowT.value = '5'; inputHollowLen.value = '6'; inputHollowQty.value = '1';
      inputAngleL1.value = '50'; inputAngleL2.value = '50'; inputAngleT.value = '5'; inputAngleLen.value = '6'; inputAngleQty.value = '1';
      inputBeamH.value = '150'; inputBeamB.value = '75'; inputBeamTw.value = '5'; inputBeamTf.value = '8'; inputBeamLen.value = '6'; inputBeamQty.value = '1';

      updateShapeForm();
      errSteel.classList.add('hidden');
      staleWarning.classList.add('hidden');
      resultsCard.classList.add('hidden');
      resultsPlaceholder.classList.remove('hidden');
      hasCalculated = false;
      lastResultData = null;
    });

    // ---------------------------------------------------------------------------
    // PDF EXPORT REPORT GENERATION
    // ---------------------------------------------------------------------------
    if (btnDownloadPdf) {
      btnDownloadPdf.addEventListener('click', async () => {
        if (!lastResultData) return;

        const txtBtn = document.getElementById('txt-btn-pdf');
        if (txtBtn) txtBtn.textContent = 'Generating PDF...';

        try {
          let jsPDFModule = (window as any).jspdf;
          if (!jsPDFModule) {
            const script1 = document.createElement('script');
            script1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
            await new Promise((resolve, reject) => {
              script1.onload = resolve;
              script1.onerror = reject;
              document.head.appendChild(script1);
            });
            const script2 = document.createElement('script');
            script2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            await new Promise((resolve, reject) => {
              script2.onload = resolve;
              script2.onerror = reject;
              document.head.appendChild(script2);
            });
            jsPDFModule = (window as any).jspdf;
          } else if (!(window as any).jspdf?.plugin?.autotable && !(window as any).autoTable) {
            const script2 = document.createElement('script');
            script2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            await new Promise((resolve, reject) => {
              script2.onload = resolve;
              script2.onerror = reject;
              document.head.appendChild(script2);
            });
          }

          const { jsPDF } = jsPDFModule;
          const doc = new jsPDF({ unit: 'pt', format: 'a4' });

          const primaryColor = [37, 99, 235]; // #2563eb
          const darkColor = [15, 23, 42]; // #0f172a
          const slateColor = [100, 116, 139]; // #64748b
          const lightBg = [248, 250, 252]; // #f8fafc

          const pageWidth = doc.internal.pageSize.getWidth();
          const pageHeight = doc.internal.pageSize.getHeight();
          const margin = 40;
          let y = 45;

          // Top Header Branding
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(18);
          doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
          doc.text('AIFreecalculator.com', margin, y);

          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9);
          doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
          doc.text('Free Online Civil Engineering & Construction Tools', margin, y + 13);

          const now = new Date();
          const dateStr = now.toISOString().split('T')[0];
          doc.text(`Generated: ${dateStr}`, pageWidth - margin, y + 5, { align: 'right' });

          y += 28;
          doc.setDrawColor(226, 232, 240);
          doc.line(margin, y, pageWidth - margin, y);
          y += 24;

          // Document Title
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(14);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text(`Steel Weight Calculation & Takeoff Report`, margin, y);
          y += 18;

          // Summary Card Box
          doc.setFillColor(lightBg[0], lightBg[1], lightBg[2]);
          doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, 'F');
          doc.setDrawColor(203, 213, 225);
          doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, 'D');

          doc.setFont('helvetica', 'bold');
          doc.setFontSize(10);
          doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
          doc.text(lastResultData.shapeName.toUpperCase(), margin + 14, y + 18);

          doc.setFontSize(15);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text(`${lastResultData.totalWeightKg.toFixed(2)} kg (${lastResultData.totalWeightTonnes.toFixed(3)} MT / ${lastResultData.totalWeightLb.toFixed(2)} lb)`, margin + 14, y + 37);

          y += 68;

          // Specifications Table
          const specRows = [
            ['Steel Profile / Shape', lastResultData.shapeName],
            ['Material & Density', `${lastResultData.materialName} (${lastResultData.materialDensityKgM3.toLocaleString()} kg/m³)`],
            ['Cross-Sectional Area', `${lastResultData.areaMm2.toFixed(1)} mm² (${lastResultData.areaCm2.toFixed(2)} cm² / ${lastResultData.areaIn2.toFixed(3)} in²)`],
            ['Unit Weight per Meter', `${lastResultData.unitWeightKgM.toFixed(3)} kg/m (${lastResultData.unitWeightLbFt.toFixed(3)} lb/ft)`],
            ['Weight per Piece', `${lastResultData.weightPerPieceKg.toFixed(2)} kg (${lastResultData.weightPerPieceLb.toFixed(2)} lb)`],
            ['Total Linear Length', `${lastResultData.totalLengthM.toFixed(2)} m (${lastResultData.totalLengthFt.toFixed(1)} ft)`],
            ['Standard 12m (40ft) Commercial Rods', `${lastResultData.standard12mBars} Bars (~${lastResultData.bundleCount} bundles)`],
            ['Estimated Total Cost', `${lastResultData.currencySymbol} ${lastResultData.totalCost.toLocaleString()}`],
          ];

          (doc as any).autoTable({
            startY: y,
            head: [['Specification Parameter', 'Calculated Value']],
            body: specRows.map(([label, val]: string[]) => [
              String(label).replace(/[³²×÷₹]/g, (m) => m === '³' ? '^3' : m === '²' ? '^2' : m === '×' ? 'x' : m === '₹' ? 'Rs.' : '/'),
              String(val).replace(/[³²×÷₹]/g, (m) => m === '³' ? ' m3' : m === '²' ? ' m2' : m === '×' ? ' x ' : m === '₹' ? 'Rs.' : '/')
            ]),
            theme: 'striped',
            headStyles: { fillColor: [37, 99, 235], textColor: 255, fontStyle: 'bold', fontSize: 9 },
            columnStyles: {
              0: { cellWidth: 220, fontStyle: 'bold' },
              1: { cellWidth: 'auto' },
            },
            margin: { left: margin, right: margin, top: 40, bottom: 40 },
            styles: { fontSize: 8.5, cellPadding: 4.5, overflow: 'linebreak' },
            pageBreak: 'auto',
          });

          y = (doc as any).lastAutoTable.finalY + 16;

          // Worked Steps Table
          (doc as any).autoTable({
            startY: y,
            head: [['Step', 'Worked Calculation Formula & Method']],
            body: lastResultData.workedSteps.map((step: string, idx: number) => [
              `#${idx + 1}`,
              String(step).replace(/[³²×÷₹]/g, (m) => m === '³' ? '^3' : m === '²' ? '^2' : m === '×' ? ' x ' : m === '₹' ? 'Rs.' : '/')
            ]),
            theme: 'striped',
            headStyles: { fillColor: [15, 23, 42], textColor: 255, fontStyle: 'bold', fontSize: 9 },
            columnStyles: {
              0: { cellWidth: 40, fontStyle: 'bold', halign: 'center' },
              1: { cellWidth: 'auto' },
            },
            margin: { left: margin, right: margin, top: 40, bottom: 40 },
            styles: { fontSize: 8.5, cellPadding: 4.5, overflow: 'linebreak' },
            pageBreak: 'auto',
          });

          // Footers
          const totalPages = (doc.internal as any).getNumberOfPages();
          for (let i = 1; i <= totalPages; i++) {
            doc.setPage(i);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(8);
            doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
            doc.text('Generated using AIFreecalculator.com', margin, pageHeight - 20);
            doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, pageHeight - 20, { align: 'right' });
          }

          const fileName = `steel-weight-report-${dateStr}.pdf`;
          doc.save(fileName);
        } catch (e) {
          console.error('PDF generation error:', e);
        } finally {
          if (txtBtn) txtBtn.textContent = 'Download PDF Report';
        }
      });
    }

    // Initialize UI on page load
    updateShapeForm();
    drawVisualDiagrams();
  </script>
</CalculatorLayout>
