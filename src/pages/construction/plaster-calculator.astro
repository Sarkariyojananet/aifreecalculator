            <td class="p-3 font-semibold text-slate-900 dark:text-white">
              <div class="font-bold">Target Range</div>
              <div class="text-[11px] text-slate-500">2D Euclidean Distance</div>
            </td>
            <td class="p-3 font-bold text-amber-600 dark:text-amber-400">
              <div>${lastResultData.distM} meters</div>
              <div class="text-[11px] font-normal text-slate-500">${lastResultData.distKm} km</div>
            </td>
            <td class="p-3 text-slate-600 dark:text-slate-400 hidden sm:table-cell">${(parseFloat(lastResultData.distM) * 3.28084).toFixed(1)} ft</td>
            <td class="p-3 text-[11px] text-slate-500 dark:text-slate-400 font-mono">sqrt(\u0394x\u00B2 + \u0394y\u00B2)</td>
          </tr>
          <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/50 transition-colors">
