---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import {
  calculateWallPlaster,
  calculateGeneralMortar,
  calculateTileMortar,
  calculateGamingMortar,
} from '../../lib/calculators/plaster';

// Metadata and SEO schema definitions
const title = "Plaster & Mortar Calculator – Cement, Sand, Tile Mortar & Gaming Tools | AI Free Calculator";
const description = "Calculate plaster and mortar quantities, estimate cement and sand requirements, and use dedicated mortar tools for tile work and supported games.";
const keywords = [
  "plaster & mortar calculator",
  "arma reforger mortar calculator",
  "arma mortar calculator",
  "squad mortar calculator",
  "tile mortar calculator",
  "plaster material calculator",
  "cement and sand calculator",
  "mortar quantity estimator",
  "plaster volume calculation",
  "cement mortar mix",
  "wall plaster calculation",
  "floor mortar quantity",
  "tile adhesive estimator",
  "mortar range calculator",
  "mortar targeting calculator",
  "gaming artillery calculator",
  "construction calculator"
];

// 7 FAQs matching 1-to-1 with JSON-LD schema
const faqs = [
  {
    q: "What is a plaster and mortar calculator?",
    a: "A plaster and mortar calculator is a versatile engineering and estimation utility that computes the exact volumes of cement, sand, water, and dry mortar required for wall plastering, masonry joints, and tile beds. It also includes a dedicated gaming mode for artillery coordinate targeting in games like Arma Reforger, Arma 3, and Squad."
  },
  {
    q: "How do I calculate plaster quantity for a wall?",
    a: "First calculate the total wall area (Length × Height × Number of Walls) and deduct all door and window openings to find the Net Plaster Area. Next, multiply the net area by the plaster thickness to get the wet mortar volume. Multiply wet volume by a dry volume factor (typically 1.30 to 1.33) plus wastage (10%) to determine the required dry mortar volume, then divide according to your cement-to-sand ratio."
  },
  {
    q: "How are cement and sand quantities estimated?",
    a: "From the total dry mortar volume, materials are divided by the mix ratio parts (e.g., 1:4 mix has 1+4=5 parts). Cement volume is (Dry Volume × 1/5) × 1440 kg/m³ to get weight in kg and 50kg bags. Sand volume is (Dry Volume × 4/5) in cubic meters or multiplied by 35.3147 to convert to Cubic Feet (CFT)."
  },
  {
    q: "How does a tile mortar calculator work?",
    a: "The tile mortar calculator determines the total floor or wall area to be tiled and multiplies it by the manufacturer's recommended adhesive coverage rate (typically 4.0 to 6.0 kg/m² depending on tile format and trowel notch depth) plus a 10% allowance for cuts and wastage, providing the total weight and required bag count."
  },
  {
    q: "Can I include wastage in the calculation?",
    a: "Yes. Construction sites experience rebound loss, wall unevenness, joint filling, and handling waste. You can customize the wastage percentage (default is 10% for plaster and tile adhesive, adjustable to 15% or 20% for rough or exterior surfaces)."
  },
  {
    q: "Can I use this tool as an Arma Reforger or Squad mortar calculator?",
    a: "Yes. The Gaming Mortar Calculator mode is a completely separate utility designed for tactical military simulators. It calculates Euclidean distance, azimuth/bearing in degrees and NATO mils, and provides reference aiming elevation values for standard mortar tubes without mixing real-world construction math."
  },
  {
    q: "Can I download my calculation as a PDF?",
    a: "Yes. After clicking Calculate in any of the four modes (Wall Plaster, General Mortar, Tile Mortar, or Gaming Mortar), click the Download PDF button to export a professionally formatted report with AIFreecalculator.com header branding, complete parameter breakdowns, and Page X of Y footers."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<CalculatorLayout
  title={title}
  description={description}
  category="Construction"
  calculatorName="Plaster & Mortar Calculator"
  slug="plaster-calculator"
  keywords={keywords}
>
  <!-- Inject FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- SUBTITLE BELOW H1 -->
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed -mt-2">
      Calculate plaster and mortar quantities, estimate cement and sand requirements, and use dedicated mortar tools for tile work and supported games.
    </p>

    <!-- CALCULATOR MODE SELECTOR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Calculator Mode:
        </span>
        <span id="lbl-mode-badge" class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[10px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
          Construction Tool
        </span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-bold" id="mode-tabs-container">
        <button
          type="button"
          class="btn-pm-tab active rounded-xl border border-blue-600 bg-blue-50 py-2.5 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer flex items-center justify-center gap-1.5"
          data-mode="wall_plaster"
        >
          <span>🧱</span> Wall Plaster
        </button>
        <button
          type="button"
          class="btn-pm-tab rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer flex items-center justify-center gap-1.5"
          data-mode="general_mortar"
        >
          <span>📦</span> Mortar Quantity
        </button>
        <button
          type="button"
          class="btn-pm-tab rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer flex items-center justify-center gap-1.5"
          data-mode="tile_mortar"
        >
          <span>🔲</span> Tile Mortar
        </button>
        <button
          type="button"
          class="btn-pm-tab rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer flex items-center justify-center gap-1.5"
          data-mode="gaming_mortar"
        >
          <span>🎯</span> Gaming Mortar
        </button>
      </div>
    </div>

    <!-- MAIN FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <form id="form-plaster-mortar" novalidate onsubmit="return false;" class="space-y-5">
        
        <!-- ========================================================= -->
        <!-- 1. WALL PLASTER INPUTS (DEFAULT MODE) -->
        <!-- ========================================================= -->
        <div id="section-input-wall-plaster" class="space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200/80 pb-2 dark:border-slate-800">
            <h2 class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🧱</span> Wall Plaster Dimensions & Mix Ratio
            </h2>
            <div class="flex items-center gap-1.5 text-xs font-semibold">
              <label class="text-slate-500">Units:</label>
              <select id="inp-wp-unit" class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                <option value="metric" selected>Metric (Meters / mm)</option>
                <option value="imperial">Imperial (Feet / Inches)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="inp-wp-length" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Wall Length (<span class="unit-len-label">m</span>)
              </label>
              <input type="number" id="inp-wp-length" value="10" min="0.1" step="any" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10" />
            </div>

            <div>
              <label for="inp-wp-height" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Wall Height (<span class="unit-len-label">m</span>)
              </label>
              <input type="number" id="inp-wp-height" value="3" min="0.1" step="any" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="3" />
            </div>

            <div>
              <label for="inp-wp-walls" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Number of Walls
              </label>
              <input type="number" id="inp-wp-walls" value="1" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1" />
            </div>
          </div>

          <!-- Openings Deduction -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-900/60">
            <div class="flex items-center justify-between">
              <label for="inp-wp-openings" class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>🚪</span> Openings Deduction (Doors, Windows, Vents)
              </label>
              <span class="text-[11px] text-slate-500">Area in <span class="unit-area-label">m²</span></span>
            </div>
            <input type="number" id="inp-wp-openings" value="0" min="0" step="any" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Total deduction area e.g. 3.5" />
          </div>

          <!-- Plaster Thickness & Ratio Grid -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="inp-wp-thick-preset" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Plaster Thickness
              </label>
              <select id="inp-wp-thick-preset" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                <option value="10">10 mm (Rough Ceiling / Internal)</option>
                <option value="12">12 mm (Standard Smooth Internal)</option>
                <option value="15" selected>15 mm (Rough Masonry / Single Coat)</option>
                <option value="20">20 mm (External Sand-Faced)</option>
                <option value="25">25 mm (Heavy External / Double Coat)</option>
                <option value="custom">Custom Thickness</option>
              </select>
              <div id="div-wp-custom-thick" class="hidden mt-2 flex gap-2">
                <input type="number" id="inp-wp-custom-thick-val" value="15" min="1" step="any" class="w-2/3 rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="15" />
                <select id="inp-wp-custom-thick-unit" class="w-1/3 rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  <option value="mm" selected>mm</option>
                  <option value="cm">cm</option>
                  <option value="in">in</option>
                </select>
              </div>
            </div>

            <div>
              <label for="inp-wp-ratio" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Mortar Mix Ratio (Cement : Sand)
              </label>
              <select id="inp-wp-ratio" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                <option value="1:3">1 : 3 (Ceiling & Waterproofing)</option>
                <option value="1:4" selected>1 : 4 (Standard Wall Plaster)</option>
                <option value="1:5">1 : 5 (Medium Strength Plaster)</option>
                <option value="1:6">1 : 6 (Economical Internal Wall)</option>
                <option value="custom">Custom Ratio</option>
              </select>
              <div id="div-wp-custom-ratio" class="hidden mt-2 grid grid-cols-2 gap-2">
                <input type="number" id="inp-wp-custom-c" value="1" min="1" step="1" class="rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Cement Part" />
                <input type="number" id="inp-wp-custom-s" value="4" min="1" step="1" class="rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Sand Part" />
              </div>
            </div>

            <div>
              <label for="inp-wp-wastage" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Wastage & Joint Allowance (%)
              </label>
              <input type="number" id="inp-wp-wastage" value="10" min="0" max="50" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10" />
            </div>
          </div>

          <!-- Advanced Engineering Parameter: Dry Volume Factor -->
          <div class="flex items-center justify-between text-xs pt-1 border-t border-slate-100 dark:border-slate-800">
            <span class="text-slate-500 dark:text-slate-400">Dry Volume Multiplier Factor (IS/ACI Standard):</span>
            <div class="flex items-center gap-1.5">
              <input type="number" id="inp-wp-dry-factor" value="1.30" min="1.1" max="1.6" step="0.01" class="w-20 rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white text-right" />
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- 2. GENERAL MORTAR QUANTITY INPUTS -->
        <!-- ========================================================= -->
        <div id="section-input-general-mortar" class="hidden space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200/80 pb-2 dark:border-slate-800">
            <h2 class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📦</span> Mortar Bed / Joint Volume & Ratio
            </h2>
            <div class="flex items-center gap-1.5 text-xs font-semibold">
              <label class="text-slate-500">Units:</label>
              <select id="inp-gm-unit" class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                <option value="metric" selected>Metric (Meters / mm)</option>
                <option value="imperial">Imperial (Feet / Inches)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <div>
              <label for="inp-gm-length" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Length (<span class="unit-gm-len">m</span>)
              </label>
              <input type="number" id="inp-gm-length" value="5" min="0.1" step="any" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="5" />
            </div>

            <div>
              <label for="inp-gm-width" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Width (<span class="unit-gm-len">m</span>)
              </label>
              <input type="number" id="inp-gm-width" value="4" min="0.1" step="any" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="4" />
            </div>

            <div>
              <label for="inp-gm-depth" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Depth / Thickness
              </label>
              <div class="mt-1 flex gap-1.5">
                <input type="number" id="inp-gm-depth" value="50" min="0.1" step="any" class="w-2/3 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="50" />
                <select id="inp-gm-depth-unit" class="w-1/3 rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  <option value="mm" selected>mm</option>
                  <option value="cm">cm</option>
                  <option value="m">m</option>
                  <option value="in">in</option>
                </select>
              </div>
            </div>

            <div>
              <label for="inp-gm-sections" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Sections / Slabs
              </label>
              <input type="number" id="inp-gm-sections" value="1" min="1" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1" />
            </div>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="inp-gm-ratio" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Mortar Ratio (Cement : Sand)
              </label>
              <select id="inp-gm-ratio" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                <option value="1:3" selected>1 : 3 (High Strength Bed / Screed)</option>
                <option value="1:4">1 : 4 (Standard Masonry / Flooring)</option>
                <option value="1:5">1 : 5 (Medium Joint Mix)</option>
                <option value="1:6">1 : 6 (Low Strength Mortar)</option>
                <option value="custom">Custom Ratio</option>
              </select>
              <div id="div-gm-custom-ratio" class="hidden mt-2 grid grid-cols-2 gap-2">
                <input type="number" id="inp-gm-custom-c" value="1" min="1" step="1" class="rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Cement Part" />
                <input type="number" id="inp-gm-custom-s" value="3" min="1" step="1" class="rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="Sand Part" />
              </div>
            </div>

            <div>
              <label for="inp-gm-wastage" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Wastage Allowance (%)
              </label>
              <input type="number" id="inp-gm-wastage" value="10" min="0" max="50" step="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10" />
            </div>

            <div>
              <label for="inp-gm-dry-factor" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Dry Volume Factor
              </label>
              <input type="number" id="inp-gm-dry-factor" value="1.30" min="1.1" max="1.6" step="0.01" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- 3. TILE MORTAR & ADHESIVE INPUTS -->
        <!-- ========================================================= -->
        <div id="section-input-tile-mortar" class="hidden space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200/80 pb-2 dark:border-slate-800">
            <h2 class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🔲</span> Tile Mortar / Adhesive Estimator
            </h2>
            <div class="flex items-center gap-1.5 text-xs font-semibold">
              <label class="text-slate-500">Area Unit:</label>
              <select id="inp-tm-unit" class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                <option value="metric" selected>Square Meters (m²)</option>
                <option value="imperial">Square Feet (sq.ft)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="inp-tm-area" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Total Tiling Area (<span class="unit-tm-area-label">m²</span>)
              </label>
              <input type="number" id="inp-tm-area" value="50" min="0.1" step="any" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="50" />
            </div>

            <div>
              <label for="inp-tm-type" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Tile Application Type
              </label>
              <select id="inp-tm-type" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                <option value="floor" selected>Floor Tile (Thicker Bed)</option>
                <option value="wall">Wall Tile (Thin-Set Adhesive)</option>
              </select>
            </div>

            <div>
              <label for="inp-tm-preset" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Tile Format / Size
              </label>
              <select id="inp-tm-preset" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">
                <option value="300x300">300 × 300 mm (Small / Standard)</option>
                <option value="600x600" selected>600 × 600 mm (Medium Format)</option>
                <option value="600x1200">600 × 1200 mm (Large Vitrified Slab)</option>
                <option value="custom">Custom Format</option>
              </select>
              <div id="div-tm-custom-size" class="hidden mt-2 grid grid-cols-2 gap-2">
                <div>
                  <label for="inp-tm-custom-len" class="text-[10px] font-bold text-slate-500 dark:text-slate-400">Tile Length (mm)</label>
                  <input type="number" id="inp-tm-custom-len" value="800" min="20" step="1" class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="800" />
                </div>
                <div>
                  <label for="inp-tm-custom-wid" class="text-[10px] font-bold text-slate-500 dark:text-slate-400">Tile Width (mm)</label>
