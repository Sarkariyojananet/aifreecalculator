            <div class="text-xs text-slate-500 dark:text-slate-400">${lastResultData.distKm} km (${(parseFloat(lastResultData.distM) * 3.28084).toFixed(0)} ft)</div>
          </div>
          <div class="rounded-2xl border border-amber-200/70 bg-white/90 p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/80">
            <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-blue-400">
              <span class="text-base">🧭</span> Azimuth Bearing
            </div>
            <div class="mt-2 text-base sm:text-lg font-extrabold text-slate-900 dark:text-white">${lastResultData.bearingDeg}\u00B0</div>
            <div class="text-xs font-semibold text-blue-600 dark:text-blue-400">Compass Heading: ${compass}</div>
          </div>
          <div class="rounded-2xl border border-amber-200/70 bg-white/90 p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/80">
            <div class="flex items-center gap-2 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              <span class="text-base">🌐</span> NATO Mils Angle
            </div>
            <div class="mt-2 text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400">${natoMils} Mils</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Warsaw Pact: ${warsawMils} Mils</div>
          </div>
