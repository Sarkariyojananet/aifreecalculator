              <span class="text-base">📡</span> Aiming Guidance
            </div>
            <div class="mt-2 text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate" title="${aimingRef}">${aimingRef}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Profile: ${gameSelect.options[gameSelect.selectedIndex].text}</div>
          </div>
