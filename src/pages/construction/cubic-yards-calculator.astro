---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
import CalculatorActionBar from "../../components/CalculatorActionBar.astro";
import { extractLocaleFromPath, getLocalizedPath } from "../../i18n/utils";
import { isValidLocale, type Locale } from "../../i18n/config";
import { getCalculatorTranslation } from "../../i18n/translations/calculators";
import uiDict from "../../data/cubic-yards-ui.json";

const localsLang = (Astro.locals as any)?.locale;
const originalPath = (Astro.locals as any)?.originalPath;
const urlQueryLang = Astro.url.searchParams.get("lang");
const detectedLang = extractLocaleFromPath(
  originalPath || Astro.url.pathname,
).lang;
const candidateLang =
  (localsLang && isValidLocale(localsLang) ? (localsLang as Locale) : null) ||
  (urlQueryLang && isValidLocale(urlQueryLang) ? (urlQueryLang as Locale) : null) ||
  detectedLang;
const lang: Locale = isValidLocale(candidateLang) ? candidateLang : "en";

const t = getCalculatorTranslation("cubic-yards-calculator", lang);
const curT = (uiDict as any)[lang] || (uiDict as any).en;

const homeHref = getLocalizedPath("/", lang);
const concreteCalcHref = getLocalizedPath("/construction/concrete-calculator/", lang);
const sqFtCalcHref = getLocalizedPath("/construction/square-footage-calculator/", lang);
const contactHref = `${getLocalizedPath("/contact/", lang)}#calc=cubic-yards-calculator&name=${encodeURIComponent(t.name)}&type=bug`;
---

<CalculatorLayout
  title={t.metaTitle}
  description={t.metaDescription}
  category="Construction"
  calculatorName={t.name}
  slug="cubic-yards-calculator"
  hideActionBar={true}
  hideFeedback={true}
  keywords={[
    "cubic yards calculator",
    "calculate cubic yards",
    "cubic yards to cubic feet",
    "cubic feet to cubic yards",
    "square feet to cubic yards with depth",
    "cubic yard calculator for concrete",
    "cubic yard calculator for mulch",
    "gravel volume calculator",
    "soil volume calculator",
    "cubic yards of material",
    "cubic yard coverage",
    "bags per cubic yard"
  ]}
>
  <div class="space-y-8">

    <!-- HERO HEADER & INTRO -->
    <div class="rounded-3xl border border-slate-200/90 bg-linear-to-r from-amber-50/70 via-orange-50/40 to-white p-5 dark:border-slate-800 dark:from-slate-900 dark:via-amber-950/20 dark:to-slate-900 sm:p-6 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/90 px-3 py-1 text-xs font-bold text-amber-900 dark:bg-amber-900/60 dark:text-amber-200 mb-2">
            <span>📦</span> {curT.heroTag}
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
            {t.h1}
          </h1>
          <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
            {t.shortDescription}
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2.5 rounded-2xl border border-slate-200/80 bg-white/95 p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-950/80 text-xs">
          <span class="text-2xl">📐</span>
          <div>
            <div class="font-bold text-slate-800 dark:text-slate-200">{curT.badgeShapes}</div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">{curT.badgeSupport}</div>
          </div>
        </div>
      </div>

      <!-- INSTRUCTION NOTICE BAR -->
      <div class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-amber-800 px-4 py-2.5 text-xs font-bold text-white shadow-xs dark:bg-amber-900">
        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-xs">▼</span>
        <span>{curT.instructionBar}</span>
      </div>
    </div>

    <!-- MAIN CALCULATOR WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- LEFT COLUMN: INPUT CARD (Matching Reference Image) (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">

        <div class="rounded-2xl border border-slate-300/80 bg-[#f4f4f4] dark:bg-slate-900 dark:border-slate-800 shadow-sm overflow-hidden">
          
          <!-- Terracotta / Brown Card Top Header (Matching Reference Image) -->
          <div class="bg-[#A3523B] dark:bg-[#8C432F] px-4 py-2.5 text-center text-white font-bold text-sm tracking-wide shadow-xs">
            {curT.calcCardHeader}
          </div>

          <div class="p-5 sm:p-6 space-y-5">
            
            <!-- Shape Dropdown Selector -->
            <div>
              <label for="sel-shape" class="block text-center text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">
                {curT.selectShapePrompt}
              </label>
              <select 
                id="sel-shape" 
                class="w-full sm:w-72 mx-auto block rounded-lg border border-slate-400 bg-white px-3 py-2 text-xs sm:text-sm font-bold text-slate-800 shadow-2xs focus:border-amber-600 focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
              >
                <option value="rectangle" selected>{curT.shapeNames.rectangle}</option>
                <option value="square">{curT.shapeNames.square}</option>
                <option value="rectangle-border">{curT.shapeNames["rectangle-border"]}</option>
                <option value="circle">{curT.shapeNames.circle}</option>
                <option value="circle-border">{curT.shapeNames["circle-border"]}</option>
                <option value="annulus">{curT.shapeNames.annulus}</option>
                <option value="triangle-base">{curT.shapeNames["triangle-base"]}</option>
                <option value="triangle-sides">{curT.shapeNames["triangle-sides"]}</option>
                <option value="trapezoid">{curT.shapeNames.trapezoid}</option>
                <option value="direct-area">{curT.shapeNames["direct-area"]}</option>
              </select>
            </div>

            <!-- DYNAMIC INPUT FIELDS CONTAINER -->
            <div id="dynamic-shape-inputs" class="space-y-3 pt-2">
              <div class="flex items-center justify-end gap-2 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
                <label for="inp-depth" class="shrink-0">{curT.labels.depth}</label>
                <input type="number" id="inp-depth" value="4" min="0" step="any" placeholder="4" class="w-24 sm:w-28 rounded-md border border-slate-400 bg-white px-2.5 py-1.5 text-center font-bold text-slate-900 shadow-2xs focus:border-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <select id="inp-depth-unit" class="w-16 shrink-0 rounded-md border border-slate-400 bg-white px-1.5 py-1.5 text-xs font-bold text-slate-800 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="in" selected>in</option>
                  <option value="ft">ft</option>
                  <option value="yd">yd</option>
                  <option value="cm">cm</option>
                  <option value="m">m</option>
                </select>
              </div>
              <div class="flex items-center justify-end gap-2 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
                <label for="inp-length" class="shrink-0">{curT.labels.length}</label>
                <input type="number" id="inp-length" value="12" min="0" step="any" placeholder="12" class="w-24 sm:w-28 rounded-md border border-slate-400 bg-white px-2.5 py-1.5 text-center font-bold text-slate-900 shadow-2xs focus:border-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <select id="inp-length-unit" class="w-16 shrink-0 rounded-md border border-slate-400 bg-white px-1.5 py-1.5 text-xs font-bold text-slate-800 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="in">in</option>
                  <option value="ft" selected>ft</option>
                  <option value="yd">yd</option>
                  <option value="cm">cm</option>
                  <option value="m">m</option>
                </select>
              </div>
              <div class="flex items-center justify-end gap-2 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
                <label for="inp-width" class="shrink-0">{curT.labels.width}</label>
                <input type="number" id="inp-width" value="10" min="0" step="any" placeholder="10" class="w-24 sm:w-28 rounded-md border border-slate-400 bg-white px-2.5 py-1.5 text-center font-bold text-slate-900 shadow-2xs focus:border-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <select id="inp-width-unit" class="w-16 shrink-0 rounded-md border border-slate-400 bg-white px-1.5 py-1.5 text-xs font-bold text-slate-800 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                  <option value="in">in</option>
                  <option value="ft" selected>ft</option>
                  <option value="yd">yd</option>
                  <option value="cm">cm</option>
                  <option value="m">m</option>
                </select>
              </div>
            </div>

            <!-- QUANTITY MULTIPLIER -->
            <div class="flex items-center justify-end gap-2 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
              <label for="inp-quantity" class="shrink-0">{curT.labels.quantity}</label>
              <input 
                type="number" 
                id="inp-quantity" 
                value="1" 
                min="1" 
                max="1000" 
                step="1"
                class="w-24 sm:w-28 rounded-md border border-slate-400 bg-white px-2.5 py-1.5 text-center font-bold text-slate-900 shadow-2xs focus:border-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
              <span class="w-16 shrink-0"></span>
            </div>

            <!-- WASTE FACTOR SELECTOR (Optional) -->
            <div class="rounded-xl border border-slate-300/80 bg-white/80 p-3.5 dark:border-slate-800 dark:bg-slate-800/60 text-xs sm:text-sm">
              <div class="flex items-center justify-between mb-1.5">
                <label for="sel-waste" class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                  <span>📐</span> {curT.labels.waste}
                </label>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">Optional</span>
              </div>
              <select 
                id="sel-waste" 
                class="w-full rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-800 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
              >
                <option value="0" selected>{curT.wasteOptions.w0}</option>
                <option value="5">{curT.wasteOptions.w5}</option>
                <option value="10">{curT.wasteOptions.w10}</option>
                <option value="15">{curT.wasteOptions.w15}</option>
                <option value="20">{curT.wasteOptions.w20}</option>
                <option value="custom">{curT.wasteOptions.custom}</option>
              </select>
              <div id="custom-waste-wrap" class="mt-2 hidden">
                <div class="flex items-center gap-2">
                  <input 
                    type="number" 
                    id="inp-custom-waste" 
                    value="10" 
                    min="0" 
                    max="100" 
                    step="any"
                    class="w-24 rounded-md border border-slate-300 px-2.5 py-1 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" 
                  />
                  <span class="text-xs text-slate-600 dark:text-slate-400">% extra volume</span>
                </div>
              </div>
            </div>

            <!-- OPTIONAL COST CALCULATION (Matching Reference Image) -->
            <fieldset class="rounded-xl border border-slate-300/90 bg-white/80 p-3.5 dark:border-slate-700 dark:bg-slate-800/50">
              <legend class="px-2 text-xs italic font-medium text-slate-600 dark:text-slate-300">
                {curT.labels.costTitle}
              </legend>

              <div class="mt-1 flex flex-wrap items-center justify-center gap-2 text-xs sm:text-sm">
                
                <!-- Currency Selector -->
                <select 
                  id="sel-currency" 
                  class="rounded-md border border-slate-300 bg-white px-2 py-1.5 font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
                >
                  <option value="$" selected>$</option>
                  <option value="€">€</option>
                  <option value="£">£</option>
                  <option value="₹">₹</option>
                  <option value="¥">¥</option>
                  <option value="₩">₩</option>
                </select>

                <!-- Price Input Box -->
                <div class="flex flex-col items-center">
                  <span class="text-[11px] italic text-slate-500 mb-0.5">price</span>
                  <input 
                    type="number" 
                    id="inp-price" 
                    placeholder="0" 
                    min="0" 
                    step="any" 
                    class="w-24 sm:w-28 rounded-md border border-slate-400 bg-white px-2.5 py-1 text-center font-bold text-slate-900 shadow-2xs focus:border-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>

                <!-- Price Unit Dropdown -->
                <div class="flex flex-col items-start">
                  <span class="text-[11px] italic text-slate-500 mb-0.5">per cubic / bag</span>
                  <select 
                    id="sel-price-unit" 
                    class="rounded-md border border-slate-400 bg-white px-2.5 py-1 font-semibold text-slate-800 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
                  >
                    <option value="yd3" selected>{curT.priceUnits.cuYd}</option>
                    <option value="ft3">{curT.priceUnits.cuFt}</option>
                    <option value="m3">{curT.priceUnits.cuM}</option>
                    <option value="bag20">{curT.priceUnits.bag20}</option>
                    <option value="bag15">{curT.priceUnits.bag15}</option>
                    <option value="bag05">{curT.priceUnits.bag05}</option>
                  </select>
                </div>

              </div>
            </fieldset>

            <!-- ACTION BUTTONS -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
              <button 
                type="button" 
                id="btn-calculate" 
                class="flex-1 min-w-40 rounded-xl bg-amber-700 hover:bg-amber-800 px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-sm transition active:scale-[0.98] text-center"
              >
                {curT.buttons.calculate}
              </button>
              <button 
                type="button" 
                id="btn-reset" 
                class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
              >
                {curT.buttons.reset}
              </button>
            </div>

            <!-- Friendly localized error banner -->
            <div id="calc-error-banner" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-800 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-300">
            </div>

          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: SHAPE DIAGRAM & RESULTS (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">

        <!-- LIVE SHAPE DIAGRAM CARD -->
        <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 shadow-xs flex flex-col items-center">
          <div class="w-full flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800 mb-3 text-xs font-bold text-slate-600 dark:text-slate-300">
            <span>📐 Selected Shape Geometry</span>
            <span id="diagram-shape-badge" class="font-mono text-amber-700 dark:text-amber-400">Rectangle</span>
          </div>
          <div id="shape-diagram-container" class="w-full h-48 sm:h-52 flex items-center justify-center p-2">
            <svg viewBox="0 0 240 160" class="w-full h-full max-h-48" xmlns="http://www.w3.org/2000/svg">
              <polygon points="40,95 70,55 200,55 170,95" fill="#BFDBFE" stroke="#2563EB" stroke-width="1.5" />
              <polygon points="170,95 200,55 200,85 170,125" fill="#93C5FD" stroke="#2563EB" stroke-width="1.5" />
              <rect x="40" y="95" width="130" height="30" fill="#3B82F6" stroke="#1D4ED8" stroke-width="2" />
              <line x1="40" y1="135" x2="170" y2="135" stroke="#334155" stroke-width="1.5" />
              <text x="105" y="148" text-anchor="middle" font-size="10" font-weight="bold" fill="#334155">Length</text>
              <line x1="180" y1="95" x2="210" y2="55" stroke="#334155" stroke-width="1.5" />
              <text x="205" y="75" text-anchor="start" font-size="10" font-weight="bold" fill="#334155">Width</text>
              <line x1="25" y1="95" x2="25" y2="125" stroke="#D97706" stroke-width="1.5" />
              <text x="18" y="113" text-anchor="end" font-size="10" font-weight="bold" fill="#D97706">Depth</text>
            </svg>
          </div>
          <div id="diagram-caption" class="mt-2 text-center text-[11px] font-semibold text-slate-500 dark:text-slate-400">
            Geometric Dimension Guide
          </div>
        </div>

        <!-- RESULTS DISPLAY CARD -->
        <div id="results-section" data-calculator-results class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 shadow-xs space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
            <h2 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
              <span>📊</span> {curT.results.summaryTitle}
            </h2>
            <div class="flex items-center gap-1.5">
              <button 
                type="button" 
                id="btn-copy-result" 
                class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 transition"
              >
                {curT.buttons.copy}
              </button>
              <button 
                type="button" 
                id="btn-print-report" 
                class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 transition"
              >
                🖨️
              </button>
            </div>
          </div>

          <!-- PRIMARY RESULT: CUBIC YARDS -->
          <div class="rounded-xl border border-amber-300 bg-linear-to-br from-amber-500/10 via-orange-500/5 to-white p-4 dark:border-amber-800/60 dark:from-amber-950/40 dark:to-slate-900 text-center">
            <div class="text-xs font-bold uppercase tracking-wider text-amber-900 dark:text-amber-300">
              {curT.results.primaryLabel}
            </div>
            <div class="mt-1 font-mono text-3xl sm:text-4xl font-black text-amber-700 dark:text-amber-400" id="res-cubic-yards">
              1.48 yd³
            </div>
            <div class="mt-1 text-xs text-slate-500 dark:text-slate-400" id="res-cubic-yards-sub">
              Net Volume: 1.4815 yd³
            </div>
          </div>

          <!-- SECONDARY VOLUMES: CU FT & CU METERS & AREA -->
          <div class="grid grid-cols-2 gap-2.5 text-xs">
            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 dark:border-slate-800 dark:bg-slate-800/50">
              <div class="font-bold text-slate-500 dark:text-slate-400">{curT.results.cuFtLabel}</div>
              <div class="mt-1 font-mono text-base font-bold text-slate-900 dark:text-white" id="res-cubic-feet">
                40.00 ft³
              </div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 dark:border-slate-800 dark:bg-slate-800/50">
              <div class="font-bold text-slate-500 dark:text-slate-400">{curT.results.cuMLabel}</div>
              <div class="mt-1 font-mono text-base font-bold text-slate-900 dark:text-white" id="res-cubic-meters">
                1.13 m³
              </div>
            </div>
            <div class="col-span-2 rounded-xl border border-slate-200 bg-slate-50/70 p-3 dark:border-slate-800 dark:bg-slate-800/50 flex items-center justify-between">
              <div>
                <div class="font-bold text-slate-500 dark:text-slate-400">{curT.results.areaLabel}</div>
                <div class="mt-0.5 font-mono text-xs font-bold text-slate-800 dark:text-slate-200" id="res-area">
                  120.00 sq ft (11.15 m²)
                </div>
              </div>
              <div id="res-depth-pill" class="rounded-lg bg-amber-100 px-2.5 py-1 text-[11px] font-bold text-amber-900 dark:bg-amber-900/60 dark:text-amber-200">
                Depth: 4 in (0.33 ft)
              </div>
            </div>
          </div>

          <!-- WITH WASTE ALLOWANCE -->
          <div id="waste-result-card" class="hidden rounded-xl border border-orange-200 bg-orange-50/60 p-3 dark:border-orange-900/40 dark:bg-orange-950/30 text-xs">
            <div class="font-bold text-orange-900 dark:text-orange-200 flex items-center justify-between">
              <span>📦 {curT.results.withWasteLabel}:</span>
              <span id="res-waste-pct" class="font-mono text-xs">10% Waste</span>
            </div>
            <div class="mt-1.5 flex items-baseline justify-between font-mono">
              <span class="text-base font-black text-orange-700 dark:text-orange-300" id="res-gross-yards">1.63 yd³</span>
              <span class="text-xs font-semibold text-slate-600 dark:text-slate-300" id="res-gross-feet">(44.00 ft³)</span>
            </div>
          </div>

          <!-- MATERIAL COST & BAG ESTIMATE -->
          <div id="cost-result-card" class="hidden rounded-xl border border-emerald-200 bg-emerald-50/70 p-3.5 dark:border-emerald-900/40 dark:bg-emerald-950/30 text-xs space-y-1.5">
            <div class="font-bold text-emerald-900 dark:text-emerald-200 flex items-center justify-between">
              <span>💰 {curT.results.costLabel}:</span>
              <span class="font-mono text-lg font-black text-emerald-700 dark:text-emerald-400" id="res-total-cost">$0.00</span>
            </div>
            <div class="flex items-center justify-between text-[11px] text-slate-600 dark:text-slate-300 pt-1 border-t border-emerald-200/60 dark:border-emerald-900/30">
              <span>{curT.results.bagsLabel} (2.0 cu ft):</span>
              <span class="font-bold font-mono text-slate-800 dark:text-slate-200" id="res-bag-count">20 bags</span>
            </div>
          </div>

          <!-- STEP-BY-STEP BREAKDOWN -->
          <details class="group rounded-xl border border-slate-200 bg-slate-50/60 p-3 dark:border-slate-800 dark:bg-slate-900/40 text-xs">
            <summary class="cursor-pointer font-bold text-slate-800 dark:text-slate-200 flex items-center justify-between">
              <span>🧮 {curT.results.breakdownTitle}</span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="mt-2.5 pt-2 border-t border-slate-200 dark:border-slate-800 space-y-2 font-mono text-[11px] text-slate-700 dark:text-slate-300" id="res-step-breakdown">
            </div>
          </details>

        </div>

      </div>

