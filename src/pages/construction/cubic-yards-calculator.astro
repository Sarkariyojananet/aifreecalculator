          case 'direct-area':
          default:
            return '<svg viewBox="0 0 240 160" class="w-full h-full max-h-48" xmlns="http://www.w3.org/2000/svg"><ellipse cx="120" cy="80" rx="75" ry="40" fill="#93C5FD" stroke="#1D4ED8" stroke-width="2" /><text x="120" y="78" text-anchor="middle" font-size="12" font-weight="black" fill="#1E40AF">' + dSurfaceArea + '</text><text x="120" y="94" text-anchor="middle" font-size="9" font-weight="semibold" fill="#64748B">' + dAnyShape + '</text><line x1="195" y1="80" x2="195" y2="115" stroke="#D97706" stroke-width="2" /><text x="203" y="100" text-anchor="start" font-size="10" font-weight="bold" fill="#D97706">' + dDepth + '</text></svg>';
        }
      }

      function renderShapeFields(shape) {
        var container = document.getElementById('dynamic-shape-inputs');
        if (!container) return;

        var def = SHAPE_DEFS[shape] || SHAPE_DEFS['rectangle'];
        container.innerHTML = '';

        def.fields.forEach(function(field) {
          var row = document.createElement('div');
          row.className = 'flex items-center justify-end gap-2 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200';

          var label = document.createElement('label');
          label.setAttribute('for', field.id);
          label.className = 'shrink-0';
          label.textContent = field.label;

          var input = document.createElement('input');
          input.type = 'number';
          input.id = field.id;
          input.value = field.defaultVal;
          input.placeholder = field.isDepth ? '4' : '10';
          input.min = '0';
          input.step = 'any';
          input.className = 'w-24 sm:w-28 rounded-md border border-slate-400 bg-white px-2.5 py-1.5 text-center font-bold text-slate-900 shadow-2xs focus:border-amber-600 focus:ring-1 focus:ring-amber-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white';

          var unitSelect = document.createElement('select');
          unitSelect.id = field.id + '-unit';
          unitSelect.className = 'w-16 shrink-0 rounded-md border border-slate-400 bg-white px-1.5 py-1.5 text-xs font-bold text-slate-800 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer';

          if (field.isArea) {
            unitSelect.innerHTML = '<option value="sqFt" selected>sq ft</option><option value="sqYd">sq yd</option><option value="sqM">sq m</option><option value="sqIn">sq in</option>';
          } else {
            unitSelect.innerHTML = '<option value="in"' + (field.defaultUnit === 'in' ? ' selected' : '') + '>in</option><option value="ft"' + (field.defaultUnit === 'ft' ? ' selected' : '') + '>ft</option><option value="yd"' + (field.defaultUnit === 'yd' ? ' selected' : '') + '>yd</option><option value="cm"' + (field.defaultUnit === 'cm' ? ' selected' : '') + '>cm</option><option value="m"' + (field.defaultUnit === 'm' ? ' selected' : '') + '>m</option>';
          }

          row.appendChild(label);
          row.appendChild(input);
          row.appendChild(unitSelect);
          container.appendChild(row);

          input.addEventListener('input', runCalculation);
          unitSelect.addEventListener('change', runCalculation);
        });

        var diagramContainer = document.getElementById('shape-diagram-container');
        if (diagramContainer) {
          diagramContainer.innerHTML = getShapeSvg(shape);
        }
        var badge = document.getElementById('diagram-shape-badge');
        if (badge) {
          badge.textContent = def.name;
        }
      }

      function getValInFeet(inputId) {
        var inp = document.getElementById(inputId);
        var unitSel = document.getElementById(inputId + '-unit');
        if (!inp || !unitSel) return 0;
        var raw = parseFloat(inp.value);
        if (isNaN(raw) || raw <= 0) return 0;
        var factor = LENGTH_TO_FEET[unitSel.value] || 1;
        return raw * factor;
      }

      function runCalculation() {
        var errorBanner = document.getElementById('calc-error-banner');
        if (errorBanner) errorBanner.classList.add('hidden');

        var depthInFeet = getValInFeet('inp-depth');
        var depthInches = depthInFeet * 12;

        var areaSqFt = 0;
        var areaFormulaStr = '';
        var isValid = true;
        var errorMsg = '';

        switch (currentShape) {
          case 'rectangle': {
            var l = getValInFeet('inp-length');
            var w = getValInFeet('inp-width');
            if (l <= 0 || w <= 0) isValid = false;
            areaSqFt = l * w;
            areaFormulaStr = 'Area = Length (' + l.toFixed(2) + ' ft) × Width (' + w.toFixed(2) + ' ft) = ' + areaSqFt.toFixed(2) + ' ft²';
            break;
          }
          case 'square': {
            var side = getValInFeet('inp-side');
            if (side <= 0) isValid = false;
            areaSqFt = side * side;
            areaFormulaStr = 'Area = Side (' + side.toFixed(2) + ' ft)² = ' + areaSqFt.toFixed(2) + ' ft²';
            break;
          }
          case 'rectangle-border': {
            var inL = getValInFeet('inp-inner-len');
            var inW = getValInFeet('inp-inner-wid');
            var border = getValInFeet('inp-border-wid');
            if (inL <= 0 || inW <= 0 || border <= 0) {
              isValid = false;
            } else {
              var outL = inL + 2 * border;
              var outW = inW + 2 * border;
              var innerArea = inL * inW;
              var outerArea = outL * outW;
              areaSqFt = outerArea - innerArea;
              areaFormulaStr = 'Outer Area (' + outL.toFixed(2) + ' × ' + outW.toFixed(2) + ' = ' + outerArea.toFixed(2) + ' ft²) − Inner Area (' + innerArea.toFixed(2) + ' ft²) = ' + areaSqFt.toFixed(2) + ' ft²';
            }
            break;
          }
          case 'circle': {
            var dia = getValInFeet('inp-diameter');
            if (dia <= 0) isValid = false;
            var r = dia / 2;
            areaSqFt = Math.PI * r * r;
            areaFormulaStr = 'Area = π × Radius (' + r.toFixed(2) + ' ft)² = ' + areaSqFt.toFixed(2) + ' ft²';
            break;
          }
          case 'circle-border': {
            var inDia = getValInFeet('inp-inner-dia');
            var borderCircle = getValInFeet('inp-border-wid');
            if (inDia <= 0 || borderCircle <= 0) {
              isValid = false;
            } else {
              var outDia = inDia + 2 * borderCircle;
              var rIn = inDia / 2;
              var rOut = outDia / 2;
              areaSqFt = Math.PI * (rOut * rOut - rIn * rIn);
              areaFormulaStr = 'Area = π × (R_outer ' + rOut.toFixed(2) + '² − R_inner ' + rIn.toFixed(2) + '²) = ' + areaSqFt.toFixed(2) + ' ft²';
            }
            break;
          }
          case 'annulus': {
            var outDiaAnn = getValInFeet('inp-outer-dia');
            var inDiaAnn = getValInFeet('inp-inner-dia');
            if (outDiaAnn <= 0 || inDiaAnn <= 0) {
              isValid = false;
            } else if (inDiaAnn >= outDiaAnn) {
              isValid = false;
              errorMsg = UI_ERRORS.innerGreaterOuter || 'Inner diameter must be strictly smaller than outer diameter.';
            } else {
              var rInAnn = inDiaAnn / 2;
              var rOutAnn = outDiaAnn / 2;
              areaSqFt = Math.PI * (rOutAnn * rOutAnn - rInAnn * rInAnn);
              areaFormulaStr = 'Area = π × (R_outer ' + rOutAnn.toFixed(2) + '² − R_inner ' + rInAnn.toFixed(2) + '²) = ' + areaSqFt.toFixed(2) + ' ft²';
            }
            break;
          }
          case 'triangle-base': {
            var b = getValInFeet('inp-base');
            var h = getValInFeet('inp-height');
            if (b <= 0 || h <= 0) isValid = false;
            areaSqFt = 0.5 * b * h;
            areaFormulaStr = 'Area = ½ × Base (' + b.toFixed(2) + ' ft) × Height (' + h.toFixed(2) + ' ft) = ' + areaSqFt.toFixed(2) + ' ft²';
            break;
          }
          case 'triangle-sides': {
            var a = getValInFeet('inp-side-a');
            var bSide = getValInFeet('inp-side-b');
            var c = getValInFeet('inp-side-c');
            if (a <= 0 || bSide <= 0 || c <= 0) {
              isValid = false;
            } else if (a + bSide <= c || a + c <= bSide || bSide + c <= a) {
              isValid = false;
              errorMsg = UI_ERRORS.triangleInequality || 'Triangle Inequality Violation: The sum of any two sides must be strictly greater than the third side.';
            } else {
              var s = (a + bSide + c) / 2;
              areaSqFt = Math.sqrt(s * (s - a) * (s - bSide) * (s - c));
              areaFormulaStr = 'Heron\'s Formula: s = ' + s.toFixed(2) + ', Area = √[s(s-a)(s-b)(s-c)] = ' + areaSqFt.toFixed(2) + ' ft²';
            }
            break;
          }
          case 'trapezoid': {
            var aTrap = getValInFeet('inp-side-a');
            var bTrap = getValInFeet('inp-side-b');
            var hTrap = getValInFeet('inp-height');
            if (aTrap <= 0 || bTrap <= 0 || hTrap <= 0) isValid = false;
            areaSqFt = 0.5 * (aTrap + bTrap) * hTrap;
            areaFormulaStr = 'Area = ½ × (Side a ' + aTrap.toFixed(2) + ' + Side b ' + bTrap.toFixed(2) + ') × Height ' + hTrap.toFixed(2) + ' = ' + areaSqFt.toFixed(2) + ' ft²';
            break;
          }
          case 'direct-area': {
            var rawArea = parseFloat(document.getElementById('inp-surface-area')?.value || '0');
            var unit = document.getElementById('inp-surface-area-unit')?.value || 'sqFt';
            if (isNaN(rawArea) || rawArea <= 0) {
              isValid = false;
            } else {
              var factor = AREA_TO_SQFT[unit] || 1;
              areaSqFt = rawArea * factor;
              areaFormulaStr = 'Direct Input: ' + rawArea + ' ' + unit + ' = ' + areaSqFt.toFixed(2) + ' sq ft';
            }
            break;
          }
        }

        if (depthInFeet <= 0) {
          isValid = false;
          if (!errorMsg) errorMsg = UI_ERRORS.depthRequired || 'Depth / thickness must be greater than zero.';
        }

        if (!isValid && !errorMsg) {
          errorMsg = UI_ERRORS.invalidPositive || 'Please enter positive dimensions greater than zero.';
        }

        if (errorMsg && errorBanner) {
          errorBanner.textContent = errorMsg;
          errorBanner.classList.remove('hidden');
        }

        if (!isValid) {
          return;
        }

        var qtyInp = document.getElementById('inp-quantity');
        var quantity = Math.max(1, parseInt(qtyInp?.value || '1', 10));

        var netCuFt = areaSqFt * depthInFeet * quantity;
        var netCuYds = netCuFt / 27;
        var netCuM = netCuFt * 0.028316846592;
        var areaSqM = areaSqFt * 0.09290304;

        var wasteSel = document.getElementById('sel-waste');
        var wastePct = 0;
        if (wasteSel?.value === 'custom') {
          var customInp = document.getElementById('inp-custom-waste');
          wastePct = Math.max(0, parseFloat(customInp?.value || '0'));
        } else {
          wastePct = Math.max(0, parseFloat(wasteSel?.value || '0'));
        }

        var grossCuFt = netCuFt * (1 + wastePct / 100);
        var grossCuYds = netCuYds * (1 + wastePct / 100);
        var grossCuM = netCuM * (1 + wastePct / 100);

        var elResCuYds = document.getElementById('res-cubic-yards');
        var elResCuYdsSub = document.getElementById('res-cubic-yards-sub');
        var elResCuFt = document.getElementById('res-cubic-feet');
        var elResCuM = document.getElementById('res-cubic-meters');
        var elResArea = document.getElementById('res-area');
        var elDepthPill = document.getElementById('res-depth-pill');

        if (elResCuYds) elResCuYds.textContent = (wastePct > 0 ? grossCuYds.toFixed(2) : netCuYds.toFixed(2)) + ' yd³';
        if (elResCuYdsSub) {
          elResCuYdsSub.textContent = wastePct > 0 
            ? 'Net: ' + netCuYds.toFixed(4) + ' yd³ | With ' + wastePct + '% Waste: ' + grossCuYds.toFixed(4) + ' yd³'
            : 'Exact Net Volume: ' + netCuYds.toFixed(4) + ' yd³';
        }
        if (elResCuFt) elResCuFt.textContent = netCuFt.toFixed(2) + ' ft³';
        if (elResCuM) elResCuM.textContent = netCuM.toFixed(2) + ' m³';
        if (elResArea) elResArea.textContent = areaSqFt.toFixed(2) + ' sq ft (' + areaSqM.toFixed(2) + ' m²)';
        if (elDepthPill) elDepthPill.textContent = 'Depth: ' + depthInches.toFixed(2) + ' in (' + depthInFeet.toFixed(3) + ' ft)';

        var wasteCard = document.getElementById('waste-result-card');
        if (wasteCard) {
          if (wastePct > 0) {
            wasteCard.classList.remove('hidden');
            var elWastePct = document.getElementById('res-waste-pct');
            var elGrossYds = document.getElementById('res-gross-yards');
            var elGrossFt = document.getElementById('res-gross-feet');
            if (elWastePct) elWastePct.textContent = wastePct + '% Waste Allowance';
            if (elGrossYds) elGrossYds.textContent = grossCuYds.toFixed(2) + ' yd³';
            if (elGrossFt) elGrossFt.textContent = '(' + grossCuFt.toFixed(2) + ' ft³)';
          } else {
            wasteCard.classList.add('hidden');
          }
        }

        var priceInp = document.getElementById('inp-price');
        var priceUnitSel = document.getElementById('sel-price-unit');
        var currencySel = document.getElementById('sel-currency');
        var costCard = document.getElementById('cost-result-card');

        var rawPrice = parseFloat(priceInp?.value || '0');
        var priceUnit = priceUnitSel?.value || 'yd3';
        var currency = currencySel?.value || '$';

        var volumeForOrderCuFt = wastePct > 0 ? grossCuFt : netCuFt;
        var volumeForOrderCuYd = wastePct > 0 ? grossCuYds : netCuYds;
        var volumeForOrderCuM = wastePct > 0 ? grossCuM : netCuM;

        var bags20 = Math.ceil(volumeForOrderCuFt / 2.0);
        var bags15 = Math.ceil(volumeForOrderCuFt / 1.5);
        var bags05 = Math.ceil(volumeForOrderCuFt / 0.5);

        if (costCard) {
          if (!isNaN(rawPrice) && rawPrice > 0) {
            costCard.classList.remove('hidden');
            var totalCost = 0;
            if (priceUnit === 'yd3') {
              totalCost = volumeForOrderCuYd * rawPrice;
            } else if (priceUnit === 'ft3') {
              totalCost = volumeForOrderCuFt * rawPrice;
            } else if (priceUnit === 'm3') {
              totalCost = volumeForOrderCuM * rawPrice;
            } else if (priceUnit === 'bag20') {
              totalCost = bags20 * rawPrice;
            } else if (priceUnit === 'bag15') {
              totalCost = bags15 * rawPrice;
            } else if (priceUnit === 'bag05') {
              totalCost = bags05 * rawPrice;
            }

            var elTotalCost = document.getElementById('res-total-cost');
            var elBagCount = document.getElementById('res-bag-count');
            if (elTotalCost) elTotalCost.textContent = currency + totalCost.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            if (elBagCount) elBagCount.textContent = bags20 + ' bags (2.0 ft³) | ' + bags15 + ' bags (1.5 ft³)';
          } else {
            costCard.classList.add('hidden');
          }
        }

        var stepContainer = document.getElementById('res-step-breakdown');
        if (stepContainer) {
          stepContainer.innerHTML = 
            '<div class="space-y-1 text-slate-700 dark:text-slate-300">' +
              '<div>1. <strong>Surface Area Calculation:</strong></div>' +
              '<div class="pl-3 text-slate-500">' + areaFormulaStr + '</div>' +
              '<div class="mt-1">2. <strong>Depth Normalization:</strong></div>' +
              '<div class="pl-3 text-slate-500">' + depthInches.toFixed(2) + ' inches ÷ 12 = ' + depthInFeet.toFixed(4) + ' ft</div>' +
              '<div class="mt-1">3. <strong>Cubic Feet Calculation:</strong></div>' +
              '<div class="pl-3 text-slate-500">Volume = Area (' + areaSqFt.toFixed(2) + ' ft²) × Depth (' + depthInFeet.toFixed(4) + ' ft)' + (quantity > 1 ? ' × ' + quantity + ' qty' : '') + ' = <strong>' + netCuFt.toFixed(2) + ' cu ft</strong></div>' +
              '<div class="mt-1">4. <strong>Cubic Yards Conversion:</strong></div>' +
              '<div class="pl-3 text-slate-500">' + netCuFt.toFixed(2) + ' cu ft ÷ 27 = <strong>' + netCuYds.toFixed(4) + ' yd³</strong></div>' +
              '<div class="mt-1">5. <strong>Metric Conversion:</strong></div>' +
              '<div class="pl-3 text-slate-500">' + netCuFt.toFixed(2) + ' cu ft × 0.028317 = <strong>' + netCuM.toFixed(4) + ' m³</strong></div>' +
              (wastePct > 0 ? 
                '<div class="mt-1 text-orange-600 dark:text-orange-400">6. <strong>Waste Allowance (' + wastePct + '%):</strong></div>' +
                '<div class="pl-3 text-slate-500">' + netCuYds.toFixed(4) + ' yd³ × (1 + ' + (wastePct / 100) + ') = <strong>' + grossCuYds.toFixed(4) + ' yd³</strong></div>'
              : '') +
              (rawPrice > 0 ? 
                '<div class="mt-1 text-emerald-600 dark:text-emerald-400">7. <strong>Estimated Cost:</strong></div>' +
                '<div class="pl-3 text-slate-500">Purchasing via ' + priceUnit + ' = <strong>' + (document.getElementById('res-total-cost')?.textContent || '') + '</strong></div>'
              : '') +
            '</div>';
        }

        var bar = document.getElementById('calc-action-bar-container');
        if (bar) bar.classList.remove('hidden');

        try {
          document.dispatchEvent(new CustomEvent('calculator:updated'));
        } catch (e) {}
      }

      var shapeSel = document.getElementById('sel-shape');
      if (shapeSel) {
        shapeSel.addEventListener('change', function(e) {
          currentShape = e.target.value;
          renderShapeFields(currentShape);
          runCalculation();
        });
      }

      var qtyInp = document.getElementById('inp-quantity');
      if (qtyInp) qtyInp.addEventListener('input', runCalculation);

      var wasteSel = document.getElementById('sel-waste');
      var customWasteWrap = document.getElementById('custom-waste-wrap');
      if (wasteSel) {
        wasteSel.addEventListener('change', function(e) {
          if (e.target.value === 'custom') {
            customWasteWrap?.classList.remove('hidden');
          } else {
            customWasteWrap?.classList.add('hidden');
          }
          runCalculation();
        });
      }

      var customWasteInp = document.getElementById('inp-custom-waste');
      if (customWasteInp) customWasteInp.addEventListener('input', runCalculation);

      var priceInp = document.getElementById('inp-price');
      var priceUnitSel = document.getElementById('sel-price-unit');
      var currencySel = document.getElementById('sel-currency');

      if (priceInp) priceInp.addEventListener('input', runCalculation);
      if (priceUnitSel) priceUnitSel.addEventListener('change', runCalculation);
      if (currencySel) currencySel.addEventListener('change', runCalculation);

      var btnCalc = document.getElementById('btn-calculate');
      if (btnCalc) btnCalc.addEventListener('click', runCalculation);

      var btnReset = document.getElementById('btn-reset');
      if (btnReset) {
        btnReset.addEventListener('click', function() {
          if (shapeSel) shapeSel.value = 'rectangle';
          currentShape = 'rectangle';
          renderShapeFields('rectangle');
          if (qtyInp) qtyInp.value = '1';
          if (wasteSel) wasteSel.value = '0';
          customWasteWrap?.classList.add('hidden');
          if (priceInp) priceInp.value = '';
          runCalculation();
        });
      }

      var btnCopy = document.getElementById('btn-copy-result');
      if (btnCopy) {
        btnCopy.addEventListener('click', function() {
          var yds = document.getElementById('res-cubic-yards')?.textContent || '';
          var ft = document.getElementById('res-cubic-feet')?.textContent || '';
          var m = document.getElementById('res-cubic-meters')?.textContent || '';
          var area = document.getElementById('res-area')?.textContent || '';
          var text = 'Cubic Yards Calculation Result:\nTotal Volume: ' + yds + ' (' + ft + ' / ' + m + ')\nSurface Area: ' + area + '\nCalculated with AI Free Calculator: ' + window.location.href;
          navigator.clipboard.writeText(text).then(function() {
            var old = btnCopy.textContent;
            btnCopy.textContent = '✓ Copied!';
            setTimeout(function() { btnCopy.textContent = old; }, 2000);
          });
        });
      }

      var btnPrint = document.getElementById('btn-print-report');
      if (btnPrint) {
        btnPrint.addEventListener('click', function() {
          var barPrintBtn = document.getElementById('btn-print-calc');
          if (barPrintBtn) {
            barPrintBtn.click();
          } else {
            window.print();
          }
        });
      }

      renderShapeFields('rectangle');
      runCalculation();
    });
  </script>
</CalculatorLayout>
