  <script>
    // Conversion factors to meters
    const TO_METERS: Record<string, number> = {
      meters: 1.0,
      feet: 0.3048,
      inches: 0.0254,
      centimeters: 0.01,
      yards: 0.9144
    };

    const CFT_PER_CUM = 35.3146667;
    const CYD_PER_CUM = 1.30795062;

    function getVal(id: string): number {
      const el = document.getElementById(id) as HTMLInputElement | null;
      return el ? parseFloat(el.value) || 0 : 0;
    }

    function getUnit(id: string): string {
      const el = document.getElementById(id) as HTMLSelectElement | null;
      return el ? el.value : 'meters';
    }

    function toM(val: number, unit: string): number {
      return val * (TO_METERS[unit] || 1.0);
    }

    function getDensityKgM3(): number {
      const sel = document.getElementById('cfg-density') as HTMLSelectElement | null;
      if (!sel) return 2130;
      if (sel.value === 'custom') {
        const inp = document.getElementById('cfg-custom-density') as HTMLInputElement | null;
        return inp ? parseFloat(inp.value) || 2130 : 2130;
      }
      return parseFloat(sel.value) || 2130;
    }

    function getWastageMult(): number {
      const sel = document.getElementById('cfg-wastage') as HTMLSelectElement | null;
      const pct = sel ? parseFloat(sel.value) || 0 : 10;
      return 1 + (pct / 100);
    }

    // Active Results Store
    const resultsStore = {
      slab: { cum: 0.625, cuft: 22.07, cuyd: 0.82, weightKg: 1331.25, weightLb: 2935.53, bags60: 48.93, bags80: 36.69 },
      cylinder: { cum: 0, cuft: 0, cuyd: 0, weightKg: 0, weightLb: 0, bags60: 0, bags80: 0 },
      tube: { cum: 0, cuft: 0, cuyd: 0, weightKg: 0, weightLb: 0, bags60: 0, bags80: 0 },
      curb: { cum: 0, cuft: 0, cuyd: 0, weightKg: 0, weightLb: 0, bags60: 0, bags80: 0 },
      stairs: { cum: 0, cuft: 0, cuyd: 0, weightKg: 0, weightLb: 0, bags60: 0, bags80: 0 },
    };

    let activeTab = 'slab';

    // 1. Calculate Slab
    function calcSlab() {
      const l = toM(getVal('inp-slab-l'), getUnit('unit-slab-l'));
      const w = toM(getVal('inp-slab-w'), getUnit('unit-slab-w'));
      const h = toM(getVal('inp-slab-h'), getUnit('unit-slab-h'));
      const q = Math.max(1, getVal('inp-slab-q'));
      const density = getDensityKgM3();
      const wastage = getWastageMult();

      const netCum = l * w * h * q;
      const totalCum = netCum * wastage;
      const totalCuft = totalCum * CFT_PER_CUM;
      const totalCuyd = totalCuft / 27;

      const weightKg = totalCum * density;
      const weightLb = totalCuft * (density * 0.06242796);
      const bags60 = weightLb / 60;
      const bags80 = weightLb / 80;

      resultsStore.slab = { cum: totalCum, cuft: totalCuft, cuyd: totalCuyd, weightKg, weightLb, bags60, bags80 };

      const elCuft = document.getElementById('res-slab-cuft');
      const elCuyd = document.getElementById('res-slab-cuyd');
      const elCum = document.getElementById('res-slab-cum');
      const elWlb = document.getElementById('res-slab-weight-lb');
      const elWkg = document.getElementById('res-slab-weight-kg');
      const elB60 = document.getElementById('res-slab-bags-60');
      const elB80 = document.getElementById('res-slab-bags-80');

      if (elCuft) elCuft.textContent = totalCuft.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCuyd) elCuyd.textContent = totalCuyd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCum) elCum.textContent = totalCum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elWlb) elWlb.textContent = weightLb.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elWkg) elWkg.textContent = weightKg.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB60) elB60.textContent = bags60.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB80) elB80.textContent = bags80.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      updateMasterSummary();
    }

    // 2. Calculate Cylinder
    function calcCylinder() {
      const d = toM(getVal('inp-cyl-d'), getUnit('unit-cyl-d'));
      const h = toM(getVal('inp-cyl-h'), getUnit('unit-cyl-h'));
      const q = Math.max(1, getVal('inp-cyl-q'));
      const density = getDensityKgM3();
      const wastage = getWastageMult();

      const r = d / 2;
      const netCum = Math.PI * r * r * h * q;
      const totalCum = netCum * wastage;
      const totalCuft = totalCum * CFT_PER_CUM;
      const totalCuyd = totalCuft / 27;

      const weightKg = totalCum * density;
      const weightLb = totalCuft * (density * 0.06242796);
      const bags60 = weightLb / 60;
      const bags80 = weightLb / 80;

      resultsStore.cylinder = { cum: totalCum, cuft: totalCuft, cuyd: totalCuyd, weightKg, weightLb, bags60, bags80 };

      const elCuft = document.getElementById('res-cyl-cuft');
      const elCuyd = document.getElementById('res-cyl-cuyd');
      const elCum = document.getElementById('res-cyl-cum');
      const elWlb = document.getElementById('res-cyl-weight-lb');
      const elWkg = document.getElementById('res-cyl-weight-kg');
      const elB60 = document.getElementById('res-cyl-bags-60');
      const elB80 = document.getElementById('res-cyl-bags-80');

      if (elCuft) elCuft.textContent = totalCuft.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCuyd) elCuyd.textContent = totalCuyd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCum) elCum.textContent = totalCum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elWlb) elWlb.textContent = weightLb.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elWkg) elWkg.textContent = weightKg.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB60) elB60.textContent = bags60.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB80) elB80.textContent = bags80.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      updateMasterSummary();
    }

    // 3. Calculate Tube
    function calcTube() {
      const d1 = toM(getVal('inp-tube-d1'), getUnit('unit-tube-d1'));
      const d2 = toM(getVal('inp-tube-d2'), getUnit('unit-tube-d2'));
      const h = toM(getVal('inp-tube-h'), getUnit('unit-tube-h'));
      const q = Math.max(1, getVal('inp-tube-q'));
      const density = getDensityKgM3();
      const wastage = getWastageMult();

      const r1 = d1 / 2;
      const r2 = Math.min(r1, d2 / 2);
      const area = Math.PI * (r1 * r1 - r2 * r2);
      const netCum = area * h * q;
      const totalCum = netCum * wastage;
      const totalCuft = totalCum * CFT_PER_CUM;
      const totalCuyd = totalCuft / 27;

      const weightKg = totalCum * density;
      const weightLb = totalCuft * (density * 0.06242796);
      const bags60 = weightLb / 60;
      const bags80 = weightLb / 80;

      resultsStore.tube = { cum: totalCum, cuft: totalCuft, cuyd: totalCuyd, weightKg, weightLb, bags60, bags80 };

      const elCuft = document.getElementById('res-tube-cuft');
      const elCuyd = document.getElementById('res-tube-cuyd');
      const elCum = document.getElementById('res-tube-cum');
      const elWlb = document.getElementById('res-tube-weight-lb');
      const elWkg = document.getElementById('res-tube-weight-kg');
      const elB60 = document.getElementById('res-tube-bags-60');
      const elB80 = document.getElementById('res-tube-bags-80');

      if (elCuft) elCuft.textContent = totalCuft.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCuyd) elCuyd.textContent = totalCuyd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCum) elCum.textContent = totalCum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elWlb) elWlb.textContent = weightLb.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elWkg) elWkg.textContent = weightKg.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB60) elB60.textContent = bags60.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB80) elB80.textContent = bags80.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      updateMasterSummary();
    }

    // 4. Calculate Curb
    function calcCurb() {
      const cd = toM(getVal('inp-curb-cd'), getUnit('unit-curb-cd'));
      const gw = toM(getVal('inp-curb-gw'), getUnit('unit-curb-gw'));
      const ch = toM(getVal('inp-curb-ch'), getUnit('unit-curb-ch'));
      const ft = toM(getVal('inp-curb-ft'), getUnit('unit-curb-ft'));
      const l = toM(getVal('inp-curb-l'), getUnit('unit-curb-l'));
      const q = Math.max(1, getVal('inp-curb-q'));
      const density = getDensityKgM3();
      const wastage = getWastageMult();

      const area = (cd * ch) + ((cd + gw) * ft);
      const netCum = area * l * q;
      const totalCum = netCum * wastage;
      const totalCuft = totalCum * CFT_PER_CUM;
      const totalCuyd = totalCuft / 27;

      const weightKg = totalCum * density;
      const weightLb = totalCuft * (density * 0.06242796);
      const bags60 = weightLb / 60;
      const bags80 = weightLb / 80;

      resultsStore.curb = { cum: totalCum, cuft: totalCuft, cuyd: totalCuyd, weightKg, weightLb, bags60, bags80 };

      const elCuft = document.getElementById('res-curb-cuft');
      const elCuyd = document.getElementById('res-curb-cuyd');
      const elCum = document.getElementById('res-curb-cum');
      const elWlb = document.getElementById('res-curb-weight-lb');
      const elWkg = document.getElementById('res-curb-weight-kg');
      const elB60 = document.getElementById('res-curb-bags-60');
      const elB80 = document.getElementById('res-curb-bags-80');

      if (elCuft) elCuft.textContent = totalCuft.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCuyd) elCuyd.textContent = totalCuyd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCum) elCum.textContent = totalCum.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      if (elWlb) elWlb.textContent = weightLb.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elWkg) elWkg.textContent = weightKg.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB60) elB60.textContent = bags60.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB80) elB80.textContent = bags80.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      updateMasterSummary();
    }

    // 5. Calculate Stairs
    function calcStairs() {
      const run = toM(getVal('inp-stair-run'), getUnit('unit-stair-run'));
      const rise = toM(getVal('inp-stair-rise'), getUnit('unit-stair-rise'));
      const w = toM(getVal('inp-stair-w'), getUnit('unit-stair-w'));
      const p = toM(getVal('inp-stair-p'), getUnit('unit-stair-p'));
      const n = Math.max(1, getVal('inp-stair-n'));
      const q = Math.max(1, getVal('inp-stair-q'));
      const density = getDensityKgM3();
      const wastage = getWastageMult();

      const stepArea = run * rise * ((n * (n - 1)) / 2);
      const platArea = p * (n * rise);
      const totalArea = stepArea + platArea;
      const netCum = totalArea * w * q;
      const totalCum = netCum * wastage;
      const totalCuft = totalCum * CFT_PER_CUM;
      const totalCuyd = totalCuft / 27;

      const weightKg = totalCum * density;
      const weightLb = totalCuft * (density * 0.06242796);
      const bags60 = weightLb / 60;
      const bags80 = weightLb / 80;

      resultsStore.stairs = { cum: totalCum, cuft: totalCuft, cuyd: totalCuyd, weightKg, weightLb, bags60, bags80 };

      const elCuft = document.getElementById('res-stair-cuft');
      const elCuyd = document.getElementById('res-stair-cuyd');
      const elCum = document.getElementById('res-stair-cum');
      const elWlb = document.getElementById('res-stair-weight-lb');
      const elWkg = document.getElementById('res-stair-weight-kg');
      const elB60 = document.getElementById('res-stair-bags-60');
      const elB80 = document.getElementById('res-stair-bags-80');

      if (elCuft) elCuft.textContent = totalCuft.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elCuyd) elCuyd.textContent = totalCuyd.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      if (elCum) elCum.textContent = totalCum.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
      if (elWlb) elWlb.textContent = weightLb.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elWkg) elWkg.textContent = weightKg.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB60) elB60.textContent = bags60.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elB80) elB80.textContent = bags80.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      updateMasterSummary();
    }

    function showAndScrollToResult() {
      const resultSec = document.getElementById('concrete-master-result');
      if (resultSec) {
        resultSec.classList.remove('hidden');
        resultSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Update Project Master BOQ
    function updateMasterSummary() {
      const chkViewAll = document.getElementById('chk-view-all') as HTMLInputElement | null;
      const isAll = chkViewAll ? chkViewAll.checked : false;

      let totCum = 0;
      let totCuft = 0;
      let totCuyd = 0;
      let totBags60 = 0;
      let totBags80 = 0;
      let totWeightLb = 0;
      let totWeightKg = 0;

      if (isAll) {
        for (const key of Object.keys(resultsStore) as (keyof typeof resultsStore)[]) {
          totCum += resultsStore[key].cum;
          totCuft += resultsStore[key].cuft;
          totCuyd += resultsStore[key].cuyd;
          totBags60 += resultsStore[key].bags60;
          totBags80 += resultsStore[key].bags80;
          totWeightLb += resultsStore[key].weightLb;
          totWeightKg += resultsStore[key].weightKg;
        }
      } else {
        const curr = resultsStore[activeTab as keyof typeof resultsStore] || resultsStore.slab;
        totCum = curr.cum;
        totCuft = curr.cuft;
        totCuyd = curr.cuyd;
        totBags60 = curr.bags60;
        totBags80 = curr.bags80;
        totWeightLb = curr.weightLb;
        totWeightKg = curr.weightKg;
      }

      const elTotCyd = document.getElementById('res-tot-cyd');
      const elTotCft = document.getElementById('res-tot-cft');
      const elTotCum = document.getElementById('res-tot-cum');
      const elTotLit = document.getElementById('res-tot-liters');
      const elTotB60 = document.getElementById('res-tot-bags60');
      const elTotB80 = document.getElementById('res-tot-bags80');
      const elTotWeightLb = document.getElementById('res-tot-weight-lb');
      const elTotWeightKg = document.getElementById('res-tot-weight-kg');

      if (elTotCyd) elTotCyd.textContent = `${totCuyd.toFixed(2)} yd³`;
      if (elTotCft) elTotCft.textContent = `${totCuft.toFixed(2)} ft³`;
      if (elTotCum) elTotCum.textContent = `${totCum.toFixed(2)} m³`;
      if (elTotLit) elTotLit.textContent = `${Math.round(totCum * 1000)} Liters`;
      if (elTotB60) elTotB60.textContent = `${Math.ceil(totBags60)} Bags`;
      if (elTotB80) elTotB80.textContent = `${Math.ceil(totBags80)} Bags`;
      if (elTotWeightLb) elTotWeightLb.textContent = `${Math.round(totWeightLb).toLocaleString('en-US')} lbs`;
      if (elTotWeightKg) elTotWeightKg.textContent = `${Math.round(totWeightKg).toLocaleString('en-US')} kg`;

      const selWastage = document.getElementById('cfg-wastage') as HTMLSelectElement | null;
      const elTotWastage = document.getElementById('res-tot-wastage');
      if (elTotWastage && selWastage) elTotWastage.textContent = `${selWastage.value}%`;

      const elTotDensity = document.getElementById('res-tot-density');
      if (elTotDensity) {
        const density = getDensityKgM3();
        const densityLb = Math.round(density * 0.06242796);
        elTotDensity.textContent = `${density.toLocaleString('en-US')} kg/m³ (${densityLb} lbs/ft³)`;
      }

      // Update Raw Material Mix Breakup (dry volume factor 1.54)
      const selMix = document.getElementById('sel-mix-ratio') as HTMLSelectElement | null;
      const mixKey = selMix ? selMix.value : '1:2:4';
      let cPart = 1, sPart = 2, aPart = 4;
      if (mixKey === '1:1.5:3') { cPart = 1; sPart = 1.5; aPart = 3; }
      else if (mixKey === '1:1:2') { cPart = 1; sPart = 1; aPart = 2; }
      else if (mixKey === '1:3:6') { cPart = 1; sPart = 3; aPart = 6; }

      const sumParts = cPart + sPart + aPart;
      const dryVol = totCum * 1.54;
      const cementVolM3 = (dryVol * cPart) / sumParts;
      const cementBags50kg = (cementVolM3 * 1440) / 50;
      const sandCft = ((dryVol * sPart) / sumParts) * CFT_PER_CUM;
      const sandTons = (sandCft * 45) / 1000;
      const aggCft = ((dryVol * aPart) / sumParts) * CFT_PER_CUM;
      const aggTons = (aggCft * 48) / 1000;
      const waterLiters = cementBags50kg * 28;
      const waterGal = waterLiters * 0.264172;

      const elRawC = document.getElementById('res-raw-cement');
      const elRawS = document.getElementById('res-raw-sand');
      const elRawA = document.getElementById('res-raw-agg');
      const elRawW = document.getElementById('res-raw-water');

      if (elRawC) elRawC.textContent = `~${cementBags50kg.toFixed(1)} Bags (50kg)`;
      if (elRawS) elRawS.textContent = `~${sandCft.toFixed(1)} cft (${sandTons.toFixed(2)} t)`;
      if (elRawA) elRawA.textContent = `~${aggCft.toFixed(1)} cft (${aggTons.toFixed(2)} t)`;
      if (elRawW) elRawW.textContent = `~${Math.round(waterLiters)} L (${Math.round(waterGal)} gal)`;
    }

    // Switch Shape Tab
    function setShapeTab(tabId: string) {
      activeTab = tabId;
      const chkViewAll = document.getElementById('chk-view-all') as HTMLInputElement | null;
      const isAll = chkViewAll ? chkViewAll.checked : false;

      const btns = document.querySelectorAll('.shape-tab-btn');
      btns.forEach((btn) => {
        const b = btn as HTMLButtonElement;
        if (b.dataset.tab === tabId) {
          b.className = 'shape-tab-btn active flex items-center justify-center gap-1.5 rounded-xl border border-blue-600 bg-blue-50 px-3 py-2.5 text-xs font-bold text-blue-700 shadow-xs transition dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer';
        } else {
          b.className = 'shape-tab-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer';
        }
      });

      const sections = document.querySelectorAll('.shape-section');
      sections.forEach((sec) => {
        const s = sec as HTMLElement;
        if (isAll) {
          s.classList.remove('hidden');
        } else {
          if (s.id === `section-${tabId}`) {
            s.classList.remove('hidden');
          } else {
            s.classList.add('hidden');
          }
        }
      });

      updateMasterSummary();
    }

    // Attach Event Listeners on DOM Ready
    function init() {
      // Calculate buttons - trigger calculation, reveal result and scroll to it
      document.getElementById('btn-calc-slab')?.addEventListener('click', () => {
        calcSlab();
        showAndScrollToResult();
      });
      document.getElementById('btn-calc-cyl')?.addEventListener('click', () => {
        calcCylinder();
        showAndScrollToResult();
      });
      document.getElementById('btn-calc-tube')?.addEventListener('click', () => {
        calcTube();
        showAndScrollToResult();
      });
      document.getElementById('btn-calc-curb')?.addEventListener('click', () => {
        calcCurb();
        showAndScrollToResult();
      });
      document.getElementById('btn-calc-stair')?.addEventListener('click', () => {
        calcStairs();
        showAndScrollToResult();
      });

      // Real-time recalculation on any input changes (updates values if result is currently open)
      const allInputs = document.querySelectorAll('#shapes-container input, #shapes-container select, #cfg-density, #cfg-wastage, #cfg-custom-density, #sel-mix-ratio');
      allInputs.forEach((inp) => {
        const handleInput = () => {
          calcSlab();
          calcCylinder();
          calcTube();
          calcCurb();
          calcStairs();
        };
        inp.addEventListener('input', handleInput);
        inp.addEventListener('change', handleInput);
      });

      // Clear buttons - reset inputs and hide master result
      document.getElementById('btn-clear-slab')?.addEventListener('click', () => {
        const elL = document.getElementById('inp-slab-l') as HTMLInputElement | null;
        const elW = document.getElementById('inp-slab-w') as HTMLInputElement | null;
        const elH = document.getElementById('inp-slab-h') as HTMLInputElement | null;
        if (elL) elL.value = '0';
        if (elW) elW.value = '0';
        if (elH) elH.value = '0';
        calcSlab();
        document.getElementById('concrete-master-result')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-cyl')?.addEventListener('click', () => {
        const elD = document.getElementById('inp-cyl-d') as HTMLInputElement | null;
        const elH = document.getElementById('inp-cyl-h') as HTMLInputElement | null;
        if (elD) elD.value = '0';
        if (elH) elH.value = '0';
        calcCylinder();
        document.getElementById('concrete-master-result')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-tube')?.addEventListener('click', () => {
        const elD1 = document.getElementById('inp-tube-d1') as HTMLInputElement | null;
        const elD2 = document.getElementById('inp-tube-d2') as HTMLInputElement | null;
        const elH = document.getElementById('inp-tube-h') as HTMLInputElement | null;
        if (elD1) elD1.value = '0';
        if (elD2) elD2.value = '0';
        if (elH) elH.value = '0';
        calcTube();
        document.getElementById('concrete-master-result')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-curb')?.addEventListener('click', () => {
        const elCd = document.getElementById('inp-curb-cd') as HTMLInputElement | null;
        const elGw = document.getElementById('inp-curb-gw') as HTMLInputElement | null;
        const elCh = document.getElementById('inp-curb-ch') as HTMLInputElement | null;
        const elFt = document.getElementById('inp-curb-ft') as HTMLInputElement | null;
        const elL = document.getElementById('inp-curb-l') as HTMLInputElement | null;
        if (elCd) elCd.value = '0';
        if (elGw) elGw.value = '0';
        if (elCh) elCh.value = '0';
        if (elFt) elFt.value = '0';
        if (elL) elL.value = '0';
        calcCurb();
        document.getElementById('concrete-master-result')?.classList.add('hidden');
      });

      document.getElementById('btn-clear-stair')?.addEventListener('click', () => {
        const elRun = document.getElementById('inp-stair-run') as HTMLInputElement | null;
        const elRise = document.getElementById('inp-stair-rise') as HTMLInputElement | null;
        const elW = document.getElementById('inp-stair-w') as HTMLInputElement | null;
        const elP = document.getElementById('inp-stair-p') as HTMLInputElement | null;
        if (elRun) elRun.value = '0';
        if (elRise) elRise.value = '0';
        if (elW) elW.value = '0';
        if (elP) elP.value = '0';
        calcStairs();
        document.getElementById('concrete-master-result')?.classList.add('hidden');
      });

      // Quick Preset buttons
      const presetBtns = document.querySelectorAll('.btn-quick-preset');
      presetBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const b = e.currentTarget as HTMLButtonElement;
          const target = b.dataset.target || 'slab';
          setShapeTab(target);

          if (target === 'slab') {
            (document.getElementById('inp-slab-l') as HTMLInputElement).value = b.dataset.l || '5';
            (document.getElementById('unit-slab-l') as HTMLSelectElement).value = b.dataset.lu || 'meters';
            (document.getElementById('inp-slab-w') as HTMLInputElement).value = b.dataset.w || '2.5';
            (document.getElementById('unit-slab-w') as HTMLSelectElement).value = b.dataset.wu || 'meters';
            (document.getElementById('inp-slab-h') as HTMLInputElement).value = b.dataset.h || '5';
            (document.getElementById('unit-slab-h') as HTMLSelectElement).value = b.dataset.hu || 'centimeters';
            (document.getElementById('inp-slab-q') as HTMLInputElement).value = b.dataset.q || '1';
            calcSlab();
          } else if (target === 'cylinder') {
            (document.getElementById('inp-cyl-d') as HTMLInputElement).value = b.dataset.d || '2.5';
            (document.getElementById('unit-cyl-d') as HTMLSelectElement).value = b.dataset.du || 'meters';
            (document.getElementById('inp-cyl-h') as HTMLInputElement).value = b.dataset.h || '6';
            (document.getElementById('unit-cyl-h') as HTMLSelectElement).value = b.dataset.hu || 'meters';
            (document.getElementById('inp-cyl-q') as HTMLInputElement).value = b.dataset.q || '1';
            calcCylinder();
          } else if (target === 'tube') {
            (document.getElementById('inp-tube-d1') as HTMLInputElement).value = b.dataset.d1 || '5';
            (document.getElementById('unit-tube-d1') as HTMLSelectElement).value = b.dataset.d1u || 'meters';
            (document.getElementById('inp-tube-d2') as HTMLInputElement).value = b.dataset.d2 || '4';
            (document.getElementById('unit-tube-d2') as HTMLSelectElement).value = b.dataset.d2u || 'meters';
            (document.getElementById('inp-tube-h') as HTMLInputElement).value = b.dataset.h || '6';
            (document.getElementById('unit-tube-h') as HTMLSelectElement).value = b.dataset.hu || 'centimeters';
            (document.getElementById('inp-tube-q') as HTMLInputElement).value = b.dataset.q || '1';
            calcTube();
          } else if (target === 'curb') {
            (document.getElementById('inp-curb-cd') as HTMLInputElement).value = b.dataset.cd || '4';
            (document.getElementById('unit-curb-cd') as HTMLSelectElement).value = b.dataset.cdu || 'centimeters';
            (document.getElementById('inp-curb-gw') as HTMLInputElement).value = b.dataset.gw || '10';
            (document.getElementById('unit-curb-gw') as HTMLSelectElement).value = b.dataset.gwu || 'centimeters';
            (document.getElementById('inp-curb-ch') as HTMLInputElement).value = b.dataset.ch || '4';
            (document.getElementById('unit-curb-ch') as HTMLSelectElement).value = b.dataset.chu || 'centimeters';
            (document.getElementById('inp-curb-ft') as HTMLInputElement).value = b.dataset.ft || '5';
            (document.getElementById('unit-curb-ft') as HTMLSelectElement).value = b.dataset.ftu || 'centimeters';
            (document.getElementById('inp-curb-l') as HTMLInputElement).value = b.dataset.l || '10';
            (document.getElementById('unit-curb-l') as HTMLSelectElement).value = b.dataset.lu || 'meters';
            (document.getElementById('inp-curb-q') as HTMLInputElement).value = b.dataset.q || '1';
            calcCurb();
          } else if (target === 'stairs') {
            (document.getElementById('inp-stair-run') as HTMLInputElement).value = b.dataset.run || '12';
            (document.getElementById('unit-stair-run') as HTMLSelectElement).value = b.dataset.runu || 'centimeters';
            (document.getElementById('inp-stair-rise') as HTMLInputElement).value = b.dataset.rise || '6';
            (document.getElementById('unit-stair-rise') as HTMLSelectElement).value = b.dataset.riseu || 'centimeters';
            (document.getElementById('inp-stair-w') as HTMLInputElement).value = b.dataset.w || '50';
            (document.getElementById('unit-stair-w') as HTMLSelectElement).value = b.dataset.wu || 'centimeters';
            (document.getElementById('inp-stair-p') as HTMLInputElement).value = b.dataset.p || '5';
            (document.getElementById('unit-stair-p') as HTMLSelectElement).value = b.dataset.pu || 'centimeters';
            (document.getElementById('inp-stair-n') as HTMLInputElement).value = b.dataset.risers || '5';
            (document.getElementById('inp-stair-q') as HTMLInputElement).value = b.dataset.q || '1';
            calcStairs();
          }
          showAndScrollToResult();
        });
      });

      // Density selector
      document.getElementById('cfg-density')?.addEventListener('change', (e) => {
        const val = (e.target as HTMLSelectElement).value;
        const wrap = document.getElementById('cfg-custom-density-wrap');
        if (wrap) {
          wrap.style.display = val === 'custom' ? 'flex' : 'none';
        }
        calcSlab();
        calcCylinder();
        calcTube();
        calcCurb();
        calcStairs();
      });

      // Shape tab buttons
      const tabBtns = document.querySelectorAll('.shape-tab-btn');
      tabBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const tab = (e.currentTarget as HTMLButtonElement).dataset.tab || 'slab';
          setShapeTab(tab);
        });
      });

      // Show All checkbox
      document.getElementById('chk-view-all')?.addEventListener('change', () => {
        setShapeTab(activeTab);
      });

      // Print Summary Button
      document.getElementById('btn-print-summary')?.addEventListener('click', () => {
        window.print();
      });

      // Initial Calculations
      calcSlab();
      calcCylinder();
      calcTube();
      calcCurb();
      calcStairs();
      setShapeTab('slab');

      // Ensure Master Result section is hidden by default until Calculate button is clicked
      document.getElementById('concrete-master-result')?.classList.add('hidden');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</CalculatorLayout>
