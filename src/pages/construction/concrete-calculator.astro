        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Slab Formula -->
          <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-blue-700 dark:text-blue-300 uppercase">1. Slabs, Walls &amp; Square Footings</h4>
            <div class="font-mono text-xs font-bold bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200">
              Volume = Length × Width × Thickness × Quantity
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400">
              In Imperial units: (Length in ft × Width in ft × Thickness in inches / 12) ÷ 27 = <strong>Cubic Yards</strong>.
            </p>
          </div>

          <!-- Cylinder Formula -->
          <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-blue-700 dark:text-blue-300 uppercase">2. Cylinders, Round Footings &amp; Sonotubes</h4>
            <div class="font-mono text-xs font-bold bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200">
              Volume = π × (Diameter / 2)² × Height × Quantity
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400">
              In Imperial units: π × (Radius in ft)² × Height in ft ÷ 27 = <strong>Cubic Yards</strong>.
            </p>
          </div>

          <!-- Circular Tube Formula -->
          <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-blue-700 dark:text-blue-300 uppercase">3. Circular Slab or Tube (Hollow Ring)</h4>
            <div class="font-mono text-xs font-bold bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200">
              Volume = [π/4 × (d₁² - d₂²)] × Height × Quantity
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400">
              Subtract the inner core volume from the outer cylinder volume to determine concrete required for pipe walls or well rings.
            </p>
          </div>

          <!-- Curb and Gutter Formula -->
          <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 space-y-2">
            <h4 class="text-xs font-bold text-blue-700 dark:text-blue-300 uppercase">4. Curb &amp; Gutter Barrier</h4>
            <div class="font-mono text-xs font-bold bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200">
              Area = (Curb Depth × Curb Height) + [(Curb Depth + Gutter Width) × Flag Thickness]
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400">
              Volume = Area × Total Length × Quantity.
            </p>
          </div>

          <!-- Stairs Formula -->
          <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/40 space-y-2 md:col-span-2">
            <h4 class="text-xs font-bold text-blue-700 dark:text-blue-300 uppercase">5. Concrete Stairs &amp; Steps</h4>
            <div class="font-mono text-xs font-bold bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200">
              Total Area = [Run × Rise × N × (N - 1) ÷ 2] + [Platform Depth × N × Rise]
