---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";

const faqs = [
  {
    q: "How do I calculate how much concrete I need?",
    a: "To calculate concrete volume, multiply Length × Width × Thickness (in feet) to find cubic feet, then divide by 27 to convert to cubic yards. For cylindrical footings, use π × radius² × depth. For stairs and curbs, break the structure into geometric components. Always add 5% to 10% extra for wastage, subgrade unevenness, and formwork deflection."
  },
  {
    q: "How many 80-lb bags of concrete make a cubic yard?",
    a: "It takes exactly 45 bags of 80-lb pre-mixed concrete to make one cubic yard (27 cubic feet) of mixed concrete. Each 80-lb bag yields approximately 0.60 cubic feet."
  },
  {
    q: "How many 60-lb bags of concrete make a cubic yard?",
    a: "It takes 60 bags of 60-lb pre-mixed concrete to make one cubic yard (27 cubic feet). Each 60-lb bag yields approximately 0.45 cubic feet of solid concrete."
  },
  {
    q: "How many bags of concrete do I need for a 10x10 slab that is 4 inches thick?",
    a: "A 10 ft × 10 ft slab at 4 inches (0.333 ft) thick has a volume of 33.33 cubic feet (1.23 cubic yards). You will need approximately 56 bags of 80-lb concrete or 74 bags of 60-lb concrete (including a 10% safety margin)."
  },
  {
    q: "What is the standard density of concrete?",
    a: "Standard bagged pre-mixed dry concrete has an in-place density of approximately 133 lbs/ft³ (2,130 kg/m³). Structural normal-weight ready-mix concrete with coarse stone aggregate typically weighs 145 to 150 lbs/ft³ (2,320 to 2,400 kg/m³)."
  },
  {
    q: "How do you calculate concrete for stairs?",
    a: "Concrete stairs volume equals the cumulative volume of each step wedge plus the top platform/landing. For N risers, the steps cross-sectional area is Run × Rise × [N × (N - 1) / 2], plus Platform Depth × (N × Rise) for the landing, multiplied by the staircase width."
  },
  {
    q: "How do you calculate concrete for a curb and gutter barrier?",
    a: "Calculate the two cross-sectional areas: (1) Curb section above the gutter = Curb Depth × Curb Height; (2) Base flag slab = (Curb Depth + Gutter Width) × Flag Thickness. Add the areas together and multiply by the total curb length."
  },
  {
    q: "Can I download or print a bill of quantities (BOQ) PDF report?",
    a: "Yes. Click 'Print / Save Report' or 'Download PDF' to generate an itemized, client-ready summary complete with geometric dimensions, volumes in cubic yards/meters, required pre-mixed bags, density assumptions, and estimated costs."
  }
];
---

<CalculatorLayout
  title="Concrete Calculator – Slabs, Footings, Columns, Tubes, Curbs & Stairs | AI Free Calculator"
  description="Free online concrete calculator to estimate concrete volume in cubic yards, cubic feet, and cubic meters, plus weight and 60-lb / 80-lb bag counts for slabs, walls, footings, round columns, tubes, curb & gutter, and stairs."
  category="Construction"
  calculatorName="Concrete Calculator"
  slug="concrete-calculator"
  keywords={[
    "concrete calculator",
    "concrete volume calculator",
    "concrete bags calculator",
    "concrete slab calculator",
    "concrete footing calculator",
    "concrete column calculator",
    "concrete tube calculator",
    "curb and gutter concrete calculator",
    "concrete stairs calculator",
    "how many bags of concrete",
    "cubic yards of concrete",
    "concrete weight calculator",
    "concrete mix ratio",
    "ready mix concrete calculator"
  ]}
>
  <div class="space-y-6">

    <!-- HERO HEADER & DESCRIPTION -->
    <div class="rounded-3xl border border-slate-200/90 bg-linear-to-r from-blue-50/60 via-indigo-50/40 to-white p-5 dark:border-slate-800 dark:from-slate-900 dark:via-blue-950/20 dark:to-slate-900 sm:p-6 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-blue-100/80 px-3 py-1 text-xs font-bold text-blue-800 dark:bg-blue-900/60 dark:text-blue-300 mb-2">
            <span>🏗️</span> All-in-One Civil & DIY Concrete Estimator
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
            Concrete Calculator
          </h1>
          <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
            Estimates the volume, weight, and pre-mixed bag quantities (60-lb &amp; 80-lb) of concrete necessary to cover any given area or structure.
            Purchasing slightly more concrete (5%–10% wastage) than the estimated result ensures you won't fall short during a pour.
          </p>
        </div>

        <!-- GLOBAL DENSITY & WASTAGE SETTINGS -->
        <div class="shrink-0 flex flex-wrap sm:flex-col gap-2 rounded-2xl border border-slate-200/80 bg-white/90 p-3 shadow-2xs dark:border-slate-800 dark:bg-slate-950/80 text-xs">
          <div class="flex items-center justify-between gap-3">
            <span class="font-bold text-slate-700 dark:text-slate-300">Concrete Density:</span>
            <select id="cfg-density" class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 cursor-pointer">
              <option value="2130" selected>Pre-mixed (2,130 kg/m³ / 133 lbs/ft³)</option>
              <option value="2400">Normal Structural (2,400 kg/m³ / 150 lbs/ft³)</option>
              <option value="1760">Lightweight (1,760 kg/m³ / 110 lbs/ft³)</option>
              <option value="custom">Custom Density...</option>
            </select>
          </div>
          <div id="cfg-custom-density-wrap" class="flex items-center justify-between gap-2 mt-1" style="display: none;">
            <span class="text-[11px] text-slate-500">kg/m³:</span>
            <input type="number" id="cfg-custom-density" value="2130" min="500" max="4000" class="w-24 rounded border border-slate-300 px-1.5 py-0.5 text-xs text-right font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="font-bold text-slate-700 dark:text-slate-300">Safety Wastage:</span>
            <select id="cfg-wastage" class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 cursor-pointer">
              <option value="0">0% (Exact Net Volume)</option>
              <option value="5">5% (Light Margin)</option>
              <option value="10" selected>10% (Recommended Standard)</option>
              <option value="15">15% (Rough/Uneven Subgrade)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- QUICK PRESETS -->
      <div class="mt-4 pt-3 border-t border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="slab" data-l="10" data-lu="feet" data-w="10" data-wu="feet" data-h="4" data-hu="inches" data-q="1">10' × 10' × 4" Patio Slab</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="slab" data-l="5" data-lu="meters" data-w="2.5" data-wu="meters" data-h="5" data-hu="centimeters" data-q="1">5m × 2.5m × 5cm Slab</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="cylinder" data-d="2.5" data-du="meters" data-h="6" data-hu="meters" data-q="1">2.5m Dia × 6m Cylinder Column</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tube" data-d1="5" data-d1u="meters" data-d2="4" data-d2u="meters" data-h="6" data-hu="centimeters" data-q="1">5m OD × 4m ID Circular Tube</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="curb" data-cd="4" data-cdu="centimeters" data-gw="10" data-gwu="centimeters" data-ch="4" data-chu="centimeters" data-ft="5" data-ftu="centimeters" data-l="10" data-lu="meters" data-q="1">10m Curb &amp; Gutter Barrier</button>
        <button type="button" class="btn-quick-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="stairs" data-run="12" data-runu="centimeters" data-rise="6" data-riseu="centimeters" data-w="50" data-wu="centimeters" data-p="5" data-pu="centimeters" data-risers="5" data-q="1">5-Step Concrete Staircase</button>
      </div>
    </div>

    <!-- VIEW & SHAPE NAVIGATION SELECTOR TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2 shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2 dark:border-slate-800/80 mb-2">
        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
          <span>📐</span> Choose Concrete Shape / Mode:
        </span>
        <div class="flex items-center gap-2">
          <label class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer">
            <input type="checkbox" id="chk-view-all" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
            <span>Show All 5 Shapes on Single Page</span>
          </label>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-1.5 sm:grid-cols-3 lg:grid-cols-5" id="shape-tab-buttons">
        <button
          type="button"
          data-tab="slab"
          class="shape-tab-btn active flex items-center justify-center gap-1.5 rounded-xl border border-blue-600 bg-blue-50 px-3 py-2.5 text-xs font-bold text-blue-700 shadow-xs transition dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer"
        >
          <span>📦</span> Slabs, Footings &amp; Walls
        </button>
        <button
          type="button"
          data-tab="cylinder"
          class="shape-tab-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>🏛️</span> Cylinder &amp; Columns
        </button>
        <button
          type="button"
          data-tab="tube"
          class="shape-tab-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>⭕</span> Circular Slab or Tube
        </button>
        <button
          type="button"
          data-tab="curb"
          class="shape-tab-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>🛣️</span> Curb &amp; Gutter Barrier
        </button>
        <button
          type="button"
          data-tab="stairs"
          class="shape-tab-btn flex items-center justify-center gap-1.5 rounded-xl border border-transparent bg-slate-50 px-3 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700/60 transition cursor-pointer"
        >
          <span>🪜</span> Stairs &amp; Steps
        </button>
      </div>
    </div>

    <!-- CALCULATOR FORMS CONTAINER -->
    <div id="shapes-container" class="space-y-8">

      <!-- ========================================================================= -->
      <!-- SHAPE 1: SLABS, SQUARE FOOTINGS, OR WALLS -->
      <!-- ========================================================================= -->
      <section id="section-slab" class="shape-section rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-5">
        <div class="border-b border-slate-100 pb-3 dark:border-slate-800 flex items-center justify-between">
          <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-blue-600 dark:text-blue-400">1.</span> Slabs, Square Footings, or Walls
          </h2>
          <span class="text-xs font-semibold text-slate-500 bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-lg">
            Rectangular Prism
          </span>
        </div>



        <!-- FORM & DIAGRAM GRID -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-center">
          <!-- Inputs Column -->
          <div class="md:col-span-7 space-y-3 rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-950/50">
            <div class="grid grid-cols-12 gap-2 items-center">
              <label for="inp-slab-l" class="col-span-4 text-xs font-bold text-slate-700 dark:text-slate-300">
                Length (l)
              </label>
              <div class="col-span-4">
                <input type="number" id="inp-slab-l" value="5" min="0.001" step="any" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div class="col-span-4">
                <select id="unit-slab-l" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                  <option value="meters" selected>meters</option>
                  <option value="feet">feet</option>
                  <option value="inches">inches</option>
                  <option value="centimeters">centimeters</option>
                  <option value="yards">yards</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-12 gap-2 items-center">
              <label for="inp-slab-w" class="col-span-4 text-xs font-bold text-slate-700 dark:text-slate-300">
                Width (w)
              </label>
              <div class="col-span-4">
                <input type="number" id="inp-slab-w" value="2.5" min="0.001" step="any" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div class="col-span-4">
                <select id="unit-slab-w" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                  <option value="meters" selected>meters</option>
                  <option value="feet">feet</option>
                  <option value="inches">inches</option>
                  <option value="centimeters">centimeters</option>
                  <option value="yards">yards</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-12 gap-2 items-center">
              <label for="inp-slab-h" class="col-span-4 text-xs font-bold text-slate-700 dark:text-slate-300">
                Thickness or Height (h)
              </label>
              <div class="col-span-4">
                <input type="number" id="inp-slab-h" value="5" min="0.001" step="any" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div class="col-span-4">
                <select id="unit-slab-h" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                  <option value="centimeters" selected>centimeters</option>
                  <option value="meters">meters</option>
                  <option value="feet">feet</option>
                  <option value="inches">inches</option>
                  <option value="yards">yards</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-12 gap-2 items-center">
              <label for="inp-slab-q" class="col-span-4 text-xs font-bold text-slate-700 dark:text-slate-300">
                Quantity
              </label>
              <div class="col-span-4">
                <input type="number" id="inp-slab-q" value="1" min="1" step="1" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 pt-2">
              <button type="button" id="btn-calc-slab" class="flex items-center gap-1.5 rounded-lg bg-emerald-700 px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-emerald-800 transition cursor-pointer">
                <span>Calculate</span> <span class="text-[10px]">▶</span>
              </button>
              <button type="button" id="btn-clear-slab" class="rounded-lg bg-slate-400 px-4 py-2 text-xs font-bold text-white hover:bg-slate-500 transition cursor-pointer">
                Clear
              </button>
            </div>
          </div>

          <!-- SVG Diagram Column -->
          <div class="md:col-span-5 flex flex-col items-center justify-center p-3">
            <svg viewBox="0 0 240 160" class="w-full max-w-56 h-auto drop-shadow-xs">
              <!-- Isometric Box -->
              <polygon points="40,90 140,90 140,130 40,130" fill="#f8fafc" stroke="#1e293b" stroke-width="2" stroke-dasharray="none" />
              <polygon points="140,90 190,50 190,90 140,130" fill="#e2e8f0" stroke="#1e293b" stroke-width="2" />
              <polygon points="40,90 90,50 190,50 140,90" fill="#cbd5e1" stroke="#1e293b" stroke-width="2" />
              <!-- Hidden dashed edges -->
              <line x1="40" y1="90" x2="90" y2="50" stroke="#94a3b8" stroke-dasharray="3,3" />
              <line x1="90" y1="50" x2="90" y2="90" stroke="#94a3b8" stroke-dasharray="3,3" />
              <line x1="90" y1="90" x2="190" y2="90" stroke="#94a3b8" stroke-dasharray="3,3" />
              <line x1="40" y1="130" x2="90" y2="90" stroke="#94a3b8" stroke-dasharray="3,3" />
              <!-- Dimension markers -->
              <text x="85" y="146" fill="#1d4ed8" font-size="14" font-weight="bold" font-family="monospace">l</text>
              <text x="175" y="120" fill="#1d4ed8" font-size="14" font-weight="bold" font-family="monospace">w</text>
              <text x="198" y="73" fill="#1d4ed8" font-size="14" font-weight="bold" font-family="monospace">h</text>
            </svg>
            <span class="text-[11px] text-slate-500 font-medium mt-1">Slab / Footing / Wall Box</span>
          </div>
        </div>
      </section>

      <!-- ========================================================================= -->
      <!-- SHAPE 2: CYLINDER, ROUND FOOTINGS, OR ROUND COLUMNS -->
      <!-- ========================================================================= -->
      <section id="section-cylinder" class="shape-section rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-5">
        <div class="border-b border-slate-100 pb-3 dark:border-slate-800 flex items-center justify-between">
          <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
            <span class="text-blue-600 dark:text-blue-400">2.</span> Cylinder, Round Footings, or Round Columns
          </h2>
          <span class="text-xs font-semibold text-slate-500 bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-lg">
            Solid Cylinder
          </span>
        </div>



        <!-- FORM & DIAGRAM GRID -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-center">
          <!-- Inputs Column -->
          <div class="md:col-span-7 space-y-3 rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-950/50">
            <div class="grid grid-cols-12 gap-2 items-center">
              <label for="inp-cyl-d" class="col-span-4 text-xs font-bold text-slate-700 dark:text-slate-300">
                Diameter (d)
              </label>
              <div class="col-span-4">
                <input type="number" id="inp-cyl-d" value="2.5" min="0.001" step="any" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div class="col-span-4">
                <select id="unit-cyl-d" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                  <option value="meters" selected>meters</option>
                  <option value="feet">feet</option>
                  <option value="inches">inches</option>
                  <option value="centimeters">centimeters</option>
                  <option value="yards">yards</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-12 gap-2 items-center">
              <label for="inp-cyl-h" class="col-span-4 text-xs font-bold text-slate-700 dark:text-slate-300">
                Depth or Height (h)
              </label>
              <div class="col-span-4">
                <input type="number" id="inp-cyl-h" value="6" min="0.001" step="any" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
              </div>
              <div class="col-span-4">
                <select id="unit-cyl-h" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                  <option value="meters" selected>meters</option>
                  <option value="feet">feet</option>
                  <option value="inches">inches</option>
                  <option value="centimeters">centimeters</option>
                  <option value="yards">yards</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-12 gap-2 items-center">
              <label for="inp-cyl-q" class="col-span-4 text-xs font-bold text-slate-700 dark:text-slate-300">
                Quantity
