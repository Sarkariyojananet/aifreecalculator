            <rect x="40" y="92" width="8" height="8" class="fill-none stroke-blue-600 dark:stroke-blue-400" stroke-width="1" />
            <text x="45" y="60" font-size="9" class="fill-blue-600 dark:fill-blue-400 font-bold">Height</text>
