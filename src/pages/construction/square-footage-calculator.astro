          </svg>
        `;
        if (caption) caption.textContent = 'Triangle: ½ × Base × Height';
      } else if (shapeKey === 'trapezoid') {
        svg = `
          <svg viewBox="0 0 160 100" class="w-36 h-24 stroke-slate-800 dark:stroke-slate-200 fill-slate-200 dark:fill-slate-800 stroke-[2.5]">
