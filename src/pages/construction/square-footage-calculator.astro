---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";

const faqs = [
  {
    question: "How do I calculate square footage for different shapes?",
    answer: "For rectangles and squares, multiply Length × Width in feet. For circles, use π × radius² (or π × (diameter/2)²). For triangles, use ½ × Base × Height or Heron's formula if all three sides are known. For complex or L-shaped rooms, divide the floor plan into separate geometric sections, calculate each section's area, and add them together."
  },
  {
    question: "Can I convert between square feet and other units using this calculator?",
    answer: "Yes. The calculator automatically converts square footage into square inches (multiply by 144), square yards (divide by 9), square meters (multiply by 0.092903 / divide by 10.7639), and acres (divide by 43,560)."
  },
  {
    question: "How do I measure and estimate materials for a construction or flooring project?",
    answer: "Input your room or surface dimensions to calculate the net area, then add a standard waste factor (typically 5% for simple rectangular rooms, 10% for standard tile/hardwood, or 15% for diagonal and herringbone patterns). Enter the unit price or box coverage to see exact package counts and cost estimates."
  },
  {
    question: "Can this calculator help with landscaping and garden projects?",
    answer: "Yes. You can estimate square footage, square yards, or acres for lawns, sod rolls, paver walkways, mulch beds, or circular patios, and calculate total material purchase costs easily."
  }
];
---

<CalculatorLayout
  title="Square Footage Calculator – Calculate Area, Materials & Costs for Any Shape | AI Free Calculator"
  description="Free online Square Footage Calculator to estimate square feet, square meters, square yards, and acres for rectangles, circles, triangles, borders, walls, and irregular shapes with cost and waste factors."
  category="Construction"
  calculatorName="Square Footage Calculator"
  slug="square-footage-calculator"
  keywords={[
    "square footage calculator",
    "sq ft calculator",
    "square foot calculator",
    "area calculator",
    "square feet calculator",
    "flooring calculator",
    "paint calculator",
    "cost per square foot",
    "room square footage",
    "square yardage calculator",
    "wall area calculator"
  ]}
>
  <div class="space-y-6">

    <!-- HERO HEADER & DESCRIPTION -->
    <div class="rounded-3xl border border-slate-200/90 bg-linear-to-r from-blue-50/60 via-indigo-50/40 to-white p-5 dark:border-slate-800 dark:from-slate-900 dark:via-blue-950/20 dark:to-slate-900 sm:p-6 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-blue-100/80 px-3 py-1 text-xs font-bold text-blue-800 dark:bg-blue-900/60 dark:text-blue-300 mb-2">
            <span>🏗️</span> Professional Area &amp; Material Estimator
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
            Square Footage Calculator
          </h1>
          <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl">
            The Square Footage Calculator estimates the square footage of a lot, house, or other surfaces in several common shapes.
            If the surface is complex in shape, it may be possible to section the surface into simple shapes and add their square footages together.
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2 rounded-2xl border border-slate-200/80 bg-white/90 p-3 shadow-2xs dark:border-slate-800 dark:bg-slate-950/80 text-xs">
          <span class="text-base">📐</span>
          <div>
            <div class="font-bold text-slate-800 dark:text-slate-200">12 Geometric Shapes</div>
            <div class="text-[11px] text-slate-500">Supports Multi-Room Sum</div>
          </div>
        </div>
      </div>

      <!-- INSTRUCTION NOTICE BAR (Matching Reference Image) -->
      <div class="mt-4 flex items-center justify-center gap-2.5 rounded-xl bg-blue-700 px-4 py-2 text-xs font-bold text-white shadow-xs dark:bg-blue-800">
        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-xs">▼</span>
        <span>Modify the values and click the Calculate button to use</span>
      </div>
    </div>

    <!-- MAIN CALCULATOR WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- LEFT COLUMN: SHAPE SELECTION & INPUTS (8 Cols) -->
      <div class="lg:col-span-8 space-y-6">

        <!-- SHAPE SELECTOR TABS -->
        <div class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900 shadow-xs">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5 flex items-center justify-between">
            <span>Select Surface Shape</span>
            <span class="text-[11px] text-blue-600 dark:text-blue-400 font-semibold" id="active-shape-indicator">Current: Rectangle</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-1.5 text-xs">
            <button type="button" data-shape="rectangle" class="shape-tab-btn active flex items-center gap-2 rounded-xl border border-blue-600 bg-blue-50/80 p-2 text-left font-bold text-blue-900 transition dark:border-blue-500 dark:bg-blue-950/40 dark:text-blue-200">
              <span class="text-base shrink-0">🔲</span>
              <span class="truncate">Rectangle</span>
            </button>
            <button type="button" data-shape="rectangle-border" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">🖼️</span>
              <span class="truncate">Rect. Border</span>
            </button>
            <button type="button" data-shape="square" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">⏹️</span>
              <span class="truncate">Square</span>
            </button>
            <button type="button" data-shape="circle" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">⭕</span>
              <span class="truncate">Circle</span>
            </button>
            <button type="button" data-shape="ring" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">🍩</span>
              <span class="truncate">Ring / Annulus</span>
            </button>
            <button type="button" data-shape="triangle-edges" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">📐</span>
              <span class="truncate">Triangle (3 Sides)</span>
            </button>
            <button type="button" data-shape="triangle-base" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">📐</span>
              <span class="truncate">Triangle (Base-Ht)</span>
            </button>
            <button type="button" data-shape="trapezoid" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">⏢</span>
              <span class="truncate">Trapezoid</span>
            </button>
            <button type="button" data-shape="sector" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">🍰</span>
              <span class="truncate">Sector</span>
            </button>
            <button type="button" data-shape="parallelogram" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">▱</span>
              <span class="truncate">Parallelogram</span>
            </button>
            <button type="button" data-shape="wall-openings" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">🚪</span>
              <span class="truncate">Wall w/ Openings</span>
            </button>
            <button type="button" data-shape="cathedral-wall" class="shape-tab-btn flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50/60 p-2 text-left font-medium text-slate-700 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300 transition">
              <span class="text-base shrink-0">⛪</span>
              <span class="truncate">Cathedral Wall</span>
            </button>
          </div>
        </div>

        <!-- ACTIVE SHAPE INPUT CARD WITH SVG DIAGRAM -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 shadow-xs">
          
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">

            <!-- FORM CONTROLS (7 Cols) -->
            <div class="md:col-span-7 space-y-4" id="shape-inputs-container">

              <!-- DYNAMIC SHAPE FIELDS INJECTED HERE -->

            </div>

            <!-- DIAGRAM PREVIEW PANEL (5 Cols) (Matching Reference Image Style) -->
            <div class="md:col-span-5 flex flex-col items-center justify-center p-4 rounded-xl border border-slate-100 bg-slate-50/80 dark:border-slate-800/80 dark:bg-slate-950/60 min-h-55">
              <div id="shape-diagram-container" class="w-full flex items-center justify-center">
                <!-- SVG rendered dynamically -->
              </div>
              <div id="diagram-caption" class="mt-2 text-center text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                Visual Geometry Diagram
              </div>
            </div>

          </div>

          <!-- COMMON CONTROLS: QUANTITY, WASTE, MATERIAL COST ESTIMATOR -->
          <div class="mt-6 pt-5 border-t border-slate-200 dark:border-slate-800 space-y-4">
            
            <!-- ROW 1: Quantity & Waste Factor -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Quantity -->
              <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-900/60">
                <label for="inp-quantity" class="flex items-center justify-between text-xs font-bold text-slate-800 dark:text-slate-200 mb-1.5">
                  <span class="flex items-center gap-1.5">
                    <span>🔢</span> Quantity / Multiplier
                  </span>
                  <span class="text-[11px] font-normal text-slate-500">Multiply identical areas</span>
                </label>
                <input 
                  type="number" 
                  id="inp-quantity" 
                  value="1" 
                  min="1" 
                  max="1000" 
                  class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs sm:text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white" 
                />
              </div>

              <!-- Waste Margin % (Optional) -->
              <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-900/60">
                <label for="inp-waste" class="flex items-center justify-between text-xs font-bold text-slate-800 dark:text-slate-200 mb-1.5">
                  <span class="flex items-center gap-1.5">
                    <span>📐</span> Waste Factor % (Optional)
                  </span>
                  <span class="text-[11px] font-normal text-slate-500">None by default</span>
                </label>
                <select 
                  id="inp-waste" 
                  class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs sm:text-sm font-semibold text-slate-800 shadow-2xs focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                >
                  <option value="0" selected>None (0% - Exact Net Area)</option>
                  <option value="5">5% (Simple Rectangular Rooms)</option>
                  <option value="10">10% (Standard Tile &amp; Flooring Cuts)</option>
                  <option value="15">15% (Diagonal / Herringbone Patterns)</option>
                  <option value="20">20% (Complex &amp; Curved Layouts)</option>
                  <option value="custom">Custom Percentage...</option>
                </select>
                <div id="custom-waste-wrap" class="mt-2" style="display: none;">
                  <div class="flex items-center gap-2">
                    <input 
                      type="number" 
                      id="inp-custom-waste" 
                      value="10" 
                      min="0" 
                      max="100" 
                      step="any"
                      class="flex-1 rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs sm:text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" 
                      placeholder="Custom waste %" 
                    />
                    <span class="text-xs font-bold text-slate-500">% Waste</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- ROW 2: DEDICATED MATERIAL COST ESTIMATOR (SPACIOUS & PROMINENT ON PC & MOBILE) -->
            <div class="rounded-2xl border border-emerald-200/80 bg-linear-to-r from-emerald-50/50 via-teal-50/30 to-white p-4 dark:border-emerald-900/40 dark:from-slate-900 dark:via-emerald-950/20 dark:to-slate-900 shadow-xs space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <div class="flex items-center gap-2 font-bold text-xs sm:text-sm text-slate-900 dark:text-white">
                  <span>💰</span>
                  <span>Material Price &amp; Cost Estimator (Optional)</span>
                </div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400">
                  Leave empty if you only need area measurements
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
                <!-- Price Input Box (7 columns on PC = generous typing space) -->
                <div class="sm:col-span-7">
                  <label for="inp-price" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                    Unit Price ($)
                  </label>
                  <div class="relative flex items-center">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-base font-black text-emerald-700 dark:text-emerald-400 select-none">
                      $
                    </span>
                    <input 
                      type="number" 
                      id="inp-price" 
                      step="0.01" 
                      min="0" 
                      placeholder="e.g. 4.50" 
                      class="w-full rounded-xl border border-slate-300 bg-white pl-9 pr-4 py-2.5 text-sm sm:text-base font-bold text-slate-900 shadow-2xs focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" 
                    />
                  </div>
                </div>

                <!-- Unit Selector (5 columns on PC) -->
                <div class="sm:col-span-5">
                  <label for="inp-price-unit" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                    Pricing Basis
                  </label>
                  <select 
                    id="inp-price-unit" 
                    class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs sm:text-sm font-semibold text-slate-800 shadow-2xs focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
                  >
                    <option value="sqft" selected>per Square Foot ($/sq ft)</option>
                    <option value="sqyd">per Square Yard ($/sq yd)</option>
                    <option value="sqm">per Square Meter ($/sq m)</option>
                    <option value="sqin">per Square Inch ($/sq in)</option>
                    <option value="package">per Box / Package</option>
                  </select>
                </div>
              </div>

              <!-- Optional Package/Box Coverage (Shown when per box/pkg selected) -->
              <div id="box-coverage-wrap" class="rounded-xl border border-emerald-200 bg-white p-3 dark:border-emerald-900/50 dark:bg-slate-900/90 text-xs flex flex-wrap items-center justify-between gap-3" style="display: none;">
                <div class="flex items-center gap-1.5 font-semibold text-emerald-950 dark:text-emerald-200">
                  <span>📦</span>
                  <span>Tile / Flooring Box Coverage:</span>
                </div>
                <div class="flex items-center gap-2">
                  <input 
                    type="number" 
                    id="inp-box-sqft" 
                    value="20" 
                    min="0.1" 
                    step="0.1" 
                    class="w-28 rounded-lg border border-emerald-300 bg-slate-50 px-3 py-1.5 text-xs sm:text-sm text-right font-bold text-slate-900 dark:border-emerald-800 dark:bg-slate-800 dark:text-white" 
                  />
                  <span class="font-bold text-slate-700 dark:text-slate-300">sq ft / box</span>
                </div>
              </div>
            </div>

            <!-- ACTION BUTTONS: CALCULATE (Green Play Icon like reference), CLEAR, & ADD TO PROJECT -->
            <div class="flex flex-wrap items-center gap-3 pt-2">
              <button
                type="button"
                id="btn-calculate"
                class="inline-flex items-center gap-2 rounded-xl bg-emerald-700 px-6 py-2.5 text-xs sm:text-sm font-bold text-white shadow-md hover:bg-emerald-800 hover:shadow-lg transition cursor-pointer"
              >
                <span>Calculate</span>
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-[10px]">▶</span>
              </button>

              <button
                type="button"
                id="btn-clear"
                class="rounded-xl border border-slate-300 bg-slate-200/80 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-700 hover:bg-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition cursor-pointer"
              >
                Clear
              </button>

              <button
                type="button"
                id="btn-add-room"
                class="inline-flex items-center gap-1.5 rounded-xl border border-blue-300 bg-blue-50/80 px-3.5 py-2.5 text-xs font-bold text-blue-700 hover:bg-blue-100 hover:border-blue-400 dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300 transition cursor-pointer ml-auto"
                title="Add current area to multi-room project accumulator"
              >
                <span>➕</span> Add to Multi-Room Project
              </button>
            </div>

            <!-- Error Notification Alert -->
            <div id="calc-error-box" class="rounded-xl border border-rose-200 bg-rose-50/90 p-3 text-xs text-rose-800 dark:border-rose-900/40 dark:bg-rose-950/30 dark:text-rose-300 font-medium" style="display: none;">
              <!-- Dynamic error message -->
            </div>

          </div>

        </div>

      </div>

      <!-- RIGHT COLUMN: RESULTS & SUMMARY (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">

        <!-- PRIMARY RESULT PANEL -->
        <div id="results-panel" class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 shadow-sm space-y-5">
          
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
              <span>📊</span> Calculation Results
            </h2>
            <span id="badge-shape-name" class="rounded-full bg-blue-100 px-2.5 py-0.5 text-[11px] font-bold text-blue-800 dark:bg-blue-900/60 dark:text-blue-300">
              Rectangle
            </span>
          </div>

          <!-- PRIMARY HEADLINE METRIC: TOTAL SQUARE FOOTAGE -->
          <div class="rounded-2xl border border-blue-200 bg-linear-to-br from-blue-50/90 via-indigo-50/40 to-white p-4.5 text-center dark:border-blue-900/50 dark:from-slate-900 dark:via-blue-950/30 dark:to-slate-950 shadow-2xs">
            <div class="text-[11px] font-bold uppercase tracking-wider text-blue-700 dark:text-blue-400">
              Total Area Required
            </div>
            <div id="res-total-sqft" class="mt-1 text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono tracking-tight">
              0.00
            </div>
            <div class="mt-0.5 text-xs font-bold text-blue-800 dark:text-blue-300">
              Square Feet (sq ft / ft²)
            </div>
            <div id="res-waste-note" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
              Includes 10% safety waste factor
            </div>
          </div>

          <!-- UNIT CONVERSIONS GRID -->
          <div class="space-y-2">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Equivalent Measurements
            </div>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div class="rounded-xl border border-slate-200/80 bg-slate-50/60 p-2.5 dark:border-slate-800 dark:bg-slate-950/60">
                <span class="text-[10px] text-slate-500 block">Square Yards:</span>
                <span id="res-sqyd" class="font-mono font-bold text-slate-800 dark:text-slate-200">0.00</span>
                <span class="text-[10px] text-slate-400 ml-1">yd²</span>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-slate-50/60 p-2.5 dark:border-slate-800 dark:bg-slate-950/60">
                <span class="text-[10px] text-slate-500 block">Square Meters:</span>
                <span id="res-sqm" class="font-mono font-bold text-slate-800 dark:text-slate-200">0.00</span>
                <span class="text-[10px] text-slate-400 ml-1">m²</span>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-slate-50/60 p-2.5 dark:border-slate-800 dark:bg-slate-950/60">
                <span class="text-[10px] text-slate-500 block">Square Inches:</span>
                <span id="res-sqin" class="font-mono font-bold text-slate-800 dark:text-slate-200">0</span>
                <span class="text-[10px] text-slate-400 ml-1">in²</span>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-slate-50/60 p-2.5 dark:border-slate-800 dark:bg-slate-950/60">
                <span class="text-[10px] text-slate-500 block">Acres:</span>
                <span id="res-acres" class="font-mono font-bold text-slate-800 dark:text-slate-200">0.0000</span>
                <span class="text-[10px] text-slate-400 ml-1">ac</span>
              </div>
            </div>
          </div>

          <!-- MATERIAL COST ESTIMATE CARD (When Price Entered) -->
