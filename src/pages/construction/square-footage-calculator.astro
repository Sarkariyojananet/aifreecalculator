    // Helper to read dimension converted to feet
    function getDimensionInFeet(fieldId) {
      const input = document.getElementById(`fld-${fieldId}`);
      if (!input) return 0;
      const val = parseFloat(input.value);
      if (isNaN(val) || val <= 0) return 0;

      const unitSelect = document.getElementById(`unit-${fieldId}`);
      const unit = unitSelect ? unitSelect.value : 'feet';
      const factor = UNIT_TO_FEET[unit] || 1.0;
      return val * factor;
    }

    // Main calculation function
    function calculateSquareFootage() {
      let baseSqFt = 0;
      const errorBox = document.getElementById('calc-error-box');

      try {
        if (currentShape === 'rectangle') {
          const l = getDimensionInFeet('length');
          const w = getDimensionInFeet('width');
          if (l <= 0 || w <= 0) throw new Error('Please enter positive values for both Length and Width.');
          baseSqFt = l * w;
        } else if (currentShape === 'square') {
          const s = getDimensionInFeet('side');
          if (s <= 0) throw new Error('Please enter a positive value for Side Length.');
          baseSqFt = s * s;
        } else if (currentShape === 'rectangle-border') {
          const l = getDimensionInFeet('length');
          const w = getDimensionInFeet('width');
          const b = getDimensionInFeet('border');
          if (l <= 0 || w <= 0 || b <= 0) throw new Error('Please enter positive values for Length, Width, and Border Width.');
          const outerArea = (l + 2 * b) * (w + 2 * b);
          const innerArea = l * w;
          baseSqFt = outerArea - innerArea;
        } else if (currentShape === 'circle') {
          const d = getDimensionInFeet('diameter');
          if (d <= 0) throw new Error('Please enter a positive diameter for the circle.');
          const r = d / 2.0;
          baseSqFt = Math.PI * r * r;
        } else if (currentShape === 'ring') {
          const outerD = getDimensionInFeet('outer_diameter');
          const b = getDimensionInFeet('border');
          if (outerD <= 0 || b <= 0) throw new Error('Please enter positive values for Outer Diameter and Border Width.');
          if (b >= outerD / 2.0) throw new Error('Border width must be less than half of the outer diameter.');
          const outerR = outerD / 2.0;
          const innerR = outerR - b;
          baseSqFt = Math.PI * (outerR * outerR - innerR * innerR);
        } else if (currentShape === 'triangle-edges') {
          const a = getDimensionInFeet('edge1');
          const b = getDimensionInFeet('edge2');
          const c = getDimensionInFeet('edge3');
          if (a <= 0 || b <= 0 || c <= 0) throw new Error('Please enter positive values for all 3 edge lengths.');
          // Validate triangle inequality
          if (a + b <= c || a + c <= b || b + c <= a) {
            throw new Error(`Impossible Triangle: The sum of any two sides must exceed the third side. (${a.toFixed(1)} + ${b.toFixed(1)} > ${c.toFixed(1)})`);
          }
          const s = (a + b + c) / 2.0;
          baseSqFt = Math.sqrt(s * (s - a) * (s - b) * (s - c));
        } else if (currentShape === 'triangle-base') {
          const b = getDimensionInFeet('base');
          const h = getDimensionInFeet('height');
          if (b <= 0 || h <= 0) throw new Error('Please enter positive values for Base and Height.');
          baseSqFt = 0.5 * b * h;
        } else if (currentShape === 'trapezoid') {
          const b1 = getDimensionInFeet('base1');
          const b2 = getDimensionInFeet('base2');
          const h = getDimensionInFeet('height');
          if (b1 <= 0 || b2 <= 0 || h <= 0) throw new Error('Please enter positive values for Base 1, Base 2, and Height.');
          baseSqFt = 0.5 * (b1 + b2) * h;
        } else if (currentShape === 'sector') {
          const r = getDimensionInFeet('radius');
          const angleInput = document.getElementById('fld-angle');
          const angle = angleInput ? parseFloat(angleInput.value) : 0;
          if (r <= 0 || isNaN(angle) || angle <= 0 || angle > 360) {
            throw new Error('Please enter a positive radius and an angle between 0.1° and 360°.');
          }
          baseSqFt = Math.PI * r * r * (angle / 360.0);
        } else if (currentShape === 'parallelogram') {
          const b = getDimensionInFeet('base');
          const h = getDimensionInFeet('height');
          if (b <= 0 || h <= 0) throw new Error('Please enter positive values for Base and Height.');
          baseSqFt = b * h;
        } else if (currentShape === 'wall-openings') {
          const ww = getDimensionInFeet('wall_width');
          const wh = getDimensionInFeet('wall_height');
          const ow = getDimensionInFeet('open_width');
          const oh = getDimensionInFeet('open_height');
          const countInput = document.getElementById('fld-open_count');
          const count = countInput ? Math.max(1, parseInt(countInput.value) || 1) : 1;

          if (ww <= 0 || wh <= 0) throw new Error('Please enter positive values for Wall Width and Wall Height.');
          const wallArea = ww * wh;
          const totalOpenings = ow * oh * count;
          if (totalOpenings >= wallArea) {
            throw new Error('The total opening area exceeds or equals the total wall area. Please verify window/door dimensions.');
          }
          baseSqFt = wallArea - totalOpenings;
        } else if (currentShape === 'cathedral-wall') {
          const w = getDimensionInFeet('width');
          const h1 = getDimensionInFeet('height1');
          const h2 = getDimensionInFeet('height2');
          if (w <= 0 || h1 <= 0 || h2 <= 0) throw new Error('Please enter positive values for Width, Short Height (H1), and Peak Height (H2).');
          baseSqFt = 0.5 * w * (h1 + h2);
        }

        // Quantity & Waste
        const qInput = document.getElementById('inp-quantity');
        const quantity = qInput ? Math.max(1, parseInt(qInput.value) || 1) : 1;

        const wasteSelect = document.getElementById('inp-waste');
        let wastePct = 0;
        if (wasteSelect) {
          if (wasteSelect.value === 'custom') {
            const customInput = document.getElementById('inp-custom-waste');
            wastePct = customInput ? Math.max(0, parseFloat(customInput.value) || 0) : 0;
          } else {
            wastePct = parseFloat(wasteSelect.value) || 0;
          }
        }

        const areaWithQty = baseSqFt * quantity;
        const wasteSqFt = areaWithQty * (wastePct / 100.0);
        const totalSqFt = areaWithQty + wasteSqFt;

        // Conversions
        const sqYards = totalSqFt / 9.0;
        const sqMeters = totalSqFt * 0.09290304; // 1 ft² = 0.09290304 m²
        const sqInches = Math.round(totalSqFt * 144.0);
        const acres = totalSqFt / 43560.0;

        // Pricing
        let materialCost;
        let boxesNeeded;
        const priceInput = document.getElementById('inp-price');
        const priceUnitSelect = document.getElementById('inp-price-unit');

        if (priceInput && priceInput.value && !isNaN(parseFloat(priceInput.value))) {
          const unitPrice = parseFloat(priceInput.value);
          const priceUnit = priceUnitSelect ? priceUnitSelect.value : 'sqft';

          if (priceUnit === 'sqft') {
            materialCost = totalSqFt * unitPrice;
          } else if (priceUnit === 'sqyd') {
            materialCost = sqYards * unitPrice;
          } else if (priceUnit === 'sqm') {
            materialCost = sqMeters * unitPrice;
          } else if (priceUnit === 'sqin') {
            materialCost = sqInches * unitPrice;
          } else if (priceUnit === 'package') {
            const boxInput = document.getElementById('inp-box-sqft');
            const sqftPerBox = boxInput ? Math.max(0.1, parseFloat(boxInput.value) || 20) : 20;
            boxesNeeded = Math.ceil(totalSqFt / sqftPerBox);
            materialCost = boxesNeeded * unitPrice;
          }
        }

        if (errorBox) errorBox.style.display = 'none';

        return {
          success: true,
          baseSqFt,
          totalSqFt,
          sqYards,
          sqMeters,
          sqInches,
          acres,
          quantity,
          wastePct,
          wasteSqFt,
          materialCost,
          boxesNeeded
        };

      } catch (err) {
        if (errorBox) {
          errorBox.textContent = err.message || 'Invalid input dimensions.';
          errorBox.style.display = 'block';
        }
        return {
          success: false,
          baseSqFt: 0,
          totalSqFt: 0,
          sqYards: 0,
          sqMeters: 0,
          sqInches: 0,
          acres: 0,
          quantity: 1,
          wastePct: 0,
          wasteSqFt: 0,
          errorMsg: err.message
        };
      }
    }

    // Update UI Results
    function updateResultsDisplay() {
      const res = calculateSquareFootage();
      if (!res.success) return;

      const elTotalSqFt = document.getElementById('res-total-sqft');
      const elSqYd = document.getElementById('res-sqyd');
      const elSqM = document.getElementById('res-sqm');
      const elSqIn = document.getElementById('res-sqin');
      const elAcres = document.getElementById('res-acres');
      const elWasteNote = document.getElementById('res-waste-note');
      const elSteps = document.getElementById('res-calculation-steps');
      const elBadgeShape = document.getElementById('badge-shape-name');
      const costCard = document.getElementById('cost-result-card');
      const elTotalCost = document.getElementById('res-total-cost');
      const elBoxBreakdown = document.getElementById('res-box-breakdown');

      if (elTotalSqFt) elTotalSqFt.textContent = res.totalSqFt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elSqYd) elSqYd.textContent = res.sqYards.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elSqM) elSqM.textContent = res.sqMeters.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (elSqIn) elSqIn.textContent = res.sqInches.toLocaleString('en-US');
      if (elAcres) elAcres.textContent = res.acres < 0.01 ? res.acres.toFixed(5) : res.acres.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 });

      if (elBadgeShape) {
        const shapeConfig = SHAPE_CONFIGS[currentShape];
        elBadgeShape.textContent = shapeConfig ? shapeConfig.name : 'Custom Shape';
      }

      if (elWasteNote) {
        elWasteNote.textContent = res.wastePct > 0 
          ? `Includes ${res.wastePct}% safety waste factor (+${res.wasteSqFt.toFixed(1)} sq ft)`
          : 'Exact net area (no waste factor added)';
      }

      if (elSteps) {
        if (res.wastePct > 0) {
          elSteps.innerHTML = `
            <div>• Base Shape Area: <strong>${res.baseSqFt.toFixed(2)} sq ft</strong></div>
            <div>• Quantity: <strong>${res.quantity}</strong> (Subtotal: ${(res.baseSqFt * res.quantity).toFixed(2)} sq ft)</div>
            <div>• Waste Margin (${res.wastePct}%): <strong>+${res.wasteSqFt.toFixed(2)} sq ft</strong></div>
            <div class="font-bold text-slate-900 dark:text-white">• Gross Total Area: <strong>${res.totalSqFt.toFixed(2)} sq ft</strong> (${res.sqMeters.toFixed(2)} m²)</div>
          `;
        } else {
          elSteps.innerHTML = `
            <div>• Base Shape Area: <strong>${res.baseSqFt.toFixed(2)} sq ft</strong></div>
            ${res.quantity > 1 ? `<div>• Quantity: <strong>${res.quantity}</strong></div>` : ''}
            <div class="font-bold text-slate-900 dark:text-white">• Total Net Area: <strong>${res.totalSqFt.toFixed(2)} sq ft</strong> (${res.sqMeters.toFixed(2)} m²)</div>
          `;
        }
      }

      if (costCard && elTotalCost) {
        if (typeof res.materialCost === 'number') {
          costCard.style.display = 'block';
          elTotalCost.textContent = `$${res.materialCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
          if (elBoxBreakdown && typeof res.boxesNeeded === 'number') {
            elBoxBreakdown.style.display = 'block';
            elBoxBreakdown.innerHTML = `Required Packages: <strong>${res.boxesNeeded} boxes</strong> (rounded up for full coverage)`;
          } else if (elBoxBreakdown) {
            elBoxBreakdown.style.display = 'none';
          }
        } else {
          costCard.style.display = 'none';
        }
      }

      try {
        document.dispatchEvent(new CustomEvent('calculator:updated'));
      } catch (e) {}
    }

    // Event listener initialization
    document.addEventListener('DOMContentLoaded', () => {
      renderShapeFields(currentShape);

      // Shape selector tabs
      const tabBtns = document.querySelectorAll('.shape-tab-btn');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('active', 'border-blue-600', 'bg-blue-50/80', 'text-blue-900', 'dark:border-blue-500', 'dark:bg-blue-950/40', 'dark:text-blue-200');
            b.classList.add('border-slate-200', 'bg-slate-50/60', 'text-slate-700', 'dark:border-slate-800', 'dark:bg-slate-900/60', 'dark:text-slate-300');
          });

          btn.classList.add('active', 'border-blue-600', 'bg-blue-50/80', 'text-blue-900', 'dark:border-blue-500', 'dark:bg-blue-950/40', 'dark:text-blue-200');
          btn.classList.remove('border-slate-200', 'bg-slate-50/60', 'text-slate-700', 'dark:border-slate-800', 'dark:bg-slate-900/60', 'dark:text-slate-300');

          const shapeKey = btn.getAttribute('data-shape') || 'rectangle';
          currentShape = shapeKey;

          const indicator = document.getElementById('active-shape-indicator');
          if (indicator) {
            const config = SHAPE_CONFIGS[shapeKey];
            indicator.textContent = `Current: ${config ? config.name : shapeKey}`;
          }

          renderShapeFields(shapeKey);
          updateResultsDisplay();
        });
      });

      // Waste select toggle
      const wasteSelect = document.getElementById('inp-waste');
      const customWasteWrap = document.getElementById('custom-waste-wrap');
      if (wasteSelect && customWasteWrap) {
        wasteSelect.addEventListener('change', () => {
          customWasteWrap.style.display = wasteSelect.value === 'custom' ? 'block' : 'none';
          updateResultsDisplay();
        });
      }

      const customWasteInput = document.getElementById('inp-custom-waste');
      if (customWasteInput) {
        customWasteInput.addEventListener('input', () => {
          updateResultsDisplay();
        });
      }

      // Quantity input listener
      const qInput = document.getElementById('inp-quantity');
      if (qInput) {
        qInput.addEventListener('input', () => {
          updateResultsDisplay();
        });
      }

      // Price input & unit toggle
      const priceInput = document.getElementById('inp-price');
      const priceUnitSelect = document.getElementById('inp-price-unit');
      const boxCoverageWrap = document.getElementById('box-coverage-wrap');
      const boxInput = document.getElementById('inp-box-sqft');

      if (priceInput) {
        priceInput.addEventListener('input', () => {
          updateResultsDisplay();
        });
      }

      if (priceUnitSelect && boxCoverageWrap) {
        priceUnitSelect.addEventListener('change', () => {
          boxCoverageWrap.style.display = priceUnitSelect.value === 'package' ? 'flex' : 'none';
          updateResultsDisplay();
        });
      }

      if (boxInput) {
        boxInput.addEventListener('input', () => {
          updateResultsDisplay();
        });
      }

      // Shape input dynamic container listener (delegated)
      const shapeContainer = document.getElementById('shape-inputs-container');
      if (shapeContainer) {
        shapeContainer.addEventListener('input', () => {
          updateResultsDisplay();
        });
        shapeContainer.addEventListener('change', () => {
          updateResultsDisplay();
        });
      }

      // Calculate Button
      const calcBtn = document.getElementById('btn-calculate');
      if (calcBtn) {
        calcBtn.addEventListener('click', () => {
          updateResultsDisplay();
        });
      }

      // Clear Button
      const clearBtn = document.getElementById('btn-clear');
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          renderShapeFields(currentShape);
          if (priceInput) priceInput.value = '';
          if (qInput) qInput.value = '1';
          if (wasteSelect) {
            wasteSelect.value = '0';
            if (customWasteWrap) customWasteWrap.style.display = 'none';
          }
          if (priceUnitSelect) {
            priceUnitSelect.value = 'sqft';
            if (boxCoverageWrap) boxCoverageWrap.style.display = 'none';
          }
          updateResultsDisplay();
        });
      }

      // Add to Project Button
      const addRoomBtn = document.getElementById('btn-add-room');
      const projectPanel = document.getElementById('project-accumulator-panel');
      const roomsList = document.getElementById('project-rooms-list');
      const grandSqFt = document.getElementById('proj-grand-sqft');
      const grandCost = document.getElementById('proj-grand-cost');
      const grandCostWrap = document.getElementById('proj-grand-cost-wrap');

      if (addRoomBtn && projectPanel && roomsList && grandSqFt) {
        addRoomBtn.addEventListener('click', () => {
          const res = calculateSquareFootage();
          if (!res.success) return;

          const shapeName = SHAPE_CONFIGS[currentShape]?.name || 'Shape';
          const roomItem = {
            id: 'room-' + Date.now(),
            name: `${shapeName} (×${res.quantity})`,
            sqft: res.totalSqFt,
            cost: res.materialCost
          };
          projectRooms.push(roomItem);

          renderProjectRooms();
        });
      }

      function renderProjectRooms() {
        if (!projectPanel || !roomsList || !grandSqFt) return;
        if (projectRooms.length === 0) {
          projectPanel.style.display = 'none';
          return;
        }

        projectPanel.style.display = 'block';
        let totalSqFt = 0;
        let totalCost = 0;
        let hasCost = false;

        roomsList.innerHTML = projectRooms.map((r, idx) => {
          totalSqFt += r.sqft;
          if (typeof r.cost === 'number') {
            totalCost += r.cost;
            hasCost = true;
          }
          return `
            <div class="flex items-center justify-between py-1.5 text-xs text-slate-700 dark:text-slate-300">
              <span class="font-medium">${idx + 1}. ${r.name}</span>
              <div class="flex items-center gap-2">
                <span class="font-mono font-bold">${r.sqft.toFixed(1)} sq ft</span>
                ${typeof r.cost === 'number' ? `<span class="text-emerald-700 dark:text-emerald-400 font-mono text-[11px] font-semibold">($${r.cost.toFixed(2)})</span>` : ''}
                <button type="button" class="del-room-btn text-rose-500 hover:text-rose-700 font-bold px-1" data-id="${r.id}">✕</button>
              </div>
            </div>
          `;
        }).join('');

        grandSqFt.textContent = `${totalSqFt.toFixed(2)} sq ft (${(totalSqFt * 0.092903).toFixed(2)} m²)`;

        if (grandCostWrap && grandCost) {
          if (hasCost) {
            grandCostWrap.style.display = 'flex';
            grandCost.textContent = `$${totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
          } else {
            grandCostWrap.style.display = 'none';
          }
        }

        // Bind delete buttons
        const delBtns = roomsList.querySelectorAll('.del-room-btn');
        delBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const findIdx = projectRooms.findIndex(r => r.id === id);
            if (findIdx !== -1) {
              projectRooms.splice(findIdx, 1);
              renderProjectRooms();
            }
          });
        });
      }

      // Clear all project rooms
      const clearProjectBtn = document.getElementById('btn-clear-project');
      if (clearProjectBtn) {
        clearProjectBtn.addEventListener('click', () => {
          projectRooms.length = 0;
          renderProjectRooms();
        });
      }

      // Copy Result
      const copyBtn = document.getElementById('btn-copy-result');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const res = calculateSquareFootage();
          if (!res.success) return;
          const text = `Square Footage Result:\nShape: ${SHAPE_CONFIGS[currentShape]?.name || 'Shape'}\nTotal Area: ${res.totalSqFt.toFixed(2)} sq ft (${res.sqMeters.toFixed(2)} m² / ${res.sqYards.toFixed(2)} sq yd)\nWaste Factor: ${res.wastePct}%\nQuantity: ${res.quantity}${typeof res.materialCost === 'number' ? `\nEstimated Cost: $${res.materialCost.toFixed(2)}` : ''}\nCalculated via AI Free Calculator: https://aifreecalculator.com/construction/square-footage-calculator/`;
          navigator.clipboard.writeText(text).then(() => {
            const old = copyBtn.textContent;
            copyBtn.textContent = '✓ Copied!';
            setTimeout(() => { copyBtn.textContent = old; }, 2000);
          });
        });
      }

      // Print Report
      const printBtn = document.getElementById('btn-print-report');
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          const barPrintBtn = document.getElementById('btn-print-calc');
          if (barPrintBtn) {
            barPrintBtn.click();
          } else {
            window.print();
          }
        });
      }

      // Share Result
      const shareBtn = document.getElementById('btn-share-result');
      if (shareBtn) {
        shareBtn.addEventListener('click', () => {
          if (navigator.share) {
            navigator.share({
              title: 'Square Footage Calculator',
              text: 'Check out this free Square Footage and Material Estimator!',
              url: window.location.href
            }).catch(() => {});
          } else {
            navigator.clipboard.writeText(window.location.href).then(() => {
              const old = shareBtn.textContent;
              shareBtn.textContent = '✓ Link Copied!';
              setTimeout(() => { shareBtn.textContent = old; }, 2000);
            });
          }
        });
      }

      // Initial calculation
      updateResultsDisplay();
    });
  </script>
</CalculatorLayout>
