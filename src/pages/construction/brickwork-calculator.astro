          <!-- Brick Course Lines on Right Face -->
          <line x1="280" y1="132" x2="440" y2="92" stroke="#fed7aa" stroke-width="1.2" />
          <line x1="280" y1="150" x2="440" y2="110" stroke="#fed7aa" stroke-width="1.2" />
          <line x1="280" y1="168" x2="440" y2="128" stroke="#fed7aa" stroke-width="1.2" />

          <!-- Dimension Annotations -->
          <text x="375" y="60" fill="#0f172a" font-size="11" font-weight="bold" text-anchor="middle">
