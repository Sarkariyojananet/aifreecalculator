      } else if (currentMode === "paving_bricks") {
        const area = parseFloat(pbArea.value) || 50;
        const areaUnit = pbUnit.value === "sqft" ? "sq.ft" : pbUnit.value === "sqyd" ? "sq.yd" : "m²";
