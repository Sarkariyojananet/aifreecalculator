            <rect x="40" y="34" width="75" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
            <rect x="120" y="34" width="75" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
            <rect x="200" y="34" width="70" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>

            <rect x="0" y="68" width="75" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
            <rect x="80" y="68" width="75" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
            <rect x="160" y="68" width="75" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
            <rect x="240" y="68" width="30" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>

            <rect x="0" y="102" width="35" height="30" fill="#0369a1" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
            <rect x="40" y="102" width="75" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
            <rect x="120" y="102" width="75" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
            <rect x="200" y="102" width="70" height="30" fill="#0284c7" stroke="#ffffff" stroke-width="${joint > 0 ? 1.5 : 0.5}" rx="2"/>
          </g>

          <!-- Plan Area Label -->
          <text x="180" y="200" fill="#475569" font-size="10" font-weight="bold" text-anchor="middle">
            Paving Grid Pattern (${area} ${areaUnit})
