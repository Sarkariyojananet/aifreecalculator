          <!-- Divider -->
          <line x1="355" y1="20" x2="355" y2="195" stroke="#e2e8f0" stroke-width="1.5" stroke-dasharray="4,4" />

          <!-- Right side: Cross Section (Paver + Sand Bedding + Subbase) -->
          <g transform="translate(385, 45)">
            <!-- Paver Block Profile -->
            <rect x="0" y="0" width="135" height="40" fill="#0284c7" stroke="#0369a1" stroke-width="2" rx="3" />
            <text x="67" y="24" fill="#ffffff" font-size="11" font-weight="bold" text-anchor="middle">
              Paver Block (${paverL}×${paverW})
            </text>

            <!-- Bedding Sand Layer -->
            <rect x="0" y="44" width="135" height="38" fill="#fde047" stroke="#ca8a04" stroke-width="1.5" rx="2" />
            <circle cx="20" cy="55" r="1.5" fill="#ca8a04" />
            <circle cx="45" cy="65" r="1.5" fill="#ca8a04" />
            <circle cx="85" cy="58" r="1.5" fill="#ca8a04" />
            <circle cx="115" cy="68" r="1.5" fill="#ca8a04" />
            <text x="67" y="66" fill="#854d0e" font-size="10" font-weight="bold" text-anchor="middle">
              ${bedding}mm Bedding Sand
            </text>

            <!-- Compacted Sub-base -->
            <rect x="0" y="86" width="135" height="32" fill="#94a3b8" stroke="#475569" stroke-width="1.5" rx="2" />
            <text x="67" y="106" fill="#1e293b" font-size="10" font-weight="bold" text-anchor="middle">
              Compacted Base
            </text>
          </g>

          <text x="452" y="200" fill="#475569" font-size="10" font-weight="bold" text-anchor="middle">
            Cross-Section Layer Detailing
          </text>
        `;
      } else if (currentMode === "custom_brickwork") {
        const l = parseFloat(cbLen.value) || 6;
        const w = parseFloat(cbWid.value) || 0.3;
        const h = parseFloat(cbHt.value) || 2.5;
        const bl = parseFloat(cbBrickL.value) || 225;
        const bw = parseFloat(cbBrickW.value) || 112.5;
        const bh = parseFloat(cbBrickH.value) || 75;
        const ratio = cbRatio.value;

        badge = `3D Custom Masonry Structure (${l}m × ${w}m × ${h}m)`;
        caption = `Volume: ${(l * w * h).toFixed(2)} m³ | Custom Brick: ${bl}×${bw}×${bh} mm | Mix: ${ratio}`;

        svgContent = `
          <!-- Ground Shadow -->
          <ellipse cx="280" cy="195" rx="170" ry="18" fill="rgba(0,0,0,0.10)" />

          <!-- 3D Isometric Masonry Structure -->
          <!-- Top Face -->
          <polygon points="280,35 440,75 280,115 120,75" fill="#fed7aa" stroke="#ea580c" stroke-width="2" />
          <!-- Left Front Face -->
          <polygon points="120,75 280,115 280,185 120,145" fill="#ea580c" stroke="#c2410c" stroke-width="2" />
          <!-- Right Front Face -->
          <polygon points="280,115 440,75 440,145 280,185" fill="#c2410c" stroke="#9a3412" stroke-width="2" />

          <!-- Brick Course Lines on Left Face -->
