          <rect x="${secX}" y="${secY + 60}" width="${secW}" height="4" fill="url(#mortarBed)" />
          <rect x="${secX}" y="${secY + 92}" width="${secW}" height="4" fill="url(#mortarBed)" />
          <rect x="${secX}" y="${secY + 124}" width="${secW}" height="4" fill="url(#mortarBed)" />

          <!-- Thickness Callout (Top) -->
