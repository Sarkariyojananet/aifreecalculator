        `;
      }

      svgBrickwork.innerHTML = svgContent;
      lblVisualBadge.textContent = badge;
      lblVisualCaption.textContent = caption;
    }

    // =========================================================
    // CALCULATION ROUTINE (Rule 8: Triggered ONLY on button click)
    // =========================================================
    function performCalculation() {
      hideError();
      const enableCost = chkEnableCost ? chkEnableCost.checked : false;
      const bRate = parseFloat(inpRateBrick.value) || 0;
      const cRate = parseFloat(inpRateCement.value) || 0;
      const sRate = parseFloat(inpRateSand.value) || 0;
      const pRate = parseFloat(inpRatePaver.value) || 0;

      try {
        if (currentMode === "wall_brickwork") {
          const unit = globalUnit;
          const len = parseFloat(wbLength.value);
          const ht = parseFloat(wbHeight.value);
          const walls = parseInt(wbWalls.value, 10) || 1;
          const thPreset = wbThicknessPreset.value as any;
          const openDed = parseFloat(wbOpenings.value) || 0;
          const joint = parseFloat(wbJoint.value) || 10;
          const wastage = parseFloat(wbWastage.value) || 0;

          if (isNaN(len) || len <= 0 || isNaN(ht) || ht <= 0 || walls <= 0) {
            return showError("Please enter valid positive Wall Length, Height, and Wall Count.");
          }

          let customThickMeters = 0.23;
          if (thPreset === "custom") {
            const val = parseFloat(wbCustomThickVal.value);
            const u = wbCustomThickUnit.value;
            if (isNaN(val) || val <= 0) {
              return showError("Please enter a valid custom wall thickness.");
            }
            customThickMeters = u === "mm" ? val / 1000 : u === "cm" ? val / 100 : u === "in" ? (val * 25.4) / 1000 : val;
          }

          let brickL = 190;
          let brickW = 90;
          let brickH = 90;
          let brickName = "Standard Metric Modular (190 × 90 × 90 mm)";

          if (wbBrickPreset.value === "custom") {
            brickL = parseFloat(wbCustomBl.value);
            brickW = parseFloat(wbCustomBw.value);
            brickH = parseFloat(wbCustomBh.value);
            if (isNaN(brickL) || brickL <= 0 || isNaN(brickW) || brickW <= 0 || isNaN(brickH) || brickH <= 0) {
              return showError("Please enter valid custom brick dimensions.");
            }
            brickName = `Custom (${brickL} × ${brickW} × ${brickH} mm)`;
          } else {
            const found = BRICK_PRESETS.find((p) => p.id === wbBrickPreset.value);
            if (found) {
              brickL = found.lengthMm;
              brickW = found.widthMm;
              brickH = found.heightMm;
              brickName = found.name;
            }
          }

          const res = calculateWallBrickwork({
            unitSystem: unit,
            wallLength: len,
            wallHeight: ht,
            wallThicknessType: thPreset,
            customThicknessMeters: customThickMeters,
            numberOfWalls: walls,
            openingsDeductionArea: openDed,
            brickLengthMm: brickL,
            brickWidthMm: brickW,
            brickHeightMm: brickH,
            mortarJointMm: joint,
            wastagePercent: wastage,
            enableCost,
            currency: globalCurrency,
            brickRate: bRate,
            cementBagRate: cRate,
            sandRatePerCft: sRate,
          });

          lastResultData = {
            mode: "wall_brickwork",
            title: "Brickwork Calculation Report",
            brickName,
            ...res,
          };

          // Render Hero
          lblHeroTag.textContent = "ESTIMATED BRICKS REQUIRED";
          badgeCalcMode.textContent = "Wall Brickwork";
          resHeroMain.textContent = `${res.finalEstimatedBricks.toLocaleString()} Bricks`;
          resHeroSub.textContent = `Base: ${res.bricksBeforeWastage.toLocaleString()} Bricks + ${res.wastageCount.toLocaleString()} (${res.wastagePercent}% Wastage) | Wall Volume: ${res.wallVolumeCum} m³ (${res.wallVolumeCft} CFT)`;

          // Render Grid
          gridResultMetrics.innerHTML = `
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Net Wall Area</div>
              <div class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">${res.netWallAreaSqm} m² <span class="text-xs font-normal text-slate-500">(${res.netWallAreaSqft} sq.ft)</span></div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Masonry Volume</div>
              <div class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">${res.wallVolumeCum} m³ <span class="text-xs font-normal text-slate-500">(${res.wallVolumeCft} CFT)</span></div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Brick Size & Joint</div>
              <div class="mt-1 text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400 truncate" title="${brickName}">${res.brickLengthMm}×${res.brickWidthMm}×${res.brickHeightMm}mm <span class="text-xs font-normal text-slate-500">(${res.mortarJointMm}mm joint)</span></div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Wall Thickness</div>
              <div class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">${(res.wallThicknessMeters * 1000).toFixed(0)} mm <span class="text-xs font-normal text-slate-500">(${res.wallThicknessLabel.split("(")[0].trim()})</span></div>
            </div>
          `;

          // Render Material Breakdown Table
          tbodyMaterialBreakdown.innerHTML = `
            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
              <td class="py-2.5 px-3 font-semibold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                <span>🧱</span> Bricks
              </td>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">${res.finalEstimatedBricks.toLocaleString()} Bricks</td>
              <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${(res.finalEstimatedBricks / 1000).toFixed(2)} k Bricks</td>
              <td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">${res.brickLengthMm}×${res.brickWidthMm}×${res.brickHeightMm} mm (incl. ${res.wastagePercent}% wastage)</td>
            </tr>
            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
              <td class="py-2.5 px-3 font-semibold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                <span>📦</span> Cement (approx.)
              </td>
              <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">${res.approxCementBags} Bags (50kg)</td>
              <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${((res.approxCementBags || 0) * 50).toFixed(0)} kg</td>
              <td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">1:6 Mortar bed & head joints allowance</td>
            </tr>
            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
              <td class="py-2.5 px-3 font-semibold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                <span>⏳</span> Sand (approx.)
              </td>
              <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">${res.approxSandCft} CFT</td>
              <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${((res.approxSandCft || 0) / 35.3147).toFixed(2)} m³</td>
              <td class="py-2.5 px-3 text-slate-500 dark:text-slate-400">Standard washed masonry mortar sand</td>
            </tr>
          `;

          // Render Cost Breakdown Table
          renderCostBreakdown(res.costSummary);

          // Render Formula Details
          const isImp = unit === "imperial";
          const lenUnitStr = isImp ? "ft" : "m";
          const primaryAreaVal = isImp ? `${res.totalWallAreaSqft} sq.ft` : `${res.totalWallAreaSqm} m²`;
          const altAreaVal = isImp ? `${res.totalWallAreaSqm} m²` : `${res.totalWallAreaSqft} sq.ft`;
          const primaryOpenVal = isImp ? `${res.openingsAreaSqft} sq.ft` : `${res.openingsAreaSqm} m²`;
          const altOpenVal = isImp ? `${res.openingsAreaSqm} m²` : `${res.openingsAreaSqft} sq.ft`;
          const primaryNetVal = isImp ? `${res.netWallAreaSqft} sq.ft` : `${res.netWallAreaSqm} m²`;
          const altNetVal = isImp ? `${res.netWallAreaSqm} m²` : `${res.netWallAreaSqft} sq.ft`;

          txtCalcDetails.innerHTML = `
            <div>1. Gross Wall Area = ${len} ${lenUnitStr} × ${ht} ${lenUnitStr} × ${walls} = <strong>${primaryAreaVal} (${altAreaVal})</strong></div>
            <div>2. Openings Deduction = ${primaryOpenVal} (${altOpenVal}) ➔ Net Wall Area = <strong>${primaryNetVal} (${altNetVal})</strong></div>
            <div>3. Total Masonry Volume = ${res.netWallAreaSqm} m² × ${res.wallThicknessMeters}m = <strong>${res.wallVolumeCum} m³ (${res.wallVolumeCft} CFT)</strong></div>
            <div>4. Nominal Single Brick Size = (${res.nominalBrickLengthMm} × ${res.nominalBrickWidthMm} × ${res.nominalBrickHeightMm} mm) = ${res.singleNominalBrickVolumeCum} m³</div>
            <div>5. Bricks Before Wastage = ${res.wallVolumeCum} m³ / ${res.singleNominalBrickVolumeCum} m³ = <strong>${res.bricksBeforeWastage.toLocaleString()} Bricks</strong></div>
            <div>6. Wastage Allowance (${res.wastagePercent}%) = ${res.wastageCount.toLocaleString()} Bricks ➔ Final Quantity = <strong>${res.finalEstimatedBricks.toLocaleString()} Bricks (rounded up)</strong></div>
          `;

          // Render Comparison Table
          sectionComparison.classList.remove("hidden");
          tbodyComparison.innerHTML = res.comparisonTable
            .map(
              (row) => `
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                <td class="py-2.5 px-3 font-semibold text-slate-700 dark:text-slate-300">${row.wastagePct}% Wastage</td>
