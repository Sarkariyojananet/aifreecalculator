    // =========================================================
    // DYNAMIC REAL-TIME SVG VISUAL DETAILING (Rule 10 & 11)
    // =========================================================
    function renderDynamicVisual() {
      if (!svgBrickwork) return;

      let svgContent = "";
      let caption = "";
      let badge = "Wall Elevation & Cross-Section";

      if (currentMode === "wall_brickwork" || currentMode === "brick_mortar") {
        const isWb = currentMode === "wall_brickwork";
        const len = parseFloat(isWb ? wbLength.value : bmLength.value) || 10;
        const ht = parseFloat(isWb ? wbHeight.value : bmHeight.value) || 3;
        const openDed = parseFloat(isWb ? wbOpenings.value : bmOpenings.value) || 0;
        const joint = parseFloat(isWb ? wbJoint.value : bmJoint.value) || 10;
        const lenUnit = globalUnit === "imperial" ? "ft" : "m";
        const areaUnit = globalUnit === "imperial" ? "sq.ft" : "m²";

        let thMm = 230;
        let thLabel = "9\" (230 mm)";
        if (isWb) {
          const tp = wbThicknessPreset.value;
          if (tp === "half_brick") {
            thMm = 115;
            thLabel = "4.5\" Half-Brick (115 mm)";
          } else if (tp === "one_brick") {
            thMm = 230;
            thLabel = "9\" One-Brick (230 mm)";
          } else if (tp === "one_half_brick") {
            thMm = 345;
            thLabel = "13.5\" 1.5-Brick (345 mm)";
          } else {
            const val = parseFloat(wbCustomThickVal.value) || 230;
            const u = wbCustomThickUnit.value;
            thMm = u === "in" ? Math.round(val * 25.4) : u === "cm" ? Math.round(val * 10) : Math.round(val);
            thLabel = `Custom (${thMm} mm)`;
          }
        } else {
          thMm = parseFloat(bmThickness.value) || 230;
          thLabel = `${thMm} mm`;
        }

        badge = `Wall Elevation & Cross-Section (${thLabel})`;
        caption = `Wall: ${len} ${lenUnit} (L) × ${ht} ${lenUnit} (H) | Thickness: ${thMm} mm | Joint: ${joint} mm | Opening: ${openDed} ${areaUnit}`;

        // Elevation Panel geometry
        const elevX = 40;
        const elevY = 35;
        const elevMaxW = 280;
        const elevMaxH = 145;

        // Aspect ratio scaling clamped
        const aspect = Math.max(0.6, Math.min(2.6, len / Math.max(0.1, ht)));
        let wallW = elevMaxW;
        let wallH = wallW / aspect;
        if (wallH > elevMaxH) {
          wallH = elevMaxH;
          wallW = wallH * aspect;
        }

        // Brick courses rows
        const numRows = 7;
        const rowH = wallH / numRows;
        let coursesSvg = "";
        for (let r = 0; r < numRows; r++) {
          const yPos = elevY + r * rowH;
          coursesSvg += `<line x1="${elevX}" y1="${yPos}" x2="${elevX + wallW}" y2="${yPos}" stroke="#cbd5e1" stroke-width="1.2" />`;
          const numCols = Math.max(4, Math.round(wallW / 35));
          const colW = wallW / numCols;
          const offset = (r % 2 === 0) ? 0 : colW / 2;
          for (let c = 0; c <= numCols; c++) {
            const xPos = elevX + c * colW + offset;
            if (xPos > elevX && xPos < elevX + wallW) {
              coursesSvg += `<line x1="${xPos}" y1="${yPos}" x2="${xPos}" y2="${yPos + rowH}" stroke="#cbd5e1" stroke-width="1.2" />`;
            }
          }
        }

        // Opening representation if any
        let openingSvg = "";
        if (openDed > 0) {
          const opW = wallW * 0.32;
          const opH = wallH * 0.55;
          const opX = elevX + wallW * 0.35;
          const opY = elevY + wallH - opH;
          openingSvg = `
            <rect x="${opX}" y="${opY}" width="${opW}" height="${opH}" fill="#e0f2fe" stroke="#0284c7" stroke-width="2" stroke-dasharray="3,3" />
            <!-- Cross diagonals indicating opening -->
            <line x1="${opX}" y1="${opY}" x2="${opX + opW}" y2="${opY + opH}" stroke="#0284c7" stroke-width="1" stroke-dasharray="2,2" opacity="0.6"/>
            <line x1="${opX + opW}" y1="${opY}" x2="${opX}" y2="${opY + opH}" stroke="#0284c7" stroke-width="1" stroke-dasharray="2,2" opacity="0.6"/>
            <rect x="${opX + opW/2 - 38}" y="${opY + opH/2 - 10}" width="76" height="20" rx="4" fill="#0369a1" />
            <text x="${opX + opW/2}" y="${opY + opH/2 + 4}" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">
              Opening -${openDed} ${areaUnit}
            </text>
          `;
        }

        // Cross Section Geometry on Right side
        const secX = 390;
        const secY = 35;
        const secH = 145;
        // Width proportional to thickness
        const secW = Math.max(35, Math.min(100, (thMm / 230) * 65));

        svgContent = `
          <defs>
            <linearGradient id="brickFill" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ea580c" />
              <stop offset="100%" stop-color="#c2410c" />
            </linearGradient>
