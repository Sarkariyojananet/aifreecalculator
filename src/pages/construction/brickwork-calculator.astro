            <div>2. Custom Brick Nominal Size = (${bl + joint} × ${bw + joint} × ${bh + joint} mm)</div>
            <div>3. Base Bricks Required = <strong>${res.baseBricks.toLocaleString()} Bricks</strong> ➔ with ${bWaste}% Wastage = <strong>${res.finalBricks.toLocaleString()} Bricks</strong></div>
            <div>4. Dry Mortar Volume = <strong>${res.dryMortarVolumeCum} m³ (${res.dryMortarVolumeCft} CFT)</strong> (Ratio ${res.ratioLabel})</div>
            <div>5. Cement = <strong>${res.cementBags50kg} Bags (50kg)</strong> | Sand = <strong>${res.sandVolumeCft} CFT (${res.sandWeightTons} Tonnes)</strong></div>
          `;

          sectionComparison.classList.add("hidden");
        }

        // Hide stale indicator & placeholder
        if (staleWarning) staleWarning.classList.add("hidden");
        if (resultsPlaceholder) resultsPlaceholder.classList.add("hidden");
        resultsSection.classList.remove("hidden");
        resultsSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } catch (err: any) {
        showError(err?.message || "An unexpected error occurred during calculation. Please check your inputs.");
      }
    }

    // Helper: Render Cost Breakdown Table
    function renderCostBreakdown(costSummary: any) {
      if (!costSummary || !sectionCostBreakdown) {
        if (sectionCostBreakdown) sectionCostBreakdown.classList.add("hidden");
        return;
      }

      sectionCostBreakdown.classList.remove("hidden");
      const sym = costSummary.currencySymbol;
      badgeCostCurrency.textContent = `${costSummary.currency} (${sym})`;

      let rowsHtml = "";
      if (costSummary.brickCost !== undefined) {
        rowsHtml += `
          <tr class="hover:bg-emerald-50/50 dark:hover:bg-emerald-950/40">
            <td class="py-2.5 px-3 font-semibold text-slate-800 dark:text-slate-200">Bricks</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${lastResultData.finalEstimatedBricks || lastResultData.finalBricks || 0} Pcs</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${sym} ${inpRateBrick.value} / pc</td>
            <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white text-right">${formatCurrency(costSummary.brickCost, costSummary.currency)}</td>
          </tr>
        `;
      }
      if (costSummary.cementCost !== undefined) {
        rowsHtml += `
          <tr class="hover:bg-emerald-50/50 dark:hover:bg-emerald-950/40">
            <td class="py-2.5 px-3 font-semibold text-slate-800 dark:text-slate-200">Cement</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${Math.ceil(lastResultData.cementBags50kg || lastResultData.approxCementBags || 0)} Bags</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${sym} ${inpRateCement.value} / bag</td>
            <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white text-right">${formatCurrency(costSummary.cementCost, costSummary.currency)}</td>
          </tr>
        `;
      }
      if (costSummary.sandCost !== undefined) {
        rowsHtml += `
          <tr class="hover:bg-emerald-50/50 dark:hover:bg-emerald-950/40">
            <td class="py-2.5 px-3 font-semibold text-slate-800 dark:text-slate-200">Sand</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${(lastResultData.sandVolumeCft || lastResultData.approxSandCft || lastResultData.beddingSandVolumeCft || 0)} CFT</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${sym} ${inpRateSand.value} / CFT</td>
            <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white text-right">${formatCurrency(costSummary.sandCost, costSummary.currency)}</td>
          </tr>
        `;
      }
      if (costSummary.paverCost !== undefined) {
        rowsHtml += `
          <tr class="hover:bg-emerald-50/50 dark:hover:bg-emerald-950/40">
            <td class="py-2.5 px-3 font-semibold text-slate-800 dark:text-slate-200">Paver Blocks</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${lastResultData.finalEstimatedPavers || 0} Pcs</td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">${sym} ${inpRatePaver.value} / block</td>
            <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white text-right">${formatCurrency(costSummary.paverCost, costSummary.currency)}</td>
          </tr>
        `;
      }

      tbodyCostBreakdown.innerHTML = rowsHtml;
      resCostTotal.textContent = costSummary.formattedTotal;

      let ratesSummary = "";
      if (costSummary.costPerSqm) {
        ratesSummary += `<span>• Cost per m²: <strong>${formatCurrency(costSummary.costPerSqm, costSummary.currency)} / m²</strong></span>`;
      }
      if (costSummary.costPerSqft) {
        ratesSummary += `<span>• Cost per sq.ft: <strong>${formatCurrency(costSummary.costPerSqft, costSummary.currency)} / sq.ft</strong></span>`;
      }
      if (costSummary.costPerCum) {
        ratesSummary += `<span>• Cost per m³: <strong>${formatCurrency(costSummary.costPerCum, costSummary.currency)} / m³</strong></span>`;
      }
      divCostRatesSummary.innerHTML = ratesSummary;
    }

    // Clear All
    function performClearAll() {
      // 1. Reset inputs for Wall Brickwork
      wbLength.value = "10";
      wbHeight.value = "3.0";
      wbWalls.value = "1";
      wbThicknessPreset.value = "one_brick";
      divWbCustomThick.classList.add("hidden");
      wbCustomThickVal.value = "230";
      wbCustomThickUnit.value = "mm";
      wbBrickPreset.value = "modular_metric";
      divWbCustomBrick.classList.add("hidden");
      wbCustomBl.value = "190";
      wbCustomBw.value = "90";
      wbCustomBh.value = "90";
      wbJoint.value = "10";
      wbOpenings.value = "4.0";
      wbWastage.value = "5";

      // 2. Reset inputs for Brick Mortar
      bmLength.value = "10";
      bmHeight.value = "3.0";
      bmThickness.value = "230";
      bmOpenings.value = "4.0";
      bmBrickPreset.value = "modular_metric";
      divBmCustomBrick.classList.add("hidden");
      bmCustomBl.value = "190";
      bmCustomBw.value = "90";
      bmCustomBh.value = "90";
      bmRatio.value = "1:6";
      divBmCustomRatio.classList.add("hidden");
      bmCustomC.value = "1";
      bmCustomS.value = "6";
      bmJoint.value = "10";
      bmWastage.value = "10";
      bmDryFactor.value = "1.33";

      // 3. Reset inputs for Paving Bricks
      pbArea.value = "50";
      pbPreset.value = "200x100";
      divPbCustomSize.classList.add("hidden");
      pbCustomL.value = "200";
      pbCustomW.value = "100";
      pbJoint.value = "3";
      pbWastage.value = "5";
      pbBedding.value = "50";

      // 4. Reset inputs for Custom Brickwork
      cbLen.value = "6";
      cbWid.value = "0.30";
      cbHt.value = "2.5";
      cbBrickL.value = "225";
      cbBrickW.value = "112.5";
      cbBrickH.value = "75";
      cbJoint.value = "10";
      cbRatio.value = "1:6";
      cbBrickWaste.value = "5";
      cbMortarWaste.value = "10";

      // Reset Cost
      if (chkEnableCost) {
        chkEnableCost.checked = false;
        divCostInputs.classList.add("hidden");
      }

      // Reset State
      lastResultData = null;
      if (resultsSection) resultsSection.classList.add("hidden");
      if (resultsPlaceholder) resultsPlaceholder.classList.remove("hidden");
      if (staleWarning) staleWarning.classList.add("hidden");
      hideError();

      // Reset Tab to Wall Brickwork
      modeButtons[0].click();
      renderDynamicVisual();
    }

    btnCalculate.addEventListener("click", performCalculation);
    if (btnRecalculateStale) btnRecalculateStale.addEventListener("click", performCalculation);
    btnClearAll.addEventListener("click", performClearAll);

    // Initial Visual Render
    renderDynamicVisual();

    // PDF Export Generation
    if (btnDownloadPdf) {
      btnDownloadPdf.addEventListener("click", async () => {
        if (!lastResultData) return;

        const txtBtn = document.getElementById("txt-btn-pdf");
        if (txtBtn) txtBtn.textContent = "Generating PDF...";

        try {
          let jsPDFModule = (window as any).jspdf;
          if (!jsPDFModule) {
            const script1 = document.createElement("script");
            script1.src = "https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js";
            await new Promise((resolve, reject) => {
              script1.onload = resolve;
              script1.onerror = reject;
              document.head.appendChild(script1);
            });
            const script2 = document.createElement("script");
            script2.src = "https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js";
            await new Promise((resolve, reject) => {
              script2.onload = resolve;
              script2.onerror = reject;
              document.head.appendChild(script2);
            });
            jsPDFModule = (window as any).jspdf;
          } else if (!(window as any).jspdf?.plugin?.autotable && !(window as any).autoTable) {
            const script2 = document.createElement("script");
            script2.src = "https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js";
            await new Promise((resolve, reject) => {
              script2.onload = resolve;
              script2.onerror = reject;
              document.head.appendChild(script2);
            });
          }

          const { jsPDF } = jsPDFModule;
          const doc = new jsPDF({ unit: "pt", format: "a4" });

          const primaryColor = [37, 99, 235]; // #2563eb
          const darkColor = [15, 23, 42]; // #0f172a
          const slateColor = [100, 116, 139]; // #64748b
          const lightBg = [248, 250, 252]; // #f8fafc

          const pageWidth = doc.internal.pageSize.getWidth();
          const pageHeight = doc.internal.pageSize.getHeight();
          const margin = 40;
          let y = 45;

          // Top Header Branding
          doc.setFont("helvetica", "bold");
          doc.setFontSize(18);
          doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
          doc.text("AIFreecalculator.com", margin, y);

          doc.setFont("helvetica", "normal");
          doc.setFontSize(9);
          doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
          doc.text("Free Civil & Structural Engineering Calculators", margin, y + 13);

          const now = new Date();
          const dateStr = now.toISOString().split("T")[0];
          doc.text(`Generated: ${dateStr} | Unit: ${globalUnit.toUpperCase()} | Currency: ${globalCurrency}`, pageWidth - margin, y + 5, {
            align: "right",
          });

          y += 28;
          doc.setDrawColor(226, 232, 240);
          doc.setLineWidth(1);
          doc.line(margin, y, pageWidth - margin, y);
          y += 24;

          // Mode-Specific Title
          doc.setFont("helvetica", "bold");
          doc.setFontSize(15);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text(lastResultData.title, margin, y);
          y += 18;

          // Summary Hero Box
          doc.setFillColor(lightBg[0], lightBg[1], lightBg[2]);
          doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, "F");
          doc.setDrawColor(203, 213, 225);
          doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, "D");

          doc.setFont("helvetica", "bold");
          doc.setFontSize(10);
          doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
          doc.text(lblHeroTag.textContent || "CALCULATION SUMMARY", margin + 14, y + 18);

          doc.setFontSize(14);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text(resHeroMain.textContent || "", margin + 14, y + 36);

          y += 72;

          // Summary Table Rows based on Mode
          doc.setFont("helvetica", "bold");
          doc.setFontSize(11);
          doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
          doc.text("Calculation Breakdown & Parameters", margin, y);
          y += 14;

          let tableRows: Array<[string, string]> = [];
          if (lastResultData.mode === "wall_brickwork") {
            tableRows = [
              ["Net Wall Area", `${lastResultData.netWallAreaSqm} m² (${lastResultData.netWallAreaSqft} sq.ft)`],
              ["Wall Thickness", `${(lastResultData.wallThicknessMeters * 1000).toFixed(0)} mm (${lastResultData.wallThicknessLabel})`],
              ["Total Masonry Volume", `${lastResultData.wallVolumeCum} m³ (${lastResultData.wallVolumeCft} CFT)`],
              ["Brick Specifications", `${lastResultData.brickLengthMm} × ${lastResultData.brickWidthMm} × ${lastResultData.brickHeightMm} mm`],
              ["Mortar Joint Thickness", `${lastResultData.mortarJointMm} mm`],
              ["Base Bricks (0% Wastage)", `${lastResultData.bricksBeforeWastage.toLocaleString()} Bricks`],
              ["Wastage Allowance", `${lastResultData.wastagePercent}% (${lastResultData.wastageCount.toLocaleString()} Bricks)`],
              ["Final Estimated Bricks", `${lastResultData.finalEstimatedBricks.toLocaleString()} Bricks`],
            ];
          } else if (lastResultData.mode === "brick_mortar") {
            tableRows = [
              ["Total Brickwork Volume", `${lastResultData.totalBrickworkVolumeCum} m³ (${lastResultData.totalBrickworkVolumeCft} CFT)`],
              ["Solid Bricks Volume", `${lastResultData.actualBricksVolumeCum} m³`],
              ["Wet Mortar Volume", `${lastResultData.wetMortarVolumeCum} m³ (${lastResultData.wetMortarVolumeCft} CFT)`],
              ["Dry Mortar Volume", `${lastResultData.dryMortarVolumeCum} m³ (Factor: ${lastResultData.dryVolumeFactor})`],
              ["Mortar Mix Ratio", `1:${lastResultData.ratioLabel.split(":")[1] || "6"} (Cement : Sand)`],
              ["Mortar Wastage Allowance", `${lastResultData.mortarWastagePercent}%`],
              ["Cement Required", `${lastResultData.cementBags50kg} Bags of 50kg (${lastResultData.cementWeightKg} kg)`],
              ["Sand Required", `${lastResultData.sandVolumeCft} CFT (${lastResultData.sandWeightTons} Tonnes)`],
            ];
          } else if (lastResultData.mode === "paving_bricks") {
            tableRows = [
              ["Total Paving Area", `${lastResultData.pavingAreaSqm} m² (${lastResultData.pavingAreaSqft} sq.ft)`],
              ["Paver Format / Type", `${lastResultData.paverLengthMm} × ${lastResultData.paverWidthMm} mm (${lastResultData.paverLabel})`],
              ["Joint Gap Spacing", `${lastResultData.jointGapMm} mm`],
              ["Coverage Density", `${lastResultData.paversPerSqm} pavers/m² (${lastResultData.paversPerSqft} /sq.ft)`],
              ["Base Pavers Count", `${lastResultData.paversBeforeWastage.toLocaleString()} Pavers`],
              ["Wastage & Edge Cuts", `${lastResultData.wastagePercent}% (${lastResultData.wastageCount.toLocaleString()} Pavers)`],
              ["Final Estimated Pavers", `${lastResultData.finalEstimatedPavers.toLocaleString()} Pavers`],
              ["Sand Bedding Layer", lastResultData.beddingSandVolumeCum ? `${lastResultData.beddingSandVolumeCum} m³ (${lastResultData.beddingSandVolumeCft} CFT / ${lastResultData.beddingSandTons} Tonnes)` : "None specified"],
            ];
          } else if (lastResultData.mode === "custom_brickwork") {
            tableRows = [
              ["Total Structure Volume", `${lastResultData.totalVolumeCum} m³ (${lastResultData.totalVolumeCft} CFT)`],
              ["Custom Brick Format", lastResultData.brickSpec],
              ["Base Bricks Required", `${lastResultData.baseBricks.toLocaleString()} Bricks`],
              ["Final Estimated Bricks", `${lastResultData.finalBricks.toLocaleString()} Bricks`],
              ["Dry Mortar Volume", `${lastResultData.dryMortarVolumeCum} m³ (${lastResultData.dryMortarVolumeCft} CFT)`],
              ["Mortar Mix Ratio", lastResultData.ratioLabel],
              ["Cement Required", `${lastResultData.cementBags50kg} Bags (${lastResultData.cementWeightKg} kg)`],
              ["Sand Required", `${lastResultData.sandVolumeCft} CFT (${lastResultData.sandWeightTons} Tonnes)`],
            ];
          }

          if (lastResultData.costSummary) {
            tableRows.push(["Estimated Material Cost", `${lastResultData.costSummary.formattedTotal} (${lastResultData.costSummary.currency})`]);
          }

          // Draw Table Rows via autoTable
          (doc as any).autoTable({
            startY: y,
            head: [["Calculation Parameter / Metric", "Value & Quantity"]],
            body: tableRows.map(([lbl, val]) => [
              lbl.replace(/[³²×÷₹]/g, (m) => m === '³' ? '^3' : m === '²' ? '^2' : m === '×' ? 'x' : m === '₹' ? 'Rs.' : '/'),
              val.replace(/[³²×÷₹]/g, (m) => m === '³' ? ' m3' : m === '²' ? ' m2' : m === '×' ? ' x ' : m === '₹' ? 'Rs.' : '/')
            ]),
            theme: "striped",
            headStyles: { fillColor: [37, 99, 235], textColor: 255, fontStyle: "bold", fontSize: 9 },
            columnStyles: {
              0: { cellWidth: 200, fontStyle: "bold" },
              1: { cellWidth: "auto" },
            },
            margin: { left: margin, right: margin, top: 40, bottom: 40 },
            styles: { fontSize: 8.5, cellPadding: 4.5, overflow: "linebreak" },
            pageBreak: "auto",
          });

          // Footer Branding on every page
          const totalPages = (doc.internal as any).getNumberOfPages();
          for (let i = 1; i <= totalPages; i++) {
            doc.setPage(i);
            doc.setFont("helvetica", "normal");
            doc.setFontSize(8);
            doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
            doc.text("Generated using AIFreecalculator.com", margin, pageHeight - 20);
            doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, pageHeight - 20, { align: "right" });
          }

          const fileDate = dateStr;
          const fileName = `brickwork-calculation-${fileDate}.pdf`;
          doc.save(fileName);
        } catch (e) {
          console.error("PDF generation error:", e);
        } finally {
          if (txtBtn) txtBtn.textContent = "Download PDF";
        }
      });
    }
  </script>
</CalculatorLayout>
