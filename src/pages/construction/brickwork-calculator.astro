    // Set Global Measurement Unit
    function setGlobalUnitSystem(newUnit: "metric" | "imperial") {
      if (newUnit === globalUnit) return;
      const prev = globalUnit;
      globalUnit = newUnit;

      btnUnitMetric.classList.toggle("bg-white", newUnit === "metric");
      btnUnitMetric.classList.toggle("text-blue-600", newUnit === "metric");
      btnUnitMetric.classList.toggle("shadow-xs", newUnit === "metric");
      btnUnitMetric.classList.toggle("dark:bg-slate-700", newUnit === "metric");
      btnUnitMetric.classList.toggle("dark:text-white", newUnit === "metric");
      btnUnitMetric.classList.toggle("text-slate-600", newUnit !== "metric");

      btnUnitImperial.classList.toggle("bg-white", newUnit === "imperial");
      btnUnitImperial.classList.toggle("text-blue-600", newUnit === "imperial");
      btnUnitImperial.classList.toggle("shadow-xs", newUnit === "imperial");
      btnUnitImperial.classList.toggle("dark:bg-slate-700", newUnit === "imperial");
      btnUnitImperial.classList.toggle("dark:text-white", newUnit === "imperial");
      btnUnitImperial.classList.toggle("text-slate-600", newUnit !== "imperial");

      // Update Sub-selectors
      if (wbUnit) wbUnit.value = newUnit;
      if (bmUnit) bmUnit.value = newUnit;
      if (pbUnit) pbUnit.value = newUnit === "imperial" ? "sqft" : "sqm";

      // Convert Physical Dimensions
      const mToFt = 3.28084;
      const ftToM = 1 / mToFt;
      const sqmToSqft = 10.7639;
      const sqftToSqm = 1 / sqmToSqft;

      if (newUnit === "imperial") {
        wbLength.value = (parseFloat(wbLength.value) * mToFt).toFixed(2);
        wbHeight.value = (parseFloat(wbHeight.value) * mToFt).toFixed(2);
        wbOpenings.value = (parseFloat(wbOpenings.value) * sqmToSqft).toFixed(2);

        bmLength.value = (parseFloat(bmLength.value) * mToFt).toFixed(2);
        bmHeight.value = (parseFloat(bmHeight.value) * mToFt).toFixed(2);
        bmOpenings.value = (parseFloat(bmOpenings.value) * sqmToSqft).toFixed(2);

        pbArea.value = (parseFloat(pbArea.value) * sqmToSqft).toFixed(2);
      } else {
        wbLength.value = Math.max(0.1, parseFloat((parseFloat(wbLength.value) * ftToM).toFixed(2))).toString();
        wbHeight.value = Math.max(0.1, parseFloat((parseFloat(wbHeight.value) * ftToM).toFixed(2))).toString();
        wbOpenings.value = Math.max(0, parseFloat((parseFloat(wbOpenings.value) * sqftToSqm).toFixed(2))).toString();

        bmLength.value = Math.max(0.1, parseFloat((parseFloat(bmLength.value) * ftToM).toFixed(2))).toString();
        bmHeight.value = Math.max(0.1, parseFloat((parseFloat(bmHeight.value) * ftToM).toFixed(2))).toString();
        bmOpenings.value = Math.max(0, parseFloat((parseFloat(bmOpenings.value) * sqftToSqm).toFixed(2))).toString();

        pbArea.value = Math.max(1, parseFloat((parseFloat(pbArea.value) * sqftToSqm).toFixed(2))).toString();
      }

      // Update Labels
      const lenStr = newUnit === "imperial" ? "ft" : "m";
      const areaStr = newUnit === "imperial" ? "sq.ft" : "m²";

      document.querySelectorAll(".unit-len-label").forEach((el) => (el.textContent = lenStr));
      document.querySelectorAll(".unit-area-label").forEach((el) => (el.textContent = areaStr));
      document.querySelectorAll(".unit-pb-area-label").forEach((el) => (el.textContent = areaStr));

      renderDynamicVisual();
      markResultsStale();
    }

    btnUnitMetric.addEventListener("click", () => setGlobalUnitSystem("metric"));
    btnUnitImperial.addEventListener("click", () => setGlobalUnitSystem("imperial"));

    // Set Global Currency
