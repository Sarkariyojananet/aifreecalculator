---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";

const faqs = [
  {
    q: "What is a brickwork calculator?",
    a: "A brickwork calculator is a tool that estimates the number of bricks required for a wall or other masonry project. By entering the wall dimensions, brick size, mortar joint thickness, openings, and wastage allowance, you can get an approximate estimate of the bricks and, where supported, the mortar materials required.",
  },
  {
    q: "How do I calculate the number of bricks required for a wall?",
    a: "First, calculate the total wall area or volume and deduct the area of doors, windows, and other openings. Then use the effective brick dimensions, including the mortar joint where applicable, to estimate how many bricks are needed. Finally, add a suitable wastage allowance for cuts, breakage, and handling.",
  },
  {
    q: "Should doors and windows be deducted from the brickwork calculation?",
    a: "Yes. In most cases, the area of doors, windows, and other large openings should be deducted from the total wall area to avoid overestimating the number of bricks required. However, small openings or specific construction details may be handled differently depending on the project specifications.",
  },
  {
    q: "How is mortar quantity calculated for brickwork?",
    a: "Mortar quantity is generally estimated by calculating the total brickwork volume and subtracting the estimated volume occupied by the bricks. The remaining quantity gives the approximate wet mortar volume. A dry volume factor and the selected cement-to-sand mix ratio can then be used to estimate the required cement and sand.",
  },
  {
    q: "How much wastage should I include when calculating bricks?",
    a: "The appropriate wastage allowance depends on the project, brick type, layout, cutting requirements, transportation, and site conditions. A common estimate may be around 5% to 10%, but projects with complex layouts or significant cutting may require a higher allowance.",
  },
  {
    q: "Can I use custom brick dimensions?",
    a: "Yes. Custom brick dimensions can be used when the bricks on your project differ from standard or preset sizes. For the most accurate estimate, enter the actual brick length, width, and height, along with the expected mortar joint thickness.",
  },
  {
    q: "Can I download my brickwork calculation as a PDF?",
    a: "Yes. After completing a calculation, you can download the result as a PDF. The PDF can include the entered dimensions, opening deductions, brick size, mortar joint thickness, wastage percentage, estimated brick quantity, and other calculated material requirements, depending on the selected calculator mode.",
  },
];
---

<CalculatorLayout
  title="Brickwork & Mortar Calculator – Calculate Bricks, Cement & Sand | AI Free Calculator"
  description="Calculate the number of bricks, mortar volume, cement bags, sand quantities, and paving bricks required for walls and masonry projects with opening deductions and wastage analysis."
  category="Construction"
  calculatorName="Brickwork & Mortar Calculator"
  slug="brickwork-calculator"
  keywords={[
    "brickwork calculator",
    "bricks calculator",
    "paving bricks calculator",
    "bricks calculator for wall",
    "number of bricks calculator",
    "brickwork calculator india",
    "brick quantity calculator",
    "wall brick calculator",
    "calculate number of bricks",
    "brick wall estimator",
    "mortar quantity calculator",
    "cement and sand for brickwork",
    "paving block calculator",
    "brick masonry calculator",
  ]}
>
  <div class="space-y-6">
    <!-- Top Utility Toolbar: Unit System & Currency Switcher -->
    <div
      class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white p-3.5 shadow-xs sm:px-5 dark:border-slate-800 dark:bg-slate-900"
    >
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Measurement System:</span>
        <div class="inline-flex rounded-xl bg-slate-100 p-1 dark:bg-slate-800" role="group">
          <button
            type="button"
            id="btn-unit-metric"
            class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-600 shadow-xs transition dark:bg-slate-700 dark:text-white cursor-pointer"
          >
            Metric (m, mm, m³)
          </button>
          <button
            type="button"
            id="btn-unit-imperial"
            class="rounded-lg px-3 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 transition dark:text-slate-400 dark:hover:text-white cursor-pointer"
          >
            Imperial (ft, in, CFT)
          </button>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Currency:</span>
        <div class="inline-flex rounded-xl bg-slate-100 p-1 dark:bg-slate-800" role="group">
          <button
            type="button"
            id="btn-curr-inr"
            class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-blue-600 shadow-xs transition dark:bg-slate-700 dark:text-white cursor-pointer"
          >
            ₹ INR (India)
          </button>
          <button
            type="button"
            id="btn-curr-usd"
            class="rounded-lg px-3 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 transition dark:text-slate-400 dark:hover:text-white cursor-pointer"
          >
            $ USD (USA)
          </button>
        </div>
      </div>
    </div>

    <!-- Mode Selector Tabs -->
    <div
      class="rounded-2xl border border-slate-200/80 bg-slate-50/60 p-1.5 dark:border-slate-800 dark:bg-slate-900/50"
    >
      <div class="grid grid-cols-2 gap-1.5 sm:grid-cols-4" id="mode-tabs">
        <button
          type="button"
          data-mode="wall_brickwork"
          class="mode-btn active flex items-center justify-center gap-2 rounded-xl border border-blue-600 bg-blue-50 px-3 py-2.5 text-xs sm:text-sm font-bold text-blue-700 shadow-sm transition dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer"
        >
          <span>🧱</span> Wall Brickwork
        </button>
        <button
          type="button"
          data-mode="brick_mortar"
          class="mode-btn flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs sm:text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 cursor-pointer"
        >
          <span>📦</span> Brick Mortar
        </button>
        <button
          type="button"
          data-mode="paving_bricks"
          class="mode-btn flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs sm:text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 cursor-pointer"
        >
          <span>🔲</span> Paving Bricks
        </button>
        <button
          type="button"
          data-mode="custom_brickwork"
          class="mode-btn flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs sm:text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 cursor-pointer"
        >
          <span>⚙️</span> Custom Brickwork
        </button>
      </div>
    </div>

    <!-- LIVE STRUCTURAL VISUAL DETAILING SVG DIAGRAM (UPDATES REAL-TIME) -->
    <div
      class="rounded-2xl border border-slate-200/80 bg-slate-50/70 p-4 sm:p-5 dark:border-slate-800 dark:bg-slate-950/60"
    >
      <div
        class="flex items-center justify-between border-b border-slate-200/80 pb-3 dark:border-slate-800"
      >
        <h3
          class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2"
        >
          <span>📐</span> Live Masonry Detailing Diagram (Updates Real-Time)
        </h3>
        <span
          id="lbl-visual-badge"
          class="rounded-md bg-blue-100 px-2.5 py-0.5 text-[11px] font-bold text-blue-700 dark:bg-blue-900/60 dark:text-blue-300"
        >
          Wall Elevation & Cross-Section
        </span>
      </div>
      <div class="mt-4 flex flex-col items-center justify-center min-h-[220px]">
        <svg
          id="svg-brickwork"
          viewBox="0 0 560 220"
          class="w-full max-w-[560px] h-auto"
        ></svg>
        <div
          id="lbl-visual-caption"
          class="mt-2 text-xs font-semibold text-slate-600 dark:text-slate-400 text-center"
        >
          --
        </div>
      </div>
    </div>

    <!-- Error Banner -->
    <div
      id="error-box"
      class="hidden rounded-xl border border-red-200 bg-red-50/90 p-4 text-xs sm:text-sm font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/50 dark:text-red-300"
      role="alert"
      aria-live="polite"
    >
    </div>

    <!-- Calculator Input Form Container -->
    <div
      class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm sm:p-6 dark:border-slate-800 dark:bg-slate-900"
    >
      <!-- ========================================================= -->
      <!-- 1. WALL BRICKWORK INPUTS -->
      <!-- ========================================================= -->
      <div id="section-input-wall-brickwork" class="space-y-4">
        <div
          class="flex items-center justify-between border-b border-slate-200/80 pb-2 dark:border-slate-800"
        >
          <h2
            class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"
          >
            <span>🧱</span> Wall Dimensions & Brick Specifications
          </h2>
          <div class="flex items-center gap-1.5 text-xs font-semibold">
            <label for="inp-wb-unit" class="text-slate-500">Unit System:</label>
            <select
              id="inp-wb-unit"
              class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
            >
              <option value="metric" selected>Metric (Meters, mm)</option>
              <option value="imperial">Imperial (Feet, Inches)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div>
            <label
              for="inp-wb-length"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Wall Length (<span class="unit-len-label">m</span>)
            </label>
            <input
              type="number"
              id="inp-wb-length"
              value="10"
              min="0.1"
              step="any"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="10"
            />
          </div>

          <div>
            <label
              for="inp-wb-height"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Wall Height (<span class="unit-len-label">m</span>)
            </label>
            <input
              type="number"
              id="inp-wb-height"
              value="3.0"
              min="0.1"
              step="any"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="3.0"
            />
          </div>

          <div>
            <label
              for="inp-wb-walls"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Number of Similar Walls
            </label>
            <input
              type="number"
              id="inp-wb-walls"
              value="1"
              min="1"
              step="1"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="1"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label
              for="inp-wb-thickness-preset"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Wall Thickness
            </label>
            <select
              id="inp-wb-thickness-preset"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
            >
              <option value="half_brick"
                >Half Brick Wall (4.5" / 115 mm / Partition)</option
              >
              <option value="one_brick" selected
                >One Brick Wall (9" / 230 mm / Main Wall)</option
              >
              <option value="one_half_brick"
                >One & Half Brick Wall (13.5" / 345 mm / Load Bearing)</option
              >
              <option value="custom">Custom Thickness</option>
            </select>
            <div id="div-wb-custom-thick" class="hidden mt-2 flex gap-2">
              <input
                type="number"
                id="inp-wb-custom-thick-val"
                value="230"
                min="10"
                step="any"
                class="w-2/3 rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                placeholder="230"
              />
              <select
                id="inp-wb-custom-thick-unit"
                class="w-1/3 rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
              >
                <option value="mm" selected>mm</option>
                <option value="cm">cm</option>
                <option value="in">in</option>
                <option value="m">m</option>
              </select>
            </div>
          </div>

          <div>
            <label
              for="inp-wb-brick-preset"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Brick Size Standard
            </label>
            <select
              id="inp-wb-brick-preset"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
            >
              <option value="modular_metric" selected
                >Standard Metric Modular (190 × 90 × 90 mm)</option
              >
              <option value="indian_traditional"
                >Indian Traditional Red Clay (225 × 112.5 × 75 mm / 9"×4.25"×3")</option
              >
              <option value="uk_standard"
                >UK Standard Facing (215 × 102.5 × 65 mm)</option
              >
              <option value="us_modular"
                >US Modular Brick (194 × 92 × 57 mm / 7⅝"×3⅝"×2¼")</option
              >
              <option value="custom">Custom Brick Size</option>
            </select>
            <div
              id="div-wb-custom-brick"
              class="hidden mt-2 grid grid-cols-3 gap-2"
            >
              <div>
                <label
                  for="inp-wb-custom-bl"
                  class="text-[10px] font-bold text-slate-500 dark:text-slate-400"
                  >Length (mm)</label
                >
                <input
                  type="number"
                  id="inp-wb-custom-bl"
                  value="190"
                  min="10"
                  step="1"
                  class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="190"
                />
              </div>
              <div>
                <label
                  for="inp-wb-custom-bw"
                  class="text-[10px] font-bold text-slate-500 dark:text-slate-400"
                  >Width (mm)</label
                >
                <input
                  type="number"
                  id="inp-wb-custom-bw"
                  value="90"
                  min="10"
                  step="1"
                  class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="90"
                />
              </div>
              <div>
                <label
                  for="inp-wb-custom-bh"
                  class="text-[10px] font-bold text-slate-500 dark:text-slate-400"
                  >Height (mm)</label
                >
                <input
                  type="number"
                  id="inp-wb-custom-bh"
                  value="90"
                  min="10"
                  step="1"
                  class="mt-0.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="90"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div>
            <label
              for="inp-wb-joint"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Mortar Joint Thickness (mm)
            </label>
            <input
              type="number"
              id="inp-wb-joint"
              value="10"
              min="0"
              max="50"
              step="1"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="10"
            />
          </div>

          <div>
            <label
              for="inp-wb-openings"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Doors & Windows Deduction (<span class="unit-area-label">m²</span
              >)
            </label>
            <input
              type="number"
              id="inp-wb-openings"
              value="4.0"
              min="0"
              step="any"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="4.0"
            />
          </div>

          <div>
            <label
              for="inp-wb-wastage"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Brick Wastage Allowance (%)
            </label>
            <input
              type="number"
              id="inp-wb-wastage"
              value="5"
              min="0"
              max="30"
              step="1"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="5"
            />
          </div>
        </div>
      </div>

      <!-- ========================================================= -->
      <!-- 2. BRICK MORTAR INPUTS -->
      <!-- ========================================================= -->
      <div id="section-input-brick-mortar" class="hidden space-y-4">
        <div
          class="flex items-center justify-between border-b border-slate-200/80 pb-2 dark:border-slate-800"
        >
          <h2
            class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"
          >
            <span>📦</span> Mortar Volume & Cement/Sand Mix Estimation
          </h2>
          <div class="flex items-center gap-1.5 text-xs font-semibold">
            <label for="inp-bm-unit" class="text-slate-500">Unit System:</label>
            <select
              id="inp-bm-unit"
              class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
            >
              <option value="metric" selected>Metric (Meters, mm)</option>
              <option value="imperial">Imperial (Feet, Inches)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
          <div>
            <label
              for="inp-bm-length"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Wall Length (<span class="unit-len-label">m</span>)
            </label>
            <input
              type="number"
              id="inp-bm-length"
              value="10"
              min="0.1"
              step="any"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="10"
            />
          </div>

          <div>
            <label
              for="inp-bm-height"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Wall Height (<span class="unit-len-label">m</span>)
            </label>
            <input
              type="number"
              id="inp-bm-height"
              value="3.0"
              min="0.1"
              step="any"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="3.0"
            />
          </div>

          <div>
            <label
              for="inp-bm-thickness"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Wall Thickness (mm)
            </label>
            <input
              type="number"
              id="inp-bm-thickness"
              value="230"
              min="10"
              step="1"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="230"
            />
          </div>

          <div>
            <label
              for="inp-bm-openings"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Deductions (<span class="unit-area-label">m²</span>)
            </label>
            <input
              type="number"
              id="inp-bm-openings"
              value="4.0"
              min="0"
              step="any"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="4.0"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label
              for="inp-bm-brick-preset"
              class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
            >
              Brick Size
            </label>
            <select
              id="inp-bm-brick-preset"
              class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
            >
              <option value="modular_metric" selected
                >Standard Metric Modular (190 × 90 × 90 mm)</option
              >
              <option value="indian_traditional"
                >Indian Traditional Red Clay (225 × 112.5 × 75 mm)</option
              >
              <option value="uk_standard"
                >UK Standard Facing (215 × 102.5 × 65 mm)</option
              >
              <option value="us_modular"
                >US Modular Brick (194 × 92 × 57 mm)</option
              >
              <option value="custom">Custom Brick Size</option>
            </select>
            <div
              id="div-bm-custom-brick"
              class="hidden mt-2 grid grid-cols-3 gap-2"
            >
              <input
                type="number"
                id="inp-bm-custom-bl"
                value="190"
                min="10"
                step="1"
                class="rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                placeholder="L (mm)"
              />
              <input
                type="number"
                id="inp-bm-custom-bw"
                value="90"
                min="10"
                step="1"
                class="rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                placeholder="W (mm)"
              />
