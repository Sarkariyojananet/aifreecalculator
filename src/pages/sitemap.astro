---
import BaseLayout from '../layouts/BaseLayout.astro';
import { calculators, categories } from '../data/calculators';

const corePages = [
  { name: 'Home', path: '/' },
  { name: 'All Calculators Directory', path: '/all-calculators/' },
  { name: 'About Us', path: '/about/' },
  { name: 'Contact Us', path: '/contact/' },
  { name: 'Privacy Policy', path: '/privacy-policy/' },
  { name: 'Terms of Service', path: '/terms/' },
  { name: 'Disclaimer', path: '/disclaimer/' },
];

// Group calculators by category
const categoryGroups = categories.map((cat) => ({
  name: cat.name,
  icon: cat.icon,
  path: cat.path,
  description: cat.description,
  calculators: calculators
    .filter((c) => c.category.toLowerCase() === cat.name.toLowerCase())
    .sort((a, b) => a.name.localeCompare(b.name)),
}));
---

<BaseLayout
  title="HTML Sitemap & Complete Directory | AI Free Calculator"
  description="Explore the full directory of 100+ free online calculators organized by category including Construction, Finance, Health, Math, and General tools."
  canonicalUrl="https://aifreecalculator.com/sitemap/"
  keywords={['sitemap', 'all calculators', 'calculator directory', 'site map', 'free online calculators list']}
>
  <div class="border-b border-slate-200 bg-white px-4 py-8 dark:border-slate-800 dark:bg-slate-900 sm:py-12">
    <div class="mx-auto max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400">Home</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">HTML Sitemap</span>
      </nav>

      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-bold tracking-wider text-blue-700 dark:border-blue-900/50 dark:bg-blue-950/60 dark:text-blue-400 mb-3">
        <span>🗺️</span> COMPLETE SITE DIRECTORY
      </div>

      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        HTML Sitemap &amp; Tool Index
      </h1>

      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Browse our entire collection of {calculators.length} free calculators and engineering utilities organized by domain. Fast, accurate, and completely free to use online.
      </p>

      <!-- Live Search Box -->
      <div class="mt-6 max-w-md">
        <input
          type="text"
          id="sitemap-search"
          placeholder="Filter calculators by name or keyword..."
          class="w-full rounded-2xl border border-slate-300 bg-white py-2.5 px-4 text-xs font-medium text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
      </div>
    </div>
  </div>

  <main class="mx-auto max-w-5xl px-4 py-10 space-y-12">
    
    <!-- Core Pages Section -->
    <section class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 shadow-xs">
      <div class="flex items-center gap-2.5 border-b border-slate-100 pb-4 dark:border-slate-800">
        <span class="text-xl">🌐</span>
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">
          Primary Site Navigation
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mt-4">
        {corePages.map((page) => (
          <a
            href={page.path}
            class="flex items-center gap-2 rounded-xl p-2.5 text-xs font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-blue-950/50 dark:hover:text-blue-400 transition"
          >
            <span class="text-slate-400">•</span>
            <span>{page.name}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Calculator Categories -->
    {categoryGroups.map((group) => (
      <section class="sitemap-category rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-4 dark:border-slate-800">
          <div class="flex items-center gap-3">
            <span class="text-2xl">{group.icon}</span>
            <div>
              <h2 class="text-lg font-bold text-slate-900 dark:text-white">
                <a href={group.path} class="hover:text-blue-600 transition">
                  {group.name} Calculators
                </a>
              </h2>
              <p class="text-xs text-slate-400 mt-0.5">{group.description}</p>
            </div>
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-0.5 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300 self-start sm:self-auto">
            {group.calculators.length} Tools
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 mt-5">
          {group.calculators.map((c) => (
            <a
              href={c.path.endsWith('/') ? c.path : `${c.path}/`}
              class="sitemap-calc-item flex items-center gap-2.5 rounded-xl p-2.5 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-slate-800/60 dark:hover:text-blue-400 transition border border-transparent hover:border-slate-200 dark:hover:border-slate-700"
              data-name={c.name.toLowerCase()}
              data-desc={c.description.toLowerCase()}
            >
              <span class="text-base shrink-0">{c.icon || '🧮'}</span>
              <span class="truncate">{c.name}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

  </main>

  <script is:inline>
    const searchInput = document.getElementById('sitemap-search');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target.value || '').toLowerCase().trim();
        const items = document.querySelectorAll('.sitemap-calc-item');
        const sections = document.querySelectorAll('.sitemap-category');

        items.forEach((item) => {
          const name = item.getAttribute('data-name') || '';
          const desc = item.getAttribute('data-desc') || '';
          const match = !query || name.includes(query) || desc.includes(query);
          item.style.display = match ? 'flex' : 'none';
        });

        // Hide empty sections during search
        sections.forEach((sec) => {
          const visibleItems = sec.querySelectorAll('.sitemap-calc-item[style="display: flex;"]');
          if (query && visibleItems.length === 0) {
            sec.style.display = 'none';
          } else {
            sec.style.display = 'block';
          }
        });
      });
    }
  </script>
</BaseLayout>
