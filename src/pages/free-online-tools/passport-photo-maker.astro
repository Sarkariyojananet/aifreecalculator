---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";

// FAQ Schema data for search engines
const faqs = [
  {
    question: "What is the official passport photo size for India?",
    answer:
      "The official Indian passport photo size is 3.5 cm × 4.5 cm (35 mm × 45 mm / 413 × 531 pixels at 300 DPI) with 70% to 80% face coverage. For Indian PAN cards, the standard size is 2.5 cm × 3.5 cm (25 mm × 35 mm / 295 × 413 pixels), and for OCI (Overseas Citizen of India) cards, it is 5.1 cm × 5.1 cm (2 × 2 inches / 600 × 600 pixels).",
  },
  {
    question: "What is the official size for a US Visa or US Passport photo?",
    answer:
      "The official US Visa and US Passport photo size is 2 × 2 inches (51 × 51 mm / 600 × 600 pixels at 300 DPI). The head height from the bottom of the chin to the top of the hair must measure between 1 inch and 1 3/8 inches (25 mm to 35 mm).",
  },
  {
    question: "How many passport photos fit on an A4 sheet or 4×6 photo paper?",
    answer:
      "On a full A4 sheet (210 × 297 mm), you can fit up to 30 standard 35×45 mm photos (or up to 49 smaller PAN card photos), or 10 photos on a handy 1/3 A4 strip. On standard 4×6 inch photo paper, you can comfortably print 6 standard passport photos with clean cutting guide borders.",
  },
  {
    question: "How do I print passport photos at home with high quality?",
    answer:
      "Select your passport size and choose 'A4 Sheet' or '4×6 Photo Paper'. Click 'Download PDF', open your printer dialog, ensure 'Scale' is set to 100% (Actual Size - do not select 'Fit to Page'), and use glossy 180-240 GSM photo inkjet paper.",
  },
  {
    question: "Are my uploaded photos sent to any server or cloud database?",
    answer:
      "No. All photo cropping, face alignment, grid calculations, and PDF generation take place 100% locally in your web browser using HTML5 Canvas. Your photos are never uploaded or stored remotely.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<CalculatorLayout
  layoutVariant="workspace"
  title="Passport Photo Maker - Online & Free | 3.5x4.5cm & US Visa 2x2"
  description="Make passport size images in seconds: 3.5×4.5 cm Indian passport, 2×2 inch US visa, face alignment guides, and printable A4/4x6 sheets at 300 DPI for free."
  category="Free Online Tools"
  calculatorName="Passport Photo Maker"
  slug="passport-photo-maker"
  keywords={[
    "passport photo maker",
    "aifreecalculator passport photo maker",
    "online passport photo maker",
    "passport size photo maker",
    "3.5 x 4.5 cm photo",
    "passport photo a4 sheet",
    "us visa photo maker 2x2",
    "printable passport photo sheet",
    "passport photo generator free",
    "indian passport photo size",
    "schengen visa photo online",
  ]}
>
  <!-- Injected FAQ Structured Data Schema (WebApplication schema is provided by CalculatorLayout) -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- Privacy & 300 DPI Security Banner -->
    <div
      class="flex items-center justify-between rounded-2xl border border-blue-200 bg-blue-50/70 p-3.5 text-xs text-blue-900 dark:border-blue-900/50 dark:bg-blue-950/30 dark:text-blue-300"
    >
      <div class="flex items-center gap-3">
        <div
          class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-white font-bold"
        >
          🔒
        </div>
        <div>
          <span class="font-bold">100% Client-Side Private:</span>
          Your photos are processed in your browser. Zero cloud uploads, zero watermarks.
        </div>
      </div>
      <div
        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300 text-[11px] font-semibold"
      >
        <span>🖨️ True 300 DPI Print Calibrated</span>
      </div>
    </div>

    <!-- ================= 1. HERO DROP ZONE (INITIAL STATE - SCREENSHOT 1) ================= -->
    <div
      id="passport-hero-upload"
      class="rounded-3xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 sm:p-14 text-center shadow-xs transition hover:border-blue-500"
    >
      <div class="mx-auto max-w-xl space-y-5">
        <div>
          <h2
            class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white"
          >
            Make Passport Size Photo
          </h2>
          <p class="mt-1.5 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            Welcome to Passport Photo Maker - Your Reliable Solution for Passport Size Images!
          </p>
        </div>

        <div
          id="passport-drop-zone"
          class="cursor-pointer rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-8 transition hover:bg-blue-50/30 dark:hover:bg-slate-800/70 space-y-4"
        >
          <p class="text-sm sm:text-base font-semibold text-slate-700 dark:text-slate-300">
            Select Or Drag & Drop Image Here
          </p>
          <input
            type="file"
            id="passport-file-input"
            accept="image/jpeg,image/png,image/webp"
            class="hidden"
          />
          <button
            type="button"
            id="passport-browse-btn"
            class="inline-flex items-center gap-2 rounded-xl bg-blue-700 hover:bg-blue-800 active:scale-95 px-7 py-3 text-sm font-bold text-white shadow-md shadow-blue-700/20 transition cursor-pointer"
          >
            Select Image
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-slate-500 pt-2">
          <span class="flex items-center gap-1 font-semibold text-slate-700 dark:text-slate-300">
            <span>🇮🇳</span> India (3.5×4.5cm)
          </span>
          <span>•</span>
          <span class="flex items-center gap-1 font-semibold text-slate-700 dark:text-slate-300">
            <span>🇺🇸</span> USA Visa (2×2in)
          </span>
          <span>•</span>
          <span class="flex items-center gap-1 font-semibold text-slate-700 dark:text-slate-300">
            <span>🇨🇦</span> Canada (50×70mm)
          </span>
          <span>•</span>
          <span class="flex items-center gap-1 font-semibold text-slate-700 dark:text-slate-300">
            <span>📄</span> A4 & 4×6 Sheets
          </span>
        </div>
      </div>
    </div>

    <!-- ================= 2. FIVE-STEP WIZARD STUDIO CONTAINER (POST UPLOAD) ================= -->
    <div
      id="passport-studio-container"
      class="hidden w-full max-w-4xl mx-auto space-y-3 sm:space-y-4"
    >
      <!-- STEP NAVIGATION TABS -->
      <div class="flex items-center justify-center">
        <div
          role="tablist"
          aria-label="Passport Photo Steps"
          class="inline-flex items-center p-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs overflow-x-auto max-w-full gap-1"
        >
          <button
            type="button"
            id="tab-step-size"
            role="tab"
            aria-selected="true"
            aria-controls="panel-step-size"
            data-step="size"
            class="wizard-step-tab active flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-white bg-blue-700 shadow-xs"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
            </svg>
            Size
          </button>
          <button
            type="button"
            id="tab-step-crop"
            role="tab"
            aria-selected="false"
            aria-controls="panel-step-crop"
            data-step="crop"
            class="wizard-step-tab flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Crop
          </button>
          <button
            type="button"
            id="tab-step-bg"
            role="tab"
            aria-selected="false"
            aria-controls="panel-step-bg"
            data-step="bg"
            class="wizard-step-tab flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 4.5 4.5 0 01.5-2L6 8l3 3-2.5 2.5a2.5 2.5 0 000 3.5L7 21zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.5"/>
            </svg>
            Background
          </button>
          <button
            type="button"
            id="tab-step-download"
            role="tab"
            aria-selected="false"
            aria-controls="panel-step-download"
            data-step="download"
            class="wizard-step-tab flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Download
          </button>
        </div>
      </div>

      <!-- MAIN CONTAINER CARD -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5 shadow-xs">
        
        <!-- ================= STEP 1: SIZE SELECTION ================= -->
        <div id="panel-step-size" role="tabpanel" aria-labelledby="tab-step-size" class="wizard-panel space-y-3 sm:space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-2">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-100">
                1. Select Passport Size Preset
              </h3>
              <p class="text-[11px] text-slate-500">Choose official standard dimension or enter custom</p>
            </div>
            <div class="inline-flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400">
              <label for="passport-dpi-input" class="font-semibold">Print DPI:</label>
              <div class="flex items-center border border-slate-300 dark:border-slate-700 rounded-md overflow-hidden">
                <input
                  type="number"
                  id="passport-dpi-input"
                  aria-label="Default DPI"
                  value="300"
                  min="72"
                  max="600"
                  class="w-14 px-1.5 py-0.5 text-center font-bold text-xs text-slate-800 dark:text-white bg-slate-50 dark:bg-slate-800 focus:outline-none"
                />
                <span class="bg-slate-700 text-white font-bold text-[10px] px-1.5 py-1">
                  DPI
                </span>
              </div>
            </div>
          </div>

          <!-- Preset Size Cards (4 Options) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <!-- Preset 1: India / UK / Europe / Australia / Philippines -->
            <div
              data-preset="india_35x45"
              role="button"
              tabindex="0"
              aria-pressed="true"
              class="passport-size-card relative cursor-pointer rounded-xl border-2 border-blue-600 bg-blue-50/40 dark:bg-blue-950/20 p-3 text-center transition-all hover:shadow-xs flex flex-col justify-between min-h-26.25 focus:outline-hidden focus:ring-2 focus:ring-blue-500"
            >
              <div class="selected-badge absolute -top-2.5 left-2.5 bg-blue-700 text-white text-[10px] font-black px-2 py-0.2 rounded-full shadow-xs">
                ✓ Selected
              </div>
              <div class="space-y-0.5 mt-1">
                <div class="font-black text-slate-800 dark:text-white text-sm sm:text-base">
                  3.5 × 4.5 CM
                </div>
                <div class="text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                  35 MM × 45 MM
                </div>
              </div>
              <div class="border-t border-slate-200 dark:border-slate-800 pt-1.5 text-[11px] text-slate-500 font-medium">
                India, Philippines, UK, Europe
              </div>
            </div>

            <!-- Preset 2: USA / OCI -->
            <div
              data-preset="usa_2x2"
              role="button"
              tabindex="0"
              aria-pressed="false"
              class="passport-size-card relative cursor-pointer rounded-xl border-2 border-slate-200 dark:border-slate-800 hover:border-blue-400 bg-white dark:bg-slate-900 p-3 text-center transition-all hover:shadow-xs flex flex-col justify-between min-h-26.25 focus:outline-hidden focus:ring-2 focus:ring-blue-500"
            >
              <div class="selected-badge hidden absolute -top-2.5 left-2.5 bg-blue-700 text-white text-[10px] font-black px-2 py-0.2 rounded-full shadow-xs">
                ✓ Selected
              </div>
              <div class="space-y-0.5 mt-1">
                <div class="font-black text-slate-800 dark:text-white text-sm sm:text-base">
                  2 × 2 Inch
                </div>
                <div class="text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                  51 MM × 51 MM
                </div>
              </div>
              <div class="border-t border-slate-200 dark:border-slate-800 pt-1.5 text-[11px] text-slate-500 font-medium">
                USA, OCI Card
              </div>
            </div>

            <!-- Preset 3: Canada -->
            <div
              data-preset="canada_50x70"
              role="button"
              tabindex="0"
              aria-pressed="false"
              class="passport-size-card relative cursor-pointer rounded-xl border-2 border-slate-200 dark:border-slate-800 hover:border-blue-400 bg-white dark:bg-slate-900 p-3 text-center transition-all hover:shadow-xs flex flex-col justify-between min-h-26.25 focus:outline-hidden focus:ring-2 focus:ring-blue-500"
            >
              <div class="selected-badge hidden absolute -top-2.5 left-2.5 bg-blue-700 text-white text-[10px] font-black px-2 py-0.2 rounded-full shadow-xs">
                ✓ Selected
              </div>
              <div class="space-y-0.5 mt-1">
                <div class="font-black text-slate-800 dark:text-white text-sm sm:text-base">
                  50 × 70 MM
                </div>
                <div class="text-[11px] font-semibold text-slate-600 dark:text-slate-400">
                  5 CM × 7 CM
                </div>
              </div>
              <div class="border-t border-slate-200 dark:border-slate-800 pt-1.5 text-[11px] text-slate-500 font-medium">
                Canada
              </div>
            </div>

            <!-- Preset 4: Custom -->
            <div
              data-preset="custom"
              role="button"
              tabindex="0"
              aria-pressed="false"
              class="passport-size-card relative cursor-pointer rounded-xl border-2 border-slate-200 dark:border-slate-800 hover:border-blue-400 bg-white dark:bg-slate-900 p-2.5 text-center transition-all hover:shadow-xs flex flex-col justify-between min-h-26.25 focus:outline-hidden focus:ring-2 focus:ring-blue-500"
            >
              <div class="selected-badge hidden absolute -top-2.5 left-2.5 bg-blue-700 text-white text-[10px] font-black px-2 py-0.2 rounded-full shadow-xs">
                ✓ Selected
              </div>
              <!-- Unit Selector Radios -->
              <div class="flex items-center justify-center gap-1 text-[10px] font-bold text-slate-700 dark:text-slate-300">
                <label class="flex items-center gap-0.5 cursor-pointer">
                  <input type="radio" name="custom-unit" value="cm" checked class="text-blue-600" /> CM
                </label>
                <label class="flex items-center gap-0.5 cursor-pointer">
                  <input type="radio" name="custom-unit" value="mm" class="text-blue-600" /> MM
                </label>
                <label class="flex items-center gap-0.5 cursor-pointer">
                  <input type="radio" name="custom-unit" value="inch" class="text-blue-600" /> In
                </label>
                <label class="flex items-center gap-0.5 cursor-pointer">
                  <input type="radio" name="custom-unit" value="px" class="text-blue-600" /> PX
                </label>
              </div>

              <!-- Input Dimensions -->
              <div class="flex items-center justify-center gap-1.5 my-1">
                <label for="custom-size-w" class="sr-only">Width</label>
                <input
                  type="number"
                  id="custom-size-w"
                  aria-label="Custom Width"
                  value="3.5"
                  step="0.1"
                  min="0.1"
                  class="w-13 px-1 py-0.5 text-center font-bold text-xs border border-slate-300 dark:border-slate-700 rounded bg-slate-50 dark:bg-slate-800"
                />
                <span class="font-bold text-slate-400 text-xs">×</span>
                <label for="custom-size-h" class="sr-only">Height</label>
                <input
                  type="number"
                  id="custom-size-h"
                  aria-label="Custom Height"
                  value="4.5"
                  step="0.1"
                  min="0.1"
                  class="w-13 px-1 py-0.5 text-center font-bold text-xs border border-slate-300 dark:border-slate-700 rounded bg-slate-50 dark:bg-slate-800"
                />
              </div>

              <div class="border-t border-slate-200 dark:border-slate-800 pt-1 text-[11px] font-black text-slate-600 dark:text-slate-300">
                Custom Size
              </div>
            </div>
          </div>

          <!-- Next Button -->
          <div class="flex justify-center pt-2">
            <button
              type="button"
              id="btn-size-next"
              class="inline-flex items-center gap-1.5 px-6 py-2 rounded-xl font-bold text-xs sm:text-sm text-blue-700 bg-white border-2 border-blue-600 hover:bg-blue-50 transition shadow-xs cursor-pointer"
            >
              <span>Next (Crop Face)</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- ================= STEP 2: CROP FACE (LIVE PHOTO CROP BOX) ================= -->
        <div id="panel-step-crop" role="tabpanel" aria-labelledby="tab-step-crop" class="wizard-panel hidden space-y-2">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-1.5">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-100">
                2. Crop Face
              </h3>
              <p class="text-[11px] text-slate-500">
                Click & drag on image to create a new crop or drag the 8 blue handles.
              </p>
            </div>

            <!-- Quick Photo Adjustment Toolbar & Controls -->
            <div class="flex items-center gap-1 bg-slate-50 dark:bg-slate-800/80 p-1 rounded-xl border border-slate-200 dark:border-slate-700">
              <button
                type="button"
                id="btn-crop-zoom-in"
                title="Zoom In"
                aria-label="Zoom in"
                class="p-1 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 transition cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
                </svg>
              </button>
              <button
                type="button"
                id="btn-crop-zoom-out"
                title="Zoom Out"
                aria-label="Zoom out"
                class="p-1 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 transition cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/>
                </svg>
              </button>
              <div class="h-4 w-px bg-slate-300 dark:bg-slate-700 mx-0.5"></div>
              <button
                type="button"
                id="btn-crop-brightness"
                title="Brightness"
                aria-label="Adjust brightness"
                class="p-1 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 transition cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
              </button>
              <button
                type="button"
                id="btn-crop-contrast"
                title="Contrast"
                aria-label="Adjust contrast"
                class="p-1 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 transition cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="9" stroke-width="2"/>
                  <path stroke-width="2" d="M12 3v18A9 9 0 0012 3z"/>
                </svg>
              </button>
              <button
                type="button"
                id="btn-crop-saturation"
                title="Saturation"
                aria-label="Adjust saturation"
                class="p-1 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-white dark:hover:bg-slate-700 transition cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                </svg>
              </button>
              <button
                type="button"
                id="btn-crop-lock-ratio"
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[11px] font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 border border-amber-300 dark:border-amber-800 hover:bg-amber-100 cursor-pointer"
              >
                <span id="crop-ratio-icon">🔓</span>
                <span id="crop-ratio-text">Freeform Crop</span>
              </button>
              <button
                type="button"
                id="btn-crop-reset"
                class="p-1 text-[11px] font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 cursor-pointer"
