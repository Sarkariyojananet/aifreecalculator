---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

// FAQ Schema for Search Engines
const faqs = [
  {
    question: "What is a word counter?",
    answer: "A word counter is a digital writing utility that analyzes entered text to calculate the exact number of words, characters, sentences, paragraphs, and reading duration in real time."
  },
  {
    question: "How does an online word counter work?",
    answer: "Our online word counter processes your text instantly within your browser using Unicode-aware text segmentation algorithms. As you type or paste content, it identifies word boundaries, sentence terminators, and paragraph line breaks without sending data to any external server."
  },
  {
    question: "Is this word counter free?",
    answer: "Yes, this word counter is 100% free to use with no account registration, trial limits, or hidden fees required."
  },
  {
    question: "How are words counted?",
    answer: "Words are counted based on standard linguistic word boundaries, separating sequences of letters, numbers, and symbols. The tool intelligently handles multiple consecutive spaces, tabs, line breaks, and hyphenated compound words without inflating counts."
  },
  {
    question: "Does the word counter count characters?",
    answer: "Yes. The tool simultaneously calculates total characters including spaces as well as characters excluding spaces."
  },
  {
    question: "Can I count characters without spaces?",
    answer: "Yes. The 'Characters (No Spaces)' metric strips out all whitespace characters (spaces, tabs, newlines) and counts only visible letters, digits, and punctuation marks, which is ideal for platforms with strict non-whitespace restrictions."
  },
  {
    question: "Does it count sentences and paragraphs?",
    answer: "Yes. Sentences are detected using standard sentence-ending punctuation (. ! ?), while paragraphs are calculated based on non-empty text blocks separated by line breaks."
  },
  {
    question: "How is reading time calculated?",
    answer: "Reading time is estimated using an average adult silent reading benchmark of approximately 200 to 250 words per minute (WPM). The result is clearly marked as an estimate since reading speed varies by subject matter and complexity."
  },
  {
    question: "How is speaking time calculated?",
    answer: "Speaking time is estimated based on an average presentation speaking pace of approximately 130 words per minute, helping public speakers and scriptwriters time their talks."
  },
  {
    question: "Can I use this tool for essays and assignments?",
    answer: "Absolutely. Students, researchers, and copywriters frequently use this tool to verify length requirements for college applications, academic essays, research abstracts, and journal submissions."
  },
  {
    question: "Is my text uploaded to a server?",
    answer: "No. All text parsing and counting happens 100% locally on your computer or mobile device. None of your writing is ever transmitted, logged, or stored on our servers."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  title="Word Counter - Free Online Word Counter Tool"
  description="Count words, characters, sentences, paragraphs, and reading time in real time with our free online word counter tool. 100% private and client-side."
  category="Free Online Tools"
  calculatorName="Word Counter"
  slug="word-counter"
  keywords={[
    'word counter',
    'word counter online',
    'online word counter',
    'word counter free',
    'word counter tool',
    'character count',
    'reading time calculator',
    'count words'
  ]}
>
  <!-- Injected FAQPage Schema for Search Engines -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- MAIN INTERACTIVE WORD COUNTER TOOL WIDGET (Default Slot) -->
  <div class="space-y-6">

    <!-- Header & SEO Introduction -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>Real-Time Writing Statistics • 100% Free & Private</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Word Counter
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Use our <strong>free online word counter tool</strong> to instantly analyze your writing. Count words, characters with and without spaces, sentences, paragraphs, and estimate reading and speaking time in real time. Perfect for essays, articles, blog posts, assignments, and social media.
      </p>

      <!-- Local Processing Privacy Guarantee Banner -->
      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left shadow-xs">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Client-Side Privacy:</strong> Your text is processed locally in your browser and is not uploaded to our server.</span>
      </div>
    </div>

    <!-- PRIMARY STATISTICS GRID -->
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5 sm:gap-3">
      
      <!-- Card 1: Words (Prominent) -->
      <div class="col-span-2 sm:col-span-2 lg:col-span-2 p-4 rounded-2xl border-2 border-blue-500/40 bg-linear-to-br from-blue-50/70 via-white to-blue-50/30 dark:from-blue-950/40 dark:via-slate-900 dark:to-blue-950/20 shadow-xs flex flex-col justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Words</span>
        <div class="my-1">
          <span id="wcWords" class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono">0</span>
        </div>
        <span class="text-[11px] text-slate-500 dark:text-slate-400">Total word count</span>
      </div>

      <!-- Card 2: Characters (with spaces) -->
      <div class="p-3 sm:p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs flex flex-col justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Characters</span>
        <div class="my-1">
          <span id="wcChars" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-mono">0</span>
        </div>
        <span class="text-[10px] text-slate-400">With spaces</span>
      </div>

      <!-- Card 3: Characters (no spaces) -->
      <div class="p-3 sm:p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs flex flex-col justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">No Spaces</span>
        <div class="my-1">
          <span id="wcCharsNoSpaces" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-mono">0</span>
        </div>
        <span class="text-[10px] text-slate-400">Excluding spaces</span>
      </div>

      <!-- Card 4: Sentences -->
      <div class="p-3 sm:p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs flex flex-col justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Sentences</span>
        <div class="my-1">
          <span id="wcSentences" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-mono">0</span>
        </div>
        <span class="text-[10px] text-slate-400">Estimated</span>
      </div>

      <!-- Card 5: Paragraphs -->
      <div class="p-3 sm:p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs flex flex-col justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Paragraphs</span>
        <div class="my-1">
          <span id="wcParagraphs" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-mono">0</span>
        </div>
        <span class="text-[10px] text-slate-400">Blocks of text</span>
      </div>

      <!-- Card 6: Reading Time -->
      <div class="p-3 sm:p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs flex flex-col justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Reading</span>
        <div class="my-1">
          <span id="wcReadingTime" class="text-xl sm:text-2xl font-bold text-emerald-700 dark:text-emerald-400 font-mono">0 min</span>
        </div>
        <span class="text-[10px] text-slate-400">~225 wpm</span>
      </div>

    </div>

    <!-- MAIN TEXTAREA & CONTROLS CONTAINER -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
      
      <!-- Toolbar Header -->
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-800 p-3 bg-slate-50 dark:bg-slate-950/40">
        
        <!-- Left: Case transform convenience tools -->
        <div class="flex items-center gap-1.5 overflow-x-auto text-xs">
          <span class="text-slate-400 font-semibold text-[11px] mr-1 hidden sm:inline">Case:</span>
          <button
            type="button"
            id="wcSentenceCaseBtn"
            class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer"
            title="Convert to Sentence case"
          >
            Sentence case
          </button>
          <button
            type="button"
            id="wcTitleCaseBtn"
            class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer"
            title="Convert to Title Case"
          >
            Title Case
          </button>
          <button
            type="button"
            id="wcUpperCaseBtn"
            class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer"
            title="Convert to UPPERCASE"
          >
            UPPER
          </button>
          <button
            type="button"
            id="wcLowerCaseBtn"
            class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition cursor-pointer"
            title="Convert to lowercase"
          >
            lower
          </button>
        </div>

        <!-- Right: Primary Actions (Copy, Clear) -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="wcCopyBtn"
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            Copy Text
          </button>

          <button
            type="button"
            id="wcClearBtn"
            class="flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition cursor-pointer"
          >
            Clear
          </button>
        </div>

      </div>

      <!-- Large Writing Textarea -->
      <div class="relative p-2 sm:p-4">
        <label for="wcTextInput" class="sr-only">Type or paste text to count words</label>
        <textarea
          id="wcTextInput"
          rows="12"
          placeholder="Type or paste your text here..."
          class="w-full p-3 sm:p-4 text-sm sm:text-base leading-relaxed bg-transparent border-0 text-slate-900 dark:text-white placeholder:text-slate-400 focus:ring-0 focus:outline-none resize-y min-h-60"
        ></textarea>

        <!-- Toast Feedback -->
        <div id="wcCopyToast" class="absolute bottom-6 right-6 transition-all duration-300 transform opacity-0 translate-y-2 pointer-events-none text-xs font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-800 px-3.5 py-1.5 rounded-xl shadow-md z-10">
          Copied to clipboard!
        </div>
      </div>

      <!-- Primary Action Buttons Row (Count Words, Sample Text) -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 dark:border-slate-800 p-3 sm:p-4 bg-slate-50/80 dark:bg-slate-950/60">
        
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Primary Count Button -->
          <button
            type="button"
            id="wcCountBtn"
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white shadow-md shadow-blue-600/25 hover:shadow-lg hover:shadow-blue-600/35 active:scale-95 transition-all duration-150 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span>Count Words</span>
          </button>

          <!-- Sample Text Loader -->
          <button
            type="button"
            id="wcSampleBtn"
            class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 shadow-2xs transition cursor-pointer"
            title="Load sample paragraph to test"
          >
            <span>📝 Sample Text</span>
          </button>
        </div>

        <div class="flex items-center gap-2">
          <!-- Live Status Badge -->
          <span id="wcStatusBadge" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="wcStatusText">Ready • Type or Paste Text</span>
          </span>
        </div>

      </div>

      <!-- Footer Bar with Speaking Time & Status -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 dark:border-slate-800 px-4 py-3 bg-slate-50 dark:bg-slate-950/40 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-4">
          <span>🗣️ Speaking Time: <strong id="wcSpeakingTime" class="text-slate-800 dark:text-slate-200">0 min</strong></span>
          <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
          <span class="hidden sm:inline">Supports English, Hindi & Unicode</span>
        </div>
        <span class="text-[11px] text-slate-400">Live automatic count</span>
      </div>

    </div>

    <!-- KEYWORD / TOP WORDS FREQUENCY CARD -->
    <div id="wcTopWordsContainer" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 flex items-center gap-2">
          <span>📊</span> Top Words Frequency (Excluding Common Stop Words)
        </h3>
        <span class="text-[11px] text-slate-400">Word Density</span>
      </div>
      <div id="wcTopWordsList" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
        <!-- Injected dynamically by word-counter.js -->
      </div>
    </div>

    <!-- SCRIPT LOADER -->
    <script is:inline src="/js/tools/word-counter.js"></script>
  </div>

  <!-- ================= RICH TAILWIND SEO CONTENT SLOT ================= -->
  <!-- Rendered below Found an issue? and AdSlotInline -->
  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300 not-prose">

      <!-- SECTION 1: OVERVIEW -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Word Counter Online: Accurate Writing Metrics at Your Fingertips
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Whether you are drafting a university thesis, polishing an article, or preparing a speech, our <strong>word counter online</strong> gives you instant clarity over your document's length and rhythm. By simply typing or pasting your draft into the writing area, you receive real-time updates of words, characters, sentences, paragraphs, reading time, and speaking duration.
        </p>
        <p class="leading-relaxed">
          Unlike desktop word processors that bury character counts behind menu tabs, this <strong>online word counter</strong> updates continuously as you type. It recognizes international Unicode characters, ensuring smooth operation across languages including English, Hindi, Spanish, and European scripts.
        </p>

        <!-- Feature Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-sm">
              ⚡
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Real-Time Analysis</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Every keystroke and pasted sentence recalculates counts instantly without refreshing the page or interrupting your focus.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">
              🔒
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Complete Privacy</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              All text analysis executes 100% inside your browser. No drafts, essays, or confidential memos are ever uploaded to any server.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-sm">
              ⏱️
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Reading & Speech Pacing</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Plan keynote presentations and script recordings with automated estimates for both silent reading and spoken delivery.
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION 2: FREE WORD COUNTER TOOL -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Free Word Counter Tool: Designed for Writers, Students, and Marketers
        </h2>
        <p class="leading-relaxed">
          Our <strong>word counter free</strong> utility provides a clean, distraction-free environment without annoying popups or subscription paywalls. As a modern <strong>word counter tool</strong>, it is engineered for high performance: whether you paste a 100-word product description or an entire 50,000-word book manuscript, the counter runs smoothly in local memory.
        </p>
        <p class="leading-relaxed">
          The built-in case formatting tools let you quickly convert pasted text into sentence case, title case, uppercase, or lowercase with a single click, saving you time during editorial review.
        </p>
      </section>

      <!-- SECTION 3: WHAT DOES A WORD COUNTER COUNT? -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          What Does a Word Counter Count?
        </h2>
        <p class="leading-relaxed">
          Effective writing requires understanding multiple dimensions of text volume. This tool computes comprehensive metrics simultaneously:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 pt-1">
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Words</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Identifies discrete linguistic word units separated by whitespace and punctuation, preventing spaces or tabs from being tallied as words.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Characters (With Spaces)</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Every letter, number, space, and punctuation mark in the document. Essential for platforms that measure overall byte or character limits.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Characters (Excluding Spaces)</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Measures only printable letters, numbers, and symbols. Standard for international academic submissions and translation invoicing.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Sentences</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Estimates sentence count using terminal punctuation marks (periods, exclamation marks, and question marks) while ignoring common decimal points.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Paragraphs</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Counts distinct blocks of text separated by line breaks. Empty blank lines are automatically excluded from the count.
