---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

// FAQ Schema for Search Engines
const faqs = [
  {
    question: "How do I convert JPG to PNG?",
    answer: "Simply drag and drop or select your JPG or JPEG image in our online converter. The browser immediately converts the image to PNG format, allowing you to preview the result and click 'Download PNG'."
  },
  {
    question: "What is a JPG to PNG converter?",
    answer: "A JPG to PNG converter is a software utility that decodes the compressed pixel data of a JPEG file and re-encodes it into the lossless Portable Network Graphics (PNG) format."
  },
  {
    question: "Can I convert JPG to PNG online for free?",
    answer: "Yes, our JPG to PNG converter is completely free with no usage caps, registration, or watermarks."
  },
  {
    question: "Does converting JPG to PNG improve quality?",
    answer: "No. Converting a JPG to PNG cannot restore detail or colors already discarded by lossy JPEG compression. However, saving the image as a PNG prevents any additional loss in quality during future edits and resaves."
  },
  {
    question: "Is PNG better than JPG?",
    answer: "PNG is better for digital illustrations, logos, icons, diagrams, and graphics requiring transparent backgrounds. JPG is generally better for photographic images where smaller file sizes are needed."
  },
  {
    question: "Can I convert multiple JPG images to PNG?",
    answer: "Yes. You can select or drop multiple JPG images at once. The converter processes all images in your browser and provides individual download links as well as a 'Download All PNGs' option."
  },
  {
    question: "Will the PNG file be smaller than the JPG?",
    answer: "In most cases, the resulting PNG will be larger than the original JPG. PNG uses lossless Deflate compression, which stores exact pixel data without the aggressive quantization used by JPEG."
  },
  {
    question: "Are my JPG images uploaded to a server?",
    answer: "No. All conversion is executed 100% locally inside your browser using HTML5 Canvas APIs. Your photos never leave your device."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  title="JPG to PNG Converter - Convert JPG to PNG Online Free"
  description="Convert JPG to PNG online for free. Transform JPEG photos into high-quality PNG format directly in your browser with no uploads, watermarks, or file limits."
  category="Free Online Tools"
  calculatorName="JPG to PNG"
  slug="jpg-to-png"
  keywords={[
    'jpg to png',
    'convert jpg to png',
    'jpg to png converter',
    'how to convert jpg to png',
    'convert jpg to png online',
    'jpeg to png',
    'image converter'
  ]}
>
  <!-- Injected FAQPage Schema for Search Engines -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- MAIN INTERACTIVE JPG TO PNG CONVERTER TOOL WIDGET -->
  <div class="space-y-6">

    <!-- Privacy & Security Guarantee Banner -->
    <div class="flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-950/30 dark:text-emerald-300">
      <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold">
        🛡️
      </div>
      <div>
        <span class="font-bold">100% Client-Side Privacy:</span>
        Your images are processed locally in your browser and are not uploaded to our server. Photos remain confidential on your device.
      </div>
    </div>

    <!-- Alert / Error Notification Box -->
    <div id="j2p-alert-box" class="hidden rounded-2xl border p-4 text-xs transition-all" role="alert">
      <div class="flex items-start gap-2.5">
        <span class="text-base shrink-0">⚠️</span>
        <div id="j2p-alert-text" class="flex-1 font-medium leading-relaxed"></div>
      </div>
    </div>

    <!-- SECTION 1: UPLOAD DROP ZONE (Visible when no images loaded) -->
    <section id="j2p-upload-section" class="transition-all">
      <div
        id="j2p-drop-zone"
        tabindex="0"
        role="button"
        aria-label="Upload JPG files: Click or drag and drop JPG images to convert to PNG"
        class="group relative flex flex-col items-center justify-center rounded-3xl border-2 border-dashed border-slate-300 bg-slate-50/50 p-8 text-center transition-all duration-200 hover:border-blue-500 hover:bg-blue-50/40 focus:border-blue-500 focus:outline-hidden focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900/40 dark:hover:border-blue-500 dark:hover:bg-blue-950/20 sm:p-12 cursor-pointer"
      >
        <input
          type="file"
          id="j2p-file-input"
          accept=".jpg,.jpeg,image/jpeg"
          multiple
          class="sr-only"
          aria-hidden="true"
        />

        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100/80 text-3xl text-blue-600 transition group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white dark:bg-blue-950/60 dark:text-blue-400 dark:group-hover:bg-blue-600 dark:group-hover:text-white">
          🖼️
        </div>

        <h2 class="mt-4 text-lg font-bold text-slate-900 dark:text-white sm:text-xl">
          Choose JPG / JPEG image or drag & drop here
        </h2>

        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 sm:text-sm max-w-md">
          Supports single or multiple <strong>.jpg and .jpeg</strong> files. Instant client-side conversion to high-quality PNG.
        </p>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
          <button
            type="button"
            id="j2p-select-file-btn"
            class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-xs transition hover:bg-blue-700 focus:ring-2 focus:ring-blue-500/30 cursor-pointer sm:text-sm"
          >
            <span>📁 Select JPG Image(s)</span>
          </button>
          <span class="text-xs text-slate-400 dark:text-slate-500">or paste from clipboard (Ctrl+V)</span>
        </div>

        <div class="mt-6 flex items-center gap-4 text-[11px] font-semibold text-slate-400 dark:text-slate-500">
          <span class="flex items-center gap-1">✓ Supports .JPG / .JPEG</span>
          <span>•</span>
          <span class="flex items-center gap-1">✓ Multiple Files Supported</span>
          <span>•</span>
          <span class="flex items-center gap-1">✓ Up to 50 MB Each</span>
        </div>
      </div>
    </section>

    <!-- SECTION 2: WORKSPACE (SINGLE IMAGE CONVERSION RESULT) -->
    <section id="j2p-workspace-single" class="hidden space-y-6">

      <!-- Success Notification Bar -->
      <div class="flex items-center justify-between gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-950/30 dark:text-emerald-300">
        <div class="flex items-center gap-2">
          <span class="text-base">✅</span>
          <span class="font-bold">Conversion Complete:</span>
          <span>Your JPG has been converted into a true PNG image.</span>
        </div>
        <span class="font-mono font-bold text-[11px] rounded-lg bg-emerald-200/70 px-2 py-0.5 text-emerald-900 dark:bg-emerald-900/60 dark:text-emerald-200">PNG Format</span>
      </div>

      <!-- File Details Comparison Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        
        <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Original JPG</div>
          <div id="j2p-stat-orig-name" class="mt-1 truncate font-bold text-xs text-slate-800 dark:text-slate-200">-</div>
          <div class="mt-0.5 text-[11px] font-mono text-slate-500">
            <span id="j2p-stat-orig-size">-</span> • <span id="j2p-stat-orig-dim">-</span>
          </div>
        </div>

        <div class="rounded-2xl border border-blue-200 bg-blue-50/40 p-3.5 shadow-2xs dark:border-blue-900/40 dark:bg-blue-950/20">
          <div class="text-[10px] font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Converted PNG</div>
          <div id="j2p-stat-png-name" class="mt-1 truncate font-bold text-xs text-blue-900 dark:text-blue-200">-</div>
          <div class="mt-0.5 text-[11px] font-mono text-blue-700 dark:text-blue-300">
            <span id="j2p-stat-png-size">-</span> • <span id="j2p-stat-png-dim">-</span>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">File Weight Impact</div>
          <div id="j2p-stat-size-diff" class="mt-1 font-mono text-xs font-bold text-slate-800 dark:text-slate-200 sm:text-sm">-</div>
        </div>

      </div>

      <!-- Side-by-Side Responsive Previews -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        
        <!-- Original JPG Card -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/70 px-4 py-2.5 text-xs dark:border-slate-800 dark:bg-slate-800/40">
            <span class="font-bold text-slate-700 dark:text-slate-200">Original JPG</span>
            <span id="j2p-badge-orig" class="rounded-md bg-slate-200/70 px-2 py-0.5 font-mono text-[10px] text-slate-700 dark:bg-slate-700 dark:text-slate-300">-</span>
          </div>
          <div class="flex min-h-55 max-h-95 items-center justify-center p-3 bg-slate-100/50 dark:bg-slate-950/50">
            <img
              id="j2p-preview-orig"
              alt="Original JPG image preview"
              class="max-h-87.5 max-w-full rounded-lg object-contain shadow-2xs"
            />
          </div>
        </div>

        <!-- Converted PNG Card -->
        <div class="overflow-hidden rounded-2xl border border-blue-200 bg-white dark:border-blue-900/60 dark:bg-slate-900">
          <div class="flex items-center justify-between border-b border-blue-100 bg-blue-50/70 px-4 py-2.5 text-xs dark:border-blue-950/50 dark:bg-blue-950/30">
            <span class="font-bold text-blue-900 dark:text-blue-200">Converted PNG</span>
            <span id="j2p-badge-png" class="rounded-md bg-blue-200/70 px-2 py-0.5 font-mono text-[10px] font-bold text-blue-800 dark:bg-blue-900/60 dark:text-blue-300">-</span>
          </div>
          <div class="flex min-h-55 max-h-95 items-center justify-center p-3 bg-slate-100/50 dark:bg-slate-950/50">
            <img
              id="j2p-preview-png"
              alt="Converted PNG image preview"
              class="max-h-87.5 max-w-full rounded-lg object-contain shadow-2xs"
            />
          </div>
        </div>

      </div>

      <!-- Action Buttons Bar -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
        <button
          type="button"
          id="j2p-reset-single"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-2xs hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
        >
          <span>🔄 Convert Another JPG</span>
        </button>

        <button
          type="button"
          id="j2p-download-single"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-linear-to-r from-blue-600 to-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-md hover:from-blue-700 hover:to-indigo-700 focus:ring-4 focus:ring-blue-500/20 transition transform active:scale-98 cursor-pointer"
        >
          <span>📥 Download PNG</span>
        </button>
      </div>

    </section>

    <!-- SECTION 3: WORKSPACE (BATCH / MULTIPLE IMAGES CONVERSION RESULT) -->
    <section id="j2p-workspace-batch" class="hidden space-y-6">
      
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-blue-200 bg-blue-50/70 p-4 text-xs dark:border-blue-900/50 dark:bg-blue-950/30">
        <div class="flex items-center gap-2">
          <span class="text-base">🎉</span>
          <span id="j2p-batch-count" class="font-bold text-blue-900 dark:text-blue-200">Batch Converted Successfully</span>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="j2p-batch-reset"
            class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
          >
            Convert More
          </button>
          <button
            type="button"
            id="j2p-batch-download-all"
            class="rounded-xl bg-blue-600 px-4 py-1.5 font-bold text-white shadow-xs hover:bg-blue-700 transition cursor-pointer"
          >
            📥 Download All PNGs
          </button>
        </div>
      </div>

      <!-- Batch Converted Items List -->
      <div id="j2p-batch-list" class="space-y-3">
        <!-- Rendered dynamically by script -->
      </div>

    </section>

    <!-- LOADING SPINNER OVERLAY -->
    <div
      id="j2p-loading-overlay"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 backdrop-blur-xs"
      aria-live="polite"
    >
      <div class="flex flex-col items-center rounded-2xl bg-white p-6 shadow-xl dark:bg-slate-800 text-center max-w-xs mx-4">
        <div class="h-10 w-10 animate-spin rounded-full border-4 border-blue-600 border-t-transparent"></div>
        <div class="mt-3 font-bold text-slate-900 dark:text-white text-sm">Converting to PNG</div>
        <div id="j2p-loading-text" class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Encoding lossless PNG in browser...
        </div>
      </div>
    </div>

  </div>

  <!-- SEO EDUCATIONAL CONTENT (Richly styled with modern CSS cards and typography) -->
  <Fragment slot="content">
    <div class="space-y-12 not-prose">
      
      <!-- Section 1: Intro Banner -->
      <section class="space-y-6">
        <div class="rounded-3xl border border-blue-100 bg-linear-to-br from-blue-50/80 via-white to-slate-50 p-6 shadow-xs dark:border-blue-950/60 dark:from-slate-900 dark:via-slate-900/80 dark:to-blue-950/20 sm:p-8">
          <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-100/60 px-3 py-1 text-xs font-bold text-blue-700 dark:border-blue-900/50 dark:bg-blue-950/70 dark:text-blue-300">
            <span class="h-2 w-2 rounded-full bg-blue-600 animate-pulse"></span>
            Lossless Client-Side Conversion
          </div>

          <h2 class="mt-4 text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            JPG to PNG Converter
          </h2>

          <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-4xl">
            Welcome to our free <strong>JPG to PNG converter</strong> designed to transform photographic JPEG images into the lossless Portable Network Graphics (PNG) format. Because the conversion engine runs completely inside your browser using HTML5 Canvas APIs, your images are converted instantaneously without uploading a single byte to external servers.
          </p>

          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="flex items-center gap-3 rounded-2xl border border-slate-200/80 bg-white/80 p-3 shadow-2xs backdrop-blur-xs dark:border-slate-800 dark:bg-slate-800/60">
              <span class="text-xl">✨</span>
              <div>
                <div class="text-xs font-bold text-slate-900 dark:text-white">Genuine PNG Encoding</div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400">Not just a renamed extension</div>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-2xl border border-slate-200/80 bg-white/80 p-3 shadow-2xs backdrop-blur-xs dark:border-slate-800 dark:bg-slate-800/60">
              <span class="text-xl">📁</span>
              <div>
                <div class="text-xs font-bold text-slate-900 dark:text-white">Batch Multi-Upload</div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400">Convert multiple JPGs at once</div>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-2xl border border-slate-200/80 bg-white/80 p-3 shadow-2xs backdrop-blur-xs dark:border-slate-800 dark:bg-slate-800/60">
              <span class="text-xl">🔒</span>
              <div>
                <div class="text-xs font-bold text-slate-900 dark:text-white">100% Client-Side</div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400">Photos stay on your device</div>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-2xl border border-slate-200/80 bg-white/80 p-3 shadow-2xs backdrop-blur-xs dark:border-slate-800 dark:bg-slate-800/60">
              <span class="text-xl">💎</span>
              <div>
                <div class="text-xs font-bold text-slate-900 dark:text-white">Completely Free</div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400">No account or watermark</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: How to Convert JPG to PNG -->
      <section class="space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Step-by-Step Tutorial</span>
          <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">
            How to Convert JPG to PNG
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 max-w-3xl">
            Converting your images takes only a few clicks:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-blue-100 font-mono text-xs font-black text-blue-700 dark:bg-blue-950 dark:text-blue-300">1</div>
            <h3 class="mt-3 text-sm font-bold text-slate-900 dark:text-white">Select or Drag JPG</h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Click the upload box to choose your image from your phone or computer, drop a file directly, or paste with <kbd class="rounded border border-slate-300 bg-slate-100 px-1 py-0.5 text-[10px] font-mono dark:border-slate-700 dark:bg-slate-800">Ctrl+V</kbd>.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-blue-100 font-mono text-xs font-black text-blue-700 dark:bg-blue-950 dark:text-blue-300">2</div>
            <h3 class="mt-3 text-sm font-bold text-slate-900 dark:text-white">Browser Converts</h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Our tool decodes the JPEG pixels and re-encodes them into a clean PNG container in real time.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-blue-100 font-mono text-xs font-black text-blue-700 dark:bg-blue-950 dark:text-blue-300">3</div>
            <h3 class="mt-3 text-sm font-bold text-slate-900 dark:text-white">Preview & Verify</h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Inspect the side-by-side preview, verify resolution, and compare the original and converted file weights.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-100 font-mono text-xs font-black text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">4</div>
            <h3 class="mt-3 text-sm font-bold text-slate-900 dark:text-white">Download PNG</h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Hit <strong>Download PNG</strong> to save your picture with the updated <code>.png</code> extension.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Convert JPG to PNG Online -->
      <section class="space-y-4">
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
          Convert JPG to PNG Online
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Installing dedicated desktop graphics packages like Photoshop or GIMP just to change an image format can be cumbersome and time-consuming. When you <strong>convert jpg to png online</strong> with our browser utility, you get the same pixel-level fidelity without downloading software, registering an account, or waiting in cloud server queues.
        </p>
      </section>

      <!-- Section 4: JPG vs PNG Comparison -->
      <section class="space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Format Comparison</span>
          <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">
            JPG vs PNG
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 max-w-3xl">
            Both JPG and PNG are fundamental pillars of modern web imagery, but they were engineered for fundamentally different purposes:
          </p>
        </div>

        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="border-b border-slate-200 bg-slate-50/70 text-slate-700 dark:border-slate-800 dark:bg-slate-800/40 dark:text-slate-300">
                <tr>
                  <th class="p-4 font-bold">Property</th>
                  <th class="p-4 font-bold text-amber-700 dark:text-amber-400">JPG / JPEG</th>
                  <th class="p-4 font-bold text-blue-600 dark:text-blue-400">PNG</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-600 dark:divide-slate-800 dark:text-slate-300">
                <tr>
                  <td class="p-4 font-semibold text-slate-900 dark:text-white">Compression Method</td>
                  <td class="p-4">Lossy (DCT frequency discard)</td>
                  <td class="p-4 font-medium text-blue-600 dark:text-blue-400">Lossless (Deflate / LZ77)</td>
                </tr>
                <tr>
                  <td class="p-4 font-semibold text-slate-900 dark:text-white">Transparency Channel</td>
                  <td class="p-4 text-red-600 dark:text-red-400 font-medium">No (opaque backgrounds only)</td>
                  <td class="p-4 font-bold text-emerald-600 dark:text-emerald-400">Yes (Full 8-bit Alpha Channel)</td>
                </tr>
                <tr>
                  <td class="p-4 font-semibold text-slate-900 dark:text-white">Best Suited For</td>
