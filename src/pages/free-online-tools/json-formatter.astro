---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

// FAQ Schema for Search Engines
const faqs = [
  {
    question: "What is a JSON formatter?",
    answer: "A JSON formatter is an online developer tool that parses raw, unformatted, or minified JavaScript Object Notation (JSON) data and restructures it with consistent indentation and line breaks, making complex nested objects and arrays easily readable."
  },
  {
    question: "How do I format JSON online?",
    answer: "Simply paste your raw JSON string into the input editor, choose your preferred indentation (2 spaces, 4 spaces, or tabs), and click 'Format JSON'. Your beautified JSON appears instantly in the output panel ready to copy or download."
  },
  {
    question: "Is this online JSON formatter free?",
    answer: "Yes. Our JSON formatter is 100% free with no registration, subscription fees, or usage restrictions."
  },
  {
    question: "How do I validate JSON?",
    answer: "Paste your code into the input panel and click 'Validate JSON'. The tool inspects syntax for missing commas, unquoted keys, trailing commas, and unclosed brackets, pinpointing the approximate line and column of any syntax errors."
  },
  {
    question: "Can I minify JSON?",
    answer: "Yes. Clicking the 'Minify JSON' button removes all unnecessary whitespace, indentations, and newlines to compress your payload for production API calls and storage optimization."
  },
  {
    question: "Does formatting JSON change the data?",
    answer: "No. Valid formatting only alters whitespace and line breaks for human readability. Key names, numeric values, string contents, boolean flags, and nested object hierarchies remain completely untouched."
  },
  {
    question: "What is the difference between JSON formatting and minifying?",
    answer: "JSON formatting expands code with line breaks and indentation to improve human readability during development and debugging. JSON minification compresses code into a single continuous string without whitespace to minimize network transmission latency."
  },
  {
    question: "Can this tool convert XML to JSON?",
    answer: "Yes. Switch to the 'XML to JSON' tab, paste your XML document, and click 'Convert to JSON'. The tool parses the XML DOM tree and converts tags, nested children, attributes, and text into standard JSON format."
  },
  {
    question: "What is an XML to JSON formatter?",
    answer: "An XML to JSON formatter is a converter utility that translates Extensible Markup Language (XML) elements into equivalent JavaScript Object Notation key-value pairs and arrays directly within your browser."
  },
  {
    question: "Is my JSON uploaded to a server?",
    answer: "No. All parsing, formatting, validation, and XML conversions execute 100% locally on your device using native browser JavaScript APIs. Your confidential payloads, API keys, and configurations are never transmitted to our servers."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  title="JSON Formatter - Format & Validate JSON Online"
  description="Format, validate, and minify JSON online in your browser. Convert XML to JSON, inspect code statistics, and download clean JSON files with zero server tracking."
  category="Free Online Tools"
  calculatorName="JSON Formatter"
  slug="json-formatter"
  keywords={[
    'json formatter',
    'json formatter online',
    'online json formatter',
    'xml to json formatter',
    'format json online',
    'minify json',
    'validate json online',
    'beautify json'
  ]}
>
  <!-- Injected FAQPage Schema for Search Engines -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- MAIN INTERACTIVE JSON FORMATTER TOOL WIDGET (Default Slot) -->
  <div class="space-y-6">

    <!-- Header & SEO Introduction -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        <span>Format • Validate • Minify • XML to JSON</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        JSON Formatter
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Beautify, inspect, and validate your code instantly with our <strong>json formatter online</strong>. Indent nested objects, minify payloads, locate syntax errors, or use the built-in <strong>xml to json formatter</strong> to translate markup structures directly in your browser.
      </p>

      <!-- Local Processing Privacy Guarantee Banner -->
      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left shadow-xs">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Client-Side Privacy:</strong> Your JSON and XML are processed locally in your browser and are not uploaded to our server.</span>
      </div>
    </div>

    <!-- MAIN TOOL WORKSPACE CONTAINER -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
      
      <!-- MODE TABS & MASTER CONTROLS TOOLBAR -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 p-3 bg-slate-50 dark:bg-slate-950/60">
        
        <!-- Left: Mode Switcher Tabs -->
        <div class="flex items-center gap-1.5 p-1 bg-slate-200/70 dark:bg-slate-800 rounded-xl">
          <button
            id="jfJsonTabBtn"
            type="button"
            class="flex items-center gap-2 px-3.5 py-1.5 text-xs sm:text-sm font-semibold rounded-lg transition-all bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 shadow-xs cursor-pointer"
          >
            <span>&#123; &#125;</span>
            JSON Formatter
          </button>
          <button
            id="jfXmlTabBtn"
            type="button"
            class="flex items-center gap-2 px-3.5 py-1.5 text-xs sm:text-sm font-semibold rounded-lg transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer"
          >
            <span>&lt;/&gt;</span>
            XML to JSON
            <span class="px-1.5 py-0.2 text-[10px] font-bold bg-purple-100 text-purple-700 dark:bg-purple-900/60 dark:text-purple-300 rounded-md">Converter</span>
          </button>
        </div>

        <!-- Right: Formatting Options & Quick Utilities -->
        <div class="flex flex-wrap items-center gap-2">
          
          <!-- Indentation Selector -->
          <div class="flex items-center gap-1.5 text-xs">
            <label for="jfIndentSelect" class="text-slate-500 font-medium">Indent:</label>
            <select
              id="jfIndentSelect"
              class="px-2.5 py-1 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 font-semibold cursor-pointer"
            >
              <option value="2" selected>2 Spaces</option>
              <option value="4">4 Spaces</option>
              <option value="tab">Tabs</option>
            </select>
          </div>

          <button
            type="button"
            id="jfLoadExampleBtn"
            class="px-2.5 py-1 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
            title="Load realistic sample data"
          >
            Load Example
          </button>

          <button
            type="button"
            id="jfClearBtn"
            class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
          >
            Clear
          </button>
        </div>

      </div>

      <!-- TWO-PANEL CODE WORKSPACE (Left: Input, Right: Formatted Output) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        
        <!-- LEFT PANEL: INPUT CODE -->
        <div class="flex flex-col h-full bg-slate-50/40 dark:bg-slate-950/20">
          <div class="flex items-center justify-between px-4 py-2.5 border-b border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/60">
            <span id="jfInputPanelTitle" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Input JSON
            </span>
            <span id="jfInputFormatHint" class="text-[11px] text-slate-400">
              Paste raw, minified, or unformatted JSON
            </span>
          </div>

          <div class="p-2 sm:p-3 flex-1 flex flex-col">
            <label for="jfInput" class="sr-only">Input code area</label>
            <textarea
              id="jfInput"
              rows="16"
              placeholder="Paste your JSON here..."
              spellcheck="false"
              class="w-full flex-1 p-3 text-xs sm:text-sm font-mono leading-relaxed bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-white placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500 focus:outline-none resize-y min-h-75"
            ></textarea>
          </div>

          <!-- Primary Input Action Buttons -->
          <div class="flex flex-wrap items-center gap-2 p-3 border-t border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/60">
            <button
              type="button"
              id="jfFormatBtn"
              class="flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-600/20 transition cursor-pointer"
            >
              Format JSON
            </button>

            <button
              type="button"
              id="jfMinifyBtn"
              class="py-2 px-3 rounded-xl text-xs sm:text-sm font-bold bg-slate-800 hover:bg-slate-900 text-white dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-700 shadow-xs transition cursor-pointer"
              title="Compact into single line removing whitespace"
            >
              Minify JSON
            </button>

            <button
              type="button"
              id="jfValidateBtn"
              class="py-2 px-3 rounded-xl text-xs sm:text-sm font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
            >
              Validate
            </button>
          </div>
        </div>

        <!-- RIGHT PANEL: FORMATTED OUTPUT -->
        <div class="flex flex-col h-full bg-slate-50/40 dark:bg-slate-950/20">
          <div class="flex items-center justify-between px-4 py-2.5 border-b border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/60">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Formatted Result
            </span>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="jfCopyBtn"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-blue-50 text-blue-600 hover:bg-blue-100 dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-blue-900/60 transition cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                Copy
              </button>

              <button
                type="button"
                id="jfDownloadBtn"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
                title="Download formatted.json"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download .json
              </button>
            </div>
          </div>

          <div class="p-2 sm:p-3 flex-1 flex flex-col relative">
            <label for="jfOutput" class="sr-only">Formatted code output</label>
            <textarea
              id="jfOutput"
              rows="16"
              readonly
              placeholder="Formatted output will appear here..."
              spellcheck="false"
              class="w-full flex-1 p-3 text-xs sm:text-sm font-mono leading-relaxed bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-white placeholder:text-slate-400 focus:ring-0 focus:outline-none resize-y min-h-75"
            ></textarea>

            <!-- Toast feedback -->
            <div id="jfCopyToast" class="absolute bottom-6 right-6 transition-all duration-300 transform opacity-0 translate-y-2 pointer-events-none text-xs font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-800 px-3.5 py-1.5 rounded-xl shadow-md">
              Copied!
            </div>
          </div>

          <!-- Output Status & Error Bar -->
          <div class="flex items-center justify-between gap-2 p-3 border-t border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/60 overflow-hidden">
            <div class="flex items-center gap-2.5 min-w-0">
              <span id="jfStatusBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-300 dark:border-slate-700 shrink-0">
                <span class="w-2 h-2 rounded-full bg-slate-400"></span> Waiting for input
              </span>
              <span id="jfStatusMessage" class="text-xs text-slate-500 dark:text-slate-400 font-medium truncate">
                Paste JSON or click Format
              </span>
            </div>
          </div>
        </div>

      </div>

      <!-- BOTTOM METRICS & CODE STATS PANEL -->
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-slate-200 dark:divide-slate-800 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 text-center text-xs">
        <div class="p-2.5">
          <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Root Type</span>
          <span id="jfStatType" class="font-mono font-bold text-slate-800 dark:text-slate-200">—</span>
        </div>
        <div class="p-2.5">
          <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Characters</span>
          <span id="jfStatChars" class="font-mono font-bold text-slate-800 dark:text-slate-200">0</span>
        </div>
        <div class="p-2.5">
          <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Lines</span>
          <span id="jfStatLines" class="font-mono font-bold text-slate-800 dark:text-slate-200">0</span>
        </div>
        <div class="p-2.5">
          <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Approx Size</span>
          <span id="jfStatSize" class="font-mono font-bold text-slate-800 dark:text-slate-200">0 B</span>
        </div>
      </div>

    </div>

    <!-- SCRIPT LOADER -->
    <script is:inline src="/js/tools/json-formatter.js"></script>
  </div>

  <!-- ================= RICH TAILWIND SEO CONTENT SLOT ================= -->
  <!-- Rendered below Found an issue? and AdSlotInline as required -->
  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300 not-prose">

      <!-- SECTION 1: OVERVIEW -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          JSON Formatter Online: Clean, Validated, and Inspectable Data
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Working with minified web API payloads or nested database records can be challenging when data is compressed into a single unreadable line. Our <strong>json formatter online</strong> transforms dense JSON code into beautifully structured, indented, and human-readable trees in a single click.
        </p>
        <p class="leading-relaxed">
          Whether you are debugging REST API responses, inspecting configuration files, or converting markup with our <strong>xml to json formatter</strong>, this <strong>online json formatter</strong> runs completely client-side in your browser. Your sensitive API payloads, authorization tokens, and personal records remain private on your computer without ever touching a server.
        </p>

        <!-- Feature Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-sm">
              ✨
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Configurable Indentation</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Format your data with 2 spaces, 4 spaces, or tabs according to your project's coding conventions.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">
              🔍
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Precision Syntax Error Tracking</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Instantly locate missing commas, invalid quotes, trailing commas, or unclosed brackets with exact line and column numbers.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-sm">
              🔄
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Instant XML to JSON</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Seamlessly parse legacy XML feeds and export them into structured JSON objects and arrays right inside the same interface.
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION 2: WHAT IS A JSON FORMATTER -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          What Is a JSON Formatter?
        </h2>
        <p class="leading-relaxed">
          JavaScript Object Notation (JSON) is the universal data interchange format powering modern web APIs, mobile applications, and microservices. Because computers do not require whitespace to process data, servers frequently transmit JSON in minified form to reduce network bandwidth.
        </p>
        <p class="leading-relaxed">
          A JSON formatter parses valid serialized JSON text and formats it with clear structural line breaks, hierarchy-based spacing, and matching indentation. Crucially, formatting is a non-destructive visual transformation: the underlying string values, numbers, boolean flags, null values, and key-value associations remain 100% identical.
        </p>
      </section>

      <!-- SECTION 3: HOW TO FORMAT JSON -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          How to Format JSON
        </h2>
        <p class="leading-relaxed">
          Formatting complex JSON data takes only four simple steps:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 pt-1">
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">Step 1</span>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Paste JSON</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Paste your raw, minified, or unformatted text into the left input editor.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">Step 2</span>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Choose Indent</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Select 2 Spaces (default), 4 Spaces, or Tab indentation from the dropdown menu.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">Step 3</span>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Click Format</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Press <strong>Format JSON</strong> to validate syntax and render the beautified result.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
            <span class="text-xs font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">Step 4</span>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Copy or Download</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Click <strong>Copy</strong> to clipboard or <strong>Download .json</strong> to save the file locally.
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION 4: HOW TO VALIDATE JSON -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          How to Validate JSON
        </h2>
        <p class="leading-relaxed">
          The JSON specification (RFC 8259) is strictly enforced. Even a single syntax oversight will cause APIs and JSON parsers to reject an entire payload. Our tool automatically checks for common validation mistakes:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-1.5">
            <h3 class="text-sm font-bold text-rose-600 dark:text-rose-400 flex items-center gap-1.5">
              <span>✕</span> Trailing Commas
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Placing a comma after the last item in an object or array (e.g. <code>&#123;"id": 1,&#125;</code>) is valid in JavaScript but invalid in standard JSON.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-1.5">
            <h3 class="text-sm font-bold text-rose-600 dark:text-rose-400 flex items-center gap-1.5">
              <span>✕</span> Single Quotes Instead of Double Quotes
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              JSON strictly requires double quotes (<code>"key": "value"</code>). Using single quotes (<code>'key': 'value'</code>) results in immediate parse failure.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-1.5">
            <h3 class="text-sm font-bold text-rose-600 dark:text-rose-400 flex items-center gap-1.5">
              <span>✕</span> Unquoted Object Keys
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              All object keys must be enclosed in double quotes (<code>&#123;"name": "test"&#125;</code>). Bare identifiers like <code>&#123;name: "test"&#125;</code> are invalid.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-1.5">
            <h3 class="text-sm font-bold text-rose-600 dark:text-rose-400 flex items-center gap-1.5">
              <span>✕</span> Unclosed Brackets or Braces
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Mismatched opening and closing braces <code>&#123; &#125;</code> or square brackets <code>[ ]</code> within deeply nested structures.
            </p>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
