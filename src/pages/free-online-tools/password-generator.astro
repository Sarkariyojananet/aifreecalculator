---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

// ─── FAQ Data (also used for FAQPage schema) ──────────────────────────────────
const faqs = [
  {
    question: "What is a password generator?",
    answer: "A password generator is a tool that automatically creates a randomized sequence of characters for use as a password. Instead of relying on predictable words or patterns, it draws from chosen character sets to produce a password that is difficult to guess."
  },
  {
    question: "What is a random password generator?",
    answer: "A random password generator creates passwords using random character selection rather than dictionary words or personal information. When backed by cryptographic randomness — as this tool is — each character is selected using the browser's Web Crypto API, making the output statistically unpredictable."
  },
  {
    question: "How does a strong password generator work?",
    answer: "A strong password generator combines a large character pool (uppercase, lowercase, digits, symbols) with a sufficient length and cryptographically secure randomness. This tool lets you customize all three factors and shows an estimated strength indicator to help guide your choices."
  },
  {
    question: "Can I generate a 12-character password?",
    answer: "Yes. Click the '12' quick-select button or set the length slider to 12. The tool will immediately generate a 12-character password using your selected character types."
  },
  {
    question: "Can I generate a 15-character password?",
    answer: "Yes. Click the '15' quick-select button or drag the slider to 15. The generated password will be exactly 15 characters long."
  },
  {
    question: "Can I generate a 16-character password?",
    answer: "Yes. The default length is 16 characters, which offers a practical balance between security and usability. Click '16' or adjust the slider to get a 16-character password instantly."
  },
  {
    question: "Is this password generator free?",
    answer: "Yes. This password generator is completely free to use. There are no account requirements, no usage limits, and no subscription fees."
  },
  {
    question: "Are generated passwords stored anywhere?",
    answer: "No. Passwords are generated entirely inside your browser using JavaScript and the Web Crypto API. They are never written to cookies, localStorage, or any database. When you close the tab, the password disappears."
  },
  {
    question: "Are passwords sent to a server?",
    answer: "No. Generation happens 100% client-side. No network request containing your password is made by this tool. The server only delivers the static page assets."
  },
  {
    question: "What makes a password strong?",
    answer: "Several factors contribute to password strength: length (more characters means more possible combinations), character diversity (using uppercase, lowercase, digits, and symbols), unpredictability (true random generation rather than words or patterns), and uniqueness (a different password for every account)."
  },
  {
    question: "Should I use a different password for every account?",
    answer: "Yes. Using the same password across multiple sites means that a breach at one service exposes all your accounts. Consider storing unique passwords in a reputable password manager so you only need to remember one master password."
  }
];

// ─── FAQPage Schema ───────────────────────────────────────────────────────────
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  title="Password Generator - Generate Strong Random Passwords"
  description="Generate strong, random passwords in your browser with customizable length and character options. 100% free, client-side, and private — passwords are never sent to a server."
  category="Free Online Tools"
  calculatorName="Password Generator"
  slug="password-generator"
  keywords={[
    'password generator',
    'random password generator',
    'strong password generator',
    'password generator 12 characters',
    'password generator 15 characters',
    'password generator 16 characters',
    'password generator free',
    'secure password generator',
    'online password generator'
  ]}
>
  <!-- FAQPage Schema Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ═══════════════════════════════════════════════════════════════════════
       MAIN TOOL WIDGET  (default slot → renders inside calculator card)
  ════════════════════════════════════════════════════════════════════════════ -->
  <div class="space-y-6">

    <!-- Header & Introduction -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Cryptographically Secure • 100% Client-Side • Free</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Password Generator
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Create <strong>strong, random passwords</strong> instantly in your browser. Customize the length and character types, then copy your password with a single click. Use this free <strong>random password generator</strong> for new accounts, password resets, or any situation that calls for a hard-to-guess credential.
      </p>

      <!-- Privacy Trust Banner -->
      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left shadow-xs">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>Passwords are generated locally in your browser and are never uploaded to our server.</strong></span>
      </div>
    </div>

    <!-- ── MAIN GENERATOR PANEL ─────────────────────────────────────────── -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden">

      <!-- Password Output -->
      <div class="p-4 sm:p-6 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800">
        <label for="pg-password-display" class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
          Generated Password
        </label>
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="relative flex-1 min-w-0">
            <input
              id="pg-password-display"
              type="password"
              readonly
              class="w-full font-mono text-base sm:text-lg font-bold text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 pr-16 focus:outline-none focus:ring-2 focus:ring-blue-500 select-all tracking-widest"
              placeholder="Click Generate to create a password"
              aria-label="Generated password"
              autocomplete="off"
              spellcheck="false"
            />
            <!-- Show/Hide Toggle -->
            <button
              id="pg-show-toggle"
              type="button"
              aria-pressed="false"
              class="absolute right-3 top-1/2 -translate-y-1/2 px-2 py-1 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 rounded"
            >
              Show
            </button>
          </div>
          <!-- Copy Button -->
          <button
            id="pg-copy-btn"
            type="button"
            class="shrink-0 flex items-center gap-1.5 px-4 py-3 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 active:scale-95 text-white shadow-xs transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            aria-label="Copy password to clipboard"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span class="hidden sm:inline">Copy Password</span>
            <span class="sm:hidden">Copy</span>
          </button>
        </div>

        <!-- Character count & strength -->
        <div class="flex items-center justify-between mt-2 flex-wrap gap-1">
          <span id="pg-char-count" class="text-xs text-slate-400 dark:text-slate-500 font-mono"></span>
          <span class="text-xs text-slate-400 dark:text-slate-500 italic">Strength is an estimate, not a guarantee.</span>
        </div>

        <!-- Strength Indicator -->
        <div id="pg-strength-container" class="hidden mt-3 space-y-1.5" role="status" aria-label="Password strength">
          <div class="flex gap-1.5">
            <div class="h-2 flex-1 rounded-full bg-slate-200 dark:bg-slate-700" data-strength-bar></div>
            <div class="h-2 flex-1 rounded-full bg-slate-200 dark:bg-slate-700" data-strength-bar></div>
            <div class="h-2 flex-1 rounded-full bg-slate-200 dark:bg-slate-700" data-strength-bar></div>
            <div class="h-2 flex-1 rounded-full bg-slate-200 dark:bg-slate-700" data-strength-bar></div>
          </div>
          <span id="pg-strength-label" class="text-xs font-semibold text-slate-500"></span>
        </div>
      </div>

      <!-- Error Message -->
      <div
        id="pg-error"
        class="hidden mx-4 sm:mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-sm font-medium text-red-700 dark:text-red-400"
        role="alert"
        aria-live="assertive"
      ></div>

      <!-- Controls -->
      <div class="p-4 sm:p-6 space-y-5">

        <!-- Length Control -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <label for="pg-length-slider" class="text-sm font-bold text-slate-800 dark:text-slate-200">
              Password Length
            </label>
            <div class="flex items-center gap-2">
              <label for="pg-length-input" class="sr-only">Exact length value</label>
              <input
                id="pg-length-input"
                type="number"
                min="4"
                max="128"
                value="16"
                class="w-16 text-center font-mono font-bold text-sm text-slate-900 dark:text-white bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-500"
                aria-label="Password length value"
              />
              <span class="text-xs text-slate-400">chars</span>
            </div>
          </div>

          <input
            id="pg-length-slider"
            type="range"
            min="4"
            max="128"
            value="16"
            step="1"
            class="w-full h-2 rounded-full accent-blue-600 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            aria-label="Password length slider"
          />

          <!-- Quick Length Presets -->
          <div class="flex flex-wrap gap-1.5" role="group" aria-label="Quick length presets">
            {[12, 15, 16, 20, 24, 32].map((len) => (
              <button
                type="button"
                data-quick-length={len}
                class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 dark:hover:text-white transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500"
                aria-label={`Set length to ${len} characters`}
              >
                {len}
              </button>
            ))}
          </div>
        </div>

        <!-- Character Options -->
        <fieldset class="space-y-2.5">
          <legend class="text-sm font-bold text-slate-800 dark:text-slate-200">Character Types</legend>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <!-- Uppercase -->
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 cursor-pointer hover:border-blue-400 dark:hover:border-blue-600 transition has-checked:border-blue-500 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/30">
              <input
                id="pg-upper"
                type="checkbox"
                checked
                class="w-4 h-4 rounded accent-blue-600 cursor-pointer focus:ring-2 focus:ring-blue-500"
                aria-describedby="pg-upper-desc"
              />
              <span class="flex flex-col min-w-0">
                <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">Uppercase Letters</span>
                <span id="pg-upper-desc" class="text-xs text-slate-500 dark:text-slate-400 font-mono">A–Z</span>
              </span>
            </label>

            <!-- Lowercase -->
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 cursor-pointer hover:border-blue-400 dark:hover:border-blue-600 transition has-checked:border-blue-500 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/30">
              <input
                id="pg-lower"
                type="checkbox"
                checked
                class="w-4 h-4 rounded accent-blue-600 cursor-pointer focus:ring-2 focus:ring-blue-500"
                aria-describedby="pg-lower-desc"
              />
              <span class="flex flex-col min-w-0">
                <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">Lowercase Letters</span>
                <span id="pg-lower-desc" class="text-xs text-slate-500 dark:text-slate-400 font-mono">a–z</span>
              </span>
            </label>

            <!-- Numbers -->
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 cursor-pointer hover:border-blue-400 dark:hover:border-blue-600 transition has-checked:border-blue-500 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/30">
              <input
                id="pg-digits"
                type="checkbox"
                checked
                class="w-4 h-4 rounded accent-blue-600 cursor-pointer focus:ring-2 focus:ring-blue-500"
                aria-describedby="pg-digits-desc"
              />
              <span class="flex flex-col min-w-0">
                <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">Numbers</span>
                <span id="pg-digits-desc" class="text-xs text-slate-500 dark:text-slate-400 font-mono">0–9</span>
              </span>
            </label>

            <!-- Symbols -->
            <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 cursor-pointer hover:border-blue-400 dark:hover:border-blue-600 transition has-checked:border-blue-500 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/30">
              <input
                id="pg-symbols"
                type="checkbox"
                checked
                class="w-4 h-4 rounded accent-blue-600 cursor-pointer focus:ring-2 focus:ring-blue-500"
                aria-describedby="pg-symbols-desc"
              />
              <span class="flex flex-col min-w-0">
                <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">Symbols</span>
                <span id="pg-symbols-desc" class="text-xs text-slate-500 dark:text-slate-400 font-mono">!@#$%^&*-_=+…</span>
              </span>
            </label>
          </div>

          <!-- Require Each -->
          <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 cursor-pointer hover:border-blue-400 dark:hover:border-blue-600 transition has-checked:border-blue-500 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/30">
            <input
              id="pg-require-each"
              type="checkbox"
              checked
              class="w-4 h-4 rounded accent-blue-600 cursor-pointer focus:ring-2 focus:ring-blue-500"
            />
            <span class="flex flex-col min-w-0">
              <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">Include at least one character from each selected type</span>
              <span class="text-xs text-slate-500 dark:text-slate-400">Guarantees diversity across enabled character groups</span>
            </span>
          </label>
        </fieldset>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-2 sm:gap-3 pt-1">
          <button
            id="pg-generate-btn"
            type="button"
            class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 active:scale-95 text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            aria-label="Generate new password"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Generate New Password
          </button>
          <button
            id="pg-reset-btn"
            type="button"
            class="px-4 py-2.5 rounded-xl text-sm font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-slate-400"
            aria-label="Reset all settings to defaults"
          >
            Reset
          </button>
        </div>

      </div>
    </div>

    <!-- ── BULK GENERATION PANEL ──────────────────────────────────────────── -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-3 p-4 sm:p-5 border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/40">
        <div>
          <h2 class="text-sm font-bold text-slate-800 dark:text-white">Generate Multiple Passwords</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Each password uses independent cryptographic randomness.</p>
        </div>
        <div class="flex items-center gap-2">
          <label for="pg-bulk-count" class="text-xs font-semibold text-slate-600 dark:text-slate-400">Count:</label>
          <select
            id="pg-bulk-count"
            class="text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-2 py-1.5 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer"
            aria-label="Number of passwords to generate"
          >
            <option value="3">3</option>
            <option value="5" selected>5</option>
            <option value="10">10</option>
          </select>
          <button
            id="pg-bulk-generate-btn"
            type="button"
            class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-800 dark:bg-slate-200 text-white dark:text-slate-900 hover:bg-blue-600 dark:hover:bg-blue-600 dark:hover:text-white transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Generate multiple passwords"
          >
            Generate List
          </button>
        </div>
      </div>

      <div id="pg-bulk-results" class="hidden p-4 sm:p-5">
        <ul id="pg-bulk-list" class="space-y-0" aria-label="Generated passwords list">
          <!-- Filled dynamically by password-generator.js -->
        </ul>
      </div>
    </div>

    <!-- Script Loader -->
    <script is:inline src="/js/tools/password-generator.js"></script>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SEO CONTENT SLOT  (name="content" → rendered in rich content section)
  ════════════════════════════════════════════════════════════════════════════ -->
  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300 not-prose">

      <!-- SECTION 1: Random Password Generator -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Random Password Generator
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          A <strong>random password generator</strong> creates credentials by selecting characters from a defined pool using a source of unpredictable values — ideally cryptographic randomness, not a simple algorithm. When a password is generated this way, there is no underlying pattern that an attacker can exploit by guessing common substitutions or dictionary words.
        </p>
        <p class="leading-relaxed">
          This tool uses the browser's <code class="px-1.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 font-mono text-sm text-blue-700 dark:text-blue-300">crypto.getRandomValues()</code> API for all character selection and shuffling. Unlike <code class="px-1.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 font-mono text-sm text-slate-600 dark:text-slate-400">Math.random()</code> — which is designed for simulations, not security — the Web Crypto API is seeded by the operating system's entropy pool, making it appropriate for generating passwords.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-base">🎲</div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Cryptographic Randomness</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Uses <code class="font-mono">crypto.getRandomValues()</code> — the same API underlying TLS key generation — not <code class="font-mono">Math.random()</code>.</p>
          </div>
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">🔒</div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">No Bias Correction Needed</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Rejection sampling prevents modulo bias when mapping random bytes to a character pool of any size.</p>
          </div>
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center text-base">🛡️</div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">No Network Transmission</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Generation runs entirely in your browser's memory. No password leaves your device.</p>
          </div>
        </div>
      </section>

      <!-- SECTION 2: Strong Password Generator -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Strong Password Generator
        </h2>
        <p class="leading-relaxed">
          A <strong>strong password generator</strong> doesn't just produce random characters — it combines randomness with length and character diversity to increase the number of possible combinations an attacker would need to test. The tool here lets you tune all three variables.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
