              <tr>
                <td class="p-3.5 font-semibold text-slate-900 dark:text-white">Each Page (Burst)</td>
                <td class="p-3.5"><em>Automatic</em></td>
                <td class="p-3.5">Individual separate PDFs for every single page (Page-1.pdf, Page-2.pdf...)</td>
                <td class="p-3.5">Scanned batch invoices, individual student certificates, ID cards</td>
              </tr>
              <tr>
                <td class="p-3.5 font-semibold text-slate-900 dark:text-white">By Ranges</td>
                <td class="p-3.5"><code>1-5, 6-10</code></td>
                <td class="p-3.5">Multiple separate PDF documents grouped by your range boundaries</td>
                <td class="p-3.5">Separating book chapters, quarterly audit reports, legal briefs</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 5: Real-World Use Cases -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Practical Real-World Use Cases
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '⚖️',
              title: 'Legal Contracts & Affidavits',
              desc: 'Isolate signature pages or confidential clauses without sharing full multi-hundred page disclosure documents with third parties.'
            },
            {
              icon: '🎓',
              title: 'Academic Papers & Textbooks',
              desc: 'Extract specific reading assignments, journal articles, or problem sets from large academic textbooks for focused study.'
            },
            {
              icon: '📑',
              title: 'Scanned Invoices & Receipts',
              desc: 'Separate multi-invoice scans into distinct monthly accounting records for streamlined ERP and bookkeeping management.'
            },
            {
              icon: '🏛️',
              title: 'Government Application Forms',
              desc: 'Extract specific declaration certificates or identity pages required for UPSC, SSC, visa, and passport portal uploads.'
            },
            {
              icon: '🏥',
              title: 'Medical Records & Diagnostic Reports',
              desc: 'Extract lab test results or discharge summaries from comprehensive hospital records for doctor consultations.'
            },
            {
