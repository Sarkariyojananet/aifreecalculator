---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

// FAQ Schema for Search Engines
const faqs = [
  {
    question: "How do I create a free QR code?",
    answer: "Choose your desired content type (Website URL, Plain Text, Wi-Fi, Email, Phone, or vCard), enter your information, customize colors and error correction if desired, and download your high-resolution QR code as a PNG, SVG, or JPG image instantly."
  },
  {
    question: "Do QR codes generated here ever expire?",
    answer: "No. Our free QR code generator creates permanent static QR codes. The destination data is encoded directly into the pattern of black-and-white modules without any intermediary redirect server. They will continue to work indefinitely as long as your destination link or content remains active."
  },
  {
    question: "What is the difference between this tool, Adobe, and Canva QR code generators?",
    answer: "While Adobe and Canva offer QR code generators, they typically require user accounts, email sign-ups, or paid subscriptions for high-resolution vector exports, and they embed QR codes inside design suites rather than providing quick standalone files. Our free QR code generator requires no account, provides lossless SVG vector downloads, includes a bulk QR code generator, and processes everything 100% locally in your browser with zero tracking."
  },
  {
    question: "Can I generate bulk QR codes at once?",
    answer: "Yes. Switch to the 'Bulk QR Code Generator' tab, paste multiple URLs or text lines (one per line, or formatted as 'Label,Data'), and our tool will generate all QR codes simultaneously with individual PNG/SVG downloads and a batch download option."
  },
  {
    question: "How do I create a Wi-Fi QR code that connects automatically?",
    answer: "Select the 'Wi-Fi Network' tab, enter your network name (SSID), password, and security type (WPA/WPA2/WEP). When scanned with a smartphone camera, the device automatically prompts the user to join the Wi-Fi network without manually typing passwords."
  },
  {
    question: "Which download format should I choose: PNG, SVG, or JPG?",
    answer: "For web pages, social media, and digital screens, choose high-resolution PNG (512px or 1024px). For professional printing, signage, brochures, and commercial merchandise, choose SVG (Scalable Vector Graphics) because it scales to any dimension without pixelation or blurriness."
  },
  {
    question: "Can I add a custom logo or image in the center of my QR code?",
    answer: "Yes. In the design options, you can choose a preset icon (Link, Wi-Fi, Mail, Star) or upload your own company logo. When adding a center logo, we automatically increase error correction to High (Q or H) so the QR code remains 100% readable by all mobile scanners."
  },
  {
    question: "Are my QR codes and input data saved on any server?",
    answer: "No. All QR code generation takes place 100% client-side inside your browser using JavaScript and HTML5 Canvas. No URLs, Wi-Fi passwords, contact details, or generated images are ever uploaded to or stored on our servers."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  title="QR Code Generator - Free Custom & Bulk QR Code Maker"
  description="Generate custom high-resolution QR codes for websites, Wi-Fi, text, vCards, and bulk lists for free. Fully client-side, private, and customizable."
  category="Free Online Tools"
  calculatorName="QR Code Generator"
  slug="qr-code-generator"
  keywords={[
    'qr code generator',
    'free qr code generator',
    'qr code generator free',
    'adobe qr code generator',
    'canva qr code generator',
    'bulk qr code generator',
    'custom qr code maker',
    'wifi qr code',
    'svg qr code generator'
  ]}
>
  <!-- Injected FAQPage Schema for Search Engines -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- MAIN INTERACTIVE QR CODE GENERATOR WIDGET -->
  <div class="space-y-6">

    <!-- Header & SEO Introduction -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>100% Free • No Sign-Up • Permanent Static QR Codes</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        QR Code Generator
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Create custom high-resolution QR codes instantly with our <strong>free QR code generator</strong>. Generate codes for websites, Wi-Fi networks, plain text, email, and vCards, or switch to our <strong>bulk QR code generator</strong> to produce dozens of codes in seconds. Download print-ready vector SVG or HD PNG files with zero watermarks and no expiration dates.
      </p>

      <!-- Local Processing Privacy Guarantee Banner -->
      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left shadow-xs">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Client-Side Privacy:</strong> Your data is encoded locally in your browser. URLs, Wi-Fi credentials, and contact details are never sent to or stored on any server.</span>
      </div>
    </div>

    <!-- MAIN TOOL CONTAINER CARD -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl overflow-hidden">
      
      <!-- MODE SWITCHER TABS (Single vs Bulk) -->
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 p-2.5 bg-slate-50 dark:bg-slate-900/60">
        <div class="flex items-center gap-1.5 p-1 bg-slate-200/70 dark:bg-slate-800 rounded-xl">
          <button
            id="singleTabBtn"
            type="button"
            class="flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg transition-all duration-200 bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 shadow-xs cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
            </svg>
            Single QR Code
          </button>
          <button
            id="bulkTabBtn"
            type="button"
            class="flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg transition-all duration-200 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Bulk QR Code Generator
            <span class="px-1.5 py-0.5 text-[10px] font-bold bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300 rounded-md">Batch</span>
          </button>
        </div>

        <div class="hidden sm:flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 pr-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Ready to generate
        </div>
      </div>

      <!-- ================= SECTION 1: SINGLE QR CODE GENERATOR ================= -->
      <div id="singleModeSection" class="p-4 sm:p-6 lg:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
          
          <!-- LEFT COLUMN: Content Inputs & Customization (7 cols) -->
          <div class="lg:col-span-7 space-y-6">

            <!-- Content Type Selector Pills -->
            <div class="space-y-2.5">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                1. Select Content Type
              </label>
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
                <button
                  type="button"
                  data-type="url"
                  class="content-type-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-transparent text-xs font-semibold transition-all duration-150 bg-blue-600 text-white shadow-xs cursor-pointer"
                >
                  <span class="text-base mb-1">🔗</span>
                  URL
                </button>
                <button
                  type="button"
                  data-type="text"
                  class="content-type-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-transparent text-xs font-semibold transition-all duration-150 bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer"
                >
                  <span class="text-base mb-1">📝</span>
                  Text
                </button>
                <button
                  type="button"
                  data-type="wifi"
                  class="content-type-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-transparent text-xs font-semibold transition-all duration-150 bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer"
                >
                  <span class="text-base mb-1">📶</span>
                  Wi-Fi
                </button>
                <button
                  type="button"
                  data-type="email"
                  class="content-type-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-transparent text-xs font-semibold transition-all duration-150 bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer"
                >
                  <span class="text-base mb-1">✉️</span>
                  Email
                </button>
                <button
                  type="button"
                  data-type="phone"
                  class="content-type-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-transparent text-xs font-semibold transition-all duration-150 bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer"
                >
                  <span class="text-base mb-1">📞</span>
                  Phone/SMS
                </button>
                <button
                  type="button"
                  data-type="vcard"
                  class="content-type-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-transparent text-xs font-semibold transition-all duration-150 bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer"
                >
                  <span class="text-base mb-1">👤</span>
                  vCard
                </button>
              </div>
            </div>

            <!-- DYNAMIC INPUT FORMS -->
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800">
              
              <!-- Form 1: Website URL -->
              <div id="formUrl" class="content-form space-y-3" data-form="url">
                <label for="urlInput" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Website or Landing Page URL
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    https://
                  </div>
                  <input
                    type="text"
                    id="urlInput"
                    value="https://aifreecalculator.com"
                    placeholder="example.com or your link"
                    class="w-full pl-20 pr-4 py-2.5 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  Enter any website URL, Google Drive link, menu PDF, or social media profile.
                </p>
              </div>

              <!-- Form 2: Plain Text -->
              <div id="formText" class="content-form space-y-3 hidden" data-form="text">
                <label for="textInput" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Plain Text Content
                </label>
                <textarea
                  id="textInput"
                  rows="3"
                  placeholder="Enter your message, notes, coupon code, or product serial number..."
                  class="w-full px-4 py-2.5 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                ></textarea>
              </div>

              <!-- Form 3: Wi-Fi Network -->
              <div id="formWifi" class="content-form space-y-3.5 hidden" data-form="wifi">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label for="wifiSsid" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                      Network Name (SSID)
                    </label>
                    <input
                      type="text"
                      id="wifiSsid"
                      placeholder="e.g., Office_Guest_WiFi"
                      class="w-full px-3.5 py-2 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                  <div>
                    <label for="wifiPass" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                      Password
                    </label>
                    <input
                      type="text"
                      id="wifiPass"
                      placeholder="Network Password"
                      class="w-full px-3.5 py-2 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                  <div class="flex items-center gap-2">
                    <label for="wifiEnc" class="text-xs font-bold text-slate-700 dark:text-slate-300">
                      Security:
                    </label>
                    <select
                      id="wifiEnc"
                      class="px-2.5 py-1 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white"
                    >
                      <option value="WPA">WPA / WPA2 / WPA3</option>
                      <option value="WEP">WEP</option>
                      <option value="nopass">None (Open)</option>
                    </select>
                  </div>

                  <label class="flex items-center gap-2 text-xs font-medium text-slate-700 dark:text-slate-300 cursor-pointer">
                    <input type="checkbox" id="wifiHidden" class="rounded border-slate-300 dark:border-slate-700 text-blue-600 focus:ring-blue-500" />
                    Hidden SSID
                  </label>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  When scanned with iOS or Android cameras, users can connect with 1 tap without typing passwords.
                </p>
              </div>

              <!-- Form 4: Email -->
              <div id="formEmail" class="content-form space-y-3 hidden" data-form="email">
                <div>
                  <label for="emailTo" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                    Send To (Email Address)
                  </label>
                  <input
                    type="email"
                    id="emailTo"
                    placeholder="support@company.com"
                    class="w-full px-3.5 py-2 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label for="emailSubject" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                      Subject
                    </label>
                    <input
                      type="text"
                      id="emailSubject"
                      placeholder="Inquiry / Feedback"
                      class="w-full px-3.5 py-2 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                  <div>
                    <label for="emailBody" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                      Pre-filled Body
                    </label>
                    <input
                      type="text"
                      id="emailBody"
                      placeholder="Hello, I'd like to ask about..."
                      class="w-full px-3.5 py-2 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                </div>
              </div>

              <!-- Form 5: Phone & SMS -->
              <div id="formPhone" class="content-form space-y-3 hidden" data-form="phone">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label for="phoneType" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                      Action
                    </label>
                    <select
                      id="phoneType"
                      class="w-full px-3 py-2 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white"
                    >
                      <option value="call">Direct Call (tel:)</option>
                      <option value="sms">SMS Text Message</option>
                    </select>
                  </div>
                  <div class="sm:col-span-2">
                    <label for="phoneNumber" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                      Phone Number (with Country Code)
                    </label>
                    <input
                      type="tel"
                      id="phoneNumber"
                      placeholder="+1 (555) 019-2834"
                      class="w-full px-3.5 py-2 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                </div>

                <div id="smsFieldGroup" class="hidden">
                  <label for="smsMessage" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                    Pre-filled SMS Message
                  </label>
                  <input
                    type="text"
                    id="smsMessage"
                    placeholder="e.g. SUBSCRIBE or RSVP YES"
                    class="w-full px-3.5 py-2 text-sm bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>
              </div>

              <!-- Form 6: vCard Contact Card -->
              <div id="formVcard" class="content-form space-y-3 hidden" data-form="vcard">
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="vcardFirstName" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">First Name</label>
                    <input type="text" id="vcardFirstName" placeholder="John" class="w-full px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white" />
                  </div>
                  <div>
                    <label for="vcardLastName" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Last Name</label>
                    <input type="text" id="vcardLastName" placeholder="Doe" class="w-full px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white" />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="vcardPhone" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Phone</label>
                    <input type="tel" id="vcardPhone" placeholder="+1234567890" class="w-full px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white" />
                  </div>
                  <div>
                    <label for="vcardEmail" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Email</label>
                    <input type="email" id="vcardEmail" placeholder="john@company.com" class="w-full px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white" />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="vcardCompany" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Company</label>
                    <input type="text" id="vcardCompany" placeholder="Acme Corp" class="w-full px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white" />
                  </div>
                  <div>
                    <label for="vcardTitle" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Job Title</label>
                    <input type="text" id="vcardTitle" placeholder="Product Lead" class="w-full px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white" />
                  </div>
                </div>
                <div>
                  <label for="vcardUrl" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Website</label>
                  <input type="text" id="vcardUrl" placeholder="https://example.com" class="w-full px-3 py-1.5 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white" />
                </div>
              </div>

            </div>

            <!-- CUSTOMIZATION CONTROLS -->
            <div class="space-y-4 pt-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                2. Design & Color Customization
              </label>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <!-- Foreground Color -->
                <div class="p-3.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700 dark:text-slate-300">QR Code Color</span>
                    <input type="text" id="fgColorText" value="#000000" class="w-20 px-2 py-0.5 text-xs text-center font-mono border border-slate-200 dark:border-slate-700 rounded bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200" />
                  </div>
                  <div class="flex items-center gap-2">
