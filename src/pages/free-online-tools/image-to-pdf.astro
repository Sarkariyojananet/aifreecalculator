          {[
            { step: '1', title: 'Upload Your Images', desc: 'Drag and drop your photos into the green drop zone or click "Choose Images" to select multiple JPG, PNG, GIF, or WebP files from your storage.' },
            { step: '2', title: 'Review & Reorder', desc: 'Check the image preview queue. Use the Up (↑) and Down (↓) buttons to arrange pictures in the exact page order you want them in the PDF.' },
            { step: '3', title: 'Generate PDF', desc: 'Click the "Convert & Merge Images to PDF" button. The engine builds each PDF page with correct dimensions and embeds your graphics.' },
            { step: '4', title: 'Instant Download', desc: 'Click the green "Download PDF" button to save your compiled, high-resolution PDF directly to your device.' },
          ].map(({ step, title, desc }) => (
            <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-1.5">
              <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Step {step}</span>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">{title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
