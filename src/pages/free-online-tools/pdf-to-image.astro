    </div>

    <div id="pti-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="pti-status-icon" class="text-2xl shrink-0"></span>
