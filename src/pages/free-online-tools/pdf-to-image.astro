              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: Format Comparison Table (PNG vs JPG) -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          PNG vs JPG: Which Format Should You Choose?
        </h2>
        <p class="leading-relaxed">
          Choosing the correct output format when using a <strong>pdf to image converter online</strong> ensures the best balance between visual quality and file size. Use this comparison table to decide between PNG and JPG:
        </p>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-100 dark:bg-slate-800/80 text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800">
              <tr>
                <th class="p-3.5 font-bold">Feature / Attribute</th>
                <th class="p-3.5 font-bold text-orange-600 dark:text-orange-400">PNG Format (Recommended for Text)</th>
                <th class="p-3.5 font-bold text-blue-600 dark:text-blue-400">JPG Format (Recommended for Photos)</th>
              </tr>
