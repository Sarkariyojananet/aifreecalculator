---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

// FAQ Schema for Search Engines
const faqs = [
  {
    question: "What is an image resizer?",
    answer: "An image resizer is an online tool that adjusts the dimensional resolution (pixels, centimeters, or inches) and file weight (KB or MB) of digital photos to fit specific screen, print, or web upload requirements."
  },
  {
    question: "How can I resize an image online?",
    answer: "Select or drag and drop your image into our free online image resizer. Choose your preferred mode—pixels, centimeters, or target file size in KB—enter your target values, and download your resized picture instantly."
  },
  {
    question: "Can I resize an image to 50KB?",
    answer: "Yes. Switch to the 'Target File Size' tab and click the '50 KB' button. The tool will automatically calculate the best balance between dimensions and image quality to keep the final output at or below 50KB."
  },
  {
    question: "Can I resize an image in KB?",
    answer: "Yes. Our image resizer in KB mode lets you choose presets like 20KB, 50KB, 100KB, or 200KB, or enter any custom KB target. The algorithm iteratively optimizes encoding to meet your target."
  },
  {
    question: "Can I resize an image in CM?",
    answer: "Yes. In the 'Centimeters (cm)' tab, enter your desired width and height in centimeters alongside your target DPI (such as 96 DPI for screen or 300 DPI for high-quality printing). The tool converts physical measurements to exact pixel dimensions."
  },
  {
    question: "What is DPI when resizing an image?",
    answer: "DPI (Dots Per Inch) defines how many pixels exist within one linear inch of an image. Higher DPI values (such as 300 DPI) produce denser, sharper physical prints, while 72 to 96 DPI is standard for computer screens and smartphones."
  },
  {
    question: "Can I resize JPG, PNG and WebP images?",
    answer: "Yes. Our tool natively supports JPG/JPEG, PNG, and WebP formats. You can also cross-convert between these formats during the resizing process."
  },
  {
    question: "Will resizing reduce image quality?",
    answer: "Downscaling dimensions (making an image smaller) actually increases perceived pixel density without loss of visual sharpness. Upscaling (making an image larger) can cause pixelation if stretched beyond original sensor resolution."
  },
  {
    question: "Is this image resizer free?",
    answer: "Yes, our image resizer is 100% free with no subscriptions, registration, watermarks, or usage limits."
  },
  {
    question: "Are my images uploaded to a server?",
    answer: "No. All resizing and encoding happen 100% locally inside your browser using HTML5 Canvas and Blob APIs. Your photos never leave your device."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  title="Image Resizer - Resize Images Online for Free"
  description="Resize images online for free by pixels, centimeters, or target file size in KB. Fast, client-side, and private image resizer with aspect ratio lock."
  category="Free Online Tools"
  calculatorName="Image Resizer"
  slug="image-resizer"
  keywords={[
    'image resizer',
    'image resizer in kb',
    'online image resizer',
    'image resizer online',
    'simple image resizer',
    'image resizer in cm',
    'image resizer 50kb',
    'canva image resizer',
    'resize image',
    'resize photo',
    'scale image'
  ]}
>
  <!-- Injected FAQPage Schema for Search Engines -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- MAIN INTERACTIVE IMAGE RESIZER TOOL WIDGET -->
  <div class="space-y-6">

    <!-- Privacy & Security Guarantee Banner -->
    <div class="flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-950/30 dark:text-emerald-300">
      <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold">
        🛡️
      </div>
      <div>
        <span class="font-bold">100% Client-Side Privacy:</span>
        Your images are processed locally in your browser and are not uploaded to our server. Photos remain strictly confidential on your device.
      </div>
    </div>

    <!-- Alert / Error Box (Hidden by default) -->
    <div id="ir-alert-box" class="hidden rounded-2xl border p-4 text-xs transition-all" role="alert">
      <div class="flex items-start gap-2.5">
        <span class="text-base shrink-0">⚠️</span>
        <div id="ir-alert-text" class="flex-1 font-medium leading-relaxed"></div>
      </div>
    </div>

    <!-- Transparency Notice (Hidden by default) -->
    <div id="ir-transparency-notice" class="hidden rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800 dark:border-amber-900/40 dark:bg-amber-950/30 dark:text-amber-300">
    </div>

    <!-- SECTION 1: UPLOAD DROP ZONE (Visible when no image loaded) -->
    <section id="ir-upload-section" class="transition-all">
      <div
        id="ir-drop-zone"
        tabindex="0"
        role="button"
        aria-label="Upload image area: Click or drag and drop an image to resize"
        class="group relative flex flex-col items-center justify-center rounded-3xl border-2 border-dashed border-slate-300 bg-slate-50/50 p-8 text-center transition-all duration-200 hover:border-blue-500 hover:bg-blue-50/40 focus:border-blue-500 focus:outline-hidden focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900/40 dark:hover:border-blue-500 dark:hover:bg-blue-950/20 sm:p-12 cursor-pointer"
      >
        <input
          type="file"
          id="ir-file-input"
          accept="image/jpeg,image/png,image/webp"
          class="sr-only"
          aria-hidden="true"
        />

        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100/80 text-3xl text-blue-600 transition group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white dark:bg-blue-950/60 dark:text-blue-400 dark:group-hover:bg-blue-600 dark:group-hover:text-white">
          📐
        </div>

        <h2 class="mt-4 text-lg font-bold text-slate-900 dark:text-white sm:text-xl">
          Choose an image or drag & drop here
        </h2>

        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 sm:text-sm max-w-md">
          Resize by <strong>Pixels, Centimeters (cm), or Target File Size (KB)</strong>. Works with JPG, PNG, and WebP files.
        </p>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
          <button
            type="button"
            id="ir-select-file-btn"
            class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-xs transition hover:bg-blue-700 focus:ring-2 focus:ring-blue-500/30 cursor-pointer sm:text-sm"
          >
            <span>📁 Select Image</span>
          </button>
          <span class="text-xs text-slate-400 dark:text-slate-500">or paste from clipboard (Ctrl+V)</span>
        </div>

        <div class="mt-6 flex items-center gap-4 text-[11px] font-semibold text-slate-400 dark:text-slate-500">
          <span class="flex items-center gap-1">✓ Supports JPG / PNG / WebP</span>
          <span>•</span>
          <span class="flex items-center gap-1">✓ Up to 50 MB</span>
          <span>•</span>
          <span class="flex items-center gap-1">✓ Local Browser Execution</span>
        </div>
      </div>
    </section>

    <!-- SECTION 2: WORKSPACE & CONTROLS (Visible when image loaded) -->
    <section id="ir-workspace-section" class="hidden space-y-6">

      <!-- Original Image Overview Header Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200/90 bg-slate-50/70 p-3.5 text-xs dark:border-slate-800 dark:bg-slate-900/60">
        <div class="flex items-center gap-2">
          <span class="font-bold text-slate-700 dark:text-slate-200">Original Resolution:</span>
          <span id="ir-stat-orig-dim" class="font-mono font-black text-blue-600 dark:text-blue-400">-</span>
        </div>
        <div class="flex items-center gap-4 text-slate-500 dark:text-slate-400">
          <span>File Size: <strong id="ir-stat-orig-size" class="text-slate-800 dark:text-slate-200 font-mono">-</strong></span>
          <span>•</span>
          <span>Aspect Ratio: <strong id="ir-stat-orig-ratio" class="text-slate-800 dark:text-slate-200 font-mono">-</strong></span>
        </div>
      </div>

      <!-- Resizing Mode Tabs Bar -->
      <div class="rounded-2xl border border-slate-200/90 bg-white shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex border-b border-slate-100 px-4 dark:border-slate-800 text-xs font-bold">
          <button
            type="button"
            id="ir-tab-pixels"
            class="active border-b-2 border-blue-600 px-4 py-3 text-blue-600 dark:text-blue-400 cursor-pointer transition"
          >
            Pixels (px)
          </button>
          <button
            type="button"
            id="ir-tab-cm"
            class="px-4 py-3 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 cursor-pointer transition"
          >
            Centimeters (cm)
          </button>
          <button
            type="button"
            id="ir-tab-kb"
            class="px-4 py-3 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 cursor-pointer transition"
          >
            Target File Size (KB)
          </button>
        </div>

        <div class="p-5">

          <!-- PANEL A: PIXELS (px) -->
          <div id="ir-panel-pixels" class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="ir-width-px" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                  Width (Pixels)
                </label>
                <div class="relative mt-1">
                  <input
                    type="number"
                    id="ir-width-px"
                    min="1"
                    max="15000"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 pr-10 font-mono text-sm font-bold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">px</span>
                </div>
              </div>

              <div>
                <label for="ir-height-px" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                  Height (Pixels)
                </label>
                <div class="relative mt-1">
                  <input
                    type="number"
                    id="ir-height-px"
                    min="1"
                    max="15000"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 pr-10 font-mono text-sm font-bold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">px</span>
                </div>
              </div>
            </div>

            <!-- Lock Aspect Ratio & Quick Scale Buttons -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1 border-t border-slate-100 dark:border-slate-800">
              <label class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
                <input type="checkbox" id="ir-lock-aspect" checked class="h-4 w-4 rounded accent-blue-600" />
                <span>Lock Aspect Ratio (Maintain Proportions)</span>
              </label>

              <div class="flex items-center gap-1 text-xs">
                <span class="font-semibold text-slate-400 mr-1">Quick Scale:</span>
                <button type="button" data-pct="25" class="ir-preset-pct rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">25%</button>
                <button type="button" data-pct="50" class="ir-preset-pct rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">50%</button>
                <button type="button" data-pct="75" class="ir-preset-pct rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">75%</button>
                <button type="button" data-pct="100" class="ir-preset-pct rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">100%</button>
                <button type="button" data-pct="200" class="ir-preset-pct rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">200%</button>
              </div>
            </div>
          </div>

          <!-- PANEL B: CENTIMETERS (cm + DPI) -->
          <div id="ir-panel-cm" class="hidden space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div>
                <label for="ir-width-cm" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                  Width (Centimeters)
                </label>
                <div class="relative mt-1">
                  <input
                    type="number"
                    id="ir-width-cm"
                    step="0.1"
                    min="0.1"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 pr-10 font-mono text-sm font-bold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">cm</span>
                </div>
              </div>

              <div>
                <label for="ir-height-cm" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                  Height (Centimeters)
                </label>
                <div class="relative mt-1">
                  <input
                    type="number"
                    id="ir-height-cm"
                    step="0.1"
                    min="0.1"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 pr-10 font-mono text-sm font-bold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">cm</span>
                </div>
              </div>

              <div>
                <label for="ir-dpi" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                  DPI (Print / Screen Resolution)
                </label>
                <div class="relative mt-1">
                  <input
                    type="number"
                    id="ir-dpi"
                    value="96"
                    min="10"
                    max="1200"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 pr-10 font-mono text-sm font-bold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">DPI</span>
                </div>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1 border-t border-slate-100 dark:border-slate-800">
              <label class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
                <input type="checkbox" id="ir-lock-aspect-cm" checked class="h-4 w-4 rounded accent-blue-600" />
                <span>Lock Aspect Ratio</span>
              </label>

              <div class="flex items-center gap-1.5 text-xs">
                <span class="font-semibold text-slate-400">DPI Presets:</span>
                <button type="button" data-dpi="72" class="ir-dpi-preset rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">72 (Web)</button>
                <button type="button" data-dpi="96" class="ir-dpi-preset rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">96 (Screen)</button>
                <button type="button" data-dpi="150" class="ir-dpi-preset rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">150 (Draft)</button>
                <button type="button" data-dpi="300" class="ir-dpi-preset rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-bold text-slate-600 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">300 (Print)</button>
              </div>
            </div>

            <!-- Dynamic CM to Pixel Resolution Display -->
            <div id="ir-cm-calc-notice" class="rounded-xl bg-blue-50/80 p-3 font-mono text-xs font-bold text-blue-900 dark:bg-blue-950/40 dark:text-blue-200">
              Calculated Dimensions: - × - px (at 96 DPI)
            </div>
          </div>

          <!-- PANEL C: FILE SIZE (KB) -->
          <div id="ir-panel-kb" class="hidden space-y-4">
            <div>
              <span class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Choose Target File Size:
              </span>
              <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
                <button
                  type="button"
                  data-kb="20"
                  class="ir-kb-preset flex flex-col items-center justify-center rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-bold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
                >
                  <span>20 KB</span>
                  <span class="text-[10px] font-normal text-slate-400">Signatures</span>
                </button>
                <button
                  type="button"
                  data-kb="50"
                  class="ir-kb-preset active flex flex-col items-center justify-center rounded-xl border border-blue-600 bg-blue-600 p-2.5 text-xs font-bold text-white shadow-xs cursor-pointer transition"
                >
                  <span>50 KB</span>
                  <span class="text-[10px] font-normal opacity-90">Resize Image to 50KB</span>
                </button>
                <button
                  type="button"
                  data-kb="100"
                  class="ir-kb-preset flex flex-col items-center justify-center rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-bold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
                >
                  <span>100 KB</span>
                  <span class="text-[10px] font-normal text-slate-400">Certificates</span>
                </button>
                <button
                  type="button"
                  data-kb="200"
                  class="ir-kb-preset flex flex-col items-center justify-center rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-bold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
                >
                  <span>200 KB</span>
                  <span class="text-[10px] font-normal text-slate-400">High Clarity</span>
                </button>
              </div>
            </div>

            <!-- Custom KB Input -->
            <div class="flex items-center gap-2 pt-1 text-xs">
              <label for="ir-custom-kb" class="font-semibold text-slate-600 dark:text-slate-400 shrink-0">Custom Target Size:</label>
              <div class="relative flex items-center">
                <input
                  type="number"
                  id="ir-custom-kb"
                  min="5"
                  max="10000"
                  placeholder="e.g. 75"
                  class="w-24 rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 pr-8 font-mono text-xs font-bold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span class="absolute right-2 text-[10px] font-bold text-slate-400">KB</span>
              </div>
              <button
                type="button"
                id="ir-apply-custom-kb"
                class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
              >
                Apply
              </button>
            </div>
          </div>

        </div>

        <!-- Shared Format & Quality Toolbar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-slate-100 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-800/30">
          
          <!-- Format Selector -->
          <div class="flex items-center gap-2 text-xs">
            <label for="ir-format-select" class="font-bold text-slate-700 dark:text-slate-300 shrink-0">Output Format:</label>
            <select
              id="ir-format-select"
              class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 font-semibold text-slate-800 shadow-2xs focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
            >
              <option value="auto" selected>Auto (Preserve)</option>
              <option value="image/jpeg">JPG / JPEG</option>
              <option value="image/png">PNG</option>
              <option value="image/webp">WebP</option>
            </select>
          </div>

          <!-- Quality Slider -->
          <div class="flex items-center gap-3 text-xs flex-1 max-w-sm">
            <span class="font-bold text-slate-700 dark:text-slate-300 shrink-0">
              Quality: <span id="ir-quality-val" class="font-mono text-blue-600 dark:text-blue-400">85%</span> <span id="ir-quality-label" class="text-[11px] text-slate-400">(High)</span>
            </span>
            <input
              type="range"
              id="ir-quality-slider"
              min="10"
              max="100"
              value="85"
              class="w-full accent-blue-600 cursor-pointer"
            />
          </div>

          <!-- Re-apply Button -->
          <button
            type="button"
            id="ir-apply-resize-btn"
            class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition cursor-pointer"
          >
            <span>🔄 Resize Now</span>
          </button>
        </div>

      </div>

      <!-- Before / After Stats Comparison -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Resized Resolution</div>
          <div id="ir-stat-resized-dim" class="mt-1 font-mono text-base font-black text-slate-900 dark:text-white sm:text-lg">-</div>
          <div class="text-[11px] text-slate-500">Output pixel dimensions</div>
        </div>

        <div class="rounded-2xl border border-blue-200 bg-blue-50/40 p-3.5 shadow-2xs dark:border-blue-900/40 dark:bg-blue-950/20">
