---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "What is PDF Compress and how does browser-based compression work?",
    answer: "PDF Compress is a document optimization process that reduces the digital storage size of a PDF file. Our tool performs PDF compression directly inside your web browser using pdf-lib and client-side stream optimization. It removes redundant metadata, strips duplicate font structures, consolidates object streams, and re-compresses binary content without transmitting your sensitive document to an external cloud server."
  },
  {
    question: "How do I achieve a PDF compress 200kb target for official portal uploads?",
    answer: "To achieve a PDF compress 200kb target for government portals (such as UPSC, SSC, state recruitment boards, college admissions, or passport portals), upload your document, select the 'Medium' or 'High' compression preset, and click 'Compress PDF'. If your original document is multi-megabyte with high-resolution scans, use our PDF Split tool first to remove non-essential pages, or convert pages with our PDF to Image tool to adjust dpi before compiling."
  },
  {
    question: "Can I use this PDF compress online tool completely free of cost?",
    answer: "Yes. Our PDF compress online utility is 100% free with no registration, no email subscription, no daily usage limits, and no promotional watermarks stamped onto your output files. You can compress as many PDF documents as you need at zero cost."
  },
  {
    question: "Is it safe to compress confidential legal, financial, or medical PDFs here?",
    answer: "Yes, completely safe. Unlike conventional online PDF compressors that upload your files to remote cloud storage where third-party servers could retain or log your information, our tool operates 100% locally on your machine. Your bank statements, Aadhaar cards, tax returns, and contracts remain strictly private on your device."
  },
  {
    question: "Will compressing a PDF degrade the quality or readability of my text?",
    answer: "No. Vector text elements, TrueType/OpenType font glyphs, tables, and hyperlinks remain sharp and fully searchable. Compression primarily optimizes internal document indexing, eliminates orphaned objects, and deflates binary content streams without blurring vector text."
  },
  {
    question: "What is the difference between Low, Medium, and High compression levels?",
    answer: "Low compression focuses on structural cleanup, object stream optimization, and metadata stripping with zero perceptible alteration to any visual element. Medium compression provides a balanced approach ideal for web sharing and email attachments. High compression performs aggressive stream compaction, perfect for tight portal upload limits like 100 KB to 200 KB."
  },
  {
    question: "Why did my PDF file size not decrease significantly?",
    answer: "If a PDF has already been heavily compressed or contains only raw vectorized text and monochrome outlines, it is already near its theoretical mathematical size limit. In such cases, our tool will notify you that the file is already optimized, preventing unnecessary re-encoding that could introduce file bloat."
  },
  {
    question: "Can I compress password-protected PDF files?",
    answer: "For data security and cryptographic reasons, password-protected or encrypted PDF documents cannot be modified directly in the browser. You must unlock or remove the password protection from your PDF file before compressing it."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "PDF Compress",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free browser-based PDF compress online tool. Reduce PDF file size to 200kb, 100kb, or custom sizes with client-side stream optimization and zero file uploads."
};
---

<CalculatorLayout
  title="PDF Compress - Compress PDF Online Free (Under 200KB)"
  description="Compress PDF online for free. Reduce PDF file size to 200kb or smaller with adjustable compression presets. Fast, 100% client-side, private, and no watermarks."
  category="Free Online Tools"
  calculatorName="PDF Compress"
  slug="pdf-compress"
  keywords={[
    'pdf compress',
    'pdf compress online',
    'pdf compress 200kb',
    'compress pdf online free',
    'reduce pdf size',
    'pdf size reducer 200kb',
    'compress pdf to 100kb',
    'pdf compressor online'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <script is:inline>
    (function() {
      var s = document.createElement('script');
      s.src = 'https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js';
      s.crossOrigin = 'anonymous';
      s.onload = function() {
        var ts = document.createElement('script');
        ts.src = '/js/tools/pdf-compress.js';
        document.body.appendChild(ts);
      };
      s.onerror = function() {
        var ts = document.createElement('script');
        ts.src = '/js/tools/pdf-compress.js';
        document.body.appendChild(ts);
      };
      document.head.appendChild(s);
    })();
  </script>

  <div class="space-y-5">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800/80 text-purple-700 dark:text-purple-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        <span>100% Client-Side • Target 200KB & 100KB • 100% Free & Private</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        PDF Compress Online
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Reduce PDF file size online with customizable compression levels. Compress large PDF documents down to 200KB or smaller directly inside your browser.
      </p>

      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Local Privacy:</strong> Your PDF files are compressed locally in your web browser and are never transmitted to any external server.</span>
      </div>
    </div>

    <div
      id="pc-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="pc-error-text"></span>
    </div>

    <div
      id="pc-drop-zone"
      tabindex="0"
      role="button"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-purple-400 dark:hover:border-purple-600 hover:bg-purple-50/40 dark:hover:bg-purple-950/20 focus:outline-none focus:ring-4 focus:ring-purple-500/20"
    >
      <input type="file" id="pc-file-input" accept=".pdf,application/pdf" class="sr-only" />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-purple-100 dark:bg-purple-950/60 text-4xl transition group-hover:scale-105">
        🗜️
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop your PDF file here to compress
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or click below to choose a PDF from your computer or mobile device
        </p>
      </div>

      <button
        type="button"
        id="pc-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-purple-600 hover:bg-purple-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-purple-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose PDF File
      </button>
    </div>

    <div id="pc-options-section" class="hidden space-y-4">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        <div class="flex items-start gap-3">
          <span class="text-2xl shrink-0">📄</span>
          <div class="flex-1 min-w-0">
            <p id="pc-filename" class="text-sm font-bold text-slate-900 dark:text-white truncate"></p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              <span id="pc-file-size"></span> • <span id="pc-page-count"></span>
            </p>
          </div>
          <button type="button" id="pc-clear-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer">
            Change File
          </button>
        </div>
      </div>

      <div class="space-y-3">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          Select Compression Level
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <label class="relative flex items-start gap-3 p-4 rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 cursor-pointer transition hover:border-purple-400 dark:hover:border-purple-600 has-[:checked]:border-purple-500 has-[:checked]:bg-purple-50 dark:has-[:checked]:bg-purple-950/30">
            <input type="radio" name="compression-level" value="low" class="mt-0.5" checked />
            <div class="space-y-1">
              <div class="flex items-center gap-1.5">
                <p class="text-sm font-bold text-slate-900 dark:text-white">Low</p>
                <span class="text-[10px] font-bold px-1.5 py-0.5 bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 rounded">Best Quality</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">Cleans metadata and object streams with zero quality loss.</p>
            </div>
          </label>

          <label class="relative flex items-start gap-3 p-4 rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 cursor-pointer transition hover:border-purple-400 dark:hover:border-purple-600 has-[:checked]:border-purple-500 has-[:checked]:bg-purple-50 dark:has-[:checked]:bg-purple-950/30">
            <input type="radio" name="compression-level" value="medium" class="mt-0.5" />
            <div class="space-y-1">
              <div class="flex items-center gap-1.5">
                <p class="text-sm font-bold text-slate-900 dark:text-white">Medium</p>
                <span class="text-[10px] font-bold px-1.5 py-0.5 bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300 rounded">Balanced</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">Standard optimization ideal for email and web forms.</p>
            </div>
          </label>

          <label class="relative flex items-start gap-3 p-4 rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 cursor-pointer transition hover:border-purple-400 dark:hover:border-purple-600 has-[:checked]:border-purple-500 has-[:checked]:bg-purple-50 dark:has-[:checked]:bg-purple-950/30">
            <input type="radio" name="compression-level" value="high" class="mt-0.5" />
            <div class="space-y-1">
              <div class="flex items-center gap-1.5">
                <p class="text-sm font-bold text-slate-900 dark:text-white">High</p>
                <span class="text-[10px] font-bold px-1.5 py-0.5 bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-400 rounded">Target 200KB</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">Maximum compression for strict 100KB–200KB portal limits.</p>
            </div>
          </label>
        </div>
      </div>

      <button
        type="button"
        id="pc-compress-btn"
        class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-purple-600 hover:bg-purple-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-6 py-3 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-purple-500"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
        Compress PDF Now
      </button>
    </div>

    <div id="pc-status-section" class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5" role="status">
      <div class="flex items-start gap-3">
        <span id="pc-status-icon" class="text-2xl shrink-0"></span>
        <div class="space-y-1 min-w-0">
          <p id="pc-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="pc-status-body" class="text-xs text-slate-500 dark:text-slate-400"></div>
        </div>
      </div>
    </div>

    <div id="pc-download-section" class="hidden"></div>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <!-- Section 1: Introduction & Overview -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          PDF Compress: Reduce PDF File Size Online Free
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Large PDF files are a frequent obstacle when submitting job applications, government recruitment forms, college admissions, and business proposals. Our powerful <strong>PDF compress</strong> tool allows you to perform <strong>pdf compress online</strong> directly within your browser, cutting excessive file size while keeping text and diagrams crisp and legible.
        </p>
        <p class="leading-relaxed">
          Whether you need to shrink a multi-megabyte scanned document to meet a strict <strong>pdf compress 200kb</strong> portal threshold or optimize corporate annual reports for swift email distribution, our client-side compression engine handles the entire process locally. No file uploads, no cloud queues, and zero security risks.
        </p>
      </section>

      <!-- Section 2: Achieving Target 200KB / 100KB for Government & Recruitment Portals -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          How to Achieve PDF Compress 200KB for Online Applications
        </h2>
        <p class="leading-relaxed">
          Major application systems like UPSC, SSC, state PSCs, IBPS, EPFO, university portals, passport agencies, and visa submission systems impose rigid file size restrictions—often capping uploads at <strong>100 KB, 200 KB, or 500 KB</strong>. When your PDF exceeds these caps, the system immediately rejects the upload.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-5 rounded-2xl border border-purple-200 dark:border-purple-800/60 bg-purple-50/50 dark:bg-purple-950/20 space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Target 1</span>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">PDF Under 200KB</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Standard ceiling for competitive exam certificates, caste declarations, and marksheet uploads. Use our <strong>Medium</strong> or <strong>High</strong> preset to deflate stream bloat effortlessly.
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-purple-200 dark:border-purple-800/60 bg-purple-50/50 dark:bg-purple-950/20 space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Target 2</span>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">PDF Under 100KB</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Strict limit for scanned signatures, single-page identity proofs, and thumbnail verification documents. High compression strips duplicate headers and metadata.
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-purple-200 dark:border-purple-800/60 bg-purple-50/50 dark:bg-purple-950/20 space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Target 3</span>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">PDF Under 500KB</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Typical requirement for multi-page resumes, bank statements, tax returns, and project tenders. Low or Medium compression easily fits this standard.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Feature Highlights -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Why Use Our Online PDF Compressor?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              icon: '🔒',
              title: '100% Client-Side Privacy',
              desc: 'Your private financial disclosures, salary slips, and legal agreements are processed exclusively inside your browser memory. Nothing is ever uploaded to a server.'
            },
            {
              icon: '⚡',
              title: 'Instant Local Speed',
              desc: 'No uploading or downloading delays. Compression algorithms execute in milliseconds using the client JavaScript engine.'
            },
            {
              icon: '🎯',
              title: 'Granular Compression Levels',
              desc: 'Choose Low for zero quality loss, Medium for general business needs, or High for aggressive size reduction under 200KB.'
            },
            {
              icon: '🔍',
              title: 'Searchable Text Preservation',
              desc: 'Vector fonts and text layers remain fully searchable, selectable, and indexable. Your document structure stays intact.'
            },
            {
              icon: '📊',
              title: 'Real-Time Size Comparison',
              desc: 'View precise before-and-after byte counts and the exact percentage of space saved before downloading.'
            },
            {
              icon: '🚫',
              title: 'Zero Watermarks & Ads',
              desc: 'We never stamp promotional logos or restrict page counts. Enjoy unlimited, clean document compression forever.'
            }
          ].map(({ icon, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{icon}</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: Step-by-Step Instructions -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          How to Compress PDF Online in 4 Simple Steps
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {[
            {
              step: '1',
              title: 'Select PDF',
              desc: 'Drop your PDF document into the drag-and-drop zone or click "Choose PDF File" to select from your device.'
            },
            {
              step: '2',
              title: 'Pick Compression',
              desc: 'Select Low, Medium, or High depending on your target file size (e.g. High for under 200KB).'
            },
            {
              step: '3',
              title: 'Click Compress',
              desc: 'Hit the "Compress PDF Now" button and watch the instant local stream optimization occur.'
            },
            {
              step: '4',
              title: 'Save Document',
              desc: 'Check your saved percentage and download your newly optimized, lightweight PDF file immediately.'
            }
          ].map(({ step, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2 relative">
              <span class="inline-block px-2 py-0.5 text-xs font-extrabold text-purple-600 dark:text-purple-400 bg-purple-100 dark:bg-purple-950/80 rounded-md uppercase tracking-wider">
                Step {step}
              </span>
              <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 5: Technical Compression Architecture Breakdown -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          How PDF Compression Algorithms Work
        </h2>
        <p class="leading-relaxed">
          PDF (Portable Document Format) is a complex container format that stores text streams, font programs, raster bitmaps, vector curves, and cross-reference tables (XREFs). Understanding how our <strong>pdf compress online</strong> engine reduces size helps you achieve the best balance between quality and weight:
        </p>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-100 dark:bg-slate-800/80 text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800">
              <tr>
                <th class="p-3.5 font-bold">Optimization Technique</th>
                <th class="p-3.5 font-bold">How It Works</th>
                <th class="p-3.5 font-bold text-purple-600 dark:text-purple-400">Impact on File Size</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
              <tr>
                <td class="p-3.5 font-semibold text-slate-900 dark:text-white">Object Stream Consolidation</td>
                <td class="p-3.5">Groups individual PDF dictionary objects into unified compressed Flate streams.</td>
                <td class="p-3.5">Reduces structural file overhead by 15% – 30%.</td>
              </tr>
              <tr>
                <td class="p-3.5 font-semibold text-slate-900 dark:text-white">Flate / Deflate Stream Compression</td>
                <td class="p-3.5">Applies zlib LZ77 and Huffman coding to raw content descriptions and vector coordinate arrays.</td>
                <td class="p-3.5">Reduces text-heavy streams by up to 50%.</td>
              </tr>
              <tr>
                <td class="p-3.5 font-semibold text-slate-900 dark:text-white">Orphaned Object & Metadata Pruning</td>
                <td class="p-3.5">Removes revision history, unused XML XMP metadata, edit markers, and thumbnail caches.</td>
                <td class="p-3.5">Shaves 50 KB – 500 KB of useless digital residue.</td>
              </tr>
