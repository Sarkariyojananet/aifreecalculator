---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="PDF Merge - Combine PDF Files Online Free"
  description="Combine and merge multiple PDF documents into a single organized file in your browser securely without file uploads."
  category="Free Online Tools"
  calculatorName="PDF Merge"
  slug="pdf-merge"
  keywords={['pdf merge', 'merge pdf', 'combine pdf files', 'join pdf', 'pdf combiner']}
>
  <div class="py-8 text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl text-blue-600 dark:bg-blue-950/50 dark:text-blue-400 mb-4">
      📄
    </div>
    <h2 class="text-xl font-bold text-slate-900 dark:text-white">
      PDF Merge
    </h2>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto">
      Combine multiple PDF files into a single organized document right in your browser.
    </p>
  </div>
</CalculatorLayout>
