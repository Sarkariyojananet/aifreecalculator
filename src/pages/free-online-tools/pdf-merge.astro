---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

// ─── FAQ Data & Schema ────────────────────────────────────────────────────────
const faqs = [
  {
    question: "What is a PDF Merge tool?",
    answer: "A PDF Merge tool combines two or more separate PDF files into a single PDF document. This tool does all of that processing directly in your browser — no file upload to a server is required."
  },
  {
    question: "Can I merge PDF files online?",
    answer: "Yes. This is a browser-based pdf merge online tool. Select your files, arrange their order, click Merge PDFs, and download the result. Everything runs client-side, so you do not need to upload your documents anywhere."
  },
  {
    question: "Is this PDF Merge tool free?",
    answer: "Yes. This pdf merge free utility is available to use at no cost and requires no account or subscription. You can merge PDFs directly from your browser without any registration."
  },
  {
    question: "Can I merge two PDF files into one?",
    answer: "Yes. Add two PDF files using the file picker or drag and drop, then click Merge PDFs. The tool will combine them into a single downloadable PDF document."
  },
  {
    question: "Can I change the order of PDF files before merging?",
    answer: "Yes. After adding your files, use the Move Up and Move Down buttons on each row to arrange them in the order you want. The final merged PDF will follow that order exactly."
  },
  {
    question: "Are my PDF files uploaded to a server?",
    answer: "No. Your PDF files are processed entirely within your browser using client-side JavaScript and the pdf-lib library. The files are read into your browser's memory only and are never transmitted to any server."
  },
  {
    question: "Can I merge large PDF files?",
    answer: "This tool can handle moderately large PDF files depending on the available memory in your browser and device. Very large files (for example, hundreds of megabytes combined) may slow down the merge process or trigger a browser memory warning. If that happens, try merging fewer files at a time."
  },
  {
    question: "Can I merge password-protected PDFs?",
    answer: "No. Password-protected or encrypted PDF files cannot be processed by this tool. The PDF library requires the full document to be accessible. Remove the password protection from your PDFs before attempting to merge them."
  },
  {
    question: "Does PDF merging reduce the quality of my documents?",
    answer: "No. This tool copies PDF pages directly without rasterizing or re-encoding the content. Text, vector graphics, and embedded images are preserved as they appear in the original documents."
  },
  {
    question: "Can I download the merged PDF?",
    answer: "Yes. After the merge completes, a Download Merged PDF button appears. Clicking it saves the combined PDF file directly to your device. No automatic download happens without your action."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "PDF Merge",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free browser-based PDF Merge tool. Combine multiple PDF files into one document, reorder pages, and download the result — all client-side with no file uploads."
};
---

<CalculatorLayout
  title="PDF Merge - Merge PDF Files Online Free"
  description="Merge PDF files online for free with a browser-based PDF Merge tool. Combine multiple PDFs into one document, reorder files, and download the merged PDF instantly."
  category="Free Online Tools"
  calculatorName="PDF Merge"
  slug="pdf-merge"
  keywords={[
    'pdf merge',
    'pdf merge online',
    'merge pdf files',
    'pdf to pdf merge',
    'combine pdf',
    'pdf merge free',
    'join pdf online',
    'merge pdf free'
  ]}
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- pdf-lib loaded from CDN — only on this page -->
  <script is:inline>
    (function() {
      var s = document.createElement('script');
      s.src = 'https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js';
      s.crossOrigin = 'anonymous';
      s.onload = function() {
        // Tool script initialises itself after pdf-lib is available
        var ts = document.createElement('script');
        ts.src = '/js/tools/pdf-merge.js';
        document.body.appendChild(ts);
      };
      s.onerror = function() {
        // Fallback: load tool script anyway — it will show a helpful error on merge click
        var ts = document.createElement('script');
        ts.src = '/js/tools/pdf-merge.js';
        document.body.appendChild(ts);
      };
      document.head.appendChild(s);
    })();
  </script>

  <!-- ═══════════════════════════════════════════════════════════════════════
       MAIN TOOL WIDGET
  ════════════════════════════════════════════════════════════════════════════ -->
  <div class="space-y-5">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/80 text-red-700 dark:text-red-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>100% Browser-Based • No File Uploads • Free</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        PDF Merge
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Merge multiple PDF files into one PDF directly in your browser. Add your files, arrange their order, and download the combined document — no upload required.
      </p>

      <!-- Privacy Banner -->
      <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2 rounded-xl text-left">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>Your PDF files are processed locally in your browser. Files are not uploaded to our server.</strong></span>
      </div>
    </div>

    <!-- Error Box -->
    <div
      id="pm-error-box"
      class="hidden rounded-xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm font-medium text-red-700 dark:text-red-400 items-start gap-2.5"
      role="alert"
      aria-live="assertive"
    >
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="pm-error-text"></span>
    </div>

    <!-- ── DRAG & DROP ZONE ──────────────────────────────────────────────── -->
    <div
      id="pm-drop-zone"
      tabindex="0"
      role="button"
      aria-label="Drop PDF files here or click to choose files"
      class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-red-400 dark:hover:border-red-600 hover:bg-red-50/40 dark:hover:bg-red-950/20 focus:outline-none focus:ring-4 focus:ring-red-500/20 focus:border-red-500"
    >
      <!-- Hidden file input -->
      <input
        type="file"
        id="pm-file-input"
        accept=".pdf,application/pdf"
        multiple
        class="sr-only"
        aria-label="Select PDF files to merge"
        tabindex="-1"
      />

      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 dark:bg-red-950/60 text-4xl transition group-hover:scale-105">
        📄
      </div>

      <div class="space-y-1">
        <p class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
          Drop PDF files here
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          or use the button below to browse your files
        </p>
      </div>

      <button
        type="button"
        id="pm-select-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
        aria-label="Choose PDF files from your device"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Choose PDF Files
      </button>

      <p class="text-xs text-slate-400 dark:text-slate-500 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Select multiple files at once · PDF files only · Processed in your browser
      </p>
    </div>

    <!-- ── FILE LIST SECTION ─────────────────────────────────────────────── -->
    <div id="pm-file-list-section" class="hidden space-y-3">

      <!-- Header -->
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
          <svg class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Your PDF Files
        </h2>
        <button
          type="button"
          id="pm-add-more-btn"
          onclick="document.getElementById('pm-file-input').click()"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-slate-400"
          aria-label="Add more PDF files"
        >
          + Add More Files
        </button>
      </div>

      <!-- File Rows -->
      <div
        id="pm-file-list"
        class="space-y-2"
        role="list"
        aria-label="PDF files queued for merging"
        aria-live="polite"
      ></div>

      <!-- Summary & Warning -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500 dark:text-slate-400 pt-1">
        <span>Total PDFs: <strong id="pm-total-count" class="text-slate-800 dark:text-slate-200">0</strong></span>
        <span>Total size: <strong id="pm-total-size" class="text-slate-800 dark:text-slate-200">0 B</strong></span>
      </div>

      <p id="pm-min-warning" class="hidden text-xs font-medium text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 rounded-lg px-3 py-2" role="status" aria-live="polite"></p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-2 sm:gap-3 pt-2">
        <button
          type="button"
          id="pm-merge-btn"
          disabled
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:scale-100 px-6 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
          aria-label="Merge all PDF files"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
          Merge PDFs
        </button>
        <button
          type="button"
          id="pm-clear-btn"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-slate-400"
          aria-label="Remove all files and reset"
        >
          Clear All
        </button>
      </div>
    </div>

    <!-- ── STATUS / PROGRESS ─────────────────────────────────────────────── -->
    <div
      id="pm-status-section"
      class="hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <div class="flex items-start gap-3">
        <span id="pm-status-icon" class="text-2xl shrink-0 leading-none mt-0.5"></span>
        <div class="space-y-1 min-w-0">
          <p id="pm-status-title" class="text-sm font-bold text-slate-900 dark:text-white"></p>
          <div id="pm-status-body" class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed"></div>
        </div>
      </div>
    </div>

    <!-- ── DOWNLOAD SECTION ──────────────────────────────────────────────── -->
    <div id="pm-download-section" class="hidden rounded-2xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50 dark:bg-emerald-950/30 p-4 sm:p-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white text-lg">
            ✅
          </div>
          <div>
            <p class="text-sm font-bold text-emerald-900 dark:text-emerald-200">Merge complete</p>
            <p class="text-xs text-emerald-700 dark:text-emerald-400">Your merged PDF is ready to download.</p>
          </div>
        </div>
        <a
          id="pm-download-btn"
          href="#"
          download="merged.pdf"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 px-5 py-2.5 text-sm font-bold text-white shadow transition cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 no-underline"
          aria-label="Download the merged PDF file"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Merged PDF
        </a>
      </div>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SEO CONTENT SLOT
  ════════════════════════════════════════════════════════════════════════════ -->
  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300 not-prose">

      <!-- SECTION 1 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          PDF Merge Online
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          This <strong>PDF merge online</strong> tool lets you combine multiple PDF documents into a single file without leaving your browser. There is nothing to install and no account required. Simply select your PDF files, choose their order, and download the merged result. Because the entire process happens client-side, your documents stay on your device.
        </p>
        <p class="leading-relaxed">
          The tool is available as a <strong>pdf merge free</strong> utility — you can use it as many times as you need for personal or professional documents. Whether you are combining scanned pages, joining reports, or consolidating project files, the process takes only a few clicks.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-red-100 dark:bg-red-950/60 text-red-600 dark:text-red-400 flex items-center justify-center text-base">🔒</div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Files Stay Private</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">PDFs are read directly in your browser's memory and are never transmitted to any server.</p>
          </div>
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-base">📋</div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Reorder Before Merging</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Move files up or down in the list so the merged PDF comes out in exactly the order you need.</p>
          </div>
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">⚡</div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">No Quality Loss</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Pages are copied directly — text, graphics, and embedded images remain unchanged.</p>
          </div>
        </div>
      </section>

      <!-- SECTION 2 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          How to Merge PDF Files
        </h2>
        <p class="leading-relaxed">
          Combining PDFs with this tool is straightforward. Follow these steps:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          {[
            { step: '1', title: 'Select or Drop Files', desc: 'Click "Choose PDF Files" or drag your PDFs into the upload area. You can add multiple files at once.' },
            { step: '2', title: 'Review the File List', desc: 'Each added PDF appears in the list with its filename and size.' },
            { step: '3', title: 'Arrange the Order', desc: 'Use the ↑ and ↓ buttons to reorder files. The merged PDF will follow this sequence.' },
            { step: '4', title: 'Click Merge PDFs', desc: 'Press the Merge PDFs button. The browser combines the documents in your chosen order.' },
            { step: '5', title: 'Download the Result', desc: 'Once complete, click Download Merged PDF to save the combined file to your device.' },
          ].map(({ step, title, desc }) => (
            <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-1">
              <span class="text-xs font-bold text-red-600 dark:text-red-400 uppercase tracking-wider">Step {step}</span>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">{title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION 3 -->
      <section class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          PDF to PDF Merge
        </h2>
        <p class="leading-relaxed">
          A <strong>pdf to pdf merge</strong> operation takes multiple existing PDF files and assembles them into one cohesive document. Unlike converting other formats to PDF, this process works entirely within the PDF format — each source file contributes its pages to the new combined document in the order you specify.
        </p>
        <p class="leading-relaxed">
          This tool uses the open-source <em>pdf-lib</em> library to copy pages from each source document into a freshly created PDF. The page dimensions and content of each original file are preserved in the output. A <strong>pdf to pdf merge</strong> in this sense is additive: the merged file contains all the pages from all source files, nothing is removed or re-encoded.
        </p>
      </section>

      <!-- SECTION 4 -->
      <section class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Free PDF Merge Tool
        </h2>
        <p class="leading-relaxed">
          This <strong>pdf merge free</strong> tool runs entirely in your browser with no subscription or sign-up required. You can merge PDF files for personal documents, work reports, academic assignments, or any other purpose at no charge.
        </p>
        <p class="leading-relaxed">
          Because the tool is browser-based, there are practical limits tied to your device's available memory rather than any artificial restriction imposed by the service. For most everyday documents, the tool works quickly and without issues. Very large combined file sets may require more processing time.
        </p>
      </section>

      <!-- SECTION 5 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Why Merge PDF Files?
        </h2>
        <p class="leading-relaxed">
          There are many practical reasons to combine separate PDF documents into one:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {[
            { icon: '📊', title: 'Combining Reports', desc: 'Merge monthly or quarterly reports into a single annual document for easier distribution.' },
            { icon: '📑', title: 'Joining Scanned Documents', desc: 'Combine scanned pages from a physical document that were saved as separate files.' },
            { icon: '🧾', title: 'Merging Invoices', desc: 'Compile individual invoice PDFs into one file for accounting records or client submissions.' },
            { icon: '📁', title: 'Organizing Project Files', desc: 'Consolidate specifications, drawings, and supporting documents into a single project PDF.' },
            { icon: '🎓', title: 'Academic Submissions', desc: 'Combine research sections, bibliographies, and appendices before submitting an assignment.' },
            { icon: '📬', title: 'Document Preparation', desc: 'Assemble cover letters, resumes, and certificates into one file for job applications.' },
          ].map(({ icon, title, desc }) => (
            <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-1.5 shadow-xs">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="text-base" aria-hidden="true">{icon}</span>
                {title}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION 6 -->
      <section class="space-y-3">
