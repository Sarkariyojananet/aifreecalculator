---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";

// FAQ Schema data for search engine rich results
const faqs = [
  {
    question: "How to make a 4 photo collage on A4 paper?",
    answer:
      "To make a 4 photo collage on A4 paper: (1) Select 'A4 Portrait (210×297mm)' from the Canvas dropdown, (2) Choose '4 Photos: 2×2 Symmetrical Grid' under Grid Layout, (3) Upload your 4 photos into the container slots, (4) Fine-tune zoom and framing using the inline adjust panel, and (5) Click 'Download Print-Ready PDF' or 'Download JPG' for crisp 300 DPI printing.",
  },
  {
    question: "Is this A4 photo collage generator online really free?",
    answer:
      "Yes. Our A4 photo collage generator online is 100% free with no watermarks, no account registration, and no daily download limits. You can generate unlimited collages in A4, Legal, Letter, or Instagram formats.",
  },
  {
    question: "Can I use this as a legal size collage maker online free?",
    answer:
      "Yes. Select 'US Legal (8.5×14in)' from the Paper Size dropdown. The generator renders a high-definition 2550×4200 pixel canvas calibrated at 300 DPI, ideal for official document photos, legal portfolios, or elongated multi-picture arrangements.",
  },
  {
    question: "How does the multiple photo collage printable sheet creator ensure sharp print quality?",
    answer:
      "Unlike basic collage makers that render at low 72 DPI screen resolution, our printable sheet creator processes full 300 DPI rasterization (2480×3508 px for A4 and 2550×4200 px for Legal) and exports native vector-embedded PDFs via jsPDF, preventing blurriness or pixelation when printed.",
  },
  {
    question: "Can I print multiple passport-size photos on a single A4 sheet?",
    answer:
      "Yes. Select 'A4 Portrait' from the canvas size dropdown, choose the '8 Photos: 4 Rows × 2 Columns' or '6 Photos' symmetrical grid layout, upload your photo, and click 'Auto-Fill All' to arrange identical passport or visa photos ready for printing.",
  },
  {
    question: "Can I add header text, names, and crop marks for cutting?",
    answer:
      "Yes. In the Spacing & Title panel, enter your desired Header Text (such as applicant name, event title, or date), customize font size, color, bold, underline, italic, and alignment. Check 'Crop Marks (trim guides)' to automatically render precision corner cutting ticks for physical scissor or trimmer cutting.",
  },
  {
    question: "Are my uploaded photos sent to any server?",
    answer:
      "No. Your photos are never uploaded to any remote server or cloud service. The entire collage layout generation, image rendering, and PDF compilation take place 100% locally inside your browser using HTML5 Canvas and client-side JavaScript.",
  },
];


---

<CalculatorLayout
  layoutVariant="workspace"
  title="Free Online Photo Collage Maker A4 Size - Printable Sheet Creator"
  description="Free online photo collage maker A4 size & legal size printable sheet generator. Learn how to make a 4 photo collage on A4 paper at 300 DPI for free."
  category="Free Online Tools"
  calculatorName="Photo Collage Maker"
  slug="photo-collage-maker"
  keywords={[
    "Free Online Photo Collage Maker A4 size",
    "A4 Photo collage generator online",
    "How to make a 4 photo collage on A4 paper",
    "Legal size collage maker online free",
    "Multiple photo collage printable sheet creator",
    "photo collage maker",
    "a4 photo collage",
    "print layout generator",
    "photo grid maker",
    "300 dpi photo collage",
    "passport photo grid a4",
    "collage with text",
    "crop marks trim guides",
    "free collage maker",
  ]}
>
  <!-- Injected Structured Data Schemas -->

  <!-- MAIN PHOTO COLLAGE STUDIO WIDGET -->
  <div class="space-y-6">
    <!-- Privacy & Security Guarantee Banner -->
    <div
      class="flex items-center justify-between rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-950/30 dark:text-emerald-300"
    >
      <div class="flex items-center gap-3">
        <div
          class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold"
        >
          🛡️
        </div>
        <div>
          <span class="font-bold">100% Client-Side Privacy:</span>
          Your photos are processed directly inside your browser. No files are ever
          uploaded to any cloud server.
        </div>
      </div>
      <div
        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 text-[11px] font-semibold"
      >
        <span>🖨️ 300 DPI Print Ready</span>
      </div>
    </div>

    <!-- ================= 3 COLUMNS IN PC VIEW (USKE NICHE OUTPUT) ================= -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-start">
      <!-- COLUMN 1: Paper Size & Layout -->
      <div
        class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3"
        >
          <h2
            class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2"
          >
            <span>📐</span> 1. Canvas & Layout
          </h2>
          <span class="text-[11px] text-slate-400 font-medium">Presets</span>
        </div>

        <div class="space-y-3.5 text-xs">
          <!-- Paper Size -->
          <div>
            <label
              for="preset-size-select"
              class="block font-bold text-slate-800 dark:text-slate-200 mb-1.5"
            >
              Paper Size
            </label>
            <select
              id="preset-size-select"
              class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-800 shadow-2xs focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
            >
              <optgroup label="🖨️ High-Res Print (300 DPI)">
                <option value="a4-p" selected>A4 (210×297 mm)</option>
                <option value="a4-l">A4 Landscape (297×210 mm)</option>
                <option value="legal-p">Legal (8.5×14 in)</option>
                <option value="legal-l">Legal Landscape (14×8.5 in)</option>
                <option value="letter-p">Letter (8.5×11 in)</option>
                <option value="letter-l">Letter Landscape (11×8.5 in)</option>
                <option value="4x6-p">4 × 6 Photo Print</option>
                <option value="4x6-l">6 × 4 Photo Print</option>
              </optgroup>
              <optgroup label="📱 Social Media Presets">
                <option value="insta-square">Instagram Square 1:1</option>
                <option value="insta-portrait">Instagram Portrait 4:5</option>
                <option value="insta-story">Story / Reel / TikTok</option>
                <option value="fb-post">Facebook Post</option>
                <option value="fb-cover">Facebook Cover</option>
                <option value="x-header">Twitter / X Header</option>
              </optgroup>
            </select>
          </div>

          <!-- Layout Dropdown -->
          <div>
            <label
              for="layout-select-dropdown"
              class="block font-bold text-slate-800 dark:text-slate-200 mb-1.5"
            >
              Layout Grid
            </label>
            <select
              id="layout-select-dropdown"
              class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-800 shadow-2xs focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
            >
              <optgroup label="2 Photos">
                <option value="2-vert">2 Photos (1×2 side by side)</option>
                <option value="2-horiz">2 Photos (2×1 stacked)</option>
              </optgroup>
              <optgroup label="3 Photos">
                <option value="3-top-split">3 Photos (1 top, 2 bottom)</option>
                <option value="3-left-split">3 Photos (1 left, 2 right)</option>
                <option value="3-triptych">3 Photos (3 vertical strips)</option>
              </optgroup>
              <optgroup label="4 Photos">
                <option value="4-grid" selected>4 Photos (2×2 grid)</option>
                <option value="4-hero-sidebar"
                  >4 Photos (1 hero, 3 stacked)</option
                >
                <option value="4-masonry">4 Photos (masonry)</option>
              </optgroup>
              <optgroup label="6 Photos">
                <option value="6-grid-3x2">6 Photos (3×2 grid)</option>
                <option value="6-grid-2x3">6 Photos (2×3 grid)</option>
                <option value="6-hero-center">6 Photos (center mosaic)</option>
              </optgroup>
              <optgroup label="8 Photos (Print / Passport)">
                <option value="8-grid-4x2">8 Photos (4×2 passport grid)</option>
                <option value="8-grid-2x4">8 Photos (2×4 grid)</option>
                <option value="8-scrapbook">8 Photos (scrapbook)</option>
              </optgroup>
            </select>
          </div>

          <!-- Photo Fit Dropdown -->
          <div>
            <label
              for="global-fit-select"
              class="block font-bold text-slate-800 dark:text-slate-200 mb-1.5"
            >
              Photo Fit Mode
            </label>
            <select
              id="global-fit-select"
              class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-800 shadow-2xs focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
            >
              <option value="contain" selected>Fit (full photo, no crop)</option
              >
              <option value="cover">Fill (cover frame completely)</option>
            </select>
          </div>

          <!-- Print / DPI Info Box -->
          <div
            class="rounded-2xl border border-blue-100 bg-blue-50/60 p-3 text-[11px] text-blue-900 dark:border-blue-900/40 dark:bg-blue-950/30 dark:text-blue-300 space-y-1"
          >
            <div class="font-bold flex items-center gap-1.5">
              <span>💡</span> Print Tip:
            </div>
            <p class="leading-relaxed">
              Standard A4 & Legal sheets render at 300 DPI for ultra-sharp photo
              lab & laser printing.
            </p>
          </div>
        </div>
      </div>

      <!-- COLUMN 2: Spacing, Borders, Crop Marks & Header Text / Person Name -->
      <div
        class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3"
        >
          <h2
            class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2"
          >
            <span>🎨</span> 2. Borders & Title
          </h2>
          <span class="text-[11px] text-slate-400 font-medium">Style</span>
        </div>

        <div class="space-y-3 text-xs">
          <!-- Borders & Dimensions in mm -->
          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label
                for="border-style-select"
                class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1"
              >
                Border Style
              </label>
              <select
                id="border-style-select"
                class="w-full rounded-xl border border-slate-300 bg-white px-2 py-1.5 text-xs font-medium text-slate-800 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
              >
                <option value="thin-black" selected>Thin Black</option>
                <option value="thick-black">Thick Black</option>
                <option value="thin-white">Thin White</option>
                <option value="elegant-grey">Grey</option>
                <option value="none">None</option>
              </select>
            </div>

            <div>
              <label
                for="input-border-width-mm"
                class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1"
              >
                Width (mm)
              </label>
              <input
                type="number"
                id="input-border-width-mm"
                min="0"
                max="25"
                step="0.5"
                value="1.5"
                class="w-full rounded-xl border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
              />
            </div>

            <div>
              <label
                for="input-gap-mm"
                class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1"
              >
                Gap (mm)
              </label>
              <input
                type="number"
                id="input-gap-mm"
                min="0"
                max="40"
                step="0.5"
                value="5"
                class="w-full rounded-xl border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
              />
            </div>

            <div>
              <label
                for="input-page-margin-mm"
                class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1"
              >
                Margin (mm)
              </label>
              <input
                type="number"
                id="input-page-margin-mm"
                min="0"
                max="50"
                step="0.5"
                value="10"
                class="w-full rounded-xl border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
              />
            </div>

            <div>
              <label
                for="input-rounded-corners-mm"
                class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1"
              >
                Corners (mm)
              </label>
              <input
                type="number"
                id="input-rounded-corners-mm"
                min="0"
                max="30"
                step="0.5"
                value="0"
                class="w-full rounded-xl border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
              />
            </div>

            <!-- Crop Marks Checkbox -->
            <div class="flex items-center gap-1.5 pt-4">
              <input
                type="checkbox"
                id="check-crop-marks"
                class="w-4 h-4 rounded accent-blue-600 cursor-pointer"
              />
              <label
                for="check-crop-marks"
                class="text-[11px] font-semibold text-slate-800 dark:text-slate-200 cursor-pointer"
              >
                Crop Marks (trim)
              </label>
            </div>
          </div>

          <!-- Header Text / Person Name (optional) -->
          <div
            class="pt-2.5 border-t border-slate-100 dark:border-slate-800 space-y-2"
          >
            <div>
              <label
                for="input-header-text"
                class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1"
              >
                Header Text / Person Name (optional)
              </label>
              <input
                type="text"
                id="input-header-text"
                placeholder="e.g. Sachin Jangra / Passport Photos"
                class="w-full rounded-xl border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-800 placeholder-slate-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
              />
            </div>

            <div class="grid grid-cols-12 gap-2 items-center">
              <div class="col-span-4">
                <label
                  for="input-header-size-pt"
                  class="block text-[10px] font-semibold text-slate-500 mb-0.5"
                  >Size (pt)</label
                >
                <input
                  type="number"
                  id="input-header-size-pt"
                  min="8"
                  max="60"
                  value="14"
                  class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                />
              </div>
              <div class="col-span-3 text-center">
                <label
                  class="block text-[10px] font-semibold text-slate-500 mb-0.5"
                  >Color</label
                >
                <input
                  type="color"
                  id="input-header-color"
                  value="#1e293b"
                  class="w-full h-7 rounded-lg border border-slate-300 cursor-pointer"
                />
              </div>
              <div class="col-span-5">
                <label
                  for="select-header-align"
                  class="block text-[10px] font-semibold text-slate-500 mb-0.5"
                  >Align</label
                >
                <select
                  id="select-header-align"
                  class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
                >
                  <option value="center" selected>Center</option>
                  <option value="left">Left</option>
                  <option value="right">Right</option>
                </select>
              </div>
            </div>

            <div
              class="flex items-center gap-3 text-xs font-semibold text-slate-700 dark:text-slate-300 pt-0.5"
            >
              <label class="flex items-center gap-1 cursor-pointer">
                <input
                  type="checkbox"
                  id="check-header-bold"
                  checked
                  class="w-3.5 h-3.5 rounded accent-blue-600"
                />
                <span>Bold</span>
              </label>
              <label class="flex items-center gap-1 cursor-pointer">
                <input
                  type="checkbox"
                  id="check-header-underline"
                  class="w-3.5 h-3.5 rounded accent-blue-600"
                />
                <span>Underline</span>
              </label>
              <label class="flex items-center gap-1 cursor-pointer">
                <input
                  type="checkbox"
                  id="check-header-italic"
                  class="w-3.5 h-3.5 rounded accent-blue-600"
                />
                <span>Italic</span>
              </label>
            </div>
          </div>

          <!-- Background Color & Elevation Shadow -->
          <div
            class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs"
          >
            <div class="flex items-center gap-2">
              <span class="font-semibold text-slate-700 dark:text-slate-300"
                >Background:</span
              >
              <input
                type="color"
                id="color-bg"
                value="#ffffff"
                class="w-6 h-6 rounded-md border border-slate-300 cursor-pointer"
              />
              <label class="flex items-center gap-1 text-[11px] font-medium text-slate-600 dark:text-slate-400 cursor-pointer ml-1">
                <input type="checkbox" id="check-bg-transparent" class="w-3.5 h-3.5 rounded accent-blue-600" />
                <span>Transparent</span>
              </label>
            </div>
            <label
              class="flex items-center gap-1.5 text-slate-700 dark:text-slate-300 cursor-pointer"
            >
              <input
                type="checkbox"
                id="toggle-shadow"
                class="w-3.5 h-3.5 rounded accent-blue-600"
              />
              <span class="text-[11px] font-medium">Elevation Shadow</span>
            </label>
          </div>
        </div>
      </div>

      <!-- COLUMN 3: Photo Containers (Slots with ✏️ Edit and ✕ Delete) -->
      <div
        class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3"
      >
        <div
          class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3"
        >
          <div>
            <h2
              class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2"
            >
              <span>🖼️</span> 3. Photo Containers
            </h2>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
              Click slot to upload. Click ✏️ to edit or ✕ to remove.
            </p>
          </div>
        </div>

        <!-- DYNAMIC SLOTS CONTAINER (Jitni photo utne containers) -->
        <div
          id="photo-slots-container"
          class="grid grid-cols-2 gap-3 max-h-130 overflow-y-auto pr-1"
        >
          <!-- Populated dynamically via JavaScript -->
        </div>
      </div>
    </div>

    <!-- ================= INLINE PHOTO ADJUSTMENT PANEL (NO POPUP) ================= -->
    <div
      id="inline-adjust-panel"
      class="rounded-3xl border border-blue-200/90 bg-blue-50/60 p-5 shadow-xs dark:border-blue-900/40 dark:bg-slate-900 space-y-3.5 transition-all"
    >
      <div class="flex items-center justify-between">
        <h3
          id="inline-adjust-title"
          class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2"
        >
          <span>🎯</span> Adjust Photo 1
        </h3>
        <div class="flex items-center gap-2">
          <span
            id="inline-adjust-status"
            class="text-[11px] text-blue-600 dark:text-blue-400 font-semibold bg-blue-100/70 dark:bg-blue-950 px-2.5 py-0.5 rounded-full"
          >
            Active Selection
          </span>
        </div>
      </div>

      <div class="flex flex-wrap items-end gap-x-6 gap-y-3 text-xs">
        <!-- Zoom (%) -->
        <div class="w-36">
          <label
            for="inline-slot-zoom"
            class="block font-bold text-slate-800 dark:text-slate-200 mb-1"
          >
            Zoom (%)
          </label>
          <input
            type="range"
            id="inline-slot-zoom"
            min="0.2"
            max="3"
            step="0.05"
            value="1"
            class="w-full accent-blue-600 cursor-pointer"
          />
          <div
            id="inline-slot-zoom-val"
            class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 mt-0.5"
          >
            100%
          </div>
        </div>

        <!-- Rotate (°) -->
        <div class="w-36">
          <label
            for="inline-slot-rotate"
            class="block font-bold text-slate-800 dark:text-slate-200 mb-1"
          >
            Rotate (°)
          </label>
          <input
            type="range"
            id="inline-slot-rotate"
            min="-180"
            max="180"
            step="5"
            value="0"
            class="w-full accent-blue-600 cursor-pointer"
          />
          <div
            id="inline-slot-rotate-val"
            class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 mt-0.5"
          >
            0°
          </div>
        </div>

        <!-- Move X -->
        <div class="w-36">
          <label
            for="inline-slot-panx"
            class="block font-bold text-slate-800 dark:text-slate-200 mb-1"
          >
            Move X
          </label>
          <input
            type="range"
            id="inline-slot-panx"
            min="-300"
            max="300"
            step="5"
            value="0"
            class="w-full accent-blue-600 cursor-pointer"
          />
          <div
            id="inline-slot-panx-val"
            class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 mt-0.5"
          >
            0
          </div>
        </div>

        <!-- Move Y -->
        <div class="w-36">
          <label
            for="inline-slot-pany"
            class="block font-bold text-slate-800 dark:text-slate-200 mb-1"
          >
            Move Y
          </label>
          <input
            type="range"
            id="inline-slot-pany"
            min="-300"
            max="300"
            step="5"
            value="0"
            class="w-full accent-blue-600 cursor-pointer"
          />
          <div
            id="inline-slot-pany-val"
            class="text-[11px] font-semibold text-slate-600 dark:text-slate-400 mt-0.5"
          >
            0
          </div>
        </div>

        <!-- Reset Adjust Button -->
        <div class="pb-1">
          <button
            type="button"
            id="inline-btn-reset-adjust"
            class="px-4 py-2 rounded-xl border border-slate-300 bg-white font-bold text-slate-700 shadow-2xs hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
          >
            Reset Adjust
          </button>
        </div>

