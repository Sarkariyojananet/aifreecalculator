---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import AdSlotTop from '../components/ads/AdSlotTop.astro';
import AdSlotInline from '../components/ads/AdSlotInline.astro';
import AdSlotFooter from '../components/ads/AdSlotFooter.astro';
import { getCalculatorsByCategory } from '../data/calculators';
import { getCalculatorOverrides } from '../lib/admin/content-store';
import { getLivePageMeta } from '../lib/seo/page-metadata';

const financeCalculators = getCalculatorsByCategory('Finance');
const overrides = await getCalculatorOverrides(Astro.locals);
const override = overrides['category:finance'] || {};
const liveMeta = getLivePageMeta('category:finance');

const effectiveTitle = override.metaTitle || liveMeta.title;
const effectiveDescription = override.metaDescription || liveMeta.description;
const effectiveCanonical = override.canonicalUrl;
const effectiveRobots = override.robots;
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
  noindex={effectiveRobots?.includes('noindex')}
  ogImage="/og/finance.png"
>
  <section class="border-b border-slate-200 bg-white px-4 py-12 dark:border-slate-800 dark:bg-slate-900/60 sm:py-16">
    <div class="mx-auto max-w-7xl">
      <div class="flex items-center gap-2 text-xs text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider mb-2">
        <span>💰</span> FINANCIAL PLANNING SUITE
      </div>
      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Finance, Loans & Tax Calculators
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        Empowering you with smart decision-making tools for loans, mortgage, wealth investments, taxes, and salary optimizations.
      </p>
    </div>
  </section>

  <!-- Top Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotTop />
  </div>

  <section class="px-4 py-10">
    <div class="mx-auto max-w-7xl space-y-6">
      <CategoryTabs activeCategory="finance" />

      <!-- First 6 Calculators -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {financeCalculators.slice(0, 6).map((calc) => (
          <CalculatorCard calculator={calc} />
        ))}
      </div>

      <!-- Middle Ad Slot -->
      <div class="py-2">
        <AdSlotInline />
      </div>

      <!-- Remaining Calculators (if any) -->
      {financeCalculators.length > 6 && (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {financeCalculators.slice(6).map((calc) => (
            <CalculatorCard calculator={calc} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Financial Calculation Guidance & Educational Section -->
  <section class="border-t border-slate-200 bg-white px-4 py-12 dark:border-slate-800 dark:bg-slate-900/60 sm:py-16">
    <div class="mx-auto max-w-7xl space-y-10">
      <div class="max-w-3xl space-y-3">
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">
          Core Financial Calculation Frameworks
        </h2>
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          Making informed personal finance decisions requires understanding how interest, compounding, and repayment schedules work mathematically. Below is an overview of the foundational models used across our financial tools.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">📊</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Reducing-Balance Amortization</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Most home loans, personal loans, and vehicle financing follow a reducing-balance method. Each Equated Monthly Installment (EMI) consists of an interest portion and a principal portion. In the early stages of a loan, interest comprises the majority of each payment; as the outstanding principal decreases, the principal component increases exponentially.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">📈</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Compounding & Time Value of Money</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Systematic Investment Plans (SIP) and compound interest tools utilize periodic reinvestment of earnings. Because compounding accelerates geometrically over long horizons, small incremental contributions made early in an investment lifecycle generate significantly larger wealth multiples than larger lump sums invested later.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/50 space-y-3">
          <div class="text-2xl">📉</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Inflation-Adjusted Real Returns</h3>
          <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            Nominal returns can create an illusion of rapid growth. To calculate genuine purchasing power growth, investors evaluate real returns using the formula: <span class="font-mono text-slate-800 dark:text-slate-200">Real Rate = ((1 + Nominal) / (1 + Inflation)) - 1</span>. Always evaluate your retirement corpus and long-term savings against expected annual inflation rates.
          </p>
        </div>
      </div>

      <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-6 dark:border-amber-900/40 dark:bg-amber-950/20 text-xs leading-relaxed text-slate-700 dark:text-slate-300 space-y-2">
        <div class="font-bold text-amber-900 dark:text-amber-300 flex items-center gap-2">
          <span>⚠️</span> Important Financial Disclaimer
        </div>
        <p>
          Calculations provided across our financial tools are for informational and planning purposes only. They use standard mathematical formulas and statutory tax slabs as published by authoritative regulatory bodies. Actual loan terms, processing fees, interest recalculations, and tax obligations vary by lending institution, jurisdiction, and individual circumstances. Consult a certified financial planner or chartered accountant before executing major borrowing or investment commitments.
        </p>
      </div>
    </div>
  </section>

  <!-- Bottom Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotFooter />
  </div>
</BaseLayout>
