<!-- Client-Side Calculation Engine & PDF Export Script -->
<script>
  import {
    calculateDailyCalories,
    calculateMacros,
    cmToFtInches,
    ftInchesToCm,
    kgToPounds,
    poundsToKg,
    ACTIVITY_LEVEL_MAP,
    GOAL_MAP,
    MACRO_PRESETS,
    type Gender,
    type BmrFormula,
    type ActivityLevel,
    type CalorieGoal,
    type CalorieCalculationResult,
  } from '../../lib/calculators/calorie';

  let currentMode = 'daily_needs';
  let lastResultData: {
    result: CalorieCalculationResult;
    inputs: {
      genderDisplay: string;
      age: number;
      heightDisplay: string;
      weightDisplay: string;
      activityDisplay: string;
      formulaDisplay: string;
      goalDisplay: string;
    };
  } | null = null;

  // DOM Elements
  const modeButtons = document.querySelectorAll<HTMLButtonElement>('.mode-btn');
  const errorBox = document.getElementById('error-box')!;
  const resultsSection = document.getElementById('results-section')!;
  const btnCalculate = document.getElementById('btn-calculate-calories') as HTMLButtonElement;
  const btnClearAll = document.getElementById('btn-clear-all') as HTMLButtonElement;
  const btnDownloadPdf = document.getElementById('btn-download-pdf') as HTMLButtonElement;

  // Profile Form Elements
  const inpGender = document.getElementById('inp-gender') as HTMLSelectElement;
  const inpAge = document.getElementById('inp-age') as HTMLInputElement;
  const inpHeightUnit = document.getElementById('inp-height-unit') as HTMLSelectElement;
  const inpWeightUnit = document.getElementById('inp-weight-unit') as HTMLSelectElement;
  const inpHeightCm = document.getElementById('inp-height-cm') as HTMLInputElement;
  const inpHeightFt = document.getElementById('inp-height-ft') as HTMLInputElement;
  const inpHeightIn = document.getElementById('inp-height-in') as HTMLInputElement;
  const inpWeight = document.getElementById('inp-weight') as HTMLInputElement;
  const inpActivity = document.getElementById('inp-activity') as HTMLSelectElement;
  const inpFormula = document.getElementById('inp-formula') as HTMLSelectElement;
  const inpGoal = document.getElementById('inp-goal') as HTMLSelectElement;
  const hintActivityDesc = document.getElementById('hint-activity-desc')!;
  const lblWeightUnit = document.getElementById('lbl-weight-unit')!;

  const wrapperHeightCm = document.getElementById('wrapper-height-cm')!;
  const wrapperHeightFtin = document.getElementById('wrapper-height-ftin')!;
  const wrapperGoalSection = document.getElementById('wrapper-goal-section')!;

  // Result Output Elements
  const badgeGoalLabel = document.getElementById('badge-goal-label')!;
  const resHeroTargetCal = document.getElementById('res-hero-target-cal')!;
  const resHeroWeeklyCal = document.getElementById('res-hero-weekly-cal')!;
  const bannerCalorieWarning = document.getElementById('banner-calorie-warning')!;
  const resCardBmr = document.getElementById('res-card-bmr')!;
  const resCardTdee = document.getElementById('res-card-tdee')!;
  const resCardAdj = document.getElementById('res-card-adj')!;
  const resCardPaceHint = document.getElementById('res-card-pace-hint')!;
  const resCardTarget = document.getElementById('res-card-target')!;
  const resCardFormula = document.getElementById('res-card-formula')!;
  const tbodyGoalComparison = document.getElementById('tbody-goal-comparison')!;
  const txtCalcDetails = document.getElementById('txt-calc-details')!;

  // Macronutrient Elements
  const selMacroSplit = document.getElementById('sel-macro-split') as HTMLSelectElement;
  const wrapperCustomMacro = document.getElementById('wrapper-custom-macro')!;
  const inpCustomP = document.getElementById('inp-custom-p') as HTMLInputElement;
  const inpCustomC = document.getElementById('inp-custom-c') as HTMLInputElement;
  const inpCustomF = document.getElementById('inp-custom-f') as HTMLInputElement;
  const txtMacroPPct = document.getElementById('txt-macro-p-pct')!;
  const txtMacroPGrams = document.getElementById('txt-macro-p-grams')!;
  const txtMacroPCal = document.getElementById('txt-macro-p-cal')!;
  const txtMacroCPct = document.getElementById('txt-macro-c-pct')!;
  const txtMacroCGrams = document.getElementById('txt-macro-c-grams')!;
  const txtMacroCCal = document.getElementById('txt-macro-c-cal')!;
  const txtMacroFPct = document.getElementById('txt-macro-f-pct')!;
  const txtMacroFGrams = document.getElementById('txt-macro-f-grams')!;
  const txtMacroFCal = document.getElementById('txt-macro-f-cal')!;

  function invalidateResults() {
    resultsSection.classList.add('hidden');
    if (errorBox) {
      errorBox.classList.add('hidden');
      errorBox.textContent = '';
    }
    lastResultData = null;
  }

  function showError(msg: string) {
    if (!errorBox) return;
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Mode Switcher
  modeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-mode') || 'daily_needs';
      if (mode === currentMode) return;
      currentMode = mode;

      modeButtons.forEach((b) => {
        b.classList.remove(
          'active',
          'border-blue-600',
          'bg-blue-50',
          'text-blue-700',
          'dark:border-blue-500',
          'dark:bg-blue-950/60',
          'dark:text-blue-300'
        );
        b.classList.add(
          'border-slate-300',
          'bg-white',
          'text-slate-700',
          'dark:border-slate-700',
          'dark:bg-slate-800',
          'dark:text-slate-200'
        );
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add(
        'active',
        'border-blue-600',
        'bg-blue-50',
        'text-blue-700',
        'dark:border-blue-500',
        'dark:bg-blue-950/60',
        'dark:text-blue-300'
      );
      btn.classList.remove(
        'border-slate-300',
        'bg-white',
        'text-slate-700',
        'dark:border-slate-700',
        'dark:bg-slate-800',
        'dark:text-slate-200'
      );
      btn.setAttribute('aria-selected', 'true');

      if (currentMode === 'maintenance') {
        wrapperGoalSection.classList.add('hidden');
        inpGoal.value = 'maintain';
      } else {
        wrapperGoalSection.classList.remove('hidden');
      }

      invalidateResults();
    });
  });

  // Height Unit Switcher
  inpHeightUnit.addEventListener('change', () => {
    const isFtIn = inpHeightUnit.value === 'ft_in';
    if (isFtIn) {
      const cm = parseFloat(inpHeightCm.value) || 170;
      const { feet, inches } = cmToFtInches(cm);
      inpHeightFt.value = String(feet);
      inpHeightIn.value = String(inches);
      wrapperHeightCm.classList.add('hidden');
      wrapperHeightFtin.classList.remove('hidden');
    } else {
      const ft = parseFloat(inpHeightFt.value) || 5;
      const inVal = parseFloat(inpHeightIn.value) || 7;
      const cm = Math.round(ftInchesToCm(ft, inVal));
      inpHeightCm.value = String(cm);
      wrapperHeightCm.classList.remove('hidden');
      wrapperHeightFtin.classList.add('hidden');
    }
    invalidateResults();
  });

  // Weight Unit Switcher
  inpWeightUnit.addEventListener('change', () => {
    const isLbs = inpWeightUnit.value === 'lbs';
    lblWeightUnit.textContent = isLbs ? 'lbs' : 'kg';
    const currentW = parseFloat(inpWeight.value);
    if (!isNaN(currentW) && currentW > 0) {
      if (isLbs) {
        inpWeight.value = Math.round(kgToPounds(currentW)).toString();
      } else {
        inpWeight.value = Math.round(poundsToKg(currentW)).toString();
      }
    }
    invalidateResults();
  });

  inpActivity.addEventListener('change', () => {
    const actKey = inpActivity.value as ActivityLevel;
    const actData = ACTIVITY_LEVEL_MAP[actKey];
    if (actData) {
      hintActivityDesc.textContent = actData.description;
    }
    invalidateResults();
  });

  // Attach invalidation to all inputs (No live calculation while typing)
  document.querySelectorAll('input, select').forEach((el) => {
    if (!el.id.startsWith('inp-custom-') && el.id !== 'sel-macro-split') {
      el.addEventListener('input', invalidateResults);
    }
  });

  // Main Calculation Routine
  function performCalculation() {
    invalidateResults();

    try {
      const gender = inpGender.value as Gender;
      const age = parseInt(inpAge.value, 10);
      const activityLevel = inpActivity.value as ActivityLevel;
      const formula = inpFormula.value as BmrFormula;
      const goal = (currentMode === 'maintenance' ? 'maintain' : inpGoal.value) as CalorieGoal;

      let heightCm = 0;
      let heightDisplay = '';
      if (inpHeightUnit.value === 'ft_in') {
        const ft = parseFloat(inpHeightFt.value);
        const inVal = parseFloat(inpHeightIn.value) || 0;
        if (isNaN(ft) || ft <= 0) return showError('Please enter a valid height in feet and inches.');
        heightCm = ftInchesToCm(ft, inVal);
        heightDisplay = `${ft} ft ${inVal} in (${heightCm.toFixed(1)} cm)`;
      } else {
        heightCm = parseFloat(inpHeightCm.value);
        if (isNaN(heightCm) || heightCm <= 0) return showError('Please enter a valid positive height.');
        const { feet, inches } = cmToFtInches(heightCm);
        heightDisplay = `${heightCm} cm (${feet}' ${inches}")`;
      }

      let weightKg = 0;
      let weightDisplay = '';
      const weightVal = parseFloat(inpWeight.value);
      if (isNaN(weightVal) || weightVal <= 0) return showError('Please enter a valid body weight.');

      if (inpWeightUnit.value === 'lbs') {
        weightKg = poundsToKg(weightVal);
        weightDisplay = `${weightVal} lbs (${weightKg.toFixed(1)} kg)`;
      } else {
        weightKg = weightVal;
        weightDisplay = `${weightKg} kg (${kgToPounds(weightKg).toFixed(1)} lbs)`;
      }

      const result = calculateDailyCalories({
        gender,
        age,
        heightCm,
        weightKg,
        activityLevel,
        formula,
        goal,
      });

      lastResultData = {
        result,
        inputs: {
          genderDisplay: gender === 'male' ? 'Male' : 'Female',
          age,
          heightDisplay,
          weightDisplay,
          activityDisplay: result.activityLabel,
          formulaDisplay: result.formulaLabel,
          goalDisplay: result.goalLabel,
        },
      };

      // Render Hero Card
      badgeGoalLabel.textContent = result.goalLabel;
      resHeroTargetCal.textContent = result.dailyCalorieTarget.toLocaleString();
      resHeroWeeklyCal.textContent = result.weeklyCalorieTarget.toLocaleString();

      if (result.isLowCalorieWarning && result.warningMessage) {
        bannerCalorieWarning.textContent = result.warningMessage;
        bannerCalorieWarning.classList.remove('hidden');
      } else {
        bannerCalorieWarning.classList.add('hidden');
      }

      // Render Metrics Grid
      resCardBmr.textContent = `${result.bmr.toLocaleString()} kcal`;
      resCardTdee.textContent = `${result.maintenanceCalories.toLocaleString()} kcal`;
      resCardAdj.textContent = `${result.goalAdjustmentKcal >= 0 ? '+' : ''}${result.goalAdjustmentKcal} kcal/day`;
      resCardPaceHint.textContent = GOAL_MAP[result.selectedGoal].paceDescription;
      resCardTarget.textContent = `${result.dailyCalorieTarget.toLocaleString()} kcal`;
      resCardFormula.textContent = result.formulaLabel;

      // Render Goal Comparison Table safely without innerHTML
      tbodyGoalComparison.replaceChildren(
        ...result.goalComparison.map((tier) => {
          const isSelected = tier.goalKey === result.selectedGoal;
          const tr = document.createElement('tr');
          tr.className = isSelected
            ? 'bg-blue-50/80 font-bold dark:bg-blue-950/40 text-blue-900 dark:text-blue-200'
            : 'hover:bg-slate-50/50 dark:hover:bg-slate-800/40';

          const tdGoal = document.createElement('td');
          tdGoal.className = 'py-2.5 px-3 flex items-center gap-1.5';
          tdGoal.textContent = (isSelected ? '👉 ' : '') + tier.label;

          const tdPace = document.createElement('td');
          tdPace.className = 'py-2.5 px-3 text-slate-500 dark:text-slate-400';
          tdPace.textContent = tier.paceDescription;

          const tdDaily = document.createElement('td');
          tdDaily.className = `py-2.5 px-3 ${isSelected ? 'text-blue-600 dark:text-blue-400 font-extrabold text-sm' : 'font-semibold'}`;
          tdDaily.textContent = `${tier.dailyCalories.toLocaleString()} kcal`;

          const tdWeekly = document.createElement('td');
          tdWeekly.className = 'py-2.5 px-3 text-right font-mono text-slate-600 dark:text-slate-400';
          tdWeekly.textContent = `${tier.weeklyCalories.toLocaleString()} kcal`;

          tr.append(tdGoal, tdPace, tdDaily, tdWeekly);
          return tr;
        })
      );

      // Render Macros
      updateMacroDisplay(result.dailyCalorieTarget);

      // Render Calculation Steps safely without innerHTML
      txtCalcDetails.replaceChildren(
        ...result.calculationSteps.map((s) => {
          const div = document.createElement('div');
          div.textContent = s;
          return div;
        })
      );

      // Reveal Results Section
      resultsSection.classList.remove('hidden');
      resultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (err: any) {
      showError(err.message || 'An unexpected calculation error occurred. Please verify your inputs.');
    }
  }

  function updateMacroDisplay(dailyCalories?: number) {
    const target = dailyCalories || (lastResultData ? lastResultData.result.dailyCalorieTarget : 2500);
    const splitKey = selMacroSplit.value;

    let pPct = 30;
    let cPct = 40;
    let fPct = 30;

    if (splitKey === 'custom') {
      wrapperCustomMacro.classList.remove('hidden');
      pPct = parseFloat(inpCustomP.value) || 30;
      cPct = parseFloat(inpCustomC.value) || 40;
      fPct = parseFloat(inpCustomF.value) || 30;
      const total = pPct + cPct + fPct;
      if (Math.abs(total - 100) > 0.5) {
        showError(`Custom macronutrient percentages must total 100% (currently ${total}%).`);
      }
    } else {
      wrapperCustomMacro.classList.add('hidden');
      const preset = MACRO_PRESETS[splitKey as keyof typeof MACRO_PRESETS] || MACRO_PRESETS.balanced;
      pPct = preset.proteinPct;
      cPct = preset.carbsPct;
      fPct = preset.fatPct;
    }

    const macroObj = calculateMacros(target, pPct, cPct, fPct);

    txtMacroPPct.textContent = `${macroObj.proteinPercent}%`;
    txtMacroPGrams.textContent = `${macroObj.proteinGrams} g / day`;
    txtMacroPCal.textContent = `${macroObj.proteinCalories.toLocaleString()} kcal/day`;

    txtMacroCPct.textContent = `${macroObj.carbsPercent}%`;
    txtMacroCGrams.textContent = `${macroObj.carbsGrams} g / day`;
    txtMacroCCal.textContent = `${macroObj.carbsCalories.toLocaleString()} kcal/day`;

    txtMacroFPct.textContent = `${macroObj.fatPercent}%`;
    txtMacroFGrams.textContent = `${macroObj.fatGrams} g / day`;
    txtMacroFCal.textContent = `${macroObj.fatCalories.toLocaleString()} kcal/day`;
  }

  selMacroSplit.addEventListener('change', () => updateMacroDisplay());
  [inpCustomP, inpCustomC, inpCustomF].forEach((el) => el.addEventListener('input', () => updateMacroDisplay()));

  // Clear All Functionality
  function performClearAll() {
    currentMode = 'daily_needs';
    modeButtons[0].click();

    inpGender.value = 'male';
    inpAge.value = '30';
    inpHeightUnit.value = 'cm';
    inpWeightUnit.value = 'kg';
    lblWeightUnit.textContent = 'kg';
    inpHeightCm.value = '170';
    inpHeightFt.value = '5';
    inpHeightIn.value = '7';
    wrapperHeightCm.classList.remove('hidden');
    wrapperHeightFtin.classList.add('hidden');
    inpWeight.value = '70';
    inpActivity.value = 'moderate';
    hintActivityDesc.textContent = ACTIVITY_LEVEL_MAP.moderate.description;
    inpFormula.value = 'mifflin';
    inpGoal.value = 'maintain';
    selMacroSplit.value = 'balanced';
    wrapperCustomMacro.classList.add('hidden');
    inpCustomP.value = '30';
    inpCustomC.value = '40';
    inpCustomF.value = '30';

    invalidateResults();
  }

  btnCalculate.addEventListener('click', performCalculation);
  btnClearAll.addEventListener('click', performClearAll);

  // PDF Export Generation
  if (btnDownloadPdf) {
    btnDownloadPdf.addEventListener('click', async () => {
      if (!lastResultData) {
        performCalculation();
        if (!lastResultData) return;
      }

      const txtBtn = document.getElementById('txt-btn-pdf');
      if (txtBtn) txtBtn.textContent = 'Generating PDF...';

      try {
        let jsPDFModule = (window as any).jspdf;
        if (!jsPDFModule) {
          const script1 = document.createElement('script');
          script1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          await new Promise((resolve, reject) => {
            script1.onload = resolve;
            script1.onerror = reject;
            document.head.appendChild(script1);
          });
          const script2 = document.createElement('script');
          script2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
          await new Promise((resolve, reject) => {
            script2.onload = resolve;
            script2.onerror = reject;
            document.head.appendChild(script2);
          });
          jsPDFModule = (window as any).jspdf;
        }

        const { jsPDF } = jsPDFModule;
        const doc = new jsPDF({ unit: 'pt', format: 'a4' });

        const primaryColor = [37, 99, 235]; // #2563eb
        const darkColor = [15, 23, 42]; // #0f172a
        const slateColor = [100, 116, 139]; // #64748b
        const lightBg = [248, 250, 252]; // #f8fafc

        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 40;
        let y = 45;

        // Header Branding
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(18);
        doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
        doc.text('AIFreecalculator.com', margin, y);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
        doc.text('Free Online Calculator Tools', margin, y + 13);

        const now = new Date();
        const dateStr = now.toISOString().split('T')[0];
        doc.text(`Generated: ${dateStr}`, pageWidth - margin, y + 5, { align: 'right' });

        y += 28;
        doc.setDrawColor(226, 232, 240);
        doc.setLineWidth(1);
        doc.line(margin, y, pageWidth - margin, y);
        y += 24;

        // Title
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(15);
        doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
        doc.text('Daily Calorie & Nutrition Calculation', margin, y);
        y += 18;

        // Summary Hero Box
        doc.setFillColor(lightBg[0], lightBg[1], lightBg[2]);
        doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, 'F');
        doc.setDrawColor(203, 213, 225);
        doc.roundedRect(margin, y, pageWidth - margin * 2, 54, 8, 8, 'D');

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(10);
        doc.setTextColor(primaryColor[0], primaryColor[1], primaryColor[2]);
        doc.text(`GOAL: ${lastResultData.inputs.goalDisplay.toUpperCase()}`, margin + 14, y + 18);

        doc.setFontSize(16);
        doc.setTextColor(darkColor[0], darkColor[1], darkColor[2]);
        doc.text(`Target: ${lastResultData.result.dailyCalorieTarget.toLocaleString()} kcal / day`, margin + 14, y + 38);

        doc.setFontSize(10);
        doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
        doc.text(`Maintenance: ${lastResultData.result.maintenanceCalories.toLocaleString()} kcal (BMR: ${lastResultData.result.bmr.toLocaleString()} kcal)`, pageWidth - margin - 14, y + 36, { align: 'right' });

        y += 70;

        // Input Parameters Table
        const inputRows = [
          ['Biological Sex', lastResultData.inputs.genderDisplay],
          ['Age', `${lastResultData.inputs.age} Years`],
          ['Height', lastResultData.inputs.heightDisplay],
          ['Body Weight', lastResultData.inputs.weightDisplay],
          ['Activity Level', lastResultData.inputs.activityDisplay],
          ['BMR Formula', lastResultData.inputs.formulaDisplay],
          ['Management Goal', lastResultData.inputs.goalDisplay],
        ];

        (doc as any).autoTable({
          startY: y,
          head: [['Parameter', 'User Entered Value']],
          body: inputRows,
          theme: 'striped',
          headStyles: { fillColor: primaryColor, textColor: 255, fontStyle: 'bold' },
          margin: { left: margin, right: margin },
          styles: { fontSize: 9, cellPadding: 4 },
        });

        y = (doc as any).lastAutoTable.finalY + 16;

        // Calorie & Goal Breakdown Table
        const goalRows = lastResultData.result.goalComparison.map((t) => [
          t.label,
          t.paceDescription,
          `${t.dailyCalories.toLocaleString()} kcal`,
          `${t.weeklyCalories.toLocaleString()} kcal`,
        ]);

        (doc as any).autoTable({
          startY: y,
          head: [['Objective', 'Weekly Pace', 'Daily Target', 'Weekly Total']],
          body: goalRows,
          theme: 'striped',
          headStyles: { fillColor: darkColor, textColor: 255, fontStyle: 'bold' },
          margin: { left: margin, right: margin },
          styles: { fontSize: 8.5, cellPadding: 4 },
        });

        y = (doc as any).lastAutoTable.finalY + 16;

        // Macro Breakdown Table
        const macroRows = [
          ['Protein (4 kcal/g)', `${lastResultData.result.macros.proteinPercent}%`, `${lastResultData.result.macros.proteinGrams} g`, `${lastResultData.result.macros.proteinCalories} kcal`],
          ['Carbohydrates (4 kcal/g)', `${lastResultData.result.macros.carbsPercent}%`, `${lastResultData.result.macros.carbsGrams} g`, `${lastResultData.result.macros.carbsCalories} kcal`],
          ['Fat (9 kcal/g)', `${lastResultData.result.macros.fatPercent}%`, `${lastResultData.result.macros.fatGrams} g`, `${lastResultData.result.macros.fatCalories} kcal`],
        ];

        (doc as any).autoTable({
          startY: y,
          head: [['Macronutrient', 'Distribution %', 'Daily Grams', 'Energy Total']],
          body: macroRows,
          theme: 'striped',
          headStyles: { fillColor: [59, 130, 246], textColor: 255, fontStyle: 'bold' },
          margin: { left: margin, right: margin },
          styles: { fontSize: 8.5, cellPadding: 4 },
        });

        y = (doc as any).lastAutoTable ? (doc as any).lastAutoTable.finalY + 16 : y + 16;

        // Calculation Details & Step-by-Step Breakdown Table (Auto-wrapping, No overflow)
        const cleanSteps = (lastResultData.result.calculationSteps || []).map((step: string, idx: number) => {
          const cleanedText = step
            .replace(/[•●]/g, '-')
            .replace(/×/g, 'x')
            .replace(/÷/g, '/')
            .replace(/²/g, '^2')
            .replace(/³/g, '^3')
            .replace(/₹/g, 'Rs. ')
            .replace(/[^\x00-\x7F]/g, ' ')
            .trim();
          return [`#${idx + 1}`, cleanedText];
        });

        if (cleanSteps.length > 0) {
          (doc as any).autoTable({
            startY: y,
            head: [['Step', 'Calculation Details & Step-by-Step Breakdown']],
            body: cleanSteps,
            theme: 'striped',
            headStyles: { fillColor: [30, 41, 59], textColor: 255, fontStyle: 'bold', fontSize: 9 },
            columnStyles: {
              0: { cellWidth: 40, fontStyle: 'bold', halign: 'center' },
              1: { cellWidth: 'auto' },
            },
            margin: { left: margin, right: margin, top: 40, bottom: 40 },
            styles: { fontSize: 8, cellPadding: 4.5, overflow: 'linebreak' },
            pageBreak: 'auto',
          });

          y = (doc as any).lastAutoTable.finalY + 16;
        }

        // Disclaimer (with page boundary check)
        const disclaimer =
          'Disclaimer: This calculation provides estimated calorie targets for general educational purposes based on mathematical formulas. It is not a medical diagnostic tool or personalized dietary prescription. For individualized nutrition planning or medical guidance, consult a registered dietitian or physician.';
        const splitDisc = doc.splitTextToSize(disclaimer, pageWidth - margin * 2);

        if (y + splitDisc.length * 10 > pageHeight - 50) {
          doc.addPage();
          y = 45;
        }

        doc.setFont('helvetica', 'italic');
        doc.setFontSize(7.5);
        doc.setTextColor(150, 150, 150);
        doc.text(splitDisc, margin, y);

        // Add page numbers and footers across all pages
        const totalPages = (doc.internal as any).getNumberOfPages();
        for (let i = 1; i <= totalPages; i++) {
          doc.setPage(i);
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8);
          doc.setTextColor(slateColor[0], slateColor[1], slateColor[2]);
          doc.text('Generated using AIFreecalculator.com', margin, pageHeight - 20);
          doc.text(`Page ${i} of ${totalPages}`, pageWidth - margin, pageHeight - 20, { align: 'right' });
        }

        doc.save(`calorie-calculation-${dateStr}.pdf`);
      } catch (err) {
        console.error(err);
        alert('Failed to generate PDF. Please try again.');
      } finally {
        if (txtBtn) txtBtn.textContent = 'Download PDF';
      }
    });
  }
</script>
