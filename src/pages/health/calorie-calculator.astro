---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    q: 'What is a calorie calculator?',
    a: 'A calorie calculator estimates the number of calories you may need each day based on information such as age, biological sex, height, weight, activity level, and your chosen weight management goal. The result is an estimate, and individual metabolic rates can vary.',
  },
  {
    q: 'What are maintenance calories (TDEE)?',
    a: 'Maintenance calories—also called Total Daily Energy Expenditure (TDEE)—represent the estimated total number of calories your body burns in a 24-hour period. Consuming this amount helps maintain your current body weight under consistent physical activity conditions.',
  },
  {
    q: 'How many calories should I eat to lose weight?',
    a: 'A weight-loss calorie target is typically calculated by applying a moderate calorie deficit (commonly 250 to 500 kcal/day below maintenance). A 500 kcal daily deficit translates to an estimated ~0.5 kg (1.1 lbs) of gradual fat loss per week.',
  },
  {
    q: 'What is the difference between the Mifflin-St Jeor and Harris-Benedict formulas?',
    a: 'The Mifflin-St Jeor equation (1990) is widely considered the clinical standard for modern populations and tends to provide higher statistical precision. The Revised Harris-Benedict equation (1984 Roza & Shizgal) is an updated version of the historic 1919 metabolic formula.',
  },
  {
    q: 'How does daily physical activity affect calorie needs?',
    a: 'Your basal metabolic rate (BMR) represents only 60% to 70% of daily calorie expenditure. Physical movement, spontaneous activity (NEAT), and structured exercise multiply your baseline BMR by 1.2 (sedentary) up to 1.9 (extra active) to determine maintenance calories.',
  },
  {
    q: 'What is a safe and sustainable rate for weight change?',
    a: 'Health organizations generally recommend a gradual pace of 0.25 kg to 0.75 kg (0.5 to 1.5 lbs) per week for weight loss, and 0.25 kg to 0.5 kg per week for muscle gain. Caloric intake should rarely drop below 1,200 kcal/day for women or 1,500 kcal/day for men without direct medical supervision.',
  },
  {
    q: 'Are calorie calculator results 100% accurate?',
    a: 'Calorie calculators provide statistical estimates based on validated population formulas. Real-world energy expenditure can vary based on genetics, body composition, thyroid hormones, adaptive thermogenesis, and sleep.',
  },
];
---

<CalculatorLayout
  title="Calorie Calculator – Calculate Daily Calories, Maintenance TDEE & Weight Goals"
  description="Estimate your daily calorie needs, maintenance calories (TDEE), and target calories for weight loss or muscle gain based on age, sex, height, weight, and activity level."
  category="Health"
  calculatorName="Calorie Calculator"
  slug="calorie-calculator"
  keywords={[
    'calorie calculator',
    'maintenance calorie calculator',
    'calorie calculator to lose weight',
    'daily calorie calculator',
    'calorie needs calculator',
    'maintenance calories',
    'tdee calculator',
    'bmr calculator',
    'calorie deficit calculator',
    'daily calorie intake',
    'weight loss calorie calculator',
  ]}
>
  <div class="space-y-6">
    <!-- Macro Calculator Quick Jump Banner -->
    <a
      href="/health/macro-calculator/"
      class="flex items-center justify-between rounded-2xl border border-blue-200 bg-blue-50/70 p-3 px-4 text-xs font-semibold text-blue-800 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300 transition hover:bg-blue-100 dark:hover:bg-blue-900/60"
    >
      <span class="flex items-center gap-2">
        <span>🥗</span>
        <span>Looking for exact <strong>Protein, Carbs &amp; Fat grams (IIFYM)</strong>? Try our Macro Calculator →</span>
      </span>
      <span class="rounded-lg bg-blue-600 text-white px-2.5 py-1 text-[11px] font-bold shrink-0">Open</span>
    </a>

    <!-- Calculator Mode Selector Tabs -->
    <div class="rounded-2xl border border-slate-200/80 bg-slate-50/60 p-1.5 dark:border-slate-800 dark:bg-slate-900/50">
      <div class="grid grid-cols-3 gap-1.5" id="mode-tabs" role="tablist">
        <button
          type="button"
          data-mode="daily_needs"
          class="mode-btn active flex items-center justify-center gap-1.5 rounded-xl border border-blue-600 bg-blue-50 px-3 py-2.5 text-xs sm:text-sm font-bold text-blue-700 shadow-sm transition dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer text-center"
          role="tab"
          aria-selected="true"
        >
          <span>🔥</span> Daily Calorie Needs
        </button>
        <button
          type="button"
          data-mode="maintenance"
          class="mode-btn flex items-center justify-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs sm:text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 cursor-pointer text-center"
          role="tab"
          aria-selected="false"
        >
          <span>⚖️</span> Maintenance TDEE
        </button>
        <button
          type="button"
          data-mode="weight_goal"
          class="mode-btn flex items-center justify-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs sm:text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 cursor-pointer text-center"
          role="tab"
          aria-selected="false"
        >
          <span>🎯</span> Weight Loss / Gain
        </button>
      </div>
    </div>

    <!-- Error Banner -->
    <div
      id="error-box"
      class="hidden rounded-xl border border-red-200 bg-red-50/90 p-4 text-xs sm:text-sm font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/50 dark:text-red-300"
      role="alert"
      aria-live="polite"
    >
    </div>

    <!-- Main Calorie Inputs Container -->
    <div id="section-profile-inputs" class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm sm:p-6 dark:border-slate-800 dark:bg-slate-900">
      <div class="space-y-5">
        
        <!-- Row 1: Demographics (Sex, Age, Units) -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 pb-4 border-b border-slate-100 dark:border-slate-800">
          <div>
            <label for="inp-gender" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Biological Sex <span class="text-red-500">*</span>
            </label>
            <select
              id="inp-gender"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
            >
              <option value="male" selected>Male</option>
              <option value="female">Female</option>
            </select>
          </div>

          <div>
            <label for="inp-age" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Age (Years) <span class="text-red-500">*</span>
            </label>
            <input
              type="number"
              id="inp-age"
              value="30"
              min="12"
              max="120"
              step="1"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="e.g., 30"
            />
          </div>

          <div>
            <label for="inp-height-unit" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Height Unit
            </label>
            <select
              id="inp-height-unit"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
            >
              <option value="cm" selected>Centimeters (cm)</option>
              <option value="ft_in">Feet & Inches (ft/in)</option>
            </select>
          </div>

          <div>
            <label for="inp-weight-unit" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Weight Unit
            </label>
            <select
              id="inp-weight-unit"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
            >
              <option value="kg" selected>Kilograms (kg)</option>
              <option value="lbs">Pounds (lbs)</option>
            </select>
          </div>
        </div>

        <!-- Row 2: Height & Weight Values -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- Height Metric -->
          <div id="wrapper-height-cm">
            <label for="inp-height-cm" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Height (cm) <span class="text-red-500">*</span>
            </label>
            <input
              type="number"
              id="inp-height-cm"
              value="170"
              min="60"
              max="260"
              step="any"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="e.g., 170"
            />
          </div>

          <!-- Height Imperial -->
          <div id="wrapper-height-ftin" class="hidden">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Height (Feet & Inches) <span class="text-red-500">*</span>
            </label>
            <div class="mt-1.5 grid grid-cols-2 gap-2">
              <div class="relative">
                <input
                  type="number"
                  id="inp-height-ft"
                  value="5"
                  min="2"
                  max="8"
                  step="1"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-8 text-xs sm:text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="5"
                />
                <span class="pointer-events-none absolute right-2.5 top-2.5 text-xs font-bold text-slate-400">ft</span>
              </div>
              <div class="relative">
                <input
                  type="number"
                  id="inp-height-in"
                  value="7"
                  min="0"
                  max="11.9"
                  step="0.1"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-8 text-xs sm:text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="7"
                />
                <span class="pointer-events-none absolute right-2.5 top-2.5 text-xs font-bold text-slate-400">in</span>
              </div>
            </div>
          </div>

          <!-- Weight -->
          <div>
            <label for="inp-weight" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Body Weight (<span id="lbl-weight-unit">kg</span>) <span class="text-red-500">*</span>
            </label>
            <input
              type="number"
              id="inp-weight"
              value="70"
              min="20"
              max="400"
              step="any"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              placeholder="e.g., 70"
            />
          </div>
        </div>

        <!-- Row 3: Activity Level & Formula -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="inp-activity" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Daily Physical Activity Level <span class="text-red-500">*</span>
            </label>
            <select
              id="inp-activity"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
            >
              <option value="sedentary">Sedentary (Little or no planned exercise, desk job)</option>
              <option value="light">Lightly Active (Light exercise/sports 1–3 days/week)</option>
              <option value="moderate" selected>Moderately Active (Moderate exercise/sports 3–5 days/week)</option>
              <option value="active">Very Active (Hard exercise/sports 6–7 days/week)</option>
              <option value="very_active">Extra Active (Hard daily training or physical manual labor)</option>
            </select>
            <p id="hint-activity-desc" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
              Moderate exercise 3–5 days/week; active daily routine.
            </p>
          </div>

          <div>
            <label for="inp-formula" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              BMR Calculation Formula
            </label>
            <select
              id="inp-formula"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
            >
              <option value="mifflin" selected>Mifflin-St Jeor (Standard / Recommended)</option>
              <option value="harris">Revised Harris-Benedict (1984 Roza & Shizgal)</option>
            </select>
            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">
              Mifflin-St Jeor provides high statistical precision for modern adults.
            </p>
          </div>
        </div>

        <!-- Row 4: Primary Goal (Visible for Daily Needs & Weight Goal modes) -->
        <div id="wrapper-goal-section" class="pt-2 border-t border-slate-100 dark:border-slate-800 space-y-3">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="inp-goal" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Weight Management Goal
              </label>
              <select
                id="inp-goal"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
              >
                <option value="maintain" selected>Maintain Weight (0 kcal adjustment)</option>
                <option value="lose_gradual">Lose Weight – Gradual (-250 kcal/day, ~0.25 kg/wk)</option>
                <option value="lose_moderate">Lose Weight – Moderate (-500 kcal/day, ~0.50 kg/wk)</option>
                <option value="lose_faster">Lose Weight – Faster (-750 kcal/day, ~0.75 kg/wk)</option>
                <option value="gain_gradual">Gain Weight – Gradual (+250 kcal/day, ~0.25 kg/wk)</option>
                <option value="gain_moderate">Gain Weight – Moderate (+500 kcal/day, ~0.50 kg/wk)</option>
              </select>
            </div>
            <div class="flex items-center">
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300 w-full">
                <strong>Pace Guidance:</strong> Gradual adjustments (250–500 kcal/day) are easier to maintain over time without excessive metabolic fatigue.
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
          <button
            type="button"
            id="btn-calculate-calories"
            class="w-full sm:flex-1 rounded-xl bg-linear-to-r from-blue-600 to-indigo-600 px-6 py-3.5 text-center text-sm font-black text-white shadow-lg shadow-blue-500/25 transition hover:from-blue-700 hover:to-indigo-700 active:scale-[0.98] cursor-pointer"
          >
            Calculate Calories →
          </button>
          <button
            type="button"
            id="btn-clear-all"
            class="w-full sm:w-auto rounded-xl border border-slate-300 bg-white px-5 py-3.5 text-center text-sm font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer"
          >
            Clear All
          </button>
        </div>

      </div>
    </div>

    <!-- ========================================================= -->
    <!-- RESULTS SECTION -->
    <!-- ========================================================= -->
    <div id="results-section" class="hidden space-y-6">
      
      <!-- Result Card Hero -->
      <div class="rounded-2xl border border-blue-500/30 bg-linear-to-br from-blue-50/90 via-indigo-50/50 to-slate-50/90 p-5 sm:p-6 dark:border-blue-900/60 dark:from-blue-950/40 dark:via-indigo-950/20 dark:to-slate-900/40 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-blue-200/60 pb-3 dark:border-blue-900/50">
          <span class="text-xs font-black uppercase tracking-wider text-blue-600 dark:text-blue-400">
            YOUR ESTIMATED DAILY CALORIES
          </span>
          <span id="badge-goal-label" class="self-start sm:self-auto rounded-md bg-blue-100 px-2 py-0.5 text-[11px] font-bold text-blue-800 dark:bg-blue-900/80 dark:text-blue-200">
            Maintain Weight
          </span>
        </div>

        <div class="mt-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
          <div class="flex items-baseline gap-2">
            <span id="res-hero-target-cal" class="text-4xl sm:text-5xl font-black tracking-tight text-blue-600 dark:text-blue-400">
              2,527
            </span>
            <span class="text-sm sm:text-base font-bold text-slate-700 dark:text-slate-300">kcal / day</span>
          </div>
          <div class="text-xs sm:text-sm font-semibold text-slate-500 dark:text-slate-400">
            Weekly Equivalent: <span id="res-hero-weekly-cal" class="font-bold text-slate-900 dark:text-white">17,689</span> kcal/week
          </div>
        </div>

        <div id="banner-calorie-warning" class="hidden mt-3 rounded-xl border border-amber-300 bg-amber-50 p-3 text-xs font-semibold text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300">
        </div>
      </div>

      <!-- Result Cards Grid -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5 text-xs">
        <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900/70 shadow-xs">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Basal Metabolic Rate (BMR)</div>
          <div id="res-card-bmr" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">1,630 kcal</div>
          <div class="mt-0.5 text-[10px] text-slate-400">Calories burned at complete rest</div>
        </div>

        <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900/70 shadow-xs">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Maintenance (TDEE)</div>
          <div id="res-card-tdee" class="mt-1 text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400">2,527 kcal</div>
          <div class="mt-0.5 text-[10px] text-slate-400">Calories to stay same weight</div>
        </div>

        <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900/70 shadow-xs">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Goal Adjustment</div>
          <div id="res-card-adj" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">0 kcal/day</div>
          <div id="res-card-pace-hint" class="mt-0.5 text-[10px] text-slate-400">Maintain balance</div>
        </div>

        <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900/70 shadow-xs">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Daily Calorie Target</div>
          <div id="res-card-target" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">2,527 kcal</div>
          <div class="mt-0.5 text-[10px] text-slate-400">Recommended daily intake</div>
        </div>

        <div class="col-span-2 sm:col-span-1 rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900/70 shadow-xs">
          <div class="text-slate-500 dark:text-slate-400 font-semibold">Formula Used</div>
          <div id="res-card-formula" class="mt-1 text-sm sm:text-base font-bold text-indigo-600 dark:text-indigo-400">Mifflin-St Jeor</div>
          <div class="mt-0.5 text-[10px] text-slate-400">Clinical standard model</div>
        </div>
      </div>

      <!-- Daily Calorie Breakdown Table -->
      <div class="rounded-2xl border border-slate-200/80 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 shadow-xs space-y-3">
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 dark:border-slate-800">
          <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <span>📊</span> Daily Calorie Target by Weight Goal
          </h3>
          <span class="text-[11px] text-slate-500">Based on your calculated TDEE</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950 font-bold text-slate-700 dark:text-slate-300">
              <tr>
                <th class="py-2.5 px-3">Goal Objective</th>
                <th class="py-2.5 px-3">Weekly Pace Estimate</th>
                <th class="py-2.5 px-3">Daily Calories</th>
                <th class="py-2.5 px-3 text-right">Weekly Total</th>
              </tr>
            </thead>
            <tbody id="tbody-goal-comparison" class="divide-y divide-slate-100 dark:divide-slate-800/80">
            </tbody>
          </table>
        </div>
      </div>

      <!-- Macronutrient Breakdown Module -->
      <div class="rounded-2xl border border-slate-200/80 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 shadow-xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-3 dark:border-slate-800">
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
              <span>🥑</span> Estimated Macronutrient Breakdown
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">
              Daily protein, carbohydrate, and fat targets based on your calculated calorie target.
            </p>
          </div>
          <div class="flex items-center gap-1.5 text-xs font-semibold">
            <label for="sel-macro-split" class="text-slate-500">Split Preset:</label>
            <select
              id="sel-macro-split"
              class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
            >
              <option value="balanced" selected>Balanced (30P / 40C / 30F)</option>
              <option value="high_protein">Higher Protein (40P / 35C / 25F)</option>
              <option value="low_carb">Lower Carb (35P / 20C / 45F)</option>
              <option value="custom">Custom Percentage Split</option>
            </select>
          </div>
        </div>

        <!-- Custom Macro Inputs (Hidden unless custom is chosen) -->
        <div id="wrapper-custom-macro" class="hidden grid-cols-3 gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs">
          <div>
            <label for="inp-custom-p" class="font-bold text-blue-600 dark:text-blue-400">Protein (%)</label>
