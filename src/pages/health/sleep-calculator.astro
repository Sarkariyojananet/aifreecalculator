---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Sleep Calculator – Best Bedtime & Wake Up Time by Sleep Cycles"
  description="Calculate the ideal bedtime or wake-up time based on 90-minute sleep cycles. Find the best times to sleep or wake up feeling refreshed and fully rested."
  category="Health"
  calculatorName="Sleep Calculator"
  slug="sleep-calculator"
  keywords={[
    'sleep calculator',
    'sleep cycle calculator',
    'bedtime calculator',
    'wake up time calculator',
    'sleep schedule calculator',
    'what time should i go to sleep',
    'how many hours of sleep calculator',
    'rem cycle calculator'
  ]}
>
  <div class="space-y-6">

    <!-- MODE TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-sleep-tab active shrink-0 rounded-lg bg-indigo-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="wakeup">What time should I wake up?</button>
        <button type="button" class="btn-sleep-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="bedtime">What time should I sleep? 🌙</button>
        <button type="button" class="btn-sleep-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="howmany">How many hours? 😴</button>
      </div>
    </div>

    <!-- PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1">⚡ I need to wake up at:</span>
        <button type="button" class="btn-wake-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-indigo-500 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-time="06:00">🌅 6:00 AM</button>
        <button type="button" class="btn-wake-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-indigo-500 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-time="06:30">6:30 AM</button>
        <button type="button" class="btn-wake-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-indigo-500 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-time="07:00">7:00 AM</button>
        <button type="button" class="btn-wake-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-indigo-500 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-time="07:30">7:30 AM</button>
        <button type="button" class="btn-wake-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-indigo-500 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-time="08:00">8:00 AM</button>
      </div>
    </div>

    <!-- MAIN PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-indigo-50/20 to-violet-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-indigo-950/10 sm:p-7">

      <!-- WAKE UP PANEL -->
      <div id="panel-wakeup" class="sleep-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>⏰</span> Bedtime Calculator — When Should I Go to Sleep?</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Enter your desired wake-up time. We'll calculate the best bedtimes based on 90-minute sleep cycles so you wake up refreshed, not groggy.</p>
        </div>
        <form id="form-sleep-wakeup" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div><label for="wake-time" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Wake-Up Time</label><input type="time" id="wake-time" value="07:00" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label for="fall-asleep" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Time to Fall Asleep (minutes)</label>
              <select id="fall-asleep" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="7">7 minutes (Very Fast)</option>
                <option value="14" selected>14 minutes (Average)</option>
                <option value="20">20 minutes (Moderate)</option>
                <option value="30">30 minutes (Slow)</option>
              </select>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="submit" id="btn-wakeup-calc" class="flex-1 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-indigo-600/25 transition active:scale-[0.98] cursor-pointer">Calculate Bedtimes →</button>
            <button type="button" id="btn-wakeup-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
        </form>
      </div>

      <!-- BEDTIME PANEL -->
      <div id="panel-bedtime" class="sleep-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>🌙</span> Wake-Up Calculator — When Should I Wake Up?</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Enter the time you plan to go to bed. We'll show you the best wake-up times aligned with your sleep cycles.</p>
        </div>
        <form id="form-sleep-bedtime" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div><label for="bed-time" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Bedtime (When you go to bed)</label><input type="time" id="bed-time" value="22:30" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label for="fall-asleep-b" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Time to Fall Asleep (minutes)</label>
              <select id="fall-asleep-b" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="7">7 minutes (Very Fast)</option>
                <option value="14" selected>14 minutes (Average)</option>
                <option value="20">20 minutes</option>
                <option value="30">30 minutes</option>
              </select>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="submit" id="btn-bedtime-calc" class="flex-1 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-indigo-600/25 transition active:scale-[0.98] cursor-pointer">Calculate Wake-Up Times →</button>
            <button type="button" id="btn-bedtime-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
        </form>
      </div>

      <!-- HOW MANY HOURS PANEL -->
      <div id="panel-howmany" class="sleep-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>😴</span> How Many Hours of Sleep Do I Need?</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Enter your bedtime and wake-up time to find out how many hours of sleep you're getting and if it's enough for your age group.</p>
        </div>
        <form id="form-sleep-howmany" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div><label for="hm-bed" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Bedtime</label><input type="time" id="hm-bed" value="23:00" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label for="hm-wake" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Wake Time</label><input type="time" id="hm-wake" value="07:00" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label for="hm-age" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Age Group</label>
              <select id="hm-age" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="14-17">Teenagers (14–17): 8–10 hrs</option>
                <option value="18-25" selected>Young Adults (18–25): 7–9 hrs</option>
                <option value="26-64">Adults (26–64): 7–9 hrs</option>
                <option value="65+">Seniors (65+): 7–8 hrs</option>
              </select>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="submit" id="btn-howmany-calc" class="flex-1 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-indigo-600/25 transition active:scale-[0.98] cursor-pointer">Check My Sleep →</button>
            <button type="button" id="btn-howmany-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
        </form>
      </div>

      <!-- RESULTS -->
      <div id="sleep-results" class="hidden mt-6 space-y-5">
        <!-- Hero Card -->
        <div class="overflow-hidden rounded-3xl border border-indigo-200 bg-linear-to-br from-white via-indigo-50/40 to-violet-100/50 p-5 shadow-lg shadow-indigo-500/5 dark:border-indigo-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-indigo-950/30 sm:p-7">
          <div class="flex flex-col gap-3 border-b border-indigo-200/80 pb-4 dark:border-slate-800">
            <span id="sleep-badge" class="text-xs font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-300">🌙 Recommended Bedtimes (to wake at 7:00 AM)</span>
            <p class="text-xs text-slate-600 dark:text-slate-300">Wake up between sleep cycles so you feel refreshed — not when you're in the middle of deep sleep.</p>
            <div id="sleep-times-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm"></div>
          </div>
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-indigo-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Sleep Duration</div>
              <div id="sleep-res-duration" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">7.5 hrs</div>
            </div>
            <div class="rounded-xl border border-indigo-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Sleep Cycles</div>
              <div id="sleep-res-cycles" class="mt-1 text-sm font-bold text-indigo-600 dark:text-indigo-400">5 Cycles</div>
            </div>
            <div class="rounded-xl border border-indigo-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Fall Asleep In</div>
              <div id="sleep-res-latency" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">14 min</div>
            </div>
            <div class="rounded-xl border border-indigo-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Quality</div>
              <div id="sleep-res-quality" class="mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400">✅ Excellent</div>
            </div>
          </div>
        </div>

        <!-- Sleep Cycle Visual -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-1.5"><span>📊</span> Sleep Cycle Stages</h3>
          <div class="space-y-2 text-xs">
            <div class="flex items-center gap-3"><div class="w-4 h-4 rounded-sm bg-indigo-200 dark:bg-indigo-800 shrink-0"></div><div><span class="font-bold text-slate-700 dark:text-slate-300">Stage 1 – Light Sleep (5%)</span>: Transition from wakefulness. Easy to wake up.</div></div>
            <div class="flex items-center gap-3"><div class="w-4 h-4 rounded-sm bg-indigo-400 dark:bg-indigo-600 shrink-0"></div><div><span class="font-bold text-slate-700 dark:text-slate-300">Stage 2 – Light Sleep (45%)</span>: Heart rate slows, body temperature drops.</div></div>
            <div class="flex items-center gap-3"><div class="w-4 h-4 rounded-sm bg-indigo-600 dark:bg-indigo-400 shrink-0"></div><div><span class="font-bold text-slate-700 dark:text-slate-300">Stage 3 – Deep Sleep (25%)</span>: Most restorative stage. Growth hormone released. Hardest to wake.</div></div>
            <div class="flex items-center gap-3"><div class="w-4 h-4 rounded-sm bg-violet-500 shrink-0"></div><div><span class="font-bold text-slate-700 dark:text-slate-300">Stage 4 – REM Sleep (25%)</span>: Dreaming, memory consolidation, emotional processing.</div></div>
          </div>
          <div class="mt-4 p-3 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/40 text-xs text-amber-800 dark:text-amber-300 font-medium">
            💡 <strong>Pro tip:</strong> Waking up at the END of a 90-minute cycle (when you're in lightest sleep) means you'll feel much more refreshed. That's why we suggest those specific bedtimes!
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- SEO CONTENT -->
  <Fragment slot="content">
    <section class="sleep-content">
      <h2>Sleep Calculator – Find Your Perfect Bedtime & Wake-Up Time</h2>
      <p>Our <strong>Sleep Calculator</strong> is designed to help you find the optimal bedtime or wake-up time based on the science of <strong>90-minute sleep cycles</strong>. If you've ever woken up feeling exhausted despite getting 8 hours of sleep, you might have been woken in the middle of a deep sleep cycle. Our sleep calculator calculates the exact times you should sleep or wake up to feel fully rested and energized.</p>

      <h2>How Sleep Cycles Work</h2>
      <p>Your brain cycles through <strong>4 stages of sleep</strong> approximately every 90 minutes:</p>
      <ul>
        <li><strong>Stage 1 (Light Sleep, ~5%):</strong> You drift in and out of sleep. Muscles may twitch. Easy to wake up.</li>
        <li><strong>Stage 2 (Light Sleep, ~45%):</strong> Heart rate slows, body temperature drops, eye movements stop. Your brain begins producing sleep spindles.</li>
        <li><strong>Stage 3 (Deep Sleep / Slow-Wave Sleep, ~25%):</strong> The most physically restorative stage. Growth hormone is released, tissues repair, immune system strengthens. Very difficult to wake from.</li>
        <li><strong>Stage 4 (REM Sleep, ~25%):</strong> Rapid Eye Movement sleep — you dream vividly. Memory consolidation, emotional regulation, creativity boost. Brain is nearly as active as when awake.</li>
      </ul>

      <h2>Why 90-Minute Sleep Cycles Matter</h2>
      <p>Each complete sleep cycle lasts approximately <strong>90 minutes</strong>. In an average night, you complete 5–6 cycles. The key to waking up refreshed is to time your alarm to coincide with the <strong>end of a cycle</strong> — when you're in the lightest sleep phase — rather than in the middle of deep sleep or REM sleep. Waking mid-cycle causes <strong>sleep inertia</strong> (that groggy, disoriented feeling that can last for hours).</p>

      <h2>How Much Sleep Do You Need?</h2>
      <ul>
        <li><strong>Newborns (0–3 months):</strong> 14–17 hours per day</li>
        <li><strong>School-age children (6–13):</strong> 9–11 hours</li>
        <li><strong>Teenagers (14–17):</strong> 8–10 hours</li>
        <li><strong>Young Adults (18–25):</strong> 7–9 hours (5–6 complete sleep cycles)</li>
        <li><strong>Adults (26–64):</strong> 7–9 hours</li>
        <li><strong>Older Adults (65+):</strong> 7–8 hours</li>
      </ul>

      <h2>Tips for Better Sleep Quality</h2>
      <ol>
        <li><strong>Consistent Schedule:</strong> Go to bed and wake up at the same time every day — even weekends. This regulates your circadian rhythm.</li>
        <li><strong>Avoid Screens Before Bed:</strong> Blue light from phones, tablets, and TVs suppresses melatonin production. Stop 60–90 minutes before bed.</li>
        <li><strong>Cool Room Temperature:</strong> The ideal sleep temperature is 15–19°C (60–67°F). Your core body temperature naturally drops during sleep.</li>
        <li><strong>Limit Caffeine After 2 PM:</strong> Caffeine has a half-life of 5–6 hours. A coffee at 4 PM still has half its caffeine at 10 PM.</li>
        <li><strong>Power Naps:</strong> A 20-minute nap (one sleep stage) is refreshing. Avoid naps longer than 30 minutes to prevent entering deep sleep and causing grogginess.</li>
        <li><strong>Melatonin Supplement:</strong> 0.5–3 mg of melatonin 30 minutes before bed can help shift your sleep timing, especially useful for jet lag or shift workers.</li>
      </ol>

      <h2>Sleep Debt and Recovery</h2>
      <p>When you consistently sleep less than your body needs, you accumulate <strong>sleep debt</strong>. Unfortunately, you cannot fully "make up" for lost sleep with one long recovery night — chronic sleep deprivation has lasting effects on cognitive performance, immune function, metabolism, and mental health. The best approach is to maintain a consistent sleep schedule and protect your 7–9 hours nightly.</p>
    </section>
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <div class="space-y-4 text-xs sm:text-sm">
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800" open>
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">1. What is a sleep cycle and how long does it last?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">A sleep cycle lasts approximately 90 minutes and consists of 4 stages: two light sleep stages, one deep sleep stage, and REM sleep. Most people complete 5–6 cycles per night. Waking at the end of a cycle means you wake during the lightest sleep phase, making it easier to feel alert.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">2. Is 6 hours of sleep enough?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">For most adults, 6 hours is below the recommended 7–9 hours. Chronic sleep deprivation at 6 hours has been linked to impaired cognitive function, weakened immunity, weight gain, and increased risk of cardiovascular disease. 4 complete sleep cycles (6 hours) is better than 5 hours, but not ideal long-term.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">3. What is sleep inertia and how do I avoid it?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Sleep inertia is the grogginess you feel when woken from deep sleep. It can last 15 minutes to 2 hours and impairs cognitive performance. Avoid it by waking at the end of a 90-minute sleep cycle using our sleep calculator, or by setting your alarm during a light sleep phase.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">4. Does everyone take 14 minutes to fall asleep?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">No. The average is 7–20 minutes. If you fall asleep in less than 5 minutes, you may be severely sleep-deprived. If it takes over 30 minutes regularly, you may have sleep-onset insomnia. Our calculator lets you customize your personal sleep latency for accurate bedtime recommendations.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">5. What is REM sleep and why is it important?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">REM (Rapid Eye Movement) sleep is the dreaming stage where your brain processes emotions, consolidates memories, and promotes creativity. It accounts for about 25% of total sleep time and occurs mostly in the later cycles of the night — another reason why cutting sleep short by 1–2 hours significantly reduces REM sleep.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">6. Are 5 sleep cycles (7.5 hours) better than 6 cycles (9 hours)?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">For most adults, 5 complete cycles (7.5 hours) is the sweet spot — you get all the deep sleep and REM sleep you need without oversleeping. 6 cycles (9 hours) is ideal for those recovering from sleep debt or during illness. More than 9 hours regularly can sometimes indicate an underlying health issue.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">7. What's the best time to wake up based on sleep science?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">The best wake time aligns with your circadian rhythm and natural light exposure. For most people, this is between 6:00–8:00 AM, timed to complete 5–6 full sleep cycles from their bedtime. Use our sleep calculator to find your exact optimal bedtime based on when you need to wake up.</p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<style>
  .sleep-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.5rem; font-weight: 800; color: #0f172a; }
  .sleep-content h2:first-child { margin-top: 0; }
  .sleep-content p { margin: 0 0 1rem; line-height: 1.75; color: #475569; }
  .sleep-content ul, .sleep-content ol { margin: 0.75rem 0 1.5rem; padding-left: 1.5rem; }
  .sleep-content ul { list-style: disc; }
  .sleep-content ol { list-style: decimal; }
  .sleep-content li + li { margin-top: 0.5rem; }
  :global(.dark) .sleep-content h2 { color: #f8fafc; }
  :global(.dark) .sleep-content p, :global(.dark) .sleep-content li { color: #cbd5e1; }
</style>

<script is:inline>
  const sleepTabs = document.querySelectorAll('.btn-sleep-tab');
  const sleepPanels = document.querySelectorAll('.sleep-panel');
  const sleepResults = document.getElementById('sleep-results');

  sleepTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      sleepTabs.forEach(t => { t.classList.remove('bg-indigo-600','text-white','shadow-xs'); t.classList.add('border','border-slate-300','bg-white','text-slate-700','dark:border-slate-700','dark:bg-slate-800','dark:text-slate-200'); });
      tab.classList.add('bg-indigo-600','text-white','shadow-xs');
      tab.classList.remove('border','border-slate-300','bg-white','text-slate-700');
      sleepPanels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');
      sleepResults?.classList.add('hidden');
    });
  });

  document.querySelectorAll('.btn-wake-preset').forEach(btn => {
    btn.addEventListener('click', () => { document.getElementById('wake-time').value = btn.dataset.time; });
  });

  function parseTime(val) {
    const [h, m] = val.split(':').map(Number);
    return h * 60 + m;
  }
  function minToTime(mins) {
    const h = Math.floor(((mins % 1440) + 1440) % 1440 / 60);
    const m = ((mins % 1440) + 1440) % 1440 % 60;
    const period = h < 12 ? 'AM' : 'PM';
    const h12 = h === 0 ? 12 : h > 12 ? h - 12 : h;
    return h12.toString().padStart(2,'0') + ':' + m.toString().padStart(2,'0') + ' ' + period;
  }
  function getCycleQuality(cycles) {
    if (cycles >= 6) return { label: '🌟 Perfect', cls: 'text-emerald-600 dark:text-emerald-400' };
    if (cycles === 5) return { label: '✅ Excellent', cls: 'text-emerald-600 dark:text-emerald-400' };
    if (cycles === 4) return { label: '⚠️ Adequate', cls: 'text-amber-600 dark:text-amber-400' };
    return { label: '❌ Insufficient', cls: 'text-red-600 dark:text-red-400' };
  }

  function showSleepResults(badge, times, latency) {
    document.getElementById('sleep-badge').textContent = badge;
    const grid = document.getElementById('sleep-times-grid');
    const recommended = [5, 6, 7, 8, 9];
    grid.innerHTML = '';
    times.forEach(({ time, cycles, label }) => {
      const q = getCycleQuality(cycles);
      const isRec = cycles === 5 || cycles === 6;
      grid.innerHTML += `<div class="rounded-2xl border ${isRec ? 'border-indigo-300 bg-indigo-50 dark:border-indigo-700 dark:bg-indigo-950/30' : 'border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900'} p-3 text-center">
        <div class="text-lg font-black ${isRec ? 'text-indigo-700 dark:text-indigo-300' : 'text-slate-800 dark:text-slate-200'}">${time}</div>
        <div class="text-[11px] font-bold text-slate-500 mt-0.5">${cycles} cycles · ${Math.round(cycles * 1.5)}h ${((cycles * 90) % 60) ? (cycles * 90) % 60 + 'min' : ''}</div>
        <div class="text-[11px] font-semibold mt-1 ${q.cls}">${q.label}</div>
        ${isRec ? '<div class="text-[10px] text-indigo-500 font-bold mt-0.5">⭐ Recommended</div>' : ''}
      </div>`;
    });

    const bestCycles = Math.max(...times.map(t => t.cycles));
    const best = times.find(t => t.cycles === bestCycles);
    document.getElementById('sleep-res-duration').textContent = (best.cycles * 1.5) + ' hrs';
    document.getElementById('sleep-res-cycles').textContent = best.cycles + ' Cycles';
    document.getElementById('sleep-res-latency').textContent = latency + ' min';
    const q = getCycleQuality(best.cycles);
    document.getElementById('sleep-res-quality').textContent = q.label;
    document.getElementById('sleep-res-quality').className = 'mt-1 text-sm font-bold ' + q.cls;
    sleepResults.classList.remove('hidden');
    sleepResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('form-sleep-wakeup')?.addEventListener('submit', () => {
    const wakeMin = parseTime(document.getElementById('wake-time').value);
    const latency = parseInt(document.getElementById('fall-asleep').value);
    const times = [];
    for (let cycles = 9; cycles >= 3; cycles--) {
      const sleepMinutes = cycles * 90;
      const bedtime = wakeMin - sleepMinutes - latency;
      times.push({ time: minToTime(bedtime), cycles, label: cycles + ' cycles' });
    }
    const badge = '🌙 Best Bedtimes to Wake Up at ' + document.getElementById('wake-time').value;
    showSleepResults(badge, times, latency);
  });

  document.getElementById('btn-wakeup-clear')?.addEventListener('click', () => sleepResults?.classList.add('hidden'));

  document.getElementById('form-sleep-bedtime')?.addEventListener('submit', () => {
    const bedMin = parseTime(document.getElementById('bed-time').value);
    const latency = parseInt(document.getElementById('fall-asleep-b').value);
    const asleepMin = bedMin + latency;
    const times = [];
    for (let cycles = 3; cycles <= 9; cycles++) {
      const sleepMinutes = cycles * 90;
      const wakeMin = asleepMin + sleepMinutes;
      times.push({ time: minToTime(wakeMin), cycles, label: cycles + ' cycles' });
    }
    const badge = '⏰ Best Wake-Up Times After Sleeping at ' + document.getElementById('bed-time').value;
    showSleepResults(badge, times, latency);
  });

  document.getElementById('btn-bedtime-clear')?.addEventListener('click', () => sleepResults?.classList.add('hidden'));

  document.getElementById('form-sleep-howmany')?.addEventListener('submit', () => {
    const bedMin = parseTime(document.getElementById('hm-bed').value);
    const wakeMin = parseTime(document.getElementById('hm-wake').value);
    let diffMin = wakeMin - bedMin;
    if (diffMin < 0) diffMin += 1440;
    const cycles = Math.round(diffMin / 90);
    const ageGroup = document.getElementById('hm-age').value;
    const minRec = ageGroup === '65+' ? 7 : 7;
    const maxRec = ageGroup === '14-17' ? 10 : 9;
    const hoursGot = +(diffMin / 60).toFixed(1);
    const badge = `😴 You're Sleeping ${hoursGot} Hours (${cycles} Cycles)`;
    const times = [{ time: hoursGot + ' hours', cycles }];
    document.getElementById('sleep-badge').textContent = badge;
    const grid = document.getElementById('sleep-times-grid');
    const isOk = hoursGot >= minRec && hoursGot <= maxRec;
    grid.innerHTML = `<div class="col-span-full rounded-2xl border ${isOk ? 'border-emerald-300 bg-emerald-50 dark:border-emerald-700 dark:bg-emerald-950/30' : 'border-red-300 bg-red-50 dark:border-red-700 dark:bg-red-950/30'} p-4 text-center">
      <div class="text-3xl font-black ${isOk ? 'text-emerald-700 dark:text-emerald-300' : 'text-red-700 dark:text-red-300'}">${hoursGot} Hours</div>
      <div class="text-sm font-bold mt-1 text-slate-600 dark:text-slate-300">${cycles} complete sleep cycles</div>
      <div class="text-sm font-bold mt-2 ${isOk ? 'text-emerald-600' : 'text-red-600'}">${isOk ? '✅ Great! This meets the recommended ' + minRec + '–' + maxRec + ' hours for your age group.' : '⚠️ Below the recommended ' + minRec + '–' + maxRec + ' hours for your age group. Consider adjusting your schedule.'}</div>
    </div>`;
    document.getElementById('sleep-res-duration').textContent = hoursGot + ' hrs';
    document.getElementById('sleep-res-cycles').textContent = cycles + ' Cycles';
    document.getElementById('sleep-res-latency').textContent = 'N/A';
    const q = getCycleQuality(cycles);
    document.getElementById('sleep-res-quality').textContent = q.label;
    document.getElementById('sleep-res-quality').className = 'mt-1 text-sm font-bold ' + q.cls;
    sleepResults.classList.remove('hidden');
  });

  document.getElementById('btn-howmany-clear')?.addEventListener('click', () => sleepResults?.classList.add('hidden'));
</script>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is a sleep cycle and how long does it last?", "acceptedAnswer": { "@type": "Answer", "text": "A sleep cycle lasts ~90 minutes with 4 stages: light sleep, deep sleep, and REM. Most people complete 5–6 cycles per night." } },
    { "@type": "Question", "name": "Is 6 hours of sleep enough?", "acceptedAnswer": { "@type": "Answer", "text": "For most adults, 6 hours is below the recommended 7–9 hours and can impair cognitive function and immune health." } },
    { "@type": "Question", "name": "What is sleep inertia and how do I avoid it?", "acceptedAnswer": { "@type": "Answer", "text": "Sleep inertia is grogginess from waking mid-cycle. Avoid it by waking at the end of a 90-minute cycle." } },
    { "@type": "Question", "name": "Does everyone take 14 minutes to fall asleep?", "acceptedAnswer": { "@type": "Answer", "text": "The average is 7–20 minutes. Our calculator lets you customize your sleep latency for accurate bedtime recommendations." } },
    { "@type": "Question", "name": "What is REM sleep and why is it important?", "acceptedAnswer": { "@type": "Answer", "text": "REM sleep is the dreaming stage where your brain consolidates memories and processes emotions. It represents ~25% of total sleep time." } },
    { "@type": "Question", "name": "Are 5 sleep cycles better than 6?", "acceptedAnswer": { "@type": "Answer", "text": "For most adults, 5 complete cycles (7.5 hours) is the sweet spot. 6 cycles (9 hours) is ideal for recovering from sleep debt." } },
    { "@type": "Question", "name": "What's the best time to wake up based on sleep science?", "acceptedAnswer": { "@type": "Answer", "text": "The best wake time aligns with natural light exposure, typically 6–8 AM, completing 5–6 full sleep cycles from bedtime." } }
  ]
})} />
