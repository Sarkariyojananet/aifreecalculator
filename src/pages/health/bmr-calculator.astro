            <span>{index + 1}. {faq.q}</span>
            <span class="group-open:rotate-180 transition-transform text-slate-400">▼</span>
          </summary>
          <p class="mt-2 text-slate-600 dark:text-slate-300 leading-relaxed">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>

