<script is:inline>
  const pregTabs = document.querySelectorAll('.btn-preg-tab');
  const pregPanels = document.querySelectorAll('.preg-panel');
  const pregResults = document.getElementById('preg-results');

  pregTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      pregTabs.forEach(t => {
        t.classList.remove('bg-pink-600','text-white','shadow-xs');
        t.classList.add('border','border-slate-300','bg-white','text-slate-700','dark:border-slate-700','dark:bg-slate-800','dark:text-slate-200');
      });
      tab.classList.add('bg-pink-600','text-white','shadow-xs');
      tab.classList.remove('border','border-slate-300','bg-white','text-slate-700');
      pregPanels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');
      pregResults?.classList.add('hidden');
    });
  });

  function addDays(d, n) { const r = new Date(d); r.setDate(r.getDate() + n); return r; }
  function fmtDate(d) { return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }); }

  function showPregResults(lmpDate, dueDays) {
    const today = new Date(); today.setHours(0,0,0,0);
    const dueDate = addDays(lmpDate, dueDays);
    const conceptionDate = addDays(lmpDate, 14);
    const daysPassed = Math.floor((today - lmpDate) / 86400000);
    const weeksPreg = Math.floor(daysPassed / 7);
    const daysExtra = daysPassed % 7;
    const daysLeft = Math.max(0, Math.floor((dueDate - today) / 86400000));

    document.getElementById('preg-res-duedate').textContent = fmtDate(dueDate);
    document.getElementById('preg-res-weeks').textContent = weeksPreg + ' Weeks ' + daysExtra + ' Days';
    document.getElementById('preg-res-lmp').textContent = fmtDate(lmpDate);
    document.getElementById('preg-res-conception').textContent = fmtDate(conceptionDate);
    document.getElementById('preg-res-remaining').textContent = daysLeft + ' Days';

    const trimester = weeksPreg <= 13 ? '1st' : weeksPreg <= 27 ? '2nd' : '3rd';
    document.getElementById('preg-res-trimester').textContent = trimester + ' Trimester';

    const pct = Math.min(100, Math.round(weeksPreg / 40 * 100));
    document.getElementById('preg-progress-bar').style.width = pct + '%';
    document.getElementById('preg-progress-label').textContent = 'Week ' + weeksPreg;

    const badgeClass = 'rounded-xl p-2 border font-bold';
    const active = 'bg-pink-100 dark:bg-pink-950/40 border-pink-200 dark:border-pink-900/40 text-pink-700 dark:text-pink-300';
    const inactive = 'bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-500';
    document.getElementById('t1-badge').className = badgeClass + ' ' + (trimester === '1st' ? active : inactive);
    document.getElementById('t2-badge').className = badgeClass + ' ' + (trimester === '2nd' ? active : inactive);
    document.getElementById('t3-badge').className = badgeClass + ' ' + (trimester === '3rd' ? active : inactive);

    const milestones = [
      { week: 6, label: '💓 Heartbeat detectable' },
      { week: 10, label: '🔬 First prenatal appointment' },
      { week: 12, label: '🧪 Nuchal translucency scan' },
      { week: 16, label: '🔍 Anatomy scan (gender reveal possible)' },
      { week: 20, label: '🎉 Halfway point!' },
      { week: 24, label: '🍬 Glucose screening test' },
      { week: 28, label: '💉 Tdap vaccine recommended' },
      { week: 32, label: '🏥 More frequent appointments begin' },
      { week: 36, label: '🧳 Prepare hospital bag' },
      { week: 37, label: '✅ Baby is considered full term' },
      { week: 40, label: '🍼 Estimated Due Date!' },
    ];
    const mgrid = document.getElementById('milestones-grid');
    mgrid.innerHTML = milestones.map(m => {
      const mDate = fmtDate(addDays(lmpDate, m.week * 7));
      const isPast = weeksPreg >= m.week;
      return `<div class="flex items-start gap-2 p-2 rounded-xl ${isPast ? 'bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-900/40' : 'bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700'}">
        <span class="text-base">${isPast ? '✅' : '○'}</span>
        <div><div class="font-bold text-slate-800 dark:text-slate-200">Week ${m.week}: ${m.label}</div><div class="text-slate-500 text-[11px]">${mDate}</div></div>
      </div>`;
    }).join('');

    pregResults.classList.remove('hidden');
    pregResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function todayStr() { return new Date().toISOString().split('T')[0]; }
  function daysAgoStr(n) { const d = new Date(); d.setDate(d.getDate() - n); return d.toISOString().split('T')[0]; }

  document.getElementById('btn-today')?.addEventListener('click', () => { document.getElementById('lmp-date').value = todayStr(); });
  document.getElementById('btn-2weeks')?.addEventListener('click', () => { document.getElementById('lmp-date').value = daysAgoStr(14); });
  document.getElementById('btn-4weeks')?.addEventListener('click', () => { document.getElementById('lmp-date').value = daysAgoStr(28); });
  document.getElementById('btn-8weeks')?.addEventListener('click', () => { document.getElementById('lmp-date').value = daysAgoStr(56); });

  document.getElementById('form-preg-lmp')?.addEventListener('submit', () => {
    const lmpVal = document.getElementById('lmp-date').value;
    if (!lmpVal) { document.getElementById('err-preg').textContent = 'Please enter your LMP date.'; document.getElementById('err-preg').classList.remove('hidden'); return; }
    document.getElementById('err-preg').classList.add('hidden');
    const cycle = parseInt(document.getElementById('cycle-length').value);
    const adjustment = cycle - 28;
    const lmp = new Date(lmpVal);
    showPregResults(lmp, 280 + adjustment);
  });
  document.getElementById('btn-lmp-clear')?.addEventListener('click', () => pregResults?.classList.add('hidden'));

  document.getElementById('form-preg-conception')?.addEventListener('submit', () => {
    const val = document.getElementById('conception-date').value;
    if (!val) return;
    const conception = new Date(val);
    const lmp = addDays(conception, -14);
    showPregResults(lmp, 280);
  });
  document.getElementById('btn-con-clear')?.addEventListener('click', () => pregResults?.classList.add('hidden'));

  document.getElementById('form-preg-dd')?.addEventListener('submit', () => {
    const val = document.getElementById('due-date').value;
    if (!val) return;
    const due = new Date(val);
    const lmp = addDays(due, -280);
    showPregResults(lmp, 280);
  });
  document.getElementById('btn-dd-clear')?.addEventListener('click', () => pregResults?.classList.add('hidden'));

  document.getElementById('form-preg-ivf')?.addEventListener('submit', () => {
    const val = document.getElementById('ivf-date').value;
    const day = parseInt(document.getElementById('ivf-day').value);
    if (!val) return;
    const transfer = new Date(val);
    const daysToAdd = day === 5 ? 261 : 263;
    const lmpEquiv = addDays(transfer, -(day === 5 ? 19 : 17));
    showPregResults(lmpEquiv, 280);
  });
  document.getElementById('btn-ivf-clear')?.addEventListener('click', () => pregResults?.classList.add('hidden'));

  function addDays(d, n) { const r = new Date(d); r.setDate(r.getDate() + n); return r; }
</script>

