---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Macro Calculator – Calculate Protein, Carbs, Fats & Calories (IIFYM)"
  description="Free macro calculator for weight loss, muscle gain, and keto. Calculate exact daily protein, carbohydrate, and fat grams based on your body and fitness goals."
  category="Health"
  calculatorName="Macro Calculator"
  slug="macro-calculator"
  keywords={[
    'macro calculator',
    'macronutrient calculator',
    'iifym calculator',
    'protein calculator',
    'daily macro calculator',
    'keto macro calculator',
    'bodybuilding macro calculator',
    'macro split calculator',
    'macros for fat loss'
  ]}
>
  <div class="space-y-6">

    <!-- PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Profiles:
        </span>
        <button type="button" class="btn-macro-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-gender="male" data-age="28" data-wt="78" data-ht="178" data-act="1.55" data-goal="fat_loss" data-diet="high_protein">
          Male 78kg (Fat Loss + High Protein)
        </button>
        <button type="button" class="btn-macro-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-gender="female" data-age="26" data-wt="62" data-ht="165" data-act="1.375" data-goal="fat_loss" data-diet="balanced">
          Female 62kg (Toning + Balanced)
        </button>
        <button type="button" class="btn-macro-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-gender="male" data-age="24" data-wt="70" data-ht="175" data-act="1.725" data-goal="lean_bulk" data-diet="high_protein">
          Male 70kg (Muscle Building Surplus)
        </button>
      </div>
    </div>

    <!-- MAIN CALCULATOR GRID -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      
      <!-- INPUT PANEL (7 cols) -->
      <div class="lg:col-span-7 space-y-5 rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:bg-slate-900 sm:p-7">
        
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🥗</span> Body Stats & Preferences
          </h2>
          <!-- Unit Selector -->
          <div class="flex items-center gap-1 rounded-xl bg-slate-100 p-1 dark:bg-slate-800 text-xs font-semibold">
            <button type="button" id="unit-metric" class="btn-macro-unit active rounded-lg bg-white px-2.5 py-1 text-slate-900 shadow-xs dark:bg-slate-700 dark:text-white">Metric (kg/cm)</button>
            <button type="button" id="unit-imperial" class="btn-macro-unit rounded-lg px-2.5 py-1 text-slate-600 dark:text-slate-300">Imperial (lbs/in)</button>
          </div>
        </div>

        <!-- Gender & Age -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">Gender</label>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" id="gender-male" class="btn-gender active rounded-xl bg-blue-600 py-2 text-xs sm:text-sm font-bold text-white shadow-xs cursor-pointer transition" data-gender="male">Male</button>
              <button type="button" id="gender-female" class="btn-gender rounded-xl border border-slate-300 bg-white py-2 text-xs sm:text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-gender="female">Female</button>
            </div>
          </div>
          <div class="space-y-1.5">
            <label for="macro-age" class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">Age</label>
            <input type="number" id="macro-age" min="15" max="95" value="28" class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2 px-3 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
        </div>

        <!-- Height & Weight -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="macro-weight" class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200" id="label-weight">Weight (kg)</label>
            <input type="number" id="macro-weight" min="30" max="300" step="0.5" value="75" class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2 px-3 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
          <div class="space-y-1.5">
            <label for="macro-height" class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200" id="label-height">Height (cm)</label>
            <input type="number" id="macro-height" min="100" max="250" value="175" class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2 px-3 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
        </div>

        <!-- Activity Level -->
        <div class="space-y-1.5">
          <label for="macro-activity" class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">Activity Level</label>
          <select id="macro-activity" class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 px-3 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white">
            <option value="1.2">Sedentary (Desk job, minimal exercise)</option>
            <option value="1.375">Lightly Active (Exercise 1–3 days/week)</option>
            <option value="1.55" selected>Moderately Active (Exercise 3–5 days/week)</option>
            <option value="1.725">Very Active (Hard training 6–7 days/week)</option>
            <option value="1.9">Extra Active (Intense daily training or physical job)</option>
          </select>
        </div>

        <!-- Goal & Diet Type -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="macro-goal" class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">Primary Goal</label>
            <select id="macro-goal" class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 px-3 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white">
              <option value="fat_loss" selected>Fat Loss (Moderate Deficit -18%)</option>
              <option value="aggressive_loss">Aggressive Cut (Deficit -25%)</option>
              <option value="maintain">Maintain Current Weight</option>
              <option value="lean_bulk">Lean Muscle Gain (Surplus +10%)</option>
              <option value="bulk">Heavy Muscle Bulk (Surplus +18%)</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="macro-diet" class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">Diet Protocol</label>
            <select id="macro-diet" class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 px-3 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white">
              <option value="balanced">Balanced (30% P / 40% C / 30% F)</option>
              <option value="high_protein" selected>High Protein / Gym (40% P / 35% C / 25% F)</option>
              <option value="low_carb">Low Carb (35% P / 20% C / 45% F)</option>
              <option value="keto">Ketogenic Keto (25% P / 5% C / 70% F)</option>
            </select>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 pt-3 border-t border-slate-200 dark:border-slate-800">
          <button
            type="button"
            id="btn-calc-macro"
            class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3.5 text-center text-sm font-black text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
          >
            Calculate Macros →
          </button>
          <button
            type="button"
            id="btn-clear-macro"
            class="rounded-xl border border-slate-300 bg-white px-5 py-3.5 text-center text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer"
          >
            Clear (✕)
          </button>
        </div>

      </div>

      <!-- RESULTS PLACEHOLDER (Visible until Calculate is clicked) -->
      <div id="macro-results-placeholder" class="lg:col-span-5 flex flex-col items-center justify-center p-8 text-center rounded-3xl border border-dashed border-slate-300 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 min-h-85">
        <span class="text-4xl mb-3">🥗</span>
        <h4 class="text-base font-bold text-slate-800 dark:text-slate-200">Ready to Calculate</h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs">Fill in your age, gender, body metrics, activity level, and fitness goal, then click <strong>Calculate Macros</strong> to get your personalized daily protein, carb, and fat targets.</p>
      </div>

      <!-- RESULTS PANEL (Hidden until Calculate is clicked) -->
      <div id="results-section" class="hidden lg:col-span-5 flex-col justify-between space-y-4 rounded-3xl border border-blue-200/80 bg-linear-to-b from-blue-50/60 to-white p-5 shadow-xl shadow-slate-900/5 dark:border-blue-900/40 dark:from-slate-900 dark:to-slate-950 sm:p-7">
        
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Daily Target Calories</div>
          <div class="mt-2">
            <div class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono" id="res-target-calories">
              2,150 kcal
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1" id="res-tdee-summary">
              Maintenance TDEE: 2,520 kcal | Deficit: -370 kcal
            </div>
          </div>
        </div>

        <!-- Macro 3 Cards Grid -->
        <div class="grid grid-cols-3 gap-2.5 pt-2 border-t border-slate-200/80 dark:border-slate-800">
          
          <!-- Protein -->
          <div class="rounded-xl border border-blue-200 bg-blue-50/70 p-3 text-center dark:border-blue-900/60 dark:bg-blue-950/40">
            <div class="text-[11px] font-bold text-blue-700 dark:text-blue-300">PROTEIN</div>
            <div class="text-xl sm:text-2xl font-black text-blue-800 dark:text-blue-200 font-mono mt-1" id="res-protein-grams">215g</div>
            <div class="text-[10px] text-blue-600 dark:text-blue-400 mt-0.5" id="res-protein-cals">860 kcal (40%)</div>
          </div>

          <!-- Carbs -->
          <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-3 text-center dark:border-amber-900/60 dark:bg-amber-950/40">
            <div class="text-[11px] font-bold text-amber-700 dark:text-amber-300">CARBS</div>
            <div class="text-xl sm:text-2xl font-black text-amber-800 dark:text-amber-200 font-mono mt-1" id="res-carbs-grams">188g</div>
            <div class="text-[10px] text-amber-600 dark:text-amber-400 mt-0.5" id="res-carbs-cals">752 kcal (35%)</div>
          </div>

          <!-- Fats -->
          <div class="rounded-xl border border-rose-200 bg-rose-50/70 p-3 text-center dark:border-rose-900/60 dark:bg-rose-950/40">
            <div class="text-[11px] font-bold text-rose-700 dark:text-rose-300">FATS</div>
            <div class="text-xl sm:text-2xl font-black text-rose-800 dark:text-rose-200 font-mono mt-1" id="res-fats-grams">60g</div>
            <div class="text-[10px] text-rose-600 dark:text-rose-400 mt-0.5" id="res-fats-cals">540 kcal (25%)</div>
          </div>

        </div>

        <!-- Meals Distribution Summary -->
        <div class="rounded-2xl border border-slate-200 bg-white/80 p-3.5 dark:border-slate-800 dark:bg-slate-900/80 space-y-1.5">
          <div class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center justify-between">
            <span>🍽️ Per-Meal Breakdown (4 Meals/Day):</span>
            <select id="select-meals-per-day" class="text-[11px] font-bold rounded-lg border border-slate-300 bg-white px-2 py-0.5 text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
              <option value="3">3 Meals</option>
              <option value="4" selected>4 Meals</option>
              <option value="5">5 Meals</option>
            </select>
          </div>
          <div class="text-[11px] text-slate-600 dark:text-slate-400" id="res-per-meal-text">
            Each meal: <strong>~54g Protein</strong>, <strong>~47g Carbs</strong>, and <strong>~15g Fats</strong>.
          </div>
        </div>

        <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 p-3 text-xs text-emerald-800 dark:border-emerald-900/40 dark:bg-emerald-950/30 dark:text-emerald-300">
          💡 <strong>IIFYM Rule:</strong> As long as you hit these daily target grams consistently and eat 80%+ whole foods, you will achieve your physique goals without cutting out your favorite foods!
        </div>

      </div>

    </div>

  </div>

  <!-- EDUCATIONAL CONTENT -->
  <Fragment slot="content">
    <article class="prose prose-slate dark:prose-invert max-w-none text-sm leading-relaxed space-y-5 pt-4">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">What Are Macros? The Complete Guide to Macronutrient Tracking & IIFYM</h2>
      <p>
        In nutritional science, <strong>macronutrients ("macros")</strong> are the three foundational nutrients that the human body requires in substantial quantities to synthesize energy, repair cellular tissues, support brain function, and regulate vital hormone production. While micronutrients (vitamins and minerals) are essential in milligram doses, macronutrients provide 100% of the caloric energy that fuels metabolic activity:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 not-prose my-3">
        <div class="rounded-xl border border-blue-200 bg-blue-50/60 p-3.5 text-xs dark:border-blue-900/50 dark:bg-blue-950/30">
          <div class="font-bold text-blue-700 dark:text-blue-300 text-sm mb-1">🍗 Protein (4 kcal/g)</div>
          <p class="text-slate-600 dark:text-slate-400">Essential for muscle protein synthesis (MPS), tissue repair, enzyme and neurotransmitter creation, and blunting hunger via peptide YY release.</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-3.5 text-xs dark:border-amber-900/50 dark:bg-amber-950/30">
          <div class="font-bold text-amber-700 dark:text-amber-300 text-sm mb-1">🍚 Carbs (4 kcal/g)</div>
          <p class="text-slate-600 dark:text-slate-400">The body's primary energy currency. Converted to glucose for cognitive functioning and stored as glycogen in liver and muscles for high-intensity gym performance.</p>
        </div>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-3.5 text-xs dark:border-emerald-900/50 dark:bg-emerald-950/30">
          <div class="font-bold text-emerald-700 dark:text-emerald-300 text-sm mb-1">🥑 Fats (9 kcal/g)</div>
          <p class="text-slate-600 dark:text-slate-400">Vital for steroid hormone production (testosterone, progesterone, estrogen), structural cell wall membranes, and the absorption of fat-soluble vitamins (A, D, E, K).</p>
        </div>
      </div>
      <p>
        Rather than merely counting total calories, tracking specific macronutrients (known as <strong>IIFYM — If It Fits Your Macros</strong> or flexible dieting) guarantees that your calorie intake matches your specific body composition objectives—preventing lean muscle loss while stripping away body fat, or building clean muscle without unnecessary adipose accumulation.
      </p>

      <h3 class="text-base font-bold text-slate-900 dark:text-white">How Are Your Daily Caloric Targets & Macros Calculated?</h3>
      <p>
        Our calculator employs the peer-reviewed <strong>Mifflin-St Jeor Equation</strong>, recognized by the Academy of Nutrition and Dietetics as the most accurate standard for predicting Basal Metabolic Rate (BMR):
      </p>
      <div class="p-3.5 bg-slate-100 dark:bg-slate-800/80 rounded-xl font-mono text-xs text-center border border-slate-200 dark:border-slate-700">
        Men BMR = (10 × Weight in kg) + (6.25 × Height in cm) - (5 × Age) + 5<br/>
        Women BMR = (10 × Weight in kg) + (6.25 × Height in cm) - (5 × Age) - 161
      </div>
      <p>
        Next, your BMR is scaled by your Physical Activity Level (PAL) multiplier to establish your <strong>Total Daily Energy Expenditure (TDEE)</strong>. Caloric adjustments are then applied based on your physical target:
      </p>
      <ul class="list-disc pl-5 space-y-1 text-slate-700 dark:text-slate-300">
        <li><strong>Fat Loss / Cutting:</strong> Standard 20% caloric deficit (0.80 × TDEE) preserves metabolic rate while promoting 0.5 kg to 1 kg of fat loss per week.</li>
        <li><strong>Maintenance / Body Recomposition:</strong> Exact 100% of TDEE (1.00 × TDEE) allows gradual recomposition for beginners and returning lifters.</li>
        <li><strong>Lean Muscle Building / Bulking:</strong> Controlled 10% to 15% caloric surplus (1.10 to 1.15 × TDEE) supplies energy for progressive resistance overload without excessive fat gain.</li>
      </ul>

      <h3 class="text-base font-bold text-slate-900 dark:text-white">Popular Macro Split Models Compared</h3>
      <p>
        Depending on your dietary preferences, athletic sport, or insulin sensitivity, macronutrient distributions can be tailored across different proven ratios:
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse border border-slate-200 dark:border-slate-800">
          <thead>
            <tr class="bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200">
              <th class="p-2.5 font-bold">Diet Style / Macro Split</th>
              <th class="p-2.5 font-bold">Carbs %</th>
              <th class="p-2.5 font-bold">Protein %</th>
              <th class="p-2.5 font-bold">Fat %</th>
              <th class="p-2.5 font-bold">Best Suited For</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-600 dark:text-slate-300">
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Balanced Lifestyle (40/30/30)</td>
              <td class="p-2.5 font-mono">40%</td>
              <td class="p-2.5 font-mono font-bold text-blue-600">30%</td>
              <td class="p-2.5 font-mono">30%</td>
              <td class="p-2.5">General health, sustainable fat loss, recreational fitness enthusiasts.</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Bodybuilder High-Protein (40/40/20)</td>
              <td class="p-2.5 font-mono">40%</td>
              <td class="p-2.5 font-mono font-bold text-blue-600">40%</td>
              <td class="p-2.5 font-mono">20%</td>
              <td class="p-2.5">Intense resistance training, cutting phases, maximum muscle retention.</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Low-Carb / Ketogenic (5/25/70)</td>
              <td class="p-2.5 font-mono">5%</td>
              <td class="p-2.5 font-mono font-bold text-blue-600">25%</td>
              <td class="p-2.5 font-mono font-bold text-emerald-600">70%</td>
              <td class="p-2.5">Insulin-resistant individuals, sedentary fat loss, strict keto followers.</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Endurance Athlete (60/20/20)</td>
              <td class="p-2.5 font-mono font-bold text-amber-600">60%</td>
              <td class="p-2.5 font-mono">20%</td>
              <td class="p-2.5 font-mono">20%</td>
              <td class="p-2.5">Marathon runners, cyclists, triathletes requiring continuous glycogen replenishment.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-base font-bold text-slate-900 dark:text-white">Step-by-Step Macro Calculation Walkthrough (Real Example)</h3>
      <p>
        Consider a <strong>30-year-old male, 175 cm tall, weighing 75 kg</strong>, who exercises 4 times a week (Moderate Activity, PAL = 1.55) and desires fat loss:
      </p>
      <ol class="list-decimal pl-5 space-y-1.5 text-slate-700 dark:text-slate-300">
        <li><strong>Calculate BMR:</strong> (10 × 75) + (6.25 × 175) - (5 × 30) + 5 = 750 + 1,093.75 - 150 + 5 = <strong>1,699 kcal</strong>.</li>
        <li><strong>Calculate Maintenance (TDEE):</strong> 1,699 × 1.55 = <strong>2,633 kcal/day</strong>.</li>
        <li><strong>Apply 20% Fat Loss Deficit:</strong> 2,633 × 0.80 ≈ <strong>2,106 kcal/day</strong>.</li>
        <li><strong>Convert into Grams (Balanced 40/30/30 Split):</strong>
          <ul class="list-circle pl-5 mt-1 space-y-0.5">
            <li><strong>Protein (30%):</strong> 2,106 × 0.30 = 632 kcal ÷ 4 = <strong>158 g/day</strong> (approx. 2.1 g/kg of body weight).</li>
            <li><strong>Carbohydrates (40%):</strong> 2,106 × 0.40 = 842 kcal ÷ 4 = <strong>211 g/day</strong>.</li>
            <li><strong>Fats (30%):</strong> 2,106 × 0.30 = 632 kcal ÷ 9 = <strong>70 g/day</strong>.</li>
          </ul>
        </li>
      </ol>

      <h3 class="text-base font-bold text-slate-900 dark:text-white">Common Macro Tracking Pitfalls & Practical Solutions</h3>
      <ul class="list-disc pl-5 space-y-1.5 text-slate-700 dark:text-slate-300">
        <li><strong>Raw vs. Cooked Weight Discrepancies:</strong> Food nutrition facts on apps like MyFitnessPal or Cronometer almost always correspond to <strong>raw/uncooked weight</strong>. Meat loses 20% to 25% of its water weight when grilled, while rice and pasta absorb 200% to 300% water weight. Be consistent in logging raw weights.</li>
        <li><strong>Hidden Cooking Oils & Sauces:</strong> A single tablespoon of olive oil, butter, or mayonnaise contains 120 calories and 14 grams of fat. Failing to weigh cooking oils will inadvertently erase your caloric deficit.</li>
        <li><strong>Overlooking Dietary Fiber:</strong> Never compromise fiber for simple carbohydrates. Target 14 grams of dietary fiber for every 1,000 calories consumed (typically 25g–38g daily) to optimize gut microbiome health and stabilize post-prandial blood glucose spikes.</li>
      </ul>
    </article>
  </Fragment>

  <!-- FAQS -->
  <Fragment slot="faq">
    <div class="space-y-3">
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900" open>
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">How much protein should I eat per day for muscle building and fat loss?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Extensive sports nutrition meta-analyses recommend consuming between <strong>1.6 to 2.2 grams of protein per kilogram of body weight</strong> (0.7 to 1.0 grams per pound) daily. When in a deep caloric deficit, protein can be elevated up to 2.4 g/kg to protect lean muscle tissue from catabolism.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">Why are dietary fats calculated at 9 calories per gram instead of 4?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Fat molecules (triglycerides) have longer carbon-hydrogen chains with minimal oxygen atoms compared to proteins and carbohydrates, allowing them to store more than twice the chemical potential energy—9 calories per gram versus 4 calories per gram for proteins and carbohydrates.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">What is the difference between counting calories and tracking macros?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Counting calories only dictates energy balance (weight gain or weight loss). Tracking macros dictates <em>what kind</em> of weight you gain or lose. By ensuring adequate protein, you lose body fat while retaining muscle; by optimizing carbohydrates, you maintain high gym performance and workout intensity.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">Can I build muscle and lose body fat at the same time (Body Recomposition)?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Yes! Simultaneous muscle growth and fat loss (body recomposition) is achievable for resistance training beginners, individuals returning after a layoff, or people with higher body fat percentages. It requires eating at maintenance calories with a high protein intake (2.0+ g/kg) and progressive strength training.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">How often should I recalculate my macronutrient targets?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">You should recalculate your macros whenever your body weight shifts by 3 to 5 kilograms (6 to 10 lbs), when your training frequency changes significantly, or if your weekly average weight remains stagnant for more than 2 to 3 consecutive weeks.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">Does the timing of my macro meals matter (meal frequency)?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Total daily macronutrient intake is responsible for 85% to 90% of your body composition results. Meal timing plays a minor role, though distributing protein across 3 to 5 meals with 25g to 40g per serving triggers muscle protein synthesis multiple times throughout the day.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">Should I weigh my food raw or cooked when tracking macros?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Weighing food raw and uncooked on a digital kitchen scale is the most accurate method because cooking times and water loss/absorption vary dramatically. When logging raw ingredients, ensure the nutrition database entry matches raw specifications.</p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<script is:inline>
(function initMacroCalculator() {
  let isMetric = true;
  let gender = 'male';

  const unitMetricBtn = document.getElementById('unit-metric');
  const unitImperialBtn = document.getElementById('unit-imperial');
  const genderMaleBtn = document.getElementById('gender-male');
  const genderFemaleBtn = document.getElementById('gender-female');

  const ageInput = document.getElementById('macro-age');
  const weightInput = document.getElementById('macro-weight');
  const heightInput = document.getElementById('macro-height');
  const labelWeight = document.getElementById('label-weight');
  const labelHeight = document.getElementById('label-height');

  const activitySelect = document.getElementById('macro-activity');
  const goalSelect = document.getElementById('macro-goal');
  const dietSelect = document.getElementById('macro-diet');
  const mealsSelect = document.getElementById('select-meals-per-day');

  const resTargetCalories = document.getElementById('res-target-calories');
  const resTdeeSummary = document.getElementById('res-tdee-summary');
  const resProteinGrams = document.getElementById('res-protein-grams');
  const resProteinCals = document.getElementById('res-protein-cals');
  const resCarbsGrams = document.getElementById('res-carbs-grams');
  const resCarbsCals = document.getElementById('res-carbs-cals');
  const resFatsGrams = document.getElementById('res-fats-grams');
  const resFatsCals = document.getElementById('res-fats-cals');
  const resPerMealText = document.getElementById('res-per-meal-text');

  function calculate() {
    const age = parseFloat(ageInput?.value) || 25;
    let wt = parseFloat(weightInput?.value) || 70;
    let ht = parseFloat(heightInput?.value) || 175;

    // Convert imperial to metric if needed
    const weightKg = isMetric ? wt : wt * 0.453592;
    const heightCm = isMetric ? ht : ht * 2.54;

    const activity = parseFloat(activitySelect?.value) || 1.55;
    const goal = goalSelect?.value || 'fat_loss';
    const diet = dietSelect?.value || 'high_protein';
    const meals = parseInt(mealsSelect?.value) || 4;

    // BMR
    let bmr = 10 * weightKg + 6.25 * heightCm - 5 * age;
    bmr = gender === 'male' ? bmr + 5 : bmr - 161;

    // TDEE
    const tdee = Math.round(bmr * activity);

    // Target Calories
    let target = tdee;
    if (goal === 'fat_loss') target = Math.round(tdee * 0.82);
    else if (goal === 'aggressive_loss') target = Math.round(tdee * 0.75);
    else if (goal === 'lean_bulk') target = Math.round(tdee * 1.10);
    else if (goal === 'bulk') target = Math.round(tdee * 1.18);

    target = Math.max(gender === 'female' ? 1200 : 1500, target);

    // Ratios
    let pR = 0.30, cR = 0.40, fR = 0.30;
    if (diet === 'high_protein') { pR = 0.40; cR = 0.35; fR = 0.25; }
    else if (diet === 'low_carb') { pR = 0.35; cR = 0.20; fR = 0.45; }
    else if (diet === 'keto') { pR = 0.25; cR = 0.05; fR = 0.70; }

    const pCal = target * pR;
    const cCal = target * cR;
    const fCal = target * fR;

    const pG = Math.round(pCal / 4);
    const cG = Math.round(cCal / 4);
    const fG = Math.round(fCal / 9);

    if (resTargetCalories) resTargetCalories.textContent = `${target.toLocaleString()} kcal`;
    if (resTdeeSummary) {
      const diff = target - tdee;
      const diffStr = diff === 0 ? 'Maintenance' : diff > 0 ? `+${diff} kcal surplus` : `${diff} kcal deficit`;
      resTdeeSummary.textContent = `Maintenance TDEE: ${tdee.toLocaleString()} kcal | ${diffStr}`;
    }

    if (resProteinGrams) resProteinGrams.textContent = `${pG}g`;
    if (resProteinCals) resProteinCals.textContent = `${Math.round(pCal)} kcal (${Math.round(pR * 100)}%)`;

    if (resCarbsGrams) resCarbsGrams.textContent = `${cG}g`;
    if (resCarbsCals) resCarbsCals.textContent = `${Math.round(cCal)} kcal (${Math.round(cR * 100)}%)`;

    if (resFatsGrams) resFatsGrams.textContent = `${fG}g`;
    if (resFatsCals) resFatsCals.textContent = `${Math.round(fCal)} kcal (${Math.round(fR * 100)}%)`;

    if (resPerMealText) {
      resPerMealText.innerHTML = `Each meal: <strong>~${(pG / meals).toFixed(1)}g Protein</strong>, <strong>~${(cG / meals).toFixed(1)}g Carbs</strong>, and <strong>~${(fG / meals).toFixed(1)}g Fats</strong>.`;
    }
  }

  let hasCalculated = false;
  const btnCalc = document.getElementById('btn-calc-macro');
  const btnClear = document.getElementById('btn-clear-macro');
  const resultsPlaceholder = document.getElementById('macro-results-placeholder');
  const resultsSection = document.getElementById('results-section');

  function showResults() {
    hasCalculated = true;
    calculate();
    resultsPlaceholder?.classList.add('hidden');
    resultsSection?.classList.remove('hidden');
    resultsSection?.classList.add('flex');
    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.remove('hidden');
    resultsSection?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function clearCalculator() {
    hasCalculated = false;
    isMetric = true;
    unitMetricBtn?.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-xs', 'dark:bg-slate-700', 'dark:text-white');
    unitImperialBtn?.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-xs', 'dark:bg-slate-700', 'dark:text-white');
    if (labelWeight) labelWeight.textContent = 'Weight (kg)';
    if (labelHeight) labelHeight.textContent = 'Height (cm)';

    gender = 'male';
    genderMaleBtn?.classList.add('active', 'bg-blue-600', 'text-white');
    genderMaleBtn?.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    genderFemaleBtn?.classList.remove('active', 'bg-blue-600', 'text-white');
    genderFemaleBtn?.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700');

    if (ageInput) ageInput.value = '28';
    if (weightInput) weightInput.value = '75';
    if (heightInput) heightInput.value = '175';
    if (activitySelect) activitySelect.value = '1.55';
    if (goalSelect) goalSelect.value = 'cut_moderate';
    if (dietSelect) dietSelect.value = 'high_protein';
    if (mealsSelect) mealsSelect.value = '4';

    resultsPlaceholder?.classList.remove('hidden');
    resultsSection?.classList.add('hidden');
    resultsSection?.classList.remove('flex');
    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');
  }

  btnCalc?.addEventListener('click', showResults);
  btnClear?.addEventListener('click', clearCalculator);

  // Unit toggle
  unitMetricBtn?.addEventListener('click', () => {
    if (isMetric) return;
    isMetric = true;
    unitMetricBtn.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-xs', 'dark:bg-slate-700', 'dark:text-white');
    unitImperialBtn?.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-xs', 'dark:bg-slate-700', 'dark:text-white');
    if (labelWeight) labelWeight.textContent = 'Weight (kg)';
    if (labelHeight) labelHeight.textContent = 'Height (cm)';
    if (weightInput) weightInput.value = Math.round(parseFloat(weightInput.value) * 0.453592) || 75;
    if (heightInput) heightInput.value = Math.round(parseFloat(heightInput.value) * 2.54) || 175;
    if (hasCalculated) calculate();
  });

  unitImperialBtn?.addEventListener('click', () => {
    if (!isMetric) return;
    isMetric = false;
    unitImperialBtn.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-xs', 'dark:bg-slate-700', 'dark:text-white');
    unitMetricBtn?.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-xs', 'dark:bg-slate-700', 'dark:text-white');
    if (labelWeight) labelWeight.textContent = 'Weight (lbs)';
    if (labelHeight) labelHeight.textContent = 'Height (inches)';
    if (weightInput) weightInput.value = Math.round(parseFloat(weightInput.value) * 2.20462) || 165;
    if (heightInput) heightInput.value = Math.round(parseFloat(heightInput.value) / 2.54) || 69;
    if (hasCalculated) calculate();
  });

  // Gender toggle
  genderMaleBtn?.addEventListener('click', () => {
    gender = 'male';
    genderMaleBtn.classList.add('active', 'bg-blue-600', 'text-white');
    genderMaleBtn.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    genderFemaleBtn?.classList.remove('active', 'bg-blue-600', 'text-white');
    genderFemaleBtn?.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    if (hasCalculated) calculate();
  });

  genderFemaleBtn?.addEventListener('click', () => {
    gender = 'female';
    genderFemaleBtn.classList.add('active', 'bg-blue-600', 'text-white');
    genderFemaleBtn.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    genderMaleBtn?.classList.remove('active', 'bg-blue-600', 'text-white');
    genderMaleBtn?.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    if (hasCalculated) calculate();
  });

  [ageInput, weightInput, heightInput, activitySelect, goalSelect, dietSelect, mealsSelect].forEach(el => {
    el?.addEventListener('input', () => { if (hasCalculated) calculate(); });
    el?.addEventListener('change', () => { if (hasCalculated) calculate(); });
  });

  // Presets
  document.querySelectorAll('.btn-macro-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const g = btn.dataset.gender;
      if (g === 'female') genderFemaleBtn?.click();
      else genderMaleBtn?.click();

      if (ageInput) ageInput.value = btn.dataset.age;
      if (unitMetricBtn) unitMetricBtn.click();
      if (weightInput) weightInput.value = btn.dataset.wt;
      if (heightInput) heightInput.value = btn.dataset.ht;
      if (activitySelect) activitySelect.value = btn.dataset.act;
      if (goalSelect) goalSelect.value = btn.dataset.goal;
      if (dietSelect) dietSelect.value = btn.dataset.diet;
      showResults();
    });
  });
})();
</script>
