<script is:inline>
  // Tab switching logic
  const mapTabs = document.querySelectorAll('.btn-map-tab');
  const mapPanels = document.querySelectorAll('.map-panel');

  mapTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      mapTabs.forEach(t => {
        t.classList.remove('bg-rose-600', 'text-white', 'shadow-xs');
        t.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
      });
      tab.classList.add('bg-rose-600', 'text-white', 'shadow-xs');
      tab.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700');
      mapPanels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');
    });
  });

  // Presets handling
  document.querySelectorAll('.btn-map-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const sbp = btn.dataset.sbp;
      const dbp = btn.dataset.dbp;
      const hr = btn.dataset.hr;
      
      const inSbp = document.getElementById('input-sbp');
      const inDbp = document.getElementById('input-dbp');
      const inHr = document.getElementById('input-hr');
      
      if (inSbp && inDbp) {
        inSbp.value = sbp;
        inDbp.value = dbp;
        if (inHr && hr) inHr.value = hr;
        calculateStandardMap();
      }
    });
  });

  function calculateStandardMap() {
    const sbp = parseFloat(document.getElementById('input-sbp')?.value);
    const dbp = parseFloat(document.getElementById('input-dbp')?.value);
    const hr = parseFloat(document.getElementById('input-hr')?.value) || 72;

    if (isNaN(sbp) || isNaN(dbp) || sbp <= dbp || sbp <= 0 || dbp <= 0) {
      alert('Please enter valid blood pressure values where Systolic pressure is greater than Diastolic pressure.');
      return;
    }

    // Standard MAP Formula: DBP + 1/3 (SBP - DBP)
    const pp = sbp - dbp;
    const map = dbp + (pp / 3);

    renderResults(map, sbp, dbp, pp);
  }

  function calculateNursingMap() {
    const sbp = parseFloat(document.getElementById('nursing-sbp')?.value);
    const dbp = parseFloat(document.getElementById('nursing-dbp')?.value);
    const targetMap = parseFloat(document.getElementById('nursing-target-map')?.value) || 65;

    if (isNaN(sbp) || isNaN(dbp) || sbp <= dbp || sbp <= 0 || dbp <= 0) {
      alert('Please enter valid blood pressure values.');
      return;
    }

    const pp = sbp - dbp;
    const map = dbp + (pp / 3);

    renderResults(map, sbp, dbp, pp, targetMap);
  }

  function renderResults(map, sbp, dbp, pp, customTarget = 65) {
    const mapValEl = document.getElementById('res-map-val');
    const badgeEl = document.getElementById('res-badge');
    const ppValEl = document.getElementById('res-pp-val');
    const ppDescEl = document.getElementById('res-pp-desc');
    const bpValEl = document.getElementById('res-bp-val');
    const sepsisTargetEl = document.getElementById('res-sepsis-target');
    const neuroTargetEl = document.getElementById('res-neuro-target');
    const statusSummaryEl = document.getElementById('res-status-summary');
    const gaugePinEl = document.getElementById('map-gauge-pin');
    const gaugeLabelEl = document.getElementById('res-gauge-label');

    const descRenalEl = document.getElementById('desc-renal');
    const descCerebralEl = document.getElementById('desc-cerebral');
    const descCoronaryEl = document.getElementById('desc-coronary');

    const cardRenal = document.getElementById('card-renal');
    const cardCerebral = document.getElementById('card-cerebral');
    const cardCoronary = document.getElementById('card-coronary');

    if (!mapValEl) return;

    // Display primary MAP
    mapValEl.textContent = map.toFixed(1);
    bpValEl.textContent = `${Math.round(sbp)} / ${Math.round(dbp)} mmHg`;
    ppValEl.textContent = `${Math.round(pp)} mmHg`;

    // Pulse pressure descriptor
    if (pp < 30) {
      ppDescEl.textContent = 'Narrow Pulse Pressure (Low Stroke Volume)';
      ppDescEl.className = 'text-[11px] text-red-600 font-semibold';
    } else if (pp > 60) {
      ppDescEl.textContent = 'Wide Pulse Pressure (Arterial Stiffness)';
      ppDescEl.className = 'text-[11px] text-amber-600 font-semibold';
    } else {
      ppDescEl.textContent = 'Normal Pulse Pressure (Healthy Elasticity)';
      ppDescEl.className = 'text-[11px] text-emerald-600 font-semibold';
    }

    // Sepsis target delta (>= 65 mmHg)
    const sepsisDelta = map - 65;
    if (sepsisDelta >= 0) {
      sepsisTargetEl.textContent = `Met (+${sepsisDelta.toFixed(1)} mmHg)`;
      sepsisTargetEl.className = 'mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400';
    } else {
      sepsisTargetEl.textContent = `Unmet (${sepsisDelta.toFixed(1)} mmHg)`;
      sepsisTargetEl.className = 'mt-1 text-sm font-bold text-red-600 dark:text-red-400';
    }

    // Neuro target delta (>= 80 mmHg)
    const neuroDelta = map - 80;
    if (neuroDelta >= 0) {
      neuroTargetEl.textContent = `Met (+${neuroDelta.toFixed(1)} mmHg)`;
      neuroTargetEl.className = 'mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400';
    } else {
      neuroTargetEl.textContent = `Unmet (${neuroDelta.toFixed(1)} mmHg)`;
      neuroTargetEl.className = 'mt-1 text-sm font-bold text-amber-600 dark:text-amber-400';
    }

    // Position on visual gauge (scale range: 40 to 140 mmHg = 100 span)
    const gaugePct = Math.min(100, Math.max(0, ((map - 40) / 100) * 100));
    if (gaugePinEl) {
      gaugePinEl.style.left = `${gaugePct}%`;
    }

    // Hemodynamic Classification & Organ Status
    if (map < 60) {
      badgeEl.textContent = 'Critical Hypoperfusion';
      badgeEl.className = 'rounded-full px-2.5 py-0.5 text-xs font-extrabold bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300';
      statusSummaryEl.textContent = 'Hypoperfusion / Shock';
      statusSummaryEl.className = 'mt-1 text-sm font-bold text-red-600 dark:text-red-400';
      gaugeLabelEl.textContent = `${map.toFixed(1)} mmHg (Critical Shock)`;
      gaugeLabelEl.className = 'text-red-600 dark:text-red-400 font-bold';

      descRenalEl.textContent = 'Critically low filtration pressure. High risk of oliguria and acute tubular necrosis.';
      descCerebralEl.textContent = 'Cerebral perfusion compromised. Risk of ischemic injury and altered mental state.';
      descCoronaryEl.textContent = 'Insufficient diastolic coronary driving pressure; risk of myocardial ischemia.';

      cardRenal.className = 'rounded-xl border border-red-300 bg-red-50/70 p-3 dark:border-red-900/60 dark:bg-red-950/40';
      cardCerebral.className = 'rounded-xl border border-red-300 bg-red-50/70 p-3 dark:border-red-900/60 dark:bg-red-950/40';
      cardCoronary.className = 'rounded-xl border border-red-300 bg-red-50/70 p-3 dark:border-red-900/60 dark:bg-red-950/40';

    } else if (map < 65) {
      badgeEl.textContent = 'Borderline Perfusion';
      badgeEl.className = 'rounded-full px-2.5 py-0.5 text-xs font-extrabold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
      statusSummaryEl.textContent = 'Suboptimal MAP';
      statusSummaryEl.className = 'mt-1 text-sm font-bold text-amber-600 dark:text-amber-400';
      gaugeLabelEl.textContent = `${map.toFixed(1)} mmHg (Borderline)`;
      gaugeLabelEl.className = 'text-amber-600 dark:text-amber-400 font-bold';

      descRenalEl.textContent = 'Filtration pressure marginal. Monitor hourly urine output closely for early AKI signs.';
      descCerebralEl.textContent = 'Autoregulation working hard. Keep MAP stable to prevent cerebral hypoperfusion.';
      descCoronaryEl.textContent = 'Acceptable baseline, but vulnerable to additional sudden pressure drops.';

      cardRenal.className = 'rounded-xl border border-amber-300 bg-amber-50/70 p-3 dark:border-amber-900/60 dark:bg-amber-950/40';
      cardCerebral.className = 'rounded-xl border border-amber-300 bg-amber-50/70 p-3 dark:border-amber-900/60 dark:bg-amber-950/40';
      cardCoronary.className = 'rounded-xl border border-amber-300 bg-amber-50/70 p-3 dark:border-amber-900/60 dark:bg-amber-950/40';

    } else if (map <= 100) {
      badgeEl.textContent = 'Optimal Organ Perfusion';
      badgeEl.className = 'rounded-full px-2.5 py-0.5 text-xs font-extrabold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
      statusSummaryEl.textContent = 'Normotensive Perfusion';
      statusSummaryEl.className = 'mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400';
      gaugeLabelEl.textContent = `${map.toFixed(1)} mmHg (Optimal)`;
      gaugeLabelEl.className = 'text-emerald-600 dark:text-emerald-400 font-bold';

      descRenalEl.textContent = 'Adequate glomerular filtration. Low risk of renal ischemic complications.';
      descCerebralEl.textContent = 'Normal cerebral blood flow maintained within physiological autoregulation.';
      descCoronaryEl.textContent = 'Healthy coronary driving pressure without excessive myocardial wall stress.';

      cardRenal.className = 'rounded-xl border border-emerald-200 bg-emerald-50/60 p-3 dark:border-emerald-900/40 dark:bg-emerald-950/30';
      cardCerebral.className = 'rounded-xl border border-emerald-200 bg-emerald-50/60 p-3 dark:border-emerald-900/40 dark:bg-emerald-950/30';
      cardCoronary.className = 'rounded-xl border border-emerald-200 bg-emerald-50/60 p-3 dark:border-emerald-900/40 dark:bg-emerald-950/30';

    } else if (map <= 110) {
      badgeEl.textContent = 'Elevated MAP';
      badgeEl.className = 'rounded-full px-2.5 py-0.5 text-xs font-extrabold bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
      statusSummaryEl.textContent = 'Mildly Elevated Pressure';
      statusSummaryEl.className = 'mt-1 text-sm font-bold text-blue-600 dark:text-blue-400';
      gaugeLabelEl.textContent = `${map.toFixed(1)} mmHg (Elevated)`;
      gaugeLabelEl.className = 'text-blue-600 dark:text-blue-400 font-bold';

      descRenalEl.textContent = 'Mildly elevated intraglomerular pressure. Long-term risk of microalbuminuria.';
      descCerebralEl.textContent = 'Approaching upper ceiling of cerebral autoregulation curve.';
      descCoronaryEl.textContent = 'Increased left ventricular afterload and higher myocardial oxygen consumption.';

      cardRenal.className = 'rounded-xl border border-blue-200 bg-blue-50/60 p-3 dark:border-blue-900/40 dark:bg-blue-950/30';
      cardCerebral.className = 'rounded-xl border border-blue-200 bg-blue-50/60 p-3 dark:border-blue-900/40 dark:bg-blue-950/30';
      cardCoronary.className = 'rounded-xl border border-blue-200 bg-blue-50/60 p-3 dark:border-blue-900/40 dark:bg-blue-950/30';

    } else {
      badgeEl.textContent = 'Severely Elevated / Crisis';
      badgeEl.className = 'rounded-full px-2.5 py-0.5 text-xs font-extrabold bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300';
      statusSummaryEl.textContent = 'Hypertensive State';
      statusSummaryEl.className = 'mt-1 text-sm font-bold text-purple-600 dark:text-purple-400';
      gaugeLabelEl.textContent = `${map.toFixed(1)} mmHg (Crisis Level)`;
      gaugeLabelEl.className = 'text-purple-600 dark:text-purple-400 font-bold';

      descRenalEl.textContent = 'Severe hyperperfusion stress on nephrons; risk of acute kidney injury.';
      descCerebralEl.textContent = 'Breakthrough hyperperfusion; risk of cerebral edema, headache, and stroke.';
      descCoronaryEl.textContent = 'Extreme cardiac workload. Potential for myocardial strain or pulmonary edema.';

      cardRenal.className = 'rounded-xl border border-purple-300 bg-purple-50/70 p-3 dark:border-purple-900/60 dark:bg-purple-950/40';
      cardCerebral.className = 'rounded-xl border border-purple-300 bg-purple-50/70 p-3 dark:border-purple-900/60 dark:bg-purple-950/40';
      cardCoronary.className = 'rounded-xl border border-purple-300 bg-purple-50/70 p-3 dark:border-purple-900/60 dark:bg-purple-950/40';
    }
  }

  // Event Listeners for Forms
  document.getElementById('form-standard-map')?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculateStandardMap();
  });

  document.getElementById('form-nursing-map')?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculateNursingMap();
  });

  document.getElementById('btn-reset-standard')?.addEventListener('click', () => {
    document.getElementById('input-sbp').value = '120';
    document.getElementById('input-dbp').value = '80';
    document.getElementById('input-hr').value = '72';
    calculateStandardMap();
  });

  document.getElementById('btn-reset-nursing')?.addEventListener('click', () => {
    document.getElementById('nursing-sbp').value = '88';
    document.getElementById('nursing-dbp').value = '52';
    document.getElementById('nursing-target-map').value = '65';
    calculateNursingMap();
  });

  // Copy Summary feature
  document.getElementById('btn-copy-map')?.addEventListener('click', () => {
    const mapVal = document.getElementById('res-map-val')?.textContent || '';
    const bpVal = document.getElementById('res-bp-val')?.textContent || '';
    const ppVal = document.getElementById('res-pp-val')?.textContent || '';
    const statusVal = document.getElementById('res-status-summary')?.textContent || '';
    const badgeVal = document.getElementById('res-badge')?.textContent || '';

    const summary = `Mean Arterial Pressure (MAP) Assessment:
- BP: ${bpVal}
- MAP: ${mapVal} mmHg (${badgeVal})
- Pulse Pressure: ${ppVal}
- Clinical Status: ${statusVal}
Calculated via aifreecalculator.com MAP Calculator`;

    navigator.clipboard.writeText(summary).then(() => {
      const fb = document.getElementById('copy-feedback');
      if (fb) {
        fb.classList.remove('hidden');
        setTimeout(() => fb.classList.add('hidden'), 2500);
      }
    });
  });

  // Initial calculation on page load
  calculateStandardMap();
</script>

