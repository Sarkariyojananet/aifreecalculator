---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="MAP Calculator – Mean Arterial Pressure (BP MAP) Calculator"
  description="Calculate Mean Arterial Pressure (MAP) from systolic and diastolic blood pressure. Free BP MAP calculator for nursing, ICU hemodynamic monitoring, and organ perfusion assessment."
  category="Health"
  calculatorName="MAP Calculator"
  slug="map-calculator"
  keywords={[
    'map calculator',
    'map calculator bp',
    'bp map calculator',
    'map calculator nursing',
    'mean arterial pressure calculator',
    'blood pressure map',
    'nursing map calculator',
    'pulse pressure calculator',
    'hemodynamic calculator',
    'sepsis map target'
  ]}
>
  <div class="space-y-6">

    <!-- TOP TAB SWITCHER -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-map-tab active shrink-0 rounded-lg bg-rose-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="standard">
          🩺 Standard BP to MAP
        </button>
        <button type="button" class="btn-map-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="nursing">
          🏥 Nursing & ICU Target Mode
        </button>
        <button type="button" class="btn-map-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="reference">
          📊 MAP Ranges & Guidelines
        </button>
      </div>
    </div>

    <!-- QUICK PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick BP Presets:
        </span>
        <button type="button" class="btn-map-preset rounded-lg border border-emerald-300 bg-emerald-50 px-2.5 py-1 font-semibold text-emerald-700 hover:bg-emerald-100 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300 cursor-pointer" data-sbp="120" data-dbp="80" data-hr="72">
          120/80 (Normal)
        </button>
        <button type="button" class="btn-map-preset rounded-lg border border-sky-300 bg-sky-50 px-2.5 py-1 font-semibold text-sky-700 hover:bg-sky-100 dark:border-sky-800 dark:bg-sky-950/30 dark:text-sky-300 cursor-pointer" data-sbp="110" data-dbp="70" data-hr="68">
          110/70 (Optimal)
        </button>
        <button type="button" class="btn-map-preset rounded-lg border border-amber-300 bg-amber-50 px-2.5 py-1 font-semibold text-amber-700 hover:bg-amber-100 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300 cursor-pointer" data-sbp="90" data-dbp="55" data-hr="95">
          90/55 (ICU Threshold)
        </button>
        <button type="button" class="btn-map-preset rounded-lg border border-red-300 bg-red-50 px-2.5 py-1 font-semibold text-red-700 hover:bg-red-100 dark:border-red-800 dark:bg-red-950/30 dark:text-red-300 cursor-pointer" data-sbp="85" data-dbp="50" data-hr="108">
          85/50 (Hypotension/Shock)
        </button>
        <button type="button" class="btn-map-preset rounded-lg border border-purple-300 bg-purple-50 px-2.5 py-1 font-semibold text-purple-700 hover:bg-purple-100 dark:border-purple-800 dark:bg-purple-950/30 dark:text-purple-300 cursor-pointer" data-sbp="145" data-dbp="92" data-hr="80">
          145/92 (Hypertension)
        </button>
        <button type="button" class="btn-map-preset rounded-lg border border-rose-400 bg-rose-50 px-2.5 py-1 font-semibold text-rose-800 hover:bg-rose-100 dark:border-rose-800 dark:bg-rose-950/40 dark:text-rose-300 cursor-pointer" data-sbp="180" data-dbp="110" data-hr="88">
          180/110 (Crisis)
        </button>
      </div>
    </div>

    <!-- MAIN CALCULATOR CARD -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-rose-50/20 to-red-50/20 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-rose-950/10 sm:p-7">
      
      <!-- TAB 1: STANDARD BP TO MAP -->
      <div id="panel-standard" class="map-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <div class="flex items-center justify-between">
            <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🩺</span> Blood Pressure to Mean Arterial Pressure (MAP)
            </h2>
            <span class="rounded-md bg-rose-100 px-2 py-0.5 text-[11px] font-bold text-rose-700 dark:bg-rose-950/50 dark:text-rose-300">
              Gold Standard Formula
            </span>
          </div>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Formula: MAP = DBP + [ ⅓ × (SBP - DBP) ] = [ (2 × DBP) + SBP ] ÷ 3
          </p>
        </div>

        <form id="form-standard-map" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="input-sbp" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Systolic BP (SBP)
              </label>
              <div class="relative mt-1.5">
                <input
                  type="number"
                  id="input-sbp"
                  value="120"
                  step="1"
                  min="40"
                  max="300"
                  required
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-14 text-base font-bold text-slate-900 shadow-2xs focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">
                  mmHg
                </span>
              </div>
              <span class="mt-1 block text-[11px] text-slate-500">Peak pumping pressure</span>
            </div>

            <div>
              <label for="input-dbp" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Diastolic BP (DBP)
              </label>
              <div class="relative mt-1.5">
                <input
                  type="number"
                  id="input-dbp"
                  value="80"
                  step="1"
                  min="20"
                  max="200"
                  required
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-14 text-base font-bold text-slate-900 shadow-2xs focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">
                  mmHg
                </span>
              </div>
              <span class="mt-1 block text-[11px] text-slate-500">Resting filling pressure</span>
            </div>

            <div>
              <label for="input-hr" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Heart Rate (Optional)
              </label>
              <div class="relative mt-1.5">
                <input
                  type="number"
                  id="input-hr"
                  value="72"
                  step="1"
                  min="30"
                  max="250"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-14 text-base font-bold text-slate-900 shadow-2xs focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">
                  BPM
                </span>
              </div>
              <span class="mt-1 block text-[11px] text-slate-500">For cardiac cycle ratio</span>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button
              type="submit"
              id="btn-calc-standard"
              class="flex-1 rounded-xl bg-rose-600 hover:bg-rose-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-rose-600/25 transition active:scale-[0.98] cursor-pointer"
            >
              Calculate MAP →
            </button>
            <button
              type="button"
              id="btn-reset-standard"
              class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Reset
            </button>
          </div>
        </form>
      </div>

      <!-- TAB 2: NURSING & ICU TARGET MODE -->
      <div id="panel-nursing" class="map-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <div class="flex items-center justify-between">
            <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🏥</span> Nursing & ICU Target Perfusion Evaluator
            </h2>
            <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[11px] font-bold text-blue-700 dark:bg-blue-950/50 dark:text-blue-300">
              Critical Care Protocol
            </span>
          </div>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Compare actual Mean Arterial Pressure against bedside clinical targets (Sepsis bundles, Neuro-ICU, Cardiopulmonary bypass).
          </p>
        </div>

        <form id="form-nursing-map" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="nursing-sbp" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Current SBP (mmHg)
              </label>
              <input
                type="number"
                id="nursing-sbp"
                value="88"
                step="1"
                min="40"
                max="300"
                required
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-base font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
            </div>
            <div>
              <label for="nursing-dbp" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Current DBP (mmHg)
              </label>
              <input
                type="number"
                id="nursing-dbp"
                value="52"
                step="1"
                min="20"
                max="200"
                required
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-base font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
            </div>
            <div>
              <label for="nursing-target-map" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Target MAP Goal
              </label>
              <select
                id="nursing-target-map"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
              >
                <option value="65" selected>≥ 65 mmHg (Sepsis / General ICU Standard)</option>
                <option value="70">≥ 70 mmHg (Cardiogenic Shock / Post-CABG)</option>
                <option value="80">≥ 80 mmHg (Neuro-ICU / Spinal Cord Injury)</option>
                <option value="85">≥ 85 mmHg (Acute Ischemic Stroke Candidate)</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button
              type="submit"
              id="btn-calc-nursing"
              class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
            >
              Evaluate ICU Target →
            </button>
            <button
              type="button"
              id="btn-reset-nursing"
              class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Reset
            </button>
          </div>
        </form>
      </div>

      <!-- TAB 3: REFERENCE TABLE -->
      <div id="panel-reference" class="map-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>📊</span> Mean Arterial Pressure Clinical Reference Chart
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Standard clinical thresholds used across critical care, emergency medicine, and nursing assessments.
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100 dark:bg-slate-800 font-bold text-slate-700 dark:text-slate-300">
              <tr>
                <th class="p-3">MAP Range</th>
                <th class="p-3">Classification</th>
                <th class="p-3">Organ Perfusion Status</th>
                <th class="p-3">Clinical Nursing Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-sans">
              <tr class="bg-red-50 dark:bg-red-950/20">
                <td class="p-3 font-mono font-bold text-red-700 dark:text-red-400">&lt; 60 mmHg</td>
                <td class="p-3 font-bold text-red-700 dark:text-red-300">Critical Hypoperfusion</td>
                <td class="p-3 text-slate-700 dark:text-slate-300">Inadequate perfusion to kidneys &amp; brain; shock state</td>
                <td class="p-3 font-medium text-slate-800 dark:text-slate-200">Urgent fluid resuscitation, vasopressors (Norepinephrine)</td>
              </tr>
              <tr class="bg-amber-50 dark:bg-amber-950/20">
                <td class="p-3 font-mono font-bold text-amber-700 dark:text-amber-400">60 – 64 mmHg</td>
                <td class="p-3 font-bold text-amber-700 dark:text-amber-300">Marginal / Low</td>
                <td class="p-3 text-slate-700 dark:text-slate-300">Borderline organ perfusion; risk of acute kidney injury (AKI)</td>
                <td class="p-3 font-medium text-slate-800 dark:text-slate-200">Close surveillance, recheck BP, review fluid balance &amp; meds</td>
              </tr>
              <tr class="bg-emerald-50 dark:bg-emerald-950/20">
                <td class="p-3 font-mono font-bold text-emerald-700 dark:text-emerald-400">65 – 100 mmHg</td>
                <td class="p-3 font-bold text-emerald-700 dark:text-emerald-300">Normal / Optimal</td>
                <td class="p-3 text-slate-700 dark:text-slate-300">Adequate continuous perfusion to all vital microvascular beds</td>
                <td class="p-3 font-medium text-slate-800 dark:text-slate-200">Routine patient monitoring; continue current treatment plan</td>
              </tr>
              <tr class="bg-blue-50 dark:bg-blue-950/20">
                <td class="p-3 font-mono font-bold text-blue-700 dark:text-blue-400">101 – 110 mmHg</td>
                <td class="p-3 font-bold text-blue-700 dark:text-blue-300">Elevated</td>
                <td class="p-3 text-slate-700 dark:text-slate-300">Increased cardiac workload and peripheral vascular resistance</td>
                <td class="p-3 font-medium text-slate-800 dark:text-slate-200">Assess causes (pain, anxiety, medications, fluid overload)</td>
              </tr>
              <tr class="bg-purple-50 dark:bg-purple-950/20">
                <td class="p-3 font-mono font-bold text-purple-700 dark:text-purple-400">&gt; 110 mmHg</td>
                <td class="p-3 font-bold text-purple-700 dark:text-purple-300">Severely Elevated / Crisis</td>
                <td class="p-3 text-slate-700 dark:text-slate-300">Risk of cerebral edema, hypertensive encephalopathy, MI</td>
                <td class="p-3 font-medium text-slate-800 dark:text-slate-200">Notify provider; titrate IV antihypertensives per order</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- RESULTS DASHBOARD -->
      <div id="map-results" class="mt-6 space-y-5">
        <div class="overflow-hidden rounded-3xl border border-rose-200 bg-linear-to-br from-white via-rose-50/40 to-red-100/50 p-5 shadow-lg shadow-rose-500/5 dark:border-rose-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-rose-950/30 sm:p-7">
          
          <!-- Primary Highlight Metric -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-rose-200/80 pb-4 dark:border-slate-800">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-rose-700 dark:text-rose-300">
                  Mean Arterial Pressure (MAP)
                </span>
                <span id="res-badge" class="rounded-full px-2.5 py-0.5 text-xs font-extrabold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                  Optimal Perfusion
                </span>
              </div>
              <div class="mt-1 flex items-baseline gap-2">
                <div id="res-map-val" class="text-4xl sm:text-5xl font-black text-rose-600 dark:text-rose-400">
                  93.3
                </div>
                <span class="text-lg font-bold text-slate-500">mmHg</span>
              </div>
            </div>

            <div class="sm:text-right space-y-1">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Pulse Pressure (PP):</span>
              <div id="res-pp-val" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
                40 mmHg
              </div>
              <div id="res-pp-desc" class="text-[11px] text-slate-500 font-medium">
                Normal Pulse Pressure
              </div>
            </div>
          </div>

          <!-- Secondary Grid Details -->
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-rose-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Blood Pressure</div>
              <div id="res-bp-val" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">120 / 80 mmHg</div>
            </div>
            <div class="rounded-xl border border-rose-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">ICU Sepsis Target (&ge;65)</div>
              <div id="res-sepsis-target" class="mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400">Met (+28.3 mmHg)</div>
            </div>
            <div class="rounded-xl border border-rose-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Cerebral Target (&ge;80)</div>
              <div id="res-neuro-target" class="mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400">Met (+13.3 mmHg)</div>
            </div>
            <div class="rounded-xl border border-rose-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Hemodynamic Status</div>
              <div id="res-status-summary" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">Normotensive</div>
            </div>
          </div>

          <!-- Visual Linear MAP Perfusion Scale -->
          <div class="mt-5">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
              <span>Perfusion Gauge</span>
              <span id="res-gauge-label" class="text-emerald-600 dark:text-emerald-400">93.3 mmHg (Optimal)</span>
            </div>
            
            <div class="relative h-4 w-full rounded-full overflow-hidden bg-slate-200 dark:bg-slate-800">
              <!-- Scale Color Bands: 40 to 140 mmHg span (100 units) -->
              <div class="absolute inset-0 flex">
                <div class="w-[20%] bg-red-500" title="<60 mmHg: Critical Hypoperfusion"></div>
                <div class="w-[5%] bg-amber-400" title="60-64 mmHg: Marginal Perfusion"></div>
                <div class="w-[35%] bg-emerald-500" title="65-100 mmHg: Optimal Range"></div>
                <div class="w-[40%] bg-purple-500" title=">100 mmHg: High / Hypertensive"></div>
              </div>
              
              <!-- Pinpoint Indicator -->
              <div
                id="map-gauge-pin"
                class="absolute top-0 bottom-0 w-2 -ml-1 bg-white border-2 border-slate-900 shadow-md rounded-full transition-all duration-300"
                style="left: 53.3%;"
              ></div>
            </div>

            <div class="mt-1.5 flex justify-between text-[10px] text-slate-500 font-mono">
              <span>40</span>
              <span class="text-red-600 font-bold">60 (Shock)</span>
              <span class="text-emerald-600 font-bold">65 (Min Target)</span>
              <span class="text-emerald-600 font-bold">100 (Upper)</span>
              <span>140+</span>
            </div>
          </div>

          <!-- Clinical Organ Perfusion Assessment Cards -->
          <div class="mt-5 border-t border-rose-200/80 pt-4 dark:border-slate-800">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">
              Vital Organ Perfusion Breakdown
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
              <div id="card-renal" class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-3 dark:border-emerald-900/40 dark:bg-emerald-950/30">
                <div class="flex items-center gap-1.5 font-bold text-emerald-800 dark:text-emerald-300">
                  <span>🫘</span> Renal (Kidneys)
                </div>
                <p id="desc-renal" class="mt-1 text-[11px] text-emerald-900 dark:text-emerald-200">
                  Glomerular filtration pressure adequate. Low risk of acute tubular necrosis.
                </p>
              </div>

              <div id="card-cerebral" class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-3 dark:border-emerald-900/40 dark:bg-emerald-950/30">
                <div class="flex items-center gap-1.5 font-bold text-emerald-800 dark:text-emerald-300">
                  <span>🧠</span> Cerebral (Brain)
                </div>
                <p id="desc-cerebral" class="mt-1 text-[11px] text-emerald-900 dark:text-emerald-200">
                  Cerebral perfusion pressure (CPP) maintained within autoregulatory limits.
                </p>
              </div>

              <div id="card-coronary" class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-3 dark:border-emerald-900/40 dark:bg-emerald-950/30">
                <div class="flex items-center gap-1.5 font-bold text-emerald-800 dark:text-emerald-300">
                  <span>🫀</span> Coronary (Myocardium)
                </div>
                <p id="desc-coronary" class="mt-1 text-[11px] text-emerald-900 dark:text-emerald-200">
                  Sufficient diastolic driving pressure to maintain subendocardial blood flow.
