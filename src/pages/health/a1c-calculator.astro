---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="A1C Calculator – HbA1c to Blood Sugar (eAG) Converter"
  description="Convert HbA1c percentage to estimated average glucose (eAG) in mg/dL and mmol/L. Check your diabetes risk, understand A1C levels chart, and monitor blood sugar control."
  category="Health"
  calculatorName="A1C Calculator"
  slug="a1c-calculator"
  keywords={[
    'a1c calculator',
    'hba1c calculator',
    'a1c to blood sugar calculator',
    'a1c conversion calculator',
    'a1c levels chart',
    'a1c average blood sugar',
    'diabetes a1c calculator',
    'hba1c to glucose calculator',
    'a1c to eag calculator'
  ]}
>
  <div class="space-y-6">

    <!-- TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-a1c-tab active shrink-0 rounded-lg bg-rose-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="a1c-to-eag">A1C → Avg Blood Sugar (eAG)</button>
        <button type="button" class="btn-a1c-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="eag-to-a1c">Blood Sugar → A1C 🔄</button>
        <button type="button" class="btn-a1c-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="risk">Diabetes Risk Chart 📊</button>
      </div>
    </div>

    <!-- PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1">⚡ Common A1C values:</span>
        <button type="button" class="btn-a1c-preset rounded-lg border border-emerald-300 bg-emerald-50 px-2.5 py-1 font-semibold text-emerald-700 hover:bg-emerald-100 dark:border-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-300 cursor-pointer" data-v="5.0">5.0% (Normal)</button>
        <button type="button" class="btn-a1c-preset rounded-lg border border-amber-300 bg-amber-50 px-2.5 py-1 font-semibold text-amber-700 hover:bg-amber-100 dark:border-amber-700 dark:bg-amber-950/30 dark:text-amber-300 cursor-pointer" data-v="5.7">5.7% (Prediabetes start)</button>
        <button type="button" class="btn-a1c-preset rounded-lg border border-orange-300 bg-orange-50 px-2.5 py-1 font-semibold text-orange-700 hover:bg-orange-100 dark:border-orange-700 dark:bg-orange-950/30 dark:text-orange-300 cursor-pointer" data-v="6.4">6.4% (Prediabetes max)</button>
        <button type="button" class="btn-a1c-preset rounded-lg border border-red-300 bg-red-50 px-2.5 py-1 font-semibold text-red-700 hover:bg-red-100 dark:border-red-700 dark:bg-red-950/30 dark:text-red-300 cursor-pointer" data-v="6.5">6.5% (Diabetes threshold)</button>
        <button type="button" class="btn-a1c-preset rounded-lg border border-red-400 bg-red-50 px-2.5 py-1 font-semibold text-red-700 hover:bg-red-100 dark:border-red-700 dark:bg-red-950/30 dark:text-red-300 cursor-pointer" data-v="7.0">7.0% (T2 Diabetes goal)</button>
      </div>
    </div>

    <!-- MAIN PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-rose-50/20 to-red-50/20 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-rose-950/10 sm:p-7">

      <!-- A1C TO EAG PANEL -->
      <div id="panel-a1c-to-eag" class="a1c-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>🩺</span> A1C to Estimated Average Glucose (eAG)</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Formula: eAG (mg/dL) = (28.7 × A1C) − 46.7 | eAG (mmol/L) = (1.594 × A1C) − 2.594</p>
        </div>
        <form id="form-a1c-to-eag" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="a1c-value" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">HbA1c / A1C Value (%)</label>
              <input type="number" id="a1c-value" value="6.5" step="0.1" min="3" max="20" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div class="flex items-end">
              <div class="w-full rounded-xl border border-blue-200 bg-blue-50/60 p-3 text-xs dark:border-blue-900/40 dark:bg-blue-950/30">
                <div class="font-bold text-blue-700 dark:text-blue-300 mb-1">📊 A1C Reference Ranges</div>
                <div class="space-y-0.5 text-slate-600 dark:text-slate-400">
                  <div><span class="text-emerald-600 font-bold">Normal:</span> Below 5.7%</div>
                  <div><span class="text-amber-600 font-bold">Prediabetes:</span> 5.7% – 6.4%</div>
                  <div><span class="text-red-600 font-bold">Diabetes:</span> 6.5% and above</div>
                </div>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-a1c-calc" class="flex-1 rounded-xl bg-rose-600 hover:bg-rose-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-rose-600/25 transition active:scale-[0.98] cursor-pointer">Convert A1C →</button>
            <button type="button" id="btn-a1c-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
        </form>
      </div>

      <!-- EAG TO A1C PANEL -->
      <div id="panel-eag-to-a1c" class="a1c-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>🔄</span> Blood Sugar to A1C Estimator</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Enter your average blood glucose reading to estimate the corresponding A1C percentage. Formula: A1C = (eAG + 46.7) / 28.7</p>
        </div>
        <form id="form-eag-to-a1c" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="eag-value" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Average Blood Glucose</label>
              <input type="number" id="eag-value" value="154" step="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="eag-unit" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Unit</label>
              <select id="eag-unit" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="mgdl" selected>mg/dL (USA standard)</option>
                <option value="mmol">mmol/L (UK/India/Canada)</option>
              </select>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="submit" id="btn-eag-calc" class="flex-1 rounded-xl bg-rose-600 hover:bg-rose-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-rose-600/25 transition active:scale-[0.98] cursor-pointer">Calculate A1C →</button>
            <button type="button" id="btn-eag-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
        </form>
      </div>

      <!-- RISK CHART PANEL -->
      <div id="panel-risk" class="a1c-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>📊</span> A1C Levels Chart & Diabetes Risk</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100 dark:bg-slate-800 font-bold text-slate-700 dark:text-slate-300">
              <tr><th class="p-3">A1C Level</th><th class="p-3 text-right">eAG (mg/dL)</th><th class="p-3 text-right">eAG (mmol/L)</th><th class="p-3">Category</th><th class="p-3">Risk Level</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs font-mono">
              <tr class="bg-emerald-50 dark:bg-emerald-950/20"><td class="p-3 font-bold">Below 5.7%</td><td class="p-3 text-right">Below 117</td><td class="p-3 text-right">Below 6.5</td><td class="p-3 text-emerald-700 font-bold">Normal</td><td class="p-3">✅ No Diabetes</td></tr>
              <tr class="bg-amber-50 dark:bg-amber-950/20"><td class="p-3 font-bold">5.7% – 6.4%</td><td class="p-3 text-right">117 – 137</td><td class="p-3 text-right">6.5 – 7.6</td><td class="p-3 text-amber-700 font-bold">Prediabetes</td><td class="p-3">⚠️ High Risk</td></tr>
              <tr class="bg-red-50 dark:bg-red-950/20"><td class="p-3 font-bold">6.5% – 7.0%</td><td class="p-3 text-right">140 – 154</td><td class="p-3 text-right">7.8 – 8.6</td><td class="p-3 text-red-700 font-bold">Diabetes</td><td class="p-3">🎯 Treatment Goal</td></tr>
              <tr class="bg-red-100 dark:bg-red-950/30"><td class="p-3 font-bold">7.0% – 8.0%</td><td class="p-3 text-right">154 – 183</td><td class="p-3 text-right">8.6 – 10.2</td><td class="p-3 text-red-700 font-bold">Diabetes</td><td class="p-3">⚠️ Above Goal</td></tr>
              <tr class="bg-red-200 dark:bg-red-950/50"><td class="p-3 font-bold">Above 8.0%</td><td class="p-3 text-right">Above 183</td><td class="p-3 text-right">Above 10.2</td><td class="p-3 text-red-800 font-bold">Diabetes</td><td class="p-3">🚨 Poor Control</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- RESULTS -->
      <div id="a1c-results" class="hidden mt-6 space-y-5">
        <div class="overflow-hidden rounded-3xl border border-rose-200 bg-linear-to-br from-white via-rose-50/40 to-red-100/50 p-5 shadow-lg shadow-rose-500/5 dark:border-rose-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-rose-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-rose-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="a1c-badge" class="text-xs font-bold uppercase tracking-wider text-rose-700 dark:text-rose-300">eAG (Average Blood Sugar)</span>
              <div id="a1c-res-eag-mgdl" class="mt-1 text-4xl sm:text-5xl font-black text-rose-600 dark:text-rose-400">140 mg/dL</div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">In mmol/L:</span>
              <div id="a1c-res-eag-mmol" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">7.8 mmol/L</div>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-rose-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">A1C / HbA1c</div>
              <div id="a1c-res-pct" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">6.5%</div>
            </div>
            <div class="rounded-xl border border-rose-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Category</div>
              <div id="a1c-res-category" class="mt-1 text-sm font-bold text-red-600 dark:text-red-400">Diabetes</div>
            </div>
            <div class="rounded-xl border border-rose-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Risk Level</div>
              <div id="a1c-res-risk" class="mt-1 text-sm font-bold text-red-600 dark:text-red-400">🎯 Treatment Goal</div>
            </div>
            <div class="rounded-xl border border-rose-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">ADA Target</div>
              <div class="mt-1 text-sm font-bold text-slate-900 dark:text-white">Below 7.0%</div>
            </div>
          </div>
          <!-- Status bar -->
          <div class="mt-4">
            <div class="text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">A1C Scale</div>
            <div class="h-4 rounded-full overflow-hidden bg-linear-to-r from-emerald-400 via-amber-400 to-red-600 relative">
              <div id="a1c-indicator" class="absolute top-0 h-full w-1.5 bg-white shadow-md" style="left: 45%"></div>
            </div>
            <div class="flex justify-between text-[10px] text-slate-500 mt-1">
              <span>4%</span><span class="text-emerald-600 font-bold">Normal &lt;5.7%</span><span class="text-amber-600 font-bold">Pre</span><span class="text-red-600 font-bold">Diabetes ≥6.5%</span><span>14%</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- SEO CONTENT -->
  <Fragment slot="content">
    <section class="a1c-content">
      <h2>A1C Calculator – HbA1c to Blood Sugar Converter & Diabetes Guide</h2>
      <p>The <strong>A1C Calculator</strong> (also known as the HbA1c calculator) is a critical tool for people managing diabetes or at risk of developing it. It converts your <strong>HbA1c percentage</strong> into an <strong>estimated average glucose (eAG)</strong> in both mg/dL (USA standard) and mmol/L (UK, India, Canada standard), helping you understand what your A1C number really means in terms of daily blood sugar levels.</p>

      <h2>What Is A1C (HbA1c)?</h2>
      <p><strong>A1C</strong>, also called <strong>Hemoglobin A1c (HbA1c)</strong>, is a blood test that measures your average blood sugar (glucose) level over the past 2–3 months. Red blood cells live for about 3 months, and glucose naturally attaches to hemoglobin in red blood cells. The higher your blood sugar, the more glucose attaches to hemoglobin, and the higher your A1C percentage.</p>

      <h2>A1C to Blood Sugar Formula</h2>
      <div class="my-4 rounded-2xl border border-slate-200 bg-slate-100/80 p-4 font-mono text-sm dark:border-slate-800 dark:bg-slate-900">
        <div>eAG (mg/dL) = (28.7 × A1C%) − 46.7</div>
        <div class="mt-1">eAG (mmol/L) = (1.594 × A1C%) − 2.594</div>
        <div class="mt-2 text-slate-500">Source: American Diabetes Association (ADA)</div>
      </div>

      <h2>A1C Levels and What They Mean</h2>
      <ul>
        <li><strong>Below 5.7%:</strong> Normal — no diabetes, continue healthy lifestyle</li>
        <li><strong>5.7% – 6.4%:</strong> Prediabetes — increased risk; lifestyle changes can reverse this</li>
        <li><strong>6.5% or above:</strong> Diabetes — confirmed diagnosis; treatment required</li>
        <li><strong>ADA Target for Diabetics:</strong> Below 7.0% (eAG ~154 mg/dL)</li>
        <li><strong>ADA Target for the Elderly:</strong> Below 8.0% (less aggressive to avoid hypoglycemia)</li>
      </ul>

      <h2>Why A1C Matters More Than a Single Blood Test</h2>
      <p>A single fasting blood glucose or random glucose test only tells you your blood sugar at that exact moment. A1C, however, provides a <strong>3-month average picture</strong> of your blood sugar control. This makes it a much more reliable indicator of long-term diabetes management and overall metabolic health. The ADA recommends A1C testing at least twice a year for diabetics with stable control, and quarterly for those who have changed medications or are not meeting their targets.</p>

      <h2>How to Lower Your A1C</h2>
      <ol>
        <li><strong>Regular Exercise:</strong> Physical activity makes insulin more effective. Even 30 minutes of walking 5 days a week can lower A1C by 0.5%–1.0%.</li>
        <li><strong>Healthy Diet:</strong> Limit refined carbohydrates, sugar, and ultra-processed foods. Focus on vegetables, fiber, lean protein, and whole grains.</li>
        <li><strong>Weight Loss:</strong> Even 5%–10% body weight reduction significantly improves insulin sensitivity.</li>
        <li><strong>Medication Adherence:</strong> Take diabetes medications as prescribed. Metformin is typically the first-line medication for Type 2 diabetes.</li>
        <li><strong>Blood Sugar Monitoring:</strong> Regular home glucose monitoring helps you understand how food, exercise, and stress affect your blood sugar.</li>
        <li><strong>Stress Management:</strong> Chronic stress raises cortisol, which raises blood sugar. Yoga, meditation, and adequate sleep help.</li>
      </ol>

      <h2>A1C vs Fasting Blood Glucose vs OGTT</h2>
      <ul>
        <li><strong>A1C:</strong> 3-month average; no fasting required; best for monitoring long-term control</li>
        <li><strong>Fasting Glucose:</strong> Single measurement after 8-hour fast; Normal &lt;100 mg/dL; Diabetes ≥126 mg/dL</li>
        <li><strong>OGTT (2-hour Glucose Tolerance Test):</strong> After drinking 75g glucose; Normal &lt;140 mg/dL; Diabetes ≥200 mg/dL</li>
        <li><strong>Random Glucose:</strong> Any time test; Diabetes suspected if ≥200 mg/dL with symptoms</li>
      </ul>
    </section>
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <div class="space-y-4 text-xs sm:text-sm">
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800" open>
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">1. What is a normal A1C level?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">A normal A1C is below 5.7%. Prediabetes is 5.7%–6.4%. A1C of 6.5% or above on two separate tests confirms diabetes. For people already diagnosed with diabetes, the ADA goal is below 7.0% (some patients may target below 6.5%).</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">2. What is eAG and how is it related to A1C?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">eAG (estimated Average Glucose) is your A1C converted to the same units as your blood glucose meter (mg/dL or mmol/L). It gives diabetics a more intuitive understanding of their A1C. Formula: eAG (mg/dL) = (28.7 × A1C) − 46.7.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">3. How often should I check my A1C?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">The ADA recommends A1C testing at least twice a year if you're meeting treatment goals, and every 3 months if you've changed medications or your blood sugar isn't under control. People with prediabetes should test annually.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">4. How quickly can A1C be lowered?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">A1C reflects the past 2–3 months of blood sugar. With significant lifestyle changes or medication, you can lower A1C by 1%–2% in 3 months. The most recent month's blood sugar has the most influence on the result (~50% weight).</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">5. Can A1C be falsely high or low?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Yes. A1C can be falsely elevated by: iron deficiency anemia, kidney disease, high bilirubin. Falsely low results occur with: hemolytic anemia, chronic blood loss, sickle cell trait, pregnancy. Doctors may order alternative tests in these cases.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">6. What is the difference between mg/dL and mmol/L?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">mg/dL (milligrams per deciliter) is used in the USA. mmol/L (millimoles per liter) is used in the UK, India, Canada, and most of Europe. To convert: mg/dL ÷ 18.015 = mmol/L. Normal fasting blood sugar: &lt;100 mg/dL = &lt;5.6 mmol/L.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">7. Does an A1C of 6.5% always mean diabetes?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Diabetes is confirmed when two separate A1C tests show 6.5% or above, OR one A1C ≥6.5% combined with classic diabetes symptoms and a random blood sugar ≥200 mg/dL. A single borderline test should always be repeated for confirmation.</p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<style>
  .a1c-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.5rem; font-weight: 800; color: #0f172a; }
  .a1c-content h2:first-child { margin-top: 0; }
  .a1c-content p { margin: 0 0 1rem; line-height: 1.75; color: #475569; }
  .a1c-content ul, .a1c-content ol { margin: 0.75rem 0 1.5rem; padding-left: 1.5rem; }
  .a1c-content ul { list-style: disc; }
  .a1c-content ol { list-style: decimal; }
  .a1c-content li + li { margin-top: 0.5rem; }
  :global(.dark) .a1c-content h2 { color: #f8fafc; }
  :global(.dark) .a1c-content p, :global(.dark) .a1c-content li { color: #cbd5e1; }
</style>

<script is:inline>
  const a1cTabs = document.querySelectorAll('.btn-a1c-tab');
  const a1cPanels = document.querySelectorAll('.a1c-panel');
  const a1cResults = document.getElementById('a1c-results');

  a1cTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      a1cTabs.forEach(t => { t.classList.remove('bg-rose-600','text-white','shadow-xs'); t.classList.add('border','border-slate-300','bg-white','text-slate-700','dark:border-slate-700','dark:bg-slate-800','dark:text-slate-200'); });
      tab.classList.add('bg-rose-600','text-white','shadow-xs');
      tab.classList.remove('border','border-slate-300','bg-white','text-slate-700');
      a1cPanels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');
      a1cResults?.classList.add('hidden');
    });
  });

  document.querySelectorAll('.btn-a1c-preset').forEach(btn => {
    btn.addEventListener('click', () => { document.getElementById('a1c-value').value = btn.dataset.v; });
  });

  function getCategory(a1c) {
    if (a1c < 5.7) return { cat: 'Normal', risk: '✅ No Diabetes Risk', cls: 'text-emerald-600 dark:text-emerald-400' };
    if (a1c <= 6.4) return { cat: 'Prediabetes', risk: '⚠️ High Risk — Act Now', cls: 'text-amber-600 dark:text-amber-400' };
    if (a1c <= 7.0) return { cat: 'Diabetes', risk: '🎯 At Treatment Goal', cls: 'text-orange-600 dark:text-orange-400' };
    if (a1c <= 8.0) return { cat: 'Diabetes', risk: '⚠️ Above ADA Goal', cls: 'text-red-600 dark:text-red-400' };
    return { cat: 'Diabetes', risk: '🚨 Poor Control', cls: 'text-red-700 dark:text-red-400' };
  }

  function showA1CResults(a1c, eag_mgdl, eag_mmol) {
    const { cat, risk, cls } = getCategory(a1c);
    document.getElementById('a1c-badge').textContent = 'eAG (Estimated Average Glucose)';
    document.getElementById('a1c-res-eag-mgdl').textContent = Math.round(eag_mgdl) + ' mg/dL';
    document.getElementById('a1c-res-eag-mmol').textContent = eag_mmol.toFixed(1) + ' mmol/L';
    document.getElementById('a1c-res-pct').textContent = a1c.toFixed(1) + '%';
    document.getElementById('a1c-res-category').textContent = cat;
    document.getElementById('a1c-res-category').className = 'mt-1 text-sm font-bold ' + cls;
    document.getElementById('a1c-res-risk').textContent = risk;
    document.getElementById('a1c-res-risk').className = 'mt-1 text-sm font-bold ' + cls;

    // Position indicator on scale (4% - 14% range = 10% span)
    const pct = Math.min(100, Math.max(0, ((a1c - 4) / 10) * 100));
    document.getElementById('a1c-indicator').style.left = pct + '%';

    a1cResults.classList.remove('hidden');
    a1cResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('form-a1c-to-eag')?.addEventListener('submit', () => {
    const a1c = parseFloat(document.getElementById('a1c-value').value);
    if (!a1c || a1c < 3 || a1c > 20) return;
    const eag_mgdl = (28.7 * a1c) - 46.7;
    const eag_mmol = (1.594 * a1c) - 2.594;
    showA1CResults(a1c, eag_mgdl, eag_mmol);
  });
  document.getElementById('btn-a1c-clear')?.addEventListener('click', () => a1cResults?.classList.add('hidden'));

  document.getElementById('form-eag-to-a1c')?.addEventListener('submit', () => {
    let eag = parseFloat(document.getElementById('eag-value').value);
    const unit = document.getElementById('eag-unit').value;
    if (unit === 'mmol') eag = eag * 18.015; // convert to mg/dL for formula
    const a1c = (eag + 46.7) / 28.7;
    const eag_mgdl = eag;
    const eag_mmol = eag / 18.015;
    showA1CResults(a1c, eag_mgdl, eag_mmol);
  });
  document.getElementById('btn-eag-clear')?.addEventListener('click', () => a1cResults?.classList.add('hidden'));
</script>

