---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="500 - Server Error"
  description="Something went wrong on our end. Please try again later."
  noindex={true}
>
  <div class="relative flex min-h-[85vh] items-center justify-center overflow-hidden px-4 py-20">
    <!-- Ambient background blobs -->
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-32 -top-32 h-96 w-96 rounded-full bg-red-500/10 blur-3xl dark:bg-red-500/5"></div>
      <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-orange-500/10 blur-3xl dark:bg-orange-500/5"></div>
    </div>

    <div class="relative text-center">
      <!-- Giant ghost 500 text -->
      <div class="error-number-500 select-none text-[9rem] font-black leading-none tracking-tighter text-slate-200 dark:text-slate-800/80 sm:text-[13rem] lg:text-[16rem]">
        500
      </div>

      <!-- Icon overlaid -->
      <div class="relative -mt-14 flex justify-center sm:-mt-20 lg:-mt-24">
        <div class="icon-pulse flex h-24 w-24 items-center justify-center rounded-3xl bg-linear-to-br from-red-500 to-orange-600 text-5xl shadow-2xl shadow-red-500/30 ring-4 ring-white dark:ring-slate-900 sm:h-28 sm:w-28 sm:text-6xl">
          ⚡
        </div>
      </div>

      <!-- Content -->
      <div class="mx-auto mt-8 max-w-lg">
        <p class="text-xs font-black uppercase tracking-[0.3em] text-red-500 dark:text-red-400">
          500 Server Error
        </p>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          Something Went Wrong
        </h1>
        <p class="mt-4 text-base leading-relaxed text-slate-500 dark:text-slate-400">
          Our servers hit an unexpected issue while processing your request.<br class="hidden sm:block" />
          Don't worry — it's on us. Please try again in a moment.
        </p>
      </div>

      <!-- Error detail card -->
      <div class="mx-auto mt-6 max-w-sm rounded-2xl border border-red-100 bg-red-50/80 px-5 py-4 dark:border-red-900/30 dark:bg-red-950/20">
        <div class="flex items-start gap-3 text-left">
          <span class="mt-0.5 shrink-0 text-lg">🔍</span>
          <div>
            <p class="text-xs font-bold text-red-700 dark:text-red-400">What you can try:</p>
            <ul class="mt-1.5 space-y-1 text-xs text-red-600 dark:text-red-400/80">
              <li>• Refresh the page (Ctrl + R)</li>
              <li>• Clear your browser cache and try again</li>
              <li>• Come back in a few minutes</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button
          id="refresh-btn"
          onclick="window.location.reload()"
          class="group inline-flex items-center justify-center gap-2 rounded-xl bg-linear-to-r from-red-500 to-orange-600 px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-red-500/30 transition-all duration-200 hover:scale-105 hover:shadow-xl hover:shadow-red-500/40 active:scale-100"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:rotate-180 duration-300" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
          </svg>
          Try Again
        </button>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-7 py-3.5 text-sm font-bold text-slate-700 shadow-sm transition-all duration-200 hover:scale-105 hover:border-slate-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
          </svg>
          Go to Homepage
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .icon-pulse {
    animation: pulse-scale 2.5s ease-in-out infinite;
  }

  @keyframes pulse-scale {
    0%, 100% { transform: scale(1); box-shadow: 0 20px 60px -15px rgba(239, 68, 68, 0.3); }
    50%       { transform: scale(1.05); box-shadow: 0 25px 70px -10px rgba(239, 68, 68, 0.5); }
  }

  .error-number-500 {
    background: linear-gradient(180deg, #fecaca 0%, #fca5a5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global(.dark) .error-number-500 {
    background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

