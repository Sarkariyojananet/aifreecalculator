---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { calculators, categories } from '../../../data/calculators';
import { getCalculatorStats } from '../../../lib/db';
import { auditCalculatorSEO } from '../../../lib/admin/seo-health';

const stats = await getCalculatorStats();
const totalCalculators = calculators.length;

const enrichedCalculators = calculators.map((c) => {
  const audit = auditCalculatorSEO(c);
  const views = stats[c.slug] || stats[`${c.slug}-calculator`] || 0;
  return {
    ...c,
    views,
    seoScore: audit.score,
    seoGrade: audit.grade,
  };
});
---

<AdminLayout title="All Calculators | Calculator CMS" sectionTitle="Calculators" activeSection="calculators">
  <div class="space-y-6 max-w-7xl mx-auto">
    
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
          Manage Calculators ({totalCalculators})
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Search, audit SEO health, edit metadata, and manage featured calculator engines.
        </p>
      </div>

      <a
        href="/admin/calculators/new/"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer self-start sm:self-auto"
      >
        <span>➕</span> Add New Calculator
      </a>
    </div>

    <!-- Filters & Search Bar -->
    <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 flex flex-col md:flex-row items-center gap-3">
      
      <!-- Search Input -->
      <div class="relative flex-1 w-full">
        <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm">🔍</span>
        <input
          type="text"
          id="calc-search-input"
          placeholder="Search name, slug, keywords or formula..."
          class="w-full rounded-2xl border border-slate-200 bg-slate-50/70 py-2.5 pl-10 pr-4 text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:bg-white focus:outline-hidden dark:border-slate-800 dark:bg-slate-950/60 dark:text-white"
        />
      </div>

      <!-- Category Filter -->
      <div class="flex items-center gap-2 w-full md:w-auto">
        <select
          id="calc-cat-filter"
          class="w-full md:w-auto rounded-2xl border border-slate-200 bg-slate-50/70 py-2.5 px-3 text-xs font-bold text-slate-700 focus:border-blue-600 focus:outline-hidden dark:border-slate-800 dark:bg-slate-950/60 dark:text-slate-300"
        >
          <option value="all">All Categories ({totalCalculators})</option>
          {categories.map((cat) => (
            <option value={cat.name}>{cat.name} ({calculators.filter((c) => c.category === cat.name).length})</option>
          ))}
        </select>

        <!-- Sort Select -->
        <select
          id="calc-sort-select"
          class="w-full md:w-auto rounded-2xl border border-slate-200 bg-slate-50/70 py-2.5 px-3 text-xs font-bold text-slate-700 focus:border-blue-600 focus:outline-hidden dark:border-slate-800 dark:bg-slate-950/60 dark:text-slate-300"
        >
          <option value="name_asc">Name (A-Z)</option>
          <option value="views_desc">Most Calculations</option>
          <option value="seo_desc">Highest SEO Score</option>
          <option value="seo_asc">Lowest SEO Score</option>
        </select>
      </div>

    </div>

    <!-- Results Count -->
    <div class="flex items-center justify-between text-xs font-semibold text-slate-500 dark:text-slate-400 px-1">
      <span id="calc-count-label">Showing all {totalCalculators} calculators</span>
      <span class="hidden sm:inline">Click any calculator to edit metadata or content</span>
    </div>

    <!-- Desktop Data Table (Screens >= 768px) -->
    <div class="hidden md:block rounded-3xl border border-slate-200 bg-white overflow-hidden shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50/80 dark:bg-slate-950/60 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100 dark:border-slate-800">
          <tr>
            <th class="py-3.5 px-5">Calculator</th>
            <th class="py-3.5 px-4">Category</th>
            <th class="py-3.5 px-4 text-center">Status</th>
            <th class="py-3.5 px-4 text-right">Calculations</th>
            <th class="py-3.5 px-4 text-center">SEO Score</th>
            <th class="py-3.5 px-5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="calc-table-body" class="divide-y divide-slate-100 dark:divide-slate-800 font-medium">
          {enrichedCalculators.map((c) => (
            <tr
              class="calc-row hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition"
              data-name={c.name.toLowerCase()}
              data-slug={c.slug.toLowerCase()}
              data-category={c.category}
              data-views={c.views}
              data-seo={c.seoScore}
            >
              <td class="py-4 px-5">
                <div class="flex items-center gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-lg dark:bg-slate-800">
                    {c.icon}
                  </span>
                  <div class="min-w-0">
                    <a
                      href={`/admin/calculators/new/?edit=${c.slug}`}
                      class="font-bold text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition"
                    >
                      {c.name}
                    </a>
                    <div class="text-[11px] font-mono text-slate-400 truncate max-w-[220px]">
                      {c.path}
                    </div>
                  </div>
                </div>
              </td>

              <td class="py-4 px-4">
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {c.category}
                </span>
              </td>

              <td class="py-4 px-4 text-center">
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[10px] font-extrabold text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Live
                </span>
              </td>

              <td class="py-4 px-4 text-right font-mono font-bold text-slate-800 dark:text-slate-200">
                {c.views.toLocaleString()}
              </td>

              <td class="py-4 px-4 text-center">
                <span class={`inline-block rounded-lg px-2 py-0.5 font-mono text-[11px] font-extrabold ${c.seoScore >= 80 ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300'}`}>
                  {c.seoScore}%
                </span>
              </td>

              <td class="py-4 px-5 text-right space-x-2">
                <a
                  href={`/admin/calculators/new/?edit=${c.slug}`}
                  class="rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-600 hover:bg-blue-100 dark:bg-blue-950 dark:text-blue-400 transition"
                >
                  Edit
                </a>
                <a
                  href={c.path}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 transition"
                >
                  View ↗
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile Stacked Card View (Screens < 768px) -->
    <div id="calc-mobile-list" class="md:hidden space-y-3">
      {enrichedCalculators.map((c) => (
        <div
          class="calc-mobile-card rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3"
          data-name={c.name.toLowerCase()}
          data-slug={c.slug.toLowerCase()}
          data-category={c.category}
          data-views={c.views}
          data-seo={c.seoScore}
        >
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-slate-100 text-xl dark:bg-slate-800">
                {c.icon}
              </span>
              <div>
                <h4 class="font-bold text-xs text-slate-900 dark:text-white">
                  {c.name}
                </h4>
                <div class="flex items-center gap-2 mt-0.5">
                  <span class="rounded bg-slate-100 px-1.5 py-0.2 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                    {c.category}
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">/{c.slug}/</span>
                </div>
              </div>
            </div>

            <span class={`rounded-lg px-2 py-0.5 font-mono text-[10px] font-black ${c.seoScore >= 80 ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300'}`}>
              {c.seoScore}%
            </span>
          </div>

          <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
            {c.description}
          </p>

          <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800 text-xs font-bold">
            <span class="text-slate-500 font-mono text-[11px]">
              <strong>{c.views.toLocaleString()}</strong> calculations
            </span>
            <div class="flex items-center gap-2">
              <a
                href={`/admin/calculators/new/?edit=${c.slug}`}
                class="rounded-xl bg-blue-600 px-3 py-1.5 text-xs text-white shadow-xs"
              >
                Edit Details
              </a>
              <a
                href={c.path}
                target="_blank"
                class="rounded-xl border border-slate-300 px-2.5 py-1.5 text-xs text-slate-700 dark:border-slate-700 dark:text-slate-300"
              >
                View ↗
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</AdminLayout>

<script is:inline>
  const searchInput = document.getElementById('calc-search-input');
  const catFilter = document.getElementById('calc-cat-filter');
  const sortSelect = document.getElementById('calc-sort-select');
  const countLabel = document.getElementById('calc-count-label');
  const tableBody = document.getElementById('calc-table-body');
  const mobileList = document.getElementById('calc-mobile-list');

  function filterAndSortCalculators() {
    const q = (searchInput?.value || '').toLowerCase().trim();
    const cat = catFilter?.value || 'all';
    const sort = sortSelect?.value || 'name_asc';

    const desktopRows = Array.from(document.querySelectorAll('.calc-row'));
    const mobileCards = Array.from(document.querySelectorAll('.calc-mobile-card'));

    // Sorting comparator
    function compare(a, b) {
      if (sort === 'views_desc') {
        const va = parseInt(a.getAttribute('data-views') || '0', 10);
        const vb = parseInt(b.getAttribute('data-views') || '0', 10);
        return vb - va;
      }
      if (sort === 'seo_desc') {
        const sa = parseInt(a.getAttribute('data-seo') || '0', 10);
        const sb = parseInt(b.getAttribute('data-seo') || '0', 10);
        return sb - sa;
      }
      if (sort === 'seo_asc') {
        const sa = parseInt(a.getAttribute('data-seo') || '0', 10);
        const sb = parseInt(b.getAttribute('data-seo') || '0', 10);
        return sa - sb;
      }
      // name_asc
      const na = a.getAttribute('data-name') || '';
      const nb = b.getAttribute('data-name') || '';
      return na.localeCompare(nb);
    }

    desktopRows.sort(compare);
    mobileCards.sort(compare);

    if (tableBody) {
      desktopRows.forEach((row) => tableBody.appendChild(row));
    }
    if (mobileList) {
      mobileCards.forEach((card) => mobileList.appendChild(card));
    }

    let visibleCount = 0;

    function evaluateItem(el) {
      const name = el.getAttribute('data-name') || '';
      const slug = el.getAttribute('data-slug') || '';
      const category = el.getAttribute('data-category') || '';

      const matchCat = cat === 'all' || category.toLowerCase() === cat.toLowerCase();
      const matchQuery = !q || name.includes(q) || slug.includes(q);

      const isVisible = matchCat && matchQuery;
      el.style.display = isVisible ? '' : 'none';
      return isVisible;
    }

    desktopRows.forEach((r) => { if (evaluateItem(r)) visibleCount++; });
    mobileCards.forEach(evaluateItem);

    if (countLabel) {
      countLabel.textContent = `Showing ${visibleCount} calculator(s)`;
    }
  }

  searchInput?.addEventListener('input', filterAndSortCalculators);
  catFilter?.addEventListener('change', filterAndSortCalculators);
  sortSelect?.addEventListener('change', filterAndSortCalculators);
</script>
