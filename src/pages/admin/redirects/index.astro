      <div class="grid grid-cols-3 gap-3 bg-slate-50 p-3.5 rounded-2xl dark:bg-slate-800/60 text-xs">
        <div>
          <span class="text-[10px] text-slate-400 uppercase font-bold block">Total Hits</span>
          <span id="modal-rev-hits" class="text-sm font-black text-slate-900 dark:text-white">0</span>
        </div>
        <div>
          <span class="text-[10px] text-slate-400 uppercase font-bold block">Recent (24h)</span>
          <span id="modal-rev-recent" class="text-sm font-black text-amber-600 dark:text-amber-400">0</span>
        </div>
        <div>
          <span class="text-[10px] text-slate-400 uppercase font-bold block">Last Recorded</span>
          <span id="modal-rev-last" class="text-xs font-semibold text-slate-700 dark:text-slate-300 block truncate">--</span>
        </div>
      </div>

      <!-- GSC SEO Impact Warning (Conditional) -->
      <div id="modal-gsc-alert" class="hidden rounded-2xl border border-amber-200 bg-amber-50 p-3 dark:border-amber-900/60 dark:bg-amber-950/40 text-xs">
        <div class="flex items-center gap-2 font-bold text-amber-900 dark:text-amber-200">
          <span>⚠️</span> Possible SEO Impact
        </div>
        <p id="modal-gsc-text" class="text-[11px] text-amber-800 dark:text-amber-300 mt-0.5">
          This URL has recorded Google Search impressions. A 301 redirect is strongly recommended.
        </p>
      </div>

      <!-- Smart Suggestion Card -->
      <div id="modal-suggestion-box" class="rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/30 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-emerald-900 dark:text-emerald-200 flex items-center gap-1.5">
            <span>✨</span> Recommended Destination
          </span>
          <span id="modal-sugg-confidence" class="rounded-md bg-emerald-200 px-2 py-0.5 text-[10px] font-black text-emerald-900 dark:bg-emerald-900 dark:text-emerald-200">
            95% match
          </span>
        </div>

        <div class="font-mono text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>→</span>
          <span id="modal-sugg-dest" class="text-emerald-700 dark:text-emerald-300"></span>
        </div>

        <p id="modal-sugg-reason" class="text-[11px] text-slate-500 dark:text-slate-400"></p>

        <button
          type="button"
          id="btn-apply-smart-suggestion"
          class="w-full rounded-xl bg-emerald-600 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-emerald-700 transition cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span>✓</span> Approve &amp; Create 301 Redirect to Suggestion
        </button>
      </div>

      <!-- Manual Alternative Destination Picker -->
      <div class="space-y-3 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
        <label class="block font-bold text-slate-700 dark:text-slate-300">
          Or Choose Another Destination:
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <select
            id="modal-custom-dest-select"
            class="sm:col-span-2 rounded-xl border border-slate-300 bg-white py-2 px-3 text-xs font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white focus:outline-hidden"
          >
            <option value="">-- Select from existing calculator/page --</option>
            {allTargets.map((t) => (
              <option value={t.path}>{t.label}</option>
            ))}
          </select>

          <select
            id="modal-custom-type"
            class="sm:col-span-1 rounded-xl border border-slate-300 bg-white py-2 px-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white focus:outline-hidden"
          >
            <option value="301">301 (Permanent)</option>
            <option value="302">302 (Temporary)</option>
          </select>
        </div>

        <button
          type="button"
          id="btn-apply-custom-redirect"
          class="w-full rounded-xl border border-slate-300 bg-slate-100 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 cursor-pointer"
        >
          Apply Custom Redirect
        </button>
      </div>

      <!-- Modal Footer / Ignore Action -->
      <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
        <button
          type="button"
          id="btn-modal-ignore"
          class="text-slate-400 hover:text-red-500 font-semibold cursor-pointer"
        >
          🔇 Ignore this 404 URL
        </button>

        <button
          type="button"
          id="btn-modal-cancel"
          class="rounded-xl px-4 py-1.5 font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer"
        >
          Cancel
        </button>
      </div>

    </div>
  </div>

</AdminLayout>

<script is:inline>
  // 1. Tab Navigation
  const tabBtns = document.querySelectorAll('.tab-nav-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach((b) => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('text-slate-600', 'dark:text-slate-300');
      });
      tabPanels.forEach((p) => p.classList.add('hidden'));

      btn.classList.remove('text-slate-600', 'dark:text-slate-300');
      btn.classList.add('bg-blue-600', 'text-white');

      if (btn.id === 'tab-btn-404') document.getElementById('tab-panel-404')?.classList.remove('hidden');
      if (btn.id === 'tab-btn-rules') document.getElementById('tab-panel-rules')?.classList.remove('hidden');
      if (btn.id === 'tab-btn-ignored') document.getElementById('tab-panel-ignored')?.classList.remove('hidden');
      if (btn.id === 'tab-btn-history') document.getElementById('tab-panel-history')?.classList.remove('hidden');
      if (btn.id === 'tab-btn-scanner') document.getElementById('tab-panel-scanner')?.classList.remove('hidden');
    });
  });

  // 2. Priority & Search Filters on 404 Monitor Tab
  const filterBtns = document.querySelectorAll('.btn-filter-prio');
  const searchInput = document.getElementById('input-search-404');
  let currentPrio = 'all';

  function apply404Filters() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.item-row-404');

    rows.forEach((row) => {
      const prio = row.getAttribute('data-prio') || 'low';
      const path = (row.getAttribute('data-path') || '').toLowerCase();

      const matchesPrio = currentPrio === 'all' || prio === currentPrio;
      const matchesSearch = !query || path.includes(query);

      if (matchesPrio && matchesSearch) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-blue-50', 'text-blue-600', 'dark:bg-blue-950', 'dark:text-blue-400');
        b.classList.add('text-slate-600', 'dark:text-slate-400');
      });
      btn.classList.remove('text-slate-600', 'dark:text-slate-400');
      btn.classList.add('bg-blue-50', 'text-blue-600', 'dark:bg-blue-950', 'dark:text-blue-400');
      currentPrio = btn.getAttribute('data-prio') || 'all';
      apply404Filters();
    });
  });

  searchInput?.addEventListener('input', apply404Filters);

  // 3. Manual Redirect Card Toggle
  const formCard = document.getElementById('redirect-form-card');
  const btnToggle = document.getElementById('btn-toggle-add-redirect');
  const btnCancel = document.getElementById('btn-cancel-redirect');
  const editId = document.getElementById('redir-edit-id');
  const srcInput = document.getElementById('redir-source');
  const destInput = document.getElementById('redir-dest');
  const statusSelect = document.getElementById('redir-status');
  const modalTitle = document.getElementById('redir-modal-title');
  const statusMsg = document.getElementById('redir-status-msg');

  btnToggle?.addEventListener('click', () => {
    if (editId) editId.value = '';
    if (srcInput) srcInput.value = '';
    if (destInput) destInput.value = '';
    if (statusSelect) statusSelect.value = '301';
    if (modalTitle) modalTitle.innerHTML = '<span>🔀</span> Create New Redirect Rule';
    statusMsg?.classList.add('hidden');
    formCard?.classList.toggle('hidden');
    srcInput?.focus();
  });

  btnCancel?.addEventListener('click', () => {
    formCard?.classList.add('hidden');
  });

  // 4. Review 404 Modal Logic
  const modalReview = document.getElementById('modal-review-404');
  const revPathEl = document.getElementById('modal-rev-path');
  const revHitsEl = document.getElementById('modal-rev-hits');
  const revRecentEl = document.getElementById('modal-rev-recent');
  const revLastEl = document.getElementById('modal-rev-last');
  const gscAlertEl = document.getElementById('modal-gsc-alert');
  const gscTextEl = document.getElementById('modal-gsc-text');
  const suggBox = document.getElementById('modal-suggestion-box');
  const suggDestEl = document.getElementById('modal-sugg-dest');
  const suggConfEl = document.getElementById('modal-sugg-confidence');
  const suggReasonEl = document.getElementById('modal-sugg-reason');
  const btnApplySmart = document.getElementById('btn-apply-smart-suggestion');
  const btnApplyCustom = document.getElementById('btn-apply-custom-redirect');
  const customDestSelect = document.getElementById('modal-custom-dest-select');
  const customTypeSelect = document.getElementById('modal-custom-type');
  const btnModalIgnore = document.getElementById('btn-modal-ignore');
  const btnCloseModal = document.getElementById('btn-close-modal-review');
  const btnCancelModal = document.getElementById('btn-modal-cancel');

  let activeReviewPath = '';
  let activeReviewSuggestedDest = '';

  function openReviewModal(data) {
    activeReviewPath = data.path;
    activeReviewSuggestedDest = data.dest;

    if (revPathEl) revPathEl.textContent = data.path;
    if (revHitsEl) revHitsEl.textContent = data.hits;
    if (revRecentEl) revRecentEl.textContent = data.recent > 0 ? `+${data.recent}` : '0';
    if (revLastEl) revLastEl.textContent = new Date(data.last).toLocaleDateString();

    const imps = parseInt(data.impressions || '0', 10);
    if (imps > 0) {
      if (gscTextEl) gscTextEl.textContent = `This URL generated ${imps} search impressions in Google Search Console. 301 redirection is recommended.`;
      gscAlertEl?.classList.remove('hidden');
    } else {
      gscAlertEl?.classList.add('hidden');
    }

    if (data.dest) {
      if (suggDestEl) suggDestEl.textContent = data.dest;
      if (suggConfEl) suggConfEl.textContent = `${data.confidence}% match`;
      if (suggReasonEl) suggReasonEl.textContent = data.reason;
      suggBox?.classList.remove('hidden');
    } else {
      suggBox?.classList.add('hidden');
    }

    if (customDestSelect) customDestSelect.value = '';
    modalReview?.classList.remove('hidden');
    modalReview?.classList.add('flex');
  }

  function closeReviewModal() {
    modalReview?.classList.add('hidden');
    modalReview?.classList.remove('flex');
  }

  document.querySelectorAll('.btn-review-404').forEach((btn) => {
    btn.addEventListener('click', () => {
      openReviewModal({
        path: btn.getAttribute('data-path') || '',
        hits: btn.getAttribute('data-hits') || '1',
        recent: btn.getAttribute('data-recent') || '1',
        first: btn.getAttribute('data-first') || '',
        last: btn.getAttribute('data-last') || '',
        dest: btn.getAttribute('data-dest') || '',
        confidence: btn.getAttribute('data-confidence') || '0',
        reason: btn.getAttribute('data-reason') || '',
        ref: btn.getAttribute('data-ref') || '',
        device: btn.getAttribute('data-device') || '',
        impressions: btn.getAttribute('data-impressions') || '0',
      });
    });
  });

  btnCloseModal?.addEventListener('click', closeReviewModal);
  btnCancelModal?.addEventListener('click', closeReviewModal);

  function getAuthHeaders() {
    const token = localStorage.getItem('admin_token');
    const headers = { 'Content-Type': 'application/json' };
    if (token) headers['Authorization'] = `Bearer ${token}`;
    return headers;
  }

  // Apply Smart Suggestion Action
  btnApplySmart?.addEventListener('click', async () => {
    if (!activeReviewPath || !activeReviewSuggestedDest) return;
    btnApplySmart.textContent = 'Creating 301 redirect...';

    try {
      const res = await fetch('/api/admin/redirects', {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({
          source: activeReviewPath,
          destination: activeReviewSuggestedDest,
          statusCode: 301,
          note: 'Created via 404 Smart Suggestion review',
        }),
      });

      const data = await res.json();
      if (res.ok && data.success) {
        alert(`✓ Redirect created successfully:\n${activeReviewPath} ➔ ${activeReviewSuggestedDest}`);
        window.location.reload();
      } else {
        alert(data.error || 'Failed to create redirect');
        btnApplySmart.textContent = '✓ Approve & Create 301 Redirect to Suggestion';
      }
    } catch {
      alert('Network error creating redirect');
      btnApplySmart.textContent = '✓ Approve & Create 301 Redirect to Suggestion';
    }
  });

  // Apply Custom Destination Action
  btnApplyCustom?.addEventListener('click', async () => {
    const dest = customDestSelect?.value.trim() || '';
    const code = parseInt(customTypeSelect?.value || '301', 10);

    if (!dest) {
      alert('Please select a destination from the list');
      return;
    }

    try {
      const res = await fetch('/api/admin/redirects', {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({
          source: activeReviewPath,
          destination: dest,
          statusCode: code,
          note: 'Created via 404 manual destination review',
        }),
      });

      const data = await res.json();
      if (res.ok && data.success) {
        alert(`✓ Redirect created:\n${activeReviewPath} ➔ ${dest}`);
        window.location.reload();
      } else {
        alert(data.error || 'Failed to create redirect');
      }
    } catch {
      alert('Network error saving redirect');
    }
  });

  // Ignore 404 Actions
  async function ignore404(path) {
    if (!confirm(`Ignore 404 alerts for "${path}"?`)) return;

    try {
      const res = await fetch('/api/admin/redirects/404s/action', {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({ path, action: 'ignore' }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to ignore URL');
      }
    } catch {
      alert('Network error');
    }
  }

  btnModalIgnore?.addEventListener('click', () => ignore404(activeReviewPath));
  document.querySelectorAll('.btn-ignore-404').forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-path');
      if (p) ignore404(p);
    });
  });

  // Restore 404 Actions
  document.querySelectorAll('.btn-restore-404').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const path = btn.getAttribute('data-path');
      if (!path) return;

      try {
        const res = await fetch('/api/admin/redirects/404s/action', {
          method: 'POST',
          headers: getAuthHeaders(),
          body: JSON.stringify({ path, action: 'restore' }),
        });
        if (res.ok) {
          window.location.reload();
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // Delete 404 Log Permanently
  document.querySelectorAll('.btn-delete-404').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const path = btn.getAttribute('data-path');
      if (!path || !confirm(`Permanently delete log for "${path}"?`)) return;

      try {
        const res = await fetch('/api/admin/redirects/404s/action', {
          method: 'POST',
          headers: getAuthHeaders(),
          body: JSON.stringify({ path, action: 'delete' }),
        });
        if (res.ok) {
          window.location.reload();
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // Collapse Chain Button
  document.querySelectorAll('.btn-collapse-chain').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const source = btn.getAttribute('data-source');
      const finalDest = btn.getAttribute('data-final');
      if (!source || !finalDest) return;

      if (!confirm(`Update "${source}" directly to final destination "${finalDest}"?`)) return;

      try {
        const res = await fetch('/api/admin/redirects', {
          method: 'POST',
          headers: getAuthHeaders(),
          body: JSON.stringify({
            source,
            destination: finalDest,
            statusCode: 301,
            collapseChain: true,
          }),
        });
        if (res.ok) {
          alert('✓ Chain collapsed directly to final destination!');
          window.location.reload();
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // Edit Existing Redirect Rule
  document.querySelectorAll('.btn-edit-redir').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || '';
      const source = btn.getAttribute('data-source') || '';
      const dest = btn.getAttribute('data-dest') || '';
      const code = btn.getAttribute('data-code') || '301';

      if (editId) editId.value = id;
      if (srcInput) srcInput.value = source;
      if (destInput) destInput.value = dest;
      if (statusSelect) statusSelect.value = code;
      if (modalTitle) modalTitle.innerHTML = '<span>✏️</span> Edit Redirect Rule';

      statusMsg?.classList.add('hidden');
      formCard?.classList.remove('hidden');
      srcInput?.focus();
    });
  });

  // Delete Existing Redirect Rule
  document.querySelectorAll('.btn-delete-redir').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id') || '';
      const source = btn.getAttribute('data-source') || '';

      if (!confirm(`Are you sure you want to delete redirect rule for "${source}"?`)) {
        return;
      }

      try {
        const res = await fetch(`/api/admin/redirects?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: getAuthHeaders(),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Failed to delete redirect rule');
        }
      } catch {
        alert('Network error while deleting redirect');
      }
    });
  });

  // Form Submit Handler (Loop and chain validation handled on server)
  document.getElementById('redirect-editor-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = editId?.value || '';
    const source = srcInput?.value.trim() || '';
    const destination = destInput?.value.trim() || '';
    const statusCode = parseInt(statusSelect?.value || '301', 10);

    if (statusMsg) {
      statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300';
      statusMsg.textContent = 'Validating and saving redirect rule...';
      statusMsg.classList.remove('hidden');
    }

    try {
      const res = await fetch('/api/admin/redirects', {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({ id, source, destination, statusCode }),
      });

      const data = await res.json();
      if (res.ok && data.success) {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
        statusMsg.textContent = '✓ Redirect rule saved successfully!';
        setTimeout(() => window.location.reload(), 700);
      } else {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300';
        statusMsg.textContent = data.error || 'Failed to save redirect rule';
      }
    } catch {
      statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300';
      statusMsg.textContent = 'Connection error while saving redirect rule';
    }
  });

  // 6. Automated 404 Scanner Controller
  const btnStartScanner = document.getElementById('btn-start-scanner');
  const btnStopScanner = document.getElementById('btn-stop-scanner');
  const btnOpenScanner = document.getElementById('btn-open-scanner');
  const progressCard = document.getElementById('scanner-progress-card');
  const resultsCard = document.getElementById('scanner-results-card');
  const progressBar = document.getElementById('scanner-progress-bar');
  const progressPercent = document.getElementById('scanner-progress-percent');
  const statusSpinner = document.getElementById('scanner-status-spinner');
  const statusText = document.getElementById('scanner-status-text');
  const cntScanned = document.getElementById('cnt-scanned');
  const cntHealthy = document.getElementById('cnt-healthy');
  const cnt404 = document.getElementById('cnt-404');
  const cntOther = document.getElementById('cnt-other');
  const badgeTotalResults = document.getElementById('badge-total-results');
  const resultsTbody = document.getElementById('scanner-results-tbody');
  const allHealthyMsg = document.getElementById('scanner-all-healthy-msg');
  const chkAutoLog = document.getElementById('chk-auto-log-404');

  let isScanning = false;
  let scanAborted = false;
  let allScanRows = [];
  let scannerFilterMode = 'broken';

  btnOpenScanner?.addEventListener('click', () => {
    document.getElementById('tab-btn-scanner')?.click();
  });

  document.querySelectorAll('.scanner-scope-card').forEach((card) => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.scanner-scope-card').forEach((c) => {
        c.classList.remove('border-blue-500', 'bg-blue-50/40', 'dark:bg-blue-950/20');
        c.classList.add('border-slate-200', 'dark:border-slate-800', 'bg-slate-50/50', 'dark:bg-slate-900/40');
      });
      card.classList.remove('border-slate-200', 'dark:border-slate-800', 'bg-slate-50/50', 'dark:bg-slate-900/40');
      card.classList.add('border-blue-500', 'bg-blue-50/40', 'dark:bg-blue-950/20');
    });
  });

  document.getElementById('toggle-custom-urls')?.addEventListener('click', () => {
    document.getElementById('custom-urls-box')?.classList.toggle('hidden');
  });

  document.querySelectorAll('.btn-scanner-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-scanner-filter').forEach((b) => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('text-slate-600', 'dark:text-slate-300');
      });
      btn.classList.remove('text-slate-600', 'dark:text-slate-300');
      btn.classList.add('bg-blue-600', 'text-white');

      scannerFilterMode = btn.getAttribute('data-filter') || 'broken';
      applyScannerFilter();
    });
  });

  function applyScannerFilter() {
    const rows = resultsTbody?.querySelectorAll('tr') || [];
    rows.forEach((row) => {
      const type = row.getAttribute('data-type');
      if (scannerFilterMode === 'all') {
        row.classList.remove('hidden');
      } else if (scannerFilterMode === 'broken') {
        if (type === 'broken') {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      } else if (scannerFilterMode === 'healthy') {
        if (type === 'healthy') {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      }
    });

    if (allHealthyMsg) {
      const totalBroken = allScanRows.filter(r => !r.ok).length;
      if (scannerFilterMode === 'broken' && totalBroken === 0 && allScanRows.length > 0) {
        allHealthyMsg.classList.remove('hidden');
      } else {
        allHealthyMsg.classList.add('hidden');
      }
    }
  }

  btnStopScanner?.addEventListener('click', () => {
    scanAborted = true;
    if (statusText) statusText.textContent = 'Stopping scan...';
  });

  btnStartScanner?.addEventListener('click', async () => {
    if (isScanning) return;

    let targetUrls = [];
    const customText = (document.getElementById('input-custom-scan-urls')?.value || '').trim();

    if (customText) {
      targetUrls = customText
        .split('\n')
        .map(u => u.trim())
        .filter(Boolean)
        .map(u => u.startsWith('/') ? u : '/' + u);
    } else {
      const selectedScopeEl = document.querySelector('input[name="scan-scope"]:checked');
      const scanType = selectedScopeEl ? selectedScopeEl.value : 'calculators';

      if (btnStartScanner) btnStartScanner.disabled = true;
      if (statusText) statusText.textContent = 'Discovering site routes...';
      progressCard?.classList.remove('hidden');

      try {
        const urlRes = await fetch(`/api/admin/redirects/scan?type=${encodeURIComponent(scanType)}`, {
          headers: getAuthHeaders(),
        });
        if (!urlRes.ok) throw new Error('Failed to fetch routes to scan');
        const urlData = await urlRes.json();
        targetUrls = urlData.urls || [];
      } catch (err) {
        alert('Failed to initialize scan: ' + (err.message || 'Network error'));
        if (btnStartScanner) btnStartScanner.disabled = false;
        progressCard?.classList.add('hidden');
        return;
      }
    }

    if (targetUrls.length === 0) {
      alert('No URLs found to scan.');
      if (btnStartScanner) btnStartScanner.disabled = false;
      return;
    }

    isScanning = true;
    scanAborted = false;
    allScanRows = [];
    if (resultsTbody) resultsTbody.innerHTML = '';
    allHealthyMsg?.classList.add('hidden');

    btnStartScanner?.classList.add('hidden');
    btnStopScanner?.classList.remove('hidden');
    btnStopScanner?.classList.add('inline-flex');
    progressCard?.classList.remove('hidden');
    resultsCard?.classList.remove('hidden');
    statusSpinner?.classList.remove('hidden');

    let total = targetUrls.length;
    let scanned = 0;
    let healthy = 0;
    let broken = 0;
    let notFound404 = 0;
    let otherCount = 0;

    const autoLog404 = chkAutoLog ? chkAutoLog.checked : true;
    const batchSize = 10;

    for (let i = 0; i < total; i += batchSize) {
      if (scanAborted) break;

      const batch = targetUrls.slice(i, i + batchSize);
      if (statusText) statusText.textContent = `Scanning batch ${Math.floor(i / batchSize) + 1} of ${Math.ceil(total / batchSize)}... (${batch[0]})`;

      try {
        const batchRes = await fetch('/api/admin/redirects/scan', {
          method: 'POST',
          headers: getAuthHeaders(),
          body: JSON.stringify({ urls: batch, autoLog404 }),
        });

        if (batchRes.ok) {
          const data = await batchRes.json();
          const results = data.results || [];

          for (const item of results) {
            allScanRows.push(item);
            scanned++;
            if (item.ok) {
              healthy++;
            } else {
              broken++;
              if (item.status === 404) notFound404++;
              else otherCount++;
            }
            renderScannerRow(item);
          }
        } else {
          scanned += batch.length;
        }
      } catch {
        scanned += batch.length;
      }

      const percent = Math.min(100, Math.round((scanned / total) * 100));
      if (progressBar) progressBar.style.width = `${percent}%`;
      if (progressPercent) progressPercent.textContent = `${percent}% (${scanned} / ${total})`;
      if (cntScanned) cntScanned.textContent = scanned.toString();
      if (cntHealthy) cntHealthy.textContent = healthy.toString();
      if (cnt404) cnt404.textContent = notFound404.toString();
      if (cntOther) cntOther.textContent = otherCount.toString();
      if (badgeTotalResults) badgeTotalResults.textContent = allScanRows.length.toString();

      applyScannerFilter();

      // Gentle 60ms pacing to keep UI smooth and prevent sudden request bursts
      await new Promise((r) => setTimeout(r, 60));
    }

    isScanning = false;
    btnStartScanner?.classList.remove('hidden');
    if (btnStartScanner) btnStartScanner.disabled = false;
    btnStopScanner?.classList.add('hidden');
    btnStopScanner?.classList.remove('inline-flex');
    statusSpinner?.classList.add('hidden');

    if (scanAborted) {
      if (statusText) statusText.textContent = `Scan stopped by user. Scanned ${scanned} of ${total} URLs.`;
    } else {
      if (statusText) statusText.textContent = `Scan finished! Verified ${scanned} routes. Found ${notFound404} 404 errors.`;
      if (progressBar) progressBar.style.width = '100%';
    }

    applyScannerFilter();
  });

  function renderScannerRow(item) {
    if (!resultsTbody) return;
    const tr = document.createElement('tr');
    tr.className = 'hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition text-xs';
    tr.setAttribute('data-type', item.ok ? 'healthy' : 'broken');

    const statusBadge = item.status === 200
      ? '<span class="rounded-md bg-emerald-100 px-2 py-0.5 font-mono text-[10px] font-black text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">200 OK</span>'
      : item.status === 404
      ? '<span class="rounded-md bg-red-600 px-2 py-0.5 font-mono text-[10px] font-black text-white">404 NOT FOUND</span>'
      : item.status >= 300 && item.status < 400
      ? `<span class="rounded-md bg-amber-100 px-2 py-0.5 font-mono text-[10px] font-black text-amber-800 dark:bg-amber-950 dark:text-amber-300">${item.status} REDIRECT</span>`
      : `<span class="rounded-md bg-rose-900 px-2 py-0.5 font-mono text-[10px] font-black text-white">${item.status} ERROR</span>`;

    const suggHtml = item.suggestion?.destination
      ? `<div class="flex items-center gap-1.5 font-mono text-[11px] text-emerald-700 dark:text-emerald-400">
           <span>→</span>
           <span class="font-bold truncate max-w-xs">${item.suggestion.destination}</span>
           <span class="text-[9px] px-1 py-0.2 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-300 font-sans font-bold">${item.suggestion.confidence}% match</span>
         </div>`
      : '<span class="text-slate-400 text-[11px]">--</span>';

    const actionHtml = !item.ok
      ? `<button type="button" class="btn-scanner-create-redir inline-flex items-center gap-1 rounded-lg bg-blue-600 px-2.5 py-1 text-[11px] font-bold text-white hover:bg-blue-700 cursor-pointer transition shadow-2xs mr-1" data-path="${item.path}" data-dest="${item.suggestion?.destination || ''}">
           🔀 Create 301 Redirect
         </button>
         <a href="${item.path}" target="_blank" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-700 px-2 py-1 text-[11px] font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
           🔗 Test
         </a>`
      : `<a href="${item.path}" target="_blank" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-700 px-2.5 py-1 text-[11px] font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
           🔗 View Page
         </a>`;

    tr.innerHTML = `
      <td class="py-3 px-4 whitespace-nowrap">${statusBadge}</td>
      <td class="py-3 px-4 font-mono font-semibold ${item.ok ? 'text-slate-800 dark:text-slate-200' : 'text-red-600 dark:text-red-400 font-bold'} break-all">
        ${item.path}
      </td>
      <td class="py-3 px-3 font-mono text-[11px] text-slate-400 whitespace-nowrap">${item.durationMs}ms</td>
      <td class="py-3 px-4">${suggHtml}</td>
      <td class="py-3 px-4 text-right whitespace-nowrap">${actionHtml}</td>
    `;

    tr.querySelector('.btn-scanner-create-redir')?.addEventListener('click', (e) => {
      const btn = e.currentTarget;
      const path = btn.getAttribute('data-path') || '';
      const dest = btn.getAttribute('data-dest') || '';

      const formCard = document.getElementById('redirect-form-card');
      const srcInput = document.getElementById('redir-source');
      const destInput = document.getElementById('redir-dest');
      const idInput = document.getElementById('redir-edit-id');

      if (idInput) idInput.value = '';
      if (srcInput) srcInput.value = path;
      if (destInput) destInput.value = dest;

      formCard?.classList.remove('hidden');
      formCard?.scrollIntoView({ behavior: 'smooth' });
      destInput?.focus();
    });

    resultsTbody.appendChild(tr);
  }
</script>
