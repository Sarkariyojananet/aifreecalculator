---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminStatCard from '../../components/admin/AdminStatCard.astro';
import QuickActions from '../../components/admin/QuickActions.astro';
import { calculators, categories } from '../../data/calculators';
import { getCalculatorStats } from '../../lib/db';
import { getFullSEOHealthSummary } from '../../lib/admin/seo-health';
import { getSearchAnalytics } from '../../lib/admin/content-store';
import { getCalculatorHealthSummaries, getTestRunHistory } from '../../lib/calculator-tests/health-store';

const stats = await getCalculatorStats();
const totalCalculators = calculators.length;
const totalCalculations = Object.values(stats).reduce((a, b) => a + b, 0);
const featuredCount = calculators.filter((c) => c.featured).length;

const seoSummary = getFullSEOHealthSummary();
const searchLogs = await getSearchAnalytics(Astro.locals);
const healthSummaries = await getCalculatorHealthSummaries(Astro.locals);
const runHistory = await getTestRunHistory(Astro.locals);
const latestTestRun = runHistory[0] || null;

const healthyCalcsCount = healthSummaries.filter((s) => s.healthStatus === 'Healthy').length;
const reviewCalcs = healthSummaries.filter((s) => s.healthStatus === 'Needs Review' || s.healthStatus === 'Critical');
const unreviewedErrorsTotal = healthSummaries.reduce((acc, s) => acc + s.unreviewedErrors, 0);

// Top Calculators
const topCalculators = Object.entries(stats)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 6)
  .map(([slug, views], idx) => {
    const calc = calculators.find((c) => c.slug === slug || c.slug === `${slug}-calculator`);
    const share = totalCalculations > 0 ? Math.round((views / totalCalculations) * 100) : 0;
    return {
      rank: idx + 1,
      slug,
      name: calc ? calc.name : slug,
      category: calc ? calc.category : 'General',
      icon: calc ? calc.icon : '🧮',
      views,
      share,
      path: calc ? calc.path : `/${slug}/`,
    };
  });

// Content Needing Attention (Real audits)
const attentionItems = seoSummary.audits
  .filter((a) => a.criticalIssues.length > 0 || a.warnings.length > 0 || a.score < 80)
  .slice(0, 5);
---

<AdminLayout title="Dashboard | Calculator CMS" sectionTitle="Dashboard" activeSection="dashboard">
  <div class="space-y-8 max-w-7xl mx-auto">
    
    <!-- Top Greeting Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
          Website &amp; CMS Overview
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Real-time metrics, calculation throughput, SEO diagnostics, and search demand.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a
          href="/admin/calculators/new/"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer"
        >
          <span>➕</span> Add Calculator
        </a>
        <a
          href="/admin/seo/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
        >
          <span>🩺</span> SEO Intelligence
        </a>
        <a
          href="/admin/calculator-health/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-indigo-200 bg-indigo-50 px-3.5 py-2 text-xs font-bold text-indigo-700 hover:bg-indigo-100 dark:border-indigo-900/60 dark:bg-indigo-950/60 dark:text-indigo-300 transition cursor-pointer"
        >
          <span>🛡️</span> Calculator Health
        </a>
      </div>
    </div>

    <!-- 1. Top Stat KPI Cards (1-col mobile, 2-col tablet, 4-col desktop) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      <AdminStatCard
        title="Total Calculators"
        value={totalCalculators}
        icon="🧮"
        badge="Active"
        badgeType="success"
        subtitle="100% Client-side engines"
        iconBg="bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400"
      />

      <AdminStatCard
        title="Total Calculations"
        value={totalCalculations.toLocaleString()}
        icon="⚡"
        badge="Live Data"
        badgeType="info"
        subtitle="All-time user computations"
        iconBg="bg-emerald-50 text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400"
      />

      <AdminStatCard
        title="SEO Health Score"
        value={`${seoSummary.overallScore}%`}
        icon="🩺"
        badge={`${seoSummary.excellentCount} Optimal`}
        badgeType="success"
        subtitle="Meta tags & taxonomy audit"
        iconBg="bg-purple-50 text-purple-600 dark:bg-purple-950 dark:text-purple-400"
      />

      <AdminStatCard
        title="Featured Tools"
        value={featuredCount}
        icon="⭐"
        badge="Homepage"
        badgeType="warning"
        subtitle={`${categories.length} Specialized categories`}
        iconBg="bg-amber-50 text-amber-600 dark:bg-amber-950 dark:text-amber-400"
      />
    </div>

    <!-- 2. Main Two-Column Grid: Usage & SEO Diagnostics -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left 7 Cols: Top Performing Calculators -->
      <div class="lg:col-span-7 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🔥</span> Top Performing Calculators
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Ranked by total calculation executions computed by users
            </p>
          </div>
          <a
            href="/admin/analytics/"
            class="text-xs font-bold text-blue-600 hover:underline dark:text-blue-400"
          >
            Full Analytics →
          </a>
        </div>

        <!-- Desktop Table View -->
        <div class="hidden sm:block rounded-3xl border border-slate-200 bg-white overflow-hidden shadow-xs dark:border-slate-800 dark:bg-slate-900">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50/80 dark:bg-slate-950/60 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100 dark:border-slate-800">
              <tr>
                <th class="py-3 px-4 w-12">#</th>
                <th class="py-3 px-4">Calculator</th>
                <th class="py-3 px-4">Category</th>
                <th class="py-3 px-4 text-right">Calculations</th>
                <th class="py-3 px-4 text-right">Share</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium">
              {topCalculators.map((t) => (
                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-400">
                    #{t.rank}
                  </td>
                  <td class="py-3.5 px-4">
                    <a href={t.path} target="_blank" class="flex items-center gap-2.5 group">
                      <span class="text-base shrink-0">{t.icon}</span>
                      <span class="font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                        {t.name}
                      </span>
                    </a>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                      {t.category}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-right font-mono font-bold text-slate-800 dark:text-slate-200">
                    {t.views.toLocaleString()}
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <div class="inline-flex items-center gap-2">
                      <div class="h-1.5 w-12 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                        <div class="h-full bg-blue-600 rounded-full" style={`width: ${t.share}%`}></div>
                      </div>
                      <span class="font-bold font-mono text-[11px] text-slate-500 w-8">{t.share}%</span>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile Stacked Card View (Screens < 640px) -->
        <div class="sm:hidden space-y-3">
          {topCalculators.map((t) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-lg">{t.icon}</span>
                  <span class="font-bold text-xs text-slate-900 dark:text-white">{t.name}</span>
                </div>
                <span class="rounded bg-blue-50 px-2 py-0.5 text-[10px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                  #{t.rank}
                </span>
              </div>
              <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1 border-t border-slate-100 dark:border-slate-800">
                <span>Category: <strong>{t.category}</strong></span>
                <span><strong>{t.views.toLocaleString()}</strong> runs ({t.share}%)</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right 5 Cols: Content & SEO Health Attention -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>⚠️</span> Content Needs Attention
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Tools with missing metadata, short descriptions, or low scores
            </p>
          </div>
          <a
            href="/admin/seo-health/"
            class="text-xs font-bold text-emerald-600 hover:underline dark:text-emerald-400"
          >
            Audit All ({seoSummary.totalCalculators}) →
          </a>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3">
          {attentionItems.length === 0 ? (
            <div class="py-6 text-center text-xs text-slate-400">
              <span class="text-xl block mb-1">🎉</span>
              All calculators meet optimal SEO and content quality guidelines!
            </div>
          ) : (
            attentionItems.map((item) => (
              <div class="rounded-2xl border border-slate-100 bg-slate-50/60 p-3.5 dark:border-slate-800 dark:bg-slate-950/40 flex items-start justify-between gap-3">
                <div class="space-y-1 min-w-0">
                  <h4 class="font-bold text-xs text-slate-900 dark:text-white truncate">
                    {item.name}
                  </h4>
                  <div class="text-[11px] text-amber-700 dark:text-amber-400 line-clamp-1 font-medium">
                    {item.criticalIssues[0] || item.warnings[0] || 'Metadata optimization recommended'}
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <span class="rounded-lg bg-white px-2 py-0.5 font-mono text-[10px] font-bold text-slate-700 shadow-2xs dark:bg-slate-800 dark:text-slate-300">
                    {item.score}/100
                  </span>
                  <a
                    href={`/admin/calculators/new/?edit=${item.slug}`}
                    class="rounded-lg bg-blue-50 px-2 py-1 text-[11px] font-bold text-blue-600 hover:bg-blue-100 dark:bg-blue-950 dark:text-blue-400"
                  >
                    Fix →
                  </a>
                </div>
              </div>
            ))
          )}
        </div>

        <!-- Calculator Reliability & Health Overview Widget -->
        <div class="space-y-4 pt-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span>🛡️</span> Calculator Reliability
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Formula test passes &amp; unhandled exception monitoring
              </p>
            </div>
            <a
              href="/admin/calculator-health/"
              class="text-xs font-bold text-indigo-600 hover:underline dark:text-indigo-400"
            >
              Monitor All →
            </a>
          </div>

          <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3">
            <div class="flex items-center justify-between text-xs pb-2 border-b border-slate-100 dark:border-slate-800">
              <span class="text-slate-500 dark:text-slate-400">Pass Baseline:</span>
              <span class="font-bold text-slate-900 dark:text-white">
                {healthyCalcsCount} / {totalCalculators} Verified
              </span>
            </div>

            {unreviewedErrorsTotal > 0 && (
              <div class="rounded-2xl border border-red-200 bg-red-50 p-3 dark:border-red-900/50 dark:bg-red-950/40 flex items-center justify-between text-xs">
                <span class="font-bold text-red-700 dark:text-red-300">
                  ⚠️ {unreviewedErrorsTotal} Unreviewed Runtime Error{unreviewedErrorsTotal > 1 ? 's' : ''}
                </span>
                <a href="/admin/calculator-health/errors/" class="font-bold text-red-600 dark:text-red-400 underline">
                  Review →
                </a>
              </div>
            )}

            {reviewCalcs.length > 0 ? (
              <div class="space-y-2 pt-1">
                {reviewCalcs.slice(0, 3).map((calc) => (
                  <div class="flex items-center justify-between rounded-xl bg-slate-50/80 p-2.5 dark:bg-slate-950/40 text-xs">
                    <span class="font-bold text-slate-800 dark:text-slate-200 truncate pr-2">
                      {calc.name}
                    </span>
                    <a
                      href={`/admin/calculator-health/${calc.slug}/`}
                      class="text-[11px] font-bold text-blue-600 dark:text-blue-400 shrink-0"
                    >
                      Inspect →
                    </a>
                  </div>
                ))}
              </div>
            ) : (
              <div class="py-2 text-center text-xs text-slate-500 dark:text-slate-400">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓ Zero critical formula regressions</span>
              </div>
            )}

            <div class="pt-2 text-[11px] text-slate-400 text-right">
              {latestTestRun ? (
                <span>Last run: {new Date(latestTestRun.completed_at || latestTestRun.started_at).toLocaleDateString()}</span>
              ) : (
                <span>No full test suite run recorded</span>
              )}
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- 3. Search Demand & Opportunities (No Result / High Volume Searches) -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🔍</span> Visitor Search Demand &amp; Missing Calculator Opportunities
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Real visitor search requests: identify popular tools and discover missing calculators to build next.
          </p>
        </div>
        <a
          href="/admin/analytics/"
          class="text-xs font-bold text-blue-600 hover:underline dark:text-blue-400 shrink-0"
        >
          Full Search Intelligence →
        </a>
      </div>

      {searchLogs.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-slate-200 bg-white p-6 text-center text-xs text-slate-400 dark:border-slate-800 dark:bg-slate-900">
          No search activity logged yet. When visitors search on your site, requests will appear here.
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {searchLogs.slice(0, 6).map((log) => (
            <div class={`rounded-3xl border p-4 shadow-xs flex flex-col justify-between space-y-3 bg-white dark:bg-slate-900 transition ${!log.hasResults ? 'border-amber-200 dark:border-amber-900/60 bg-amber-50/10' : 'border-slate-200 dark:border-slate-800'}`}>
              <div class="flex items-start justify-between gap-2">
                <div class="space-y-1 min-w-0">
                  <div class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white truncate">
                    "{log.query}"
                  </div>
                  <div class="flex items-center gap-2">
                    <span class={`rounded px-1.5 py-0.2 text-[9px] font-extrabold uppercase ${log.hasResults ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 animate-pulse'}`}>
                      {log.hasResults ? '✓ Has Tool' : '🚨 Missing Tool (Opportunity)'}
                    </span>
                  </div>
                </div>

                <div class="text-right shrink-0">
                  <div class="text-base font-black text-slate-900 dark:text-white font-mono">{log.count}</div>
                  <div class="text-[9px] text-slate-400">searches</div>
                </div>
              </div>

              <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px]">
                {!log.hasResults ? (
                  <a
                    href={`/admin/calculators/new/?name=${encodeURIComponent(log.query)}`}
                    class="font-bold text-amber-700 hover:text-amber-800 dark:text-amber-400 hover:underline inline-flex items-center gap-1"
                  >
                    <span>➕</span> Build Calculator →
                  </a>
                ) : (
                  <span class="text-slate-400 font-medium">Active in catalog</span>
                )}
                <span class="text-[10px] text-slate-400">
                  {log.lastSearched ? new Date(log.lastSearched).toLocaleDateString([], { month: 'short', day: 'numeric' }) : 'Recent'}
                </span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- 4. Quick Actions -->
    <QuickActions />

  </div>
</AdminLayout>
