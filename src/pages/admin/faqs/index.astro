---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getFAQs } from '../../../lib/admin/content-store';
import { categories, calculators } from '../../../data/calculators';

const faqs = await getFAQs(Astro.locals);
---

<AdminLayout title="FAQ Manager | Calculator CMS" sectionTitle="FAQ Manager" activeSection="faqs">
  <div class="space-y-6 max-w-5xl mx-auto pb-12">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
          FAQ &amp; Question Manager ({faqs.length})
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Manage reusable answers, calculator-specific mathematical explanations, and structured FAQPage schemas.
        </p>
      </div>

      <button
        type="button"
        id="btn-open-add-faq"
        class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer self-start sm:self-auto"
      >
        <span>➕</span> Add New Question
      </button>
    </div>

    <!-- Add / Edit FAQ Inline Form -->
    <div id="faq-form-card" class="hidden rounded-3xl border border-blue-200 bg-blue-50/50 p-6 dark:border-blue-900/60 dark:bg-blue-950/30 space-y-4">
      <div class="flex items-center justify-between border-b border-blue-100 pb-3 dark:border-blue-900/40">
        <h3 id="faq-form-title" class="text-sm font-bold text-blue-900 dark:text-blue-200 flex items-center gap-2">
          <span>➕</span> Add New Question &amp; Answer
        </h3>
        <button type="button" id="btn-cancel-faq" class="text-xs font-bold text-slate-400 hover:text-slate-600 cursor-pointer">
          ✕ Cancel
        </button>
      </div>

      <form id="faq-editor-form" class="space-y-4">
        <input type="hidden" id="faq-edit-id" value="" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="faq-category" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Category / Section
            </label>
            <select
              id="faq-category"
              class="mt-1.5 w-full rounded-2xl border border-slate-300 bg-white py-2.5 px-3 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:border-blue-600 focus:outline-hidden"
            >
              <option value="General">General (Site-Wide FAQ)</option>
              {categories.map((c) => (
                <option value={c.name}>{c.name}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="faq-calc-slug" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Attach to Calculator (Optional)
            </label>
            <select
              id="faq-calc-slug"
              class="mt-1.5 w-full rounded-2xl border border-slate-300 bg-white py-2.5 px-3 text-xs font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:border-blue-600 focus:outline-hidden"
            >
              <option value="">-- None (General / Category FAQ) --</option>
              {calculators.map((c) => (
                <option value={c.slug}>{c.name} ({c.category})</option>
              ))}
            </select>
          </div>
        </div>

        <div>
          <label for="faq-question" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
            Question Title <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="faq-question"
            required
            placeholder="e.g. How is rebar weight calculated per meter?"
            class="mt-1.5 w-full rounded-2xl border border-slate-300 bg-white py-2.5 px-3.5 text-xs font-semibold text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          />
        </div>

        <div>
          <label for="faq-answer" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
            Comprehensive Answer <span class="text-red-500">*</span>
          </label>
          <textarea
            id="faq-answer"
            rows="3"
            required
            placeholder="Write clear, step-by-step mathematical or practical answer..."
            class="mt-1.5 w-full rounded-2xl border border-slate-300 bg-white p-3 text-xs text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          ></textarea>
        </div>

        <div id="faq-status-alert" class="hidden rounded-xl p-3 text-xs font-semibold"></div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button
            type="submit"
            id="btn-save-faq-submit"
            class="rounded-xl bg-blue-600 px-6 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-blue-700 transition cursor-pointer"
          >
            💾 Save FAQ Item
          </button>
        </div>
      </form>
    </div>

    <!-- FAQ Items List (Responsive Stacked Cards) -->
    <div id="faq-list-container" class="space-y-4">
      {faqs.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-slate-200 bg-white p-8 text-center text-xs text-slate-400 dark:border-slate-800 dark:bg-slate-900">
          <p class="text-2xl mb-1">❓</p>
          <p class="font-bold text-slate-600 dark:text-slate-300">No FAQ questions created yet.</p>
          <p class="mt-1">Click "+ Add New Question" above to create structured FAQs.</p>
        </div>
      ) : (
        faqs.map((f, idx) => (
          <div class="faq-card rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3">
            <div class="flex items-start justify-between gap-3">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {f.category || 'General'}
                  </span>
                  {f.calculatorSlug && (
                    <span class="rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-mono text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                      /{f.calculatorSlug}/
                    </span>
                  )}
                  <span class="text-[10px] font-mono text-slate-400">Order: #{f.sortOrder || idx + 1}</span>
                </div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white pt-1">
                  {f.question}
                </h3>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button
                  type="button"
                  class="btn-edit-faq text-xs font-bold text-blue-600 hover:underline dark:text-blue-400 cursor-pointer"
                  data-id={f.id}
                  data-q={f.question}
                  data-a={f.answer}
                  data-cat={f.category}
                  data-slug={f.calculatorSlug || ''}
                  data-order={f.sortOrder || idx + 1}
                >
                  Edit
                </button>
                <button
                  type="button"
                  class="btn-delete-faq text-xs font-bold text-red-600 hover:underline dark:text-red-400 cursor-pointer"
                  data-id={f.id}
                  data-q={f.question}
                >
                  Delete
                </button>
              </div>
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed bg-slate-50/70 dark:bg-slate-950/40 p-3.5 rounded-2xl border border-slate-100 dark:border-slate-800">
              {f.answer}
            </p>
          </div>
        ))
      )}
    </div>

  </div>
</AdminLayout>

<script is:inline>
  const formCard = document.getElementById('faq-form-card');
  const btnOpenAdd = document.getElementById('btn-open-add-faq');
  const btnCancel = document.getElementById('btn-cancel-faq');
  const form = document.getElementById('faq-editor-form');

  const inputId = document.getElementById('faq-edit-id');
  const inputQ = document.getElementById('faq-question');
  const inputA = document.getElementById('faq-answer');
  const selectCat = document.getElementById('faq-category');
  const selectCalc = document.getElementById('faq-calc-slug');
  const formTitle = document.getElementById('faq-form-title');
  const statusAlert = document.getElementById('faq-status-alert');

  function getAuthToken() {
    return localStorage.getItem('admin_token') || '';
  }

  btnOpenAdd?.addEventListener('click', () => {
    if (inputId) inputId.value = '';
    if (inputQ) inputQ.value = '';
    if (inputA) inputA.value = '';
    if (selectCalc) selectCalc.value = '';
    if (formTitle) formTitle.innerHTML = '<span>➕</span> Add New Question &amp; Answer';
    statusAlert?.classList.add('hidden');
    formCard?.classList.remove('hidden');
    inputQ?.focus();
  });

  btnCancel?.addEventListener('click', () => {
    formCard?.classList.add('hidden');
  });

  document.querySelectorAll('.btn-edit-faq').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || '';
      const q = btn.getAttribute('data-q') || '';
      const a = btn.getAttribute('data-a') || '';
      const cat = btn.getAttribute('data-cat') || 'General';
      const slug = btn.getAttribute('data-slug') || '';

      if (inputId) inputId.value = id;
      if (inputQ) inputQ.value = q;
      if (inputA) inputA.value = a;
      if (selectCat) selectCat.value = cat;
      if (selectCalc) selectCalc.value = slug;
      if (formTitle) formTitle.innerHTML = '<span>✏️</span> Edit Question &amp; Answer';

      statusAlert?.classList.add('hidden');
      formCard?.classList.remove('hidden');
      inputQ?.focus();
    });
  });

  document.querySelectorAll('.btn-delete-faq').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id') || '';
      const q = btn.getAttribute('data-q') || '';

      if (!confirm(`Are you sure you want to delete FAQ: "${q}"?`)) {
        return;
      }

      try {
        const token = getAuthToken();
        const res = await fetch(`/api/admin/faqs?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: token ? { 'Authorization': `Bearer ${token}` } : {},
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Failed to delete FAQ');
        }
      } catch {
        alert('Network error while deleting FAQ');
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = inputId?.value || '';
    const question = inputQ?.value.trim();
    const answer = inputA?.value.trim();
    const category = selectCat?.value || 'General';
    const calculatorSlug = selectCalc?.value || undefined;

    if (!question || !answer) {
      if (statusAlert) {
        statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300';
        statusAlert.textContent = 'Question and Answer are required.';
        statusAlert.classList.remove('hidden');
      }
      return;
    }

    if (statusAlert) {
      statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300';
      statusAlert.textContent = 'Saving FAQ item...';
      statusAlert.classList.remove('hidden');
    }

    try {
      const token = getAuthToken();
      const res = await fetch('/api/admin/faqs', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
        },
        body: JSON.stringify({ id, question, answer, category, calculatorSlug }),
      });

      const data = await res.json();
      if (res.ok && data.success) {
        statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
        statusAlert.textContent = '✓ FAQ item saved successfully!';
        setTimeout(() => window.location.reload(), 700);
      } else {
        statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300';
        statusAlert.textContent = data.error || 'Failed to save FAQ';
      }
    } catch {
      statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300';
      statusAlert.textContent = 'Connection error while saving FAQ';
    }
  });
</script>
