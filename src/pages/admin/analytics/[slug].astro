---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { calculators } from '../../../data/calculators';
import { getCalculatorDetailFunnel } from '../../../lib/analytics/store';
import type { AnalyticsDateRange } from '../../../lib/analytics/types';

const { slug } = Astro.params;
const calc = calculators.find((c) => c.slug === slug);

if (!calc) {
  return Astro.redirect('/admin/analytics/');
}

const url = Astro.url;
const range = (url.searchParams.get('range') || '28d') as AnalyticsDateRange;

// Fetch detailed funnel metrics for this calculator
const detail = await getCalculatorDetailFunnel(calc.slug, range, Astro.locals);
if (!detail) {
  return Astro.redirect('/admin/analytics/');
}

const rangeLabels: Record<AnalyticsDateRange, string> = {
  today: 'Today',
  '7d': 'Last 7 Days',
  '28d': 'Last 28 Days',
  '3m': 'Last 3 Months',
};

const gradeColors = {
  optimal: 'bg-emerald-500 text-white',
  good: 'bg-blue-600 text-white',
  needs_attention: 'bg-amber-500 text-white',
  critical: 'bg-red-600 text-white',
};

const gradeTextColors = {
  optimal: 'text-emerald-600 dark:text-emerald-400',
  good: 'text-blue-600 dark:text-blue-400',
  needs_attention: 'text-amber-600 dark:text-amber-400',
  critical: 'text-red-600 dark:text-red-400',
};
---

<AdminLayout title={`${calc.name} Funnel Analytics | Calculator CMS`} sectionTitle="Analytics" activeSection="analytics">
  <div class="space-y-8 max-w-7xl mx-auto pb-16">

    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-1.5">
          <a href="/admin/analytics/" class="hover:text-blue-600 dark:hover:text-blue-400">Analytics</a>
          <span>/</span>
          <span class="text-slate-800 dark:text-slate-200 font-medium">{calc.category}</span>
          <span>/</span>
          <span class="text-slate-500 truncate">{calc.name}</span>
        </nav>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
          <span>{calc.icon || '🧮'}</span>
          <span>{calc.name} Funnel Analytics</span>
        </h2>
      </div>

      <!-- Actions & Date Range Selector -->
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href={calc.path}
          target="_blank"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition"
        >
          <span>🔗</span> View Live Tool
        </a>
        <a
          href={`/admin/calculator-health/${calc.slug}/`}
          class="inline-flex items-center gap-1.5 rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-bold text-indigo-700 hover:bg-indigo-100 dark:border-indigo-900 dark:bg-indigo-950/60 dark:text-indigo-300 transition"
        >
          <span>🛡️</span> Health &amp; Tests
        </a>

        <!-- Date Range Pills -->
        <div class="flex items-center gap-1 rounded-2xl border border-slate-200 bg-white p-1 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
          {(['today', '7d', '28d', '3m'] as AnalyticsDateRange[]).map((r) => (
            <a
              href={`/admin/analytics/${calc.slug}/?range=${r}`}
              class={`rounded-xl px-2.5 py-1 text-xs font-bold transition ${
                range === r
                  ? 'bg-blue-600 text-white shadow-xs'
                  : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white'
              }`}
            >
              {rangeLabels[r]}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- 1. Conversion Score & Summary Banner -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Conversion Score Gauge Card (5 Cols) -->
      <div class="lg:col-span-5 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between space-y-5">
        <div class="flex items-start justify-between">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Conversion Rating</span>
            <h3 class="text-lg font-black text-slate-900 dark:text-white mt-0.5">0-100 Performance Score</h3>
          </div>
          <span class={`rounded-full px-3 py-1 text-xs font-black uppercase ${gradeColors[detail.conversionGrade]}`}>
            {detail.conversionGrade.replace('_', ' ')}
          </span>
        </div>

        <div class="flex items-baseline gap-2">
          <span class={`text-6xl font-black tracking-tight font-mono ${gradeTextColors[detail.conversionGrade]}`}>
            {detail.conversionScore}
          </span>
          <span class="text-slate-400 font-bold text-xl">/ 100</span>
        </div>

        <!-- Formula Components Breakdown -->
        <div class="space-y-2.5 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
          <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
            <span>Form Activation (Start Rate):</span>
            <strong class="font-mono text-slate-900 dark:text-white">{detail.startRate}%</strong>
          </div>
          <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
            <span>Form Completion (Calculate Rate):</span>
            <strong class="font-mono text-slate-900 dark:text-white">{detail.calculateRate}%</strong>
          </div>
          <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
            <span>Formula Reliability (Success Rate):</span>
            <strong class="font-mono text-emerald-600 dark:text-emerald-400">{detail.successRate}%</strong>
          </div>
          <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
            <span>Result Engagement (Copy/Share):</span>
            <strong class="font-mono text-slate-900 dark:text-white">{detail.resultEngagementRate}%</strong>
          </div>
        </div>
      </div>

      <!-- Strengths & Optimization Insights (7 Cols) -->
      <div class="lg:col-span-7 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between space-y-4">
        <div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🔍</span> Performance Diagnosis &amp; Optimization
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Key factors driving this calculator's user activation and drop-off rates
          </p>
        </div>

        <!-- Strengths -->
        <div class="space-y-2">
          <h4 class="text-xs font-extrabold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-1.5">
            <span>✅</span> Strengths
          </h4>
          {detail.strengths.length > 0 ? (
            <ul class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
              {detail.strengths.map((s) => (
                <li class="flex items-start gap-2 bg-emerald-50/50 dark:bg-emerald-950/20 p-2 rounded-xl border border-emerald-100 dark:border-emerald-900/40">
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">•</span>
                  <span>{s}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-xs text-slate-400 italic">No significant strengths detected yet in this period.</p>
          )}
        </div>

        <!-- Needs Improvement -->
        <div class="space-y-2">
          <h4 class="text-xs font-extrabold uppercase text-amber-700 dark:text-amber-400 flex items-center gap-1.5">
            <span>💡</span> Areas for Improvement
          </h4>
          {detail.needsImprovement.length > 0 ? (
            <ul class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
              {detail.needsImprovement.map((imp) => (
                <li class="flex items-start gap-2 bg-amber-50/50 dark:bg-amber-950/20 p-2 rounded-xl border border-amber-100 dark:border-amber-900/40">
                  <span class="text-amber-600 dark:text-amber-400 font-bold shrink-0">•</span>
                  <span>{imp}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">All funnel stages operating at optimal benchmark.</p>
          )}
        </div>
      </div>

    </div>

    <!-- 2. Visual 4-Stage Funnel Journey -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-7 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-6">
      <div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🪜</span> 4-Stage Calculator User Funnel
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Step-by-step visitor progression from landing on the page to computing verified results
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        {detail.stages.map((stage, idx) => {
          const colors = [
            'from-blue-600 to-blue-500',
            'from-indigo-600 to-indigo-500',
            'from-violet-600 to-violet-500',
            'from-emerald-600 to-emerald-500',
          ];

          return (
            <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-950/40 flex flex-col justify-between space-y-3 relative">
              <div class="space-y-1">
                <span class="text-[10px] font-extrabold uppercase text-slate-400">
                  Stage {idx + 1}
                </span>
                <h4 class="font-bold text-sm text-slate-900 dark:text-white">
                  {stage.name}
                </h4>
                <div class="flex items-baseline gap-2 pt-1">
                  <span class="text-2xl font-black font-mono text-slate-900 dark:text-white">
                    {stage.count.toLocaleString()}
                  </span>
                  <span class="text-xs font-bold text-slate-500">
                    ({stage.percentageOfViews}% of views)
                  </span>
                </div>
              </div>

              <!-- Funnel Progress Bar -->
              <div class="space-y-1">
                <div class="h-2 w-full rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                  <div
                    class={`h-full rounded-full bg-linear-to-r ${colors[idx]}`}
                    style={`width: ${stage.percentageOfViews}%`}
                  ></div>
                </div>
                {idx > 0 && (
                  <div class="flex items-center justify-between text-[11px] pt-1">
                    <span class="text-slate-400">Drop-off:</span>
                    <span class={`font-mono font-bold ${stage.dropOffFromPrevious > 50 ? 'text-amber-600 dark:text-amber-400' : 'text-slate-600 dark:text-slate-400'}`}>
                      {stage.dropOffFromPrevious}%
                    </span>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- 3. Bottom Grid: Result Actions, Device Split & Traffic Sources -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Post-Result Actions Card -->
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-4">
        <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>✨</span> Post-Result Actions
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          User interactions after results are generated
        </p>

        <div class="space-y-3 pt-2">
          <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-100 dark:border-slate-800">
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">📋 Result Copies:</span>
            <strong class="font-mono text-sm text-slate-900 dark:text-white">{detail.resultCopies}</strong>
          </div>
          <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-100 dark:border-slate-800">
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">🔗 Link / Result Shares:</span>
            <strong class="font-mono text-sm text-slate-900 dark:text-white">{detail.resultShares}</strong>
          </div>
          <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-100 dark:border-slate-800">
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">🔄 Calculator Resets:</span>
            <strong class="font-mono text-sm text-slate-900 dark:text-white">{detail.resets}</strong>
          </div>
        </div>
      </div>

      <!-- Device Breakdown Card -->
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-4">
        <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📱</span> Device Distribution
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Visitors by client device hardware
        </p>

        <div class="space-y-3 pt-2">
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-slate-700 dark:text-slate-300">📱 Mobile</span>
              <span class="font-mono text-slate-900 dark:text-white">{detail.deviceSplit.mobile}%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-blue-600 rounded-full" style={`width: ${detail.deviceSplit.mobile}%`}></div>
            </div>
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-slate-700 dark:text-slate-300">💻 Desktop</span>
              <span class="font-mono text-slate-900 dark:text-white">{detail.deviceSplit.desktop}%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-indigo-600 rounded-full" style={`width: ${detail.deviceSplit.desktop}%`}></div>
            </div>
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-slate-700 dark:text-slate-300">📟 Tablet</span>
              <span class="font-mono text-slate-900 dark:text-white">{detail.deviceSplit.tablet}%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-purple-600 rounded-full" style={`width: ${detail.deviceSplit.tablet}%`}></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Traffic Source Breakdown Card -->
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-4">
        <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🌐</span> Traffic Sources
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Inbound channels driving calculation visits
        </p>

        <div class="space-y-3 pt-2">
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-slate-700 dark:text-slate-300">🔍 Google / Organic</span>
              <span class="font-mono text-slate-900 dark:text-white">{detail.sourceSplit.organic}%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-emerald-600 rounded-full" style={`width: ${detail.sourceSplit.organic}%`}></div>
            </div>
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-slate-700 dark:text-slate-300">🔗 Direct</span>
              <span class="font-mono text-slate-900 dark:text-white">{detail.sourceSplit.direct}%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-blue-600 rounded-full" style={`width: ${detail.sourceSplit.direct}%`}></div>
            </div>
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-slate-700 dark:text-slate-300">📱 Social</span>
              <span class="font-mono text-slate-900 dark:text-white">{detail.sourceSplit.social}%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-pink-600 rounded-full" style={`width: ${detail.sourceSplit.social}%`}></div>
            </div>
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-slate-700 dark:text-slate-300">↗️ Referral / Other</span>
              <span class="font-mono text-slate-900 dark:text-white">{detail.sourceSplit.referral}%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div class="h-full bg-amber-600 rounded-full" style={`width: ${detail.sourceSplit.referral}%`}></div>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</AdminLayout>
