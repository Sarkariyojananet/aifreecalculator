---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getContactMessages, getContactNotificationEmail, getDb } from '../../../lib/db';
import { authenticateAdminRequest } from '../../../lib/auth';

export const prerender = false;

const user = await authenticateAdminRequest(Astro.request, Astro.cookies);
if (!user) {
  return Astro.redirect(`/admin/barwalaoffice/?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}

const db = getDb(Astro.locals);
const messages = await getContactMessages(db);
const targetEmail = await getContactNotificationEmail(db, Astro.locals);

const unreadCount = messages.filter((m) => m.status === 'new').length;
const repliedCount = messages.filter((m) => m.status === 'replied').length;
const totalCount = messages.length;
---

<AdminLayout title="Inbox & Messages | Calculator CMS" sectionTitle="Inbox & Messages" activeSection="messages" badge={`${unreadCount} New`}>
  <div class="space-y-6 max-w-6xl mx-auto pb-12">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
          <span>📬</span> Contact Inquiries &amp; Messages (<span id="header-total-count">{totalCount}</span>)
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Messages received from visitors via the Contact Us form and sent to <code class="font-mono text-blue-600 dark:text-blue-400 font-bold">support@aifreecalculator.com</code>.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={`mailto:${targetEmail}`}
          class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition shadow-2xs"
        >
          <span>✉️</span> Open Mailbox
        </a>
        <button
          type="button"
          id="btn-refresh-messages"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer"
        >
          <span id="refresh-spinner">🔄</span> Refresh
        </button>
      </div>
    </div>

    <!-- Notification Email Forwarding Configuration Banner -->
    <div class="rounded-2xl border border-blue-200 bg-blue-50/70 p-4 dark:border-blue-900/60 dark:bg-blue-950/40 text-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-slate-800 dark:text-slate-100 font-bold">
          <span>📬</span>
          <span>Contact Form Forwarding Destination:</span>
          <span id="label-target-email" class="rounded-lg bg-white px-2 py-0.5 font-mono text-blue-700 dark:bg-slate-900 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
            {targetEmail}
          </span>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          Inquiries submitted on the website contact form are saved in D1 and forwarded to this email address.
          <span class="block mt-0.5 text-blue-600 dark:text-blue-400">
            💡 Delivered to verified recipient via Cloudflare Email Service (indiarojgaarcom@gmail.com).
          </span>
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <input
          type="email"
          id="input-notification-email"
          placeholder="Enter your Gmail address..."
          value={targetEmail}
          class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white w-52 sm:w-60"
        />
        <button
          type="button"
          id="btn-save-email"
          class="rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white hover:bg-blue-700 transition cursor-pointer"
        >
          Save Email
        </button>
      </div>
    </div>

    <!-- Live Status Banner for Email Saving & Operations -->
    <div id="email-status-banner" class="hidden rounded-xl px-4 py-2.5 text-xs font-semibold transition shadow-xs"></div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div
        data-stat-filter="new"
        title="Click to view Unread messages"
        class="stat-card cursor-pointer group rounded-2xl border border-blue-200 bg-blue-50/50 p-4 dark:border-blue-900/60 dark:bg-blue-950/30 flex items-center justify-between hover:border-blue-400 dark:hover:border-blue-700 hover:shadow-md transition"
      >
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300 group-hover:underline">New / Unread</p>
          <p class="text-2xl font-black text-blue-900 dark:text-blue-100 mt-1" id="stat-unread-count">{unreadCount}</p>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-200 text-lg group-hover:scale-110 transition-transform">
          🔔
        </div>
      </div>

      <div
        data-stat-filter="replied"
        title="Click to view Replied messages"
        class="stat-card cursor-pointer group rounded-2xl border border-emerald-200 bg-emerald-50/50 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/30 flex items-center justify-between hover:border-emerald-400 dark:hover:border-emerald-700 hover:shadow-md transition"
      >
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 group-hover:underline">Replied / Handled</p>
          <p class="text-2xl font-black text-emerald-900 dark:text-emerald-100 mt-1" id="stat-replied-count">{repliedCount}</p>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-200 text-lg group-hover:scale-110 transition-transform">
          ✅
        </div>
      </div>

      <div
        data-stat-filter="all"
        title="Click to view All messages"
        class="stat-card cursor-pointer group rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 flex items-center justify-between hover:border-slate-400 dark:hover:border-slate-600 hover:shadow-md transition"
      >
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 group-hover:underline">Total Inquiries</p>
          <p class="text-2xl font-black text-slate-900 dark:text-white mt-1" id="stat-total-count">{totalCount}</p>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 text-lg group-hover:scale-110 transition-transform">
          📥
        </div>
      </div>
    </div>

    <!-- Controls & Filters -->
    <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0" id="filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="filter-btn active rounded-xl px-3.5 py-1.5 text-xs font-bold bg-blue-600 text-white cursor-pointer transition"
        >
          All ({totalCount})
        </button>
        <button
          type="button"
          data-filter="new"
          class="filter-btn rounded-xl px-3.5 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer transition"
        >
          Unread ({unreadCount})
        </button>
        <button
          type="button"
          data-filter="replied"
          class="filter-btn rounded-xl px-3.5 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer transition"
        >
          Replied ({repliedCount})
        </button>
        <button
          type="button"
          data-filter="archived"
          class="filter-btn rounded-xl px-3.5 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer transition"
        >
          Archived
        </button>
      </div>

      <div class="relative min-w-[240px]">
        <input
          type="text"
          id="search-messages"
          placeholder="Search by name, email, subject..."
          class="w-full rounded-xl border border-slate-300 bg-white py-2 pl-9 pr-3 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
        <span class="absolute left-3 top-2.5 text-xs text-slate-400">🔍</span>
      </div>
    </div>

    <!-- Messages Container -->
    <div id="messages-list" class="space-y-4">
      <div id="empty-messages-placeholder" class={`${messages.length === 0 ? '' : 'hidden '}rounded-3xl border border-dashed border-slate-300 dark:border-slate-800 p-12 text-center bg-slate-50/50 dark:bg-slate-900/30`}>
        <span class="text-4xl">📭</span>
        <h3 class="mt-3 text-sm font-bold text-slate-900 dark:text-white">No Contact Messages Yet</h3>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto">
          When users submit questions, bug reports, or calculator requests on the Contact page, they will appear right here and be forwarded to support@aifreecalculator.com.
        </p>
      </div>

      {messages.map((msg) => {
          const isNew = msg.status === 'new';
          const isReplied = msg.status === 'replied';
          const isArchived = msg.status === 'archived';

          return (
            <div
              class="message-card group rounded-2xl border transition-all duration-200 bg-white dark:bg-slate-900 p-5 shadow-2xs hover:shadow-md"
              data-id={msg.id}
              data-status={msg.status}
              data-search={`${msg.name} ${msg.email} ${msg.subject} ${msg.category} ${msg.message}`.toLowerCase()}
              class:list={[
                isNew ? 'border-blue-200 dark:border-blue-900/60 bg-blue-50/10' : 'border-slate-200 dark:border-slate-800'
              ]}
            >
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-black text-slate-900 dark:text-white text-sm">
                      {msg.name}
                    </span>
                    <a
                      href={`mailto:${msg.email}`}
                      class="font-mono text-xs text-blue-600 dark:text-blue-400 hover:underline"
                    >
                      &lt;{msg.email}&gt;
                    </a>
                    
                    <!-- Category Badge -->
                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                      {msg.category || 'General'}
                    </span>

                    <!-- Status Badge -->
                    {isNew && (
                      <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300 animate-pulse">
                        ● New
                      </span>
                    )}
                    {isReplied && (
                      <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                        ✓ Replied
                      </span>
                    )}
                    {isArchived && (
                      <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                        📦 Archived
                      </span>
                    )}
                  </div>

                  <h4 class="font-bold text-xs text-slate-800 dark:text-slate-200">
                    Subject: <span class="font-normal text-slate-900 dark:text-white">{msg.subject}</span>
                  </h4>
                </div>

                <div class="text-right shrink-0">
                  <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500">
                    {new Date(msg.created_at).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' })}
                  </span>
                </div>
              </div>

              <!-- Message Body -->
              <div class="mt-3.5 rounded-xl bg-slate-50 p-3.5 text-xs text-slate-700 leading-relaxed dark:bg-slate-950/60 dark:text-slate-300 border border-slate-100 dark:border-slate-800/80 whitespace-pre-wrap">
                {msg.message}
              </div>

              <!-- Card Action Bar -->
              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-1.5 text-[10px] font-mono text-slate-400">
                  <span>ID: {msg.id}</span>
                </div>

                <div class="flex items-center gap-2">
                  <a
                    href={`mailto:${msg.email}?subject=Re: [AI Free Calculator] ${encodeURIComponent(msg.subject)}&body=Hi ${encodeURIComponent(msg.name)},%0D%0A%0D%0AThank you for reaching out to AI Free Calculator regarding "${encodeURIComponent(msg.subject)}".%0D%0A%0D%0A`}
                    target="_blank"
                    class="btn-reply-email inline-flex items-center gap-1 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-blue-700 transition"
                    data-id={msg.id}
                  >
                    <span>↩️</span> Reply via Email
                  </a>

                  {isNew ? (
                    <button
                      type="button"
                      class="btn-set-status rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer transition"
                      data-id={msg.id}
                      data-status="read"
                    >
                      Mark as Read
                    </button>
                  ) : null}

                  {!isReplied && (
                    <button
                      type="button"
                      class="btn-set-status rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700 hover:bg-emerald-100 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 cursor-pointer transition"
                      data-id={msg.id}
                      data-status="replied"
                    >
                      Mark Replied
                    </button>
                  )}

                  {!isArchived ? (
                    <button
                      type="button"
                      class="btn-set-status rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 cursor-pointer transition"
                      data-id={msg.id}
                      data-status="archived"
                      title="Archive message"
                    >
                      📦
                    </button>
                  ) : (
                    <button
                      type="button"
                      class="btn-set-status rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 cursor-pointer transition"
                      data-id={msg.id}
                      data-status="read"
                      title="Unarchive message"
                    >
                      Unarchive
                    </button>
                  )}

                  <button
                    type="button"
                    class="btn-delete-msg rounded-lg border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-bold text-red-600 hover:bg-red-100 dark:border-red-900/40 dark:bg-red-950/40 dark:text-red-400 cursor-pointer transition"
                    data-id={msg.id}
                    title="Delete message"
                  >
                    🗑️
                  </button>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- No Match Alert when filtering/searching -->
    <div id="no-filter-matches" class="hidden rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 p-8 text-center bg-slate-50/50 dark:bg-slate-900/30 text-slate-500">
      <p class="text-sm font-bold text-slate-800 dark:text-slate-200">No matching messages found</p>
      <p class="text-xs text-slate-400 mt-1">Try switching to the "All" tab or clearing the search box.</p>
    </div>

  </div>

  <script is:inline>
    function initMessagesDashboard() {
      // Filter Tabs & Search Filtering
      const filterBtns = document.querySelectorAll('.filter-btn');
      const searchInput = document.getElementById('search-messages');
      const messageCards = document.querySelectorAll('.message-card');
      const noFilterMatches = document.getElementById('no-filter-matches');
      const statCards = document.querySelectorAll('.stat-card');

      let currentFilter = 'all';
      let searchQuery = '';

      function applyFilters() {
        const currentCards = document.querySelectorAll('.message-card');
        let visibleCount = 0;
        currentCards.forEach((card) => {
          const status = card.getAttribute('data-status') || '';
          const searchData = card.getAttribute('data-search') || '';

          const matchesStatus = currentFilter === 'all' || status === currentFilter;
          const matchesSearch = !searchQuery || searchData.includes(searchQuery);

          if (matchesStatus && matchesSearch) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noFilterMatches) {
          if (currentCards.length > 0 && visibleCount === 0) {
            noFilterMatches.classList.remove('hidden');
          } else {
            noFilterMatches.classList.add('hidden');
          }
        }
      }

      function recalculateDashboardCounters() {
        const remainingUnread = document.querySelectorAll('.message-card[data-status="new"]').length;
        const repliedCount = document.querySelectorAll('.message-card[data-status="replied"]').length;
        const totalCount = document.querySelectorAll('.message-card').length;

        // Stat cards
        const unreadStatEl = document.getElementById('stat-unread-count');
        if (unreadStatEl) unreadStatEl.textContent = String(remainingUnread);

        const repliedStatEl = document.getElementById('stat-replied-count');
        if (repliedStatEl) repliedStatEl.textContent = String(repliedCount);

        const totalStatEl = document.getElementById('stat-total-count');
        if (totalStatEl) totalStatEl.textContent = String(totalCount);

        // Top Header total count
        const headerTotalEl = document.getElementById('header-total-count');
        if (headerTotalEl) headerTotalEl.textContent = String(totalCount);

        // Filter tab buttons (All, Unread, Replied)
        const allTabBtn = document.querySelector('.filter-btn[data-filter="all"]');
        if (allTabBtn) allTabBtn.textContent = `All (${totalCount})`;

        const unreadTabBtn = document.querySelector('.filter-btn[data-filter="new"]');
        if (unreadTabBtn) unreadTabBtn.textContent = `Unread (${remainingUnread})`;

        const repliedTabBtn = document.querySelector('.filter-btn[data-filter="replied"]');
        if (repliedTabBtn) repliedTabBtn.textContent = `Replied (${repliedCount})`;

        // Empty state placeholder
        const emptyPlaceholder = document.getElementById('empty-messages-placeholder');
        if (emptyPlaceholder) {
          if (totalCount === 0) {
            emptyPlaceholder.classList.remove('hidden');
          } else {
            emptyPlaceholder.classList.add('hidden');
          }
        }

        // Global sidebar badge & floating notification popup
        if (typeof window.updateAdminUnreadCount === 'function') {
          window.updateAdminUnreadCount(remainingUnread);
        }
      }

      // Filter tabs event listeners
      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.classList.remove('bg-blue-600', 'text-white', 'active');
            b.classList.add('text-slate-600', 'dark:text-slate-300');
          });
          btn.classList.add('bg-blue-600', 'text-white', 'active');
          btn.classList.remove('text-slate-600', 'dark:text-slate-300');
          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      // Quick Stats Cards click event listeners
      statCards.forEach((card) => {
        card.addEventListener('click', () => {
          const targetFilter = card.getAttribute('data-stat-filter');
          if (!targetFilter) return;
          const targetTab = document.querySelector(`.filter-btn[data-filter="${targetFilter}"]`);
          if (targetTab) {
            targetTab.click();
            targetTab.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      });

      searchInput?.addEventListener('input', (e) => {
        searchQuery = (e.target.value || '').trim().toLowerCase();
        applyFilters();
      });

      function getAuthToken() {
        return localStorage.getItem('admin_token') || '';
      }

      function showStatusBanner(message, isSuccess = true) {
        const banner = document.getElementById('email-status-banner');
        if (!banner) return;
        banner.className = `rounded-xl px-4 py-2.5 text-xs font-semibold transition shadow-xs ${
          isSuccess
            ? 'bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/50 dark:text-emerald-300 dark:border-emerald-800'
            : 'bg-red-50 text-red-800 border border-red-200 dark:bg-red-950/50 dark:text-red-300 dark:border-red-800'
        }`;
        banner.textContent = message;
        banner.classList.remove('hidden');
        setTimeout(() => {
          banner.classList.add('hidden');
        }, 5000);
      }

      // Refresh Action
      const btnRefresh = document.getElementById('btn-refresh-messages');
      const refreshSpinner = document.getElementById('refresh-spinner');
      btnRefresh?.addEventListener('click', () => {
        if (refreshSpinner) refreshSpinner.classList.add('animate-spin');
        btnRefresh.disabled = true;
        btnRefresh.style.opacity = '0.7';
        window.location.reload();
      });

      // Save Notification Email Action
      const btnSaveEmail = document.getElementById('btn-save-email');
      const inputEmail = document.getElementById('input-notification-email');
      const labelEmail = document.getElementById('label-target-email');

      if (btnSaveEmail) {
        btnSaveEmail.addEventListener('click', async function () {
          const email = inputEmail && inputEmail.value ? inputEmail.value.trim() : '';
          if (!email || !email.includes('@')) {
            showStatusBanner('Please enter a valid email address (e.g. name@domain.com).', false);
            return;
          }

          btnSaveEmail.disabled = true;
          const origText = btnSaveEmail.textContent;
          btnSaveEmail.textContent = 'Saving...';

          try {
            const token = getAuthToken();
            const res = await fetch('/api/admin/messages', {
              method: 'POST',
              credentials: 'include',
              headers: {
                'Content-Type': 'application/json',
                ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
              },
              body: JSON.stringify({ email: email }),
            });

            if (res.ok) {
              if (labelEmail) labelEmail.textContent = email;
              showStatusBanner(`✓ Forwarding email successfully updated to: ${email}`, true);
              btnSaveEmail.textContent = '✓ Saved!';
              setTimeout(function () {
                btnSaveEmail.disabled = false;
                btnSaveEmail.textContent = origText;
              }, 1500);
            } else {
              const errData = await res.json().catch(() => ({}));
              showStatusBanner(errData.error || 'Failed to save notification email.', false);
              btnSaveEmail.disabled = false;
              btnSaveEmail.textContent = origText;
            }
          } catch (err) {
            showStatusBanner('Network error saving email.', false);
            btnSaveEmail.disabled = false;
            btnSaveEmail.textContent = origText;
          }
        });
      }

      // Helper to update card DOM and counters dynamically without full page reload
      function applyCardStatusUpdate(card, id, status) {
        if (!card) return;
        const oldStatus = card.getAttribute('data-status');
        card.setAttribute('data-status', status);

        // If transitioning from 'new' to another status:
        if (oldStatus === 'new' && status !== 'new') {
          card.classList.remove('border-blue-200', 'dark:border-blue-900/60', 'bg-blue-50/10');
          card.classList.add('border-slate-200', 'dark:border-slate-800');

          // Remove pulsating "● New" badge
          const newBadge = card.querySelector('.animate-pulse');
          if (newBadge) newBadge.remove();

          // Remove "Mark as Read" button
          card.querySelectorAll('.btn-set-status').forEach((b) => {
            if (b.getAttribute('data-status') === 'read' && b.textContent.includes('Mark as Read')) {
              b.remove();
            }
          });
        }

        // If marked as replied
        if (status === 'replied') {
          const badgesContainer = card.querySelector('.flex.flex-wrap.items-center.gap-2');
          if (badgesContainer && !badgesContainer.querySelector('.badge-replied')) {
            const repliedBadge = document.createElement('span');
            repliedBadge.className = 'badge-replied rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300';
            repliedBadge.textContent = '✓ Replied';
            badgesContainer.appendChild(repliedBadge);
          }
          // Remove "Mark Replied" button
          card.querySelectorAll('.btn-set-status').forEach((b) => {
            if (b.getAttribute('data-status') === 'replied') b.remove();
          });
        }

        // Recalculate stats on page, tabs, header, and global badge immediately!
        recalculateDashboardCounters();

        // If currently filtering to "new", smoothly hide the card
        if (currentFilter === 'new') {
          card.style.display = 'none';
        }
        applyFilters();
      }

      // Mark message as read when clicking an unread message card to view it
      document.querySelectorAll('.message-card').forEach((card) => {
        card.addEventListener('click', async (e) => {
          // Ignore clicks on buttons, links, or inputs inside the card
          if (e.target.closest('button') || e.target.closest('a') || e.target.closest('input')) return;

          const id = card.getAttribute('data-id');
          const status = card.getAttribute('data-status');
          if (status === 'new' && id) {
            applyCardStatusUpdate(card, id, 'read');
            try {
              const token = getAuthToken();
              fetch('/api/admin/messages', {
                method: 'PATCH',
                credentials: 'include',
                headers: {
                  'Content-Type': 'application/json',
                  ...(token ? { Authorization: `Bearer ${token}` } : {}),
                },
                body: JSON.stringify({ id: id, status: 'read' }),
              }).catch(() => {});
            } catch {}
          }
        });
      });

      // Direct Button Listeners for Mark Read / Replied / Archive
      document.querySelectorAll('.btn-set-status').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          const status = btn.getAttribute('data-status');
          if (!id || !status) return;

          const card = btn.closest('.message-card');
          btn.disabled = true;
          const originalText = btn.textContent;
          btn.textContent = 'Updating...';

          try {
            const token = getAuthToken();
            const res = await fetch('/api/admin/messages', {
              method: 'PATCH',
              credentials: 'include',
              headers: {
                'Content-Type': 'application/json',
                ...(token ? { Authorization: `Bearer ${token}` } : {}),
              },
              body: JSON.stringify({ id: id, status: status }),
            });

            if (res.ok) {
              applyCardStatusUpdate(card, id, status);
            } else {
              const errData = await res.json().catch(() => ({}));
              alert(errData.error || 'Failed to update message status.');
              btn.disabled = false;
              btn.textContent = originalText;
            }
          } catch (err) {
            alert('Network error while updating status.');
            btn.disabled = false;
            btn.textContent = originalText;
          }
        });
      });

      // Direct Button Listeners for Delete Message
      document.querySelectorAll('.btn-delete-msg').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          if (!id) return;
          if (!confirm('Are you sure you want to permanently delete this message?')) return;

          btn.disabled = true;
          const card = btn.closest('.message-card');

          try {
            const token = getAuthToken();
            const res = await fetch('/api/admin/messages?id=' + encodeURIComponent(id), {
              method: 'DELETE',
              credentials: 'include',
              headers: token ? { Authorization: `Bearer ${token}` } : {},
            });

            if (res.ok) {
              if (card) {
                card.style.transition = 'all 0.2s ease-out';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.96)';
                setTimeout(() => {
                  card.remove();
                  recalculateDashboardCounters();
                  applyFilters();
                }, 200);
              } else {
                recalculateDashboardCounters();
                applyFilters();
              }
            } else {
              const errData = await res.json().catch(() => ({}));
              alert(errData.error || 'Failed to delete message.');
              btn.disabled = false;
            }
          } catch (err) {
            alert('Network error while deleting message.');
            btn.disabled = false;
          }
        });
      });

      // Direct Button Listeners for Reply via Email
      document.querySelectorAll('.btn-reply-email').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          const card = btn.closest('.message-card');
          if (id) {
            applyCardStatusUpdate(card, id, 'replied');
            const token = getAuthToken();
            fetch('/api/admin/messages', {
              method: 'PATCH',
              credentials: 'include',
              headers: {
                'Content-Type': 'application/json',
                ...(token ? { Authorization: `Bearer ${token}` } : {}),
              },
              body: JSON.stringify({ id: id, status: 'replied' }),
            }).catch(() => {});
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMessagesDashboard);
    } else {
      initMessagesDashboard();
    }
  </script>
</AdminLayout>
