---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="AdSense & AdX Settings | AI Free Calculator" activeTab="settings">
  <div class="space-y-8 max-w-6xl mx-auto">
    
    <!-- Top Header Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6 dark:border-slate-800">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-100 text-lg text-blue-600 dark:bg-blue-950 dark:text-blue-400">
            📢
          </span>
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
              Ad Setup &amp; Monetization (AdSense, AdX &amp; 3rd-Party)
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Manage Google AdSense, Google Ad Manager (AdX), 3rd-party ad networks, global scripts, and authorized <code class="font-mono text-blue-600 dark:text-blue-400">/ads.txt</code> sellers.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Status Badges -->
      <div class="flex items-center gap-2">
        <span id="badge-global-status" class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          <span class="h-2 w-2 rounded-full bg-slate-400" aria-hidden="true"></span> Loading...
        </span>
        <span id="badge-test-mode" style="display: none;" class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
          🛠️ Test Mode ON
        </span>
      </div>
    </div>

    <!-- Main Settings Form -->
    <form id="adsense-full-form" class="space-y-8" novalidate aria-label="Ad configuration form">
      
      <!-- 1. Master Ad Network Setup -->
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 sm:p-8 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 dark:border-slate-800">
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span aria-hidden="true">🌐</span> Master Ad Network Controls
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Control global advertisement display, preview mode, and Google AdSense credentials.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Master Ads Toggle Switch -->
          <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-950/40">
            <div>
              <label for="field-enabled" class="block text-xs font-bold text-slate-900 dark:text-white cursor-pointer select-none">
                Enable Ads Site-Wide
              </label>
              <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Toggle all advertisements on/off with one switch</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="field-enabled"
                role="switch"
                class="sr-only peer"
                aria-checked="false"
              />
              <div
                class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500 peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-slate-900"
                aria-hidden="true"
              ></div>
            </label>
          </div>

          <!-- Test / Mockup Mode Switch -->
          <div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-950/40">
            <div>
              <label for="field-test-mode" class="block text-xs font-bold text-slate-900 dark:text-white cursor-pointer select-none">
                Test / Preview Mode
                <span class="ml-1 rounded bg-amber-200 px-1.5 py-0.5 text-[9px] font-extrabold text-amber-900 dark:bg-amber-900/60 dark:text-amber-200">SAFE</span>
              </label>
              <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Show visual test placeholders without requesting live ads</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                id="field-test-mode"
                role="switch"
                class="sr-only peer"
                aria-checked="false"
              />
              <div
                class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500 dark:bg-slate-700 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500 peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-slate-900"
                aria-hidden="true"
              ></div>
            </label>
          </div>

        </div>

        <!-- Publisher Client ID Field (AdSense) -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="field-client-id" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Google AdSense Publisher ID (<span class="font-mono text-blue-600 dark:text-blue-400">ca-pub-XXXXXXXXXXXXXXXX</span>)
            </label>
            <span class="text-[11px] text-slate-400 font-medium">Leave blank if only using 3rd-party ad networks</span>
          </div>
          <div class="relative flex items-center">
            <span class="pointer-events-none absolute left-3.5 text-slate-400 text-sm" aria-hidden="true">🆔</span>
            <input
              type="text"
              id="field-client-id"
              placeholder="ca-pub-1234567890123456"
              autocomplete="off"
              spellcheck="false"
              class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-10 pr-4 text-sm font-mono font-semibold text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              aria-describedby="client-id-hint client-id-error"
            />
          </div>
          <p id="client-id-hint" class="text-[11px] text-slate-500 dark:text-slate-400">
            Found in AdSense under <strong>Account → Settings → Account information → Publisher ID</strong>.
          </p>
          <p id="client-id-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400" role="alert" aria-live="polite"></p>
        </div>

        <!-- Auto Ads Option -->
        <div class="flex items-center justify-between rounded-xl border border-slate-100 bg-slate-50/40 p-3.5 dark:border-slate-800/80 dark:bg-slate-950/20">
          <div class="flex items-center gap-3">
            <span class="text-lg" aria-hidden="true">🤖</span>
            <div>
              <label for="field-auto-ads" class="block text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer select-none">
                Enable Google Auto Ads
              </label>
              <div class="text-[10px] text-slate-500 dark:text-slate-400">Allows Google AdSense Auto ads to automatically place eligible ads based on your AdSense dashboard setup.</div>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input
              type="checkbox"
              id="field-auto-ads"
              role="switch"
              class="sr-only peer"
              aria-checked="false"
            />
            <div
              class="w-9 h-5 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600 dark:bg-slate-700 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500 peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-slate-900"
              aria-hidden="true"
            ></div>
          </label>
        </div>

        <!-- Global Header Script / 3rd-Party Head Tag -->
        <div class="space-y-2 border-t border-slate-100 pt-4 dark:border-slate-800">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
            <label for="field-header-script" class="block text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>⚡</span> Global Header Script / 3rd-Party Ad Network Tag (<code class="text-indigo-600 dark:text-indigo-400">&lt;head&gt;</code>)
            </label>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-insert-gpt-header"
                class="text-[10px] font-bold text-indigo-600 hover:underline dark:text-indigo-400 cursor-pointer"
              >
                + Insert Google GPT Head Tag
              </button>
              <button
                type="button"
                id="btn-insert-prebid-header"
                class="text-[10px] font-bold text-purple-600 hover:underline dark:text-purple-400 cursor-pointer"
              >
                + Insert Prebid Tag
              </button>
            </div>
          </div>
          <textarea
            id="field-header-script"
            rows="3"
            placeholder="<!-- Global Ad Tag / Prebid / GPT Head Tag -->&#10;&lt;script async src=&quot;https://securepubads.g.doubleclick.net/tag/js/gpt.js&quot;&gt;&lt;/script&gt;"
            autocomplete="off"
            spellcheck="false"
            class="w-full rounded-2xl border border-slate-300 bg-white p-3 font-mono text-xs text-slate-900 placeholder:text-slate-400 focus:border-indigo-600 focus:outline-hidden focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          ></textarea>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">
            Optional script injected into the page <code class="font-mono text-indigo-600 dark:text-indigo-400">&lt;head&gt;</code> for Google Ad Manager GPT, Prebid.js, Media.net, or other 3rd-party ad tags.
          </p>
        </div>

      </div>

      <!-- 2. Google Analytics 4 (GA4) Tracking Card -->
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 sm:p-8 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 dark:border-slate-800">
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span aria-hidden="true">📈</span> Google Analytics 4 (GA4) Setup
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Set your Google Analytics Measurement ID to track site visits, calculator events, and user engagement across the entire website.
            </p>
          </div>
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-bold text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
            Real-time Sync
          </span>
        </div>

        <div class="space-y-2">
          <label for="field-ga-id" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
            Google Analytics Measurement ID (<span class="font-mono text-emerald-600 dark:text-emerald-400">G-XXXXXXXXXX</span>)
          </label>
          <div class="relative flex items-center">
            <span class="pointer-events-none absolute left-3.5 text-slate-400 text-sm" aria-hidden="true">📊</span>
            <input
              type="text"
              id="field-ga-id"
              placeholder="e.g. G-6LRLPH95P7"
              autocomplete="off"
              spellcheck="false"
              class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-10 pr-4 text-sm font-mono font-semibold text-slate-900 placeholder:text-slate-400 focus:border-emerald-600 focus:outline-hidden focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              aria-describedby="ga-id-hint ga-id-error"
            />
          </div>
          <p id="ga-id-hint" class="text-[11px] text-slate-500 dark:text-slate-400">
            Found in Google Analytics under <strong>Admin → Data collection and modification → Data streams → Measurement ID</strong>. Leave empty if you do not want to track with Google Analytics.
          </p>
          <p id="ga-id-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400" role="alert" aria-live="polite"></p>
        </div>
      </div>

      <!-- 3. Multi-Location Ad Slots Management (4 Locations) -->
      <div class="space-y-4">
        <div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span aria-hidden="true">📐</span> Website Ad Placement Locations
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Configure each ad unit using standard Google AdSense (Slot ID) OR manually enter Google AdX / 3rd-party ad script code.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          
          <!-- Slot 1: Top Banner -->
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 flex flex-col justify-between space-y-4" data-slot-card="top">
            <div class="space-y-3">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-sm text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold" aria-hidden="true">1</span>
                  <div>
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white">Top Leaderboard Banner</h4>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Horizontal (728x90)</span>
                  </div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input
                    type="checkbox"
                    id="slot-top-enabled"
                    role="switch"
                    checked
                    class="sr-only peer"
                    aria-label="Enable Top Banner slot"
                    aria-checked="true"
                  />
                  <div
                    class="w-9 h-5 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600 dark:bg-slate-700 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500 peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-slate-900"
                    aria-hidden="true"
                  ></div>
                </label>
              </div>

              <!-- Network Mode Toggle -->
              <div class="flex rounded-xl bg-slate-100 p-1 dark:bg-slate-800/80 text-[11px] font-bold">
                <button
                  type="button"
                  data-network-btn="top"
                  data-network-val="adsense"
                  class="flex-1 rounded-lg py-1.5 text-center transition bg-white text-blue-600 shadow-xs dark:bg-slate-900 dark:text-blue-400 cursor-pointer"
                >
                  Google AdSense
                </button>
                <button
                  type="button"
                  data-network-btn="top"
                  data-network-val="adx"
                  class="flex-1 rounded-lg py-1.5 text-center text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition cursor-pointer"
                >
                  Google AdX / 3rd-Party Code
                </button>
              </div>

              <!-- AdSense Slot ID Input Box -->
              <div id="slot-top-adsense-box" class="space-y-1">
                <label for="slot-top-id" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                  AdSense Slot ID (Numeric)
                </label>
                <input
                  type="text"
                  id="slot-top-id"
                  placeholder="e.g. 1234567890"
                  autocomplete="off"
                  inputmode="numeric"
                  class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-mono font-bold text-slate-900 focus:border-blue-600 focus:outline-hidden focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
                  aria-describedby="slot-top-error"
                />
                <p id="slot-top-error" class="hidden mt-1 text-[11px] font-semibold text-red-600 dark:text-red-400" role="alert" aria-live="polite"></p>
              </div>

              <!-- Google AdX / Custom Code Textarea Box -->
              <div id="slot-top-adx-box" class="hidden space-y-1">
                <div class="flex items-center justify-between">
                  <label for="slot-top-code" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                    Manual AdX / 3rd-Party Ad Script Code
                  </label>
                  <span class="text-[10px] text-slate-400 font-mono">HTML / JS / GPT tag</span>
                </div>
                <textarea
                  id="slot-top-code"
                  rows="3"
                  placeholder="&lt;div id=&quot;div-gpt-ad-top&quot;&gt;&#10;  &lt;!-- Manual AdX / Custom ad script --&gt;&#10;&lt;/div&gt;"
                  autocomplete="off"
                  spellcheck="false"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 font-mono text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
                ></textarea>
                <p id="slot-top-code-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400" role="alert" aria-live="polite"></p>
              </div>
            </div>

            <div class="rounded-xl bg-slate-50 p-2.5 text-[10px] text-slate-500 dark:bg-slate-950/60 dark:text-slate-400 flex items-center justify-between">
              <span>Location: <code>data-ad-slot-location="top"</code></span>
              <span class="font-semibold text-blue-600 dark:text-blue-400">Header Leaderboard</span>
            </div>
          </div>

          <!-- Slot 2: In-Content Inline -->
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 flex flex-col justify-between space-y-4" data-slot-card="inline">
            <div class="space-y-3">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-50 text-sm text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400 font-bold" aria-hidden="true">2</span>
                  <div>
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white">In-Content Result Ad</h4>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Rectangle (336x280 / 300x250)</span>
                  </div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input
                    type="checkbox"
                    id="slot-inline-enabled"
                    role="switch"
                    checked
                    class="sr-only peer"
                    aria-label="Enable In-Content slot"
                    aria-checked="true"
                  />
                  <div
                    class="w-9 h-5 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-500 peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-slate-900"
                    aria-hidden="true"
                  ></div>
                </label>
              </div>

              <!-- Network Mode Toggle -->
              <div class="flex rounded-xl bg-slate-100 p-1 dark:bg-slate-800/80 text-[11px] font-bold">
                <button
                  type="button"
                  data-network-btn="inline"
                  data-network-val="adsense"
                  class="flex-1 rounded-lg py-1.5 text-center transition bg-white text-emerald-600 shadow-xs dark:bg-slate-900 dark:text-emerald-400 cursor-pointer"
                >
                  Google AdSense
                </button>
                <button
                  type="button"
                  data-network-btn="inline"
                  data-network-val="adx"
                  class="flex-1 rounded-lg py-1.5 text-center text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition cursor-pointer"
                >
                  Google AdX / 3rd-Party Code
                </button>
              </div>

              <!-- AdSense Slot ID Input Box -->
              <div id="slot-inline-adsense-box" class="space-y-1">
                <label for="slot-inline-id" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                  AdSense Slot ID (Numeric)
                </label>
                <input
                  type="text"
                  id="slot-inline-id"
                  placeholder="e.g. 2345678901"
                  autocomplete="off"
                  inputmode="numeric"
                  class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-mono font-bold text-slate-900 focus:border-emerald-600 focus:outline-hidden focus:ring-2 focus:ring-emerald-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
                  aria-describedby="slot-inline-error"
                />
                <p id="slot-inline-error" class="hidden mt-1 text-[11px] font-semibold text-red-600 dark:text-red-400" role="alert" aria-live="polite"></p>
              </div>

              <!-- Google AdX / Custom Code Textarea Box -->
              <div id="slot-inline-adx-box" class="hidden space-y-1">
                <div class="flex items-center justify-between">
                  <label for="slot-inline-code" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                    Manual AdX / 3rd-Party Ad Script Code
                  </label>
                  <span class="text-[10px] text-slate-400 font-mono">HTML / JS / GPT tag</span>
                </div>
                <textarea
                  id="slot-inline-code"
                  rows="3"
                  placeholder="&lt;div id=&quot;div-gpt-ad-inline&quot;&gt;&#10;  &lt;!-- Manual In-Content Ad Code --&gt;&#10;&lt;/div&gt;"
                  autocomplete="off"
                  spellcheck="false"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 font-mono text-xs text-slate-900 placeholder:text-slate-400 focus:border-emerald-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
                ></textarea>
                <p id="slot-inline-code-error" class="hidden text-[11px] font-semibold text-red-600 dark:text-red-400" role="alert" aria-live="polite"></p>
              </div>
            </div>

            <div class="rounded-xl bg-slate-50 p-2.5 text-[10px] text-slate-500 dark:bg-slate-950/60 dark:text-slate-400 flex items-center justify-between">
              <span>Location: <code>data-ad-slot-location="inline"</code></span>
              <span class="font-semibold text-emerald-600 dark:text-emerald-400">High Viewability Result</span>
            </div>
          </div>

          <!-- Slot 3: Sticky Sidebar -->
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 flex flex-col justify-between space-y-4" data-slot-card="sidebar">
            <div class="space-y-3">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
                <div class="flex items-center gap-2.5">
