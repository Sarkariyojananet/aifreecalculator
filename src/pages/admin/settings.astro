            class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span id="btn-reload-text">↻ Reload</span>
          </button>
        </div>

        <p id="form-status-msg" class="text-xs font-semibold text-slate-600 dark:text-slate-400" role="status" aria-live="polite"></p>
      </div>

    </form>

    <!-- 5. Interactive Live Previewer -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/80 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
        <div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span aria-hidden="true">👁️</span> Ad Placement Preview
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Visual mockup of each configured ad unit — no real live ads are loaded here.
          </p>
        </div>
      </div>

      <!-- Preview Tabs -->
      <div class="flex flex-wrap items-center gap-2 border-b border-slate-100 pb-3 dark:border-slate-800" role="tablist" aria-label="Ad placement preview tabs">
        <button
          type="button"
          role="tab"
          data-preview-tab="top"
          aria-selected="true"
          class="preview-tab active rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white transition focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none cursor-pointer"
        >
          Top Banner (728x90)
        </button>
        <button
          type="button"
          role="tab"
          data-preview-tab="inline"
          aria-selected="false"
          class="preview-tab rounded-xl bg-slate-100 px-3.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 transition focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none cursor-pointer"
        >
          In-Content (336x280)
        </button>
        <button
          type="button"
          role="tab"
          data-preview-tab="sidebar"
          aria-selected="false"
          class="preview-tab rounded-xl bg-slate-100 px-3.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 transition focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none cursor-pointer"
        >
          Sticky Sidebar (300x600)
        </button>
        <button
          type="button"
          role="tab"
          data-preview-tab="footer"
          aria-selected="false"
          class="preview-tab rounded-xl bg-slate-100 px-3.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 transition focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none cursor-pointer"
        >
          Footer Banner (728x90)
        </button>
      </div>

      <!-- Preview Box -->
      <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-950/40 flex items-center justify-center min-h-[180px]">
        <div id="preview-render-box" class="w-full text-center"></div>
      </div>
    </div>

  </div>
</AdminLayout>

<script is:inline>
  // ─── Constants & Presets ──────────────────────────────────────────────────────
  const PUB_ID_PATTERN  = /^ca-pub-\d+$/;
  const SLOT_ID_PATTERN = /^\d+$/;

  const PRESETS = {
    adx: `# Google Ad Manager / AdX Authorized Resellers\ngoogle.com, pub-1234567890123456, RESELLER, f08c47fec0942fa0\nrubiconproject.com, 1234, RESELLER, 0bfd66d529a55803\nappnexus.com, 5678, RESELLER, f5ab79cb980f11d1\npubmatic.com, 9012, RESELLER, 5d6247e0f4457746`,
    medianet: `# Media.net (Yahoo! Bing Network)\nmedianet.com, 8CUX12345, DIRECT\ncontextweb.com, 123456, RESELLER, 89ff14713cb38e68`,
    ezoic: `# Ezoic Partner Network\nezoic.com, 12345, DIRECT\ngoogle.com, pub-1234567890123456, RESELLER, f08c47fec0942fa0`,
    appnexus: `# AppNexus (Xandr / Microsoft Advertising)\nappnexus.com, 12345, DIRECT, f5ab79cb980f11d1`,
    pubmatic: `# PubMatic SSP\npubmatic.com, 123456, DIRECT, 5d6247e0f4457746`,
    rubicon: `# Rubicon Project (Magnite)\nrubiconproject.com, 12345, DIRECT, 0bfd66d529a55803`,
    amazon: `# Amazon Publisher Services (TAM / APS)\namazon.com, 1234, DIRECT`,
    taboola: `# Taboola Native Ads\ntaboola.com, 1234567, DIRECT`,
    outbrain: `# Outbrain Native Ads\noutbrain.com, 12345, DIRECT`,
    criteo: `# Criteo Advertising\ncriteo.com, 12345, DIRECT, b349c882414704e7`,
    infolinks: `# Infolinks In-Text & Overlay Ads\ninfolinks.com, 12345, DIRECT`,
    propeller: `# PropellerAds Network\npropellerads.com, 12345, DIRECT`,
  };

  // ─── Element References ───────────────────────────────────────────────────────
  const form            = document.getElementById('adsense-full-form');
  const statusMsg       = document.getElementById('form-status-msg');
  const btnSave         = document.getElementById('btn-save-adsense');
  const btnSaveText     = document.getElementById('btn-save-text');
  const btnSaveIcon     = document.getElementById('btn-save-icon');
  const btnReload       = document.getElementById('btn-reload-adsense');
  const btnReloadText   = document.getElementById('btn-reload-text');

  const fieldEnabled    = document.getElementById('field-enabled');
  const fieldTestMode   = document.getElementById('field-test-mode');
  const fieldAutoAds    = document.getElementById('field-auto-ads');
  const fieldClientId   = document.getElementById('field-client-id');
  const fieldGaId       = document.getElementById('field-ga-id');
  const fieldHeaderScript = document.getElementById('field-header-script');
  const clientIdError   = document.getElementById('client-id-error');
  const gaIdError       = document.getElementById('ga-id-error');

  const slotTopEnabled     = document.getElementById('slot-top-enabled');
  const slotTopId          = document.getElementById('slot-top-id');
  const slotTopCode        = document.getElementById('slot-top-code');
  const slotTopError       = document.getElementById('slot-top-error');
  const slotTopCodeError   = document.getElementById('slot-top-code-error');

  const slotInlineEnabled  = document.getElementById('slot-inline-enabled');
  const slotInlineId       = document.getElementById('slot-inline-id');
  const slotInlineCode     = document.getElementById('slot-inline-code');
  const slotInlineError    = document.getElementById('slot-inline-error');
  const slotInlineCodeError = document.getElementById('slot-inline-code-error');

  const slotSidebarEnabled = document.getElementById('slot-sidebar-enabled');
  const slotSidebarId      = document.getElementById('slot-sidebar-id');
  const slotSidebarCode    = document.getElementById('slot-sidebar-code');
  const slotSidebarError   = document.getElementById('slot-sidebar-error');
  const slotSidebarCodeError = document.getElementById('slot-sidebar-code-error');

  const slotFooterEnabled  = document.getElementById('slot-footer-enabled');
  const slotFooterId       = document.getElementById('slot-footer-id');
  const slotFooterCode     = document.getElementById('slot-footer-code');
  const slotFooterError    = document.getElementById('slot-footer-error');
  const slotFooterCodeError = document.getElementById('slot-footer-code-error');

  const badgeGlobalStatus  = document.getElementById('badge-global-status');
  const badgeTestMode      = document.getElementById('badge-test-mode');
  
  const fieldIncludeGoogleAdsTxt = document.getElementById('field-include-google-ads-txt');
  const fieldThirdPartyAdsTxt   = document.getElementById('field-third-party-ads-txt');
  const adsTxtSnippet           = document.getElementById('ads-txt-snippet');
  const adsTxtWarning           = document.getElementById('ads-txt-warning');
  const adsTxtLineCount         = document.getElementById('ads-txt-line-count');
  const adsTxtValidationMsg     = document.getElementById('ads-txt-validation-msg');
  const fullAdsTxtPreview       = document.getElementById('full-ads-txt-preview');
  const btnCopyAdsTxt           = document.getElementById('btn-copy-ads-txt');
  const copyBtnText             = document.getElementById('copy-btn-text');
  const fileImportAdsTxt        = document.getElementById('file-import-ads-txt');
  const btnDedupAdsTxt          = document.getElementById('btn-dedup-ads-txt');
  const btnValidateAdsTxt       = document.getElementById('btn-validate-ads-txt');

  const previewRenderBox   = document.getElementById('preview-render-box');
  const previewTabs        = document.querySelectorAll('.preview-tab');

  const btnInsertGptHeader = document.getElementById('btn-insert-gpt-header');
  const btnInsertPrebidHeader = document.getElementById('btn-insert-prebid-header');

  // Track active network choice for each slot: 'adsense' | 'adx'
  const slotNetworks = {
    top: 'adsense',
    inline: 'adsense',
    sidebar: 'adsense',
    footer: 'adsense',
  };

  let activePreviewTab = 'top';
  let isSaving         = false;
  let isReloading      = false;

  // ─── Helpers ─────────────────────────────────────────────────────────────────
  function setFieldError(el, msg) {
    if (!el) return;
    if (msg) { el.textContent = msg; el.classList.remove('hidden'); }
    else     { el.textContent = '';  el.classList.add('hidden');    }
  }

  function setStatus(msg, type) {
    const cls = {
      neutral: 'text-xs font-semibold text-slate-600 dark:text-slate-400',
      success: 'text-xs font-semibold text-emerald-600 dark:text-emerald-400',
      error:   'text-xs font-semibold text-red-600 dark:text-red-400',
      loading: 'text-xs font-semibold text-blue-600 dark:text-blue-400',
    };
    if (statusMsg) {
      statusMsg.className = cls[type] || cls.neutral;
      statusMsg.textContent = msg || '';
    }
  }

  function setSlotNetwork(slotKey, network) {
    slotNetworks[slotKey] = network;

    const adsenseBox = document.getElementById(`slot-${slotKey}-adsense-box`);
    const adxBox = document.getElementById(`slot-${slotKey}-adx-box`);
    const buttons = document.querySelectorAll(`[data-network-btn="${slotKey}"]`);

    if (network === 'adx') {
      adsenseBox?.classList.add('hidden');
      adxBox?.classList.remove('hidden');
    } else {
      adsenseBox?.classList.remove('hidden');
      adxBox?.classList.add('hidden');
    }

    const themeColors = {
      top: 'text-blue-600 dark:text-blue-400',
      inline: 'text-emerald-600 dark:text-emerald-400',
      sidebar: 'text-indigo-600 dark:text-indigo-400',
      footer: 'text-amber-600 dark:text-amber-400',
    };

    buttons.forEach((btn) => {
      const val = btn.getAttribute('data-network-val');
      const isSelected = val === network;
      if (isSelected) {
        btn.className = `flex-1 rounded-lg py-1.5 text-center transition bg-white shadow-xs dark:bg-slate-900 font-bold ${themeColors[slotKey] || 'text-blue-600'}`;
      } else {
        btn.className = 'flex-1 rounded-lg py-1.5 text-center text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition font-medium cursor-pointer';
      }
    });

    renderPreview();
  }

  // Bind slot network switcher buttons
  document.querySelectorAll('[data-network-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slotKey = btn.getAttribute('data-network-btn');
      const network = btn.getAttribute('data-network-val');
      if (slotKey && network) {
        setSlotNetwork(slotKey, network);
      }
    });
  });

  // ─── Preset Insertion ────────────────────────────────────────────────────────
  document.querySelectorAll('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const presetKey = btn.getAttribute('data-preset');
      const textToAppend = PRESETS[presetKey];
      if (textToAppend && fieldThirdPartyAdsTxt) {
        const current = fieldThirdPartyAdsTxt.value.trim();
        if (current) {
          fieldThirdPartyAdsTxt.value = current + '\n\n' + textToAppend;
        } else {
          fieldThirdPartyAdsTxt.value = textToAppend;
        }
        updateAdsTxtSnippet();
        if (adsTxtValidationMsg) {
          adsTxtValidationMsg.textContent = `✓ Added ${btn.textContent.replace('+', '').trim()} preset`;
          adsTxtValidationMsg.className = 'font-semibold text-emerald-600 dark:text-emerald-400';
          setTimeout(() => { if (adsTxtValidationMsg) adsTxtValidationMsg.textContent = ''; }, 3000);
        }
      }
    });
  });

  btnInsertGptHeader?.addEventListener('click', () => {
    const gptTag = '<script async src="https://securepubads.g.doubleclick.net/tag/js/gpt.js"><' + '/script>\n<script>\n  window.googletag = window.googletag || {cmd: []};\n<' + '/script>';
    if (fieldHeaderScript) {
      const current = fieldHeaderScript.value.trim();
      fieldHeaderScript.value = current ? current + '\n' + gptTag : gptTag;
    }
  });

  btnInsertPrebidHeader?.addEventListener('click', () => {
    const prebidTag = '<script async src="https://cdn.jsdelivr.net/npm/prebid.js@latest/dist/not-for-prod/prebid.js"><' + '/script>\n<script>\n  var pbjs = pbjs || {};\n  pbjs.que = pbjs.que || [];\n<' + '/script>';
    if (fieldHeaderScript) {
      const current = fieldHeaderScript.value.trim();
      fieldHeaderScript.value = current ? current + '\n' + prebidTag : prebidTag;
    }
  });

  // ─── File Import ─────────────────────────────────────────────────────────────
  fileImportAdsTxt?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const content = event.target?.result;
      if (typeof content === 'string' && fieldThirdPartyAdsTxt) {
        const cur = fieldThirdPartyAdsTxt.value.trim();
        fieldThirdPartyAdsTxt.value = cur ? cur + '\n\n# Imported from ' + file.name + '\n' + content.trim() : content.trim();
        updateAdsTxtSnippet();
        if (adsTxtValidationMsg) {
          adsTxtValidationMsg.textContent = `✓ Imported ${file.name} successfully`;
          adsTxtValidationMsg.className = 'font-semibold text-emerald-600 dark:text-emerald-400';
        }
      }
    };
    reader.readAsText(file);
    e.target.value = '';
  });

  // ─── Deduplication ───────────────────────────────────────────────────────────
  btnDedupAdsTxt?.addEventListener('click', () => {
    if (!fieldThirdPartyAdsTxt) return;
    const lines = fieldThirdPartyAdsTxt.value.split('\n');
    const seen = new Set();
    const result = [];
    let dupCount = 0;

    for (let rawLine of lines) {
      const line = rawLine.trim();
      if (!line) {
        result.push('');
        continue;
      }
      if (line.startsWith('#')) {
        result.push(rawLine);
        continue;
      }
      const normalized = line.toLowerCase();
      if (seen.has(normalized)) {
        dupCount++;
      } else {
        seen.add(normalized);
        result.push(line);
      }
    }

    fieldThirdPartyAdsTxt.value = result.join('\n').replace(/\n{3,}/g, '\n\n').trim();
    updateAdsTxtSnippet();
    if (adsTxtValidationMsg) {
      adsTxtValidationMsg.textContent = dupCount > 0 ? `✓ Cleaned & removed ${dupCount} duplicate line(s)` : '✓ No duplicates found';
      adsTxtValidationMsg.className = 'font-semibold text-blue-600 dark:text-blue-400';
      setTimeout(() => { if (adsTxtValidationMsg) adsTxtValidationMsg.textContent = ''; }, 3000);
    }
  });

  // ─── Validation ──────────────────────────────────────────────────────────────
  btnValidateAdsTxt?.addEventListener('click', () => {
    if (!fieldThirdPartyAdsTxt) return;
    const lines = fieldThirdPartyAdsTxt.value.split('\n');
    let validCount = 0;
    let invalidCount = 0;
    const invalidLines = [];

    lines.forEach((rawLine, idx) => {
      const line = rawLine.trim();
      if (!line || line.startsWith('#')) return;
      // Standard ads.txt format: domain, publisher_id, type (DIRECT/RESELLER), [certification_id]
      const parts = line.split(',').map((p) => p.trim());
      if (parts.length >= 3) {
        const domain = parts[0];
        const pubId = parts[1];
        const type = parts[2].toUpperCase();
        if (domain.includes('.') && pubId.length > 0 && (type === 'DIRECT' || type === 'RESELLER')) {
          validCount++;
        } else {
          invalidCount++;
          invalidLines.push(idx + 1);
        }
      } else {
        invalidCount++;
        invalidLines.push(idx + 1);
      }
    });

    if (adsTxtValidationMsg) {
      if (invalidCount === 0) {
        adsTxtValidationMsg.textContent = `✓ All ${validCount} partner seller lines are valid IAB format`;
        adsTxtValidationMsg.className = 'font-semibold text-emerald-600 dark:text-emerald-400';
      } else {
        adsTxtValidationMsg.textContent = `⚠️ Found ${invalidCount} irregular line(s) on line(s): ${invalidLines.slice(0, 5).join(', ')}${invalidLines.length > 5 ? '...' : ''}`;
        adsTxtValidationMsg.className = 'font-semibold text-amber-600 dark:text-amber-400';
      }
    }
  });

  // ─── Form Validation ─────────────────────────────────────────────────────────
  function validateForm() {
    let valid = true;

    setFieldError(clientIdError, '');
    setFieldError(gaIdError, '');
    [
      slotTopError, slotTopCodeError,
      slotInlineError, slotInlineCodeError,
      slotSidebarError, slotSidebarCodeError,
      slotFooterError, slotFooterCodeError,
    ].forEach((err) => setFieldError(err, ''));

    const clientId = fieldClientId.value.trim();
    const gaId = fieldGaId?.value.trim() || '';

    // Validate Google Analytics Measurement ID if provided
    if (gaId) {
      if (!/^G-[A-Za-z0-9]+$/i.test(gaId)) {
        setFieldError(gaIdError, 'Measurement ID must start with "G-" followed by alphanumeric characters (e.g. G-6LRLPH95P7).');
        valid = false;
      }
    }

    // Validate Publisher ID if entered
    if (clientId && !PUB_ID_PATTERN.test(clientId)) {
      setFieldError(clientIdError, 'Format must be: ca-pub-1234567890123456 (digits only after ca-pub-)');
      valid = false;
    }

    return valid;
  }

  // ─── ads.txt Snippet & Full Generator ────────────────────────────────────────
  function updateAdsTxtSnippet() {
    const clientId = (fieldClientId?.value || '').trim();
    const includeGoogle = fieldIncludeGoogleAdsTxt?.checked !== false;
    const hasValidGoogleId = PUB_ID_PATTERN.test(clientId) && !clientId.includes('XXXX');

    let googleLine = '';
    if (hasValidGoogleId) {
      const pubOnly = clientId.replace('ca-', '');
      googleLine = `google.com, ${pubOnly}, DIRECT, f08c47fec0942fa0`;
      adsTxtWarning?.classList.add('hidden');
    } else {
      googleLine = 'google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0';
      if (includeGoogle && clientId) {
        adsTxtWarning?.classList.remove('hidden');
      } else {
        adsTxtWarning?.classList.add('hidden');
      }
    }

    if (adsTxtSnippet) {
      adsTxtSnippet.textContent = googleLine;
      adsTxtSnippet.parentElement.style.opacity = includeGoogle ? '1' : '0.4';
    }

    const thirdPartyLines = (fieldThirdPartyAdsTxt?.value || '').trim();

    const fullLines = [
      '# =========================================================================',
      '# Authorized Digital Sellers (ads.txt) - https://iabtechlab.com/ads-txt/',
      '# =========================================================================',
    ];

    if (includeGoogle && hasValidGoogleId) {
      fullLines.push('');
      fullLines.push('# Google AdSense (Direct Publisher)');
      fullLines.push(googleLine);
    }

    if (thirdPartyLines) {
      fullLines.push('');
      fullLines.push('# 3rd-Party Authorized Partner Networks (AdX, SSPs, DSPs, Header Bidding)');
      fullLines.push(thirdPartyLines);
    }

    if (!includeGoogle && !thirdPartyLines) {
      fullLines.push('');
      fullLines.push('# No active ad seller records configured yet.');
    }

    if (fullAdsTxtPreview) {
      fullAdsTxtPreview.textContent = fullLines.join('\n');
    }

    // Update Line Count
    if (adsTxtLineCount && fieldThirdPartyAdsTxt) {
      const raw = fieldThirdPartyAdsTxt.value.split('\n');
      const partnerLines = raw.filter((l) => l.trim() && !l.trim().startsWith('#')).length;
      const totalLines = partnerLines + (includeGoogle && hasValidGoogleId ? 1 : 0);
      adsTxtLineCount.textContent = `${totalLines} total seller record(s) (${partnerLines} 3rd-party partner lines)`;
    }
  }

  // ─── Status Badges ───────────────────────────────────────────────────────────
  function updateStatusBadges(config) {
    if (!config) return;
    const clientId  = (config.clientId || '').trim();
    const isEnabled = Boolean(config.enabled);
    const hasValidId = PUB_ID_PATTERN.test(clientId) && !clientId.includes('XXXX');

    const anyAdxActive = ['top', 'inline', 'sidebar', 'footer'].some((k) => {
      const slot = config.slots?.[k];
      return slot?.enabled !== false && (slot?.adNetwork === 'adx' || Boolean(slot?.customCode));
    });

    const hasThirdParty = Boolean((config.thirdPartyAdsTxt || '').trim());

    let badgeClass, dotClass, label;
    if (!isEnabled) {
      badgeClass = 'inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-400';
      dotClass   = 'h-2 w-2 rounded-full bg-slate-400';
      label      = 'Ads Disabled';
    } else if (config.testMode === true) {
      badgeClass = 'inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 dark:bg-amber-950/60 dark:text-amber-300';
      dotClass   = 'h-2 w-2 rounded-full bg-amber-500';
      label      = 'Test Mode Active';
    } else if (hasValidId && anyAdxActive) {
      badgeClass = 'inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300';
      dotClass   = 'h-2 w-2 rounded-full bg-emerald-500';
      label      = 'AdSense & 3rd-Party Active';
    } else if (hasValidId) {
      badgeClass = 'inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300';
      dotClass   = 'h-2 w-2 rounded-full bg-emerald-500';
      label      = 'AdSense Live';
    } else if (anyAdxActive || hasThirdParty) {
      badgeClass = 'inline-flex items-center gap-1.5 rounded-full bg-purple-100 px-3 py-1 text-xs font-bold text-purple-800 dark:bg-purple-950/60 dark:text-purple-300';
      dotClass   = 'h-2 w-2 rounded-full bg-purple-500';
      label      = '3rd-Party / AdX Active';
    } else {
      badgeClass = 'inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 dark:bg-amber-950/60 dark:text-amber-300';
      dotClass   = 'h-2 w-2 rounded-full bg-amber-500';
      label      = 'Pending Configuration';
    }

    if (badgeGlobalStatus) {
      badgeGlobalStatus.className = badgeClass;
      badgeGlobalStatus.textContent = '';
      const dot = document.createElement('span');
      dot.className = dotClass;
      dot.setAttribute('aria-hidden', 'true');
      badgeGlobalStatus.appendChild(dot);
      badgeGlobalStatus.appendChild(document.createTextNode(' ' + label));
    }

    if (badgeTestMode) {
      badgeTestMode.style.display = config.testMode === true ? 'inline-flex' : 'none';
    }

    // Sync aria-checked
    [fieldEnabled, fieldTestMode, fieldAutoAds, slotTopEnabled, slotInlineEnabled, slotSidebarEnabled, slotFooterEnabled, fieldIncludeGoogleAdsTxt]
      .forEach(el => { if (el) el.setAttribute('aria-checked', el.checked ? 'true' : 'false'); });

    updateAdsTxtSnippet();
  }

  // ─── Preview Renderer ─────────────────────────────────────────────────────────
  function renderPreview() {
    if (!previewRenderBox) return;
    const pubId  = fieldClientId?.value.trim() || 'ca-pub-XXXXXXXXXXXXXXXX';
    const isTest = fieldTestMode?.checked;
    const isSiteEnabled = fieldEnabled?.checked;
    const net    = slotNetworks[activePreviewTab] || 'adsense';
    const isAdx  = net === 'adx';

    let slotIdRaw = '', customCode = '', label = '', dims = '', minH = '90px', maxW = '728px', isSlotEnabled = true;

    if (activePreviewTab === 'top') {
      slotIdRaw = slotTopId?.value.trim() || '1234567890';
      customCode = slotTopCode?.value.trim() || '';
      isSlotEnabled = slotTopEnabled?.checked !== false;
      label = 'Top Leaderboard Banner'; dims = '728 × 90 (Leaderboard)';
    } else if (activePreviewTab === 'inline') {
      slotIdRaw = slotInlineId?.value.trim() || '2345678901';
      customCode = slotInlineCode?.value.trim() || '';
      isSlotEnabled = slotInlineEnabled?.checked !== false;
      label = 'In-Content Result Ad'; dims = '336 × 280 (Medium Rectangle)';
      minH = '250px'; maxW = '336px';
    } else if (activePreviewTab === 'sidebar') {
      slotIdRaw = slotSidebarId?.value.trim() || '3456789012';
      customCode = slotSidebarCode?.value.trim() || '';
      isSlotEnabled = slotSidebarEnabled?.checked !== false;
      label = 'Sticky Sidebar Ad'; dims = '300 × 600 (Half-Page Skyscraper)';
      minH = '350px'; maxW = '300px';
    } else if (activePreviewTab === 'footer') {
      slotIdRaw = slotFooterId?.value.trim() || '4567890123';
      customCode = slotFooterCode?.value.trim() || '';
      isSlotEnabled = slotFooterEnabled?.checked !== false;
      label = 'Bottom Footer Banner'; dims = '728 × 90 (Leaderboard)';
    }

    previewRenderBox.textContent = '';
    const wrap = document.createElement('div');
    wrap.className = 'mx-auto rounded-2xl border-2 border-dashed p-4 text-center transition shadow-xs';
    wrap.style.cssText = `max-width:${maxW};min-height:${minH};display:flex;flex-direction:column;justify-content:center;align-items:center;`;
    
    if (!isSiteEnabled || !isSlotEnabled) {
      wrap.classList.add('border-slate-300', 'bg-slate-100/60', 'dark:border-slate-700', 'dark:bg-slate-900/40');
    } else if (isTest) {
      wrap.classList.add('border-amber-400','bg-amber-50/60','dark:border-amber-700','dark:bg-amber-950/30');
    } else if (isAdx) {
      wrap.classList.add('border-indigo-400','bg-indigo-50/50','dark:border-indigo-700','dark:bg-indigo-950/30');
    } else {
      wrap.classList.add('border-blue-400','bg-blue-50/50','dark:border-blue-700','dark:bg-blue-950/30');
    }

    const tagLine = document.createElement('div');
    tagLine.className = 'text-[10px] font-extrabold uppercase tracking-widest flex items-center gap-1.5';
    
    if (!isSiteEnabled || !isSlotEnabled) {
      tagLine.classList.add('text-slate-500', 'dark:text-slate-400');
    } else if (isTest) {
      tagLine.classList.add('text-amber-700', 'dark:text-amber-400');
    } else if (isAdx) {
      tagLine.classList.add('text-indigo-700', 'dark:text-indigo-400');
    } else {
      tagLine.classList.add('text-blue-600', 'dark:text-blue-400');
    }

    const tagIcon = document.createElement('span');
    tagIcon.textContent = (!isSiteEnabled || !isSlotEnabled) ? '⏸️' : (isTest ? '🛠️' : (isAdx ? '⚡' : '📐'));
    tagIcon.setAttribute('aria-hidden','true');

    const tagText = document.createElement('span');
    if (!isSiteEnabled) {
      tagText.textContent = 'SLOT INACTIVE (SITE-WIDE ADS DISABLED)';
    } else if (!isSlotEnabled) {
      tagText.textContent = 'SLOT DISABLED';
    } else if (isTest) {
      tagText.textContent = 'TEST MODE — SAFE VISUAL MOCKUP';
    } else if (isAdx) {
      tagText.textContent = 'GOOGLE ADX / 3RD-PARTY CUSTOM TAG';
    } else {
      tagText.textContent = 'GOOGLE ADSENSE UNIT';
    }

    tagLine.appendChild(tagIcon);
    tagLine.appendChild(tagText);

    const labelEl = document.createElement('div');
    labelEl.className = 'mt-2 text-sm font-bold text-slate-800 dark:text-slate-100';
    labelEl.textContent = label;

    const metaRow = document.createElement('div');
    metaRow.className = 'mt-1.5 flex flex-wrap items-center justify-center gap-2 text-[11px] font-mono text-slate-500 dark:text-slate-400';

    if (isAdx) {
      const adxBadge = document.createElement('span');
      adxBadge.className = 'bg-white/80 dark:bg-slate-900 px-2.5 py-0.5 rounded border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 font-semibold';
      adxBadge.textContent = customCode ? `Custom Tag Configured (${customCode.length} chars)` : 'No custom script entered yet';
      metaRow.appendChild(adxBadge);
    } else {
      const clientBadge = document.createElement('span');
      clientBadge.className = 'bg-white/80 dark:bg-slate-900 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-800';
      clientBadge.textContent = 'Publisher: ' + (pubId || 'ca-pub-demo');
      const slotBadge = document.createElement('span');
      slotBadge.className = 'bg-white/80 dark:bg-slate-900 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-800';
      slotBadge.textContent = 'Slot ID: ' + (slotIdRaw || '1234567890');
      metaRow.appendChild(clientBadge);
      metaRow.appendChild(slotBadge);
    }

    const dimsEl = document.createElement('div');
    dimsEl.className = 'mt-2 text-[10px] font-semibold text-slate-400';
    dimsEl.textContent = dims;

    wrap.appendChild(tagLine);
    wrap.appendChild(labelEl);
    wrap.appendChild(metaRow);
    wrap.appendChild(dimsEl);
    previewRenderBox.appendChild(wrap);
  }

  // ─── Load / Reload Settings ───────────────────────────────────────────────────
  async function loadSettings() {
    if (isReloading) return;
    isReloading = true;
    if (btnReload)     { btnReload.disabled = true; }
    if (btnReloadText) { btnReloadText.textContent = '↻ Reloading...'; }
    setStatus('Loading settings...', 'neutral');

    try {
      const res = await fetch('/api/adsense-config/?t=' + Date.now(), {
        cache: 'no-store',
        headers: { 'Cache-Control': 'no-cache' },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      let data;
      try { data = await res.json(); }
      catch { throw new Error('Invalid response from server.'); }

      if (fieldEnabled) fieldEnabled.checked = Boolean(data.enabled);
      if (fieldTestMode) fieldTestMode.checked = data.testMode === true;
      if (fieldAutoAds) fieldAutoAds.checked = Boolean(data.autoAds);
      if (fieldClientId) fieldClientId.value = data.clientId || '';
      if (fieldGaId) fieldGaId.value = data.gaMeasurementId || '';
      if (fieldHeaderScript) fieldHeaderScript.value = data.headerScript || '';

      if (fieldIncludeGoogleAdsTxt) {
        fieldIncludeGoogleAdsTxt.checked = data.includeGoogleAdsTxt !== false;
      }
      if (fieldThirdPartyAdsTxt) {
        fieldThirdPartyAdsTxt.value = data.thirdPartyAdsTxt || data.customAdsTxt || '';
      }

      if (slotTopEnabled) slotTopEnabled.checked = data.slots?.top?.enabled !== false;
      if (slotTopId) slotTopId.value = data.slots?.top?.slotId || '';
      if (slotTopCode) slotTopCode.value = data.slots?.top?.customCode || '';
      setSlotNetwork('top', data.slots?.top?.adNetwork === 'adx' ? 'adx' : 'adsense');

      if (slotInlineEnabled) slotInlineEnabled.checked = data.slots?.inline?.enabled !== false;
      if (slotInlineId) slotInlineId.value = data.slots?.inline?.slotId || '';
      if (slotInlineCode) slotInlineCode.value = data.slots?.inline?.customCode || '';
      setSlotNetwork('inline', data.slots?.inline?.adNetwork === 'adx' ? 'adx' : 'adsense');

      if (slotSidebarEnabled) slotSidebarEnabled.checked = data.slots?.sidebar?.enabled !== false;
      if (slotSidebarId) slotSidebarId.value = data.slots?.sidebar?.slotId || '';
      if (slotSidebarCode) slotSidebarCode.value = data.slots?.sidebar?.customCode || '';
      setSlotNetwork('sidebar', data.slots?.sidebar?.adNetwork === 'adx' ? 'adx' : 'adsense');

      if (slotFooterEnabled) slotFooterEnabled.checked = data.slots?.footer?.enabled !== false;
      if (slotFooterId) slotFooterId.value = data.slots?.footer?.slotId || '';
      if (slotFooterCode) slotFooterCode.value = data.slots?.footer?.customCode || '';
      setSlotNetwork('footer', data.slots?.footer?.adNetwork === 'adx' ? 'adx' : 'adsense');

      updateStatusBadges(data);
      renderPreview();
      setStatus('', 'neutral');
    } catch (err) {
      console.error('[Ad Settings] Load error:', err);
      setStatus('Could not load settings. Check connection and try again.', 'error');
    } finally {
      isReloading = false;
      if (btnReload)     { btnReload.disabled = false; }
      if (btnReloadText) { btnReloadText.textContent = '↻ Reload'; }
    }
  }

  // ─── Save Form ────────────────────────────────────────────────────────────────
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isSaving) return;

    if (!validateForm()) {
      setStatus('Please fix validation errors before saving.', 'error');
      return;
    }

    isSaving = true;
    if (btnSave) btnSave.disabled = true;
    if (btnSaveText) btnSaveText.textContent = 'Saving...';
    if (btnSaveIcon) btnSaveIcon.textContent = '⏳';
    setStatus('Saving ad & ads.txt settings...', 'loading');

    const payload = {
      enabled:             fieldEnabled?.checked || false,
      testMode:            fieldTestMode?.checked || false,
      autoAds:             fieldAutoAds?.checked || false,
      clientId:            fieldClientId?.value.trim() || '',
      gaMeasurementId:     fieldGaId?.value.trim() || '',
      headerScript:        fieldHeaderScript?.value.trim() || '',
      includeGoogleAdsTxt: fieldIncludeGoogleAdsTxt?.checked !== false,
      thirdPartyAdsTxt:    fieldThirdPartyAdsTxt?.value.trim() || '',
      customAdsTxt:        fieldThirdPartyAdsTxt?.value.trim() || '',
      slots: {
        top: {
          slotId:     slotTopId?.value.trim() || '',
          enabled:    slotTopEnabled?.checked !== false,
          adNetwork:  slotNetworks.top,
          customCode: slotTopCode?.value.trim() || '',
        },
        inline: {
          slotId:     slotInlineId?.value.trim() || '',
          enabled:    slotInlineEnabled?.checked !== false,
          adNetwork:  slotNetworks.inline,
          customCode: slotInlineCode?.value.trim() || '',
        },
        sidebar: {
          slotId:     slotSidebarId?.value.trim() || '',
          enabled:    slotSidebarEnabled?.checked !== false,
          adNetwork:  slotNetworks.sidebar,
          customCode: slotSidebarCode?.value.trim() || '',
        },
        footer: {
          slotId:     slotFooterId?.value.trim() || '',
          enabled:    slotFooterEnabled?.checked !== false,
          adNetwork:  slotNetworks.footer,
          customCode: slotFooterCode?.value.trim() || '',
        },
      },
    };

    try {
      const token = localStorage.getItem('admin_token') || '';
      const headers = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = `Bearer ${token}`;

      const res = await fetch('/api/adsense-config/', {
        method: 'POST',
        credentials: 'include',
        headers,
        body: JSON.stringify(payload),
      });

      let data = {};
      try { data = await res.json(); } catch { /* non-JSON */ }

      if (res.ok) {
        setStatus('✓ Settings & ads.txt saved and published successfully!', 'success');
        updateStatusBadges(payload);
        renderPreview();
      } else if (res.status === 401) {
        if (statusMsg) {
          statusMsg.className = 'text-xs font-semibold text-red-600';
          statusMsg.textContent = '❌ Session expired. ';
          const link = document.createElement('a');
          link.href = `/admin/login/?redirect=${encodeURIComponent(window.location.pathname)}`;
          link.className = 'underline font-bold';
          link.textContent = 'Click here to Sign In';
          statusMsg.appendChild(link);
        }
      } else {
        const msg = typeof data.error === 'string' ? data.error : 'Failed to save settings.';
        setStatus('❌ ' + msg, 'error');
      }
    } catch (err) {
      console.error('[Ad Settings] Save error:', err);
      setStatus('❌ Network error. Please try again.', 'error');
    } finally {
      isSaving = false;
      if (btnSave) btnSave.disabled = false;
      if (btnSaveText) btnSaveText.textContent = 'Save & Apply Ad Settings';
      if (btnSaveIcon) btnSaveIcon.textContent = '💾';
    }
  });

  // ─── Reload Button ────────────────────────────────────────────────────────────
  btnReload?.addEventListener('click', loadSettings);

  // ─── Real-time Listeners ──────────────────────────────────────────────────────
  [fieldEnabled, fieldTestMode, fieldAutoAds, fieldIncludeGoogleAdsTxt].forEach((toggle) => {
    toggle?.addEventListener('change', () => {
      toggle.setAttribute('aria-checked', toggle.checked ? 'true' : 'false');
      updateStatusBadges({
        enabled: fieldEnabled?.checked,
        testMode: fieldTestMode?.checked,
        clientId: fieldClientId?.value.trim(),
        includeGoogleAdsTxt: fieldIncludeGoogleAdsTxt?.checked !== false,
        thirdPartyAdsTxt: fieldThirdPartyAdsTxt?.value.trim(),
        slots: {
          top: { enabled: slotTopEnabled?.checked, adNetwork: slotNetworks.top, customCode: slotTopCode?.value },
          inline: { enabled: slotInlineEnabled?.checked, adNetwork: slotNetworks.inline, customCode: slotInlineCode?.value },
          sidebar: { enabled: slotSidebarEnabled?.checked, adNetwork: slotNetworks.sidebar, customCode: slotSidebarCode?.value },
          footer: { enabled: slotFooterEnabled?.checked, adNetwork: slotNetworks.footer, customCode: slotFooterCode?.value },
        }
      });
      renderPreview();
    });
  });

  [slotTopEnabled, slotInlineEnabled, slotSidebarEnabled, slotFooterEnabled].forEach((toggle) => {
    toggle?.addEventListener('change', () => {
      toggle.setAttribute('aria-checked', toggle.checked ? 'true' : 'false');
      renderPreview();
    });
  });

  [fieldClientId, slotTopId, slotInlineId, slotSidebarId, slotFooterId].forEach((input) => {
    input?.addEventListener('input', () => {
      renderPreview();
      updateAdsTxtSnippet();
    });
  });

  fieldGaId?.addEventListener('input', () => {
    setFieldError(gaIdError, '');
  });

  fieldThirdPartyAdsTxt?.addEventListener('input', () => {
    updateAdsTxtSnippet();
  });

  [slotTopCode, slotInlineCode, slotSidebarCode, slotFooterCode].forEach((textarea) => {
    textarea?.addEventListener('input', () => {
      renderPreview();
    });
  });

  // ─── Preview Tab Switching ────────────────────────────────────────────────────
  previewTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      previewTabs.forEach((t) => {
        t.className = 'preview-tab rounded-xl bg-slate-100 px-3.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 transition focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none cursor-pointer';
        t.setAttribute('aria-selected', 'false');
      });
      tab.className = 'preview-tab active rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white transition focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:outline-none cursor-pointer';
      tab.setAttribute('aria-selected', 'true');
      activePreviewTab = tab.getAttribute('data-preview-tab') || 'top';
      renderPreview();
    });
  });

  // ─── Copy ads.txt (with Fallback) ─────────────────────────────────────────────
  btnCopyAdsTxt?.addEventListener('click', async () => {
    const textToCopy = fullAdsTxtPreview?.textContent.trim() || '';
    if (!textToCopy) return;

    let success = false;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(textToCopy);
        success = true;
      } catch {}
    }

    if (!success) {
      const tempArea = document.createElement('textarea');
      tempArea.value = textToCopy;
      tempArea.style.position = 'fixed';
      tempArea.style.opacity = '0';
      document.body.appendChild(tempArea);
      tempArea.focus();
      tempArea.select();
      try {
        success = document.execCommand('copy');
      } catch {}
      document.body.removeChild(tempArea);
    }

    if (copyBtnText) {
      copyBtnText.textContent = success ? 'Copied! ✅' : 'Failed to copy';
      setTimeout(() => { copyBtnText.textContent = 'Copy Complete ads.txt'; }, 2000);
    }
  });

  // ─── Initial Load ─────────────────────────────────────────────────────────────
  loadSettings();
</script>
