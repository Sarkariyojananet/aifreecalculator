---
import AdminLayout from '../../layouts/AdminLayout.astro';
import BackupRollbackCard from '../../components/admin/settings/BackupRollbackCard.astro';
import MasterAdsCard from '../../components/admin/settings/MasterAdsCard.astro';
import AdSlotEditor from '../../components/admin/settings/AdSlotEditor.astro';
import SmartThrottlingCard from '../../components/admin/settings/SmartThrottlingCard.astro';
import AdsTxtManager from '../../components/admin/settings/AdsTxtManager.astro';
import AuditLogCard from '../../components/admin/settings/AuditLogCard.astro';
---

<AdminLayout title="AdSense & Ad Monetization Settings | Calculator CMS" sectionTitle="Ad Monetization" activeSection="settings">
  <div class="space-y-8 max-w-6xl mx-auto">
    
    <!-- Top Header Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6 dark:border-slate-800">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-100 text-lg text-blue-600 dark:bg-blue-950 dark:text-blue-400">
            📢
          </span>
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
              Monetization &amp; Ad Control Center
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Manage Google AdSense, AdX, Direct Sponsor banners, Affiliate partnerships, Smart Throttling, and IAB <code class="font-mono text-blue-600 dark:text-blue-400">/ads.txt</code> sellers.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Status Badges & Analytics Link -->
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/admin/monetization/"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-3 py-1 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition"
        >
          <span>💰</span> Revenue Analytics →
        </a>
        <span id="badge-global-status" class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          <span class="h-2 w-2 rounded-full bg-slate-400" aria-hidden="true"></span> Loading...
        </span>
        <span id="badge-test-mode" style="display: none;" class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
          🛠️ Test Mode ON
        </span>
      </div>
    </div>

    <!-- 1. 💾 CMS Data Backup, Restore & 1-Click Rollback Card -->
    <BackupRollbackCard />

    <!-- Main Settings Form -->
    <form id="adsense-full-form" class="space-y-8" novalidate aria-label="Ad configuration form">
      
      <!-- 2. Master Ad Network Controls (AdSense, Auto Ads, GA4, Header Script) -->
      <MasterAdsCard />

      <!-- 3. Ad Slots & Monetization Switcher (AdSense, AdX, Direct Sponsor, Affiliate) -->
      <AdSlotEditor />

      <!-- 4. Smart Ads Throttling & Core Web Vitals Protection -->
      <SmartThrottlingCard />

      <!-- 5. Authorized Digital Sellers (ads.txt) -->
      <AdsTxtManager />

      <!-- Sticky Action & Submit Footer Bar -->
      <div class="sticky bottom-4 z-20 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200/90 bg-white/95 p-4 shadow-xl backdrop-blur-md dark:border-slate-800 dark:bg-slate-900/95">
        <div class="flex items-center gap-3">
          <button
            type="submit"
            id="btn-save-adsense"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-2.5 text-xs font-bold text-white shadow-md shadow-blue-500/20 hover:bg-blue-700 active:scale-[0.98] transition cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span id="btn-save-icon" aria-hidden="true">💾</span>
            <span id="btn-save-text">Save &amp; Apply All Settings</span>
          </button>
          <button
            type="button"
            id="btn-reload-adsense"
            class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
          >
            <span id="btn-reload-text">↻ Reload</span>
          </button>
        </div>

        <p id="form-status-msg" class="text-xs font-semibold text-slate-600 dark:text-slate-400" role="status" aria-live="polite"></p>
      </div>

    </form>

    <!-- 6. 🛡️ Security, Activity & Audit Trail Card -->
    <AuditLogCard />

    <!-- 7. Restore From Backup Modal Dialog -->
    <dialog
      id="modal-restore-backup"
      class="rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl backdrop:bg-slate-900/60 dark:border-slate-800 dark:bg-slate-900 dark:text-white max-w-lg w-full fixed inset-0 m-auto"
    >
      <div class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
          <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🔄</span> Restore CMS &amp; Monetization Backup
          </h3>
          <button type="button" id="btn-close-restore-modal" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg cursor-pointer">✕</button>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400">
          Select an exported JSON backup file. All configurations (SEO overrides, ads, redirects, categories, and FAQs) will be restored safely.
        </p>

        <div class="space-y-2">
          <input
            type="file"
            id="file-restore-input"
            accept=".json,application/json"
            class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-950 dark:file:text-blue-300 hover:file:bg-blue-100 cursor-pointer"
          />
        </div>

        <div class="space-y-1">
          <label for="input-backup-json" class="block text-[11px] font-bold text-slate-700 dark:text-slate-300">Or Paste JSON Content Directly:</label>
          <textarea
            id="input-backup-json"
            rows="5"
            placeholder="{ &quot;schemaVersion&quot;: &quot;1.1&quot;, ... }"
            class="w-full rounded-2xl border border-slate-300 bg-white p-3 font-mono text-xs text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          ></textarea>
        </div>

        <div id="restore-status-msg" class="hidden text-xs font-semibold p-3 rounded-xl"></div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
          <button
            type="button"
            id="btn-cancel-restore"
            class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
          >
            Cancel
          </button>
          <button
            type="button"
            id="btn-execute-restore"
            class="rounded-xl bg-blue-600 px-5 py-2 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition"
          >
            Execute Restore
          </button>
        </div>
      </div>
    </dialog>

  </div>
</AdminLayout>

<script>
  // ─── DOM References ────────────────────────────────────────────────────────
  const badgeGlobalStatus = document.getElementById('badge-global-status');
  const badgeTestMode = document.getElementById('badge-test-mode');

  // Master Inputs
  const fieldEnabled = document.getElementById('field-enabled') as HTMLInputElement | null;
  const fieldTestMode = document.getElementById('field-test-mode') as HTMLInputElement | null;
  const fieldClientId = document.getElementById('field-client-id') as HTMLInputElement | null;
  const fieldAutoAds = document.getElementById('field-auto-ads') as HTMLInputElement | null;
  const fieldGaId = document.getElementById('field-ga-id') as HTMLInputElement | null;
  const fieldHeaderScript = document.getElementById('field-header-script') as HTMLTextAreaElement | null;

  // Smart Throttling Inputs
  const fieldThrottlingEnabled = document.getElementById('field-throttling-enabled') as HTMLInputElement | null;
  const fieldThrottleSlowConn = document.getElementById('field-throttle-slow-conn') as HTMLInputElement | null;
  const fieldThrottleLazy = document.getElementById('field-throttle-lazy') as HTMLInputElement | null;
  const fieldThrottleMobileMax = document.getElementById('field-throttle-mobile-max') as HTMLSelectElement | null;
  const fieldThrottleCls = document.getElementById('field-throttle-cls') as HTMLInputElement | null;

  // Ads.txt Inputs
  const fieldIncludeGoogleAdsTxt = document.getElementById('field-include-google-adstxt') as HTMLInputElement | null;
  const fieldThirdPartyAdsTxt = document.getElementById('field-third-party-adstxt') as HTMLTextAreaElement | null;
  const btnValidateAdsTxt = document.getElementById('btn-validate-adstxt');
  const adsTxtValidationMsg = document.getElementById('adstxt-validation-msg');

  // Form & Actions
  const form = document.getElementById('adsense-full-form') as HTMLFormElement | null;
  const btnSave = document.getElementById('btn-save-adsense') as HTMLButtonElement | null;
  const btnSaveText = document.getElementById('btn-save-text');
  const btnReload = document.getElementById('btn-reload-adsense') as HTMLButtonElement | null;
  const formStatusMsg = document.getElementById('form-status-msg');

  // Rollback & Backup
  const btnQuickRollback = document.getElementById('btn-quick-rollback') as HTMLButtonElement | null;
  const labelSnapshotDate = document.getElementById('label-snapshot-date');
  const modalRestore = document.getElementById('modal-restore-backup') as HTMLDialogElement | null;
  const btnOpenRestore = document.getElementById('btn-open-restore-modal');
  const btnCloseRestore = document.getElementById('btn-close-restore-modal');
  const btnCancelRestore = document.getElementById('btn-cancel-restore');
  const btnExecuteRestore = document.getElementById('btn-execute-restore') as HTMLButtonElement | null;
  const fileRestoreInput = document.getElementById('file-restore-input') as HTMLInputElement | null;
  const inputBackupJson = document.getElementById('input-backup-json') as HTMLTextAreaElement | null;
  const restoreStatusMsg = document.getElementById('restore-status-msg');

  // Audit Logs
  const auditLogTbody = document.getElementById('audit-log-tbody');
  const btnRefreshAuditLogs = document.getElementById('btn-refresh-audit-logs');

  const slotKeys = ['top', 'inline', 'sidebar', 'footer'] as const;

  // ─── Slot Tab Navigation ───────────────────────────────────────────────────
  const tabButtons = document.querySelectorAll('.slot-tab-btn');
  const slotPanels = document.querySelectorAll('.slot-panel');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetSlot = btn.getAttribute('data-slot-tab');
      tabButtons.forEach((b) => {
        b.classList.remove('active', 'bg-white', 'dark:bg-slate-900', 'text-blue-600', 'dark:text-blue-400', 'shadow-2xs');
        b.classList.add('text-slate-600', 'dark:text-slate-400');
      });
      btn.classList.add('active', 'bg-white', 'dark:bg-slate-900', 'text-blue-600', 'dark:text-blue-400', 'shadow-2xs');
      btn.classList.remove('text-slate-600', 'dark:text-slate-400');

      slotPanels.forEach((panel) => {
        if (panel.id === `panel-slot-${targetSlot}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });

  // ─── Network Mode Toggle Handler (AdSense vs AdX vs Sponsor vs Affiliate) ───
  function setupNetworkRadioListeners(slot: string) {
    const radios = document.querySelectorAll(`input[name="${slot}-network"]`);
    const panel = document.getElementById(`panel-slot-${slot}`);
    if (!panel) return;

    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        const val = (radio as HTMLInputElement).value;
        const modeAdsense = panel.querySelector('.mode-adsense');
        const modeAdx = panel.querySelector('.mode-adx');
        const modeSponsor = panel.querySelector('.mode-sponsor');

        if (modeAdsense) modeAdsense.classList.toggle('hidden', val !== 'adsense');
        if (modeAdx) modeAdx.classList.toggle('hidden', val !== 'adx');
        if (modeSponsor) modeSponsor.classList.toggle('hidden', val !== 'direct_sponsor' && val !== 'affiliate');
      });
    });
  }

  slotKeys.forEach(setupNetworkRadioListeners);

  // ─── Load Settings from API ────────────────────────────────────────────────
  async function loadSettings() {
    try {
      if (badgeGlobalStatus) {
        badgeGlobalStatus.innerHTML = '<span class="h-2 w-2 rounded-full bg-blue-500 animate-pulse"></span> Loading settings...';
      }

      const res = await fetch('/api/adsense-config/?t=' + Date.now());
      if (!res.ok) throw new Error('Failed to load settings');
      const config = await res.json();

      // Populate Master Controls
      if (fieldEnabled) fieldEnabled.checked = Boolean(config.enabled);
      if (fieldTestMode) fieldTestMode.checked = Boolean(config.testMode);
      if (fieldClientId) fieldClientId.value = config.clientId || '';
      if (fieldAutoAds) fieldAutoAds.checked = Boolean(config.autoAds);
      if (fieldGaId) fieldGaId.value = config.gaMeasurementId || '';
      if (fieldHeaderScript) fieldHeaderScript.value = config.headerScript || '';

      // Populate Smart Throttling
      const throttling = config.smartThrottling || {};
      if (fieldThrottlingEnabled) fieldThrottlingEnabled.checked = throttling.enabled !== false;
      if (fieldThrottleSlowConn) fieldThrottleSlowConn.checked = throttling.disableOnSlowConnection !== false;
      if (fieldThrottleLazy) fieldThrottleLazy.checked = throttling.lazyLoadWithMargin !== false;
      if (fieldThrottleMobileMax) fieldThrottleMobileMax.value = String(throttling.maxMobileAds ?? 2);
      if (fieldThrottleCls) fieldThrottleCls.checked = throttling.preventClsPlaceholders !== false;

      // Populate Ads.txt
      if (fieldIncludeGoogleAdsTxt) fieldIncludeGoogleAdsTxt.checked = config.includeGoogleAdsTxt !== false;
      if (fieldThirdPartyAdsTxt) fieldThirdPartyAdsTxt.value = config.thirdPartyAdsTxt || '';

      // Populate Slots
      for (const slot of slotKeys) {
        const slotData = config.slots?.[slot] || {};
        const enabledEl = document.getElementById(`field-slot-${slot}-enabled`) as HTMLInputElement | null;
        if (enabledEl) enabledEl.checked = slotData.enabled !== false;

        const net = slotData.adNetwork || 'adsense';
        const radio = document.querySelector(`input[name="${slot}-network"][value="${net}"]`) as HTMLInputElement | null;
        if (radio) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change'));
        }

        const idEl = document.getElementById(`field-slot-${slot}-id`) as HTMLInputElement | null;
        if (idEl) idEl.value = slotData.slotId || '';

        const codeEl = document.getElementById(`field-slot-${slot}-code`) as HTMLTextAreaElement | null;
        if (codeEl) codeEl.value = slotData.customCode || '';

        const targetEl = document.getElementById(`field-slot-${slot}-sponsor-target`) as HTMLInputElement | null;
        if (targetEl) targetEl.value = slotData.sponsorTargetUrl || '';

        const bannerEl = document.getElementById(`field-slot-${slot}-sponsor-banner`) as HTMLInputElement | null;
        if (bannerEl) bannerEl.value = slotData.sponsorBannerUrl || '';

        const altEl = document.getElementById(`field-slot-${slot}-sponsor-alt`) as HTMLInputElement | null;
        if (altEl) altEl.value = slotData.sponsorAltText || '';

        const badgeEl = document.getElementById(`field-slot-${slot}-sponsor-badge`) as HTMLInputElement | null;
        if (badgeEl) badgeEl.value = slotData.sponsorBadgeText || (net === 'affiliate' ? 'Partner' : 'Sponsored');
      }

      // Update Badges
      updateStatusBadges(config);
      await loadAuditLogs();
    } catch (err: any) {
      if (badgeGlobalStatus) {
        badgeGlobalStatus.innerHTML = '<span class="h-2 w-2 rounded-full bg-red-500"></span> Load Error';
      }
      if (formStatusMsg) {
        formStatusMsg.textContent = 'Failed to load settings. Please refresh.';
        formStatusMsg.className = 'text-xs font-semibold text-red-600 dark:text-red-400';
      }
    }
  }

  function updateStatusBadges(config: any) {
    if (badgeGlobalStatus) {
      if (config.enabled) {
        badgeGlobalStatus.innerHTML = '<span class="h-2 w-2 rounded-full bg-emerald-500"></span> Live Active';
        badgeGlobalStatus.className = 'inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300';
      } else {
        badgeGlobalStatus.innerHTML = '<span class="h-2 w-2 rounded-full bg-slate-400"></span> Disabled';
        badgeGlobalStatus.className = 'inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300';
      }
    }

    if (badgeTestMode) {
      badgeTestMode.style.display = config.testMode ? 'inline-flex' : 'none';
    }
  }

  // ─── Save Settings ──────────────────────────────────────────────────────────
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (btnSave) {
      btnSave.disabled = true;
      if (btnSaveText) btnSaveText.textContent = 'Saving Changes...';
    }

    const payload: any = {
      enabled: Boolean(fieldEnabled?.checked),
      testMode: Boolean(fieldTestMode?.checked),
      clientId: fieldClientId?.value?.trim() || '',
      autoAds: Boolean(fieldAutoAds?.checked),
      gaMeasurementId: fieldGaId?.value?.trim() || '',
      headerScript: fieldHeaderScript?.value?.trim() || '',
      includeGoogleAdsTxt: Boolean(fieldIncludeGoogleAdsTxt?.checked),
      thirdPartyAdsTxt: fieldThirdPartyAdsTxt?.value?.trim() || '',
      smartThrottling: {
        enabled: Boolean(fieldThrottlingEnabled?.checked),
        disableOnSlowConnection: Boolean(fieldThrottleSlowConn?.checked),
        lazyLoadWithMargin: Boolean(fieldThrottleLazy?.checked),
        lazyLoadMarginPx: 300,
        delayUntilInteraction: false,
        maxMobileAds: Number(fieldThrottleMobileMax?.value || 2),
        preventClsPlaceholders: Boolean(fieldThrottleCls?.checked),
      },
      slots: {},
    };

    for (const slot of slotKeys) {
      const enabled = (document.getElementById(`field-slot-${slot}-enabled`) as HTMLInputElement | null)?.checked ?? true;
      const activeRadio = document.querySelector(`input[name="${slot}-network"]:checked`) as HTMLInputElement | null;
      const adNetwork = activeRadio?.value || 'adsense';

      payload.slots[slot] = {
        enabled,
        adNetwork,
        slotId: (document.getElementById(`field-slot-${slot}-id`) as HTMLInputElement | null)?.value?.trim() || '',
        customCode: (document.getElementById(`field-slot-${slot}-code`) as HTMLTextAreaElement | null)?.value?.trim() || '',
        sponsorTargetUrl: (document.getElementById(`field-slot-${slot}-sponsor-target`) as HTMLInputElement | null)?.value?.trim() || '',
        sponsorBannerUrl: (document.getElementById(`field-slot-${slot}-sponsor-banner`) as HTMLInputElement | null)?.value?.trim() || '',
        sponsorAltText: (document.getElementById(`field-slot-${slot}-sponsor-alt`) as HTMLInputElement | null)?.value?.trim() || '',
        sponsorBadgeText: (document.getElementById(`field-slot-${slot}-sponsor-badge`) as HTMLInputElement | null)?.value?.trim() || 'Sponsored',
        sponsorOpenInNewTab: true,
        sponsorRel: 'sponsored nofollow noopener',
      };
    }

    try {
      const res = await fetch('/api/adsense-config/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save settings');

      if (formStatusMsg) {
        formStatusMsg.textContent = '✓ All settings, sponsor units, and throttling rules published successfully!';
        formStatusMsg.className = 'text-xs font-semibold text-emerald-600 dark:text-emerald-400';
      }

      updateStatusBadges(data.settings || payload);
      await loadAuditLogs();
    } catch (err: any) {
      if (formStatusMsg) {
        formStatusMsg.textContent = '❌ ' + (err.message || 'Error saving settings.');
        formStatusMsg.className = 'text-xs font-semibold text-red-600 dark:text-red-400';
      }
    } finally {
      if (btnSave) {
        btnSave.disabled = false;
        if (btnSaveText) btnSaveText.textContent = 'Save & Apply All Settings';
      }
    }
  });

  btnReload?.addEventListener('click', loadSettings);

  // ─── Audit Trail & Snapshot Rollback ───────────────────────────────────────
  async function loadAuditLogs() {
    if (!auditLogTbody) return;
    try {
      const res = await fetch('/api/admin/audit-logs');
      if (!res.ok) return;
      const data = await res.json();

      if (btnQuickRollback && labelSnapshotDate) {
        if (data.hasSnapshot && data.snapshotSavedAt) {
          btnQuickRollback.disabled = false;
          const dt = new Date(data.snapshotSavedAt);
          labelSnapshotDate.textContent = dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' (' + dt.toLocaleDateString() + ')';
        } else {
          btnQuickRollback.disabled = true;
          labelSnapshotDate.textContent = 'No snapshot';
        }
      }

      const logs = data.logs || [];
      if (!logs.length) {
        auditLogTbody.innerHTML = `<tr><td colspan="5" class="px-4 py-4 text-center text-slate-400">No activity recorded yet.</td></tr>`;
        return;
      }

      auditLogTbody.innerHTML = logs.map((log: any) => {
        let actionBadgeClass = 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300';
        if (log.action.includes('SETTINGS')) actionBadgeClass = 'bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300';
        if (log.action.includes('SPONSOR')) actionBadgeClass = 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300';
        if (log.action.includes('BACKUP')) actionBadgeClass = 'bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300';

        const timeStr = new Date(log.timestamp).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' });
        return `
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/40 transition-colors">
            <td class="px-4 py-2.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">${timeStr}</td>
            <td class="px-4 py-2.5 font-bold text-slate-900 dark:text-white">${log.user || 'admin'}</td>
            <td class="px-4 py-2.5">
              <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold ${actionBadgeClass}">
                ${log.action}
              </span>
            </td>
            <td class="px-4 py-2.5 text-slate-700 dark:text-slate-300">${log.summary || ''}</td>
            <td class="px-4 py-2.5 text-right uppercase text-[10px] font-bold text-slate-400">${log.category || 'general'}</td>
          </tr>
        `;
      }).join('');
    } catch (err) {
      console.error('Failed to load audit logs:', err);
    }
  }

  btnRefreshAuditLogs?.addEventListener('click', loadAuditLogs);

  // Rollback Action
  btnQuickRollback?.addEventListener('click', async () => {
    if (!confirm('Are you sure you want to revert to the previous configuration snapshot?')) return;

    if (btnQuickRollback) btnQuickRollback.disabled = true;

    try {
      const res = await fetch('/api/admin/audit-logs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'ROLLBACK' }),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Rollback failed');

      alert('✓ Successfully rolled back settings! Reloading configuration...');
      await loadSettings();
    } catch (err: any) {
      alert('❌ Rollback Error: ' + err.message);
    } finally {
      if (btnQuickRollback) btnQuickRollback.disabled = false;
    }
  });

  // ─── Ads.txt IAB Validator ─────────────────────────────────────────────────
  btnValidateAdsTxt?.addEventListener('click', () => {
    if (!fieldThirdPartyAdsTxt || !adsTxtValidationMsg) return;
    const lines = fieldThirdPartyAdsTxt.value.split('\n');
    let validCount = 0;
    let invalidCount = 0;

    lines.forEach((raw) => {
      const line = raw.trim();
      if (!line || line.startsWith('#')) return;
      const parts = line.split(',').map((p) => p.trim());
      if (parts.length >= 3) {
        const domain = parts[0];
        const pubId = parts[1];
        const type = parts[2].toUpperCase();
        if (domain.includes('.') && pubId.length > 0 && (type === 'DIRECT' || type === 'RESELLER')) {
          validCount++;
        } else {
          invalidCount++;
        }
      } else {
        invalidCount++;
      }
    });

    if (invalidCount === 0) {
      adsTxtValidationMsg.textContent = `✓ All ${validCount} partner seller lines conform to IAB OpenRTB specification.`;
      adsTxtValidationMsg.className = 'font-semibold text-emerald-600 dark:text-emerald-400';
    } else {
      adsTxtValidationMsg.textContent = `⚠️ Found ${invalidCount} irregular line(s). Please verify (domain, pubId, DIRECT/RESELLER).`;
      adsTxtValidationMsg.className = 'font-semibold text-amber-600 dark:text-amber-400';
    }
  });

  // ─── Backup & Restore Modal ────────────────────────────────────────────────
  btnOpenRestore?.addEventListener('click', () => modalRestore?.showModal());
  btnCloseRestore?.addEventListener('click', () => modalRestore?.close());
  btnCancelRestore?.addEventListener('click', () => modalRestore?.close());

  fileRestoreInput?.addEventListener('change', (e: any) => {
    const file = e.target?.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (evt) => {
      if (inputBackupJson) inputBackupJson.value = (evt.target?.result as string) || '';
    };
    reader.readAsText(file);
  });

  btnExecuteRestore?.addEventListener('click', async () => {
    const raw = inputBackupJson?.value?.trim();
    if (!raw) {
      if (restoreStatusMsg) {
        restoreStatusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300';
        restoreStatusMsg.textContent = 'Please choose a backup JSON file or paste content.';
        restoreStatusMsg.classList.remove('hidden');
      }
      return;
    }

    let parsed;
    try {
      parsed = JSON.parse(raw);
    } catch {
      if (restoreStatusMsg) {
        restoreStatusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300';
        restoreStatusMsg.textContent = 'Invalid JSON syntax. Please verify the backup file.';
        restoreStatusMsg.classList.remove('hidden');
      }
      return;
    }

    if (btnExecuteRestore) {
      btnExecuteRestore.disabled = true;
      btnExecuteRestore.textContent = 'Restoring...';
    }

    try {
      const res = await fetch('/api/admin/backup/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(parsed),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Restore failed');

      if (restoreStatusMsg) {
        restoreStatusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-emerald-50 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300';
        restoreStatusMsg.textContent = '✅ Backup restored successfully! Refreshing...';
        restoreStatusMsg.classList.remove('hidden');
      }

      setTimeout(() => window.location.reload(), 1200);
    } catch (err: any) {
      if (restoreStatusMsg) {
        restoreStatusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300';
        restoreStatusMsg.textContent = '❌ ' + (err.message || 'Error executing restore.');
        restoreStatusMsg.classList.remove('hidden');
      }
      if (btnExecuteRestore) {
        btnExecuteRestore.disabled = false;
        btnExecuteRestore.textContent = 'Execute Restore';
      }
    }
  });

  // ─── Initial Load ──────────────────────────────────────────────────────────
  loadSettings();
</script>
