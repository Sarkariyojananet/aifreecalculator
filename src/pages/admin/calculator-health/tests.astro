---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ALL_TEST_CASES, getTestedSlugs } from '../../../lib/calculator-tests/test-cases';
import { getLatestTestResults, getTestRunHistory, getCustomTestCases } from '../../../lib/calculator-tests/health-store';
import { calculators } from '../../../data/calculators';

const testedSlugs = getTestedSlugs();
const latestResults = await getLatestTestResults(Astro.locals);
const customTestCases = await getCustomTestCases(Astro.locals);
const runHistory = await getTestRunHistory(Astro.locals);
const latestRun = runHistory[0] || null;

const allTestsCombined = [
  ...ALL_TEST_CASES.map((tc) => ({
    ...tc,
    id: `static_${tc.slug}_${tc.name.replace(/\s+/g, '_')}`,
    isCustom: false,
  })),
  ...customTestCases.map((c) => ({
    id: c.id,
    slug: c.slug,
    name: c.name,
    category: c.category,
    expectedBehavior: c.expectedBehavior,
    expectedResultKey: c.expectedResultKey,
    expectedValue: c.expectedValue,
    tolerance: c.tolerance,
    run: () => {},
    description: c.description,
    isCustom: true,
  })),
];

const totalTests = allTestsCombined.length;
const normalTests = allTestsCombined.filter((t) => t.category === 'Normal').length;
const edgeTests = allTestsCombined.filter((t) => t.category === 'Edge Case').length;
const boundaryTests = allTestsCombined.filter((t) => t.category === 'Boundary').length;
const invalidTests = allTestsCombined.filter((t) => t.category === 'Invalid Input').length;

// Map test cases with their latest execution results if available
const enrichedTests = allTestsCombined.map((tc) => {
  const calc = calculators.find((c) => c.slug === tc.slug);
  const calcResults = latestResults?.[tc.slug]?.results;
  const matchResult = calcResults?.find((r) => r.testName === tc.name);

  return {
    ...tc,
    calcName: calc ? calc.name : tc.slug,
    calcCategory: calc ? calc.category : 'General',
    calcIcon: calc ? calc.icon : '🧮',
    latestState: matchResult?.state || 'NOT_RUN',
    durationMs: matchResult?.durationMs,
    errorMessage: matchResult?.errorMessage,
    actualValue: matchResult?.actualValue,
    expectedValue: matchResult?.expectedValue,
  };
});
---

<AdminLayout title="Calculator Test Suite | Calculator CMS" sectionTitle="Test Suite" activeSection="calculator-health">
  <div class="space-y-8 max-w-7xl mx-auto pb-12">

    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
            Automated Test Suite
          </h2>
          <span class="rounded-full bg-blue-100 dark:bg-blue-950 px-2.5 py-0.5 text-xs font-bold text-blue-700 dark:text-blue-300">
            {totalTests} Tests Across {testedSlugs.length} Calculators
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Covers normal baseline calculations, extreme boundaries, zero/negative edge conditions, and invalid input protection.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button
          id="btn-open-test-modal"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-2xs hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
        >
          <span>➕</span> Add Custom Test Case
        </button>
        <button
          id="run-tests-btn"
          type="button"
          class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer disabled:opacity-50"
        >
          <span id="btn-icon">⚡</span>
          <span id="btn-text">Execute All {totalTests} Tests</span>
        </button>
      </div>
    </div>

    <!-- Sub-Navigation Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="/admin/calculator-health/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🛡️ Health Overview
      </a>
      <a href="/admin/calculator-health/tests/" class="rounded-xl bg-blue-50 px-3.5 py-1.5 text-xs font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300 shrink-0">
        🧪 Test Suite ({testedSlugs.length} Covered)
      </a>
      <a href="/admin/calculator-health/errors/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        ⚠️ Runtime Errors
      </a>
    </div>

    <!-- Test Category Breakdown Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Normal Cases</div>
        <div class="mt-2 text-3xl font-black text-slate-900 dark:text-white">{normalTests}</div>
        <div class="mt-1 text-[11px] text-slate-400">Baseline accuracy benchmarks</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Edge Cases</div>
        <div class="mt-2 text-3xl font-black text-blue-600 dark:text-blue-400">{edgeTests}</div>
        <div class="mt-1 text-[11px] text-slate-400">Zero, 100%, negative, decimals</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Boundaries</div>
        <div class="mt-2 text-3xl font-black text-purple-600 dark:text-purple-400">{boundaryTests}</div>
        <div class="mt-1 text-[11px] text-slate-400">Maximum allowed values &amp; limits</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Invalid Inputs</div>
        <div class="mt-2 text-3xl font-black text-amber-600 dark:text-amber-400">{invalidTests}</div>
        <div class="mt-1 text-[11px] text-slate-400">NaN / Division-by-zero defense</div>
      </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">Filter Type:</span>
        <button type="button" class="test-filter-btn active px-3 py-1 rounded-xl text-xs font-bold transition bg-blue-600 text-white" data-type="all">
          All ({totalTests})
        </button>
        <button type="button" class="test-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200" data-type="Normal">
          Normal
        </button>
        <button type="button" class="test-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200" data-type="Edge Case">
          Edge Case
        </button>
        <button type="button" class="test-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200" data-type="Boundary">
          Boundary
        </button>
        <button type="button" class="test-filter-btn px-3 py-1 rounded-xl text-xs font-bold transition bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200" data-type="Invalid Input">
          Invalid
        </button>
      </div>

      <input
        type="search"
        id="search-test-input"
        placeholder="Search test case or calculator..."
        class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-800 placeholder-slate-400 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:placeholder-slate-500 w-full sm:w-64"
      />
    </div>

    <!-- Test Cases Table -->
    <div class="rounded-3xl border border-slate-200 bg-white overflow-hidden shadow-xs dark:border-slate-800 dark:bg-slate-900">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50/80 dark:bg-slate-950/60 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100 dark:border-slate-800">
          <tr>
            <th class="py-3.5 px-4">Calculator</th>
            <th class="py-3.5 px-4">Test Case</th>
            <th class="py-3.5 px-4">Category</th>
            <th class="py-3.5 px-4">Expected Behavior</th>
            <th class="py-3.5 px-4">Status</th>
            <th class="py-3.5 px-4 text-right">Duration</th>
          </tr>
        </thead>
        <tbody id="test-table-body" class="divide-y divide-slate-100 dark:divide-slate-800 font-medium">
          {enrichedTests.map((t) => (
            <tr
              class="test-row hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition"
              data-type={t.category}
              data-calc={t.calcName.toLowerCase()}
              data-slug={t.slug}
              data-name={t.name.toLowerCase()}
            >
              <td class="py-3 px-4">
                <div class="flex items-center gap-2">
                  <span>{t.calcIcon}</span>
                  <div>
                    <a href={`/admin/calculator-health/${t.slug}/`} class="font-bold text-slate-900 dark:text-white hover:text-blue-600 transition">
                      {t.calcName}
                    </a>
                    <div class="text-[10px] text-slate-400 font-mono">/{t.slug}/</div>
                  </div>
                </div>
              </td>

              <td class="py-3 px-4">
                <div class="font-semibold text-slate-800 dark:text-slate-200">{t.name}</div>
                {t.errorMessage && (
                  <div class="text-[11px] text-red-600 dark:text-red-400 font-mono mt-0.5">
                    {t.errorMessage}
                  </div>
                )}
              </td>

              <td class="py-3 px-4">
                <span class={
                  t.category === 'Normal' ? 'rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300' :
                  t.category === 'Edge Case' ? 'rounded-md bg-blue-50 px-2 py-0.5 text-[10px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300' :
                  t.category === 'Boundary' ? 'rounded-md bg-purple-50 px-2 py-0.5 text-[10px] font-bold text-purple-700 dark:bg-purple-950 dark:text-purple-300' :
                  'rounded-md bg-amber-50 px-2 py-0.5 text-[10px] font-bold text-amber-700 dark:bg-amber-950 dark:text-amber-300'
                }>
                  {t.category}
                </span>
              </td>

              <td class="py-3 px-4">
                <div class="font-mono text-[11px] text-slate-600 dark:text-slate-300">
                  {t.expectedBehavior === 'result' ? (
                    <span>
                      {t.expectedResultKey}:{' '}
                      <strong>{t.expectedValue !== undefined ? String(t.expectedValue) : 'validated'}</strong>
                      {t.tolerance ? ` (±${t.tolerance})` : ''}
                    </span>
                  ) : (
                    <span class="text-amber-600 dark:text-amber-400">
                      Expects Handled Error
                    </span>
                  )}
                </div>
              </td>

              <td class="py-3 px-4">
                {t.latestState === 'PASS' && (
                  <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-bold">
                    <span>✓</span> PASS
                  </span>
                )}
                {t.latestState === 'FAIL' && (
                  <span class="inline-flex items-center gap-1 text-amber-600 dark:text-amber-400 font-bold">
                    <span>⚠️</span> FAIL
                  </span>
                )}
                {t.latestState === 'ERROR' && (
                  <span class="inline-flex items-center gap-1 text-red-600 dark:text-red-400 font-bold">
                    <span>❌</span> ERROR
                  </span>
                )}
                {t.latestState === 'NOT_RUN' && (
                  <span class="text-slate-400 font-medium">Ready</span>
                )}
              </td>

              <td class="py-3 px-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <span class="font-mono text-slate-400">
                    {t.durationMs !== undefined ? `${t.durationMs.toFixed(1)}ms` : '-'}
                  </span>
                  {t.isCustom && (
                    <button
                      type="button"
                      class="btn-delete-custom-test p-1 text-slate-400 hover:text-red-600 dark:hover:text-red-400 transition cursor-pointer"
                      data-slug={t.slug}
                      data-id={t.id}
                      title="Delete custom test case"
                    >
                      🗑️
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- ➕ Add Custom Test Case Modal -->
    <div id="modal-add-custom-test" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
      <div class="w-full max-w-lg rounded-3xl bg-white p-6 dark:bg-slate-900 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
          <div class="flex items-center gap-2">
            <span class="text-xl">🧪</span>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Add Custom Formula Test Case</h3>
          </div>
          <button type="button" id="btn-close-test-modal" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg cursor-pointer">✕</button>
        </div>

        <form id="form-add-test" class="space-y-3.5 text-xs">
          <div>
            <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Target Calculator <span class="text-red-500">*</span></label>
            <select
              id="test-calc-slug"
              name="slug"
              required
              class="w-full rounded-xl border border-slate-300 bg-white p-2.5 font-semibold text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white cursor-pointer"
            >
              {calculators.map((c) => (
                <option value={c.slug}>🧮 {c.name} (/{c.slug}/)</option>
              ))}
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Test Name <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="test-name"
                name="name"
                placeholder="e.g. Standard 10m x 5m pool"
                required
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>

            <div>
              <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Category</label>
              <select
                id="test-category"
                name="category"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 font-semibold text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white cursor-pointer"
              >
                <option value="Normal">Normal Baseline</option>
                <option value="Boundary">Boundary Condition</option>
                <option value="Edge Case">Edge Case</option>
                <option value="Invalid Input">Invalid Input Guard</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Expected Key</label>
              <input
                type="text"
                id="test-expected-key"
                placeholder="e.g. volumeM3"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 font-mono text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>

            <div>
              <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Expected Value</label>
              <input
                type="text"
                id="test-expected-val"
                placeholder="e.g. 75"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 font-mono text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>

            <div>
              <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Tolerance (±)</label>
              <input
                type="number"
                id="test-tolerance"
                step="any"
                value="0.01"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 font-mono text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>
          </div>

          <div>
            <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Input Parameters (JSON)</label>
            <textarea
              id="test-inputs-json"
              rows="3"
              placeholder='e.g. {"length": 10, "width": 5, "depth": 1.5}'
              class="w-full rounded-xl border border-slate-300 bg-white p-2.5 font-mono text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            ></textarea>
          </div>

          <div>
            <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Notes / Description</label>
            <input
              type="text"
              id="test-description"
              placeholder="e.g. Verifies swimming pool rectangular volume formula"
              class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            />
          </div>

          <div id="test-form-status" class="hidden rounded-xl p-3 text-xs font-semibold"></div>

          <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
            <button
              type="button"
              id="btn-cancel-test-modal"
              class="rounded-xl border border-slate-300 px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              id="btn-save-custom-test"
              class="rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white hover:bg-blue-700 transition cursor-pointer"
            >
              Save Test Case
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  // Run tests button
  const runBtn = document.getElementById('run-tests-btn') as HTMLButtonElement | null;
  const btnIcon = document.getElementById('btn-icon');
  const btnText = document.getElementById('btn-text');

  if (runBtn) {
    runBtn.addEventListener('click', async () => {
      if (runBtn.disabled) return;
      runBtn.disabled = true;
      if (btnIcon) btnIcon.textContent = '⏳';
      if (btnText) btnText.textContent = 'Running All Tests...';

      try {
        const token = localStorage.getItem('admin_token') || '';
        const res = await fetch('/api/admin/calculator-health/run', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
          },
        });

        if (res.ok) {
          const data = await res.json();
          if (btnIcon) btnIcon.textContent = '✓';
          if (btnText) btnText.textContent = `Completed (${data.passed}/${data.totalTests} passed)`;
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          alert('Failed to run test suite.');
          runBtn.disabled = false;
        }
      } catch {
        alert('Network error connecting to test runner.');
        runBtn.disabled = false;
      }
    });
  }

  // Filtering
  let activeType = 'all';
  let searchQuery = '';

  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.test-filter-btn');
  const searchInput = document.getElementById('search-test-input') as HTMLInputElement | null;

  function applyFilters() {
    const rows = document.querySelectorAll<HTMLElement>('.test-row');
    rows.forEach((row) => {
      const type = row.getAttribute('data-type') || '';
      const calc = row.getAttribute('data-calc') || '';
      const slug = row.getAttribute('data-slug') || '';
      const name = row.getAttribute('data-name') || '';

      const matchType = activeType === 'all' || type === activeType;
      const matchSearch =
        !searchQuery ||
        name.includes(searchQuery) ||
        calc.includes(searchQuery) ||
        slug.includes(searchQuery);

      row.style.display = matchType && matchSearch ? '' : 'none';
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
      });
      btn.classList.remove('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
      btn.classList.add('bg-blue-600', 'text-white');
      activeType = btn.getAttribute('data-type') || 'all';
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  }

  // ─── Custom Test Case Modal Controller ─────────────────────────────────────────
  const modalTest = document.getElementById('modal-add-custom-test');
  const btnOpenTestModal = document.getElementById('btn-open-test-modal');
  const btnCloseTestModal = document.getElementById('btn-close-test-modal');
  const btnCancelTestModal = document.getElementById('btn-cancel-test-modal');
  const formAddTest = document.getElementById('form-add-test') as HTMLFormElement | null;
  const testFormStatus = document.getElementById('test-form-status');
  const btnSaveCustomTest = document.getElementById('btn-save-custom-test') as HTMLButtonElement | null;

  function openTestModal() {
    if (!modalTest) return;
    modalTest.classList.remove('hidden');
    modalTest.classList.add('flex');
    if (testFormStatus) {
      testFormStatus.classList.add('hidden');
      testFormStatus.textContent = '';
    }
  }

  function closeTestModal() {
    if (!modalTest) return;
    modalTest.classList.add('hidden');
    modalTest.classList.remove('flex');
  }

  btnOpenTestModal?.addEventListener('click', openTestModal);
  btnCloseTestModal?.addEventListener('click', closeTestModal);
  btnCancelTestModal?.addEventListener('click', closeTestModal);

  formAddTest?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const slugEl = document.getElementById('test-calc-slug') as HTMLSelectElement | null;
    const nameEl = document.getElementById('test-name') as HTMLInputElement | null;
    const catEl = document.getElementById('test-category') as HTMLSelectElement | null;
    const keyEl = document.getElementById('test-expected-key') as HTMLInputElement | null;
    const valEl = document.getElementById('test-expected-val') as HTMLInputElement | null;
    const tolEl = document.getElementById('test-tolerance') as HTMLInputElement | null;
    const descEl = document.getElementById('test-description') as HTMLInputElement | null;
    const inputsJsonEl = document.getElementById('test-inputs-json') as HTMLTextAreaElement | null;

    const slug = slugEl?.value || '';
    const name = nameEl?.value.trim() || '';
    if (!slug || !name) return;

    let inputValues = {};
    const rawJson = inputsJsonEl?.value.trim() || '';
    if (rawJson) {
      try {
        inputValues = JSON.parse(rawJson);
      } catch {
        if (testFormStatus) {
          testFormStatus.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300';
          testFormStatus.textContent = 'Input parameters must be valid JSON.';
          testFormStatus.classList.remove('hidden');
        }
        return;
      }
    }

    if (btnSaveCustomTest) {
      btnSaveCustomTest.disabled = true;
      btnSaveCustomTest.textContent = 'Saving...';
    }

    try {
      const token = localStorage.getItem('admin_token') || '';
      const res = await fetch(`/api/admin/calculator-health/tests/${slug}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
        },
        body: JSON.stringify({
          name,
          category: catEl?.value || 'Normal',
          expectedBehavior: 'result',
          expectedResultKey: keyEl?.value.trim() || undefined,
          expectedValue: valEl?.value !== '' ? Number(valEl?.value) || valEl?.value : undefined,
          tolerance: Number(tolEl?.value) || 0,
          description: descEl?.value.trim() || undefined,
          inputValues,
          active: true,
        }),
      });

      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        if (testFormStatus) {
          testFormStatus.className = 'rounded-xl p-3 text-xs font-semibold bg-emerald-50 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300';
          testFormStatus.textContent = '✅ Test case saved successfully!';
          testFormStatus.classList.remove('hidden');
        }
        setTimeout(() => {
          window.location.reload();
        }, 800);
      } else {
        throw new Error(data.error || 'Failed to save test case.');
      }
    } catch (err: any) {
      if (testFormStatus) {
        testFormStatus.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300';
        testFormStatus.textContent = '❌ ' + (err.message || 'Error saving test case.');
        testFormStatus.classList.remove('hidden');
      }
      if (btnSaveCustomTest) {
        btnSaveCustomTest.disabled = false;
        btnSaveCustomTest.textContent = 'Save Test Case';
      }
    }
  });

  // Delete custom test case listener
  document.querySelectorAll('.btn-delete-custom-test').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const slug = btn.getAttribute('data-slug');
      const testId = btn.getAttribute('data-id');
      if (!slug || !testId) return;

      if (!confirm('Are you sure you want to delete this custom test case?')) return;

      try {
        const token = localStorage.getItem('admin_token') || '';
        const res = await fetch(`/api/admin/calculator-health/tests/${slug}?id=${encodeURIComponent(testId)}`, {
          method: 'DELETE',
          headers: token ? { 'Authorization': `Bearer ${token}` } : {},
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to delete test case.');
        }
      } catch {
        alert('Network error deleting test case.');
      }
    });
  });
</script>
