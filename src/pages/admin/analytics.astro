---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCalculatorStats } from '../../lib/db';
import { calculators } from '../../data/calculators';

const stats = await getCalculatorStats();
const totalCalculations = Object.values(stats).reduce((a, b) => a + b, 0);

const sortedTools = Object.entries(stats)
  .sort(([, a], [, b]) => b - a)
  .map(([slug, views]) => {
    const calc = calculators.find((c) => c.slug === slug);
    return {
      slug,
      name: calc ? calc.name : slug,
      category: calc ? calc.category : 'General',
      icon: calc ? calc.icon : '🧮',
      views,
    };
  });
---

<AdminLayout title="Analytics & Usage Stats | AI Free Calculator" activeTab="analytics">
  <div class="space-y-6">
    
    <!-- Top KPI Cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Calculations Computed</div>
        <div class="mt-2 text-3xl font-black text-blue-600 dark:text-blue-400">{totalCalculations.toLocaleString()}</div>
        <div class="mt-1 text-[11px] text-slate-400">Across all 42+ active tools</div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Top Visited Category</div>
        <div class="mt-2 text-3xl font-black text-emerald-600 dark:text-emerald-400">Finance & Taxes</div>
        <div class="mt-1 text-[11px] text-slate-400">Income Tax & EMI driving highest RPM</div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Civil BOQ Computations</div>
        <div class="mt-2 text-3xl font-black text-slate-900 dark:text-white">3,035+</div>
        <div class="mt-1 text-[11px] text-slate-400">RCC Slab & Brickwork estimators</div>
      </div>
    </div>

    <!-- Leaderboard Table -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900 p-6">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-4">
        Top Performing Calculators Leaderboard
      </h3>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-950 text-slate-600 dark:text-slate-400 font-bold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="p-3">Rank</th>
              <th class="p-3">Calculator</th>
              <th class="p-3">Category</th>
              <th class="p-3 text-right">Calculations Run</th>
              <th class="p-3 text-right">Share</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium">
            {sortedTools.map((t, idx) => {
              const share = Math.round((t.views / totalCalculations) * 100);
              return (
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                  <td class="p-3 font-bold text-slate-400">#{idx + 1}</td>
                  <td class="p-3">
                    <div class="flex items-center gap-2">
                      <span>{t.icon}</span>
                      <span class="font-bold text-slate-900 dark:text-white">{t.name}</span>
                    </div>
                  </td>
                  <td class="p-3">
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                      {t.category}
                    </span>
                  </td>
                  <td class="p-3 text-right font-mono font-bold text-blue-600 dark:text-blue-400">
                    {t.views.toLocaleString()}
                  </td>
                  <td class="p-3 text-right font-semibold text-slate-500">
                    {share}%
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
