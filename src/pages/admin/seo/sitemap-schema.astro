---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { calculators, categories } from '../../../data/calculators';
import { CORE_PAGES } from '../../../lib/seo/audit-engine';

const sitemapEntries = [
  { url: 'https://aifreecalculator.com/', priority: '1.0', changefreq: 'daily', type: 'Homepage' },
  ...categories.map((c) => ({
    url: `https://aifreecalculator.com${c.path}`,
    priority: '0.9',
    changefreq: 'weekly',
    type: 'Category Hub',
  })),
  ...calculators.map((c) => ({
    url: `https://aifreecalculator.com${c.path}`,
    priority: '0.9',
    changefreq: 'weekly',
    type: 'Calculator Tool',
  })),
  ...CORE_PAGES.filter((p) => p.path !== '/').map((p) => ({
    url: `https://aifreecalculator.com${p.path}`,
    priority: '0.7',
    changefreq: 'monthly',
    type: 'Core Static Page',
  })),
];

// Schema audit: verifies schema components exist in CalculatorLayout source.
// Does NOT perform runtime JSON-LD parsing or visible FAQ consistency check.
// Status reflects "Schema Present" not "Schema Structurally Validated".
const schemaAudits = calculators.map((c) => ({
  name: c.name,
  path: c.path,
  category: c.category,
  schemas: ['WebApplication', 'Offer', 'FAQPage'],
  status: 'present', // Component-level presence confirmed; runtime JSON-LD not parsed.
}));
---

<AdminLayout title="Sitemap & Schema Health Validator | Calculator CMS" sectionTitle="Sitemap & Schema" activeSection="seo-health">
  <div class="space-y-8 max-w-7xl mx-auto pb-16">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
          <span>🗺️</span> Sitemap Route Inventory &amp; Schema Inspector
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Validates expected public routes against the sitemap registry. Schema inspection confirms component presence — not runtime JSON-LD parsing. Admin routes and API endpoints are excluded.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/sitemap-index.xml"
          target="_blank"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition shadow-2xs"
        >
          <span>🌐</span> View sitemap-index.xml ↗
        </a>
      </div>
    </div>

    <!-- SEO Sub-Navigation Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="/admin/seo/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📊 Audit Overview
      </a>
      <a href="/admin/seo/bulk/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📝 Bulk Meta Editor
      </a>
      <a href="/admin/seo/duplicates/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        👯 Duplicate Content
      </a>
      <a href="/admin/seo/links/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🔗 Internal Link Audit
      </a>
      <a href="/admin/seo/sitemap-schema/" class="rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs shrink-0">
        🗺️ Sitemap &amp; Schema
      </a>
      <a href="/admin/seo/history/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📜 Change History
      </a>
    </div>

    <!-- Methodology Disclosure -->
    <div class="rounded-2xl border border-amber-200 bg-amber-50/60 px-5 py-3.5 text-xs text-amber-800 dark:border-amber-800/40 dark:bg-amber-950/30 dark:text-amber-300 leading-relaxed">
      <strong>⚠️ Methodology Note:</strong> This report is a <em>Sitemap Route Inventory</em> — it compares expected public routes against the registry. It does not fetch or parse the generated <code>sitemap-index.xml</code> at runtime. Schema status indicates component presence in CalculatorLayout; runtime JSON-LD structure is not parsed.
    </div>

    <!-- 1. Sitemap Health Summary -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Expected Public Routes</div>
        <div class="mt-1 text-3xl font-black text-slate-900 dark:text-white font-mono">{sitemapEntries.length}</div>
        <div class="mt-1 text-xs text-slate-500">Route Inventory (not diff vs generated XML)</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Admin &amp; API Exclusions</div>
        <div class="mt-1 text-3xl font-black text-blue-600 dark:text-blue-400 font-mono">Enforced</div>
        <div class="mt-1 text-xs text-slate-400">noindex, nofollow on all admin routes</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Schema Coverage</div>
        <div class="mt-1 text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono">{calculators.length} / {calculators.length}</div>
        <div class="mt-1 text-xs text-slate-500">Schema Present (not runtime validated)</div>
      </div>
    </div>

    <!-- 2. Schema Structure Inspector -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>⚡</span> JSON-LD Schema Inspector ({schemaAudits.length} Tools)
        </h3>
        <span class="text-xs text-slate-500">Schema Present — Component-Level Inspection</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-2xs dark:border-slate-800 dark:bg-slate-900 space-y-3">
          <h4 class="font-bold text-xs uppercase tracking-wider text-slate-400">Schema Types Implemented</h4>
          <div class="space-y-2 text-xs">
            <div class="flex items-center justify-between rounded-xl bg-slate-50 p-2.5 dark:bg-slate-950">
              <span class="font-bold text-slate-900 dark:text-white">WebApplication</span>
              <span class="font-mono text-emerald-600 font-bold">{calculators.length} tools (Present)</span>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-slate-50 p-2.5 dark:bg-slate-950">
              <span class="font-bold text-slate-900 dark:text-white">FAQPage (Structured Q&amp;A)</span>
              <span class="font-mono text-emerald-600 font-bold">{calculators.length} tools (Present)</span>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-slate-50 p-2.5 dark:bg-slate-950">
              <span class="font-bold text-slate-900 dark:text-white">BreadcrumbList</span>
              <span class="font-mono text-emerald-600 font-bold">5 Category Hubs</span>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-slate-50 p-2.5 dark:bg-slate-950">
              <span class="font-bold text-slate-900 dark:text-white">WebSite &amp; Organization</span>
              <span class="font-mono text-emerald-600 font-bold">Homepage</span>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-2xs dark:border-slate-800 dark:bg-slate-900 space-y-3">
          <h4 class="font-bold text-xs uppercase tracking-wider text-slate-400">Google Rich Snippets Validation</h4>
          <div class="space-y-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            <div class="flex items-start gap-2">
              <span class="text-emerald-600">✓</span>
              <span><strong>No Fake Reviews / AggregateRating:</strong> Google penalized spam ratings. AI Free Calculator uses WebApplication without artificial stars or fabricated ratings.</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-emerald-600">✓</span>
              <span><strong>Free Offer Declared:</strong> Schema explicitly specifies <code>price: 0 USD</code> for search engine software cards.</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-amber-600">⚠</span>
              <span><strong>FAQ Consistency:</strong> FAQPage schema is emitted by CalculatorLayout. Matching against page-specific visible FAQ HTML is not validated at runtime — full consistency check requires rendered page inspection.</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-slate-500">ℹ</span>
              <span><strong>JSON-LD Structure:</strong> Schema components are present in source. Runtime JSON-LD parsing (required to catch structural errors) is not performed by this tool. Use Google Rich Results Test for production validation.</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Sitemap URL Registry Table -->
    <div class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📋</span> Expected Public Route Registry ({sitemapEntries.length} Routes)
        </h3>
        <input
          type="text"
          id="search-sitemap-table"
          placeholder="Filter URLs..."
          class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
        />
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white shadow-2xs dark:border-slate-800 dark:bg-slate-900 overflow-x-auto">
        <table class="w-full text-left text-xs" id="sitemap-table">
          <thead class="border-b border-slate-100 bg-slate-50/70 text-[11px] font-black uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-950/40 dark:text-slate-400">
            <tr>
              <th class="p-3.5">Indexed URL</th>
              <th class="p-3.5">Page Type</th>
              <th class="p-3.5 text-center">Priority</th>
              <th class="p-3.5 text-center">Change Frequency</th>
              <th class="p-3.5 text-right">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
            {sitemapEntries.map((item) => (
              <tr class="sitemap-row hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition" data-search={item.url.toLowerCase()}>
                <td class="p-3.5 font-mono text-blue-600 dark:text-blue-400 truncate max-w-md">
                  <a href={item.url} target="_blank" class="hover:underline">
                    {item.url} ↗
                  </a>
                </td>
                <td class="p-3.5 font-bold text-slate-800 dark:text-slate-200">
                  {item.type}
                </td>
                <td class="p-3.5 text-center font-mono font-bold">
                  <span class="rounded bg-blue-50 px-2 py-0.5 text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                    {item.priority}
                  </span>
                </td>
                <td class="p-3.5 text-center font-mono text-slate-500 dark:text-slate-400">
                  {item.changefreq}
                </td>
                <td class="p-3.5 text-right">
                  <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                    ● Included
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script is:inline>
  const searchInp = document.getElementById('search-sitemap-table');
  const rows = document.querySelectorAll('.sitemap-row');

  searchInp?.addEventListener('input', (e) => {
    const q = (e.target.value || '').trim().toLowerCase();
    rows.forEach((row) => {
      const text = row.dataset.search || '';
      if (!q || text.includes(q)) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  });
</script>
