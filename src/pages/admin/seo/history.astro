---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSEOChangeHistory } from '../../../lib/seo/change-history';
import { authenticateAdminRequest } from '../../../lib/auth';

const user = await authenticateAdminRequest(Astro.request, Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/barwalaoffice/');
}

const history = await getSEOChangeHistory(Astro.locals);
---

<AdminLayout title="SEO Change History & Audit Trail | Calculator CMS" sectionTitle="SEO Change History" activeSection="seo-health">
  <div class="space-y-8 max-w-7xl mx-auto pb-16">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
          <span>📜</span> SEO Change History &amp; Audit Trail
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Historical log of every metadata modification, field change, timestamp, and administrator author.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/admin/seo/bulk/"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition"
        >
          <span>📝</span> Open Bulk Editor
        </a>
      </div>
    </div>

    <!-- SEO Sub-Navigation Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="/admin/seo/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📊 Audit Overview
      </a>
      <a href="/admin/seo/bulk/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📝 Bulk Meta Editor
      </a>
      <a href="/admin/seo/duplicates/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        👯 Duplicate Content
      </a>
      <a href="/admin/seo/links/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🔗 Internal Link Audit
      </a>
      <a href="/admin/seo/sitemap-schema/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🗺️ Sitemap &amp; Schema
      </a>
      <a href="/admin/seo/history/" class="rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs shrink-0">
        📜 Change History ({history.length})
      </a>
    </div>

    <!-- History Timeline / List -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>⏱️</span> Recent Modifications Log ({history.length})
        </h3>
      </div>

      {history.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-slate-300 p-12 text-center dark:border-slate-800">
          <span class="text-3xl">📭</span>
          <p class="mt-2 text-xs text-slate-500">No SEO changes recorded yet. Edits made in the Bulk Editor will appear here.</p>
        </div>
      ) : (
        <div class="space-y-3">
          {history.map((rec) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-2xs dark:border-slate-800 dark:bg-slate-900 space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-2.5 dark:border-slate-800">
                <div class="flex items-center gap-2">
                  <span class="rounded bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300 uppercase">
                    {rec.field}
                  </span>
                  <h4 class="font-bold text-sm text-slate-900 dark:text-white">{rec.pageName}</h4>
                  <span class="font-mono text-xs text-slate-400">({rec.pagePath})</span>
                </div>

                <div class="flex items-center gap-2 text-[11px] text-slate-400">
                  <span>Author: <strong class="text-slate-700 dark:text-slate-300">{rec.adminUser}</strong></span>
                  <span>•</span>
                  <span>{new Date(rec.changedAt).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' })}</span>
                </div>
              </div>

              <!-- Diff View -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                <div class="rounded-xl bg-red-50/50 p-3 border border-red-100 dark:border-red-900/40 dark:bg-red-950/20">
                  <div class="text-[10px] font-bold text-red-700 dark:text-red-400 uppercase tracking-wider mb-1">Previous Value:</div>
                  <div class="text-slate-700 dark:text-slate-300 line-through opacity-80 break-words">{rec.oldValue || '(empty)'}</div>
                </div>

                <div class="rounded-xl bg-emerald-50/50 p-3 border border-emerald-100 dark:border-emerald-900/40 dark:bg-emerald-950/20">
                  <div class="text-[10px] font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-1">New Value:</div>
                  <div class="text-emerald-900 dark:text-emerald-200 font-medium break-words">{rec.newValue}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

  </div>
</AdminLayout>
