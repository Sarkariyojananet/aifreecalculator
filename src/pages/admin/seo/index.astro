---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { runFullSEOAudit } from '../../../lib/seo/audit-engine';
import { authenticateAdminRequest } from '../../../lib/auth';

const user = await authenticateAdminRequest(Astro.request, Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/barwalaoffice/');
}

// Run comprehensive rule-based technical SEO audit
const report = await runFullSEOAudit(Astro.locals);
const auditGeneratedAt = new Date(report.timestamp).toLocaleString('en-IN', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

// Category counts
const titleCount = report.issues.filter((i) => i.category === 'title').length;
const descCount = report.issues.filter((i) => i.category === 'description').length;
const dupCount = report.issues.filter((i) => i.category === 'duplicate').length;
const linkCount = report.issues.filter((i) => i.category === 'links').length;
const canonicalCount = report.issues.filter((i) => i.category === 'canonical').length;

const auditSuccess = Astro.url.searchParams.get('audited');
---

<AdminLayout title="SEO Intelligence & Health Dashboard | Calculator CMS" sectionTitle="SEO Intelligence" activeSection="seo" badge={`${report.criticalCount + report.highCount} Action Items`}>
  <div class="space-y-8 max-w-7xl mx-auto pb-16">
    
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
          <span>🩺</span> SEO Intelligence Dashboard
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Automated technical SEO health audit, metadata verification, and orphan link detection.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button
          type="button"
          id="btn-trigger-audit"
          onclick="window.triggerSeoAudit && window.triggerSeoAudit()"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer"
        >
          <span id="btn-trigger-icon">⚡</span>
          <span id="btn-trigger-text">Re-run Audit</span>
        </button>

        <a
          href="/admin/seo/bulk/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition shadow-2xs"
        >
          <span>📝</span> Bulk Editor
        </a>
      </div>
    </div>

    <div id="live-audit-status" class="hidden rounded-2xl p-4 text-xs font-bold shadow-xs"></div>

    {auditSuccess && (
      <div id="audit-success-banner" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-xs font-bold text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/60 dark:text-emerald-300 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <span class="text-base">✅</span>
          <span>Fresh SEO Audit completed successfully! Scanned all {report.totalPages} live routes ({report.issues.length} active issue items).</span>
        </div>
        <a href="/admin/seo/" class="text-emerald-700 dark:text-emerald-400 hover:underline text-[11px] shrink-0">Dismiss ✕</a>
      </div>
    )}

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="#technical-audit" class="rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs shrink-0">
        🩺 Technical Health Audit ({report.issues.length})
      </a>
      <a href="/admin/seo/bulk/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📝 Bulk Meta Editor
      </a>
      <a href="/admin/seo/duplicates/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        👯 Duplicate Content ({report.duplicates.length})
      </a>
      <a href="/admin/seo/links/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🔗 Internal Links ({report.orphanPages.length} Orphans)
      </a>
      <a href="/admin/seo/sitemap-schema/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🗺️ Sitemap &amp; Schema
      </a>
      <a href="/admin/seo/history/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📜 Change History
      </a>
    </div>


    <!-- Technical Health & Metadata Audit Section -->
    <div id="technical-audit" class="space-y-6">
      
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-xl font-black text-slate-900 dark:text-white flex items-center gap-2.5">
            <span>🩺</span> Technical Health &amp; Metadata Audit
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Rule-based code &amp; DOM audit across all 42+ calculator routes. Last run: {auditGeneratedAt}
          </p>
        </div>
      </div>

      <!-- KPI Summary Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-3 sm:gap-4">
        <div data-kpi-filter="pages-all" class="cursor-pointer rounded-3xl border border-slate-200 bg-white p-4 shadow-2xs hover:shadow-md hover:border-blue-400 transition-all dark:border-slate-800 dark:bg-slate-900" title="Click to show all live pages">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Pages Audited</div>
          <div class="mt-1 text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">{report.totalPages}</div>
          <div class="mt-1 text-[11px] font-semibold text-blue-600 dark:text-blue-400">View All Pages →</div>
        </div>

        <div data-kpi-filter="pages-clean" class="cursor-pointer rounded-3xl border border-emerald-200 bg-emerald-50/50 p-4 shadow-2xs hover:shadow-md hover:border-emerald-400 transition-all dark:border-emerald-900/40 dark:bg-emerald-950/20" title="Click to view 100% clean pages">
          <div class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">100% Clean</div>
          <div class="mt-1 text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono">{report.healthyPages}</div>
          <div class="mt-1 text-[11px] font-semibold text-emerald-700/80 dark:text-emerald-400">Zero SEO issues</div>
        </div>

        <div data-kpi-filter="critical" class="cursor-pointer rounded-3xl border border-red-200 bg-red-50/60 p-4 shadow-2xs hover:shadow-md hover:border-red-400 transition-all dark:border-red-900/50 dark:bg-red-950/30" title="Click to filter Critical issues">
          <div class="text-[10px] font-bold uppercase tracking-wider text-red-700 dark:text-red-300">Critical</div>
          <div class="mt-1 text-2xl sm:text-3xl font-black text-red-600 dark:text-red-400 font-mono">{report.criticalCount}</div>
          <div class="mt-1 text-[11px] font-semibold text-red-700/80 dark:text-red-400">Fix immediately</div>
        </div>

        <div data-kpi-filter="high" class="cursor-pointer rounded-3xl border border-amber-200 bg-amber-50/60 p-4 shadow-2xs hover:shadow-md hover:border-amber-400 transition-all dark:border-amber-900/50 dark:bg-amber-950/30" title="Click to filter High Priority issues">
          <div class="text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300">High Priority</div>
          <div class="mt-1 text-2xl sm:text-3xl font-black text-amber-600 dark:text-amber-400 font-mono">{report.highCount}</div>
          <div class="mt-1 text-[11px] font-semibold text-amber-700/80 dark:text-amber-400">Impacting ranking</div>
        </div>

        <div data-kpi-filter="medium" class="cursor-pointer rounded-3xl border border-blue-200 bg-blue-50/50 p-4 shadow-2xs hover:shadow-md hover:border-blue-400 transition-all dark:border-blue-900/40 dark:bg-blue-950/20" title="Click to filter Medium Priority issues">
          <div class="text-[10px] font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Medium Priority</div>
          <div class="mt-1 text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400 font-mono">{report.mediumCount}</div>
          <div class="mt-1 text-[11px] font-semibold text-blue-700/80 dark:text-blue-400">Optimization ops</div>
        </div>

        <div data-kpi-filter="low" class="cursor-pointer rounded-3xl border border-slate-200 bg-slate-50/60 p-4 shadow-2xs hover:shadow-md hover:border-slate-400 transition-all dark:border-slate-800 dark:bg-slate-900" title="Click to filter Low Priority issues">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Low Priority</div>
          <div class="mt-1 text-2xl sm:text-3xl font-black text-slate-700 dark:text-slate-300 font-mono">{report.lowCount}</div>
          <div class="mt-1 text-[11px] font-semibold text-slate-500">Minor tweaks ({report.totalPages - report.healthyPages} pages)</div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Avg Score</div>
          <div class="mt-1 text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">{report.overallScore}%</div>
          <div class="mt-1 text-[11px] font-semibold text-emerald-600">Site-wide health</div>
        </div>
      </div>

      <!-- Main Audit Explorer with View Switching Tabs -->
      <div class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-5">
        
        <!-- View Switcher -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4 dark:border-slate-800">
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="tab-view-pages"
              class="view-toggle-btn active rounded-xl px-4 py-2 text-xs font-bold bg-blue-600 text-white shadow-xs cursor-pointer transition"
            >
              📄 All Audited Pages ({report.totalPages})
            </button>
            <button
              type="button"
              id="tab-view-issues"
              class="view-toggle-btn rounded-xl px-4 py-2 text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer transition"
            >
              ⚠️ Issue Items ({report.issues.length})
            </button>
          </div>

          <div class="text-xs text-slate-500 dark:text-slate-400">
            <span id="view-mode-description">Showing full catalog of {report.totalPages} pages with live SEO health</span>
          </div>
        </div>

        <!-- 1. ALL AUDITED PAGES VIEW -->
        <div id="section-view-pages" class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2" id="page-filter-group">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Show:</span>
              <button type="button" data-page-filter="all" class="page-filter-btn active rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-3 py-1 text-xs font-bold transition">All Pages ({report.totalPages})</button>
              <button type="button" data-page-filter="clean" class="page-filter-btn rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 px-3 py-1 text-xs font-bold transition">100% Clean ({report.healthyPages})</button>
              <button type="button" data-page-filter="issues" class="page-filter-btn rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 px-3 py-1 text-xs font-bold transition">Has Suggestions ({report.totalPages - report.healthyPages})</button>
            </div>

            <div class="relative min-w-56">
              <input
                type="text"
                id="search-pages-input"
                placeholder="Search by page name or path..."
                class="w-full rounded-xl border border-slate-300 bg-white py-1.5 px-3 pl-8 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white focus:border-blue-500 focus:outline-hidden"
              />
              <span class="absolute left-2.5 top-2 text-xs text-slate-400">🔍</span>
            </div>
          </div>

          <!-- All Pages Table -->
          <div class="overflow-x-auto rounded-2xl border border-slate-100 dark:border-slate-800">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-400 font-semibold uppercase text-[10px] bg-slate-50/60 dark:bg-slate-950/40">
                  <th class="py-3 px-3.5">Page &amp; Route</th>
                  <th class="py-3 px-3.5">Category</th>
                  <th class="py-3 px-3.5">Meta Title</th>
                  <th class="py-3 px-3.5">Health Score</th>
                  <th class="py-3 px-3.5">SEO Status</th>
                  <th class="py-3 px-3.5 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800" id="all-pages-tbody">
                {report.pages.map((p) => {
                  const hasIssues = p.issues.length > 0;
                  const slug = p.path.replace(/^\/([^\/]+)\/([^\/]+)\/?$/, '$2').replace(/\//g, '');
                  const isCore = p.type === 'core';

                  return (
                    <tr
                      class="page-row hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition"
                      data-status={hasIssues ? 'issues' : 'clean'}
                      data-name={p.name.toLowerCase()}
                      data-path={p.path.toLowerCase()}
                      data-title={p.metaTitle.toLowerCase()}
                    >
                      <td class="py-3 px-3.5 max-w-xs">
                        <div class="font-bold text-slate-900 dark:text-white truncate text-xs">
                          {p.name}
                        </div>
                        <a href={p.path} target="_blank" rel="noopener" class="font-mono text-[11px] text-blue-600 hover:underline dark:text-blue-400 truncate block">
                          {p.path} ↗
                        </a>
                      </td>
                      <td class="py-3 px-3.5">
                        <span class="rounded-md px-2 py-0.5 text-[10px] font-bold uppercase bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                          {p.category || p.type}
                        </span>
                      </td>
                      <td class="py-3 px-3.5 max-w-sm">
                        <div class="text-[11px] text-slate-800 dark:text-slate-200 line-clamp-1" title={p.metaTitle}>
                          {p.metaTitle}
                        </div>
                        <div class="text-[10px] text-slate-400 mt-0.5 font-mono">
                          {p.metaTitle.length} chars • Description: {p.metaDescription ? `${p.metaDescription.length} chars` : 'Missing'}
                        </div>
                      </td>
                      <td class="py-3 px-3.5">
                        <span
                          class={`inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[10px] font-extrabold ${
                            p.score >= 100
                              ? 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-900/60'
                              : p.score >= 90
                              ? 'bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-900/60'
                              : p.score >= 75
                              ? 'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-900/60'
                              : 'bg-red-50 text-red-700 border border-red-200 dark:bg-red-950/60 dark:text-red-300 dark:border-red-900/60'
                          }`}
                        >
                          {p.score}%
                        </span>
                      </td>
                      <td class="py-3 px-3.5">
                        {!hasIssues ? (
                          <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                            <span>✓</span> 100% Clean
                          </span>
                        ) : (
                          <div class="space-y-0.5">
                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-600 dark:text-amber-400">
                              <span>⚠️</span> {p.issues.length} {p.issues.length === 1 ? 'Opportunity' : 'Opportunities'}
                            </span>
                            <div class="text-[10px] text-slate-400 truncate max-w-45" title={p.issues.map(i => i.issue).join(', ')}>
                              {p.issues[0]?.issue}
                            </div>
                          </div>
                        )}
                      </td>
                      <td class="py-3 px-3.5 text-right">
                        <div class="flex items-center justify-end gap-1.5">
                          {!isCore && slug ? (
                            <a
                              href={`/admin/calculators/new/?edit=${encodeURIComponent(slug)}&tab=tab-seo`}
                              class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-[11px] font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 transition"
                            >
                              Edit SEO
                            </a>
                          ) : (
                            <a
                              href="/admin/seo/bulk/"
                              class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-[11px] font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 transition"
                            >
                              Bulk Meta
                            </a>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. DETECTED ISSUES VIEW (Filtered by Severity) -->
        <div id="section-view-issues" class="hidden space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Severity:</span>
              <button type="button" data-sev-filter="all" class="sev-btn active rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-3 py-1 text-xs font-bold transition cursor-pointer">All ({report.issues.length})</button>
              <button type="button" data-sev-filter="critical" class="sev-btn rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 px-3 py-1 text-xs font-bold transition cursor-pointer">Critical ({report.criticalCount})</button>
              <button type="button" data-sev-filter="high" class="sev-btn rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 px-3 py-1 text-xs font-bold transition cursor-pointer">High ({report.highCount})</button>
              <button type="button" data-sev-filter="medium" class="sev-btn rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 px-3 py-1 text-xs font-bold transition cursor-pointer">Medium ({report.mediumCount})</button>
              <button type="button" data-sev-filter="low" class="sev-btn rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 px-3 py-1 text-xs font-bold transition cursor-pointer">Low ({report.lowCount})</button>
            </div>

            <div class="relative min-w-55">
              <input
                type="text"
                id="search-audit-issues"
                placeholder="Search audit issues..."
                class="w-full rounded-xl border border-slate-300 bg-white py-1.5 px-3 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white focus:border-blue-500 focus:outline-hidden"
              />
            </div>
          </div>

          <div id="issues-container" class="space-y-3 pt-2">
            {report.issues.map((issue) => (
              <div class="issue-card rounded-2xl border border-slate-200 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-950/40" data-severity={issue.severity} data-category={issue.category}>
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class={`rounded-md px-2 py-0.5 text-[10px] font-black uppercase ${
                        issue.severity === 'critical' ? 'bg-red-600 text-white' :
                        issue.severity === 'high' ? 'bg-amber-500 text-white' :
                        issue.severity === 'medium' ? 'bg-blue-600 text-white' :
                        'bg-slate-500 text-white'
                      }`}>
                        {issue.severity}
                      </span>
                      <span class="text-xs font-extrabold text-slate-900 dark:text-white">{issue.issue}</span>
                    </div>
                    <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">{issue.reason}</p>
                    <div class="mt-2 text-[11px] font-mono text-slate-500">{issue.pagePath}</div>
                  </div>
                  <div class="sm:text-right shrink-0">
                    <div class="text-[11px] text-slate-400">Suggested Action:</div>
                    <div class="text-xs font-bold text-blue-600 dark:text-blue-400 mt-0.5">{issue.suggestedAction}</div>
                    {issue.editUrl && (
                      <a
                        href={issue.editUrl}
                        class="inline-block mt-2 rounded-lg bg-blue-50 px-2.5 py-1 text-[11px] font-bold text-blue-600 hover:bg-blue-100 dark:bg-blue-950/60 dark:text-blue-400 transition"
                      >
                        Fix Issue →
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>

  </div>

  <script is:inline>
    function initSeoDashboard() {
      // View switching (All Pages vs Issues)
      const tabViewPages = document.getElementById('tab-view-pages');
      const tabViewIssues = document.getElementById('tab-view-issues');
      const sectionPages = document.getElementById('section-view-pages');
      const sectionIssues = document.getElementById('section-view-issues');
      const viewDesc = document.getElementById('view-mode-description');

      function switchView(mode) {
        if (mode === 'pages') {
          tabViewPages?.classList.add('active', 'bg-blue-600', 'text-white');
          tabViewPages?.classList.remove('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
          tabViewIssues?.classList.remove('active', 'bg-blue-600', 'text-white');
          tabViewIssues?.classList.add('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
          sectionPages?.classList.remove('hidden');
          sectionIssues?.classList.add('hidden');
          if (viewDesc) viewDesc.textContent = 'Showing all audited live routes and real-time SEO health';
        } else {
          tabViewIssues?.classList.add('active', 'bg-blue-600', 'text-white');
          tabViewIssues?.classList.remove('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
          tabViewPages?.classList.remove('active', 'bg-blue-600', 'text-white');
          tabViewPages?.classList.add('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
          sectionPages?.classList.add('hidden');
          sectionIssues?.classList.remove('hidden');
          if (viewDesc) viewDesc.textContent = 'Showing detected SEO opportunities filtered by severity';
        }
      }

      tabViewPages?.addEventListener('click', () => switchView('pages'));
      tabViewIssues?.addEventListener('click', () => switchView('issues'));

      // All Pages filtering (All / Clean / Issues)
      const pageFilterButtons = document.querySelectorAll('.page-filter-btn');
      const searchPagesInput = document.getElementById('search-pages-input');
      let activePageFilter = 'all';

      pageFilterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          pageFilterButtons.forEach((b) => b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900'));
          btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900');
          activePageFilter = btn.getAttribute('data-page-filter') || 'all';
          filterPagesList();
        });
      });

      searchPagesInput?.addEventListener('input', () => filterPagesList());

      function filterPagesList() {
        const q = (searchPagesInput?.value || '').toLowerCase().trim();
        document.querySelectorAll('.page-row').forEach((row) => {
          const status = row.getAttribute('data-status');
          const name = row.getAttribute('data-name') || '';
          const path = row.getAttribute('data-path') || '';
          const title = row.getAttribute('data-title') || '';

          const matchesStatus =
            activePageFilter === 'all' ||
            (activePageFilter === 'clean' && status === 'clean') ||
            (activePageFilter === 'issues' && status === 'issues');

          const matchesText = !q || name.includes(q) || path.includes(q) || title.includes(q);
          row.style.display = matchesStatus && matchesText ? '' : 'none';
        });
      }

      // KPI Card Click Filter
      document.querySelectorAll('[data-kpi-filter]').forEach((kpi) => {
        kpi.addEventListener('click', () => {
          const filter = kpi.getAttribute('data-kpi-filter');
          if (filter === 'pages-all') {
            switchView('pages');
            const btn = document.querySelector('.page-filter-btn[data-page-filter="all"]');
            if (btn) btn.click();
            document.getElementById('technical-audit')?.scrollIntoView({ behavior: 'smooth' });
          } else if (filter === 'pages-clean') {
            switchView('pages');
            const btn = document.querySelector('.page-filter-btn[data-page-filter="clean"]');
            if (btn) btn.click();
            document.getElementById('technical-audit')?.scrollIntoView({ behavior: 'smooth' });
          } else {
            switchView('issues');
            const matchingBtn = document.querySelector(`.sev-btn[data-sev-filter="${filter}"]`);
            if (matchingBtn) {
              matchingBtn.click();
              document.getElementById('technical-audit')?.scrollIntoView({ behavior: 'smooth' });
            }
          }
        });
      });

      // Re-run SEO Technical Audit
      window.triggerSeoAudit = async function () {
        const btnTriggerAudit = document.getElementById('btn-trigger-audit');
        const btnTriggerIcon = document.getElementById('btn-trigger-icon');
        const btnTriggerText = document.getElementById('btn-trigger-text');
        const liveAuditStatus = document.getElementById('live-audit-status');

        if (btnTriggerAudit && btnTriggerAudit.disabled) return;
        if (btnTriggerAudit) btnTriggerAudit.disabled = true;
        if (btnTriggerIcon) {
          btnTriggerIcon.textContent = '⏳';
          btnTriggerIcon.classList.add('animate-spin');
        }
        if (btnTriggerText) btnTriggerText.textContent = 'Auditing Routes...';

        if (liveAuditStatus) {
          liveAuditStatus.className = 'rounded-2xl p-4 text-xs font-bold block bg-blue-50 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-900/60 shadow-xs flex items-center gap-2';
          liveAuditStatus.innerHTML = '<span class="text-base animate-spin">⏳</span><span>Running comprehensive SEO health audit across all pages and calculators...</span>';
        }

        try {
          const token = localStorage.getItem('admin_token');
          const res = await fetch('/api/admin/seo/audit', {
            method: 'GET',
            headers: {
              'Accept': 'application/json',
              ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
            },
            cache: 'no-store'
          });

          const data = await res.json();
          if (res.ok && data.success) {
            if (liveAuditStatus) {
              liveAuditStatus.className = 'rounded-2xl p-4 text-xs font-bold block bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/60 shadow-xs flex items-center gap-2';
              liveAuditStatus.innerHTML = '<span class="text-base">✅</span><span>SEO audit completed successfully! Refreshing dashboard...</span>';
            }
            setTimeout(() => {
              const currentUrl = new URL(window.location.href);
              currentUrl.searchParams.set('audited', '1');
              window.location.href = currentUrl.toString();
            }, 700);
          } else {
            throw new Error(data.error || 'Audit execution failed');
          }
        } catch (err) {
          if (liveAuditStatus) {
            liveAuditStatus.className = 'rounded-2xl p-4 text-xs font-bold block bg-red-50 text-red-800 dark:bg-red-950/60 dark:text-red-300 border border-red-200 dark:border-red-900/60 shadow-xs flex items-center gap-2';
            liveAuditStatus.innerHTML = '<span class="text-base">❌</span><span>Error running audit: ' + (err && err.message ? err.message : 'Unknown error') + '</span>';
          }
          if (btnTriggerAudit) btnTriggerAudit.disabled = false;
          if (btnTriggerIcon) {
            btnTriggerIcon.textContent = '⚡';
            btnTriggerIcon.classList.remove('animate-spin');
          }
          if (btnTriggerText) btnTriggerText.textContent = 'Re-run Audit';
        }
      };

      const btnTriggerAudit = document.getElementById('btn-trigger-audit');
      if (btnTriggerAudit) {
        btnTriggerAudit.addEventListener('click', window.triggerSeoAudit);
      }

      // Filter issue cards in technical audit
      const sevButtons = document.querySelectorAll('.sev-btn');
      const searchAudit = document.getElementById('search-audit-issues');
      let currentSeverity = 'all';

      sevButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          sevButtons.forEach((b) => b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900'));
          btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900');
          currentSeverity = btn.getAttribute('data-sev-filter') || 'all';
          filterAuditCards();
        });
      });

      searchAudit?.addEventListener('input', () => filterAuditCards());

      function filterAuditCards() {
        const q = (searchAudit?.value || '').toLowerCase().trim();
        document.querySelectorAll('.issue-card').forEach((card) => {
          const sev = card.getAttribute('data-severity');
          const text = card.textContent?.toLowerCase() || '';
          const matchesSev = currentSeverity === 'all' || sev === currentSeverity;
          const matchesText = !q || text.includes(q);
          card.style.display = matchesSev && matchesText ? '' : 'none';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSeoDashboard);
    } else {
      initSeoDashboard();
    }
  </script>
</AdminLayout>
