---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { runFullSEOAudit } from '../../../lib/seo/audit-engine';

const report = await runFullSEOAudit(Astro.locals);
const auditGeneratedAt = new Date(report.timestamp).toLocaleString('en-IN', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<AdminLayout title="SEO Intelligence & Health Dashboard | Calculator CMS" sectionTitle="SEO Intelligence" activeSection="seo-health" badge={`${report.criticalCount + report.highCount} Action Items`}>
  <div class="space-y-8 max-w-7xl mx-auto pb-16">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
          <span>🩺</span> SEO Intelligence Dashboard
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Rule-based metadata audit across all public pages. Results generated fresh on this page load — not stored or cached.
        </p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">
          Last Audit Run: <span class="font-mono font-semibold text-slate-600 dark:text-slate-400">{auditGeneratedAt}</span>
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="btn-trigger-audit"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer"
        >
          <span>⚡</span> Re-run Audit
        </button>
        <a
          href="/admin/seo/bulk/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition shadow-2xs"
        >
          <span>📝</span> Bulk Editor
        </a>
      </div>
    </div>

    <!-- SEO Sub-Navigation Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="/admin/seo/" class="rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs shrink-0">
        📊 Audit Overview
      </a>
      <a href="/admin/seo/bulk/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📝 Bulk Meta Editor
      </a>
      <a href="/admin/seo/duplicates/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        👯 Duplicate Content ({report.duplicates.length})
      </a>
      <a href="/admin/seo/links/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🔗 Internal Link Audit ({report.orphanPages.length} Orphans)
      </a>
      <a href="/admin/seo/sitemap-schema/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🗺️ Sitemap &amp; Schema
      </a>
      <a href="/admin/seo/history/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📜 Change History
      </a>
    </div>

    <!-- 1. Executive Health Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Pages Audited</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">{report.totalPages}</div>
        <div class="mt-1 text-[11px] font-semibold text-slate-500">All live routes</div>
      </div>

      <div class="rounded-3xl border border-emerald-200 bg-emerald-50/50 p-4 shadow-2xs dark:border-emerald-900/40 dark:bg-emerald-950/20">
        <div class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Healthy Pages</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono">{report.healthyPages}</div>
        <div class="mt-1 text-[11px] font-semibold text-emerald-700/80 dark:text-emerald-400">Zero high issues</div>
      </div>

      <div class="rounded-3xl border border-red-200 bg-red-50/60 p-4 shadow-2xs dark:border-red-900/50 dark:bg-red-950/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-red-700 dark:text-red-300">Critical</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-red-600 dark:text-red-400 font-mono">{report.criticalCount}</div>
        <div class="mt-1 text-[11px] font-semibold text-red-700/80 dark:text-red-400">Fix immediately</div>
      </div>

      <div class="rounded-3xl border border-amber-200 bg-amber-50/60 p-4 shadow-2xs dark:border-amber-900/50 dark:bg-amber-950/30">
        <div class="text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300">High Priority</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-amber-600 dark:text-amber-400 font-mono">{report.highCount}</div>
        <div class="mt-1 text-[11px] font-semibold text-amber-700/80 dark:text-amber-400">Impacting ranking</div>
      </div>

      <div class="rounded-3xl border border-blue-200 bg-blue-50/50 p-4 shadow-2xs dark:border-blue-900/40 dark:bg-blue-950/20">
        <div class="text-[10px] font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Medium Priority</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400 font-mono">{report.mediumCount}</div>
        <div class="mt-1 text-[11px] font-semibold text-blue-700/80 dark:text-blue-400">Optimization ops</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Avg Score</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">{report.overallScore}%</div>
        <div class="mt-1 text-[11px] font-semibold text-emerald-600">Site-wide health</div>
      </div>
    </div>

    <!-- 2. Transparent Audit Methodology Explanation Banner -->
    <div class="rounded-3xl border border-slate-200 bg-slate-50/70 p-5 dark:border-slate-800 dark:bg-slate-900/60 text-xs text-slate-600 dark:text-slate-300 space-y-1.5 leading-relaxed">
      <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5 text-sm">
        <span>📖</span> Rule-Based Scoring Transparency
      </div>
      <div>
        Every issue listed below is derived from explicit rules: Meta Title presence (30–65 chars), Meta Description (100–165 chars), Canonical URL integrity, Duplicate content scans, Orphan link audits, and Schema validation. Zero opaque AI scores.
      </div>
    </div>

    <!-- 3. Filter & Search Controls -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
        
        <!-- Search -->
        <div class="relative w-full sm:w-80">
          <input
            type="text"
            id="search-issues-input"
            placeholder="Search page, issue, or reason..."
            class="w-full rounded-2xl border border-slate-300 bg-white py-2 pl-9 pr-3 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:border-blue-600 focus:outline-hidden"
          />
          <span class="absolute left-3 top-2.5 text-xs text-slate-400">🔍</span>
        </div>

        <!-- Severity Filter Buttons -->
        <div class="flex items-center gap-1 overflow-x-auto pb-1 sm:pb-0" id="severity-filter-group">
          <button type="button" data-severity="all" class="sev-btn active rounded-xl bg-blue-600 px-3 py-1.5 text-xs font-bold text-white cursor-pointer transition">
            All ({report.issues.length})
          </button>
          <button type="button" data-severity="critical" class="sev-btn rounded-xl px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer transition">
            Critical ({report.criticalCount})
          </button>
          <button type="button" data-severity="high" class="sev-btn rounded-xl px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer transition">
            High ({report.highCount})
          </button>
          <button type="button" data-severity="medium" class="sev-btn rounded-xl px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer transition">
            Medium ({report.mediumCount})
          </button>
          <button type="button" data-severity="low" class="sev-btn rounded-xl px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 cursor-pointer transition">
            Low ({report.lowCount})
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs" id="cat-filter-group">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mr-1">Category:</span>
        <button type="button" data-cat="all" class="cat-btn active rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-2.5 py-1 text-[11px] font-bold cursor-pointer">
          All Issues
        </button>
        <button type="button" data-cat="title" class="cat-btn rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2.5 py-1 text-[11px] font-semibold hover:bg-slate-200 cursor-pointer">
          Titles
        </button>
        <button type="button" data-cat="description" class="cat-btn rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2.5 py-1 text-[11px] font-semibold hover:bg-slate-200 cursor-pointer">
          Descriptions
        </button>
        <button type="button" data-cat="duplicate" class="cat-btn rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2.5 py-1 text-[11px] font-semibold hover:bg-slate-200 cursor-pointer">
          Duplicates
        </button>
        <button type="button" data-cat="links" class="cat-btn rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2.5 py-1 text-[11px] font-semibold hover:bg-slate-200 cursor-pointer">
          Internal Links &amp; Orphans
        </button>
        <button type="button" data-cat="canonical" class="cat-btn rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2.5 py-1 text-[11px] font-semibold hover:bg-slate-200 cursor-pointer">
          Canonical URLs
        </button>
      </div>
    </div>

    <!-- 4. Detailed Issue Cards List -->
    <div id="issues-container" class="space-y-3">
      {report.issues.length === 0 ? (
        <div class="rounded-3xl border border-emerald-200 bg-emerald-50/40 p-12 text-center dark:border-emerald-900/50 dark:bg-emerald-950/20">
          <span class="text-4xl">🎉</span>
          <h3 class="mt-3 text-base font-bold text-emerald-900 dark:text-emerald-200">100% Optimal SEO Health</h3>
          <p class="mt-1 text-xs text-emerald-700 dark:text-emerald-300">All 42+ calculators and category hubs pass all title, description, canonical, schema, and internal linking checks.</p>
        </div>
      ) : (
        report.issues.map((item) => {
          const isCrit = item.severity === 'critical';
          const isHigh = item.severity === 'high';
          const isMed  = item.severity === 'medium';
          const isLow  = item.severity === 'low';

          return (
            <div
              class="issue-card rounded-2xl border bg-white p-5 shadow-2xs dark:bg-slate-900 transition-all hover:shadow-sm"
              data-severity={item.severity}
              data-category={item.category}
              data-type={item.pageType}
              data-search={`${item.pageName} ${item.pagePath} ${item.issue} ${item.reason} ${item.suggestedAction}`.toLowerCase()}
              class:list={[
                isCrit ? 'border-red-200 dark:border-red-900/60 bg-red-50/10' :
                isHigh ? 'border-amber-200 dark:border-amber-900/60 bg-amber-50/10' :
                isMed  ? 'border-blue-200 dark:border-blue-900/50' : 'border-slate-200 dark:border-slate-800'
              ]}
            >
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <!-- Severity Badge -->
                    {isCrit && <span class="rounded-md bg-red-100 px-2 py-0.5 text-[10px] font-black uppercase text-red-700 dark:bg-red-950 dark:text-red-300">CRITICAL</span>}
                    {isHigh && <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-black uppercase text-amber-700 dark:bg-amber-950 dark:text-amber-300">HIGH PRIORITY</span>}
                    {isMed  && <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-black uppercase text-blue-700 dark:bg-blue-950 dark:text-blue-300">MEDIUM</span>}
                    {isLow  && <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-black uppercase text-slate-600 dark:bg-slate-800 dark:text-slate-300">LOW</span>}

                    <!-- Category Pill -->
                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300 uppercase">
                      {item.category}
                    </span>

                    <span class="font-bold text-sm text-slate-900 dark:text-white">
                      {item.pageName}
                    </span>

                    <a href={item.pagePath} target="_blank" class="font-mono text-xs text-blue-600 hover:underline dark:text-blue-400 truncate">
                      {item.pagePath} ↗
                    </a>
                  </div>

                  <h4 class="font-bold text-xs text-slate-800 dark:text-slate-200 pt-0.5">
                    Issue: <span class="text-red-700 dark:text-red-300 font-semibold">{item.issue}</span>
                  </h4>

                  <div class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    <strong>Diagnosis:</strong> {item.reason}
                  </div>

                  <div class="rounded-xl bg-blue-50/60 p-2.5 text-xs text-blue-950 dark:bg-blue-950/30 dark:text-blue-200 border border-blue-100 dark:border-blue-900/40">
                    <strong>💡 Action Required:</strong> {item.suggestedAction}
                  </div>
                </div>

                <div class="shrink-0 flex sm:flex-col items-center sm:items-end gap-2">
                  {item.editUrl && (
                    <a
                      href={item.editUrl}
                      class="inline-flex items-center gap-1 rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition"
                    >
                      <span>✏️</span> Fix Issue
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })
      )}
    </div>

  </div>
</AdminLayout>

<script is:inline>
  const searchInput = document.getElementById('search-issues-input');
  const sevButtons  = document.querySelectorAll('.sev-btn');
  const catButtons  = document.querySelectorAll('.cat-btn');
  const issueCards  = document.querySelectorAll('.issue-card');

  let activeSeverity = 'all';
  let activeCategory = 'all';
  let searchQuery    = '';

  function filterCards() {
    issueCards.forEach((card) => {
      const sev = card.dataset.severity;
      const cat = card.dataset.category;
      const searchData = card.dataset.search || '';

      const matchSev = activeSeverity === 'all' || sev === activeSeverity;
      const matchCat = activeCategory === 'all' || cat === activeCategory;
      const matchSearch = !searchQuery || searchData.includes(searchQuery);

      if (matchSev && matchCat && matchSearch) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  sevButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      sevButtons.forEach((b) => {
        b.classList.remove('bg-blue-600', 'text-white', 'active');
        b.classList.add('text-slate-600', 'dark:text-slate-300');
      });
      btn.classList.add('bg-blue-600', 'text-white', 'active');
      btn.classList.remove('text-slate-600', 'dark:text-slate-300');
      activeSeverity = btn.dataset.severity || 'all';
      filterCards();
    });
  });

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => {
        b.classList.remove('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900', 'active');
        b.classList.add('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
      });
      btn.classList.add('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900', 'active');
      btn.classList.remove('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
      activeCategory = btn.dataset.cat || 'all';
      filterCards();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target.value || '').trim().toLowerCase();
    filterCards();
  });

  document.getElementById('btn-trigger-audit')?.addEventListener('click', () => {
    window.location.reload();
  });
</script>
