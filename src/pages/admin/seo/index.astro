---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { runFullSEOAudit } from '../../../lib/seo/audit-engine';
import { authenticateAdminRequest } from '../../../lib/auth';
import { syncGscPerformanceData, getGscCredentials } from '../../../lib/seo/gsc-store';
import type { GscDateRange } from '../../../lib/seo/gsc-types';

const user = await authenticateAdminRequest(Astro.request, Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/barwalaoffice/');
}

// 1. Run static rules audit (existing)
const report = await runFullSEOAudit(Astro.locals);
const auditGeneratedAt = new Date(report.timestamp).toLocaleString('en-IN', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

// Category counts
const titleCount = report.issues.filter((i) => i.category === 'title').length;
const descCount = report.issues.filter((i) => i.category === 'description').length;
const dupCount = report.issues.filter((i) => i.category === 'duplicate').length;
const linkCount = report.issues.filter((i) => i.category === 'links').length;
const canonicalCount = report.issues.filter((i) => i.category === 'canonical').length;

const auditSuccess = Astro.url.searchParams.get('audited');

// 2. Fetch GSC Snapshot
const requestedRange = (Astro.url.searchParams.get('range') || '28d') as GscDateRange;
const range: GscDateRange = requestedRange === '7d' || requestedRange === '3m' ? requestedRange : '28d';

const gscSnapshot = await syncGscPerformanceData(Astro.locals, range, false);
const isGscConnected = gscSnapshot.status === 'connected';
const gscData = gscSnapshot.data?.[range];

const lastGscSyncFormatted = gscSnapshot.lastSyncedAt
  ? new Date(gscSnapshot.lastSyncedAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })
  : 'Never';

// Top growing pages
const topGrowingPages = (gscData?.topPages || [])
  .filter((p) => p.clickChangePercent > 10 && p.clicks >= 5)
  .sort((a, b) => b.clickChangePercent - a.clickChangePercent)
  .slice(0, 4);

// Needs attention pages (high impressions, low CTR, or dropped rank)
const needsAttentionPages = (gscData?.topPages || [])
  .filter((p) => (p.impressions > 200 && p.ctr < 2.5) || p.positionChange > 2)
  .slice(0, 4);
---

<AdminLayout title="SEO Intelligence & Health Dashboard | Calculator CMS" sectionTitle="SEO Intelligence" activeSection="seo" badge={`${report.criticalCount + report.highCount} Action Items`}>
  <div class="space-y-8 max-w-7xl mx-auto pb-16">
    
    
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
          <span>🩺</span> SEO Intelligence Dashboard
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Google Search Console performance metrics, opportunity finder, content decay detection, and technical health audit.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button
          type="button"
          id="btn-sync-gsc"
          class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 px-3.5 py-2 text-xs font-bold text-white shadow-sm shadow-emerald-500/20 hover:bg-emerald-700 transition cursor-pointer"
        >
          <span id="btn-sync-gsc-icon">🔄</span>
          <span id="btn-sync-gsc-text">Sync GSC Data</span>
        </button>

        <button
          type="button"
          id="btn-open-gsc-modal"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition shadow-2xs cursor-pointer"
        >
          <span>⚙️</span> GSC Setup
        </button>

        <button
          type="button"
          id="btn-trigger-audit"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer"
        >
          <span id="btn-trigger-icon">⚡</span>
          <span id="btn-trigger-text">Re-run Audit</span>
        </button>

        <a
          href="/admin/seo/bulk/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition shadow-2xs"
        >
          <span>📝</span> Bulk Editor
        </a>
      </div>
    </div>

    
    <div id="live-audit-status" class="hidden rounded-2xl p-4 text-xs font-bold shadow-xs"></div>

    {auditSuccess && (
      <div id="audit-success-banner" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-xs font-bold text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/60 dark:text-emerald-300 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <span class="text-base">✅</span>
          <span>Fresh SEO Audit completed successfully! Scanned all {report.totalPages} live routes ({report.issues.length} active issue items).</span>
        </div>
        <a href="/admin/seo/" class="text-emerald-700 dark:text-emerald-400 hover:underline text-[11px] shrink-0">Dismiss ✕</a>
      </div>
    )}

    
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="#gsc-performance" class="rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs shrink-0">
        📈 GSC Performance &amp; Ops
      </a>
      <a href="#technical-audit" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🩺 Technical Health Audit ({report.issues.length})
      </a>
      <a href="/admin/seo/bulk/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📝 Bulk Meta Editor
      </a>
      <a href="/admin/seo/duplicates/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        👯 Duplicate Content ({report.duplicates.length})
      </a>
      <a href="/admin/seo/links/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🔗 Internal Links ({report.orphanPages.length} Orphans)
      </a>
      <a href="/admin/seo/sitemap-schema/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🗺️ Sitemap &amp; Schema
      </a>
      <a href="/admin/seo/history/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📜 Change History
      </a>
    </div>

    
    
    
    <div id="gsc-performance" class="space-y-6">
      
      
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center gap-3">
          <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl text-lg ${
            isGscConnected ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400' : 'bg-slate-100 text-slate-400 dark:bg-slate-800'
          }`}>
            {isGscConnected ? '🟢' : '⚪'}
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-slate-900 dark:text-white">
                Google Search Console
              </span>
              <span class={`rounded-full px-2.5 py-0.5 text-[10px] font-bold ${
                isGscConnected ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400'
              }`}>
                {isGscConnected ? 'Connected' : 'Not Connected'}
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Property: <strong class="text-slate-700 dark:text-slate-300">{gscSnapshot.propertyUrl}</strong> • Last Synced: <strong class="text-slate-700 dark:text-slate-300">{lastGscSyncFormatted}</strong>
            </p>
          </div>
        </div>

        
        <div class="flex items-center gap-2 self-start md:self-center">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Range:</span>
          <div class="inline-flex rounded-xl bg-slate-100 p-1 dark:bg-slate-800">
            <a
              href="?range=7d"
              class={`rounded-lg px-3 py-1 text-xs font-bold transition ${
                range === '7d'
                  ? 'bg-white text-blue-600 shadow-xs dark:bg-slate-900 dark:text-blue-400'
                  : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white'
              }`}
            >
              7 Days
            </a>
            <a
              href="?range=28d"
              class={`rounded-lg px-3 py-1 text-xs font-bold transition ${
                range === '28d'
                  ? 'bg-white text-blue-600 shadow-xs dark:bg-slate-900 dark:text-blue-400'
                  : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white'
              }`}
            >
              28 Days
            </a>
            <a
              href="?range=3m"
              class={`rounded-lg px-3 py-1 text-xs font-bold transition ${
                range === '3m'
                  ? 'bg-white text-blue-600 shadow-xs dark:bg-slate-900 dark:text-blue-400'
                  : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white'
              }`}
            >
              3 Months
            </a>
          </div>
        </div>
      </div>

      {!isGscConnected && (
        <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50/60 p-8 sm:p-12 text-center dark:border-slate-800 dark:bg-slate-900/30 space-y-4">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl dark:bg-blue-950/60">
            📈
          </div>
          <div class="max-w-xl mx-auto">
            <h3 class="text-lg font-extrabold text-slate-900 dark:text-white">
              Connect Google Search Console Property
            </h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-1.5 leading-relaxed">
              Connect your Google Service Account to unlock real search metrics, automated content decay detection, striking distance keyword opportunities, and calculator ranking diagnostics.
            </p>
          </div>
          <div class="pt-2 flex flex-wrap justify-center gap-3">
            <button
              type="button"
              onclick="document.getElementById('modal-gsc-config')?.classList.remove('hidden')"
              class="rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-sm shadow-blue-500/25 hover:bg-blue-700 transition cursor-pointer"
            >
              Connect Google Search Console →
            </button>
          </div>
        </div>
      )}

      {isGscConnected && (
        <div class="space-y-8">
          
          
          {gscData?.performance && (
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
              
              
              <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Search Clicks</div>
                <div class="mt-2 flex items-baseline gap-2">
                  <span class="text-3xl font-black text-slate-900 dark:text-white font-mono">
                    {gscData.performance.currentPeriod.summary.clicks.toLocaleString()}
                  </span>
                  <span class={`text-xs font-bold ${gscData.performance.deltas.clicks.isPositive ? 'text-emerald-600' : 'text-red-600'}`}>
                    {gscData.performance.deltas.clicks.isPositive ? '↑' : '↓'} {Math.abs(gscData.performance.deltas.clicks.percentageChange)}%
                  </span>
                </div>
                <div class="mt-1 text-[11px] text-slate-400">
                  Prev: {gscData.performance.previousPeriod.summary.clicks.toLocaleString()} clicks
                </div>
              </div>

              
              <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Impressions</div>
                <div class="mt-2 flex items-baseline gap-2">
                  <span class="text-3xl font-black text-slate-900 dark:text-white font-mono">
                    {gscData.performance.currentPeriod.summary.impressions.toLocaleString()}
                  </span>
                  <span class={`text-xs font-bold ${gscData.performance.deltas.impressions.isPositive ? 'text-emerald-600' : 'text-red-600'}`}>
                    {gscData.performance.deltas.impressions.isPositive ? '↑' : '↓'} {Math.abs(gscData.performance.deltas.impressions.percentageChange)}%
                  </span>
                </div>
                <div class="mt-1 text-[11px] text-slate-400">
                  Prev: {gscData.performance.previousPeriod.summary.impressions.toLocaleString()} impressions
                </div>
              </div>

              
              <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Average CTR</div>
                <div class="mt-2 flex items-baseline gap-2">
                  <span class="text-3xl font-black text-slate-900 dark:text-white font-mono">
                    {gscData.performance.currentPeriod.summary.ctr}%
                  </span>
                  <span class={`text-xs font-bold ${gscData.performance.deltas.ctr.isPositive ? 'text-emerald-600' : 'text-amber-600'}`}>
                    {gscData.performance.deltas.ctr.isPositive ? '↑' : '↓'} {Math.abs(gscData.performance.deltas.ctr.delta)}%
                  </span>
                </div>
                <div class="mt-1 text-[11px] text-slate-400">
                  Prev: {gscData.performance.previousPeriod.summary.ctr}%
                </div>
              </div>

              
              <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Average Position</div>
                <div class="mt-2 flex items-baseline gap-2">
                  <span class="text-3xl font-black text-slate-900 dark:text-white font-mono">
                    {gscData.performance.currentPeriod.summary.position.toFixed(1)}
                  </span>
                  <span class={`text-xs font-bold ${gscData.performance.deltas.position.isPositive ? 'text-emerald-600' : 'text-red-600'}`}>
                    {gscData.performance.deltas.position.isPositive ? '↑' : '↓'} {Math.abs(gscData.performance.deltas.position.delta).toFixed(1)} spots
                  </span>
                </div>
                <div class="mt-1 text-[11px] text-slate-400">
                  Prev: {gscData.performance.previousPeriod.summary.position.toFixed(1)}
                </div>
              </div>

            </div>
          )}

          
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
                  <span>🚀</span> Top SEO Opportunities ({gscData?.opportunities?.length || 0})
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                  Actionable striking-distance keywords, low-CTR page 1 queries, and high-impression pages.
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {(!gscData?.opportunities || gscData.opportunities.length === 0) ? (
                <div class="col-span-full rounded-3xl border border-slate-200 bg-white p-8 text-center text-xs text-slate-400 dark:border-slate-800 dark:bg-slate-900">
                  No high-confidence opportunities detected in this timeframe. Check back as search impressions accumulate.
                </div>
              ) : (
                gscData.opportunities.slice(0, 6).map((opp) => (
                  <div class="rounded-3xl border border-blue-200/70 bg-white p-5 shadow-xs dark:border-blue-950 dark:bg-slate-900 flex flex-col justify-between hover:shadow-md transition">
                    <div>
                      <div class="flex items-center justify-between gap-2">
                        <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[10px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300 border border-blue-200/50 dark:border-blue-900">
                          {opp.type === 'position' ? 'Striking Distance' : opp.type === 'ctr' ? 'Low CTR' : 'Page 1 Potential'}
                        </span>
                        <span class="font-mono text-xs font-bold text-emerald-600">
                          Score: {opp.opportunityScore}/100
                        </span>
                      </div>

                      <div class="mt-3 flex items-center gap-2">
                        <span class="text-lg">{opp.icon || '🧮'}</span>
                        <h4 class="text-xs font-extrabold text-slate-900 dark:text-white truncate">
                          {opp.calculatorName}
                        </h4>
                      </div>

                      {opp.query && (
                        <div class="mt-1 text-xs font-bold text-blue-600 dark:text-blue-400 font-mono">
                          "{opp.query}"
                        </div>
                      )}

                      <div class="mt-3 grid grid-cols-3 gap-2 text-center rounded-2xl bg-slate-50 p-2 text-slate-700 dark:bg-slate-800/60 dark:text-slate-300 text-[11px] font-mono">
                        <div>
                          <span class="text-[9px] block text-slate-400 uppercase">Pos</span>
                          <strong>#{opp.currentPosition.toFixed(1)}</strong>
                        </div>
                        <div>
                          <span class="text-[9px] block text-slate-400 uppercase">Impr</span>
                          <strong>{opp.impressions.toLocaleString()}</strong>
                        </div>
                        <div>
                          <span class="text-[9px] block text-slate-400 uppercase">CTR</span>
                          <strong>{opp.ctr}%</strong>
                        </div>
                      </div>

                      <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                        {opp.reason}
                      </p>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                      <span class="text-[11px] text-slate-400 font-medium truncate max-w-45">
                        {opp.recommendedAction}
                      </span>
                      {opp.calculatorSlug ? (
                        <a
                          href={`/admin/seo/${opp.calculatorSlug}/?range=${range}`}
                          class="rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700 hover:bg-blue-100 dark:bg-blue-950 dark:text-blue-300 shrink-0 transition"
                        >
                          View Details →
                        </a>
                      ) : (
                        <a
                          href={opp.pageUrl}
                          target="_blank"
                          class="text-xs text-blue-600 hover:underline shrink-0"
                        >
                          Visit ↗
                        </a>
                      )}
                    </div>
                  </div>
                ))
              )}
            </div>
          </div>

          
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
                  <span>📉</span> Content Decay Detection ({gscData?.decayAlerts?.length || 0})
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                  Pages with meaningful traffic decline or ranking drops requiring immediate content refreshment.
                </p>
              </div>
            </div>

            {(!gscData?.decayAlerts || gscData.decayAlerts.length === 0) ? (
              <div class="rounded-3xl border border-emerald-200 bg-emerald-50/50 p-6 text-center text-xs font-semibold text-emerald-800 dark:border-emerald-900/40 dark:bg-emerald-950/20 dark:text-emerald-300">
                ✅ Zero content decay alerts detected! All active pages maintained or grew traffic across comparison periods.
              </div>
            ) : (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {gscData.decayAlerts.map((decay) => (
                  <div class="rounded-3xl border border-red-200 bg-red-50/40 p-5 shadow-xs dark:border-red-900/50 dark:bg-red-950/20 flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <span class="text-lg">{decay.icon || '🧮'}</span>
                          <h4 class="text-sm font-extrabold text-slate-900 dark:text-white">
                            {decay.calculatorName}
                          </h4>
                        </div>
                        <span class={`rounded-full px-2.5 py-0.5 text-[10px] font-black uppercase ${
                          decay.priority === 'critical' ? 'bg-red-600 text-white animate-pulse' :
                          decay.priority === 'high' ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200' :
                          'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200'
                        }`}>
                          {decay.priority}
                        </span>
                      </div>

                      <div class="mt-3 flex items-center gap-4 text-xs font-mono">
                        <div>
                          <span class="text-slate-400 block text-[10px] uppercase">Traffic Drop</span>
                          <strong class="text-red-600 text-sm">↓ {decay.trafficDeclinePercent}%</strong>
                        </div>
                        <div>
                          <span class="text-slate-400 block text-[10px] uppercase">Clicks Shift</span>
                          <span class="text-slate-700 dark:text-slate-300">{decay.previousClicks} → {decay.currentClicks}</span>
                        </div>
                        <div>
                          <span class="text-slate-400 block text-[10px] uppercase">Position</span>
                          <span class="text-slate-700 dark:text-slate-300">#{decay.previousPosition.toFixed(1)} → #{decay.currentPosition.toFixed(1)}</span>
                        </div>
                      </div>

                      <p class="mt-3 text-xs text-slate-600 dark:text-slate-400">
                        {decay.explanation}
                      </p>
                    </div>

                    <div class="mt-4 pt-3 border-t border-red-100 dark:border-red-950 flex items-center justify-between">
                      <span class="text-[11px] text-slate-500 truncate max-w-60">
                        • {decay.recommendedFixes[0]}
                      </span>
                      {decay.calculatorSlug && (
                        <a
                          href={`/admin/seo/${decay.calculatorSlug}/?range=${range}`}
                          class="rounded-lg bg-red-100 px-3 py-1 text-xs font-bold text-red-800 hover:bg-red-200 dark:bg-red-950 dark:text-red-200 transition"
                        >
                          Review &amp; Fix →
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            
            <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3">
