---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { runFullSEOAudit } from '../../../lib/seo/audit-engine';
import { authenticateAdminRequest } from '../../../lib/auth';

const user = await authenticateAdminRequest(Astro.request, Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/barwalaoffice/');
}

const report = await runFullSEOAudit(Astro.locals);
const auditGeneratedAt = new Date(report.timestamp).toLocaleString('en-IN', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

// Category counts
const titleCount = report.issues.filter((i) => i.category === 'title').length;
const descCount = report.issues.filter((i) => i.category === 'description').length;
const dupCount = report.issues.filter((i) => i.category === 'duplicate').length;
const linkCount = report.issues.filter((i) => i.category === 'links').length;
const canonicalCount = report.issues.filter((i) => i.category === 'canonical').length;

const auditSuccess = Astro.url.searchParams.get('audited');
---

<AdminLayout title="SEO Intelligence & Health Dashboard | Calculator CMS" sectionTitle="SEO Intelligence" activeSection="seo-health" badge={`${report.criticalCount + report.highCount} Action Items`}>
  <div class="space-y-8 max-w-7xl mx-auto pb-16">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
          <span>🩺</span> SEO Intelligence Dashboard
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Rule-based metadata audit across all public pages. Results generated fresh on this page load — not stored or cached.
        </p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">
          Last Audit Run: <span id="audit-timestamp-label" class="font-mono font-semibold text-slate-600 dark:text-slate-400">{auditGeneratedAt}</span>
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="btn-trigger-audit"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer"
        >
          <span id="btn-trigger-icon">⚡</span>
          <span id="btn-trigger-text">Re-run Audit</span>
        </button>
        <a
          href="/admin/seo/bulk/"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition shadow-2xs"
        >
          <span>📝</span> Bulk Editor
        </a>
      </div>
    </div>

    <!-- Live Audit In-Progress / Success Notification Container -->
    <div id="live-audit-status" class="hidden rounded-2xl p-4 text-xs font-bold shadow-xs"></div>

    <!-- Persistent Audit Success Notice (after reload) -->
    {auditSuccess && (
      <div id="audit-success-banner" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-xs font-bold text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/60 dark:text-emerald-300 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <span class="text-base">✅</span>
          <span>Fresh SEO Audit completed successfully just now! Scanned all {report.totalPages} live routes ({report.issues.length} active issue items).</span>
        </div>
        <a href="/admin/seo/" class="text-emerald-700 dark:text-emerald-400 hover:underline text-[11px] shrink-0">Dismiss ✕</a>
      </div>
    )}

    <!-- SEO Sub-Navigation Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="/admin/seo/" class="rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs shrink-0">
        📊 Audit Overview
      </a>
      <a href="/admin/seo/bulk/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📝 Bulk Meta Editor
      </a>
      <a href="/admin/seo/duplicates/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        👯 Duplicate Content ({report.duplicates.length})
      </a>
      <a href="/admin/seo/links/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🔗 Internal Link Audit ({report.orphanPages.length} Orphans)
      </a>
      <a href="/admin/seo/sitemap-schema/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🗺️ Sitemap &amp; Schema
      </a>
      <a href="/admin/seo/history/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📜 Change History
      </a>
    </div>

    <!-- 1. Executive Health Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      <div data-kpi-filter="all" class="cursor-pointer rounded-3xl border border-slate-200 bg-white p-4 shadow-2xs hover:shadow-md hover:border-blue-400 transition-all dark:border-slate-800 dark:bg-slate-900" title="Click to show all issues">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Pages Audited</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">{report.totalPages}</div>
        <div class="mt-1 text-[11px] font-semibold text-slate-500">All live routes</div>
      </div>

      <div class="rounded-3xl border border-emerald-200 bg-emerald-50/50 p-4 shadow-2xs dark:border-emerald-900/40 dark:bg-emerald-950/20">
        <div class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Healthy Pages</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono">{report.healthyPages}</div>
        <div class="mt-1 text-[11px] font-semibold text-emerald-700/80 dark:text-emerald-400">Zero high issues</div>
      </div>

      <div data-kpi-filter="critical" class="cursor-pointer rounded-3xl border border-red-200 bg-red-50/60 p-4 shadow-2xs hover:shadow-md hover:border-red-400 transition-all dark:border-red-900/50 dark:bg-red-950/30" title="Click to filter Critical issues">
        <div class="text-[10px] font-bold uppercase tracking-wider text-red-700 dark:text-red-300">Critical</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-red-600 dark:text-red-400 font-mono">{report.criticalCount}</div>
        <div class="mt-1 text-[11px] font-semibold text-red-700/80 dark:text-red-400">Fix immediately</div>
      </div>

      <div data-kpi-filter="high" class="cursor-pointer rounded-3xl border border-amber-200 bg-amber-50/60 p-4 shadow-2xs hover:shadow-md hover:border-amber-400 transition-all dark:border-amber-900/50 dark:bg-amber-950/30" title="Click to filter High Priority issues">
        <div class="text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300">High Priority</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-amber-600 dark:text-amber-400 font-mono">{report.highCount}</div>
        <div class="mt-1 text-[11px] font-semibold text-amber-700/80 dark:text-amber-400">Impacting ranking</div>
      </div>

      <div data-kpi-filter="medium" class="cursor-pointer rounded-3xl border border-blue-200 bg-blue-50/50 p-4 shadow-2xs hover:shadow-md hover:border-blue-400 transition-all dark:border-blue-900/40 dark:bg-blue-950/20" title="Click to filter Medium Priority issues">
        <div class="text-[10px] font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Medium Priority</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400 font-mono">{report.mediumCount}</div>
        <div class="mt-1 text-[11px] font-semibold text-blue-700/80 dark:text-blue-400">Optimization ops</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Avg Score</div>
        <div class="mt-1 text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">{report.overallScore}%</div>
        <div class="mt-1 text-[11px] font-semibold text-emerald-600">Site-wide health</div>
      </div>
    </div>

    <!-- 2. Transparent Audit Methodology Explanation Banner -->
    <div class="rounded-3xl border border-slate-200 bg-slate-50/70 p-5 dark:border-slate-800 dark:bg-slate-900/60 text-xs text-slate-600 dark:text-slate-300 space-y-1.5 leading-relaxed">
      <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5 text-sm">
        <span>📖</span> Rule-Based Scoring Transparency
      </div>
      <div>
        Every issue listed below is derived from explicit rules: Meta Title presence (30–65 chars), Meta Description (100–165 chars), Canonical URL integrity, Duplicate content scans, Orphan link audits, and Schema validation. Zero opaque AI scores.
      </div>
    </div>

    <!-- 3. Filter & Search Controls -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
        
        <!-- Search -->
        <div class="relative w-full sm:w-80">
          <input
            type="text"
            id="search-issues-input"
            placeholder="Search page, issue, or reason..."
            class="w-full rounded-2xl border border-slate-300 bg-white py-2 pl-9 pr-3 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:border-blue-600 focus:outline-hidden"
          />
          <span class="absolute left-3 top-2.5 text-xs text-slate-400">🔍</span>
        </div>

        <!-- Severity Filter Buttons -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0" id="severity-filter-group">
          <button
            type="button"
            data-severity="all"
            class="sev-btn active rounded-xl bg-blue-600 px-3 py-1.5 text-xs font-bold text-white shadow-xs transition-colors cursor-pointer"
          >
            All ({report.issues.length})
          </button>
          <button
            type="button"
            data-severity="critical"
            class="sev-btn rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer"
          >
            Critical ({report.criticalCount})
          </button>
          <button
            type="button"
            data-severity="high"
            class="sev-btn rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer"
          >
            High ({report.highCount})
          </button>
          <button
            type="button"
            data-severity="medium"
            class="sev-btn rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer"
          >
            Medium ({report.mediumCount})
          </button>
          <button
            type="button"
            data-severity="low"
            class="sev-btn rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer"
          >
            Low ({report.lowCount})
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs" id="cat-filter-group">
        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mr-1">Category:</span>
        <button
          type="button"
          data-cat="all"
          class="cat-btn active rounded-lg bg-blue-600 px-3 py-1 text-[11px] font-bold text-white shadow-xs transition-colors cursor-pointer"
        >
          All Issues ({report.issues.length})
        </button>
        <button
          type="button"
          data-cat="title"
          class="cat-btn rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1 text-[11px] font-semibold transition-colors cursor-pointer"
        >
          Titles ({titleCount})
        </button>
        <button
          type="button"
          data-cat="description"
          class="cat-btn rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1 text-[11px] font-semibold transition-colors cursor-pointer"
        >
          Descriptions ({descCount})
        </button>
        <button
          type="button"
          data-cat="duplicate"
          class="cat-btn rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1 text-[11px] font-semibold transition-colors cursor-pointer"
        >
          Duplicates ({dupCount})
        </button>
        <button
          type="button"
          data-cat="links"
          class="cat-btn rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1 text-[11px] font-semibold transition-colors cursor-pointer"
        >
          Internal Links &amp; Orphans ({linkCount})
        </button>
        <button
          type="button"
          data-cat="canonical"
          class="cat-btn rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1 text-[11px] font-semibold transition-colors cursor-pointer"
        >
          Canonical URLs ({canonicalCount})
        </button>
      </div>
    </div>

    <!-- 4. Detailed Issue Cards List -->
    <div id="issues-container" class="space-y-3">
      {report.issues.length === 0 ? (
        <div class="rounded-3xl border border-emerald-200 bg-emerald-50/40 p-12 text-center dark:border-emerald-900/50 dark:bg-emerald-950/20">
          <span class="text-4xl">🎉</span>
          <h3 class="mt-3 text-base font-bold text-emerald-900 dark:text-emerald-200">100% Optimal SEO Health</h3>
          <p class="mt-1 text-xs text-emerald-700 dark:text-emerald-300">All 42+ calculators and category hubs pass all title, description, canonical, schema, and internal linking checks.</p>
        </div>
      ) : (
        report.issues.map((item) => {
          const isCrit = item.severity === 'critical';
          const isHigh = item.severity === 'high';
          const isMed  = item.severity === 'medium';
          const isLow  = item.severity === 'low';

          return (
            <div
              class="issue-card rounded-2xl border bg-white p-5 shadow-2xs dark:bg-slate-900 transition-all hover:shadow-sm"
              data-severity={item.severity}
              data-category={item.category}
              data-type={item.pageType}
              data-search={`${item.pageName} ${item.pagePath} ${item.issue} ${item.reason} ${item.suggestedAction}`.toLowerCase()}
              class:list={[
                isCrit ? 'border-red-200 dark:border-red-900/60 bg-red-50/10' :
                isHigh ? 'border-amber-200 dark:border-amber-900/60 bg-amber-50/10' :
                isMed  ? 'border-blue-200 dark:border-blue-900/50' : 'border-slate-200 dark:border-slate-800'
              ]}
            >
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <!-- Severity Badge -->
                    {isCrit && <span class="rounded-md bg-red-100 px-2 py-0.5 text-[10px] font-black uppercase text-red-700 dark:bg-red-950 dark:text-red-300">CRITICAL</span>}
                    {isHigh && <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-black uppercase text-amber-700 dark:bg-amber-950 dark:text-amber-300">HIGH PRIORITY</span>}
                    {isMed  && <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[10px] font-black uppercase text-blue-700 dark:bg-blue-950 dark:text-blue-300">MEDIUM</span>}
                    {isLow  && <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-black uppercase text-slate-600 dark:bg-slate-800 dark:text-slate-300">LOW</span>}

                    <!-- Category Pill -->
                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300 uppercase">
                      {item.category}
                    </span>

                    <span class="font-bold text-sm text-slate-900 dark:text-white">
                      {item.pageName}
                    </span>

                    <a href={item.pagePath} target="_blank" class="font-mono text-xs text-blue-600 hover:underline dark:text-blue-400 truncate">
                      {item.pagePath} ↗
                    </a>
                  </div>

                  <h4 class="font-bold text-xs text-slate-800 dark:text-slate-200 pt-0.5">
                    Issue: <span class="text-red-700 dark:text-red-300 font-semibold">{item.issue}</span>
                  </h4>

                  <div class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    <strong>Diagnosis:</strong> {item.reason}
                  </div>

                  <div class="rounded-xl bg-blue-50/60 p-2.5 text-xs text-blue-950 dark:bg-blue-950/30 dark:text-blue-200 border border-blue-100 dark:border-blue-900/40">
                    <strong>💡 Action Required:</strong> {item.suggestedAction}
                  </div>
                </div>

                <div class="shrink-0 flex sm:flex-col items-center sm:items-end gap-2">
                  {item.editUrl && (
                    <a
                      href={item.editUrl}
                      class="inline-flex items-center gap-1 rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition"
                    >
                      <span>✏️</span> Fix Issue
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })
      )}
    </div>

    <!-- Empty State When Filters Yield 0 Matches -->
    <div
      id="no-filter-matches"
      style="display: none;"
      class="rounded-3xl border border-dashed border-slate-300 bg-white/50 p-10 text-center dark:border-slate-800 dark:bg-slate-900/50"
    >
      <div class="text-3xl mb-2">🎯</div>
      <h4 class="text-sm font-bold text-slate-900 dark:text-white">No Issues Match Active Filter</h4>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-md mx-auto">
        There are zero issues under this specific category or severity filter.
      </p>
      <button
        type="button"
        id="btn-reset-filters"
        class="mt-4 inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs hover:bg-blue-700 transition cursor-pointer"
      >
        <span>↺</span> Reset All Filters
      </button>
    </div>

  </div>

  <!-- Page Controller Script moved INSIDE AdminLayout -->
  <script is:inline>
    function initSeoDashboard() {
      const searchInput = document.getElementById('search-issues-input');
      const sevButtons  = document.querySelectorAll('.sev-btn');
      const catButtons  = document.querySelectorAll('.cat-btn');
      const emptyFilterBox = document.getElementById('no-filter-matches');
      const btnTriggerAudit = document.getElementById('btn-trigger-audit');
      const btnTriggerIcon = document.getElementById('btn-trigger-icon');
      const btnTriggerText = document.getElementById('btn-trigger-text');
      const btnResetFilters = document.getElementById('btn-reset-filters');
      const liveStatus = document.getElementById('live-audit-status');

      let activeSeverity = 'all';
      let activeCategory = 'all';
      let searchQuery    = '';

      function filterCards() {
        let visibleCount = 0;
        const cards = document.querySelectorAll('.issue-card');
        
        cards.forEach((card) => {
          const sev = card.getAttribute('data-severity') || '';
          const cat = card.getAttribute('data-category') || '';
          const searchData = card.getAttribute('data-search') || '';

          const matchSev = activeSeverity === 'all' || sev === activeSeverity;
          const matchCat = activeCategory === 'all' || cat === activeCategory;
          const matchSearch = !searchQuery || searchData.includes(searchQuery);

          if (matchSev && matchCat && matchSearch) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (emptyFilterBox) {
          emptyFilterBox.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
        }
      }

      function updateSevButtons(targetSev) {
        activeSeverity = targetSev;
        sevButtons.forEach((b) => {
          const isMatch = (b.getAttribute('data-severity') || '') === targetSev;
          if (isMatch) {
            b.className = 'sev-btn active rounded-xl bg-blue-600 px-3 py-1.5 text-xs font-bold text-white shadow-xs transition-colors cursor-pointer';
          } else {
            b.className = 'sev-btn rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer';
          }
        });
      }

      function updateCatButtons(targetCat) {
        activeCategory = targetCat;
        catButtons.forEach((b) => {
          const isMatch = (b.getAttribute('data-cat') || '') === targetCat;
          if (isMatch) {
            b.className = 'cat-btn active rounded-lg bg-blue-600 px-3 py-1 text-[11px] font-bold text-white shadow-xs transition-colors cursor-pointer';
          } else {
            b.className = 'cat-btn rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 px-3 py-1 text-[11px] font-semibold transition-colors cursor-pointer';
          }
        });
      }

      // Severity Buttons Click Listeners
      sevButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const sev = btn.getAttribute('data-severity') || 'all';
          updateSevButtons(sev);
          updateCatButtons('all');
          filterCards();
        });
      });

      // Category Buttons Click Listeners
      catButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const cat = btn.getAttribute('data-cat') || 'all';
          updateCatButtons(cat);
          updateSevButtons('all');
          filterCards();
        });
      });

      // Executive Health Metric KPI Cards
      document.querySelectorAll('[data-kpi-filter]').forEach((card) => {
        card.addEventListener('click', () => {
          const targetSev = card.getAttribute('data-kpi-filter');
          if (!targetSev) return;
          updateSevButtons(targetSev);
          updateCatButtons('all');
          filterCards();
        });
      });

      // Search Input
      searchInput?.addEventListener('input', (e) => {
        searchQuery = (e.target.value || '').trim().toLowerCase();
        filterCards();
      });

      // Reset All Filters
      btnResetFilters?.addEventListener('click', () => {
        updateSevButtons('all');
        updateCatButtons('all');
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        filterCards();
      });

      // Re-run Audit Button with Live Visual Feedback
      if (btnTriggerAudit) {
        btnTriggerAudit.addEventListener('click', async () => {
          if (btnTriggerAudit.disabled) return;
          btnTriggerAudit.disabled = true;
          btnTriggerAudit.classList.add('opacity-75', 'cursor-wait');
          if (btnTriggerIcon) btnTriggerIcon.textContent = '⏳';
          if (btnTriggerText) btnTriggerText.textContent = 'Running Fresh Audit...';

          if (liveStatus) {
            liveStatus.className = 'rounded-2xl border border-blue-200 bg-blue-50 text-blue-900 dark:border-blue-900/60 dark:bg-blue-950/60 dark:text-blue-200 p-4 text-xs font-bold block shadow-xs animate-pulse';
            liveStatus.innerHTML = '<span>⚡ Executing comprehensive SEO rules audit across all 42+ calculators, canonicals, descriptions, titles, and orphan links...</span>';
          }

          try {
            const token = localStorage.getItem('admin_token') || '';
            const res = await fetch('/api/admin/seo/audit?t=' + Date.now(), {
              method: 'GET',
              credentials: 'include',
              headers: {
                ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
              },
            });

            if (res.ok) {
              const data = await res.json();
              if (btnTriggerIcon) btnTriggerIcon.textContent = '✓';
              if (btnTriggerText) btnTriggerText.textContent = 'Audit Complete!';

              if (liveStatus) {
                liveStatus.className = 'rounded-2xl border border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-900/60 dark:bg-emerald-950/60 dark:text-emerald-200 p-4 text-xs font-bold block shadow-xs';
                liveStatus.innerHTML = `<span>✅ SEO Audit Finished! Scanned ${data.report?.totalPages || 42} pages. Found ${data.report?.issues?.length || 0} issues. Reloading dashboard with updated analysis...</span>`;
              }

              setTimeout(() => {
                window.location.href = '/admin/seo/?audited=1&t=' + Date.now();
              }, 700);
            } else {
              const data = await res.json().catch(() => ({}));
              alert(data.error || 'Failed to re-run audit. Please verify admin session.');
              btnTriggerAudit.disabled = false;
              btnTriggerAudit.classList.remove('opacity-75', 'cursor-wait');
              if (btnTriggerIcon) btnTriggerIcon.textContent = '⚡';
              if (btnTriggerText) btnTriggerText.textContent = 'Re-run Audit';
              if (liveStatus) liveStatus.className = 'hidden';
            }
          } catch (err) {
            alert('Network connection error while running audit. Refreshing page...');
            window.location.reload();
          }
        });
      }

      // Read initial URL query parameters if present (e.g. ?severity=critical or ?category=title)
      try {
        const qParams = new URLSearchParams(window.location.search);
        const qSev = qParams.get('severity');
        const qCat = qParams.get('category');
        if (qSev) updateSevButtons(qSev);
        if (qCat) updateCatButtons(qCat);
        if (qSev || qCat) filterCards();
      } catch (e) {}
    }

    // Execute immediately and on DOMContentLoaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSeoDashboard);
    } else {
      initSeoDashboard();
    }
  </script>
</AdminLayout>

