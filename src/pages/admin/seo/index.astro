  <script is:inline>
    function initGscDashboard() {
      // 1. Search Filter for Top Pages Table
      const searchPages = document.getElementById('search-gsc-pages');
      if (searchPages) {
        searchPages.addEventListener('input', (e) => {
          const q = (e.target.value || '').toLowerCase().trim();
          document.querySelectorAll('.page-table-row').forEach((row) => {
            const text = row.querySelector('.page-row-title')?.textContent?.toLowerCase() || '';
            const path = row.querySelector('.font-mono')?.textContent?.toLowerCase() || '';
            row.style.display = (text.includes(q) || path.includes(q)) ? '' : 'none';
          });
        });
      }

      // 2. Search Filter for Top Queries Table
      const searchQueries = document.getElementById('search-gsc-queries');
      if (searchQueries) {
        searchQueries.addEventListener('input', (e) => {
          const q = (e.target.value || '').toLowerCase().trim();
          document.querySelectorAll('.query-table-row').forEach((row) => {
            const text = row.querySelector('.query-row-text')?.textContent?.toLowerCase() || '';
            row.style.display = text.includes(q) ? '' : 'none';
          });
        });
      }

      // 3. Manual Sync Button
      const btnSync = document.getElementById('btn-sync-gsc');
      const btnSyncIcon = document.getElementById('btn-sync-gsc-icon');
      const btnSyncText = document.getElementById('btn-sync-gsc-text');

      if (btnSync) {
        btnSync.addEventListener('click', async () => {
          if (btnSync.disabled) return;
          btnSync.disabled = true;
          if (btnSyncIcon) btnSyncIcon.textContent = '⏳';
          if (btnSyncText) btnSyncText.textContent = 'Syncing GSC...';

          try {
            const urlParams = new URLSearchParams(window.location.search);
            const range = urlParams.get('range') || '28d';
            const res = await fetch('/api/admin/seo/gsc/sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ range }),
            });

            const data = await res.json();
            if (res.ok && data.success) {
              if (btnSyncIcon) btnSyncIcon.textContent = '✓';
              if (btnSyncText) btnSyncText.textContent = 'Synced!';
              setTimeout(() => window.location.reload(), 600);
            } else {
              alert(data.error || 'Failed to sync with Search Console. Please verify credentials.');
              btnSync.disabled = false;
              if (btnSyncIcon) btnSyncIcon.textContent = '🔄';
              if (btnSyncText) btnSyncText.textContent = 'Sync GSC Data';
            }
          } catch (err) {
            alert('Network error while syncing Google Search Console data.');
            btnSync.disabled = false;
            if (btnSyncIcon) btnSyncIcon.textContent = '🔄';
            if (btnSyncText) btnSyncText.textContent = 'Sync GSC Data';
          }
        });
      }

      // 4. GSC Credentials Form Submission
      const formGsc = document.getElementById('form-gsc-credentials');
      const statusBox = document.getElementById('gsc-config-status');
      const btnSaveGsc = document.getElementById('btn-save-gsc');

      if (formGsc) {
        // Auto-parse if JSON pasted into email or key field
        const inpEmail = document.getElementById('inp-gsc-email');
        const inpKey = document.getElementById('inp-gsc-key');
        const inpProperty = document.getElementById('inp-gsc-property');

        const tryParseJson = (text) => {
          try {
            const parsed = JSON.parse(text);
            if (parsed.client_email && parsed.private_key) {
              if (inpEmail) inpEmail.value = parsed.client_email;
              if (inpKey) inpKey.value = parsed.private_key;
              return true;
            }
          } catch {}
          return false;
        };

        inpKey?.addEventListener('paste', (e) => {
          setTimeout(() => {
            if (inpKey.value.includes('{') && tryParseJson(inpKey.value)) {
              statusBox.className = 'rounded-xl p-3 text-xs font-bold block bg-blue-50 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
              statusBox.textContent = '✓ Service Account JSON detected and auto-parsed successfully.';
            }
          }, 50);
        });

        formGsc.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (btnSaveGsc.disabled) return;
          btnSaveGsc.disabled = true;
          btnSaveGsc.textContent = 'Connecting...';

          statusBox.className = 'rounded-xl p-3 text-xs font-bold block bg-blue-50 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
          statusBox.textContent = '⚡ Authenticating with Google Search Console API...';

          try {
            const clientEmail = inpEmail?.value?.trim() || '';
            let privateKey = inpKey?.value?.trim() || '';
            const propertyUrl = inpProperty?.value?.trim() || 'https://aifreecalculator.com/';

            // If user pasted raw JSON
            if (privateKey.includes('{')) {
              try {
                const parsed = JSON.parse(privateKey);
                if (parsed.private_key) privateKey = parsed.private_key;
              } catch {}
            }

            const res = await fetch('/api/admin/seo/gsc', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ clientEmail, privateKey, propertyUrl }),
            });

            const result = await res.json();

            if (res.ok && result.success) {
              statusBox.className = 'rounded-xl p-3 text-xs font-bold block bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
              statusBox.textContent = '✅ Google Search Console connected successfully! Reloading...';
              setTimeout(() => window.location.reload(), 1000);
            } else {
              statusBox.className = 'rounded-xl p-3 text-xs font-bold block bg-red-50 text-red-800 dark:bg-red-950 dark:text-red-300';
              statusBox.textContent = `❌ ${result.error || 'Authentication failed'}`;
              btnSaveGsc.disabled = false;
              btnSaveGsc.textContent = 'Validate & Connect';
            }
          } catch (err) {
            statusBox.className = 'rounded-xl p-3 text-xs font-bold block bg-red-50 text-red-800 dark:bg-red-950 dark:text-red-300';
            statusBox.textContent = '❌ Network error communicating with server.';
            btnSaveGsc.disabled = false;
            btnSaveGsc.textContent = 'Validate & Connect';
          }
        });
      }

      // 5. Open GSC Modal Button
      const btnOpenModal = document.getElementById('btn-open-gsc-modal');
      const modal = document.getElementById('modal-gsc-config');
      if (btnOpenModal && modal) {
        btnOpenModal.addEventListener('click', () => modal.classList.remove('hidden'));
      }

      // 6. Filter issue cards in technical audit
      const sevButtons = document.querySelectorAll('.sev-btn');
      const searchAudit = document.getElementById('search-audit-issues');
      let currentSeverity = 'all';

      sevButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          sevButtons.forEach((b) => b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900'));
          btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900');
          currentSeverity = btn.getAttribute('data-sev-filter') || 'all';
          filterAuditCards();
        });
      });

      searchAudit?.addEventListener('input', () => filterAuditCards());

      function filterAuditCards() {
        const q = (searchAudit?.value || '').toLowerCase().trim();
        document.querySelectorAll('.issue-card').forEach((card) => {
          const sev = card.getAttribute('data-severity');
          const text = card.textContent?.toLowerCase() || '';
          const matchesSev = currentSeverity === 'all' || sev === currentSeverity;
          const matchesText = !q || text.includes(q);
          card.style.display = matchesSev && matchesText ? '' : 'none';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGscDashboard);
    } else {
      initGscDashboard();
    }
  </script>
</AdminLayout>
