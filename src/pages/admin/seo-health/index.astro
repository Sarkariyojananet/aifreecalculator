---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SEOHealthCard from '../../../components/admin/SEOHealthCard.astro';
import { getFullSEOHealthSummary } from '../../../lib/admin/seo-health';

const summary = getFullSEOHealthSummary();
---

<AdminLayout title="SEO Health Audit | Calculator CMS" sectionTitle="SEO Health" activeSection="seo-health">
  <div class="space-y-8 max-w-7xl mx-auto pb-12">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
          SEO Health Diagnostics ({summary.totalCalculators} Audited)
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Automated metadata validation, title/description character limits, search keywords, and rich schema coverage.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/admin/seo/"
          class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 hover:bg-blue-700 transition"
        >
          <span>🩺</span> Open Full SEO Intelligence →
        </a>
      </div>
    </div>

    <!-- SEO Sub-Navigation Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="/admin/seo/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📊 Audit Overview
      </a>
      <a href="/admin/seo/bulk/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📝 Bulk Meta Editor
      </a>
      <a href="/admin/seo/duplicates/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        👯 Duplicate Content
      </a>
      <a href="/admin/seo/links/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🔗 Internal Link Audit
      </a>
      <a href="/admin/seo/sitemap-schema/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        🗺️ Sitemap &amp; Schema
      </a>
      <a href="/admin/seo/history/" class="rounded-xl px-3.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 shrink-0 transition">
        📜 Change History
      </a>
    </div>

    <!-- 1. SEO Summary Metrics Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Average Score</div>
        <div class="mt-2 text-3xl font-black text-slate-900 dark:text-white">{summary.overallScore}%</div>
        <div class="mt-1 text-[11px] text-emerald-600 font-bold">Passing Core Web Signals</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Excellent (90%+)</div>
        <div class="mt-2 text-3xl font-black text-emerald-600 dark:text-emerald-400">{summary.excellentCount}</div>
        <div class="mt-1 text-[11px] text-slate-400">Fully optimized tools</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Good (75-89%)</div>
        <div class="mt-2 text-3xl font-black text-blue-600 dark:text-blue-400">{summary.goodCount}</div>
        <div class="mt-1 text-[11px] text-slate-400">Minor tweaks needed</div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Needs Work (&lt;75%)</div>
        <div class="mt-2 text-3xl font-black text-amber-600 dark:text-amber-400">{summary.fairCount + summary.poorCount}</div>
        <div class="mt-1 text-[11px] text-slate-400">Expand descriptions</div>
      </div>
    </div>

    <!-- 2. Common Optimization Opportunities Banner -->
    <div class="rounded-3xl border border-slate-200 bg-slate-50/70 p-6 dark:border-slate-800 dark:bg-slate-900/60 space-y-3">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>🔍</span> Top Optimization Recommendations Across Site
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-1">
        {summary.topIssues.map((issue) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-950 flex items-center justify-between gap-2 shadow-2xs">
            <div class="text-xs font-semibold text-slate-700 dark:text-slate-300 line-clamp-1">
              {issue.issue}
            </div>
            <span class="rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-extrabold text-amber-700 dark:bg-amber-950 dark:text-amber-300 shrink-0">
              {issue.count} tools
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. Filter Toolbar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
      <!-- Search Input -->
      <div class="relative w-full sm:w-80">
        <input
          type="text"
          id="seo-search-input"
          placeholder="Filter by name, slug or issue..."
          class="w-full rounded-2xl border border-slate-200 bg-white py-2 px-3.5 pl-9 text-xs font-medium text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-800 dark:bg-slate-900 dark:text-white"
        />
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs">🔍</span>
      </div>

      <!-- Filter Buttons -->
      <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
        <button type="button" class="seo-filter active rounded-xl bg-blue-600 px-3 py-1.5 text-xs font-bold text-white shadow-xs" data-filter="all">
          All ({summary.totalCalculators})
        </button>
        <button type="button" class="seo-filter rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 transition" data-filter="needs_work">
          Needs Attention ({summary.fairCount + summary.poorCount})
        </button>
        <button type="button" class="seo-filter rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 transition" data-filter="excellent">
          Excellent ({summary.excellentCount})
        </button>
      </div>
    </div>

    <!-- 4. Individual Calculator Audit Cards Grid -->
    <div id="seo-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {summary.audits.map((audit) => (
        <div class="seo-item-card" data-name={audit.name.toLowerCase()} data-slug={audit.slug.toLowerCase()} data-grade={audit.grade}>
          <SEOHealthCard audit={audit} />
        </div>
      ))}
    </div>

  </div>
</AdminLayout>

<script is:inline>
  const searchInput = document.getElementById('seo-search-input');
  const filters = document.querySelectorAll('.seo-filter');
  const cards = document.querySelectorAll('.seo-item-card');

  let activeFilter = 'all';

  function applySeoFilters() {
    const q = (searchInput?.value || '').toLowerCase().trim();

    cards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const slug = card.getAttribute('data-slug') || '';
      const grade = card.getAttribute('data-grade') || '';

      const matchQuery = !q || name.includes(q) || slug.includes(q);
      let matchFilter = true;

      if (activeFilter === 'needs_work') {
        matchFilter = grade === 'fair' || grade === 'poor';
      } else if (activeFilter === 'excellent') {
        matchFilter = grade === 'excellent';
      }

      card.style.display = matchQuery && matchFilter ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', applySeoFilters);

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((b) => {
        b.className = 'seo-filter rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 transition';
      });
      btn.className = 'seo-filter active rounded-xl bg-blue-600 px-3 py-1.5 text-xs font-bold text-white shadow-xs';
      activeFilter = btn.getAttribute('data-filter') || 'all';
      applySeoFilters();
    });
  });
</script>
