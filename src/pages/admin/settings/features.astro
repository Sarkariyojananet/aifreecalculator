---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getFeatureFlags } from '../../../lib/admin/content-store';

const flags = await getFeatureFlags(Astro.locals);
---

<AdminLayout title="Feature Flags & Global Controls | Calculator CMS" sectionTitle="Feature Flags" activeSection="features">
  <div class="space-y-6 max-w-5xl mx-auto pb-12">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200/80 pb-6 dark:border-slate-800/80">
      <div>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
          Feature Flags &amp; Runtime Toggles
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Enable or disable interactive frontend utilities on the fly without triggering a complete code deployment.
        </p>
      </div>

      <a
        href="/admin/settings/"
        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 shadow-2xs self-start sm:self-auto"
      >
        <span>📢</span> Ad &amp; Monetization Settings →
      </a>
    </div>

    <!-- Feature Flags Form Container -->
    <form id="feature-flags-form" class="space-y-6">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900/90 divide-y divide-slate-100 dark:divide-slate-800">
        
        <!-- Flag 1: PDF Export -->
        <div class="py-4 flex items-center justify-between gap-4 first:pt-0">
          <div>
            <h3 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📄</span> PDF Report Download Utility
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
              Allows users to export formatted BOQ, EMI, and Calorie computation reports using jsPDF.
            </p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="flag-pdf" checked={flags.enablePdfDownload} class="sr-only peer" />
            <div class="w-10 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          </label>
        </div>

        <!-- Flag 2: Share Calculation -->
        <div class="py-4 flex items-center justify-between gap-4">
          <div>
            <h3 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🔗</span> 1-Click Share &amp; Copy Calculation URL
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
              Generates pre-filled shareable query parameters so users can share calculation results with contractors or clients.
            </p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="flag-share" checked={flags.enableShareCalculation} class="sr-only peer" />
            <div class="w-10 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          </label>
        </div>

        <!-- Flag 3: User Feedback Rating -->
        <div class="py-4 flex items-center justify-between gap-4">
          <div>
            <h3 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>👍</span> Helpful / Not Helpful Feedback System
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
              Collects anonymous rating feedback on calculator pages to help prioritize accuracy updates.
            </p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="flag-feedback" checked={flags.enableUserFeedback} class="sr-only peer" />
            <div class="w-10 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          </label>
        </div>

        <!-- Flag 4: Search Analytics -->
        <div class="py-4 flex items-center justify-between gap-4">
          <div>
            <h3 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🔍</span> Privacy-Safe Search Analytics Logging
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
              Records non-personal search keywords in D1 to detect trending calculator search requests.
            </p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="flag-analytics" checked={flags.enableSearchAnalytics} class="sr-only peer" />
            <div class="w-10 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          </label>
        </div>

        <!-- Flag 5: Dark Mode Switcher -->
        <div class="py-4 flex items-center justify-between gap-4">
          <div>
            <h3 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🌓</span> Dark &amp; Light Theme Toggle Button
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
              Displays theme toggle switch in header navigation for all visitors.
            </p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="flag-theme" checked={flags.enableDarkModeToggle} class="sr-only peer" />
            <div class="w-10 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          </label>
        </div>

        <!-- Flag 6: Recently Used Tools -->
        <div class="py-4 flex items-center justify-between gap-4 last:pb-0">
          <div>
            <h3 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>⏱️</span> Recently Used Calculators Bar
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
              Displays local browser history of recently accessed calculators for instant re-access.
            </p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="flag-recent" checked={flags.enableRecentlyUsed} class="sr-only peer" />
            <div class="w-10 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:bg-slate-700"></div>
          </label>
        </div>

      </div>

      <!-- Status Alert -->
      <div id="features-status-alert" class="hidden rounded-xl p-3 text-xs font-semibold"></div>

      <!-- Save Bar -->
      <div class="flex items-center justify-end border-t border-slate-200/80 pt-4 dark:border-slate-800/80">
        <button
          type="submit"
          id="btn-save-features-submit"
          class="rounded-xl bg-blue-600 px-6 py-2.5 text-xs font-bold text-white shadow-md shadow-blue-500/20 hover:bg-blue-700 transition cursor-pointer"
        >
          💾 Save Feature Toggles
        </button>
      </div>
    </form>

  </div>
</AdminLayout>

<script is:inline>
  const form = document.getElementById('feature-flags-form');
  const statusAlert = document.getElementById('features-status-alert');

  const flagPdf = document.getElementById('flag-pdf');
  const flagShare = document.getElementById('flag-share');
  const flagFeedback = document.getElementById('flag-feedback');
  const flagAnalytics = document.getElementById('flag-analytics');
  const flagTheme = document.getElementById('flag-theme');
  const flagRecent = document.getElementById('flag-recent');

  function getAuthToken() {
    return localStorage.getItem('admin_token') || '';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const payload = {
      enablePdfDownload: Boolean(flagPdf?.checked),
      enableShareCalculation: Boolean(flagShare?.checked),
      enableUserFeedback: Boolean(flagFeedback?.checked),
      enableSearchAnalytics: Boolean(flagAnalytics?.checked),
      enableDarkModeToggle: Boolean(flagTheme?.checked),
      enableRecentlyUsed: Boolean(flagRecent?.checked),
    };

    if (statusAlert) {
      statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300';
      statusAlert.textContent = 'Saving runtime feature flag settings...';
      statusAlert.classList.remove('hidden');
    }

    try {
      const token = getAuthToken();
      const res = await fetch('/api/admin/features', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
        },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (res.ok && data.success) {
        statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
        statusAlert.textContent = '✓ Runtime feature flag settings saved successfully!';
        setTimeout(() => window.location.reload(), 700);
      } else {
        statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300';
        statusAlert.textContent = data.error || 'Failed to save feature flags';
      }
    } catch {
      statusAlert.className = 'rounded-xl p-3 text-xs font-semibold bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300';
      statusAlert.textContent = 'Connection error while saving feature flags';
    }
  });
</script>
