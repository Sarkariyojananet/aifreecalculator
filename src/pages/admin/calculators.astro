---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { calculators } from '../../data/calculators';

const featuredCount = calculators.filter((calculator) => calculator.featured).length;

const categories = [
  ...new Set(calculators.map((calculator) => calculator.category)),
];

const categoryCount = categories.length;
---

<AdminLayout
  title="Manage Calculators | AI Free Calculator"
  activeTab="calculators"
>
  <div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-lg dark:bg-blue-950/40">
            🧮
          </div>

          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
              Manage Calculators
            </h2>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              Search and manage all registered calculator tools.
            </p>
          </div>
        </div>
      </div>

      <!-- Search -->
      <div class="relative w-full lg:w-80">
        <label for="admin-calc-search" class="sr-only">
          Search calculators
        </label>

        <input
          type="search"
          id="admin-calc-search"
          placeholder="Search name, category or slug..."
          autocomplete="off"
          class="w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-4 pr-10 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
        />

        <button
          type="button"
          id="clear-search"
          aria-label="Clear search"
          class="absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-lg px-2 py-1 text-sm text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200"
        >
          ×
        </button>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid gap-4 sm:grid-cols-3">

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Total Calculators
        </p>

        <p class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">
          {calculators.length}
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Featured Tools
        </p>

        <p class="mt-2 text-2xl font-bold text-amber-500">
          {featuredCount}
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Categories
        </p>

        <p class="mt-2 text-2xl font-bold text-blue-600 dark:text-blue-400">
          {categoryCount}
        </p>
      </div>

    </div>

    <!-- Table Card -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">

      <!-- Table Header -->
      <div class="flex flex-col gap-3 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800">

        <div>
          <h3 class="font-semibold text-slate-900 dark:text-white">
            All Registered Calculators
          </h3>

          <p
            id="results-count"
            class="mt-1 text-xs text-slate-500 dark:text-slate-400"
          >
            Showing {calculators.length} calculators
          </p>
        </div>

        <div class="text-xs text-slate-400 dark:text-slate-500">
          Search by name, category, slug or route
        </div>

      </div>

      <!-- Table -->
      <div class="overflow-x-auto">

        <table class="min-w-[850px] w-full text-left text-sm">

          <thead class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950">

            <tr class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">

              <th scope="col" class="px-5 py-3.5">
                Calculator
              </th>

              <th scope="col" class="px-5 py-3.5">
                Category
              </th>

              <th scope="col" class="px-5 py-3.5">
                Route
              </th>

              <th scope="col" class="px-5 py-3.5">
                Status
              </th>

              <th scope="col" class="px-5 py-3.5 text-right">
                Action
              </th>

            </tr>

          </thead>

          <tbody
            id="calc-table-body"
            class="divide-y divide-slate-100 dark:divide-slate-800"
          >

            {
              calculators.map((calculator) => (
                <tr
                  class="calc-row transition hover:bg-slate-50/80 dark:hover:bg-slate-800/50"
                  data-name={calculator.name.toLowerCase()}
                  data-category={calculator.category.toLowerCase()}
                  data-slug={calculator.slug.toLowerCase()}
                  data-path={calculator.path.toLowerCase()}
                >

                  <!-- Calculator -->
                  <td class="px-5 py-4">

                    <div class="flex items-center gap-3">

                      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-lg dark:bg-slate-800">
                        {calculator.icon}
                      </div>

                      <div class="min-w-0">

                        <div class="truncate font-semibold text-slate-900 dark:text-white">
                          {calculator.name}
                        </div>

                        <div class="mt-0.5 truncate font-mono text-[11px] text-slate-400 dark:text-slate-500">
                          {calculator.slug}
                        </div>

                      </div>

                    </div>

                  </td>

                  <!-- Category -->
                  <td class="px-5 py-4">

                    <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                      {calculator.category}
                    </span>

                  </td>

                  <!-- Route -->
                  <td class="px-5 py-4">

                    <code class="rounded-md bg-blue-50 px-2 py-1 font-mono text-[11px] text-blue-700 dark:bg-blue-950/40 dark:text-blue-300">
                      {calculator.path}
                    </code>

                  </td>

                  <!-- Status -->
                  <td class="px-5 py-4">

                    {
                      calculator.featured ? (
                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-bold text-amber-800 dark:bg-amber-950/50 dark:text-amber-300">
                          ⭐ Featured
                        </span>
                      ) : (
                        <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                          Standard
                        </span>
                      )
                    }

                  </td>

                  <!-- Action -->
                  <td class="px-5 py-4 text-right">

                    <a
                      href={calculator.path}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open ${calculator.name}`}
                      class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-blue-600 transition hover:border-blue-200 hover:bg-blue-50 dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 dark:hover:border-blue-900 dark:hover:bg-slate-700"
                    >
                      Open Tool
                      <span class="ml-1">↗</span>
                    </a>

                  </td>

                </tr>
              ))
            }

          </tbody>

        </table>

      </div>

      <!-- Empty State -->
      <div
        id="no-results"
        class="hidden px-6 py-16 text-center"
      >

        <div class="text-4xl">
          🔎
        </div>

        <h3 class="mt-4 font-semibold text-slate-900 dark:text-white">
          No calculators found
        </h3>

        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Try searching with a different calculator name or category.
        </p>

        <button
          type="button"
          id="empty-clear-search"
          class="mt-4 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          Clear Search
        </button>

      </div>

    </div>

  </div>
</AdminLayout>

<script is:inline>
  const searchInput = document.getElementById('admin-calc-search');
  const clearButton = document.getElementById('clear-search');
  const emptyClearButton = document.getElementById('empty-clear-search');
  const rows = document.querySelectorAll('.calc-row');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');

  function filterCalculators() {
    const query = searchInput.value.toLowerCase().trim();

    let visibleCount = 0;

    rows.forEach((row) => {
      const name = row.dataset.name || '';
      const category = row.dataset.category || '';
      const slug = row.dataset.slug || '';
      const path = row.dataset.path || '';

      const matches =
        !query ||
        name.includes(query) ||
        category.includes(query) ||
        slug.includes(query) ||
        path.includes(query);

      row.classList.toggle('hidden', !matches);

      if (matches) {
        visibleCount++;
      }
    });

    if (resultsCount) {
      resultsCount.textContent = query
        ? `Showing ${visibleCount} of ${rows.length} calculators`
        : `Showing ${rows.length} calculators`;
    }

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount !== 0);
    }

    if (clearButton) {
      clearButton.classList.toggle('hidden', !query);
    }
  }

  function clearSearch() {
    if (!searchInput) return;
    searchInput.value = '';
    filterCalculators();
    searchInput.focus();
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterCalculators);
  }

  if (clearButton) {
    clearButton.addEventListener('click', clearSearch);
  }

  if (emptyClearButton) {
    emptyClearButton.addEventListener('click', clearSearch);
  }
</script>
