<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // State
  let currentCalculationType = 'add'; // 'add' | 'remove'

  // DOM Elements
  const modeButtons = document.querySelectorAll('.btn-gst-mode');
  const gstPanelTitle = document.getElementById('gst-panel-title');
  const lblGstAmount = document.getElementById('lbl-gst-amount');
  const inpGstAmount = document.getElementById('inp-gst-amount');
  const selGstRate = document.getElementById('sel-gst-rate');
  const selTxType = document.getElementById('sel-tx-type');
  const rowCustomRate = document.getElementById('row-custom-rate');
  const inpCustomRate = document.getElementById('inp-custom-rate');

  const btnCalcGst = document.getElementById('btn-calc-gst');
  const btnClearGst = document.getElementById('btn-clear-gst');
  const errGst = document.getElementById('err-gst');

  // Results Elements
  const gstResultsSection = document.getElementById('gst-results-section');
  const resMainHighlightLabel = document.getElementById('res-main-highlight-label');
  const resMainHighlightVal = document.getElementById('res-main-highlight-val');
  const resTotalGstBadge = document.getElementById('res-total-gst-badge');
  const resBasePrice = document.getElementById('res-base-price');
  const resAppliedRate = document.getElementById('res-applied-rate');
  const colResCgst = document.getElementById('col-res-cgst');
  const lblResCgst = document.getElementById('lbl-res-cgst');
  const resCgstVal = document.getElementById('res-cgst-val');
  const colResSgst = document.getElementById('col-res-sgst');
  const lblResSgst = document.getElementById('lbl-res-sgst');
  const resSgstVal = document.getElementById('res-sgst-val');
  const colResIgst = document.getElementById('col-res-igst');
  const lblResIgst = document.getElementById('lbl-res-igst');
  const resIgstVal = document.getElementById('res-igst-val');
  const stepBreakdownContainer = document.getElementById('step-breakdown-container');

  // Formatter
  function formatINR(val) {
    return `₹ ${Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  // Switch Mode Handler
  function switchGstMode(mode) {
    currentCalculationType = mode;
    modeButtons.forEach((btn) => {
      if (btn.getAttribute('data-mode') === mode) {
        btn.className = 'btn-gst-mode active shrink-0 rounded-lg bg-blue-600 px-4 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-gst-mode shrink-0 rounded-lg border border-slate-300 bg-white px-4 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    if (mode === 'add') {
      gstPanelTitle.innerHTML = '<span>🧾</span> Add GST Calculator';
      lblGstAmount.textContent = 'Amount (₹ - Excluding GST)';
    } else {
      gstPanelTitle.innerHTML = '<span>🔄</span> Remove GST (Reverse Calculator)';
      lblGstAmount.textContent = 'Inclusive Amount (₹ - Including GST)';
    }
  }

  modeButtons.forEach((btn) => {
    btn.addEventListener('click', () => switchGstMode(btn.getAttribute('data-mode')));
  });

  // Custom rate dropdown listener
  selGstRate.addEventListener('change', () => {
    if (selGstRate.value === 'custom') {
      rowCustomRate.classList.remove('hidden');
    } else {
      rowCustomRate.classList.add('hidden');
    }
  });

  // Execute Calculation
  function executeGstCalculation() {
    errGst.classList.add('hidden');

    const amount = parseFloat(inpGstAmount.value);
    if (isNaN(amount) || amount < 0) {
      errGst.textContent = 'Please enter a valid positive amount.';
      errGst.classList.remove('hidden');
      gstResultsSection.classList.add('hidden');
      return;
    }

    let rate = 0;
    if (selGstRate.value === 'custom') {
      rate = parseFloat(inpCustomRate.value);
      if (isNaN(rate) || rate < 0 || rate > 100) {
        errGst.textContent = 'Please enter a valid custom GST rate between 0% and 100%.';
        errGst.classList.remove('hidden');
        gstResultsSection.classList.add('hidden');
        return;
      }
    } else {
      rate = parseFloat(selGstRate.value) || 0;
    }

    const txType = selTxType.value; // 'intra-state' | 'inter-state'

    let baseAmount = 0;
    let gstAmount = 0;
    let totalAmount = 0;
    const steps = [];

    if (currentCalculationType === 'add') {
      baseAmount = amount;
      gstAmount = (amount * rate) / 100;
      totalAmount = baseAmount + gstAmount;

      resMainHighlightLabel.textContent = 'Total Amount (Including GST)';
      resMainHighlightVal.textContent = formatINR(totalAmount);

      steps.push({
        title: 'Step 1: Calculate GST Amount',
        formula: `GST Amount = Amount × (GST Rate ÷ 100)`,
        calc: `₹ ${amount.toLocaleString('en-IN')} × (${rate} ÷ 100) = ${formatINR(gstAmount)}`,
      });
      steps.push({
        title: 'Step 2: Add GST to Base Amount',
        formula: `Final Amount = Base Amount + GST Amount`,
        calc: `₹ ${amount.toLocaleString('en-IN')} + ${formatINR(gstAmount)} = ${formatINR(totalAmount)}`,
      });
    } else {
      totalAmount = amount;
      if (rate === 0) {
        baseAmount = totalAmount;
        gstAmount = 0;
      } else {
        baseAmount = (totalAmount * 100) / (100 + rate);
        gstAmount = totalAmount - baseAmount;
      }

      resMainHighlightLabel.textContent = 'Base Price (Amount Before GST)';
      resMainHighlightVal.textContent = formatINR(baseAmount);

      steps.push({
        title: 'Step 1: Extract Base Taxable Price',
        formula: `Base Price = Inclusive Amount × 100 ÷ (100 + GST Rate)`,
        calc: `₹ ${amount.toLocaleString('en-IN')} × 100 ÷ (100 + ${rate}) = ${formatINR(baseAmount)}`,
      });
      steps.push({
        title: 'Step 2: Compute Extracted GST Tax',
        formula: `GST Tax = Inclusive Amount − Base Price`,
        calc: `₹ ${amount.toLocaleString('en-IN')} − ${formatINR(baseAmount)} = ${formatINR(gstAmount)}`,
      });
    }

    resTotalGstBadge.textContent = formatINR(gstAmount);
    resBasePrice.textContent = formatINR(baseAmount);
    resAppliedRate.textContent = `${rate}%`;

    if (txType === 'intra-state') {
      const halfRate = rate / 2;
      const halfTax = gstAmount / 2;

      lblResCgst.textContent = `CGST (${halfRate}%)`;
      resCgstVal.textContent = formatINR(halfTax);

      lblResSgst.textContent = `SGST (${halfRate}%)`;
      resSgstVal.textContent = formatINR(halfTax);

      colResCgst.classList.remove('hidden');
      colResSgst.classList.remove('hidden');
      colResIgst.classList.add('hidden');

      steps.push({
        title: 'Step 3: Intra-State Tax Split',
        formula: `CGST (${halfRate}%) + SGST (${halfRate}%)`,
        calc: `${formatINR(halfTax)} + ${formatINR(halfTax)} = ${formatINR(gstAmount)}`,
      });
    } else {
      lblResIgst.textContent = `IGST (${rate}%)`;
      resIgstVal.textContent = formatINR(gstAmount);

      colResCgst.classList.add('hidden');
      colResSgst.classList.add('hidden');
      colResIgst.classList.remove('hidden');

      steps.push({
        title: 'Step 3: Inter-State Integrated Tax',
        formula: `IGST (${rate}%)`,
        calc: `Full tax component of ${formatINR(gstAmount)} attributed to IGST.`,
      });
    }

    // Render Steps
    stepBreakdownContainer.innerHTML = steps.map((s) => `
      <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-3 dark:border-slate-800 dark:bg-slate-950/50">
        <div class="font-bold text-slate-800 dark:text-slate-200">${s.title}</div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 font-mono mt-0.5">${s.formula}</div>
        <div class="text-xs font-bold text-blue-600 dark:text-blue-400 font-mono mt-1">${s.calc}</div>
      </div>
    `).join('');

    gstResultsSection.classList.remove('hidden');
  }

  btnCalcGst.addEventListener('click', executeGstCalculation);

  btnClearGst.addEventListener('click', () => {
    inpGstAmount.value = '1000';
    selGstRate.value = '18';
    selTxType.value = 'intra-state';
    rowCustomRate.classList.add('hidden');
    inpCustomRate.value = '18';
    errGst.classList.add('hidden');
    gstResultsSection.classList.add('hidden');
    switchGstMode('add');
  });

  // Preset Buttons Listener
  document.querySelectorAll('.btn-gst-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-mode');
      const amt = btn.getAttribute('data-amt');
      const rate = btn.getAttribute('data-rate');
      const tx = btn.getAttribute('data-tx');

      switchGstMode(mode);
      if (amt) inpGstAmount.value = amt;
      if (rate) {
        selGstRate.value = rate;
        selGstRate.dispatchEvent(new Event('change'));
      }
      if (tx) selTxType.value = tx === 'intra' ? 'intra-state' : 'inter-state';
    });
  });

  // Enter Key Listener
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeGstCalculation();
        }
      });
    });
  });
</script>
