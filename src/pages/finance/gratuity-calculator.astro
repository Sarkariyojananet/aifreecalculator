<!-- CLIENT SIDE SCRIPT -->
<script>
  import { calculateSimpleGratuity, calculateAdvancedGratuity } from '../../lib/calculators/gratuity';

  function formatINR(val: number): string {
    return '₹ ' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // ─────────────────────────────────────────────────────────────────────────
  // TAB SWITCHING (Simple vs Advanced)
  // ─────────────────────────────────────────────────────────────────────────
  const tabBtnSimple = document.getElementById('tab-btn-simple') as HTMLButtonElement;
  const tabBtnAdv = document.getElementById('tab-btn-adv') as HTMLButtonElement;
  const panelSimple = document.getElementById('panel-simple-gratuity') as HTMLDivElement;
  const panelAdv = document.getElementById('panel-adv-gratuity') as HTMLDivElement;
  const modeDescText = document.getElementById('mode-desc-text') as HTMLDivElement;

  function switchTab(mode: 'simple' | 'advanced') {
    if (mode === 'simple') {
      tabBtnSimple.className = 'btn-grat-mode active shrink-0 rounded-xl bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5';
      tabBtnAdv.className = 'btn-grat-mode shrink-0 rounded-xl border border-slate-300 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5';
      panelSimple.classList.remove('hidden');
      panelAdv.classList.add('hidden');
      modeDescText.textContent = 'Quick calculation using salary and service period';
    } else {
      tabBtnAdv.className = 'btn-grat-mode active shrink-0 rounded-xl bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5';
      tabBtnSimple.className = 'btn-grat-mode shrink-0 rounded-xl border border-slate-300 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5';
      panelAdv.classList.remove('hidden');
      panelSimple.classList.add('hidden');
      modeDescText.textContent = 'Detailed calculation with DA, service rules and eligibility';
    }
  }

  tabBtnSimple.addEventListener('click', () => switchTab('simple'));
  tabBtnAdv.addEventListener('click', () => switchTab('advanced'));

  // ─────────────────────────────────────────────────────────────────────────
  // 1. SIMPLE GRATUITY CALCULATOR LOGIC
  // ─────────────────────────────────────────────────────────────────────────
  const formSimple = document.getElementById('form-simple-grat') as HTMLFormElement;
  const inpSimSalary = document.getElementById('inp-sim-salary') as HTMLInputElement;
  const rangeSimSalary = document.getElementById('range-sim-salary') as HTMLInputElement;

  const inpSimYears = document.getElementById('inp-sim-years') as HTMLInputElement;
  const rangeSimYears = document.getElementById('range-sim-years') as HTMLInputElement;

  const inpSimMonths = document.getElementById('inp-sim-months') as HTMLInputElement;
  const rangeSimMonths = document.getElementById('range-sim-months') as HTMLInputElement;

  const btnCalcSimple = document.getElementById('btn-calc-simple') as HTMLButtonElement;
  const btnClearSimple = document.getElementById('btn-clear-simple') as HTMLButtonElement;
  const errSim = document.getElementById('err-sim') as HTMLParagraphElement;

  const simResultsSection = document.getElementById('sim-results-section') as HTMLDivElement;
  const resSimAmount = document.getElementById('res-sim-amount') as HTMLDivElement;
  const resSimEligibleYears = document.getElementById('res-sim-eligible-years') as HTMLDivElement;
  const bannerSimWarning = document.getElementById('banner-sim-warning') as HTMLDivElement;
  const resSimSalary = document.getElementById('res-sim-salary') as HTMLDivElement;
  const resSimDuration = document.getElementById('res-sim-duration') as HTMLDivElement;
  const resSimFormula = document.getElementById('res-sim-formula') as HTMLDivElement;

  // IMPORTANT: Reset/hide results whenever user changes any input or slider in Simple mode
  function handleSimpleInputModification() {
    simResultsSection.classList.add('hidden');
    errSim.classList.add('hidden');
  }

  function setupSliderSync(input: HTMLInputElement, range: HTMLInputElement, onMod: () => void) {
    range.addEventListener('input', () => {
      input.value = range.value;
      onMod();
    });
    input.addEventListener('input', () => {
      range.value = input.value;
      onMod();
    });
  }

  setupSliderSync(inpSimSalary, rangeSimSalary, handleSimpleInputModification);
  setupSliderSync(inpSimYears, rangeSimYears, handleSimpleInputModification);
  setupSliderSync(inpSimMonths, rangeSimMonths, handleSimpleInputModification);

  function executeSimpleCalculation() {
    errSim.classList.add('hidden');

    const salary = parseFloat(inpSimSalary.value);
    const years = parseInt(inpSimYears.value, 10);
    const months = parseInt(inpSimMonths.value, 10) || 0;

    if (isNaN(salary) || salary <= 0) {
      errSim.textContent = 'Please enter a valid monthly salary.';
      errSim.classList.remove('hidden');
      return;
    }

    if (isNaN(years) || years < 0) {
      errSim.textContent = 'Please enter valid completed years of service.';
      errSim.classList.remove('hidden');
      return;
    }

    if (isNaN(months) || months < 0 || months > 11) {
      errSim.textContent = 'Additional months must be between 0 and 11.';
      errSim.classList.remove('hidden');
      return;
    }

    const res = calculateSimpleGratuity({
      monthlySalary: salary,
      yearsOfService: years,
      monthsOfService: months
    });

    // Populate Simple Result Section
    resSimAmount.textContent = formatINR(res.gratuityAmount);
    resSimEligibleYears.textContent = `${res.eligibleYears} Year${res.eligibleYears === 1 ? '' : 's'}`;
    resSimSalary.textContent = formatINR(res.monthlySalary);
    resSimDuration.textContent = res.actualServiceDurationText;
    resSimFormula.textContent = res.formulaUsed;

    if (!res.isEligible && res.eligibilityWarning) {
      bannerSimWarning.textContent = res.eligibilityWarning;
      bannerSimWarning.classList.remove('hidden');
    } else {
      bannerSimWarning.classList.add('hidden');
    }

    simResultsSection.classList.remove('hidden');
    simResultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  btnCalcSimple.addEventListener('click', executeSimpleCalculation);

  btnClearSimple.addEventListener('click', () => {
    inpSimSalary.value = '60000';
    rangeSimSalary.value = '60000';
    inpSimYears.value = '5';
    rangeSimYears.value = '5';
    inpSimMonths.value = '0';
    rangeSimMonths.value = '0';
    handleSimpleInputModification();
  });

  // Presets for Simple
  document.querySelectorAll('.btn-preset-simple').forEach((btn) => {
    btn.addEventListener('click', () => {
      const s = btn.getAttribute('data-salary') || '60000';
      const y = btn.getAttribute('data-years') || '5';
      const m = btn.getAttribute('data-months') || '0';

      inpSimSalary.value = s;
      rangeSimSalary.value = s;
      inpSimYears.value = y;
      rangeSimYears.value = y;
      inpSimMonths.value = m;
      rangeSimMonths.value = m;

      handleSimpleInputModification();
      executeSimpleCalculation();
    });
  });

  formSimple.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeSimpleCalculation();
    }
  });

  // ─────────────────────────────────────────────────────────────────────────
  // 2. ADVANCED GRATUITY CALCULATOR LOGIC
  // ─────────────────────────────────────────────────────────────────────────
  const formAdv = document.getElementById('form-adv-grat') as HTMLFormElement;
  const inpAdvBasic = document.getElementById('inp-adv-basic') as HTMLInputElement;
  const rangeAdvBasic = document.getElementById('range-adv-basic') as HTMLInputElement;

  const inpAdvDa = document.getElementById('inp-adv-da') as HTMLInputElement;
  const rangeAdvDa = document.getElementById('range-adv-da') as HTMLInputElement;

  const inpAdvYears = document.getElementById('inp-adv-years') as HTMLInputElement;
  const rangeAdvYears = document.getElementById('range-adv-years') as HTMLInputElement;

  const inpAdvMonths = document.getElementById('inp-adv-months') as HTMLInputElement;
  const rangeAdvMonths = document.getElementById('range-adv-months') as HTMLInputElement;

  const selAdvSituation = document.getElementById('sel-adv-situation') as HTMLSelectElement;

  const btnCalcAdv = document.getElementById('btn-calc-adv') as HTMLButtonElement;
  const btnClearAdv = document.getElementById('btn-clear-adv') as HTMLButtonElement;
  const errAdv = document.getElementById('err-adv') as HTMLParagraphElement;

  const advResultsSection = document.getElementById('adv-results-section') as HTMLDivElement;
  const resAdvAmount = document.getElementById('res-adv-amount') as HTMLDivElement;
  const resAdvEligibleYears = document.getElementById('res-adv-eligible-years') as HTMLDivElement;
  const badgeAdvEligibility = document.getElementById('badge-adv-eligibility') as HTMLSpanElement;
  const bannerAdvMsg = document.getElementById('banner-adv-msg') as HTMLDivElement;

  const resAdvBasic = document.getElementById('res-adv-basic') as HTMLDivElement;
  const resAdvDa = document.getElementById('res-adv-da') as HTMLDivElement;
  const resAdvTotalSalary = document.getElementById('res-adv-total-salary') as HTMLDivElement;
  const resAdvDuration = document.getElementById('res-adv-duration') as HTMLDivElement;

  const resAdvDailySalary = document.getElementById('res-adv-daily-salary') as HTMLDivElement;
  const resAdv15DaysSalary = document.getElementById('res-adv-15days-salary') as HTMLDivElement;
  const resAdvFormulaStep = document.getElementById('res-adv-formula-step') as HTMLDivElement;
  const resAdvTaxInfo = document.getElementById('res-adv-tax-info') as HTMLParagraphElement;
  const resAdvDisclaimer = document.getElementById('res-adv-disclaimer') as HTMLParagraphElement;

  // IMPORTANT: Reset/hide results whenever user changes any input or slider in Advanced mode
  function handleAdvInputModification() {
    advResultsSection.classList.add('hidden');
    errAdv.classList.add('hidden');
  }

  setupSliderSync(inpAdvBasic, rangeAdvBasic, handleAdvInputModification);
  setupSliderSync(inpAdvDa, rangeAdvDa, handleAdvInputModification);
  setupSliderSync(inpAdvYears, rangeAdvYears, handleAdvInputModification);
  setupSliderSync(inpAdvMonths, rangeAdvMonths, handleAdvInputModification);
  selAdvSituation.addEventListener('change', handleAdvInputModification);

  function executeAdvancedCalculation() {
    errAdv.classList.add('hidden');

    const basic = parseFloat(inpAdvBasic.value);
    const da = parseFloat(inpAdvDa.value) || 0;
    const years = parseInt(inpAdvYears.value, 10);
    const months = parseInt(inpAdvMonths.value, 10) || 0;
    const situation = selAdvSituation.value as any;

    if (isNaN(basic) || basic < 0) {
      errAdv.textContent = 'Please enter a valid Basic Salary.';
      errAdv.classList.remove('hidden');
      return;
    }

    if (isNaN(years) || years < 0) {
      errAdv.textContent = 'Please enter valid completed years of service.';
      errAdv.classList.remove('hidden');
      return;
    }

    if (isNaN(months) || months < 0 || months > 11) {
      errAdv.textContent = 'Additional months must be between 0 and 11.';
      errAdv.classList.remove('hidden');
      return;
    }

    const res = calculateAdvancedGratuity({
      basicSalary: basic,
      dearnessAllowance: da,
      yearsOfService: years,
      monthsOfService: months,
      employmentSituation: situation
    });

    // Populate all 12 Advanced items:
    // 1. Eligibility Status
    if (!res.isEligible) {
      badgeAdvEligibility.textContent = res.eligibilityStatus;
      badgeAdvEligibility.className = 'inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
      bannerAdvMsg.className = 'mt-4 rounded-xl p-3.5 text-xs font-semibold bg-amber-50 border border-amber-300 dark:bg-amber-950/40 dark:border-amber-900/60 text-amber-900 dark:text-amber-200';
      bannerAdvMsg.textContent = res.eligibilityDetail;
    } else if (res.isWaiverApplied) {
      badgeAdvEligibility.textContent = res.eligibilityStatus;
      badgeAdvEligibility.className = 'inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-bold bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
      bannerAdvMsg.className = 'mt-4 rounded-xl p-3.5 text-xs font-semibold bg-blue-50 border border-blue-300 dark:bg-blue-950/40 dark:border-blue-900/60 text-blue-900 dark:text-blue-200';
      bannerAdvMsg.textContent = res.eligibilityDetail;
    } else {
      badgeAdvEligibility.textContent = res.eligibilityStatus;
      badgeAdvEligibility.className = 'inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
      bannerAdvMsg.className = 'mt-4 rounded-xl p-3.5 text-xs font-semibold bg-emerald-50 border border-emerald-300 dark:bg-emerald-950/40 dark:border-emerald-900/60 text-emerald-900 dark:text-emerald-200';
      bannerAdvMsg.textContent = res.eligibilityDetail;
    }

    // 2. Basic Salary
    resAdvBasic.textContent = formatINR(res.basicSalary);
    // 3. Dearness Allowance
    resAdvDa.textContent = formatINR(res.dearnessAllowance);
    // 4. Total Salary Considered
    resAdvTotalSalary.textContent = formatINR(res.totalSalaryConsidered);
    // 5. Actual Service Duration
    resAdvDuration.textContent = res.actualServiceDurationText;
    // 6. Eligible Service Years
    resAdvEligibleYears.textContent = `${res.eligibleYears} Year${res.eligibleYears === 1 ? '' : 's'}`;
    // 7. Daily Salary Calculation
    resAdvDailySalary.textContent = `${formatINR(res.dailySalary)} (${formatINR(res.totalSalaryConsidered)} ÷ 26)`;
    // 8. 15 Days Salary Calculation
    resAdv15DaysSalary.textContent = `${formatINR(res.fifteenDaysSalary)} (${formatINR(res.dailySalary)} × 15)`;
    // 9. Final Gratuity Calculation
    resAdvFormulaStep.textContent = res.formulaCalculationText;
    // 10. Estimated Gratuity Amount
    resAdvAmount.textContent = formatINR(res.gratuityAmount);
    // 11. Important Statutory/Tax Information
    resAdvTaxInfo.textContent = res.statutoryTaxInfo;
    // 12. Policy Disclaimer
    resAdvDisclaimer.textContent = res.disclaimer;

    advResultsSection.classList.remove('hidden');
    advResultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  btnCalcAdv.addEventListener('click', executeAdvancedCalculation);

  btnClearAdv.addEventListener('click', () => {
    inpAdvBasic.value = '50000';
    rangeAdvBasic.value = '50000';
    inpAdvDa.value = '0';
    rangeAdvDa.value = '0';
    inpAdvYears.value = '8';
    rangeAdvYears.value = '8';
    inpAdvMonths.value = '8';
    rangeAdvMonths.value = '8';
    selAdvSituation.value = 'resignation';
    handleAdvInputModification();
  });

  // Presets for Advanced
  document.querySelectorAll('.btn-preset-adv').forEach((btn) => {
    btn.addEventListener('click', () => {
      const b = btn.getAttribute('data-basic') || '50000';
      const d = btn.getAttribute('data-da') || '0';
      const y = btn.getAttribute('data-years') || '8';
      const m = btn.getAttribute('data-months') || '8';
      const sit = btn.getAttribute('data-sit') || 'resignation';

      inpAdvBasic.value = b;
      rangeAdvBasic.value = b;
      inpAdvDa.value = d;
      rangeAdvDa.value = d;
      inpAdvYears.value = y;
      rangeAdvYears.value = y;
      inpAdvMonths.value = m;
      rangeAdvMonths.value = m;
      selAdvSituation.value = sit;

      handleAdvInputModification();
      executeAdvancedCalculation();
    });
  });

  formAdv.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeAdvancedCalculation();
    }
  });
</script>
