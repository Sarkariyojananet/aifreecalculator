---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Gratuity Calculator – Simple & Advanced (Payment of Gratuity Act 1972)"
  description="Calculate your gratuity payout using either the quick Simple Gratuity Calculator or the in-depth Advanced Gratuity Calculator with DA, service rounding rules, and eligibility checks."
  category="Finance"
  calculatorName="Gratuity Calculator"
  slug="gratuity-calculator"
  keywords={[
    'gratuity calculator',
    'simple gratuity calculator',
    'advanced gratuity calculator',
    'gratuity calculation formula',
    'payment of gratuity act 1972',
    'gratuity eligibility',
    'gratuity rounding rules',
    'gratuity calculator india',
    'gratuity tax exemption limit'
  ]}
>
  <div class="space-y-6">

    <!-- TAB SWITCHER: SIMPLE VS ADVANCED -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button
          type="button"
          id="tab-btn-simple"
          class="btn-grat-mode active shrink-0 rounded-xl bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5"
          data-mode="simple"
        >
          <span>⚡</span>
          <span>Simple Calculator</span>
          <span class="hidden sm:inline text-[10px] font-normal opacity-90">(Quick Salary & Tenure)</span>
        </button>
        <button
          type="button"
          id="tab-btn-adv"
          class="btn-grat-mode shrink-0 rounded-xl border border-slate-300 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-mode="advanced"
        >
          <span>⚙️</span>
          <span>Advanced Calculator</span>
          <span class="hidden sm:inline text-[10px] font-normal opacity-90">(DA, Situation & Breakdown)</span>
        </button>
      </div>
      <div id="mode-desc-text" class="mt-2 px-1 text-[11px] font-medium text-slate-500 dark:text-slate-400">
        Quick calculation using salary and service period
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- 1. SIMPLE GRATUITY CALCULATOR PANEL (Default)                     -->
    <!-- ================================================================= -->
    <div id="panel-simple-gratuity" class="space-y-6">
      
      <!-- SIMPLE QUICK PRESETS -->
      <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
            <span>⚡</span> Quick Presets:
          </span>
          <button type="button" class="btn-preset-simple rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-salary="60000" data-years="5" data-months="0">💼 ₹60k Salary, 5 Yrs (₹1,73,077)</button>
          <button type="button" class="btn-preset-simple rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-salary="50000" data-years="8" data-months="8">🚀 ₹50k Salary, 8y 8m (9 Yrs)</button>
          <button type="button" class="btn-preset-simple rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-salary="40000" data-years="7" data-months="6">⚖️ 7y 6m (≤ 6m: 7 Yrs)</button>
          <button type="button" class="btn-preset-simple rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-salary="40000" data-years="7" data-months="7">📈 7y 7m (&gt; 6m: 8 Yrs)</button>
          <button type="button" class="btn-preset-simple rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-salary="50000" data-years="4" data-months="0">⚠️ 4 Yrs (Warning Check)</button>
        </div>
      </div>

      <!-- SIMPLE FORM CONTAINER -->
      <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
        
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>⚡</span> Simple Gratuity Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Formula: <strong>Gratuity = (Monthly Salary × 15 × Eligible Years) ÷ 26</strong>
          </p>
        </div>

        <form id="form-simple-grat" class="mt-5 space-y-4" novalidate onsubmit="return false;">
          
          <!-- Simple Input 1: Monthly Salary (Basic + DA) -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <label for="inp-sim-salary" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                1. Monthly Salary (Basic + DA) (₹) <span class="text-red-500">*</span>
              </label>
              <div class="relative w-36 sm:w-44">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-bold text-slate-400">₹</span>
                <input
                  type="number"
                  id="inp-sim-salary"
                  value="60000"
                  step="1000"
                  min="0"
                  max="1000000"
                  class="w-full rounded-xl border border-slate-300 bg-white py-1.5 pl-7 pr-3 text-right text-sm font-bold text-slate-900 focus:border-blue-600 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
            </div>
            <input
              type="range"
              id="range-sim-salary"
              value="60000"
              min="1000"
              max="300000"
              step="1000"
              class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
              aria-label="Monthly Salary Range"
            />
            <div class="flex justify-between text-[11px] font-semibold text-slate-400">
              <span>₹1,000</span>
              <span>₹1,50,000</span>
              <span>₹3,00,000+</span>
            </div>
          </div>

          <!-- Simple Input 2: Years of Service -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <label for="inp-sim-years" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                2. Years of Service <span class="text-red-500">*</span>
              </label>
              <div class="relative w-28 sm:w-36">
                <input
                  type="number"
                  id="inp-sim-years"
                  value="5"
                  step="1"
                  min="0"
                  max="50"
                  class="w-full rounded-xl border border-slate-300 bg-white py-1.5 px-3 text-right text-sm font-bold text-slate-900 focus:border-blue-600 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
            </div>
            <input
              type="range"
              id="range-sim-years"
              value="5"
              min="0"
              max="40"
              step="1"
              class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
              aria-label="Years of Service Range"
            />
            <div class="flex justify-between text-[11px] font-semibold text-slate-400">
              <span>0 Years</span>
              <span>20 Years</span>
              <span>40 Years</span>
            </div>
          </div>

          <!-- Simple Input 3: Additional Months of Service -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <label for="inp-sim-months" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  3. Additional Months of Service
                </label>
                <div class="text-[11px] font-normal text-slate-500 dark:text-slate-400">
                  &gt; 6 months rounds up to next full year; &le; 6 months does not round up
                </div>
              </div>
              <div class="relative w-28 sm:w-36">
                <input
                  type="number"
                  id="inp-sim-months"
                  value="0"
                  step="1"
                  min="0"
                  max="11"
                  class="w-full rounded-xl border border-slate-300 bg-white py-1.5 px-3 text-right text-sm font-bold text-slate-900 focus:border-blue-600 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
            </div>
            <input
              type="range"
              id="range-sim-months"
              value="0"
              min="0"
              max="11"
              step="1"
              class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
              aria-label="Additional Months Range"
            />
            <div class="flex justify-between text-[11px] font-semibold text-slate-400">
              <span>0 Months</span>
              <span>6 Months</span>
              <span>11 Months</span>
            </div>
          </div>

          <!-- BUTTONS -->
          <div class="flex items-center gap-2 pt-2">
            <button
              type="submit"
              id="btn-calc-simple"
              class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer text-center"
            >
              Calculate Gratuity →
            </button>
            <button
              type="button"
              id="btn-clear-simple"
              class="rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Clear (✕)
            </button>
          </div>

          <p id="err-sim" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>

        <!-- SIMPLE RESULTS CONTAINER (Hidden until button is clicked) -->
        <div id="sim-results-section" class="hidden mt-6 space-y-4">
          
          <!-- Highlight Card -->
          <div class="overflow-hidden rounded-3xl border border-emerald-200 bg-linear-to-br from-white via-emerald-50/40 to-emerald-100/50 p-5 shadow-lg shadow-emerald-500/5 dark:border-emerald-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-emerald-950/30 sm:p-7">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-emerald-200/80 pb-4 dark:border-slate-800">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Estimated Gratuity Amount</span>
                <div id="res-sim-amount" class="mt-1 text-4xl sm:text-5xl font-black text-emerald-600 dark:text-emerald-400">
                  ₹ 1,73,076.92
                </div>
              </div>
              <div class="sm:text-right">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Eligible Years Used:</span>
                <div id="res-sim-eligible-years" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
                  5 Years
                </div>
              </div>
            </div>

            <!-- Eligibility Notice Banner if < 5 years -->
            <div id="banner-sim-warning" class="hidden mt-4 rounded-xl p-3.5 text-xs font-semibold bg-amber-50 border border-amber-300 dark:bg-amber-950/40 dark:border-amber-900/60 text-amber-900 dark:text-amber-200">
              <!-- Dynamically populated -->
            </div>

            <!-- 4 Required Metrics Row -->
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3.5 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Monthly Salary</div>
                <div id="res-sim-salary" class="mt-1 text-base font-bold text-slate-900 dark:text-white">₹ 60,000</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3.5 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Actual Service Duration</div>
                <div id="res-sim-duration" class="mt-1 text-base font-bold text-slate-900 dark:text-white">5 Years 0 Months</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3.5 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Formula Applied</div>
                <div id="res-sim-formula" class="mt-1 text-xs font-mono font-bold text-blue-600 dark:text-blue-400">(60,000 × 15 × 5) ÷ 26</div>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- ================================================================= -->
    <!-- 2. ADVANCED GRATUITY CALCULATOR PANEL (Tab 2)                      -->
    <!-- ================================================================= -->
    <div id="panel-adv-gratuity" class="hidden space-y-6">
      
      <!-- ADVANCED QUICK PRESETS -->
      <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
            <span>⚡</span> Presets:
          </span>
          <button type="button" class="btn-preset-adv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-basic="50000" data-da="0" data-years="8" data-months="8" data-sit="resignation">💼 ₹50k Basic, 8y 8m (9 Yrs, ₹2,59,615)</button>
          <button type="button" class="btn-preset-adv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-basic="40000" data-da="5000" data-years="10" data-months="7" data-sit="retirement">🚀 ₹40k Basic + ₹5k DA, 10y 7m (11 Yrs)</button>
          <button type="button" class="btn-preset-adv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-basic="50000" data-da="0" data-years="4" data-months="0" data-sit="resignation">⚠️ 4 Yrs (Resignation Warning)</button>
          <button type="button" class="btn-preset-adv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-basic="50000" data-da="0" data-years="3" data-months="6" data-sit="disability">🕊️ 3.5 Yrs (Death/Disability Waiver)</button>
        </div>
      </div>

      <!-- ADVANCED FORM CONTAINER -->
      <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
        
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>⚙️</span> Advanced Gratuity Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Comprehensive calculation with itemized Basic Salary, Dearness Allowance (DA), employment situation, daily wage basis, and tax status.
          </p>
        </div>

        <form id="form-adv-grat" class="mt-5 space-y-4" novalidate onsubmit="return false;">
          
          <!-- ADV ROW 1: BASIC SALARY & DA -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <!-- 1. Basic Salary -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-adv-basic" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  1. Basic Salary (₹ / mo) <span class="text-red-500">*</span>
                </label>
                <input
                  type="number"
                  id="inp-adv-basic"
                  value="50000"
                  step="1000"
                  min="0"
                  class="w-32 rounded-xl border border-slate-300 bg-white py-1.5 px-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
              <input
                type="range"
                id="range-adv-basic"
                value="50000"
                min="1000"
                max="300000"
                step="1000"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
                aria-label="Basic Salary Range"
              />
            </div>

            <!-- 2. Dearness Allowance (DA) -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-adv-da" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  2. Dearness Allowance (DA) (₹ / mo)
                </label>
                <input
                  type="number"
                  id="inp-adv-da"
                  value="0"
                  step="500"
                  min="0"
                  class="w-32 rounded-xl border border-slate-300 bg-white py-1.5 px-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
              <input
                type="range"
                id="range-adv-da"
                value="0"
                min="0"
                max="100000"
                step="500"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
                aria-label="Dearness Allowance Range"
              />
            </div>
          </div>

          <!-- ADV ROW 2: SERVICE DURATION -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <!-- 3. Years of Service -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-adv-years" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  3. Years of Service <span class="text-red-500">*</span>
                </label>
                <input
                  type="number"
                  id="inp-adv-years"
                  value="8"
                  step="1"
                  min="0"
                  max="50"
                  class="w-24 rounded-xl border border-slate-300 bg-white py-1.5 px-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
              <input
                type="range"
                id="range-adv-years"
                value="8"
                min="0"
                max="40"
                step="1"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
                aria-label="Advanced Years of Service Range"
              />
            </div>

            <!-- 4. Additional Months -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <div>
                  <label for="inp-adv-months" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    4. Additional Months
                  </label>
                  <div class="text-[10px] text-slate-500">&gt; 6m rounds up; &le; 6m does not</div>
                </div>
                <input
                  type="number"
                  id="inp-adv-months"
                  value="8"
                  step="1"
                  min="0"
                  max="11"
                  class="w-24 rounded-xl border border-slate-300 bg-white py-1.5 px-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
              <input
                type="range"
                id="range-adv-months"
                value="8"
                min="0"
                max="11"
                step="1"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
                aria-label="Advanced Additional Months Range"
              />
            </div>
          </div>

          <!-- ADV ROW 3: 5. EMPLOYMENT SITUATION -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
            <label for="sel-adv-situation" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              5. Employment Situation / Reason for Exit <span class="text-red-500">*</span>
            </label>
            <select
              id="sel-adv-situation"
              class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
            >
              <option value="resignation" selected>Resignation (Standard 5-Year Rule applies)</option>
              <option value="retirement">Retirement / Superannuation (Standard 5-Year Rule applies)</option>
              <option value="termination">Termination (Standard 5-Year Rule applies)</option>
              <option value="death">Death of Employee (5-Year Rule Waived)</option>
              <option value="disability">Permanent Disability due to accident/disease (5-Year Rule Waived)</option>
            </select>
