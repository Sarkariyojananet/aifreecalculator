<script is:inline>
  // State
  let lastCalculatedMortgage = null;
  let activeScheduleView = 'yearly'; // 'yearly' | 'monthly'

  // DOM Elements
  const inpMgPrice = document.getElementById('inp-mg-price');
  const inpMgDown = document.getElementById('inp-mg-down');
  const inpMgDownPct = document.getElementById('inp-mg-down-pct-input');
  const lblMgDownPct = document.getElementById('lbl-mg-down-pct');
  const txtMgLoanAmt = document.getElementById('txt-mg-loan-amt');

  const inpMgRate = document.getElementById('inp-mg-rate');
  const inpMgTerm = document.getElementById('inp-mg-term');
  const selMgTermUnit = document.getElementById('sel-mg-term-unit');

  const inpMgTax = document.getElementById('inp-mg-tax');
  const inpMgIns = document.getElementById('inp-mg-ins');
  const inpMgPmi = document.getElementById('inp-mg-pmi');
  const inpMgHoa = document.getElementById('inp-mg-hoa');

  const inpMgExtraMo = document.getElementById('inp-mg-extra-mo');
  const inpMgExtraYr = document.getElementById('inp-mg-extra-yr');
  const inpMgExtraOnce = document.getElementById('inp-mg-extra-once');

  const btnCalcMg = document.getElementById('btn-calc-mg');
  const btnClearMg = document.getElementById('btn-clear-mg');
  const errMg = document.getElementById('err-mg');

  // Results Elements
  const mgResultsSection = document.getElementById('mg-results-section');
  const resMgTotalMo = document.getElementById('res-mg-total-mo');
  const resMgPiMo = document.getElementById('res-mg-pi-mo');
  const resMgLoan = document.getElementById('res-mg-loan');
  const resMgTotalInt = document.getElementById('res-mg-total-int');
  const resMgTotalRepaid = document.getElementById('res-mg-total-repaid');
  const resMgPayoffDate = document.getElementById('res-mg-payoff-date');

  const barMgPrincipal = document.getElementById('bar-mg-principal');
  const barMgInterest = document.getElementById('bar-mg-interest');
  const lblChartPrincipal = document.getElementById('lbl-chart-principal');
  const lblChartInterest = document.getElementById('lbl-chart-interest');

  const cardMgExtraComparison = document.getElementById('card-mg-extra-comparison');
  const resMgIntSaved = document.getElementById('res-mg-int-saved');
  const resMgTimeSaved = document.getElementById('res-mg-time-saved');
  const resMgNewDuration = document.getElementById('res-mg-new-duration');
  const resMgNewInt = document.getElementById('res-mg-new-int');

  const tabMgYearly = document.getElementById('tab-mg-yearly');
  const tabMgMonthly = document.getElementById('tab-mg-monthly');
  const btnMgDownloadPdf = document.getElementById('btn-mg-download-pdf');
  const txtBtnMgPdf = document.getElementById('txt-btn-mg-pdf');

  const mgSchedThead = document.getElementById('mg-sched-thead');
  const mgSchedTbody = document.getElementById('mg-sched-tbody');

  // Currency Formatter
  function formatINR(val) {
    return `₹ ${Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  // Down Payment Sync
  function syncDownPaymentFromAmount() {
    const price = parseFloat(inpMgPrice.value) || 0;
    const downAmt = parseFloat(inpMgDown.value) || 0;
    if (price > 0) {
      const pct = Math.min(100, (downAmt / price) * 100);
      inpMgDownPct.value = pct.toFixed(1);
      lblMgDownPct.textContent = `${pct.toFixed(1)}%`;
      const loan = Math.max(0, price - downAmt);
      txtMgLoanAmt.textContent = `₹ ${loan.toLocaleString('en-IN')} (${(100 - pct).toFixed(1)}% Financed)`;
    }
  }

  function syncDownPaymentFromPct() {
    const price = parseFloat(inpMgPrice.value) || 0;
    const pct = parseFloat(inpMgDownPct.value) || 0;
    if (price > 0) {
      const downAmt = Math.round((price * pct) / 100);
      inpMgDown.value = downAmt;
      lblMgDownPct.textContent = `${pct.toFixed(1)}%`;
      const loan = Math.max(0, price - downAmt);
      txtMgLoanAmt.textContent = `₹ ${loan.toLocaleString('en-IN')} (${(100 - pct).toFixed(1)}% Financed)`;
    }
  }

  inpMgPrice.addEventListener('input', syncDownPaymentFromAmount);
  inpMgDown.addEventListener('input', syncDownPaymentFromAmount);
  inpMgDownPct.addEventListener('input', syncDownPaymentFromPct);

  // Quick Term Buttons
  document.querySelectorAll('.btn-mg-quick-term').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-mg-quick-term').forEach((b) => {
        b.className = 'btn-mg-quick-term rounded-md border border-slate-300 bg-white px-2 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer';
      });
      btn.className = 'btn-mg-quick-term active rounded-md bg-blue-600 px-2 py-0.5 font-bold text-white shadow-2xs cursor-pointer';
      inpMgTerm.value = btn.getAttribute('data-years');
      selMgTermUnit.value = 'years';
    });
  });

  // Calculate Mortgage Logic
  function executeMortgageCalculation() {
    errMg.classList.add('hidden');

    const price = parseFloat(inpMgPrice.value) || 0;
    const downAmt = parseFloat(inpMgDown.value) || 0;
    const rateAnnual = parseFloat(inpMgRate.value) || 0;
    const termVal = parseFloat(inpMgTerm.value) || 0;
    const termUnit = selMgTermUnit.value; // 'years' | 'months'

    const taxAnnual = parseFloat(inpMgTax.value) || 0;
    const insAnnual = parseFloat(inpMgIns.value) || 0;
    const pmiMonthly = parseFloat(inpMgPmi.value) || 0;
    const hoaMonthly = parseFloat(inpMgHoa.value) || 0;

    const extraMo = parseFloat(inpMgExtraMo.value) || 0;
    const extraYr = parseFloat(inpMgExtraYr.value) || 0;
    const extraOnce = parseFloat(inpMgExtraOnce.value) || 0;

    if (price <= 0) {
      errMg.textContent = 'Please enter a valid home price greater than 0.';
      errMg.classList.remove('hidden');
      mgResultsSection.classList.add('hidden');
      return;
    }

    if (downAmt >= price) {
      errMg.textContent = 'Down payment cannot equal or exceed the home purchase price.';
      errMg.classList.remove('hidden');
      mgResultsSection.classList.add('hidden');
      return;
    }

    if (rateAnnual < 0) {
      errMg.textContent = 'Interest rate cannot be negative.';
      errMg.classList.remove('hidden');
      mgResultsSection.classList.add('hidden');
      return;
    }

    if (termVal <= 0) {
      errMg.textContent = 'Loan term must be greater than 0.';
      errMg.classList.remove('hidden');
      mgResultsSection.classList.add('hidden');
      return;
    }

    const loanAmount = price - downAmt;
    const totalMonths = termUnit === 'years' ? Math.round(termVal * 12) : Math.round(termVal);
    const r = rateAnnual / 12 / 100;

    // Monthly P&I
    let monthlyPI = 0;
    if (r === 0) {
      monthlyPI = loanAmount / totalMonths;
    } else {
      const factor = Math.pow(1 + r, totalMonths);
      monthlyPI = (loanAmount * r * factor) / (factor - 1);
    }

    const monthlyTax = taxAnnual / 12;
    const monthlyIns = insAnnual / 12;
    const totalMonthlyPayment = monthlyPI + monthlyTax + monthlyIns + pmiMonthly + hoaMonthly;

    // Original baseline total interest without extra payments
    const originalTotalInterest = r > 0 ? (monthlyPI * totalMonths - loanAmount) : 0;

    // Amortization Simulation
    const yearlySchedule = [];
    const monthlySchedule = [];

    let balance = loanAmount;
    let totalInterestPaid = 0;
    let totalPrincipalPaid = 0;
    let totalExtraPaid = 0;

    let currentYear = 1;
    let yearOpeningBalance = balance;
    let yearPrincipal = 0;
    let yearInterest = 0;
    let yearExtra = 0;
    let yearTotalPaid = 0;

    let month = 1;
    const maxSafety = totalMonths * 2;

    while (balance > 0.001 && month <= maxSafety) {
      const monthOpening = balance;
      const monthInterest = r > 0 ? balance * r : 0;

      let regularPrincipal = Math.min(balance, monthlyPI - monthInterest);
      if (regularPrincipal < 0) regularPrincipal = 0;

      let schedPayment = regularPrincipal + monthInterest;

      let extraThisMonth = extraMo;
      if (extraYr > 0 && month % 12 === 1) extraThisMonth += extraYr;
      if (extraOnce > 0 && month === 1) extraThisMonth += extraOnce;

      const remAfterRegular = Math.max(0, balance - regularPrincipal);
      extraThisMonth = Math.min(remAfterRegular, extraThisMonth);

      const totalPrincipalThisMonth = regularPrincipal + extraThisMonth;
      const totalPaymentThisMonth = schedPayment + extraThisMonth;

      balance = Math.max(0, balance - totalPrincipalThisMonth);

      totalInterestPaid += monthInterest;
      totalPrincipalPaid += regularPrincipal;
      totalExtraPaid += extraThisMonth;

      yearPrincipal += regularPrincipal;
      yearInterest += monthInterest;
      yearExtra += extraThisMonth;
      yearTotalPaid += totalPaymentThisMonth;

      monthlySchedule.push({
        paymentNumber: month,
        monthIndex: month,
        openingBalance: monthOpening,
        scheduledPayment: schedPayment,
        principalPaid: regularPrincipal,
        interestPaid: monthInterest,
        extraPayment: extraThisMonth,
        totalPayment: totalPaymentThisMonth,
        closingBalance: balance,
      });

      if (month % 12 === 0 || balance <= 0.001) {
        yearlySchedule.push({
          year: currentYear,
          openingBalance: yearOpeningBalance,
          principalPaid: yearPrincipal,
          interestPaid: yearInterest,
          extraPaid: yearExtra,
          totalPaid: yearTotalPaid,
          closingBalance: balance,
        });

        currentYear++;
        yearOpeningBalance = balance;
        yearPrincipal = 0;
        yearInterest = 0;
        yearExtra = 0;
        yearTotalPaid = 0;
      }

      if (balance <= 0.001) break;
      month++;
    }

    const actualPaymentsCount = monthlySchedule.length;
    const interestSaved = Math.max(0, originalTotalInterest - totalInterestPaid);
    const monthsSaved = Math.max(0, totalMonths - actualPaymentsCount);
    const yearsSaved = Math.floor(monthsSaved / 12);
    const remMonthsSaved = monthsSaved % 12;

    const today = new Date();
    const payoffDate = new Date(today.getFullYear(), today.getMonth() + actualPaymentsCount, 1);
    const payoffMonthStr = payoffDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

    // Save calculation state
    lastCalculatedMortgage = {
      price,
      downAmt,
      downPct: ((downAmt / price) * 100).toFixed(1),
      loanAmount,
      rateAnnual,
      termVal,
      termUnit,
      totalMonths,
      monthlyPI,
      monthlyTax,
      monthlyIns,
      pmiMonthly,
      hoaMonthly,
      totalMonthlyPayment,
      totalInterestPaid,
      totalPrincipalPaid: totalPrincipalPaid + totalExtraPaid,
      totalAmountRepaid: loanAmount + totalInterestPaid,
      payoffDateStr: payoffMonthStr,
      hasExtraPayments: (extraMo > 0 || extraYr > 0 || extraOnce > 0),
      interestSaved,
      monthsSaved,
      timeSavedStr: `${yearsSaved} Yrs ${remMonthsSaved} Mos`,
      actualPaymentsCount,
      yearlySchedule,
      monthlySchedule,
    };

    // Update Result Card
    resMgTotalMo.textContent = formatINR(totalMonthlyPayment);
    resMgPiMo.textContent = formatINR(monthlyPI);
    resMgLoan.textContent = formatINR(loanAmount);
    resMgTotalInt.textContent = formatINR(totalInterestPaid);
    resMgTotalRepaid.textContent = formatINR(lastCalculatedMortgage.totalAmountRepaid);
    resMgPayoffDate.textContent = payoffMonthStr;

    // Update Chart
    const totalPie = lastCalculatedMortgage.totalAmountRepaid > 0 ? lastCalculatedMortgage.totalAmountRepaid : 1;
    const principalPct = ((loanAmount / totalPie) * 100).toFixed(1);
    const interestPct = ((totalInterestPaid / totalPie) * 100).toFixed(1);

    barMgPrincipal.style.width = `${principalPct}%`;
    barMgInterest.style.width = `${interestPct}%`;

    lblChartPrincipal.textContent = `Principal: ${formatINR(loanAmount)} (${principalPct}%)`;
    lblChartInterest.textContent = `Total Interest: ${formatINR(totalInterestPaid)} (${interestPct}%)`;

    // Extra Payments Drawer
    if (lastCalculatedMortgage.hasExtraPayments && monthsSaved > 0) {
      cardMgExtraComparison.classList.remove('hidden');
      resMgIntSaved.textContent = formatINR(interestSaved);
      resMgTimeSaved.textContent = lastCalculatedMortgage.timeSavedStr;
      resMgNewDuration.textContent = `${(actualPaymentsCount / 12).toFixed(1)} Years (${actualPaymentsCount} Mos)`;
      resMgNewInt.textContent = formatINR(totalInterestPaid);
    } else {
      cardMgExtraComparison.classList.add('hidden');
    }

    // Render Table
    renderScheduleTable();

    mgResultsSection.classList.remove('hidden');
  }

  // Render Active Schedule Table
  function renderScheduleTable() {
    if (!lastCalculatedMortgage) return;

    if (activeScheduleView === 'yearly') {
      mgSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Year</th>
          <th class="p-2.5 text-right">Opening Balance</th>
          <th class="p-2.5 text-right">Principal Paid</th>
          <th class="p-2.5 text-right">Interest Paid</th>
          <th class="p-2.5 text-right">Extra Paid</th>
          <th class="p-2.5 text-right">Total Payment</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Closing Balance</th>
        </tr>
      `;

      mgSchedTbody.innerHTML = lastCalculatedMortgage.yearlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Year ${row.year}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-semibold">${formatINR(row.principalPaid)}</td>
          <td class="p-2.5 text-right text-red-600 dark:text-red-400 font-semibold">${formatINR(row.interestPaid)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatINR(row.extraPaid)}</td>
          <td class="p-2.5 text-right text-slate-900 dark:text-white font-bold">${formatINR(row.totalPaid)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    } else {
      mgSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Payment #</th>
          <th class="p-2.5 text-right">Opening Balance</th>
          <th class="p-2.5 text-right">Scheduled P&I</th>
          <th class="p-2.5 text-right">Principal</th>
          <th class="p-2.5 text-right">Interest</th>
          <th class="p-2.5 text-right">Extra Payment</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Closing Balance</th>
        </tr>
      `;

      mgSchedTbody.innerHTML = lastCalculatedMortgage.monthlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Month ${row.paymentNumber}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right text-slate-900 dark:text-white font-semibold">${formatINR(row.scheduledPayment)}</td>
          <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-semibold">${formatINR(row.principalPaid)}</td>
          <td class="p-2.5 text-right text-red-600 dark:text-red-400 font-semibold">${formatINR(row.interestPaid)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatINR(row.extraPayment)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    }
  }

  // Switch Schedule Tabs
  tabMgYearly.addEventListener('click', () => {
    activeScheduleView = 'yearly';
    tabMgYearly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabMgMonthly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  tabMgMonthly.addEventListener('click', () => {
    activeScheduleView = 'monthly';
    tabMgMonthly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabMgYearly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  btnCalcMg.addEventListener('click', executeMortgageCalculation);

  btnClearMg.addEventListener('click', () => {
    inpMgPrice.value = '5000000';
    inpMgDown.value = '1000000';
    inpMgDownPct.value = '20';
    inpMgRate.value = '8.5';
    inpMgTerm.value = '20';
    selMgTermUnit.value = 'years';
    inpMgTax.value = '0';
    inpMgIns.value = '0';
    inpMgPmi.value = '0';
    inpMgHoa.value = '0';
    inpMgExtraMo.value = '0';
    inpMgExtraYr.value = '0';
    inpMgExtraOnce.value = '0';
    errMg.classList.add('hidden');
    mgResultsSection.classList.add('hidden');
    lastCalculatedMortgage = null;
    activeScheduleView = 'yearly';
    tabMgYearly.click();
    syncDownPaymentFromAmount();
  });

  // Preset Buttons Listener
  document.querySelectorAll('.btn-mg-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const price = btn.getAttribute('data-price');
      const down = btn.getAttribute('data-down');
      const rate = btn.getAttribute('data-rate');
      const term = btn.getAttribute('data-term');
      const extra = btn.getAttribute('data-extra');

      if (price) inpMgPrice.value = price;
      if (down) inpMgDown.value = down;
      if (rate) inpMgRate.value = rate;
      if (term) inpMgTerm.value = term;
      if (extra) inpMgExtraMo.value = extra;

      syncDownPaymentFromAmount();
    });
  });

  // Enter Key Listener
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeMortgageCalculation();
        }
      });
    });
  });

  // Tab-Selective PDF Download
  async function generateMgPdf() {
    if (!lastCalculatedMortgage) {
      alert('Please calculate your mortgage first.');
      return;
    }

    btnMgDownloadPdf.disabled = true;
    const originalText = txtBtnMgPdf.textContent;
    txtBtnMgPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      const pdfTitle = activeScheduleView === 'yearly'
        ? 'Mortgage Loan Amortization – Yearly Summary'
        : 'Mortgage Loan Amortization – Monthly Schedule';

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(pdfTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 28, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('MORTGAGE LOAN SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);
      doc.text(`Home Price: Rs. ${lastCalculatedMortgage.price.toLocaleString('en-IN')}`, 18, 44);
      doc.text(`Down Payment: Rs. ${lastCalculatedMortgage.downAmt.toLocaleString('en-IN')} (${lastCalculatedMortgage.downPct}%)`, 18, 49);
      doc.text(`Loan Principal: Rs. ${lastCalculatedMortgage.loanAmount.toLocaleString('en-IN')}`, 18, 54);
      doc.text(`Interest Rate: ${lastCalculatedMortgage.rateAnnual}% p.a.`, 18, 59);

      doc.text(`Tenure: ${lastCalculatedMortgage.termVal} ${lastCalculatedMortgage.termUnit}`, 85, 44);
      doc.text(`Monthly P&I: Rs. ${lastCalculatedMortgage.monthlyPI.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 85, 49);
      doc.text(`Total Monthly Payment: Rs. ${lastCalculatedMortgage.totalMonthlyPayment.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 85, 54);
      doc.text(`Payoff Date: ${lastCalculatedMortgage.payoffDateStr}`, 85, 59);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(220, 38, 38);
      doc.text(`Total Interest: Rs. ${lastCalculatedMortgage.totalInterestPaid.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 140, 46);
      doc.setTextColor(37, 99, 235);
      doc.text(`Total Repaid: Rs. ${lastCalculatedMortgage.totalAmountRepaid.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 140, 52);

      // 4. Tab-Selective Table Data Generation
      let tableHead = [];
      let tableData = [];

      if (activeScheduleView === 'yearly') {
        tableHead = [['Year', 'Opening Bal', 'Principal Paid', 'Interest Paid', 'Extra Paid', 'Total Payment', 'Closing Balance']];
        tableData = lastCalculatedMortgage.yearlySchedule.map((r) => [
          `Year ${r.year}`,
          'Rs. ' + r.openingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.principalPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.interestPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.extraPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.totalPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.closingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        ]);
      } else {
        tableHead = [['Month', 'Opening Balance', 'Scheduled P&I', 'Principal', 'Interest', 'Extra Paid', 'Closing Balance']];
        tableData = lastCalculatedMortgage.monthlySchedule.map((r) => [
          `Month ${r.paymentNumber}`,
          'Rs. ' + r.openingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.scheduledPayment.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.principalPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.interestPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.extraPayment.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.closingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        ]);
      }

      doc.autoTable({
        startY: 65,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { cellWidth: 22, halign: 'left', fontStyle: 'bold' },
          1: { halign: 'right' },
          2: { halign: 'right' },
          3: { halign: 'right', textColor: [220, 38, 38] },
          4: { halign: 'right', textColor: [16, 185, 129] },
          5: { halign: 'right' },
          6: { halign: 'right', fontStyle: 'bold', textColor: [37, 99, 235] }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const today = new Date().toISOString().split('T')[0];
      const filename = activeScheduleView === 'yearly'
        ? `mortgage-yearly-summary-${today}.pdf`
        : `mortgage-monthly-schedule-${today}.pdf`;

      doc.save(filename);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnMgDownloadPdf.disabled = false;
      txtBtnMgPdf.textContent = originalText;
    }
  }

  btnMgDownloadPdf.addEventListener('click', generateMgPdf);
</script>
