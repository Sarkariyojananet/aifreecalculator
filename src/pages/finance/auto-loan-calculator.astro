      setCalculationType(mode);

      const price = btn.getAttribute('data-price');
      const down = btn.getAttribute('data-down');
      const trade = btn.getAttribute('data-trade');
      const disc = btn.getAttribute('data-disc');
      const tax = btn.getAttribute('data-tax');
      const rate = btn.getAttribute('data-rate');
      const term = btn.getAttribute('data-term');
      const extra = btn.getAttribute('data-extra');

      if (mode === 'refinance') {
        if (price) inpRefBalance.value = price;
        if (tax) inpRefFees.value = tax;
        const curPay = btn.getAttribute('data-curpay');
        const curRate = btn.getAttribute('data-currate');
        if (curPay) inpRefCurPay.value = curPay;
        if (curRate) inpRefCurRate.value = curRate;
      } else {
        if (price) inpAutoPrice.value = price;
