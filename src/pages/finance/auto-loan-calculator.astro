---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Auto & Car Loan Calculator – Calculate EMI, Interest & Repayment"
  description="Estimate your monthly car loan payment, total interest, and repayment schedule based on your vehicle price, down payment, interest rate, and loan term."
  category="Finance"
  calculatorName="Auto & Car Loan Calculator"
  slug="auto-loan-calculator"
  keywords={[
    'auto & car loan calculator',
    'used car loan calculator',
    'simple car loan calculator',
    'refinance car loan calculator',
    'sbi car loan calculator',
    'hdfc car loan calculator',
    'car loan calculator emi',
    'emi car loan calculator',
    'auto loan calculator',
    'vehicle loan payment',
    'car payment calculator'
  ]}
>
  <div class="space-y-6">

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-auto-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="new" data-price="1000000" data-down="200000" data-trade="0" data-disc="0" data-tax="0" data-rate="8.5" data-term="60" data-extra="0">🚗 New Car 5-Yr (₹10L, 20% Down @ 8.5%)</button>
        <button type="button" class="btn-auto-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="used" data-price="600000" data-down="100000" data-trade="50000" data-disc="0" data-tax="0" data-rate="11.0" data-term="36" data-extra="0">🚙 Used Car 3-Yr (₹6L, ₹1.5L Down+Trade @ 11%)</button>
        <button type="button" class="btn-auto-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="new" data-price="1800000" data-down="360000" data-trade="100000" data-disc="25000" data-tax="0" data-rate="8.75" data-term="84" data-extra="0">🚘 Premium SUV 7-Yr (₹18L @ 8.75%)</button>
        <button type="button" class="btn-auto-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="refinance" data-price="500000" data-down="0" data-trade="0" data-disc="0" data-tax="5000" data-rate="8.25" data-term="48" data-extra="0" data-currate="10.5" data-curpay="12800">🔄 Auto Refinance (₹5L from 10.5% to 8.25%)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🚗</span> Auto & Car Loan Calculator
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Calculate your monthly car loan EMI, total interest, amortization schedule, and prepayment savings.
            </p>
          </div>

          <!-- LOAN TYPE SELECTOR -->
          <div class="inline-flex rounded-2xl border border-slate-300 bg-white p-1 shadow-2xs dark:border-slate-700 dark:bg-slate-900 text-xs font-bold shrink-0">
            <button type="button" id="tab-type-new" class="type-tab-btn active rounded-xl bg-blue-600 px-3 py-1.5 text-white shadow-xs transition cursor-pointer" data-mode="new">
              🚗 New Car Loan
            </button>
            <button type="button" id="tab-type-used" class="type-tab-btn rounded-xl px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition cursor-pointer" data-mode="used">
              🚙 Used Car Loan
            </button>
            <button type="button" id="tab-type-refinance" class="type-tab-btn rounded-xl px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition cursor-pointer" data-mode="refinance">
              🔄 Car Loan Refinance
            </button>
          </div>
        </div>
      </div>

      <form id="form-auto-loan" class="mt-5 space-y-4" novalidate onsubmit="return false;">
        
        <!-- SECTION 1: PURCHASE INPUTS (NEW / USED CAR) -->
        <div id="section-purchase-inputs" class="space-y-4">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            
            <!-- Vehicle Purchase Price -->
            <div>
              <label for="inp-auto-price" id="lbl-auto-price" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Vehicle Purchase Price (₹)
              </label>
              <input type="number" id="inp-auto-price" value="1000000" step="10000" min="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10,00,000" />
            </div>

            <!-- Down Payment (Amount & Sync %) -->
            <div>
              <div class="flex items-center justify-between">
                <label for="inp-auto-down" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Down Payment (₹)</label>
                <span id="lbl-auto-down-pct" class="text-[11px] font-bold text-blue-600 dark:text-blue-400">20%</span>
              </div>
              <div class="mt-1.5 flex rounded-xl border border-slate-300 bg-white dark:border-slate-700 dark:bg-slate-800">
                <input type="number" id="inp-auto-down" value="200000" step="5000" min="0" class="w-full rounded-l-xl border-0 p-2.5 text-sm font-bold text-slate-900 focus:ring-0 dark:bg-slate-800 dark:text-white" placeholder="2,00,000" />
                <input type="number" id="inp-auto-down-pct-input" value="20" min="0" max="100" step="0.5" class="w-16 rounded-r-xl border-l border-slate-300 bg-slate-50 p-2 text-center text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300" title="Down payment percentage (%)" />
              </div>
            </div>

            <!-- Trade-In Value (Optional) -->
            <div>
              <label for="inp-auto-trade" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Trade-In Allowance (₹) <span class="text-slate-400 font-normal lowercase">(optional)</span></label>
              <input type="number" id="inp-auto-trade" value="0" step="5000" min="0" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>

          </div>

          <!-- OPTIONAL CREDITS & TAXES ACCORDION -->
          <details class="group rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
            <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              <span class="flex items-center gap-1.5">
                <span>🏷️</span> Optional Credits, Discounts & Financed Taxes/Fees
              </span>
              <span class="text-blue-600 dark:text-blue-400 font-semibold text-[11px] group-open:rotate-180 transition-transform">▼ Expand</span>
            </summary>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
              <div>
                <label for="inp-auto-disc" class="block font-bold text-slate-700 dark:text-slate-300">Manufacturer Rebates / Dealer Discounts (₹)</label>
                <input type="number" id="inp-auto-disc" value="0" step="1000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
              </div>
              <div>
                <label for="inp-auto-tax-fees" class="block font-bold text-slate-700 dark:text-slate-300">Financed Taxes, Registration & Processing Fees (₹)</label>
                <input type="number" id="inp-auto-tax-fees" value="0" step="1000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
              </div>
            </div>
          </details>

          <!-- ESTIMATED NET LOAN AMOUNT PREVIEW -->
          <div class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-blue-200 bg-blue-50/40 p-3 dark:border-blue-900/60 dark:bg-blue-950/20 text-xs">
            <div class="flex items-center gap-1.5 font-bold text-blue-800 dark:text-blue-300">
              <span>💳</span> Estimated Financed Loan Principal: 
              <span id="txt-auto-loan-calc-preview" class="font-black text-slate-900 dark:text-white ml-1">₹ 8,00,000 (80% Financed)</span>
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
              Formula: Price − Down − Trade − Discounts + Fees
            </div>
          </div>
        </div>

        <!-- SECTION 2: REFINANCE INPUTS (WHEN REFINANCE MODE IS ACTIVE) -->
        <div id="section-refinance-inputs" class="hidden space-y-4">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            
            <!-- Current Outstanding Balance -->
            <div>
              <label for="inp-ref-balance" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Current Outstanding Loan Balance (₹)
              </label>
              <input type="number" id="inp-ref-balance" value="500000" step="10000" min="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="5,00,000" />
            </div>

            <!-- Refinancing Fees -->
            <div>
              <label for="inp-ref-fees" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Refinancing / Processing Fees (₹) <span class="text-slate-400 font-normal lowercase">(optional)</span>
              </label>
              <input type="number" id="inp-ref-fees" value="0" step="1000" min="0" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>

            <!-- Cash Out Amount -->
            <div>
              <label for="inp-ref-cashout" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Cash-Out Amount (₹) <span class="text-slate-400 font-normal lowercase">(optional)</span>
              </label>
              <input type="number" id="inp-ref-cashout" value="0" step="10000" min="0" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>

          </div>

          <!-- OPTIONAL EXISTING LOAN DETAILS FOR COMPARISON -->
          <details class="group rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900" open>
            <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              <span class="flex items-center gap-1.5">
                <span>⚖️</span> Optional Existing Loan Details (For Side-by-Side Savings Comparison)
              </span>
              <span class="text-blue-600 dark:text-blue-400 font-semibold text-[11px] group-open:rotate-180 transition-transform">▼ Toggle</span>
            </summary>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
              <div>
                <label for="inp-ref-cur-pay" class="block font-bold text-slate-700 dark:text-slate-300">Current Monthly Payment (₹)</label>
                <input type="number" id="inp-ref-cur-pay" value="12800" step="100" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="12,800" />
              </div>
              <div>
                <label for="inp-ref-cur-rate" class="block font-bold text-slate-700 dark:text-slate-300">Existing Interest Rate (% p.a.)</label>
                <input type="number" id="inp-ref-cur-rate" value="10.5" step="0.1" min="0" max="40" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10.5" />
              </div>
            </div>
          </details>
        </div>

        <!-- SECTION 3: COMMON LOAN SETTINGS (INTEREST RATE, TERM, START DATE) -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          
          <!-- Annual Interest Rate -->
          <div>
            <label for="inp-auto-rate" id="lbl-auto-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Annual Interest Rate (% p.a.)
            </label>
            <input type="number" id="inp-auto-rate" value="8.5" step="0.1" min="0" max="40" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="8.5" />
          </div>

          <!-- Loan Term & Unit -->
          <div>
            <label for="inp-auto-term" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Loan Term / Tenure</label>
            <div class="mt-1.5 flex rounded-xl border border-slate-300 bg-white dark:border-slate-700 dark:bg-slate-800">
              <input type="number" id="inp-auto-term" value="60" step="1" min="1" max="120" class="w-full rounded-l-xl border-0 p-2.5 text-sm font-bold text-slate-900 focus:ring-0 dark:bg-slate-800 dark:text-white" placeholder="60" />
              <select id="sel-auto-term-unit" class="rounded-r-xl border-l border-slate-300 bg-slate-50 px-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 cursor-pointer">
                <option value="months" selected>Months</option>
                <option value="years">Years</option>
              </select>
            </div>
          </div>

          <!-- Optional Loan Start Date -->
          <div>
            <label for="inp-auto-start-date" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Loan Start Date</label>
            <input type="month" id="inp-auto-start-date" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>

        </div>

        <!-- QUICK TERM BUTTONS BAR -->
        <div class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-slate-200 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-900/60 text-xs">
          <span class="text-slate-600 dark:text-slate-400 font-bold flex items-center gap-1">
            <span>⏱️</span> Popular Car Loan Tenures:
          </span>
          <div class="flex flex-wrap items-center gap-1">
            <button type="button" class="btn-auto-quick-term rounded-md border border-slate-300 bg-white px-2 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="12">12 Mos (1Y)</button>
            <button type="button" class="btn-auto-quick-term rounded-md border border-slate-300 bg-white px-2 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="24">24 Mos (2Y)</button>
            <button type="button" class="btn-auto-quick-term rounded-md border border-slate-300 bg-white px-2 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="36">36 Mos (3Y)</button>
            <button type="button" class="btn-auto-quick-term rounded-md border border-slate-300 bg-white px-2 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="48">48 Mos (4Y)</button>
            <button type="button" class="btn-auto-quick-term active rounded-md bg-blue-600 px-2 py-0.5 font-bold text-white shadow-2xs cursor-pointer" data-months="60">60 Mos (5Y)</button>
            <button type="button" class="btn-auto-quick-term rounded-md border border-slate-300 bg-white px-2 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="72">72 Mos (6Y)</button>
            <button type="button" class="btn-auto-quick-term rounded-md border border-slate-300 bg-white px-2 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="84">84 Mos (7Y)</button>
          </div>
        </div>

        <!-- SECTION 4: EXTRA CAR LOAN PAYMENTS (ACCORDION) -->
        <details class="group rounded-2xl border border-emerald-200 bg-emerald-50/20 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/10">
          <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">
            <span class="flex items-center gap-1.5">
              <span>🚀</span> Extra Car Loan Payments (Prepayment & Principal Reductions)
            </span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-[11px] group-open:rotate-180 transition-transform">▼ Expand</span>
          </summary>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 mt-3 pt-3 border-t border-emerald-100 dark:border-emerald-900/40 text-xs">
            <div>
              <label for="inp-auto-extra-mo" class="block font-bold text-slate-700 dark:text-slate-300">Extra Monthly Payment (₹)</label>
              <input type="number" id="inp-auto-extra-mo" value="0" step="500" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>
            <div>
              <label for="inp-auto-extra-yr" class="block font-bold text-slate-700 dark:text-slate-300">Extra Annual Payment (₹)</label>
              <input type="number" id="inp-auto-extra-yr" value="0" step="5000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>
            <div>
              <label for="inp-auto-extra-once" class="block font-bold text-slate-700 dark:text-slate-300">One-Time Extra Payment (₹)</label>
              <input type="number" id="inp-auto-extra-once" value="0" step="10000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>
          </div>
        </details>

        <!-- ACTION BUTTONS (Calculate & Clear All) -->
        <div class="flex items-center gap-2 pt-2">
          <button type="submit" id="btn-calc-auto" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
            Calculate Car Loan →
          </button>
          <button type="button" id="btn-clear-auto" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
            Clear All (✕)
          </button>
        </div>

        <!-- ACCESSIBLE VALIDATION ERROR -->
        <p id="err-auto" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

      </form>

      <!-- RESULTS PRESENTATION SECTION (Hidden initially, displayed only upon Calculate) -->
      <div id="auto-results-section" class="hidden mt-6 space-y-6">
        
        <!-- 1. MAIN RESULT HIGHLIGHT CARD -->
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">ESTIMATED MONTHLY PAYMENT</span>
              <div id="res-auto-monthly-emi" class="mt-1 text-4xl sm:text-5xl font-black text-blue-600 dark:text-blue-400">₹ 16,413.48</div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Interest Payable:</span>
              <div id="res-auto-total-int" class="text-2xl sm:text-3xl font-black text-red-600 dark:text-red-400">₹ 1,84,809.00</div>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Estimated Loan Amount</div>
              <div id="res-auto-loan-amt" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹ 8,00,000</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Interest Rate</div>
              <div id="res-auto-rate-val" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">8.5% per year</div>
            </div>
