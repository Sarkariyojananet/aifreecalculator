<script is:inline>
  // State Management
  let currentLoanType = 'new'; // 'new' | 'used' | 'refinance'
  let lastCalculatedAutoLoan = null;
  let activeScheduleView = 'yearly'; // 'yearly' | 'monthly'

  // Type Switcher Tabs
  const tabTypeNew = document.getElementById('tab-type-new');
  const tabTypeUsed = document.getElementById('tab-type-used');
  const tabTypeRefinance = document.getElementById('tab-type-refinance');
  const typeTabBtns = [tabTypeNew, tabTypeUsed, tabTypeRefinance];

  const sectionPurchaseInputs = document.getElementById('section-purchase-inputs');
  const sectionRefinanceInputs = document.getElementById('section-refinance-inputs');

  const lblAutoPrice = document.getElementById('lbl-auto-price');
  const lblAutoRate = document.getElementById('lbl-auto-rate');

  // Purchase Inputs
  const inpAutoPrice = document.getElementById('inp-auto-price');
  const inpAutoDown = document.getElementById('inp-auto-down');
  const inpAutoDownPctInput = document.getElementById('inp-auto-down-pct-input');
  const lblAutoDownPct = document.getElementById('lbl-auto-down-pct');
  const inpAutoTrade = document.getElementById('inp-auto-trade');
  const inpAutoDisc = document.getElementById('inp-auto-disc');
  const inpAutoTaxFees = document.getElementById('inp-auto-tax-fees');
  const txtAutoLoanCalcPreview = document.getElementById('txt-auto-loan-calc-preview');

  // Refinance Inputs
  const inpRefBalance = document.getElementById('inp-ref-balance');
  const inpRefFees = document.getElementById('inp-ref-fees');
  const inpRefCashout = document.getElementById('inp-ref-cashout');
  const inpRefCurPay = document.getElementById('inp-ref-cur-pay');
  const inpRefCurRate = document.getElementById('inp-ref-cur-rate');

  // Common Loan Settings
  const inpAutoRate = document.getElementById('inp-auto-rate');
  const inpAutoTerm = document.getElementById('inp-auto-term');
  const selAutoTermUnit = document.getElementById('sel-auto-term-unit');
  const inpAutoStartDate = document.getElementById('inp-auto-start-date');

  // Extra Payments
  const inpAutoExtraMo = document.getElementById('inp-auto-extra-mo');
  const inpAutoExtraYr = document.getElementById('inp-auto-extra-yr');
  const inpAutoExtraOnce = document.getElementById('inp-auto-extra-once');

  // Buttons & Error
  const btnCalcAuto = document.getElementById('btn-calc-auto');
  const btnClearAuto = document.getElementById('btn-clear-auto');
  const errAuto = document.getElementById('err-auto');

  // Results Section
  const autoResultsSection = document.getElementById('auto-results-section');
  const resAutoMonthlyEmi = document.getElementById('res-auto-monthly-emi');
  const resAutoTotalInt = document.getElementById('res-auto-total-int');
  const resAutoLoanAmt = document.getElementById('res-auto-loan-amt');
  const resAutoRateVal = document.getElementById('res-auto-rate-val');
  const resAutoTotalPayable = document.getElementById('res-auto-total-payable');
  const resAutoPayoffDate = document.getElementById('res-auto-payoff-date');

  // Summary Elements
  const lblSumVehiclePrice = document.getElementById('lbl-sum-vehicle-price');
  const sumVehiclePrice = document.getElementById('sum-vehicle-price');
  const lblSumDownPayment = document.getElementById('lbl-sum-down-payment');
  const sumDownPayment = document.getElementById('sum-down-payment');
  const lblSumTradeDisc = document.getElementById('lbl-sum-trade-disc');
  const sumTradeDisc = document.getElementById('sum-trade-disc');
  const lblSumTaxesFees = document.getElementById('lbl-sum-taxes-fees');
  const sumTaxesFees = document.getElementById('sum-taxes-fees');
  const sumNetLoan = document.getElementById('sum-net-loan');
  const sumLoanTerm = document.getElementById('sum-loan-term');
  const sumTotalInterest = document.getElementById('sum-total-interest');
  const sumTotalOutOfPocket = document.getElementById('sum-total-out-of-pocket');

  // Chart Elements
  const barAutoPrincipal = document.getElementById('bar-auto-principal');
  const barAutoInterest = document.getElementById('bar-auto-interest');
  const lblChartPrincipal = document.getElementById('lbl-chart-principal');
  const lblChartInterest = document.getElementById('lbl-chart-interest');

  // Extra Payments Card
  const cardAutoExtraComparison = document.getElementById('card-auto-extra-comparison');
  const resAutoIntSaved = document.getElementById('res-auto-int-saved');
  const resAutoTimeSaved = document.getElementById('res-auto-time-saved');
  const resAutoNewDuration = document.getElementById('res-auto-new-duration');
  const resAutoNewInt = document.getElementById('res-auto-new-int');

  // Refinance Comparison Card
  const cardAutoRefinanceComparison = document.getElementById('card-auto-refinance-comparison');
  const cmpCurPay = document.getElementById('cmp-cur-pay');
  const cmpCurRate = document.getElementById('cmp-cur-rate');
  const cmpCurInt = document.getElementById('cmp-cur-int');
  const cmpNewPay = document.getElementById('cmp-new-pay');
  const cmpNewRate = document.getElementById('cmp-new-rate');
  const cmpNewInt = document.getElementById('cmp-new-int');
  const cmpNetSavings = document.getElementById('cmp-net-savings');
  const cmpMoSavings = document.getElementById('cmp-mo-savings');

  // Schedule Table Elements
  const tabAutoYearly = document.getElementById('tab-auto-yearly');
  const tabAutoMonthly = document.getElementById('tab-auto-monthly');
  const btnAutoDownloadPdf = document.getElementById('btn-auto-download-pdf');
  const txtBtnAutoPdf = document.getElementById('txt-btn-auto-pdf');
  const autoSchedThead = document.getElementById('auto-sched-thead');
  const autoSchedTbody = document.getElementById('auto-sched-tbody');

  // Set default start date to current month
  const todayDate = new Date();
  const currentMonthStr = `${todayDate.getFullYear()}-${String(todayDate.getMonth() + 1).padStart(2, '0')}`;
  inpAutoStartDate.value = currentMonthStr;

  // Number Formatter (Indian Currency Standard)
  function formatINR(val, includeDecimals = true) {
    const num = Number(val);
    if (isNaN(num)) return '₹ 0';
    if (!includeDecimals) {
      return `₹ ${Math.round(num).toLocaleString('en-IN')}`;
    }
    return `₹ ${num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  // Synchronize Down Payment Amount & Percentage
  function syncDownPaymentFromAmount() {
    const price = parseFloat(inpAutoPrice.value) || 0;
    const downAmt = parseFloat(inpAutoDown.value) || 0;
    if (price > 0) {
      const pct = Math.min(100, Math.max(0, (downAmt / price) * 100));
      inpAutoDownPctInput.value = pct.toFixed(1).replace(/\.0$/, '');
      lblAutoDownPct.textContent = `${pct.toFixed(1).replace(/\.0$/, '')}%`;
    } else {
      inpAutoDownPctInput.value = '0';
      lblAutoDownPct.textContent = '0%';
    }
    updateNetLoanPrincipalBadge();
  }

  function syncDownPaymentFromPercent() {
    const price = parseFloat(inpAutoPrice.value) || 0;
    const pct = parseFloat(inpAutoDownPctInput.value) || 0;
    const downAmt = (price * pct) / 100;
    inpAutoDown.value = Math.round(downAmt);
    lblAutoDownPct.textContent = `${pct}%`;
    updateNetLoanPrincipalBadge();
  }

  function updateNetLoanPrincipalBadge() {
    const price = parseFloat(inpAutoPrice.value) || 0;
    const down = parseFloat(inpAutoDown.value) || 0;
    const trade = parseFloat(inpAutoTrade.value) || 0;
    const disc = parseFloat(inpAutoDisc.value) || 0;
    const taxFees = parseFloat(inpAutoTaxFees.value) || 0;

    const net = Math.max(0, price - down - trade - disc + taxFees);
    const financedPct = price > 0 ? ((net / price) * 100).toFixed(0) : '0';
    txtAutoLoanCalcPreview.textContent = `${formatINR(net, false)} (${financedPct}% Financed)`;
  }

  inpAutoPrice.addEventListener('input', syncDownPaymentFromPercent);
  inpAutoDown.addEventListener('input', syncDownPaymentFromAmount);
  inpAutoDownPctInput.addEventListener('input', syncDownPaymentFromPercent);
  [inpAutoTrade, inpAutoDisc, inpAutoTaxFees].forEach((el) => {
    el.addEventListener('input', updateNetLoanPrincipalBadge);
  });

  // Switch Calculation Types
  function setCalculationType(mode) {
    currentLoanType = mode;
    typeTabBtns.forEach((btn) => {
      if (btn.getAttribute('data-mode') === mode) {
        btn.className = 'type-tab-btn active rounded-xl bg-blue-600 px-3 py-1.5 text-white shadow-xs transition cursor-pointer';
      } else {
        btn.className = 'type-tab-btn rounded-xl px-3 py-1.5 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition cursor-pointer';
      }
    });

    // Update Field Visibility & Labels
    if (mode === 'refinance') {
      sectionPurchaseInputs.classList.add('hidden');
      sectionRefinanceInputs.classList.remove('hidden');
      lblAutoRate.textContent = 'New Annual Interest Rate (% p.a.)';
    } else {
      sectionPurchaseInputs.classList.remove('hidden');
      sectionRefinanceInputs.classList.add('hidden');
      lblAutoRate.textContent = 'Annual Interest Rate (% p.a.)';

      if (mode === 'used') {
        lblAutoPrice.textContent = 'Used Vehicle Purchase Price (₹)';
      } else {
        lblAutoPrice.textContent = 'Vehicle Purchase Price (₹)';
      }
    }

    // Hide previous results when changing loan type
    autoResultsSection.classList.add('hidden');
    lastCalculatedAutoLoan = null;
    errAuto.classList.add('hidden');
  }

  tabTypeNew.addEventListener('click', () => setCalculationType('new'));
  tabTypeUsed.addEventListener('click', () => setCalculationType('used'));
  tabTypeRefinance.addEventListener('click', () => setCalculationType('refinance'));

  // Quick Term Buttons
  document.querySelectorAll('.btn-auto-quick-term').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-auto-quick-term').forEach((b) => {
        b.className = 'btn-auto-quick-term rounded-md border border-slate-300 bg-white px-2 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer';
      });
      btn.className = 'btn-auto-quick-term active rounded-md bg-blue-600 px-2 py-0.5 font-bold text-white shadow-2xs cursor-pointer';
      inpAutoTerm.value = btn.getAttribute('data-months');
      selAutoTermUnit.value = 'months';
    });
  });

  // Master Calculation Execution
  function executeCarLoanCalculation() {
    errAuto.classList.add('hidden');

    const rateAnnual = parseFloat(inpAutoRate.value);
    const termVal = parseFloat(inpAutoTerm.value);
    const termUnit = selAutoTermUnit.value; // 'months' | 'years'

    const extraMo = parseFloat(inpAutoExtraMo.value) || 0;
    const extraYr = parseFloat(inpAutoExtraYr.value) || 0;
    const extraOnce = parseFloat(inpAutoExtraOnce.value) || 0;

    if (isNaN(rateAnnual) || rateAnnual < 0) {
      errAuto.textContent = 'Please enter a valid interest rate of 0% or higher.';
      errAuto.classList.remove('hidden');
      autoResultsSection.classList.add('hidden');
      return;
    }

    if (isNaN(termVal) || termVal <= 0) {
      errAuto.textContent = 'Please enter a valid loan term greater than 0.';
      errAuto.classList.remove('hidden');
      autoResultsSection.classList.add('hidden');
      return;
    }

    const totalMonths = termUnit === 'years' ? Math.round(termVal * 12) : Math.round(termVal);
    if (totalMonths <= 0) {
      errAuto.textContent = 'Total loan months must be at least 1.';
      errAuto.classList.remove('hidden');
      autoResultsSection.classList.add('hidden');
      return;
    }

    let vehiclePrice = 0;
    let downPayment = 0;
    let tradeIn = 0;
    let discounts = 0;
    let taxesAndFees = 0;
    let netLoanAmount = 0;

    let refCurPay = 0;
    let refCurRate = 0;
    let hasRefinanceComparison = false;

    if (currentLoanType === 'refinance') {
      const currentBalance = parseFloat(inpRefBalance.value) || 0;
      const refFees = parseFloat(inpRefFees.value) || 0;
      const cashout = parseFloat(inpRefCashout.value) || 0;

      if (currentBalance <= 0) {
        errAuto.textContent = 'Current loan balance must be greater than 0.';
        errAuto.classList.remove('hidden');
        autoResultsSection.classList.add('hidden');
        return;
      }

      vehiclePrice = currentBalance;
      taxesAndFees = refFees;
      netLoanAmount = Math.max(0, currentBalance + refFees + cashout);

      refCurPay = parseFloat(inpRefCurPay.value) || 0;
      refCurRate = parseFloat(inpRefCurRate.value) || 0;
      if (refCurPay > 0 && refCurRate > 0) {
        hasRefinanceComparison = true;
      }
    } else {
      vehiclePrice = parseFloat(inpAutoPrice.value) || 0;
      downPayment = parseFloat(inpAutoDown.value) || 0;
      tradeIn = parseFloat(inpAutoTrade.value) || 0;
      discounts = parseFloat(inpAutoDisc.value) || 0;
      taxesAndFees = parseFloat(inpAutoTaxFees.value) || 0;

      if (vehiclePrice <= 0) {
        errAuto.textContent = 'Vehicle purchase price must be greater than 0.';
        errAuto.classList.remove('hidden');
        autoResultsSection.classList.add('hidden');
        return;
      }

      if (downPayment < 0 || tradeIn < 0 || discounts < 0 || taxesAndFees < 0) {
        errAuto.textContent = 'Down payment, trade-in, discounts, and fees cannot be negative.';
        errAuto.classList.remove('hidden');
        autoResultsSection.classList.add('hidden');
        return;
      }

      netLoanAmount = Math.max(0, vehiclePrice - downPayment - tradeIn - discounts + taxesAndFees);

      if (netLoanAmount <= 0) {
        errAuto.textContent = 'Your down payment and trade-in exceed the vehicle purchase cost (Loan Amount is 0).';
        errAuto.classList.remove('hidden');
        autoResultsSection.classList.add('hidden');
        return;
      }
    }

    // Monthly Interest Rate
    const r = rateAnnual / 12 / 100;
    let monthlyPayment = 0;
    if (r === 0) {
      monthlyPayment = netLoanAmount / totalMonths;
    } else {
      const factor = Math.pow(1 + r, totalMonths);
      monthlyPayment = (netLoanAmount * r * factor) / (factor - 1);
    }

    const originalTotalInterest = r > 0 ? Math.max(0, monthlyPayment * totalMonths - netLoanAmount) : 0;

    // Date parsing
    let startYear = todayDate.getFullYear();
    let startMonth = todayDate.getMonth();
    if (inpAutoStartDate.value) {
      const parts = inpAutoStartDate.value.split('-');
      if (parts.length === 2) {
        const y = parseInt(parts[0], 10);
        const m = parseInt(parts[1], 10) - 1;
        if (!isNaN(y)) startYear = y;
        if (!isNaN(m) && m >= 0 && m < 12) startMonth = m;
      }
    }

    // Amortization Schedule Calculation
    const yearlySchedule = [];
    const monthlySchedule = [];

    let balance = netLoanAmount;
    let totalInterestPaid = 0;
    let totalPrincipalPaid = 0;
    let totalExtraPaid = 0;

    let currentYear = 1;
    let yearOpeningBalance = balance;
    let yearPrincipal = 0;
    let yearInterest = 0;
    let yearExtra = 0;
    let yearTotalPaid = 0;

    let month = 1;
    const maxSafety = Math.max(12, totalMonths * 3);

    while (balance > 0.001 && month <= maxSafety) {
      const monthOpening = balance;
      const monthInterest = r > 0 ? balance * r : 0;

      let regularPrincipal = Math.min(balance, monthlyPayment - monthInterest);
      if (regularPrincipal < 0) regularPrincipal = 0;

      const schedPayment = regularPrincipal + monthInterest;

      let extraThisMonth = extraMo;
      if (extraYr > 0 && month % 12 === 1) extraThisMonth += extraYr;
      if (extraOnce > 0 && month === 1) extraThisMonth += extraOnce;

      const remAfterRegular = Math.max(0, balance - regularPrincipal);
      extraThisMonth = Math.min(remAfterRegular, extraThisMonth);

      const totalPrincipalThisMonth = regularPrincipal + extraThisMonth;
      const totalPaymentThisMonth = schedPayment + extraThisMonth;

      balance = Math.max(0, balance - totalPrincipalThisMonth);

      totalInterestPaid += monthInterest;
      totalPrincipalPaid += regularPrincipal;
      totalExtraPaid += extraThisMonth;

      yearPrincipal += regularPrincipal;
      yearInterest += monthInterest;
      yearExtra += extraThisMonth;
      yearTotalPaid += totalPaymentThisMonth;

      const paymentDate = new Date(startYear, startMonth + month, 1);
      const dateStr = paymentDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

      monthlySchedule.push({
        paymentNumber: month,
        paymentDateStr: dateStr,
        openingBalance: monthOpening,
        scheduledPayment: schedPayment,
        principalPaid: regularPrincipal,
        interestPaid: monthInterest,
        extraPayment: extraThisMonth,
        totalPayment: totalPaymentThisMonth,
        closingBalance: balance,
      });

      if (month % 12 === 0 || balance <= 0.001) {
        yearlySchedule.push({
          year: currentYear,
          openingBalance: yearOpeningBalance,
          principalPaid: yearPrincipal,
          interestPaid: yearInterest,
          extraPaid: yearExtra,
          totalPaid: yearTotalPaid,
          closingBalance: balance,
        });

        currentYear++;
        yearOpeningBalance = balance;
        yearPrincipal = 0;
        yearInterest = 0;
        yearExtra = 0;
        yearTotalPaid = 0;
      }

      if (balance <= 0.001) break;
      month++;
    }

    const actualPaymentsCount = monthlySchedule.length;
    const interestSaved = Math.max(0, originalTotalInterest - totalInterestPaid);
    const monthsSaved = Math.max(0, totalMonths - actualPaymentsCount);
    const yearsSaved = Math.floor(monthsSaved / 12);
    const remMonthsSaved = monthsSaved % 12;
    const timeSavedStr = yearsSaved > 0
      ? `${yearsSaved} Yr${yearsSaved > 1 ? 's' : ''} ${remMonthsSaved} Mo${remMonthsSaved !== 1 ? 's' : ''}`
      : `${remMonthsSaved} Month${remMonthsSaved !== 1 ? 's' : ''}`;

    const payoffDate = new Date(startYear, startMonth + actualPaymentsCount, 1);
    const payoffDateStr = payoffDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

    const totalAmountPayable = netLoanAmount + totalInterestPaid;
    const totalOutOfPocket = currentLoanType === 'refinance'
      ? totalAmountPayable
      : (downPayment + tradeIn + discounts + totalAmountPayable);

    // Save State
    lastCalculatedAutoLoan = {
      loanType: currentLoanType,
      vehiclePrice,
      downPayment,
      downPaymentPercent: vehiclePrice > 0 ? (downPayment / vehiclePrice) * 100 : 0,
      tradeIn,
      discounts,
      taxesAndFees,
      netLoanAmount,
      rateAnnual,
      termVal,
      termUnit,
      totalMonths,
      monthlyPayment,
      totalInterestPaid,
      totalPrincipalPaid: totalPrincipalPaid + totalExtraPaid,
      totalAmountPayable,
      totalOutOfPocket,
      payoffDateStr,
      actualPaymentsCount,
      hasExtraPayments: (extraMo > 0 || extraYr > 0 || extraOnce > 0),
      interestSaved,
      monthsSaved,
      timeSavedStr,
      yearlySchedule,
      monthlySchedule,
    };

    // Update Result Hero Card
    resAutoMonthlyEmi.textContent = formatINR(monthlyPayment);
    resAutoTotalInt.textContent = formatINR(totalInterestPaid);
    resAutoLoanAmt.textContent = formatINR(netLoanAmount);
    resAutoRateVal.textContent = `${rateAnnual}% per year`;
    resAutoTotalPayable.textContent = formatINR(totalAmountPayable);
    resAutoPayoffDate.textContent = payoffDateStr;

    // Update Loan Summary Grid
    if (currentLoanType === 'refinance') {
      lblSumVehiclePrice.textContent = 'Current Loan Balance';
      sumVehiclePrice.textContent = formatINR(vehiclePrice);
      lblSumDownPayment.textContent = 'Refinance Fees Financed';
      sumDownPayment.textContent = formatINR(taxesAndFees);
      lblSumTradeDisc.textContent = 'Cash-Out Financed';
      sumTradeDisc.textContent = formatINR(parseFloat(inpRefCashout.value) || 0);
      lblSumTaxesFees.textContent = 'New Rate & Term';
      sumTaxesFees.textContent = `${rateAnnual}% / ${totalMonths} Mos`;
    } else {
      lblSumVehiclePrice.textContent = currentLoanType === 'used' ? 'Used Vehicle Price' : 'Vehicle Price';
      sumVehiclePrice.textContent = formatINR(vehiclePrice);
      lblSumDownPayment.textContent = 'Down Payment';
      sumDownPayment.textContent = `${formatINR(downPayment)} (${lastCalculatedAutoLoan.downPaymentPercent.toFixed(1)}%)`;
      lblSumTradeDisc.textContent = 'Trade-In & Discounts';
      sumTradeDisc.textContent = formatINR(tradeIn + discounts);
      lblSumTaxesFees.textContent = 'Taxes & Fees Financed';
      sumTaxesFees.textContent = formatINR(taxesAndFees);
    }

    sumNetLoan.textContent = formatINR(netLoanAmount);
    sumLoanTerm.textContent = `${totalMonths} Months (${(totalMonths / 12).toFixed(1)} Yrs)`;
    sumTotalInterest.textContent = formatINR(totalInterestPaid);
    sumTotalOutOfPocket.textContent = formatINR(totalOutOfPocket);

    // Update Chart Ratio Bar
    const chartTotal = totalAmountPayable > 0 ? totalAmountPayable : 1;
    const principalPct = ((netLoanAmount / chartTotal) * 100).toFixed(1);
    const interestPct = ((totalInterestPaid / chartTotal) * 100).toFixed(1);

    barAutoPrincipal.style.width = `${principalPct}%`;
    barAutoInterest.style.width = `${interestPct}%`;

    lblChartPrincipal.textContent = `Principal: ${formatINR(netLoanAmount)} (${principalPct}%)`;
    lblChartInterest.textContent = `Total Interest: ${formatINR(totalInterestPaid)} (${interestPct}%)`;

    // Extra Payment Savings Box
    if (lastCalculatedAutoLoan.hasExtraPayments && monthsSaved > 0) {
      cardAutoExtraComparison.classList.remove('hidden');
      resAutoIntSaved.textContent = formatINR(interestSaved);
      resAutoTimeSaved.textContent = timeSavedStr;
      resAutoNewDuration.textContent = `${(actualPaymentsCount / 12).toFixed(1)} Yrs (${actualPaymentsCount} Mos)`;
      resAutoNewInt.textContent = formatINR(totalInterestPaid);
    } else {
      cardAutoExtraComparison.classList.add('hidden');
    }

    // Refinance Comparison Box
    if (currentLoanType === 'refinance' && hasRefinanceComparison) {
      cardAutoRefinanceComparison.classList.remove('hidden');
      const curRemainingInt = Math.max(0, refCurPay * totalMonths - vehiclePrice);
      const moSavings = refCurPay - monthlyPayment;
      const totalIntSavings = curRemainingInt - totalInterestPaid;
      const netSavings = totalIntSavings - taxesAndFees;

      cmpCurPay.textContent = formatINR(refCurPay);
      cmpCurRate.textContent = `${refCurRate}%`;
      cmpCurInt.textContent = formatINR(curRemainingInt);

      cmpNewPay.textContent = formatINR(monthlyPayment);
      cmpNewRate.textContent = `${rateAnnual}%`;
      cmpNewInt.textContent = formatINR(totalInterestPaid);

      cmpNetSavings.textContent = formatINR(netSavings);
      cmpMoSavings.textContent = `(${formatINR(moSavings)}/mo difference)`;
    } else {
      cardAutoRefinanceComparison.classList.add('hidden');
    }

    // Render Active Schedule Table
    renderScheduleTable();

    // Show Result Container
    autoResultsSection.classList.remove('hidden');
  }

