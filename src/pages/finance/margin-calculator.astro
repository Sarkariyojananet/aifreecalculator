  function formatMoney(val) {
    const num = Number(val);
    if (isNaN(num)) return activeCurrency + '0.00';
    const loc = activeCurrency === '₹' ? 'en-IN' : 'en-US';
    const formatted = Math.abs(num).toLocaleString(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    return num < 0 ? `-${activeCurrency}${formatted}` : `${activeCurrency}${formatted}`;
  }

  // Update currency labels throughout inputs
  function updateCurrencyLabels() {
    document.querySelectorAll('.txt-cur-symbol').forEach((el) => {
      el.textContent = activeCurrency;
    });
  }

  selCurrency.addEventListener('change', () => {
    activeCurrency = selCurrency.value;
    updateCurrencyLabels();
    executeMarginCalculation();
  });

  // Mode Switcher Handler
  document.querySelectorAll('.btn-margin-mode').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-margin-mode').forEach((b) => {
        b.className = 'btn-margin-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center';
      });
      btn.className = 'btn-margin-mode active rounded-xl border border-blue-600 bg-blue-50 px-3 py-2 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer text-center';

      activeMarginMode = btn.getAttribute('data-mode') || 'cost_margin';
      errMargin.classList.add('hidden');

      secCostMargin.classList.add('hidden');
      secCostRevenue.classList.add('hidden');
      secRevenueMargin.classList.add('hidden');
      secRevenueProfit.classList.add('hidden');
      secCostProfit.classList.add('hidden');

      if (activeMarginMode === 'cost_margin') {
        secCostMargin.classList.remove('hidden');
        txtMarginPanelTitle.innerHTML = '<span>🏷️</span> Cost &amp; Desired Margin Calculator';
        txtMarginSubtitle.textContent = 'Calculate your required selling price and profit from cost of goods sold (COGS) and desired profit margin.';
      } else if (activeMarginMode === 'cost_revenue') {
        secCostRevenue.classList.remove('hidden');
        txtMarginPanelTitle.innerHTML = '<span>💰</span> Cost &amp; Selling Price Margin Calculator';
        txtMarginSubtitle.textContent = 'Calculate gross profit, margin percentage, and markup from known cost and actual selling price.';
      } else if (activeMarginMode === 'revenue_margin') {
        secRevenueMargin.classList.remove('hidden');
        txtMarginPanelTitle.innerHTML = '<span>🔄</span> Target Revenue &amp; Margin Calculator';
        txtMarginSubtitle.textContent = 'Determine your maximum allowable manufacturing or purchase cost (COGS) to achieve a target margin on fixed price.';
      } else if (activeMarginMode === 'revenue_profit') {
        secRevenueProfit.classList.remove('hidden');
        txtMarginPanelTitle.innerHTML = '<span>📈</span> Revenue &amp; Profit Calculator';
        txtMarginSubtitle.textContent = 'Calculate cost and profit margin percentage from total revenue and gross profit amount.';
      } else if (activeMarginMode === 'cost_profit') {
        secCostProfit.classList.remove('hidden');
        txtMarginPanelTitle.innerHTML = '<span>⚖️</span> Cost &amp; Desired Profit Calculator';
        txtMarginSubtitle.textContent = 'Calculate required selling price and resulting profit margin percentage from known cost and desired profit.';
      }

      executeMarginCalculation();
    });
  });

  // Quick Margin Preset Buttons
  document.querySelectorAll('.btn-quick-margin').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-margin') || '40';
      if (activeMarginMode === 'cost_margin') {
        inpCmMargin.value = val;
      } else if (activeMarginMode === 'revenue_margin') {
        inpRmMargin.value = val;
      }
      executeMarginCalculation();
    });
  });

  // Execute Margin Calculation
  function executeMarginCalculation() {
    errMargin.classList.add('hidden');

    let cost = 0;
    let revenue = 0;
    let profit = 0;
    let margin = 0;
    let markup = 0;

    let heroLabel = 'REQUIRED SELLING PRICE';
    let heroValue = 0;
    let isHeroPercent = false;
    let heroSubtitle = '';

    let formulaName = '';
    let formulaEq = '';
    const steps = [];

    if (activeMarginMode === 'cost_margin') {
      cost = parseFloat(inpCmCost.value);
      margin = parseFloat(inpCmMargin.value);

      if (isNaN(cost) || cost < 0) {
        showError('Please enter a valid non-negative cost value.');
        return;
      }
      if (isNaN(margin)) {
        showError('Please enter a valid desired profit margin percentage.');
        return;
      }
      if (margin < 0) {
        showError('Profit margin cannot be negative for commercial pricing.');
        return;
      }
      if (margin >= 100) {
        showError('Profit margin must be strictly less than 100%. A 100% margin requires infinite selling price (division by zero).');
        return;
      }

      revenue = cost / (1 - margin / 100);
      profit = revenue - cost;
      markup = cost > 0 ? (profit / cost) * 100 : 0;

      heroLabel = 'REQUIRED SELLING PRICE';
      heroValue = revenue;
      isHeroPercent = false;
      heroSubtitle = `Yields ${margin.toFixed(2)}% Gross Margin (${formatMoney(profit)} profit)`;

      formulaName = 'Selling Price from Cost & Desired Margin';
      formulaEq = 'Revenue = Cost ÷ (1 - Margin ÷ 100);  Profit = Revenue - Cost';

      steps.push(`Step 1 (Revenue): ${formatMoney(cost)} ÷ (1 - ${margin} ÷ 100) = ${formatMoney(cost)} ÷ ${(1 - margin / 100).toFixed(4)} = <strong>${formatMoney(revenue)}</strong>`);
      steps.push(`Step 2 (Profit): ${formatMoney(revenue)} - ${formatMoney(cost)} = <strong>${formatMoney(profit)}</strong>`);
      steps.push(`Step 3 (Markup): (${formatMoney(profit)} ÷ ${formatMoney(cost)}) × 100 = <strong>${markup.toFixed(2)}%</strong>`);

    } else if (activeMarginMode === 'cost_revenue') {
      cost = parseFloat(inpCrCost.value);
      revenue = parseFloat(inpCrRev.value);

      if (isNaN(cost) || cost < 0) {
        showError('Please enter a valid non-negative cost value.');
        return;
      }
      if (isNaN(revenue) || revenue <= 0) {
        showError('Selling Price must be greater than zero.');
        return;
      }

      profit = revenue - cost;
      margin = (profit / revenue) * 100;
      markup = cost > 0 ? (profit / cost) * 100 : 0;

      heroLabel = 'PROFIT MARGIN';
      heroValue = margin;
      isHeroPercent = true;
      heroSubtitle = `${formatMoney(profit)} Gross Profit on ${formatMoney(revenue)} Sales`;

      formulaName = 'Profit Margin from Cost & Selling Price';
      formulaEq = 'Profit = Revenue - Cost;  Margin (%) = (Profit ÷ Revenue) × 100';

      steps.push(`Step 1 (Profit): ${formatMoney(revenue)} - ${formatMoney(cost)} = <strong>${formatMoney(profit)}</strong>`);
      steps.push(`Step 2 (Margin %): (${formatMoney(profit)} ÷ ${formatMoney(revenue)}) × 100 = <strong>${margin.toFixed(2)}%</strong>`);
      if (cost > 0) {
        steps.push(`Step 3 (Markup %): (${formatMoney(profit)} ÷ ${formatMoney(cost)}) × 100 = <strong>${markup.toFixed(2)}%</strong>`);
      }

    } else if (activeMarginMode === 'revenue_margin') {
      revenue = parseFloat(inpRmRev.value);
      margin = parseFloat(inpRmMargin.value);

      if (isNaN(revenue) || revenue <= 0) {
        showError('Selling Price must be greater than zero.');
        return;
      }
      if (isNaN(margin) || margin < 0 || margin >= 100) {
        showError('Profit margin must be between 0% and 99.99%.');
        return;
      }

      profit = (revenue * margin) / 100;
      cost = revenue - profit;
      markup = cost > 0 ? (profit / cost) * 100 : 0;

      heroLabel = 'MAX ALLOWABLE COST (COGS)';
      heroValue = cost;
      isHeroPercent = false;
      heroSubtitle = `Target Profit: ${formatMoney(profit)} (${margin.toFixed(2)}% margin)`;

      formulaName = 'Allowable Cost from Revenue & Desired Margin';
      formulaEq = 'Profit = Revenue × (Margin ÷ 100);  Cost = Revenue - Profit';

      steps.push(`Step 1 (Profit Target): ${formatMoney(revenue)} × (${margin} ÷ 100) = <strong>${formatMoney(profit)}</strong>`);
      steps.push(`Step 2 (Max Cost): ${formatMoney(revenue)} - ${formatMoney(profit)} = <strong>${formatMoney(cost)}</strong>`);

    } else if (activeMarginMode === 'revenue_profit') {
      revenue = parseFloat(inpRpRev.value);
      profit = parseFloat(inpRpProfit.value);

      if (isNaN(revenue) || revenue <= 0) {
        showError('Selling Price must be greater than zero.');
        return;
      }
      if (isNaN(profit)) {
        showError('Please enter a valid profit value.');
        return;
      }
      if (profit > revenue) {
        showError('Profit cannot exceed total revenue (cost would be negative).');
        return;
      }

      cost = revenue - profit;
      margin = (profit / revenue) * 100;
      markup = cost > 0 ? (profit / cost) * 100 : 0;

      heroLabel = 'PROFIT MARGIN';
      heroValue = margin;
      isHeroPercent = true;
      heroSubtitle = `Cost of Goods Sold (COGS): ${formatMoney(cost)}`;

      formulaName = 'Cost and Margin from Revenue & Profit';
      formulaEq = 'Cost = Revenue - Profit;  Margin (%) = (Profit ÷ Revenue) × 100';

      steps.push(`Step 1 (Cost): ${formatMoney(revenue)} - ${formatMoney(profit)} = <strong>${formatMoney(cost)}</strong>`);
      steps.push(`Step 2 (Margin %): (${formatMoney(profit)} ÷ ${formatMoney(revenue)}) × 100 = <strong>${margin.toFixed(2)}%</strong>`);

    } else if (activeMarginMode === 'cost_profit') {
      cost = parseFloat(inpCpCost.value);
      profit = parseFloat(inpCpProfit.value);

      if (isNaN(cost) || cost < 0) {
        showError('Cost must be a valid non-negative number.');
        return;
      }
      if (isNaN(profit)) {
        showError('Please enter a valid profit amount.');
        return;
      }
      if (cost + profit <= 0) {
        showError('Total selling price (Cost + Profit) must be greater than zero.');
        return;
      }

      revenue = cost + profit;
      margin = (profit / revenue) * 100;
      markup = cost > 0 ? (profit / cost) * 100 : 0;

      heroLabel = 'REQUIRED SELLING PRICE';
      heroValue = revenue;
      isHeroPercent = false;
      heroSubtitle = `Yields ${margin.toFixed(2)}% Margin (${formatMoney(profit)} profit)`;

      formulaName = 'Selling Price and Margin from Cost & Profit';
      formulaEq = 'Revenue = Cost + Profit;  Margin (%) = (Profit ÷ Revenue) × 100';

      steps.push(`Step 1 (Selling Price): ${formatMoney(cost)} + ${formatMoney(profit)} = <strong>${formatMoney(revenue)}</strong>`);
      steps.push(`Step 2 (Margin %): (${formatMoney(profit)} ÷ ${formatMoney(revenue)}) × 100 = <strong>${margin.toFixed(2)}%</strong>`);
    }

    // Save calculation state for PDF export
    lastCalculatedMargin = {
      mode: activeMarginMode,
      currency: activeCurrency,
      cost,
      revenue,
      profit,
      margin,
      markup,
      heroLabel,
      heroValue,
      isHeroPercent,
    };

    // Render Hero Card
    lblHeroTitle.textContent = heroLabel;
    resHeroAmount.textContent = isHeroPercent ? `${heroValue.toFixed(2)}%` : formatMoney(heroValue);
    resHeroSubtitle.textContent = heroSubtitle;
    resHeroSecondary.textContent = formatMoney(profit);
    resHeroMarkupBadge.textContent = `Markup: ${markup.toFixed(2)}%`;

    // Render 5-Box Grid
    resGridCost.textContent = formatMoney(cost);
    resGridRev.textContent = formatMoney(revenue);
    resGridProfit.textContent = formatMoney(profit);
    resGridMargin.textContent = `${margin.toFixed(2)}%`;
    resGridMarkup.textContent = cost > 0 ? `${markup.toFixed(2)}%` : 'N/A';

    // Render Breakdown
    txtBreakdownTitle.textContent = formulaName;
    txtBreakdownFormula.textContent = formulaEq;
    boxBreakdownSteps.innerHTML = steps.map((s) => `<div>${s}</div>`).join('');

    // Render Comparison Table
    const tiers = [10, 15, 20, 25, 30, 40, 50, 60];
    const baseCost = cost > 0 ? cost : 100;

    tblComparison.innerHTML = tiers.map((tier) => {
      const tierRev = baseCost / (1 - tier / 100);
      const tierProfit = tierRev - baseCost;
      const tierMarkup = baseCost > 0 ? (tierProfit / baseCost) * 100 : 0;
      const isCur = Math.abs(tier - margin) < 0.5;

      const rowClass = isCur
        ? 'bg-blue-50/80 dark:bg-blue-950/50 font-bold text-blue-700 dark:text-blue-300'
        : 'hover:bg-slate-50 dark:hover:bg-slate-800/40 text-slate-700 dark:text-slate-300';

      return `
        <tr class="${rowClass}">
          <td class="p-2.5 rounded-l-lg">${tier}% ${isCur ? '★ (Selected)' : ''}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatMoney(tierRev)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-bold">${formatMoney(tierProfit)}</td>
          <td class="p-2.5 text-right rounded-r-lg text-amber-600 dark:text-amber-400">${tierMarkup.toFixed(2)}%</td>
        </tr>
      `;
    }).join('');

    marginResultsSection.classList.remove('hidden');
  }

  function showError(msg) {
    errMargin.textContent = msg;
    errMargin.classList.remove('hidden');
  }

  // Live Auto-Calculation on inputs
  [
    inpCmCost, inpCmMargin,
    inpCrCost, inpCrRev,
    inpRmRev, inpRmMargin,
    inpRpRev, inpRpProfit,
    inpCpCost, inpCpProfit,
  ].forEach((input) => {
    input?.addEventListener('input', () => {
      executeMarginCalculation();
    });
  });

  // Submit button
  btnCalcMargin.addEventListener('click', (e) => {
    e.preventDefault();
    executeMarginCalculation();
  });

  // Clear button
  btnClearMargin.addEventListener('click', () => {
    if (activeMarginMode === 'cost_margin') {
      inpCmCost.value = '30';
      inpCmMargin.value = '40';
    } else if (activeMarginMode === 'cost_revenue') {
      inpCrCost.value = '30';
      inpCrRev.value = '50';
    } else if (activeMarginMode === 'revenue_margin') {
      inpRmRev.value = '100';
      inpRmMargin.value = '25';
    } else if (activeMarginMode === 'revenue_profit') {
      inpRpRev.value = '200';
      inpRpProfit.value = '50';
    } else if (activeMarginMode === 'cost_profit') {
      inpCpCost.value = '100';
      inpCpProfit.value = '50';
    }
    executeMarginCalculation();
  });

  // PDF Export
  btnDownloadPdf.addEventListener('click', async () => {
    if (!lastCalculatedMargin) return;

    btnDownloadPdf.disabled = true;
    btnDownloadPdf.textContent = 'Generating PDF...';

    try {
      if (typeof window.jspdf !== 'undefined') {
        generatePdfDoc(window.jspdf.jsPDF);
      } else {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
        script.onload = () => {
          if (window.jspdf) {
            generatePdfDoc(window.jspdf.jsPDF);
          } else {
            window.print();
          }
        };
        script.onerror = () => window.print();
        document.body.appendChild(script);
      }
    } catch {
      window.print();
    } finally {
      setTimeout(() => {
        btnDownloadPdf.disabled = false;
        btnDownloadPdf.innerHTML = '<span>📄</span> <span>Download PDF</span>';
      }, 1000);
    }
  });

  function generatePdfDoc(jsPDF) {
    const doc = new jsPDF();
    const data = lastCalculatedMargin;

    doc.setFontSize(18);
    doc.text('Profit Margin Calculation Report', 14, 20);

    doc.setFontSize(10);
    doc.setTextColor(100);
    doc.text(`Generated on ${new Date().toLocaleDateString()} | aifreecalculator.com/finance/margin-calculator/`, 14, 28);

    doc.setDrawColor(200);
    doc.line(14, 32, 196, 32);

    doc.setFontSize(12);
    doc.setTextColor(30);
    doc.text('Financial Summary:', 14, 42);

    doc.setFontSize(10);
    doc.text(`• Cost of Goods Sold (COGS): ${formatMoney(data.cost)}`, 18, 50);
    doc.text(`• Revenue / Selling Price: ${formatMoney(data.revenue)}`, 18, 58);
    doc.text(`• Gross Profit: ${formatMoney(data.profit)}`, 18, 66);
    doc.text(`• Profit Margin: ${data.margin.toFixed(2)}%`, 18, 74);
    doc.text(`• Equivalent Markup: ${data.markup.toFixed(2)}%`, 18, 82);

    doc.line(14, 90, 196, 90);

    doc.setFontSize(11);
    doc.text('Key Formulas:', 14, 100);
    doc.setFontSize(9);
    doc.text('• Profit Margin (%) = ((Revenue - Cost) / Revenue) × 100', 18, 108);
    doc.text('• Markup (%) = ((Revenue - Cost) / Cost) × 100', 18, 115);
    doc.text('• Selling Price = Cost / (1 - Margin / 100)', 18, 122);

    doc.save('margin-calculation-report.pdf');
  }

  // Initial calculation on load
  executeMarginCalculation();
</script>
