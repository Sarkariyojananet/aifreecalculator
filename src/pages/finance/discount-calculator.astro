---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Discount & Sale Price Calculator – Calculate Discount, Savings & Final Price"
  description="Calculate sale price, discount percentage, money saved, original price, multiple stacked discounts, and Buy X Get Y (BOGO) bundles with optional sales tax."
  category="Finance"
  calculatorName="Discount & Sale Price Calculator"
  slug="discount-calculator"
  keywords={[
    'discount calculator',
    'sale price calculator',
    'discount percentage calculator',
    'percentage off calculator',
    'price after discount calculator',
    'calculate discount',
    'discount amount calculator',
    'multiple discount calculator',
    'stacked discount calculator',
    'bogo calculator',
    'buy one get one calculator',
    'original price calculator',
    'reverse discount calculator'
  ]}
>
  <div class="space-y-6">

    <!-- CALCULATION MODE SELECTOR TABS (5 MODES) -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 hidden lg:inline px-1">
          Mode:
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-1.5 w-full text-xs font-bold">
          <button type="button" class="btn-disc-mode active rounded-xl border border-blue-600 bg-blue-50 px-3 py-2 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer text-center" data-mode="sale_price">
            🏷️ Sale Price
          </button>
          <button type="button" class="btn-disc-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="discount_pct">
            ％ Discount %
          </button>
          <button type="button" class="btn-disc-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="original_price">
            🔄 Original Price
          </button>
          <button type="button" class="btn-disc-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="multiple">
            ✨ Stacked (Multi)
          </button>
          <button type="button" class="btn-disc-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center col-span-2 sm:col-span-1" data-mode="bogo">
            🎁 Buy X Get Y (BOGO)
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">

      <!-- Top Title & Global Currency Row -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200/80 pb-4 dark:border-slate-800">
        <div>
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span id="txt-disc-title-icon">🏷️</span> <span id="txt-disc-title">Discount & Sale Price Calculator</span>
          </h2>
          <p id="txt-disc-subtitle" class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Calculate the discount amount, money saved, and final sale price using percentage or fixed discounts.
          </p>
        </div>

        <!-- Global Currency Selector -->
        <div class="flex items-center gap-2 self-start sm:self-auto">
          <label for="sel-disc-currency" class="text-xs font-bold text-slate-600 dark:text-slate-400 shrink-0">Currency:</label>
          <select id="sel-disc-currency" class="rounded-xl border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
            <option value="$">$ USD / CAD / AUD</option>
            <option value="₹">₹ INR (Rupees)</option>
            <option value="€">€ EUR (Euro)</option>
            <option value="£">£ GBP (Pound)</option>
            <option value="¥">¥ JPY / CNY (Yen/Yuan)</option>
            <option value="₩">₩ KRW (Won)</option>
            <option value="R$">R$ BRL (Real)</option>
            <option value="kr">kr SEK/NOK/DKK</option>
            <option value="₱">₱ PHP (Peso)</option>
            <option value="د.إ">د.إ AED (Dirham)</option>
          </select>
        </div>
      </div>

      <form id="form-discount" class="mt-4 space-y-4" novalidate onsubmit="return false;">

        <!-- ================================================================= -->
        <!-- MODE 1: FIND SALE PRICE                                           -->
        <!-- ================================================================= -->
        <div id="sec-disc-mode-saleprice" class="space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/60 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>💰</span> Price & Discount Value
            </span>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label for="inp-disc-orig-price" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Original Retail Price (<span class="lbl-curr-sym">$</span>)
                </label>
                <input type="number" id="inp-disc-orig-price" value="1000" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1000" />
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount Type</label>
                <div class="mt-1 grid grid-cols-2 gap-2 text-xs font-bold">
                  <button type="button" id="btn-type-pct" class="active rounded-xl border border-blue-600 bg-blue-50 py-2.5 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer">
                    Percentage (%) Off
                  </button>
                  <button type="button" id="btn-type-fixed" class="rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer">
                    Fixed Markdown (<span class="lbl-curr-sym">$</span>)
                  </button>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 pt-2 border-t border-slate-100 dark:border-slate-800">
              <div id="box-disc-pct-input">
                <label for="inp-disc-val-pct" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount Percentage (% off)</label>
                <input type="number" id="inp-disc-val-pct" value="20" step="1" min="0" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="20" />
              </div>

              <div id="box-disc-fixed-input" class="hidden">
                <label for="inp-disc-val-fixed" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Fixed Discount Amount (<span class="lbl-curr-sym">$</span>)</label>
                <input type="number" id="inp-disc-val-fixed" value="200" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="200" />
              </div>

              <!-- Quantity Multiplier -->
              <div>
                <label for="inp-disc-qty-sale" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Item Quantity (Units)</label>
                <input type="number" id="inp-disc-qty-sale" value="1" step="1" min="1" max="10000" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1" />
              </div>
            </div>

            <!-- Quick Discount Presets -->
            <div id="box-disc-presets" class="pt-1">
              <label class="block text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Quick Discount Presets</label>
              <div class="flex flex-wrap gap-1.5">
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="5">5%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="10">10%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="15">15%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="20">20%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="25">25%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="30">30%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="40">40%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="50">50%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="60">60%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="70">70%</button>
                <button type="button" class="btn-disc-quick-pct rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="75">75%</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ================================================================= -->
        <!-- MODE 2: FIND DISCOUNT PERCENTAGE                                  -->
        <!-- ================================================================= -->
        <div id="sec-disc-mode-pct" class="hidden space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/60 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>🔍</span> Calculate Discount % from Prices
            </span>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
              <div>
                <label for="inp-disc-calc-orig" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Original Retail Price (<span class="lbl-curr-sym">$</span>)
                </label>
                <input type="number" id="inp-disc-calc-orig" value="100" step="5" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="100" />
              </div>

              <div>
                <label for="inp-disc-calc-sale" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Discounted Sale Price (<span class="lbl-curr-sym">$</span>)
                </label>
                <input type="number" id="inp-disc-calc-sale" value="75" step="5" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="75" />
              </div>

              <div>
                <label for="inp-disc-qty-pct" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quantity (Units)</label>
                <input type="number" id="inp-disc-qty-pct" value="1" step="1" min="1" max="10000" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1" />
              </div>
            </div>
          </div>
        </div>

        <!-- ================================================================= -->
        <!-- MODE 3: FIND ORIGINAL PRICE                                       -->
        <!-- ================================================================= -->
        <div id="sec-disc-mode-orig" class="hidden space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/60 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>🔄</span> Reverse Original Price from Sale Price
            </span>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
              <div>
                <label for="inp-disc-rev-sale" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Current Sale Price (<span class="lbl-curr-sym">$</span>)
                </label>
                <input type="number" id="inp-disc-rev-sale" value="800" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="800" />
              </div>

              <div>
                <label for="inp-disc-rev-pct" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount Percentage (% off)</label>
                <input type="number" id="inp-disc-rev-pct" value="20" step="1" min="0" max="99.99" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="20" />
              </div>

              <div>
                <label for="inp-disc-qty-orig" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quantity (Units)</label>
                <input type="number" id="inp-disc-qty-orig" value="1" step="1" min="1" max="10000" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1" />
              </div>
            </div>
          </div>
        </div>

        <!-- ================================================================= -->
        <!-- MODE 4: MULTIPLE SEQUENTIAL DISCOUNTS                             -->
        <!-- ================================================================= -->
        <div id="sec-disc-mode-multi" class="hidden space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/60 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>✨</span> Sequential Stacked Discounts
              </span>
              <span class="text-[11px] text-blue-600 dark:text-blue-400 font-semibold">Compounding arithmetic</span>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
              <div class="sm:col-span-2">
                <label for="inp-disc-multi-orig" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Original Price (<span class="lbl-curr-sym">$</span>)
                </label>
                <input type="number" id="inp-disc-multi-orig" value="1000" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1000" />
              </div>

              <div>
                <label for="inp-disc-qty-multi" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quantity (Units)</label>
                <input type="number" id="inp-disc-qty-multi" value="1" step="1" min="1" max="10000" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1" />
              </div>

              <div>
                <label for="inp-disc-multi-d1" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount 1 (% off)</label>
                <input type="number" id="inp-disc-multi-d1" value="20" step="1" min="0" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="20" />
              </div>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 pt-2 border-t border-slate-100 dark:border-slate-800">
              <div>
                <label for="inp-disc-multi-d2" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount 2 (Secondary % off)</label>
                <input type="number" id="inp-disc-multi-d2" value="10" step="1" min="0" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10" />
              </div>

              <!-- Optional 3rd discount row -->
              <div id="row-disc-multi-d3" class="hidden">
                <div class="flex gap-2 items-end">
                  <div class="flex-1">
                    <label for="inp-disc-multi-d3" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount 3 (Promo % off)</label>
                    <input type="number" id="inp-disc-multi-d3" value="5" step="1" min="0" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="5" />
                  </div>
                  <button type="button" id="btn-remove-d3" class="rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-bold text-red-600 hover:bg-red-100 dark:border-red-900/40 dark:bg-red-950/20 dark:text-red-300 cursor-pointer" title="Remove 3rd discount">
                    ✕
                  </button>
                </div>
              </div>

              <div id="box-btn-add-d3" class="flex items-end">
                <button type="button" id="btn-add-d3" class="w-full rounded-xl border border-dashed border-blue-300 dark:border-blue-700 bg-blue-50/50 dark:bg-blue-950/30 p-2.5 text-xs font-bold text-blue-600 dark:text-blue-400 hover:bg-blue-50 cursor-pointer flex items-center justify-center gap-1">
                  <span>➕ Add 3rd Discount (%)</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- ================================================================= -->
        <!-- MODE 5: BUY X GET Y (BOGO / BUNDLE)                               -->
        <!-- ================================================================= -->
        <div id="sec-disc-mode-bogo" class="hidden space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/60 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>🎁</span> Buy X Get Y Free / Discounted Bundle
            </span>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label for="inp-disc-bogo-price" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Individual Unit Retail Price (<span class="lbl-curr-sym">$</span>)
                </label>
                <input type="number" id="inp-disc-bogo-price" value="50" step="5" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="50" />
              </div>

              <div>
                <label for="inp-disc-bogo-total-qty" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Total Items You Want to Buy (Units)
                </label>
                <input type="number" id="inp-disc-bogo-total-qty" value="4" step="1" min="1" max="10000" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="4" />
              </div>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 pt-2 border-t border-slate-100 dark:border-slate-800">
              <div>
                <label for="inp-disc-bogo-buy" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Buy X Items (at Full Price)</label>
                <input type="number" id="inp-disc-bogo-buy" value="1" step="1" min="1" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1" />
              </div>

              <div>
                <label for="inp-disc-bogo-get" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Get Y Items (at Discount)</label>
