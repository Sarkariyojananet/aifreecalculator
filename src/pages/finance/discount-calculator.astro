  const inpCalcOrig = document.getElementById('inp-disc-calc-orig');
  const inpCalcSale = document.getElementById('inp-disc-calc-sale');
  const inpQtyPct = document.getElementById('inp-disc-qty-pct');

  // Input Elements - Mode 3: Original Price
  const inpRevSale = document.getElementById('inp-disc-rev-sale');
  const inpRevPct = document.getElementById('inp-disc-rev-pct');
  const inpQtyOrig = document.getElementById('inp-disc-qty-orig');

  // Input Elements - Mode 4: Multiple Discounts
  const inpMultiOrig = document.getElementById('inp-disc-multi-orig');
  const inpMultiD1 = document.getElementById('inp-disc-multi-d1');
  const inpMultiD2 = document.getElementById('inp-disc-multi-d2');
  const inpMultiD3 = document.getElementById('inp-disc-multi-d3');
  const inpQtyMulti = document.getElementById('inp-disc-qty-multi');
  const rowMultiD3 = document.getElementById('row-disc-multi-d3');
  const btnAddD3 = document.getElementById('btn-add-d3');
  const btnRemoveD3 = document.getElementById('btn-remove-d3');
  const boxBtnAddD3 = document.getElementById('box-btn-add-d3');

  // Input Elements - Mode 5: BOGO / Bundle
  const inpBogoPrice = document.getElementById('inp-disc-bogo-price');
  const inpBogoTotalQty = document.getElementById('inp-disc-bogo-total-qty');
  const inpBogoBuy = document.getElementById('inp-disc-bogo-buy');
  const inpBogoGet = document.getElementById('inp-disc-bogo-get');
  const selBogoDiscount = document.getElementById('sel-disc-bogo-discount');

  // Sales Tax Elements
  const chkApplyTax = document.getElementById('chk-apply-tax');
  const inpTaxRate = document.getElementById('inp-disc-tax-rate');

  // Action Buttons & Error
  const btnCalcDisc = document.getElementById('btn-calc-disc');
  const btnClearDisc = document.getElementById('btn-clear-disc');
  const errDisc = document.getElementById('err-disc');

  // Results Elements
  const discResultsSection = document.getElementById('disc-results-section');
  const lblDiscHeroTitle = document.getElementById('lbl-disc-hero-title');
  const resDiscHeroAmount = document.getElementById('res-disc-hero-amount');
  const resDiscHeroSubtitle = document.getElementById('res-disc-hero-subtitle');
  const lblDiscHeroSecondary = document.getElementById('lbl-disc-hero-secondary');
  const resDiscHeroSecondary = document.getElementById('res-disc-hero-secondary');
  const resDiscHeroSecondarySub = document.getElementById('res-disc-hero-secondary-sub');

  // Visual Bar Elements
  const txtBarPaidPct = document.getElementById('txt-bar-paid-pct');
  const txtBarSavedPct = document.getElementById('txt-bar-saved-pct');
  const barPaidFill = document.getElementById('bar-paid-fill');
  const barSavedFill = document.getElementById('bar-saved-fill');

  // 4 Grid Elements
  const lblDiscGrid1 = document.getElementById('lbl-disc-grid-1');
  const resDiscGrid1 = document.getElementById('res-disc-grid-1');
  const lblDiscGrid2 = document.getElementById('lbl-disc-grid-2');
  const resDiscGrid2 = document.getElementById('res-disc-grid-2');
  const lblDiscGrid3 = document.getElementById('lbl-disc-grid-3');
  const resDiscGrid3 = document.getElementById('res-disc-grid-3');
  const lblDiscGrid4 = document.getElementById('lbl-disc-grid-4');
  const resDiscGrid4 = document.getElementById('res-disc-grid-4');

  // BOGO Extra Details Card Elements
  const boxDiscBogoDetails = document.getElementById('box-disc-bogo-details');
  const resBogoFullCount = document.getElementById('res-bogo-full-count');
  const resBogoFullPrice = document.getElementById('res-bogo-full-price');
  const resBogoDiscCount = document.getElementById('res-bogo-disc-count');
  const resBogoDiscPrice = document.getElementById('res-bogo-disc-price');
  const resBogoUnitPrice = document.getElementById('res-bogo-unit-price');
  const resBogoEffDiscount = document.getElementById('res-bogo-eff-discount');

  // Breakdown Text Elements
  const txtDiscFormulaName = document.getElementById('txt-disc-formula-name');
  const txtDiscBreakdownFormula = document.getElementById('txt-disc-breakdown-formula');
  const txtDiscBreakdownStep1 = document.getElementById('txt-disc-breakdown-step1');
  const txtDiscBreakdownStep2 = document.getElementById('txt-disc-breakdown-step2');
  const boxDiscBreakdownStep3 = document.getElementById('box-disc-breakdown-step3');
  const txtDiscBreakdownStep3 = document.getElementById('txt-disc-breakdown-step3');

  // Comparison Table & PDF
  const tblDiscComparison = document.getElementById('tbl-disc-comparison');
  const btnDiscDownloadPdf = document.getElementById('btn-disc-download-pdf');
  const txtBtnDiscPdf = document.getElementById('txt-btn-disc-pdf');

  // Format Money helper
  function formatMoney(val) {
    const num = Number(val);
    if (isNaN(num)) return `${activeCurrency}0.00`;
    return `${activeCurrency}${num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  // Update Currency Labels
  function updateCurrencySymbols() {
    document.querySelectorAll('.lbl-curr-sym').forEach((el) => {
      el.textContent = activeCurrency;
    });
  }

  selCurrency.addEventListener('change', () => {
    activeCurrency = selCurrency.value;
    updateCurrencySymbols();
    if (!discResultsSection.classList.contains('hidden') && lastCalculatedDiscount) {
      executeDiscountCalculation();
    }
  });

  // Mode Switcher Handler
  document.querySelectorAll('.btn-disc-mode').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-disc-mode').forEach((b) => {
        b.className = 'btn-disc-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center';
      });
      btn.className = 'btn-disc-mode active rounded-xl border border-blue-600 bg-blue-50 px-3 py-2 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer text-center';

      activeDiscountMode = btn.getAttribute('data-mode') || 'sale_price';
      discResultsSection.classList.add('hidden');
      errDisc.classList.add('hidden');
      lastCalculatedDiscount = null;

      secModeSalePrice.classList.add('hidden');
      secModePct.classList.add('hidden');
      secModeOrig.classList.add('hidden');
      secModeMulti.classList.add('hidden');
      secModeBogo.classList.add('hidden');

      if (activeDiscountMode === 'sale_price') {
        secModeSalePrice.classList.remove('hidden');
        txtDiscTitleIcon.textContent = '🏷️';
        txtDiscTitle.textContent = 'Discount & Sale Price Calculator';
        txtDiscSubtitle.textContent = 'Calculate the discount amount, money saved, and final sale price using percentage or fixed discounts.';
      } else if (activeDiscountMode === 'discount_pct') {
        secModePct.classList.remove('hidden');
        txtDiscTitleIcon.textContent = '％';
        txtDiscTitle.textContent = 'Find Discount Percentage';
        txtDiscSubtitle.textContent = 'Find the exact percentage saved based on the original retail price and discounted sale price.';
      } else if (activeDiscountMode === 'original_price') {
        secModeOrig.classList.remove('hidden');
        txtDiscTitleIcon.textContent = '🔄';
        txtDiscTitle.textContent = 'Reverse Original Price Calculator';
        txtDiscSubtitle.textContent = 'Reverse calculate the original pre-discount sticker price from the sale price and discount percentage.';
      } else if (activeDiscountMode === 'multiple') {
        secModeMulti.classList.remove('hidden');
        txtDiscTitleIcon.textContent = '✨';
        txtDiscTitle.textContent = 'Multiple Stacked Discounts Calculator';
        txtDiscSubtitle.textContent = 'Model sequential stacked discounts (e.g. 20% sale + extra 10% coupon) and calculate the true compounding discount.';
      } else {
        secModeBogo.classList.remove('hidden');
        txtDiscTitleIcon.textContent = '🎁';
        txtDiscTitle.textContent = 'Buy X Get Y (BOGO) Bundle Calculator';
        txtDiscSubtitle.textContent = 'Calculate total costs, effective unit prices, and true percentage savings for Buy X Get Y offers and bundles.';
      }
    });
  });

  // Discount Type Toggle (Percentage vs Fixed)
  btnTypePct.addEventListener('click', () => {
    activeDiscountType = 'percentage';
    btnTypePct.className = 'active rounded-xl border border-blue-600 bg-blue-50 py-2.5 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer';
    btnTypeFixed.className = 'rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer';
    boxPctInput.classList.remove('hidden');
    boxFixedInput.classList.add('hidden');
    document.getElementById('box-disc-presets').classList.remove('hidden');
  });

  btnTypeFixed.addEventListener('click', () => {
    activeDiscountType = 'fixed';
    btnTypeFixed.className = 'active rounded-xl border border-blue-600 bg-blue-50 py-2.5 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer';
    btnTypePct.className = 'rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer';
    boxFixedInput.classList.remove('hidden');
    boxPctInput.classList.add('hidden');
    document.getElementById('box-disc-presets').classList.add('hidden');
  });

  // Quick Percentage Preset Buttons
  document.querySelectorAll('.btn-disc-quick-pct').forEach((btn) => {
    btn.addEventListener('click', () => {
      btnTypePct.click();
      inpValPct.value = btn.getAttribute('data-pct') || '20';
    });
  });

  // Multiple Discounts Row 3 handlers
  btnAddD3.addEventListener('click', () => {
    rowMultiD3.classList.remove('hidden');
    boxBtnAddD3.classList.add('hidden');
  });

  btnRemoveD3.addEventListener('click', () => {
    rowMultiD3.classList.add('hidden');
    boxBtnAddD3.classList.remove('hidden');
    inpMultiD3.value = '0';
  });

  // Master Calculation Execution
  function executeDiscountCalculation() {
    errDisc.classList.add('hidden');

    const isTaxEnabled = chkApplyTax.checked;
    const taxRate = isTaxEnabled ? Math.max(0, parseFloat(inpTaxRate.value) || 0) : 0;

    let originalPrice = 0;
    let qty = 1;
    let originalTotal = 0;
    let salePrice = 0;
    let saleTotal = 0;
    let discountAmount = 0;
    let discountPercentage = 0;
    let amountSaved = 0;
    let unitPriceAfterDiscount = 0;
    let salesTaxAmount = 0;
    let finalPriceWithTax = 0;
    let effectiveDiscountPercent = 0;

    let formulaName = '';
    let formulaText = '';
    let step1Text = '';
    let step2Text = '';
    let step3Text = '';

    let bogoData = null;

    if (activeDiscountMode === 'sale_price') {
      originalPrice = parseFloat(inpOrigPrice.value);
      qty = Math.max(1, parseInt(inpQtySale.value) || 1);

      if (isNaN(originalPrice) || originalPrice < 0) {
        errDisc.textContent = 'Please enter a valid original retail price (0 or greater).';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      originalTotal = Number((originalPrice * qty).toFixed(2));

      if (activeDiscountType === 'percentage') {
        discountPercentage = parseFloat(inpValPct.value);
        if (isNaN(discountPercentage) || discountPercentage < 0 || discountPercentage > 100) {
          errDisc.textContent = 'Discount percentage must be between 0% and 100%.';
          errDisc.classList.remove('hidden');
          discResultsSection.classList.add('hidden');
          return;
        }

        const unitDiscount = Number(((originalPrice * discountPercentage) / 100).toFixed(2));
        salePrice = Number((originalPrice - unitDiscount).toFixed(2));
        unitPriceAfterDiscount = salePrice;
        saleTotal = Number((salePrice * qty).toFixed(2));
        discountAmount = Number((unitDiscount * qty).toFixed(2));
        amountSaved = discountAmount;

        formulaName = 'Standard Percentage Discount Formula';
        formulaText = 'Discount Amount = Original Price × (Discount % ÷ 100) | Sale Price = Original Price − Discount';
        step1Text = `${formatMoney(originalPrice)} × (${discountPercentage}% ÷ 100) = ${formatMoney(unitDiscount)} Saved per unit (${formatMoney(discountAmount)} for ${qty} unit${qty > 1 ? 's' : ''})`;
        step2Text = `${formatMoney(originalTotal)} − ${formatMoney(discountAmount)} = ${formatMoney(saleTotal)} Final Sale Price`;
      } else {
        const rawFixed = parseFloat(inpValFixed.value);
        if (isNaN(rawFixed) || rawFixed < 0) {
          errDisc.textContent = 'Fixed discount amount must be 0 or greater.';
          errDisc.classList.remove('hidden');
          discResultsSection.classList.add('hidden');
          return;
        }

        const unitDiscount = Math.min(originalPrice, rawFixed);
        salePrice = Number((originalPrice - unitDiscount).toFixed(2));
        unitPriceAfterDiscount = salePrice;
        discountAmount = Number((unitDiscount * qty).toFixed(2));
        saleTotal = Number((salePrice * qty).toFixed(2));
        amountSaved = discountAmount;
        discountPercentage = originalPrice > 0 ? Number(((unitDiscount / originalPrice) * 100).toFixed(2)) : 0;

        formulaName = 'Fixed Cash Discount Formula';
        formulaText = 'Sale Price = Original Price − Fixed Discount Amount';
        step1Text = `Fixed Cash Markdown: ${formatMoney(unitDiscount)} per unit (${discountPercentage.toFixed(1)}% equivalent)`;
        step2Text = `${formatMoney(originalTotal)} − ${formatMoney(discountAmount)} = ${formatMoney(saleTotal)} Final Sale Price`;
      }

      if (isTaxEnabled && taxRate > 0) {
        salesTaxAmount = Number(((saleTotal * taxRate) / 100).toFixed(2));
        finalPriceWithTax = Number((saleTotal + salesTaxAmount).toFixed(2));
        step3Text = `Sales Tax (${taxRate}%): ${formatMoney(saleTotal)} × ${taxRate}% = ${formatMoney(salesTaxAmount)} | Total with Tax = ${formatMoney(finalPriceWithTax)}`;
      } else {
        finalPriceWithTax = saleTotal;
      }

      lblDiscHeroTitle.textContent = qty > 1 ? 'TOTAL FINAL SALE PRICE' : 'FINAL SALE PRICE';
      resDiscHeroAmount.textContent = formatMoney(isTaxEnabled && taxRate > 0 ? finalPriceWithTax : saleTotal);
      resDiscHeroSubtitle.textContent = activeDiscountType === 'percentage'
        ? `${discountPercentage}% Off applied to ${qty} unit${qty > 1 ? 's' : ''} (${formatMoney(salePrice)}/item)`
        : `${formatMoney(discountAmount)} Markdown applied to ${qty} unit${qty > 1 ? 's' : ''} (${discountPercentage.toFixed(1)}% equivalent)`;
      lblDiscHeroSecondary.textContent = 'Total Money Saved:';
      resDiscHeroSecondary.textContent = formatMoney(amountSaved);
      resDiscHeroSecondarySub.textContent = `${discountPercentage.toFixed(1)}% Off Original`;

      lblDiscGrid1.textContent = qty > 1 ? `Original (${qty} units)` : 'Original Price';
      resDiscGrid1.textContent = formatMoney(originalTotal);
      lblDiscGrid2.textContent = 'Discount Rate';
      resDiscGrid2.textContent = activeDiscountType === 'percentage' ? `${discountPercentage}%` : formatMoney(discountAmount);
      lblDiscGrid3.textContent = isTaxEnabled && taxRate > 0 ? `Tax (${taxRate}%)` : 'Discount Amount';
      resDiscGrid3.textContent = isTaxEnabled && taxRate > 0 ? formatMoney(salesTaxAmount) : formatMoney(discountAmount);
      lblDiscGrid4.textContent = isTaxEnabled && taxRate > 0 ? 'Total with Tax' : 'Final Sale Price';
      resDiscGrid4.textContent = formatMoney(finalPriceWithTax);

      boxDiscBogoDetails.classList.add('hidden');

    } else if (activeDiscountMode === 'discount_pct') {
      originalPrice = parseFloat(inpCalcOrig.value);
      salePrice = parseFloat(inpCalcSale.value);
      qty = Math.max(1, parseInt(inpQtyPct.value) || 1);

      if (isNaN(originalPrice) || originalPrice <= 0) {
        errDisc.textContent = 'Original retail price must be greater than 0.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      if (isNaN(salePrice) || salePrice < 0) {
        errDisc.textContent = 'Discounted sale price must be 0 or greater.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      if (salePrice > originalPrice) {
        errDisc.textContent = 'Sale price cannot exceed the original retail price.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      originalTotal = Number((originalPrice * qty).toFixed(2));
      saleTotal = Number((salePrice * qty).toFixed(2));
      const unitSaved = Number((originalPrice - salePrice).toFixed(2));
      discountAmount = Number((unitSaved * qty).toFixed(2));
      amountSaved = discountAmount;
      discountPercentage = Number(((unitSaved / originalPrice) * 100).toFixed(2));
      unitPriceAfterDiscount = salePrice;

      if (isTaxEnabled && taxRate > 0) {
        salesTaxAmount = Number(((saleTotal * taxRate) / 100).toFixed(2));
        finalPriceWithTax = Number((saleTotal + salesTaxAmount).toFixed(2));
        step3Text = `Sales Tax (${taxRate}%): ${formatMoney(saleTotal)} × ${taxRate}% = ${formatMoney(salesTaxAmount)} | Total with Tax = ${formatMoney(finalPriceWithTax)}`;
      } else {
        finalPriceWithTax = saleTotal;
      }

      formulaName = 'Reverse Discount Percentage Formula';
      formulaText = 'Discount % = ((Original Price − Sale Price) ÷ Original Price) × 100';
      step1Text = `${formatMoney(originalPrice)} − ${formatMoney(salePrice)} = ${formatMoney(unitSaved)} Saved per unit (${formatMoney(amountSaved)} total)`;
      step2Text = `(${formatMoney(amountSaved)} ÷ ${formatMoney(originalTotal)}) × 100 = ${discountPercentage}% Total Discount Rate`;

      lblDiscHeroTitle.textContent = 'DISCOUNT PERCENTAGE SAVED';
      resDiscHeroAmount.textContent = `${discountPercentage}% OFF`;
      resDiscHeroSubtitle.textContent = `Calculated from ${formatMoney(originalPrice)} down to ${formatMoney(salePrice)} per unit`;
      lblDiscHeroSecondary.textContent = 'Total Money Saved:';
      resDiscHeroSecondary.textContent = formatMoney(amountSaved);
      resDiscHeroSecondarySub.textContent = `${formatMoney(saleTotal)} Net Sale Total`;

      lblDiscGrid1.textContent = qty > 1 ? `Original (${qty} units)` : 'Original MSRP';
      resDiscGrid1.textContent = formatMoney(originalTotal);
      lblDiscGrid2.textContent = qty > 1 ? `Sale (${qty} units)` : 'Sale Price';
      resDiscGrid2.textContent = formatMoney(saleTotal);
      lblDiscGrid3.textContent = 'Total Savings';
      resDiscGrid3.textContent = formatMoney(amountSaved);
      lblDiscGrid4.textContent = 'Discount Rate';
      resDiscGrid4.textContent = `${discountPercentage}%`;

      boxDiscBogoDetails.classList.add('hidden');

    } else if (activeDiscountMode === 'original_price') {
      salePrice = parseFloat(inpRevSale.value);
      discountPercentage = parseFloat(inpRevPct.value);
      qty = Math.max(1, parseInt(inpQtyOrig.value) || 1);

      if (isNaN(salePrice) || salePrice <= 0) {
        errDisc.textContent = 'Sale price must be greater than 0.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      if (isNaN(discountPercentage) || discountPercentage < 0 || discountPercentage >= 100) {
        errDisc.textContent = 'Discount percentage must be between 0% and 99.99% for reverse calculation.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      originalPrice = Number((salePrice / (1 - discountPercentage / 100)).toFixed(2));
      originalTotal = Number((originalPrice * qty).toFixed(2));
      saleTotal = Number((salePrice * qty).toFixed(2));
      discountAmount = Number(((originalPrice - salePrice) * qty).toFixed(2));
      amountSaved = discountAmount;
      unitPriceAfterDiscount = salePrice;

      if (isTaxEnabled && taxRate > 0) {
        salesTaxAmount = Number(((saleTotal * taxRate) / 100).toFixed(2));
        finalPriceWithTax = Number((saleTotal + salesTaxAmount).toFixed(2));
        step3Text = `Sales Tax (${taxRate}%): ${formatMoney(saleTotal)} × ${taxRate}% = ${formatMoney(salesTaxAmount)} | Total with Tax = ${formatMoney(finalPriceWithTax)}`;
      } else {
        finalPriceWithTax = saleTotal;
      }

      formulaName = 'Reverse MSRP Original Price Formula';
      formulaText = 'Original Price = Sale Price ÷ (1 − Discount % ÷ 100)';
      step1Text = `${formatMoney(salePrice)} ÷ (1 − ${discountPercentage / 100}) = ${formatMoney(originalPrice)} Original MSRP per unit`;
      step2Text = `${formatMoney(originalTotal)} − ${formatMoney(saleTotal)} = ${formatMoney(discountAmount)} Total Discount Deducted`;

      lblDiscHeroTitle.textContent = qty > 1 ? 'ESTIMATED ORIGINAL TOTAL' : 'ESTIMATED ORIGINAL PRICE';
      resDiscHeroAmount.textContent = formatMoney(originalTotal);
      resDiscHeroSubtitle.textContent = `Restored from ${formatMoney(salePrice)} at ${discountPercentage}% discount (${formatMoney(originalPrice)}/unit MSRP)`;
      lblDiscHeroSecondary.textContent = 'Total Discount Value:';
      resDiscHeroSecondary.textContent = formatMoney(discountAmount);
      resDiscHeroSecondarySub.textContent = `${discountPercentage}% Off Pre-Discount MSRP`;

      lblDiscGrid1.textContent = qty > 1 ? `Sale Total (${qty} units)` : 'Current Sale Price';
      resDiscGrid1.textContent = formatMoney(saleTotal);
      lblDiscGrid2.textContent = 'Discount Rate';
      resDiscGrid2.textContent = `${discountPercentage}%`;
      lblDiscGrid3.textContent = 'Discount Value';
      resDiscGrid3.textContent = formatMoney(discountAmount);
      lblDiscGrid4.textContent = qty > 1 ? 'Original MSRP Total' : 'Original Price';
      resDiscGrid4.textContent = formatMoney(originalTotal);

      boxDiscBogoDetails.classList.add('hidden');

    } else if (activeDiscountMode === 'multiple') {
      // Multiple Stacked Sequential Discounts
      originalPrice = parseFloat(inpMultiOrig.value);
      qty = Math.max(1, parseInt(inpQtyMulti.value) || 1);

      if (isNaN(originalPrice) || originalPrice <= 0) {
        errDisc.textContent = 'Original price must be greater than 0.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      const d1 = Math.min(100, Math.max(0, parseFloat(inpMultiD1.value) || 0));
      const d2 = Math.min(100, Math.max(0, parseFloat(inpMultiD2.value) || 0));
      const d3 = !rowMultiD3.classList.contains('hidden') ? Math.min(100, Math.max(0, parseFloat(inpMultiD3.value) || 0)) : 0;

      const rawDiscounts = [d1, d2];
      if (d3 > 0) rawDiscounts.push(d3);

      originalTotal = Number((originalPrice * qty).toFixed(2));
      let curUnitPrice = originalPrice;
      const stepDescs = [];

      rawDiscounts.forEach((pct, idx) => {
        const saved = Number(((curUnitPrice * pct) / 100).toFixed(2));
        const nextP = Number((curUnitPrice - saved).toFixed(2));
        stepDescs.push(`D${idx + 1} (${pct}%): ${formatMoney(curUnitPrice)} → ${formatMoney(nextP)} (-${formatMoney(saved)})`);
        curUnitPrice = nextP;
      });

      salePrice = curUnitPrice;
      unitPriceAfterDiscount = salePrice;
      saleTotal = Number((salePrice * qty).toFixed(2));
      amountSaved = Number((originalTotal - saleTotal).toFixed(2));
      discountAmount = amountSaved;
      effectiveDiscountPercent = originalTotal > 0 ? Number(((amountSaved / originalTotal) * 100).toFixed(2)) : 0;
      discountPercentage = effectiveDiscountPercent;

      if (isTaxEnabled && taxRate > 0) {
        salesTaxAmount = Number(((saleTotal * taxRate) / 100).toFixed(2));
        finalPriceWithTax = Number((saleTotal + salesTaxAmount).toFixed(2));
        step3Text = `Sales Tax (${taxRate}%): ${formatMoney(saleTotal)} × ${taxRate}% = ${formatMoney(salesTaxAmount)} | Total with Tax = ${formatMoney(finalPriceWithTax)}`;
      } else {
        finalPriceWithTax = saleTotal;
      }

      const naiveSum = rawDiscounts.reduce((a, b) => a + b, 0);
      formulaName = 'Sequential Compounding Formula';
      formulaText = 'Price_n = Price_{n-1} × (1 − Discount_n ÷ 100) | Effective % = (Total Saved ÷ Original) × 100';
      step1Text = stepDescs.join(' | ');
      step2Text = `Total Saved: ${formatMoney(amountSaved)} | True Effective Compounding Discount: ${effectiveDiscountPercent}% (vs ${naiveSum.toFixed(1)}% naive sum)`;

      lblDiscHeroTitle.textContent = qty > 1 ? 'FINAL STACKED SALE PRICE' : 'FINAL SALE PRICE';
      resDiscHeroAmount.textContent = formatMoney(isTaxEnabled && taxRate > 0 ? finalPriceWithTax : saleTotal);
      resDiscHeroSubtitle.textContent = `Effective Compounding Discount: ${effectiveDiscountPercent}% (${rawDiscounts.join('% + ')}% stacked)`;
      lblDiscHeroSecondary.textContent = 'Total Money Saved:';
      resDiscHeroSecondary.textContent = formatMoney(amountSaved);
      resDiscHeroSecondarySub.textContent = `${effectiveDiscountPercent}% True Discount`;

      lblDiscGrid1.textContent = qty > 1 ? `Original (${qty} units)` : 'Original Price';
      resDiscGrid1.textContent = formatMoney(originalTotal);
      lblDiscGrid2.textContent = 'Stacked Discounts';
      resDiscGrid2.textContent = rawDiscounts.map(d => `${d}%`).join(' + ');
      lblDiscGrid3.textContent = isTaxEnabled && taxRate > 0 ? `Tax (${taxRate}%)` : 'Total Saved';
      resDiscGrid3.textContent = isTaxEnabled && taxRate > 0 ? formatMoney(salesTaxAmount) : formatMoney(amountSaved);
      lblDiscGrid4.textContent = isTaxEnabled && taxRate > 0 ? 'Total with Tax' : 'Final Sale Price';
      resDiscGrid4.textContent = formatMoney(finalPriceWithTax);

      boxDiscBogoDetails.classList.add('hidden');

    } else {
      // Mode 5: Buy X Get Y (BOGO / Bundle)
      const unitPrice = Math.max(0, parseFloat(inpBogoPrice.value) || 0);
      const buyX = Math.max(1, parseInt(inpBogoBuy.value) || 1);
      const getY = Math.max(1, parseInt(inpBogoGet.value) || 1);
      const bogoDiscPct = Math.min(100, Math.max(0, parseFloat(selBogoDiscount.value) || 100));
      const totalItems = Math.max(buyX + getY, parseInt(inpBogoTotalQty.value) || (buyX + getY));

      if (isNaN(unitPrice) || unitPrice <= 0) {
        errDisc.textContent = 'Individual unit price must be greater than 0.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      const bundleSize = buyX + getY;
      const fullBundles = Math.floor(totalItems / bundleSize);
      const remainder = totalItems % bundleSize;

      const fullPriceItems = (fullBundles * buyX) + remainder;
      const discountedItems = fullBundles * getY;

      const fullPriceTotal = fullPriceItems * unitPrice;
      const discountedUnit = unitPrice * (1 - bogoDiscPct / 100);
      const discountedTotal = discountedItems * discountedUnit;

      originalPrice = unitPrice;
      originalTotal = Number((totalItems * unitPrice).toFixed(2));
      saleTotal = Number((fullPriceTotal + discountedTotal).toFixed(2));
      salePrice = totalItems > 0 ? Number((saleTotal / totalItems).toFixed(2)) : 0;
      unitPriceAfterDiscount = salePrice;
      amountSaved = Number((originalTotal - saleTotal).toFixed(2));
      discountAmount = amountSaved;
      effectiveDiscountPercent = originalTotal > 0 ? Number(((amountSaved / originalTotal) * 100).toFixed(2)) : 0;
      discountPercentage = effectiveDiscountPercent;

      if (isTaxEnabled && taxRate > 0) {
        salesTaxAmount = Number(((saleTotal * taxRate) / 100).toFixed(2));
        finalPriceWithTax = Number((saleTotal + salesTaxAmount).toFixed(2));
        step3Text = `Sales Tax (${taxRate}%): ${formatMoney(saleTotal)} × ${taxRate}% = ${formatMoney(salesTaxAmount)} | Total with Tax = ${formatMoney(finalPriceWithTax)}`;
      } else {
        finalPriceWithTax = saleTotal;
      }

      formulaName = `Buy ${buyX} Get ${getY} (${bogoDiscPct}% Off) Bundle Formula`;
      formulaText = 'Bundle Subtotal = (Full Price Units × Unit Price) + (Discounted Units × Unit Price × (1 − Discount % ÷ 100))';
      step1Text = `${fullPriceItems} item${fullPriceItems > 1 ? 's' : ''} at full price (${formatMoney(fullPriceTotal)}) + ${discountedItems} item${discountedItems > 1 ? 's' : ''} with ${bogoDiscPct}% off (${formatMoney(discountedTotal)})`;
      step2Text = `Total Paid: ${formatMoney(saleTotal)} (${formatMoney(salePrice)}/item avg) | Total Saved: ${formatMoney(amountSaved)} (${effectiveDiscountPercent}% off)`;

      lblDiscHeroTitle.textContent = `BUNDLE TOTAL FOR ${totalItems} ITEMS`;
      resDiscHeroAmount.textContent = formatMoney(isTaxEnabled && taxRate > 0 ? finalPriceWithTax : saleTotal);
      resDiscHeroSubtitle.textContent = `Effective Unit Price: ${formatMoney(salePrice)}/item (${effectiveDiscountPercent}% overall discount)`;
      lblDiscHeroSecondary.textContent = 'Total Money Saved:';
      resDiscHeroSecondary.textContent = formatMoney(amountSaved);
      resDiscHeroSecondarySub.textContent = `${effectiveDiscountPercent}% Off Regular Total`;

      lblDiscGrid1.textContent = `Original (${totalItems} items)`;
      resDiscGrid1.textContent = formatMoney(originalTotal);
      lblDiscGrid2.textContent = 'Avg Price/Item';
      resDiscGrid2.textContent = formatMoney(salePrice);
      lblDiscGrid3.textContent = isTaxEnabled && taxRate > 0 ? `Tax (${taxRate}%)` : 'Total Saved';
      resDiscGrid3.textContent = isTaxEnabled && taxRate > 0 ? formatMoney(salesTaxAmount) : formatMoney(amountSaved);
      lblDiscGrid4.textContent = isTaxEnabled && taxRate > 0 ? 'Total with Tax' : 'Bundle Total';
      resDiscGrid4.textContent = formatMoney(finalPriceWithTax);

      // Populate BOGO details box
      bogoData = {
        fullPriceItems,
        discountedItems,
        fullPriceTotal,
        discountedTotal,
        effectiveUnitPrice: salePrice,
        effectiveDiscountPercent,
        totalItems,
      };

      resBogoFullCount.textContent = `${fullPriceItems} item${fullPriceItems > 1 ? 's' : ''}`;
      resBogoFullPrice.textContent = formatMoney(fullPriceTotal);
      resBogoDiscCount.textContent = `${discountedItems} item${discountedItems > 1 ? 's' : ''} (${bogoDiscPct}% off)`;
      resBogoDiscPrice.textContent = formatMoney(discountedTotal);
      resBogoUnitPrice.textContent = `${formatMoney(salePrice)}/item`;
      resBogoEffDiscount.textContent = `${effectiveDiscountPercent}% Off`;

      boxDiscBogoDetails.classList.remove('hidden');
    }

    // Update Visual Proportions Bar
    const paidPct = originalTotal > 0 ? Math.min(100, Math.max(0, Number(((saleTotal / originalTotal) * 100).toFixed(1)))) : 100;
    const savedPct = Number((100 - paidPct).toFixed(1));

    txtBarPaidPct.textContent = `${paidPct}%`;
    txtBarSavedPct.textContent = `${savedPct}%`;
    barPaidFill.style.width = `${paidPct}%`;
    barSavedFill.style.width = `${savedPct}%`;

    // Step-by-Step UI Update
    txtDiscFormulaName.textContent = formulaName;
    txtDiscBreakdownFormula.textContent = formulaText;
    txtDiscBreakdownStep1.textContent = step1Text;
    txtDiscBreakdownStep2.textContent = step2Text;

    if (step3Text) {
      boxDiscBreakdownStep3.classList.remove('hidden');
      txtDiscBreakdownStep3.textContent = step3Text;
    } else {
      boxDiscBreakdownStep3.classList.add('hidden');
    }

    // Comparison Matrix Generation
    const baseForComp = originalTotal > 0 ? originalTotal : (originalPrice > 0 ? originalPrice : 1000);
    const stdPercentages = [5, 10, 15, 20, 25, 30, 40, 50, 60, 70, 75, 80, 90];
    const roundedActivePct = Math.round(discountPercentage);
    if (roundedActivePct > 0 && roundedActivePct < 100 && !stdPercentages.includes(roundedActivePct)) {
      stdPercentages.push(roundedActivePct);
      stdPercentages.sort((a, b) => a - b);
    }

    tblDiscComparison.innerHTML = stdPercentages.map((pct) => {
      const saved = Number(((baseForComp * pct) / 100).toFixed(2));
      const finalP = Number((baseForComp - saved).toFixed(2));
      const isCur = Math.abs(pct - discountPercentage) < 0.01;

      return `
        <tr class="hover:bg-blue-50/50 dark:hover:bg-slate-800/60 cursor-pointer transition ${isCur ? 'bg-blue-50/80 dark:bg-blue-950/40 font-bold' : ''}" data-comp-pct="${pct}" title="Click to apply ${pct}% discount">
          <td class="p-2.5 font-sans font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <span>${pct}%</span>
            ${isCur ? '<span class="rounded bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 px-1.5 py-0.2 text-[10px] font-extrabold">Active</span>' : ''}
          </td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatMoney(saved)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatMoney(finalP)}</td>
        </tr>
      `;
    }).join('');

    // Add interactive click to comparison rows
    tblDiscComparison.querySelectorAll('tr[data-comp-pct]').forEach((row) => {
      row.addEventListener('click', () => {
        const compPct = row.getAttribute('data-comp-pct');
        if (compPct) {
          const saleBtn = document.querySelector('.btn-disc-mode[data-mode="sale_price"]');
          if (saleBtn) saleBtn.click();
          btnTypePct.click();
          inpValPct.value = compPct;
          executeDiscountCalculation();
        }
      });
    });

    // Save State for PDF and Action Bar
    lastCalculatedDiscount = {
      mode: activeDiscountMode,
      currency: activeCurrency,
      originalPrice,
      originalTotal,
      quantity: qty,
      salePrice,
      saleTotal,
      discountAmount,
      discountPercentage,
      amountSaved,
      isTaxEnabled,
      taxRate,
      salesTaxAmount,
      finalPriceWithTax,
      effectiveDiscountPercent,
      paidPercentage: paidPct,
      savedPercentage: savedPct,
      bogoData,
      comparisonList: stdPercentages.map((pct) => ({
        pct,
        saved: Number(((baseForComp * pct) / 100).toFixed(2)),
        finalP: Number((baseForComp - ((baseForComp * pct) / 100)).toFixed(2)),
        isCurrent: Math.abs(pct - discountPercentage) < 0.01,
      })),
    };

    // Show Results Section (Strict Gated Display)
    discResultsSection.classList.remove('hidden');

    // Notify Action Bar
    document.dispatchEvent(new CustomEvent('calculator:updated', { detail: lastCalculatedDiscount }));
  }

  // Clear All Form Fields & Hide Results
  btnClearDisc.addEventListener('click', () => {
    const saleModeBtn = document.querySelector('.btn-disc-mode[data-mode="sale_price"]');
    if (saleModeBtn) saleModeBtn.click();

    inpOrigPrice.value = '1000';
    btnTypePct.click();
    inpValPct.value = '20';
    inpValFixed.value = '200';
    inpQtySale.value = '1';

    inpCalcOrig.value = '100';
    inpCalcSale.value = '75';
    inpQtyPct.value = '1';

    inpRevSale.value = '800';
    inpRevPct.value = '20';
    inpQtyOrig.value = '1';

    inpMultiOrig.value = '1000';
    inpMultiD1.value = '20';
    inpMultiD2.value = '10';
    inpMultiD3.value = '5';
    inpQtyMulti.value = '1';
    btnRemoveD3.click();

    inpBogoPrice.value = '50';
    inpBogoTotalQty.value = '4';
    inpBogoBuy.value = '1';
    inpBogoGet.value = '1';
    selBogoDiscount.value = '100';

    chkApplyTax.checked = false;
    inpTaxRate.value = '7.5';

    errDisc.classList.add('hidden');
    discResultsSection.classList.add('hidden');
    lastCalculatedDiscount = null;

    // Notify Action Bar
    document.dispatchEvent(new CustomEvent('calculator:updated', { detail: null }));
  });

  // Calculate Button click triggers calculation
  btnCalcDisc.addEventListener('click', executeDiscountCalculation);

  // Form inputs trigger calculation on Enter key
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeDiscountCalculation();
        }
      });
    });
  });

  // Tab-Selective Branded PDF Export
  async function generateDiscountPdf() {
    if (!lastCalculatedDiscount) {
      alert('Please calculate your discount first.');
      return;
    }

    btnDiscDownloadPdf.disabled = true;
    const originalText = txtBtnDiscPdf.textContent;
    txtBtnDiscPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      const sym = lastCalculatedDiscount.currency || '$';

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Financial Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      let docTitle = 'Discount & Sale Price Calculation';
      if (lastCalculatedDiscount.mode === 'discount_pct') {
        docTitle = 'Discount Percentage Calculation';
      } else if (lastCalculatedDiscount.mode === 'original_price') {
        docTitle = 'Original Price Calculation';
      } else if (lastCalculatedDiscount.mode === 'multiple') {
        docTitle = 'Multiple Stacked Discount Calculation';
      } else if (lastCalculatedDiscount.mode === 'bogo') {
        docTitle = 'Buy X Get Y (BOGO) Bundle Calculation';
      }

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(docTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 34, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('CALCULATION SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);

      doc.text(`Original Retail Total: ${sym}${lastCalculatedDiscount.originalTotal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 44);
      doc.text(`Discount Rate: ${lastCalculatedDiscount.discountPercentage.toFixed(1)}%`, 18, 49);
      doc.text(`Total Money Saved: ${sym}${lastCalculatedDiscount.amountSaved.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 54);
      doc.text(`Quantity: ${lastCalculatedDiscount.quantity} unit${lastCalculatedDiscount.quantity > 1 ? 's' : ''}`, 18, 59);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(16, 185, 129);
      doc.text(`Final Sale Price: ${sym}${lastCalculatedDiscount.saleTotal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 105, 44);

      if (lastCalculatedDiscount.isTaxEnabled && lastCalculatedDiscount.taxRate > 0) {
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(71, 85, 105);
        doc.text(`Sales Tax (${lastCalculatedDiscount.taxRate}%): ${sym}${lastCalculatedDiscount.salesTaxAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 105, 49);
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(37, 99, 235);
        doc.text(`Total with Tax: ${sym}${lastCalculatedDiscount.finalPriceWithTax.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 105, 54);
      } else {
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(71, 85, 105);
        doc.text(`Unit Price: ${sym}${lastCalculatedDiscount.salePrice.toLocaleString('en-US', { minimumFractionDigits: 2 })}/item`, 105, 49);
      }

      // 4. Comparison Table
      const tableHead = [['Discount Percentage', 'Total Amount Saved', 'Final Sale Price']];
      const tableData = lastCalculatedDiscount.comparisonList.map((r) => [
        `${r.pct}% ${r.isCurrent ? '(Active)' : ''}`,
        `${sym}${r.saved.toLocaleString('en-US', { minimumFractionDigits: 2 })}`,
        `${sym}${r.finalP.toLocaleString('en-US', { minimumFractionDigits: 2 })}`
      ]);

      doc.autoTable({
        startY: 72,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { halign: 'left', fontStyle: 'bold' },
          1: { halign: 'right', fontStyle: 'bold', textColor: [16, 185, 129] },
          2: { halign: 'right', fontStyle: 'bold', textColor: [37, 99, 235] }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const todayStr = new Date().toISOString().split('T')[0];
      doc.save(`discount-calculation-report-${todayStr}.pdf`);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnDiscDownloadPdf.disabled = false;
      txtBtnDiscPdf.textContent = originalText;
    }
  }

  btnDiscDownloadPdf.addEventListener('click', generateDiscountPdf);
</script>
