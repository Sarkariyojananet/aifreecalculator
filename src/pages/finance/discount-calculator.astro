---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Discount & Sale Price Calculator – Calculate Discount and Final Price"
  description="Calculate the discount amount, amount saved, and final sale price using a percentage or fixed discount."
  category="Finance"
  calculatorName="Discount & Sale Price Calculator"
  slug="discount-calculator"
  keywords={[
    'discount calculator',
    'sale price calculator',
    'discount percentage calculator',
    'percentage off calculator',
    'price after discount calculator',
    'calculate discount',
    'discount amount calculator',
    'multiple discount calculator',
    'sale price after discount',
    'original price calculator'
  ]}
>
  <div class="space-y-6">

    <!-- CALCULATION MODE SELECTOR TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 hidden sm:inline">
          Mode:
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 w-full sm:w-auto text-xs font-bold">
          <button type="button" class="btn-disc-mode active rounded-xl border border-blue-600 bg-blue-50 px-3 py-2 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer text-center" data-mode="sale_price">
            🏷️ Find Sale Price
          </button>
          <button type="button" class="btn-disc-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="discount_pct">
            ％ Find Discount %
          </button>
          <button type="button" class="btn-disc-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="original_price">
            🔄 Find Original Price
          </button>
          <button type="button" class="btn-disc-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="multiple">
            ✨ Multiple Discounts
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
        <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
          <span>🏷️</span> Discount & Sale Price Calculator
        </h2>
        <p id="txt-disc-subtitle" class="mt-1 text-xs text-slate-600 dark:text-slate-400">
          Calculate the discount amount, amount saved, and final sale price using a percentage or fixed discount.
        </p>
      </div>

      <form id="form-discount" class="mt-4 space-y-4" novalidate onsubmit="return false;">
        
        <!-- SECTION 1: DYNAMIC INPUT CONTROLS ACCORDING TO MODE -->
        
        <!-- Mode A: Find Sale Price Inputs -->
        <div id="sec-disc-mode-saleprice" class="space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>💰</span> Price & Discount Value
            </span>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label for="inp-disc-orig-price" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Original Retail Price ($ / ₹)</label>
                <input type="number" id="inp-disc-orig-price" value="1000" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1,000" />
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount Type</label>
                <div class="mt-1 grid grid-cols-2 gap-2 text-xs font-bold">
                  <button type="button" id="btn-type-pct" class="active rounded-xl border border-blue-600 bg-blue-50 py-2.5 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer">
                    Percentage (%) Off
                  </button>
                  <button type="button" id="btn-type-fixed" class="rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer">
                    Fixed Amount ($ / ₹)
                  </button>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 pt-2 border-t border-slate-100 dark:border-slate-800">
              <div id="box-disc-pct-input">
                <label for="inp-disc-val-pct" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount Percentage (% off)</label>
                <input type="number" id="inp-disc-val-pct" value="20" step="1" min="0" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="20" />
              </div>

              <div id="box-disc-fixed-input" class="hidden">
                <label for="inp-disc-val-fixed" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Fixed Discount Amount ($ / ₹)</label>
                <input type="number" id="inp-disc-val-fixed" value="200" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="200" />
              </div>

              <!-- Quick Discount Presets -->
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Quick Discount Presets</label>
                <div class="mt-1 flex flex-wrap gap-1.5">
                  <button type="button" class="btn-disc-quick-pct rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="10">10%</button>
                  <button type="button" class="btn-disc-quick-pct rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="15">15%</button>
                  <button type="button" class="btn-disc-quick-pct rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="20">20%</button>
                  <button type="button" class="btn-disc-quick-pct rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="25">25%</button>
                  <button type="button" class="btn-disc-quick-pct rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="30">30%</button>
                  <button type="button" class="btn-disc-quick-pct rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="40">40%</button>
                  <button type="button" class="btn-disc-quick-pct rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-pct="50">50%</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Mode B: Find Discount Percentage Inputs -->
        <div id="sec-disc-mode-pct" class="hidden space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>🔍</span> Calculate Discount % from Prices
            </span>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label for="inp-disc-calc-orig" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Original Retail Price ($ / ₹)</label>
                <input type="number" id="inp-disc-calc-orig" value="100" step="5" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="100" />
              </div>

              <div>
                <label for="inp-disc-calc-sale" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Final Sale Price ($ / ₹)</label>
                <input type="number" id="inp-disc-calc-sale" value="75" step="5" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="75" />
              </div>
            </div>
          </div>
        </div>

        <!-- Mode C: Find Original Price Inputs -->
        <div id="sec-disc-mode-orig" class="hidden space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>🔄</span> Reverse Original Price from Sale Price
            </span>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label for="inp-disc-rev-sale" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Current Sale Price ($ / ₹)</label>
                <input type="number" id="inp-disc-rev-sale" value="800" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="800" />
              </div>

              <div>
                <label for="inp-disc-rev-pct" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Discount Percentage Applied (% off)</label>
                <input type="number" id="inp-disc-rev-pct" value="20" step="1" min="0" max="99.99" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="20" />
              </div>
            </div>
          </div>
        </div>

        <!-- Mode D: Multiple Discounts Inputs -->
        <div id="sec-disc-mode-multi" class="hidden space-y-4">
          <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>✨</span> Sequential Stacked Discounts
            </span>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
              <div>
                <label for="inp-disc-multi-orig" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Original Price ($ / ₹)</label>
                <input type="number" id="inp-disc-multi-orig" value="1000" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="1,000" />
              </div>

              <div>
                <label for="inp-disc-multi-d1" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Primary Discount 1 (%)</label>
                <input type="number" id="inp-disc-multi-d1" value="20" step="1" min="0" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="20" />
              </div>

              <div>
                <label for="inp-disc-multi-d2" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Secondary Discount 2 (%)</label>
                <input type="number" id="inp-disc-multi-d2" value="10" step="1" min="0" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10" />
              </div>
            </div>

            <!-- Optional 3rd discount row -->
            <div id="row-disc-multi-d3" class="hidden pt-2 border-t border-slate-100 dark:border-slate-800">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="sm:col-span-2">
                  <label for="inp-disc-multi-d3" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Additional Promo Discount 3 (%)</label>
                  <input type="number" id="inp-disc-multi-d3" value="5" step="1" min="0" max="100" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="5" />
                </div>
                <div class="flex items-end">
                  <button type="button" id="btn-remove-d3" class="w-full rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-bold text-red-600 hover:bg-red-100 dark:border-red-900/40 dark:bg-red-950/20 dark:text-red-300 cursor-pointer">
                    ✕ Remove 3rd Discount
                  </button>
                </div>
              </div>
            </div>

            <div id="box-btn-add-d3">
              <button type="button" id="btn-add-d3" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline cursor-pointer flex items-center gap-1">
                <span>➕ Add Another Discount (%)</span>
              </button>
            </div>
          </div>
        </div>

        <!-- OPTIONAL SALES TAX SECTION (Accordion) -->
        <details class="group rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            <span class="flex items-center gap-1.5">
              <span>🧾</span> Optional: Apply Sales Tax After Discount
            </span>
            <span class="text-blue-600 dark:text-blue-400 font-semibold text-[11px] group-open:rotate-180 transition-transform">▼ Expand</span>
          </summary>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
            <div class="flex items-center gap-2 pt-2">
              <input type="checkbox" id="chk-apply-tax" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 cursor-pointer" />
              <label for="chk-apply-tax" class="font-bold text-slate-700 dark:text-slate-300 cursor-pointer">
                Enable Sales Tax Calculation
              </label>
            </div>

            <div>
              <label for="inp-disc-tax-rate" class="block font-bold text-slate-700 dark:text-slate-300">Sales Tax Rate (% percentage)</label>
              <input type="number" id="inp-disc-tax-rate" value="7.5" step="0.1" min="0" max="35" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="7.5" />
            </div>
          </div>
        </details>

        <!-- ACTION BUTTONS -->
        <div class="flex items-center gap-2 pt-2">
          <button type="submit" id="btn-calc-disc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
            Calculate Discount →
          </button>
          <button type="button" id="btn-clear-disc" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
            Clear All (✕)
          </button>
        </div>

        <!-- ACCESSIBLE ERROR -->
        <p id="err-disc" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

      </form>

      <!-- RESULTS PRESENTATION SECTION (Hidden initially) -->
      <div id="disc-results-section" class="hidden mt-6 space-y-6">
        
        <!-- 1. MAIN RESULT HERO CARD -->
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="lbl-disc-hero-title" class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">FINAL SALE PRICE</span>
              <div id="res-disc-hero-amount" class="mt-1 text-3xl sm:text-4xl lg:text-5xl font-black text-blue-600 dark:text-blue-400">$ 800.00</div>
              <div id="res-disc-hero-subtitle" class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">20% Discount Applied</div>
            </div>
            <div class="sm:text-right">
              <span id="lbl-disc-hero-secondary" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Money Saved:</span>
              <div id="res-disc-hero-secondary" class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400">$ 200.00</div>
            </div>
          </div>

          <div id="grid-disc-summary" class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div id="lbl-disc-grid-1" class="text-slate-500 dark:text-slate-400 font-semibold">Original Price</div>
              <div id="res-disc-grid-1" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">$ 1,000.00</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div id="lbl-disc-grid-2" class="text-slate-500 dark:text-slate-400 font-semibold">Discount</div>
              <div id="res-disc-grid-2" class="mt-1 text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400">20%</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div id="lbl-disc-grid-3" class="text-slate-500 dark:text-slate-400 font-semibold">Discount Amount</div>
              <div id="res-disc-grid-3" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">$ 200.00</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div id="lbl-disc-grid-4" class="text-slate-500 dark:text-slate-400 font-semibold">Final Sale Price</div>
              <div id="res-disc-grid-4" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">$ 800.00</div>
            </div>
          </div>
        </div>

        <!-- 2. STEP-BY-STEP CALCULATION BREAKDOWN -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-200 pb-3 dark:border-slate-800">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>📐</span> Discount Calculation Breakdown
            </h3>
            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono" id="txt-disc-formula-name">
              Standard Percentage Formula
            </span>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2 text-xs font-mono">
            <div class="text-slate-600 dark:text-slate-400">Formula: <strong id="txt-disc-breakdown-formula" class="text-slate-900 dark:text-white font-mono">Discount = Price × (Rate ÷ 100)</strong></div>
            <div class="pt-1 border-t border-slate-200/80 dark:border-slate-800 space-y-1">
              <div>Step 1: <span id="txt-disc-breakdown-step1" class="font-bold text-emerald-600 dark:text-emerald-400">$1,000.00 × 0.20 = $200.00 Saved</span></div>
              <div>Step 2: <span id="txt-disc-breakdown-step2" class="font-bold text-slate-900 dark:text-white">$1,000.00 − $200.00 = $800.00 Final Sale Price</span></div>
              <div id="box-disc-breakdown-step3" class="hidden text-blue-600 dark:text-blue-400">Step 3: <span id="txt-disc-breakdown-step3" class="font-bold">+ Tax</span></div>
            </div>
          </div>
        </div>

        <!-- 3. DISCOUNT COMPARISON TABLE & PDF DOWNLOAD -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-2">
            <div>
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>📊</span> Discount Comparison
              </h3>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">
                Compare potential sale prices and savings across standard discount tiers.
              </p>
            </div>

            <!-- Download PDF Button -->
