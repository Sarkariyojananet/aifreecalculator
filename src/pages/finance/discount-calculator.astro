  });

  // Master Calculation Execution
  function executeDiscountCalculation() {
    errDisc.classList.add('hidden');

    const isTaxEnabled = chkApplyTax.checked;
    const taxRate = isTaxEnabled ? Math.max(0, parseFloat(inpTaxRate.value) || 0) : 0;

    let originalPrice = 0;
    let salePrice = 0;
    let discountAmount = 0;
    let discountPercentage = 0;
    let amountSaved = 0;
    let salesTaxAmount = 0;
    let finalPriceWithTax = 0;
    let effectiveDiscountPercent = 0;

    let formulaName = '';
    let formulaText = '';
    let step1Text = '';
    let step2Text = '';
    let step3Text = '';

    if (activeDiscountMode === 'sale_price') {
      originalPrice = parseFloat(inpOrigPrice.value);
      if (isNaN(originalPrice) || originalPrice < 0) {
        errDisc.textContent = 'Please enter a valid original price (0 or greater).';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      if (activeDiscountType === 'percentage') {
        discountPercentage = parseFloat(inpValPct.value);
        if (isNaN(discountPercentage) || discountPercentage < 0 || discountPercentage > 100) {
          errDisc.textContent = 'Discount percentage must be between 0% and 100%.';
          errDisc.classList.remove('hidden');
          discResultsSection.classList.add('hidden');
          return;
        }

        discountAmount = Number(((originalPrice * discountPercentage) / 100).toFixed(2));
        salePrice = Number((originalPrice - discountAmount).toFixed(2));
        amountSaved = discountAmount;

        formulaName = 'Standard Percentage Discount Formula';
        formulaText = 'Discount Amount = Price × (Discount % ÷ 100) | Sale Price = Price − Discount';
        step1Text = `${formatMoney(originalPrice)} × (${discountPercentage}% ÷ 100) = ${formatMoney(discountAmount)} Saved`;
        step2Text = `${formatMoney(originalPrice)} − ${formatMoney(discountAmount)} = ${formatMoney(salePrice)} Final Sale Price`;
      } else {
        const fixedVal = parseFloat(inpValFixed.value);
        if (isNaN(fixedVal) || fixedVal < 0) {
          errDisc.textContent = 'Fixed discount amount must be 0 or greater.';
          errDisc.classList.remove('hidden');
          discResultsSection.classList.add('hidden');
          return;
        }

        discountAmount = Math.min(originalPrice, fixedVal);
        salePrice = Number((originalPrice - discountAmount).toFixed(2));
        amountSaved = discountAmount;
        discountPercentage = originalPrice > 0 ? Number(((discountAmount / originalPrice) * 100).toFixed(2)) : 0;

        formulaName = 'Fixed Amount Discount Formula';
        formulaText = 'Sale Price = Original Price − Fixed Discount Amount';
        step1Text = `Fixed Cash Markdown: ${formatMoney(discountAmount)} (${discountPercentage.toFixed(1)}% equivalent)`;
        step2Text = `${formatMoney(originalPrice)} − ${formatMoney(discountAmount)} = ${formatMoney(salePrice)} Final Sale Price`;
      }

      if (isTaxEnabled && taxRate > 0) {
        salesTaxAmount = Number(((salePrice * taxRate) / 100).toFixed(2));
        finalPriceWithTax = Number((salePrice + salesTaxAmount).toFixed(2));
        step3Text = `Sales Tax (${taxRate}%): ${formatMoney(salePrice)} × ${taxRate}% = ${formatMoney(salesTaxAmount)} | Total with Tax = ${formatMoney(finalPriceWithTax)}`;
      } else {
        finalPriceWithTax = salePrice;
      }

      lblDiscHeroTitle.textContent = 'FINAL SALE PRICE';
      resDiscHeroAmount.textContent = formatMoney(salePrice);
      resDiscHeroSubtitle.textContent = activeDiscountType === 'percentage'
        ? `${discountPercentage}% Discount Applied`
        : `${formatMoney(discountAmount)} Fixed Discount Applied (${discountPercentage.toFixed(1)}%)`;
      lblDiscHeroSecondary.textContent = 'Total Money Saved:';
      resDiscHeroSecondary.textContent = formatMoney(amountSaved);

      lblDiscGrid1.textContent = 'Original Price';
      resDiscGrid1.textContent = formatMoney(originalPrice);
      lblDiscGrid2.textContent = 'Discount';
      resDiscGrid2.textContent = activeDiscountType === 'percentage' ? `${discountPercentage}%` : formatMoney(discountAmount);
      lblDiscGrid3.textContent = isTaxEnabled && taxRate > 0 ? `Sales Tax (${taxRate}%)` : 'Discount Amount';
      resDiscGrid3.textContent = isTaxEnabled && taxRate > 0 ? formatMoney(salesTaxAmount) : formatMoney(discountAmount);
      lblDiscGrid4.textContent = isTaxEnabled && taxRate > 0 ? 'Total with Tax' : 'Sale Price';
      resDiscGrid4.textContent = isTaxEnabled && taxRate > 0 ? formatMoney(finalPriceWithTax) : formatMoney(salePrice);

    } else if (activeDiscountMode === 'discount_pct') {
      originalPrice = parseFloat(inpCalcOrig.value);
      salePrice = parseFloat(inpCalcSale.value);

      if (isNaN(originalPrice) || originalPrice <= 0) {
        errDisc.textContent = 'Original price must be greater than 0.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      if (isNaN(salePrice) || salePrice < 0) {
        errDisc.textContent = 'Sale price must be 0 or greater.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      if (salePrice > originalPrice) {
        errDisc.textContent = 'Sale price cannot exceed the original retail price.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      discountAmount = Number((originalPrice - salePrice).toFixed(2));
      amountSaved = discountAmount;
      discountPercentage = Number(((discountAmount / originalPrice) * 100).toFixed(2));
      finalPriceWithTax = salePrice;

      formulaName = 'Discount Percentage Formula';
      formulaText = 'Discount % = ((Original Price − Sale Price) ÷ Original Price) × 100';
      step1Text = `${formatMoney(originalPrice)} − ${formatMoney(salePrice)} = ${formatMoney(discountAmount)} Money Saved`;
      step2Text = `(${formatMoney(discountAmount)} ÷ ${formatMoney(originalPrice)}) × 100 = ${discountPercentage}% Discount`;

      lblDiscHeroTitle.textContent = 'DISCOUNT PERCENTAGE';
      resDiscHeroAmount.textContent = `${discountPercentage}%`;
      resDiscHeroSubtitle.textContent = `Calculated from ${formatMoney(originalPrice)} down to ${formatMoney(salePrice)}`;
      lblDiscHeroSecondary.textContent = 'Amount Saved:';
      resDiscHeroSecondary.textContent = formatMoney(amountSaved);

      lblDiscGrid1.textContent = 'Original Price';
      resDiscGrid1.textContent = formatMoney(originalPrice);
      lblDiscGrid2.textContent = 'Sale Price';
      resDiscGrid2.textContent = formatMoney(salePrice);
      lblDiscGrid3.textContent = 'Amount Saved';
      resDiscGrid3.textContent = formatMoney(amountSaved);
      lblDiscGrid4.textContent = 'Discount Percentage';
      resDiscGrid4.textContent = `${discountPercentage}%`;

    } else if (activeDiscountMode === 'original_price') {
      salePrice = parseFloat(inpRevSale.value);
      discountPercentage = parseFloat(inpRevPct.value);

      if (isNaN(salePrice) || salePrice <= 0) {
        errDisc.textContent = 'Sale price must be greater than 0.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      if (isNaN(discountPercentage) || discountPercentage < 0 || discountPercentage >= 100) {
        errDisc.textContent = 'Discount percentage must be between 0% and 99.99% for reverse calculation.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      originalPrice = Number((salePrice / (1 - discountPercentage / 100)).toFixed(2));
      discountAmount = Number((originalPrice - salePrice).toFixed(2));
      amountSaved = discountAmount;
      finalPriceWithTax = salePrice;

      formulaName = 'Reverse Original Price Formula';
      formulaText = 'Original Price = Sale Price ÷ (1 − Discount % ÷ 100)';
      step1Text = `${formatMoney(salePrice)} ÷ (1 − ${discountPercentage / 100}) = ${formatMoney(originalPrice)} Original Price`;
      step2Text = `${formatMoney(originalPrice)} − ${formatMoney(salePrice)} = ${formatMoney(discountAmount)} Discount Amount`;

      lblDiscHeroTitle.textContent = 'ESTIMATED ORIGINAL PRICE';
      resDiscHeroAmount.textContent = formatMoney(originalPrice);
      resDiscHeroSubtitle.textContent = `Restored from ${formatMoney(salePrice)} at ${discountPercentage}% Discount`;
      lblDiscHeroSecondary.textContent = 'Discount Amount:';
      resDiscHeroSecondary.textContent = formatMoney(discountAmount);

      lblDiscGrid1.textContent = 'Sale Price';
      resDiscGrid1.textContent = formatMoney(salePrice);
      lblDiscGrid2.textContent = 'Discount Percentage';
      resDiscGrid2.textContent = `${discountPercentage}%`;
      lblDiscGrid3.textContent = 'Discount Amount';
      resDiscGrid3.textContent = formatMoney(discountAmount);
      lblDiscGrid4.textContent = 'Original Price';
      resDiscGrid4.textContent = formatMoney(originalPrice);

    } else {
      // Multiple Sequential Discounts
      originalPrice = parseFloat(inpMultiOrig.value);
      if (isNaN(originalPrice) || originalPrice <= 0) {
        errDisc.textContent = 'Original price must be greater than 0.';
        errDisc.classList.remove('hidden');
        discResultsSection.classList.add('hidden');
        return;
      }

      const d1 = Math.min(100, Math.max(0, parseFloat(inpMultiD1.value) || 0));
      const d2 = Math.min(100, Math.max(0, parseFloat(inpMultiD2.value) || 0));
      const d3 = !rowMultiD3.classList.contains('hidden') ? Math.min(100, Math.max(0, parseFloat(inpMultiD3.value) || 0)) : 0;

      const discounts = [d1, d2];
      if (d3 > 0) discounts.push(d3);

      let curP = originalPrice;
      const stepDescs = [];

      discounts.forEach((pct, idx) => {
        const saved = Number(((curP * pct) / 100).toFixed(2));
        const nextP = Number((curP - saved).toFixed(2));
        stepDescs.push(`D${idx + 1} (${pct}%): ${formatMoney(curP)} → ${formatMoney(nextP)} (-${formatMoney(saved)})`);
        curP = nextP;
      });

      salePrice = curP;
      amountSaved = Number((originalPrice - salePrice).toFixed(2));
      discountAmount = amountSaved;
      effectiveDiscountPercent = Number(((amountSaved / originalPrice) * 100).toFixed(2));
      discountPercentage = effectiveDiscountPercent;
      finalPriceWithTax = salePrice;

      formulaName = 'Sequential Compounding Formula';
      formulaText = 'Price_n = Price_{n-1} × (1 − Discount_n ÷ 100) | Effective % = (Saved ÷ Original) × 100';
      step1Text = stepDescs.join(' | ');
      step2Text = `Total Saved: ${formatMoney(amountSaved)} | Effective Overall Discount: ${effectiveDiscountPercent}%`;

      lblDiscHeroTitle.textContent = 'FINAL SALE PRICE';
      resDiscHeroAmount.textContent = formatMoney(salePrice);
      resDiscHeroSubtitle.textContent = `Effective Total Discount: ${effectiveDiscountPercent}% (${discounts.join('% + ')}%)`;
      lblDiscHeroSecondary.textContent = 'Total Amount Saved:';
      resDiscHeroSecondary.textContent = formatMoney(amountSaved);

      lblDiscGrid1.textContent = 'Original Price';
      resDiscGrid1.textContent = formatMoney(originalPrice);
      lblDiscGrid2.textContent = 'Discounts Stacked';
      resDiscGrid2.textContent = discounts.map(d => `${d}%`).join(' + ');
      lblDiscGrid3.textContent = 'Total Saved';
      resDiscGrid3.textContent = formatMoney(amountSaved);
      lblDiscGrid4.textContent = 'Effective Discount';
      resDiscGrid4.textContent = `${effectiveDiscountPercent}%`;
    }

    // Step-by-Step UI Update
    txtDiscFormulaName.textContent = formulaName;
    txtDiscBreakdownFormula.textContent = formulaText;
    txtDiscBreakdownStep1.textContent = step1Text;
    txtDiscBreakdownStep2.textContent = step2Text;

    if (step3Text) {
      boxDiscBreakdownStep3.classList.remove('hidden');
      txtDiscBreakdownStep3.textContent = step3Text;
    } else {
      boxDiscBreakdownStep3.classList.add('hidden');
    }

    // Discount Comparison Matrix
    const baseForComp = originalPrice > 0 ? originalPrice : 1000;
    const stdPercentages = [10, 20, 25, 30, 40, 50];
    const roundedActivePct = Math.round(discountPercentage);
    if (roundedActivePct > 0 && roundedActivePct < 100 && !stdPercentages.includes(roundedActivePct)) {
      stdPercentages.push(roundedActivePct);
      stdPercentages.sort((a, b) => a - b);
    }

    tblDiscComparison.innerHTML = stdPercentages.map((pct) => {
      const saved = Number(((baseForComp * pct) / 100).toFixed(2));
      const finalP = Number((baseForComp - saved).toFixed(2));
      const isCur = Math.abs(pct - discountPercentage) < 0.01;

      return `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 ${isCur ? 'bg-blue-50/50 dark:bg-blue-950/30 font-bold' : ''}">
          <td class="p-2.5 font-sans font-bold text-slate-900 dark:text-white">
            ${pct}% ${isCur ? '<span class="text-blue-600 dark:text-blue-400 text-[11px]">(Current)</span>' : ''}
          </td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatMoney(saved)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatMoney(finalP)}</td>
        </tr>
      `;
    }).join('');

    // Save State
    lastCalculatedDiscount = {
      mode: activeDiscountMode,
      originalPrice,
      salePrice,
      discountAmount,
      discountPercentage,
      amountSaved,
      isTaxEnabled,
      taxRate,
      salesTaxAmount,
      finalPriceWithTax,
      effectiveDiscountPercent,
      comparisonList: stdPercentages.map((pct) => ({
        pct,
        saved: Number(((baseForComp * pct) / 100).toFixed(2)),
        finalP: Number((baseForComp - ((baseForComp * pct) / 100)).toFixed(2)),
        isCurrent: Math.abs(pct - discountPercentage) < 0.01,
      })),
    };

    discResultsSection.classList.remove('hidden');
  }

  // Clear All Button
  btnClearDisc.addEventListener('click', () => {
    const saleModeBtn = document.querySelector('.btn-disc-mode[data-mode="sale_price"]');
    if (saleModeBtn) saleModeBtn.click();

    inpOrigPrice.value = '1000';
    btnTypePct.click();
    inpValPct.value = '20';
    inpValFixed.value = '200';

    inpCalcOrig.value = '100';
    inpCalcSale.value = '75';

    inpRevSale.value = '800';
    inpRevPct.value = '20';

    inpMultiOrig.value = '1000';
    inpMultiD1.value = '20';
    inpMultiD2.value = '10';
    inpMultiD3.value = '5';
    btnRemoveD3.click();

    chkApplyTax.checked = false;
    inpTaxRate.value = '7.5';

    errDisc.classList.add('hidden');
    discResultsSection.classList.add('hidden');
    lastCalculatedDiscount = null;
  });

  // Calculate Button
  btnCalcDisc.addEventListener('click', executeDiscountCalculation);

  // Enter Key Triggers Calculation
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeDiscountCalculation();
        }
      });
    });
  });

  // Tab-Selective Branded PDF Export
  async function generateDiscountPdf() {
    if (!lastCalculatedDiscount) {
      alert('Please calculate your discount first.');
      return;
    }

    btnDiscDownloadPdf.disabled = true;
    const originalText = txtBtnDiscPdf.textContent;
    txtBtnDiscPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      let docTitle = 'Discount & Sale Price Calculation';
      if (lastCalculatedDiscount.mode === 'discount_pct') {
        docTitle = 'Discount Percentage Calculation';
      } else if (lastCalculatedDiscount.mode === 'original_price') {
        docTitle = 'Original Price Calculation';
      } else if (lastCalculatedDiscount.mode === 'multiple') {
        docTitle = 'Multiple Discount Calculation';
      }

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(docTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 32, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('CALCULATION SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);

      doc.text(`Original Price: $${lastCalculatedDiscount.originalPrice.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 44);
      doc.text(`Discount Rate: ${lastCalculatedDiscount.discountPercentage.toFixed(1)}%`, 18, 49);
      doc.text(`Money Saved: $${lastCalculatedDiscount.amountSaved.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 54);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(16, 185, 129);
      doc.text(`Final Sale Price: $${lastCalculatedDiscount.salePrice.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 100, 44);

      if (lastCalculatedDiscount.isTaxEnabled && lastCalculatedDiscount.taxRate > 0) {
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(71, 85, 105);
        doc.text(`Sales Tax (${lastCalculatedDiscount.taxRate}%): $${lastCalculatedDiscount.salesTaxAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 100, 49);
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(37, 99, 235);
        doc.text(`Total with Tax: $${lastCalculatedDiscount.finalPriceWithTax.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 100, 54);
      }

      // 4. Comparison Table
      const tableHead = [['Discount Percentage', 'Total Amount Saved', 'Final Sale Price']];
      const tableData = lastCalculatedDiscount.comparisonList.map((r) => [
        `${r.pct}% ${r.isCurrent ? '(Selected)' : ''}`,
        `$${r.saved.toLocaleString('en-US', { minimumFractionDigits: 2 })}`,
        `$${r.finalP.toLocaleString('en-US', { minimumFractionDigits: 2 })}`
      ]);

      doc.autoTable({
        startY: 70,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { halign: 'left', fontStyle: 'bold' },
          1: { halign: 'right', fontStyle: 'bold', textColor: [16, 185, 129] },
          2: { halign: 'right', fontStyle: 'bold', textColor: [37, 99, 235] }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2.2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const todayStr = new Date().toISOString().split('T')[0];
      doc.save(`discount-sale-price-calculation-${todayStr}.pdf`);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnDiscDownloadPdf.disabled = false;
      txtBtnDiscPdf.textContent = originalText;
    }
  }

  btnDiscDownloadPdf.addEventListener('click', generateDiscountPdf);
</script>
