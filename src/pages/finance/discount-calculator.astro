<!-- CLIENT-SIDE CALCULATION ENGINE & UI LOGIC -->
<script is:inline>
  // State
  let activeDiscountMode = 'sale_price'; // 'sale_price' | 'discount_pct' | 'original_price' | 'multiple' | 'bogo'
  let activeDiscountType = 'percentage'; // 'percentage' | 'fixed'
  let activeCurrency = '$';
  let lastCalculatedDiscount = null;

  // Mode Containers
  const secModeSalePrice = document.getElementById('sec-disc-mode-saleprice');
  const secModePct = document.getElementById('sec-disc-mode-pct');
  const secModeOrig = document.getElementById('sec-disc-mode-orig');
  const secModeMulti = document.getElementById('sec-disc-mode-multi');
  const secModeBogo = document.getElementById('sec-disc-mode-bogo');

  const txtDiscTitleIcon = document.getElementById('txt-disc-title-icon');
  const txtDiscTitle = document.getElementById('txt-disc-title');
  const txtDiscSubtitle = document.getElementById('txt-disc-subtitle');
  const selCurrency = document.getElementById('sel-disc-currency');

  // Input Elements - Mode 1: Sale Price
  const inpOrigPrice = document.getElementById('inp-disc-orig-price');
  const btnTypePct = document.getElementById('btn-type-pct');
  const btnTypeFixed = document.getElementById('btn-type-fixed');
  const boxPctInput = document.getElementById('box-disc-pct-input');
  const boxFixedInput = document.getElementById('box-disc-fixed-input');
