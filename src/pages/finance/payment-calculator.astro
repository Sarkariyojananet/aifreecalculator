---

<CalculatorLayout
  title="Payment Calculator: Loan, Mortgage & Car Payment Estimator"
  description="Calculate monthly payments for car loans, mortgages, and personal debt. Compare fixed loan terms or fixed monthly payments with complete amortization schedules."
  category="Finance"
  calculatorName="Payment Calculator"
  slug="payment-calculator"
  lang={lang}
  keywords={[
    'payment calculator',
    'car payment calculator',
    'mortgage payment calculator',
    'loan payment calculator',
    'car loan payment calculator',
    'monthly payment calculator',
    'fixed term loan calculator',
    'loan payoff calculator',
    'apr payment calculator'
  ]}
>
  <div class="space-y-6">

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> {t.quickPresets}
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="term" data-amt="35000" data-rate="6.5" data-years="5" data-months="0">{t.carLoanPreset}</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="term" data-amt="400000" data-rate="6.8" data-years="30" data-months="0">{t.mortgage30Preset}</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="term" data-amt="400000" data-rate="6.1" data-years="15" data-months="0">{t.mortgage15Preset}</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="payment" data-amt="8000" data-rate="21.9" data-pay="250">{t.creditCardPreset}</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="term" data-amt="15000" data-rate="9.5" data-years="3" data-months="0">{t.personalLoanPreset}</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>💳</span> {t.cardTitle}
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              {t.cardSubtitle}
            </p>
          </div>

          <!-- CURRENCY SELECTOR -->
          <div class="flex items-center gap-2 self-start sm:self-auto">
            <label for="sel-currency" class="text-xs font-bold text-slate-600 dark:text-slate-400">{t.currency}</label>
            <select id="sel-currency" class="rounded-xl border border-slate-300 bg-white px-2.5 py-1 text-xs font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
              <option value="$" selected>USD ($)</option>
              <option value="₹">INR (₹)</option>
              <option value="€">EUR (€)</option>
              <option value="£">GBP (£)</option>
            </select>
          </div>
        </div>

        <!-- MODE SELECTION TABS -->
        <div class="mt-4 inline-flex w-full rounded-2xl border border-slate-200 bg-slate-100 p-1 dark:border-slate-800 dark:bg-slate-900/80 text-xs font-bold sm:w-auto">
          <button type="button" id="tab-mode-term" class="mode-tab-btn active flex-1 sm:flex-none rounded-xl bg-blue-600 px-4 py-2 text-white shadow-xs transition cursor-pointer" data-mode="term">
            {t.tabFixedTerm}
          </button>
          <button type="button" id="tab-mode-payment" class="mode-tab-btn flex-1 sm:flex-none rounded-xl px-4 py-2 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition cursor-pointer" data-mode="payment">
            {t.tabFixedPayment}
          </button>
        </div>
      </div>

      <form id="form-payment" class="mt-5 space-y-4" novalidate onsubmit="return false;" data-i18n={JSON.stringify(t)}>
        
        <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            
            <!-- Loan Principal Amount -->
            <div>
              <label for="inp-loan-amount" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                {t.loanAmount} (<span class="currency-label">$</span>)
              </label>
              <input type="number" id="inp-loan-amount" value="35000" step="500" min="100" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="35,000" />
            </div>

            <!-- Interest Rate / APR -->
            <div>
              <div class="flex items-center justify-between">
                <label for="inp-loan-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  {t.interestRate}
                </label>
                <span class="text-[11px] text-slate-500 dark:text-slate-400">{t.annualRate}</span>
              </div>
              <input type="number" id="inp-loan-rate" value="6.5" step="0.05" min="0" max="99" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="6.5" />
            </div>

            <!-- Dynamic Third Field: Term (when Fixed Term) OR Monthly Payment (when Fixed Payment) -->
            <div id="container-field-term">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                {t.loanTerm}
              </label>
              <div class="mt-1.5 grid grid-cols-2 gap-2">
                <div>
                  <div class="relative">
                    <label for="inp-term-years" class="sr-only">{t.loanTerm} ({t.years})</label>
                    <input type="number" id="inp-term-years" value="5" step="1" min="0" max="50" class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-12 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="5" />
                    <span class="absolute right-3 top-2.5 text-xs font-semibold text-slate-400">{t.years}</span>
                  </div>
                </div>
                <div>
                  <div class="relative">
                    <label for="inp-term-months" class="sr-only">{t.loanTerm} ({t.months})</label>
                    <input type="number" id="inp-term-months" value="0" step="1" min="0" max="11" class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-12 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
                    <span class="absolute right-3 top-2.5 text-xs font-semibold text-slate-400">{t.months}</span>
                  </div>
                </div>
              </div>
            </div>

            <div id="container-field-payment" class="hidden">
              <label for="inp-monthly-payment" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                {t.monthlyPaymentAmount} (<span class="currency-label">$</span>)
              </label>
              <input type="number" id="inp-monthly-payment" value="250" step="10" min="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="250" />
            </div>

          </div>

          <!-- Term Presets Quick Chips (visible in Fixed Term mode) -->
          <div id="chips-term" class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
            <span class="text-slate-500 dark:text-slate-400 font-semibold text-[11px]">{t.popularTerms}</span>
            <button type="button" class="btn-term-chip rounded-lg bg-slate-100 px-2 py-0.5 font-bold text-slate-700 hover:bg-blue-100 hover:text-blue-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-years="3" data-months="0">{t.term3yr}</button>
            <button type="button" class="btn-term-chip rounded-lg bg-slate-100 px-2 py-0.5 font-bold text-slate-700 hover:bg-blue-100 hover:text-blue-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-years="4" data-months="0">{t.term4yr}</button>
            <button type="button" class="btn-term-chip rounded-lg bg-blue-50 px-2 py-0.5 font-bold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer" data-years="5" data-months="0">{t.term5yr}</button>
            <button type="button" class="btn-term-chip rounded-lg bg-slate-100 px-2 py-0.5 font-bold text-slate-700 hover:bg-blue-100 hover:text-blue-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-years="6" data-months="0">{t.term6yr}</button>
            <button type="button" class="btn-term-chip rounded-lg bg-slate-100 px-2 py-0.5 font-bold text-slate-700 hover:bg-blue-100 hover:text-blue-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-years="15" data-months="0">{t.term15yr}</button>
            <button type="button" class="btn-term-chip rounded-lg bg-slate-100 px-2 py-0.5 font-bold text-slate-700 hover:bg-blue-100 hover:text-blue-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-years="30" data-months="0">{t.term30yr}</button>
          </div>
        </div>

        <!-- WARNING ALERT FOR NEGATIVE AMORTIZATION -->
        <div id="alert-insufficient-payment" class="hidden rounded-2xl border border-amber-300 bg-amber-50 p-4 dark:border-amber-800 dark:bg-amber-950/40 text-amber-900 dark:text-amber-200 space-y-1">
          <div class="flex items-center gap-2 font-black text-sm">
            <span>⚠️</span> {t.negAmortTitle}
          </div>
          <p class="text-xs leading-relaxed" id="txt-alert-message">
            {t.negAmortDesc}
          </p>
        </div>

        <!-- STANDARDIZED RESULTS SECTION CONTAINER -->
        <div id="results-section" class="space-y-4">

          <!-- PRIMARY RESULT CARDS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            
            <!-- Card 1: Primary Output (Monthly Payment OR Payoff Time) -->
            <div class="rounded-2xl border border-blue-200 bg-blue-50/70 p-4 dark:border-blue-900/60 dark:bg-blue-950/30">
              <div id="lbl-result-primary" class="text-xs font-semibold text-blue-700 dark:text-blue-300 uppercase tracking-wider">{t.lblMonthlyPayment}</div>
              <div id="res-payment-primary" class="mt-1 text-2xl font-black text-blue-900 dark:text-blue-100">$684.86</div>
              <div id="sub-result-primary" class="mt-0.5 text-[11px] text-blue-600 dark:text-blue-400">{t.subMonthlyPayment}</div>
            </div>

            <!-- Card 2: Total Interest -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
              <div id="lbl-result-interest" class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">{t.lblTotalInterest}</div>
              <div id="res-total-interest" class="mt-1 text-2xl font-black text-red-600 dark:text-red-400">$6,091.60</div>
              <div id="sub-result-interest" class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">14.8% {t.ofTotalPayment}</div>
            </div>

            <!-- Card 3: Total Repayment Amount -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
              <div id="lbl-result-total" class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">{t.lblTotalPayment}</div>
              <div id="res-total-payment" class="mt-1 text-2xl font-black text-slate-900 dark:text-white">$41,091.60</div>
              <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">{t.subTotalPayment}</div>
            </div>

            <!-- Card 4: Estimated Payoff Date -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
              <div id="lbl-result-date" class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">{t.lblPayoffDate}</div>
              <div id="res-payoff-date" class="mt-1 text-2xl font-black text-emerald-600 dark:text-emerald-400">Nov 2031</div>
              <div id="sub-result-date" class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">60 {t.subPayoffDate}</div>
            </div>

          </div>

          <!-- PRINCIPAL VS INTEREST BREAKDOWN BAR -->
          <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>📊</span> {t.proportionTitle}
              </h3>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">
                {t.proportionSub}
              </span>
            </div>

            <div class="space-y-2">
              <div class="h-4 w-full overflow-hidden rounded-full bg-slate-100 flex dark:bg-slate-800" role="progressbar" aria-label="Principal vs Interest Ratio">
                <div id="bar-principal" class="bg-blue-600 transition-all duration-300" style="width: 85.2%;" title="Principal Borrowed"></div>
                <div id="bar-interest" class="bg-red-500 transition-all duration-300" style="width: 14.8%;" title="Interest Cost"></div>
              </div>
              <div class="flex flex-wrap items-center justify-between text-xs font-semibold text-slate-600 dark:text-slate-400">
                <span class="flex items-center gap-1.5">
                  <span class="inline-block h-3 w-3 rounded-full bg-blue-600"></span>
