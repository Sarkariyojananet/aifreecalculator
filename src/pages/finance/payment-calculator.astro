    const containerFieldPayment = document.getElementById('container-field-payment');
    const chipsTerm = document.getElementById('chips-term');
    const alertBox = document.getElementById('alert-insufficient-payment');
    const alertMsg = document.getElementById('txt-alert-message');

    // Inputs
    const inpLoanAmount = document.getElementById('inp-loan-amount');
    const inpLoanRate = document.getElementById('inp-loan-rate');
    const inpTermYears = document.getElementById('inp-term-years');
    const inpTermMonths = document.getElementById('inp-term-months');
    const inpMonthlyPayment = document.getElementById('inp-monthly-payment');

    // Result DOMs
    const lblResultPrimary = document.getElementById('lbl-result-primary');
    const valResultPrimary = document.getElementById('res-payment-primary');
    const subResultPrimary = document.getElementById('sub-result-primary');
    const valResultInterest = document.getElementById('res-total-interest');
    const subResultInterest = document.getElementById('sub-result-interest');
    const valResultTotal = document.getElementById('res-total-payment');
    const valResultDate = document.getElementById('res-payoff-date');
    const subResultDate = document.getElementById('sub-result-date');

    // Bar chart DOMs
    const barPrincipal = document.getElementById('bar-principal');
    const barInterest = document.getElementById('bar-interest');
    const lblBarPrincipal = document.getElementById('lbl-bar-principal');
    const lblBarInterest = document.getElementById('lbl-bar-interest');

    // Schedule DOMs
    const tabSchedYearly = document.getElementById('tab-sched-yearly');
    const tabSchedMonthly = document.getElementById('tab-sched-monthly');
    const thPeriod = document.getElementById('th-period');
    const tblBody = document.getElementById('tbl-amortization-body');
    const btnExportCsv = document.getElementById('btn-export-csv');

    function formatMoney(amount) {
      if (typeof amount !== 'number' || isNaN(amount) || !isFinite(amount)) return currentCurrency + '0.00';
      return currentCurrency + amount.toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function updateCurrencySymbols() {
      if (selCurrency && 'value' in selCurrency) {
        currentCurrency = selCurrency.value;
      }
      currencyLabels.forEach(el => {
        el.textContent = currentCurrency;
      });
      calculate();
    }

    function setMode(mode) {
      currentMode = mode;
      if (mode === 'term') {
        if (tabModeTerm) {
          tabModeTerm.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
          tabModeTerm.classList.remove('text-slate-600', 'dark:text-slate-400');
        }
        if (tabModePayment) {
          tabModePayment.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
          tabModePayment.classList.add('text-slate-600', 'dark:text-slate-400');
        }
        
        if (containerFieldTerm) containerFieldTerm.classList.remove('hidden');
        if (chipsTerm) chipsTerm.classList.remove('hidden');
        if (containerFieldPayment) containerFieldPayment.classList.add('hidden');
        if (lblResultPrimary) lblResultPrimary.textContent = i18n.lblMonthlyPayment || 'Monthly Payment';
        if (subResultPrimary) subResultPrimary.textContent = i18n.subMonthlyPayment || 'Regular monthly payment due';
      } else {
        if (tabModePayment) {
          tabModePayment.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
          tabModePayment.classList.remove('text-slate-600', 'dark:text-slate-400');
        }
        if (tabModeTerm) {
          tabModeTerm.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
          tabModeTerm.classList.add('text-slate-600', 'dark:text-slate-400');
        }

        if (containerFieldTerm) containerFieldTerm.classList.add('hidden');
        if (chipsTerm) chipsTerm.classList.add('hidden');
        if (containerFieldPayment) containerFieldPayment.classList.remove('hidden');
        if (lblResultPrimary) lblResultPrimary.textContent = i18n.lblPayoffTime || 'Time to Debt Free';
        if (subResultPrimary) subResultPrimary.textContent = i18n.subPayoffTime || 'Estimated payoff duration';
      }
      calculate();
    }

    function calculate() {
      const principal = Math.max(0, parseFloat(inpLoanAmount ? inpLoanAmount.value : '0') || 0);
      const annualRate = Math.max(0, parseFloat(inpLoanRate ? inpLoanRate.value : '0') || 0);
      const monthlyRate = annualRate / 100 / 12;

      if (alertBox) alertBox.classList.add('hidden');
      latestSchedule = [];

      if (principal <= 0) {
        if (valResultPrimary) valResultPrimary.textContent = formatMoney(0);
        if (valResultInterest) valResultInterest.textContent = formatMoney(0);
        if (valResultTotal) valResultTotal.textContent = formatMoney(0);
        if (valResultDate) valResultDate.textContent = 'N/A';
        if (subResultDate) subResultDate.textContent = '0 ' + (i18n.subPayoffDate || 'total monthly payments');
        renderSchedule([]);
        return;
      }

      if (currentMode === 'term') {
        const years = parseInt(inpTermYears ? inpTermYears.value : '0', 10) || 0;
        const months = parseInt(inpTermMonths ? inpTermMonths.value : '0', 10) || 0;
        const totalMonths = (years * 12) + months;

        if (totalMonths <= 0) {
          if (valResultPrimary) valResultPrimary.textContent = formatMoney(0);
          if (valResultInterest) valResultInterest.textContent = formatMoney(0);
          if (valResultTotal) valResultTotal.textContent = formatMoney(0);
          renderSchedule([]);
          return;
        }

        let monthlyPayment = 0;
        if (monthlyRate === 0) {
          monthlyPayment = principal / totalMonths;
        } else {
          monthlyPayment = principal * (monthlyRate * Math.pow(1 + monthlyRate, totalMonths)) / (Math.pow(1 + monthlyRate, totalMonths) - 1);
        }

        const totalPaid = monthlyPayment * totalMonths;
        const totalInterest = Math.max(0, totalPaid - principal);

        if (valResultPrimary) valResultPrimary.textContent = formatMoney(monthlyPayment);
        if (valResultInterest) valResultInterest.textContent = formatMoney(totalInterest);
        if (valResultTotal) valResultTotal.textContent = formatMoney(totalPaid);

        const intPct = totalPaid > 0 ? ((totalInterest / totalPaid) * 100).toFixed(1) : '0';
        const princPct = totalPaid > 0 ? (100 - parseFloat(intPct)).toFixed(1) : '100';
        if (subResultInterest) subResultInterest.textContent = intPct + '% ' + (i18n.ofTotalPayment || 'of total payment');

        if (barPrincipal) barPrincipal.style.width = princPct + '%';
        if (barInterest) barInterest.style.width = intPct + '%';
        if (lblBarPrincipal) lblBarPrincipal.textContent = (i18n.principal || 'Principal') + ': ' + formatMoney(principal) + ' (' + princPct + '%)';
        if (lblBarInterest) lblBarInterest.textContent = (i18n.interest || 'Interest') + ': ' + formatMoney(totalInterest) + ' (' + intPct + '%)';

        // Payoff date
        const now = new Date();
        const payoffDate = new Date(now.getFullYear(), now.getMonth() + totalMonths, 1);
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        if (valResultDate) valResultDate.textContent = monthNames[payoffDate.getMonth()] + ' ' + payoffDate.getFullYear();
        if (subResultDate) subResultDate.textContent = totalMonths + ' ' + (i18n.subPayoffDate || 'total monthly payments');

        // Build amortization schedule
        let balance = principal;
        let cumulativeInterest = 0;

        for (let m = 1; m <= totalMonths; m++) {
          const interestPortion = balance * monthlyRate;
          let principalPortion = monthlyPayment - interestPortion;
          if (m === totalMonths || principalPortion > balance) {
            principalPortion = balance;
          }
          cumulativeInterest += interestPortion;
          balance = Math.max(0, balance - principalPortion);

          latestSchedule.push({
            month: m,
            payment: principalPortion + interestPortion,
            principal: principalPortion,
            interest: interestPortion,
            totalInterest: cumulativeInterest,
            balance: balance
          });

          if (balance <= 0) break;
        }

        renderSchedule(latestSchedule);

      } else {
        // Fixed monthly payment mode
        const monthlyPayment = parseFloat(inpMonthlyPayment ? inpMonthlyPayment.value : '0') || 0;
        const initialMonthlyInterest = principal * monthlyRate;

        if (monthlyRate > 0 && monthlyPayment <= initialMonthlyInterest) {
          if (alertBox) alertBox.classList.remove('hidden');
          if (alertMsg) alertMsg.textContent = i18n.negAmortDesc || 'Your monthly payment is not enough to cover the initial interest charge of this loan. The loan balance will grow over time instead of decreasing. Increase your monthly payment or reduce the loan amount.';
          if (valResultPrimary) valResultPrimary.textContent = 'Never (Negative Amortization)';
          if (valResultInterest) valResultInterest.textContent = 'Infinite';
          if (valResultTotal) valResultTotal.textContent = 'Infinite';
          if (valResultDate) valResultDate.textContent = 'N/A';
          if (subResultDate) subResultDate.textContent = 'Balance grows indefinitely';
          renderSchedule([]);
          return;
        }

        let totalMonths = 0;
        if (monthlyRate === 0) {
          totalMonths = Math.ceil(principal / monthlyPayment);
        } else {
          totalMonths = Math.ceil(-Math.log(1 - (principal * monthlyRate) / monthlyPayment) / Math.log(1 + monthlyRate));
        }

        if (totalMonths > 600) { // Capped at 50 years
          totalMonths = 600;
        }

        const yearsNeeded = Math.floor(totalMonths / 12);
        const monthsRemainder = totalMonths % 12;
        let timeStr = '';
        if (yearsNeeded > 0) {
          timeStr += yearsNeeded + ' ' + (i18n.years || 'Yrs') + ' ';
        }
        if (monthsRemainder > 0 || yearsNeeded === 0) {
          timeStr += monthsRemainder + ' ' + (i18n.months || 'Mos');
        }

        if (valResultPrimary) valResultPrimary.textContent = timeStr.trim();
        if (subResultPrimary) subResultPrimary.textContent = totalMonths + ' ' + (i18n.subPayoffDate || 'total monthly payments');

        // Build schedule
        let balance = principal;
        let cumulativeInterest = 0;
        let totalPaid = 0;

        for (let m = 1; m <= totalMonths + 12; m++) {
          const interestPortion = balance * monthlyRate;
          let principalPortion = monthlyPayment - interestPortion;
          if (principalPortion > balance) {
            principalPortion = balance;
          }
          const actualPayment = principalPortion + interestPortion;
          cumulativeInterest += interestPortion;
          balance = Math.max(0, balance - principalPortion);
          totalPaid += actualPayment;

          latestSchedule.push({
            month: m,
            payment: actualPayment,
            principal: principalPortion,
            interest: interestPortion,
            totalInterest: cumulativeInterest,
            balance: balance
          });

          if (balance <= 0.001) break;
        }

        if (valResultInterest) valResultInterest.textContent = formatMoney(cumulativeInterest);
        if (valResultTotal) valResultTotal.textContent = formatMoney(totalPaid);

        const intPct = totalPaid > 0 ? ((cumulativeInterest / totalPaid) * 100).toFixed(1) : '0';
        const princPct = totalPaid > 0 ? (100 - parseFloat(intPct)).toFixed(1) : '100';
        if (subResultInterest) subResultInterest.textContent = intPct + '% ' + (i18n.ofTotalPayment || 'of total payment');

        if (barPrincipal) barPrincipal.style.width = princPct + '%';
        if (barInterest) barInterest.style.width = intPct + '%';
        if (lblBarPrincipal) lblBarPrincipal.textContent = (i18n.principal || 'Principal') + ': ' + formatMoney(principal) + ' (' + princPct + '%)';
        if (lblBarInterest) lblBarInterest.textContent = (i18n.interest || 'Interest') + ': ' + formatMoney(cumulativeInterest) + ' (' + intPct + '%)';

        const now = new Date();
        const payoffDate = new Date(now.getFullYear(), now.getMonth() + latestSchedule.length, 1);
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        if (valResultDate) valResultDate.textContent = monthNames[payoffDate.getMonth()] + ' ' + payoffDate.getFullYear();
        if (subResultDate) subResultDate.textContent = latestSchedule.length + ' ' + (i18n.subPayoffDate || 'monthly payments');

        renderSchedule(latestSchedule);
      }
    }

    function renderSchedule(schedule) {
      if (!tblBody) return;
      tblBody.innerHTML = '';
      if (!schedule || schedule.length === 0) {
        const row = document.createElement('tr');
        row.innerHTML = '<td colspan="6" class="p-4 text-center text-slate-400">No amortization data available. Enter valid loan inputs above.</td>';
        tblBody.appendChild(row);
        return;
      }

      if (scheduleView === 'monthly') {
        if (thPeriod) thPeriod.textContent = i18n.thPeriodMonth || 'Month';
        schedule.forEach(item => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-800/50';
          tr.innerHTML = `
            <td class="p-3 font-bold text-slate-900 dark:text-white">${escapeText(i18n.thPeriodMonth || 'Mo')} ${item.month}</td>
            <td class="p-3 font-semibold text-slate-800 dark:text-slate-200">${formatMoney(item.payment)}</td>
            <td class="p-3 text-blue-600 dark:text-blue-400 font-semibold">${formatMoney(item.principal)}</td>
            <td class="p-3 text-red-600 dark:text-red-400">${formatMoney(item.interest)}</td>
            <td class="p-3 text-slate-500">${formatMoney(item.totalInterest)}</td>
            <td class="p-3 font-bold text-slate-900 dark:text-white">${formatMoney(item.balance)}</td>
          `;
          tblBody.appendChild(tr);
        });
      } else {
        // Yearly summary
        if (thPeriod) thPeriod.textContent = i18n.thPeriodYear || 'Year';
        const yearlyData = [];
        let curYear = 1;
        let sumPayment = 0;
        let sumPrincipal = 0;
        let sumInterest = 0;
        let lastEndBal = 0;
        let lastCumInt = 0;

        schedule.forEach((item, idx) => {
          sumPayment += item.payment;
          sumPrincipal += item.principal;
          sumInterest += item.interest;
          lastEndBal = item.balance;
          lastCumInt = item.totalInterest;

          if (item.month % 12 === 0 || idx === schedule.length - 1) {
            yearlyData.push({
              year: curYear,
              payment: sumPayment,
              principal: sumPrincipal,
              interest: sumInterest,
              totalInterest: lastCumInt,
              balance: lastEndBal
            });
            curYear++;
            sumPayment = 0;
            sumPrincipal = 0;
            sumInterest = 0;
          }
        });

        yearlyData.forEach(item => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-800/50';
          tr.innerHTML = `
            <td class="p-3 font-bold text-slate-900 dark:text-white">${escapeText(i18n.thPeriodYear || 'Year')} ${item.year}</td>
            <td class="p-3 font-semibold text-slate-800 dark:text-slate-200">${formatMoney(item.payment)}</td>
            <td class="p-3 text-blue-600 dark:text-blue-400 font-semibold">${formatMoney(item.principal)}</td>
            <td class="p-3 text-red-600 dark:text-red-400">${formatMoney(item.interest)}</td>
            <td class="p-3 text-slate-500">${formatMoney(item.totalInterest)}</td>
            <td class="p-3 font-bold text-slate-900 dark:text-white">${formatMoney(item.balance)}</td>
          `;
          tblBody.appendChild(tr);
        });
      }
    }

    function escapeText(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
      });
    }

    function exportCsv() {
      if (!latestSchedule || latestSchedule.length === 0) {
        alert('No amortization schedule to export.');
        return;
      }

      let csv = 'Month,Payment,Principal,Interest,Cumulative Interest,Ending Balance\n';
      latestSchedule.forEach(item => {
        csv += `${item.month},${item.payment.toFixed(2)},${item.principal.toFixed(2)},${item.interest.toFixed(2)},${item.totalInterest.toFixed(2)},${item.balance.toFixed(2)}\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', 'loan-payment-amortization-schedule.csv');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Event Listeners
    if (selCurrency) selCurrency.addEventListener('change', updateCurrencySymbols);

    if (tabModeTerm) tabModeTerm.addEventListener('click', () => setMode('term'));
    if (tabModePayment) tabModePayment.addEventListener('click', () => setMode('payment'));

    [inpLoanAmount, inpLoanRate, inpTermYears, inpTermMonths, inpMonthlyPayment].forEach(input => {
      if (input) input.addEventListener('input', calculate);
    });

    // Preset buttons
    document.querySelectorAll('.btn-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode') || 'term';
        setMode(mode);
        if (inpLoanAmount) inpLoanAmount.value = btn.getAttribute('data-amt') || '35000';
        if (inpLoanRate) inpLoanRate.value = btn.getAttribute('data-rate') || '6.5';
        if (mode === 'term') {
          if (inpTermYears) inpTermYears.value = btn.getAttribute('data-years') || '5';
          if (inpTermMonths) inpTermMonths.value = btn.getAttribute('data-months') || '0';
        } else {
          if (inpMonthlyPayment) inpMonthlyPayment.value = btn.getAttribute('data-pay') || '250';
        }
        calculate();
      });
    });

    // Term Chip buttons
    document.querySelectorAll('.btn-term-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        if (inpTermYears) inpTermYears.value = chip.getAttribute('data-years') || '5';
        if (inpTermMonths) inpTermMonths.value = chip.getAttribute('data-months') || '0';
        calculate();
      });
    });

    // Schedule View Tabs
    if (tabSchedYearly) {
      tabSchedYearly.addEventListener('click', () => {
        scheduleView = 'yearly';
        tabSchedYearly.className = 'rounded-lg bg-white px-3 py-1 text-slate-900 shadow-2xs dark:bg-slate-900 dark:text-white cursor-pointer';
        if (tabSchedMonthly) tabSchedMonthly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
        renderSchedule(latestSchedule);
      });
    }

    if (tabSchedMonthly) {
      tabSchedMonthly.addEventListener('click', () => {
        scheduleView = 'monthly';
        tabSchedMonthly.className = 'rounded-lg bg-white px-3 py-1 text-slate-900 shadow-2xs dark:bg-slate-900 dark:text-white cursor-pointer';
        if (tabSchedYearly) tabSchedYearly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
        renderSchedule(latestSchedule);
      });
    }

    if (btnExportCsv) btnExportCsv.addEventListener('click', exportCsv);

    // Initial calculation on load
    calculate();
  })();
</script>
