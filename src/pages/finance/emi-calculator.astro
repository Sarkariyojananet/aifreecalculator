<script is:inline>
  // State
  let currentLoanType = 'general';
  let tenureType = 'years'; // 'years' or 'months'
  let activeScheduleView = 'yearly'; // 'yearly' or 'monthly'
  let lastCalculatedSchedules = { monthly: [], yearly: [] };

  // DOM Elements
  const loanTabs = document.querySelectorAll('.btn-loan-tab');
