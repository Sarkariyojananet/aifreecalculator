  const panelPrepay = document.getElementById('panel-prepay');
  const panelCompare = document.getElementById('panel-compare');

  const emiPanelTitle = document.getElementById('emi-panel-title');
  const emiPanelDesc = document.getElementById('emi-panel-desc');
  const rowPriceDown = document.getElementById('row-price-down');
  const lblAssetPrice = document.getElementById('lbl-asset-price');
  const inpAssetPrice = document.getElementById('inp-asset-price');
  const inpDownPayment = document.getElementById('inp-down-payment');
  const rowFee = document.getElementById('row-fee');

  const inpLoanAmount = document.getElementById('inp-loan-amount');
  const inpInterestRate = document.getElementById('inp-interest-rate');
  const inpLoanTenure = document.getElementById('inp-loan-tenure');
  const inpProcFee = document.getElementById('inp-proc-fee');
  const btnTenureYr = document.getElementById('btn-tenure-yr');
  const btnTenureMo = document.getElementById('btn-tenure-mo');

  const btnMainCalc = document.getElementById('btn-main-calc');
  const btnMainClear = document.getElementById('btn-main-clear');
  const errMain = document.getElementById('err-main');

  // Prepayment Form Elements
  const prePrincipal = document.getElementById('pre-principal');
  const preRate = document.getElementById('pre-rate');
  const preTenureMo = document.getElementById('pre-tenure-mo');
  const preAmount = document.getElementById('pre-amount');
  const btnPrepayCalc = document.getElementById('btn-prepay-calc');
  const btnPrepayClear = document.getElementById('btn-prepay-clear');
  const errPrepay = document.getElementById('err-prepay');
  const resPrepayCard = document.getElementById('res-prepay-card');
  const txtPrepaySaved = document.getElementById('txt-prepay-saved');
  const txtPrepayReduced = document.getElementById('txt-prepay-reduced');
  const txtPrepayNewtenure = document.getElementById('txt-prepay-newtenure');

  // Compare Form Elements
  const cmpAp = document.getElementById('cmp-a-p'), cmpAr = document.getElementById('cmp-a-r'), cmpAt = document.getElementById('cmp-a-t');
  const cmpBp = document.getElementById('cmp-b-p'), cmpBr = document.getElementById('cmp-b-r'), cmpBt = document.getElementById('cmp-b-t');
  const cmpCp = document.getElementById('cmp-c-p'), cmpCr = document.getElementById('cmp-c-r'), cmpCt = document.getElementById('cmp-c-t');
  const btnCompareCalc = document.getElementById('btn-compare-calc');
  const btnCompareClear = document.getElementById('btn-compare-clear');
  const resCompareCard = document.getElementById('res-compare-card');
  const compareTbody = document.getElementById('compare-tbody');

  // Result Elements
  const emiResultsSection = document.getElementById('emi-results-section');
  const resMonthlyEmi = document.getElementById('res-monthly-emi');
  const resTotalPayment = document.getElementById('res-total-payment');
  const resPrincipalAmt = document.getElementById('res-principal-amt');
  const resTotalInterest = document.getElementById('res-total-interest');
  const resTenureSummary = document.getElementById('res-tenure-summary');
  const resSplitPct = document.getElementById('res-split-pct');
  const resVisualBreakdown = document.getElementById('res-visual-breakdown');
  const svgDonutInterest = document.getElementById('svg-donut-interest');
  const txtLegendPrinc = document.getElementById('txt-legend-princ');
  const txtLegendInt = document.getElementById('txt-legend-int');
  const resAmortizationCard = document.getElementById('res-amortization-card');
  const btnViewYearly = document.getElementById('btn-view-yearly');
  const btnViewMonthly = document.getElementById('btn-view-monthly');
  const thScheduleTime = document.getElementById('th-schedule-time');
  const scheduleTbody = document.getElementById('schedule-tbody');

  // Number Formatting Helper
  function formatINR(val) {
    return `₹ ${Math.round(val).toLocaleString('en-IN')}`;
  }

  // Auto-update loan amount from price and down payment
  function updateLoanFromPrice() {
    if (currentLoanType === 'home' || currentLoanType === 'car' || currentLoanType === 'bike') {
      const price = parseFloat(inpAssetPrice.value) || 0;
      const down = parseFloat(inpDownPayment.value) || 0;
      if (price >= down) {
        inpLoanAmount.value = price - down;
      }
    }
  }

  inpAssetPrice.addEventListener('input', updateLoanFromPrice);
  inpDownPayment.addEventListener('input', updateLoanFromPrice);

  // Switch Loan Types
  function switchLoanType(type) {
    currentLoanType = type;
    loanTabs.forEach((b) => {
      if (b.getAttribute('data-type') === type) {
        b.className = 'btn-loan-tab active shrink-0 rounded-lg bg-blue-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        b.className = 'btn-loan-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    panelStandard.classList.add('hidden');
    panelPrepay.classList.add('hidden');
    panelCompare.classList.add('hidden');

    if (type === 'prepay') {
      panelPrepay.classList.remove('hidden');
      return;
    }

    if (type === 'compare') {
      panelCompare.classList.remove('hidden');
      return;
    }

    panelStandard.classList.remove('hidden');

    // Configure standard panel based on loan type
    rowPriceDown.classList.add('hidden');
    rowFee.classList.add('hidden');

    if (type === 'general') {
      emiPanelTitle.innerHTML = '<span>💳</span> General Loan EMI Calculator';
      emiPanelDesc.textContent = 'Enter your loan principal, annual interest rate, and repayment tenure to compute your monthly installment.';
    } else if (type === 'home') {
      emiPanelTitle.innerHTML = '<span>🏠</span> Home Loan EMI Calculator';
      emiPanelDesc.textContent = 'Compute your home mortgage monthly installment with property cost and down payment options.';
      lblAssetPrice.textContent = 'Property Purchase Cost (₹)';
      rowPriceDown.classList.remove('hidden');
    } else if (type === 'car') {
      emiPanelTitle.innerHTML = '<span>🚗</span> Car Loan EMI Calculator';
      emiPanelDesc.textContent = 'Calculate your four-wheeler loan installment based on on-road price and down payment.';
      lblAssetPrice.textContent = 'Car On-Road Price (₹)';
      rowPriceDown.classList.remove('hidden');
      rowFee.classList.remove('hidden');
    } else if (type === 'personal') {
      emiPanelTitle.innerHTML = '<span>💼</span> Personal Loan EMI Calculator';
      emiPanelDesc.textContent = 'Calculate personal loan installments for multipurpose financing with optional processing fees.';
      rowFee.classList.remove('hidden');
    } else if (type === 'bike') {
      emiPanelTitle.innerHTML = '<span>🏍️</span> Bike Loan EMI Calculator';
      emiPanelDesc.textContent = 'Calculate your two-wheeler monthly installment based on bike price and down payment.';
      lblAssetPrice.textContent = 'Two-Wheeler On-Road Price (₹)';
      rowPriceDown.classList.remove('hidden');
    }
  }

  loanTabs.forEach((btn) => {
    btn.addEventListener('click', () => switchLoanType(btn.getAttribute('data-type')));
  });

  // Tenure Mode Toggle
  btnTenureYr.addEventListener('click', () => {
    if (tenureType !== 'years') {
      tenureType = 'years';
      btnTenureYr.className = 'rounded px-1.5 py-0.5 bg-blue-600 text-white cursor-pointer';
      btnTenureMo.className = 'rounded px-1.5 py-0.5 text-slate-600 dark:text-slate-400 hover:text-blue-600 cursor-pointer';
      const mo = parseFloat(inpLoanTenure.value) || 240;
      inpLoanTenure.value = Math.max(1, Math.round(mo / 12));
    }
  });

  btnTenureMo.addEventListener('click', () => {
    if (tenureType !== 'months') {
      tenureType = 'months';
      btnTenureMo.className = 'rounded px-1.5 py-0.5 bg-blue-600 text-white cursor-pointer';
      btnTenureYr.className = 'rounded px-1.5 py-0.5 text-slate-600 dark:text-slate-400 hover:text-blue-600 cursor-pointer';
      const yr = parseFloat(inpLoanTenure.value) || 20;
      inpLoanTenure.value = Math.round(yr * 12);
    }
  });

  // Calculate Main EMI Function
  function executeMainEmiCalc() {
    errMain.classList.add('hidden');
    const P = parseFloat(inpLoanAmount.value) || 0;
    const annualR = parseFloat(inpInterestRate.value);
    const tenureVal = parseFloat(inpLoanTenure.value) || 0;
    const fee = parseFloat(inpProcFee.value) || 0;

    if (P <= 0) {
      errMain.textContent = 'Please enter a valid loan amount greater than zero.';
      errMain.classList.remove('hidden');
      emiResultsSection.classList.add('hidden');
      return;
    }

    if (isNaN(annualR) || annualR < 0) {
      errMain.textContent = 'Please enter a valid interest rate (0% or greater).';
      errMain.classList.remove('hidden');
      emiResultsSection.classList.add('hidden');
      return;
    }

    if (tenureVal <= 0) {
      errMain.textContent = 'Loan tenure must be greater than zero.';
      errMain.classList.remove('hidden');
      emiResultsSection.classList.add('hidden');
      return;
    }

    const n = tenureType === 'years' ? Math.round(tenureVal * 12) : Math.round(tenureVal);
    const r = annualR / 12 / 100;

    let emi = 0;
    if (r === 0) {
      emi = Math.round(P / n);
    } else {
      const factor = Math.pow(1 + r, n);
      emi = Math.round((P * r * factor) / (factor - 1));
    }

    const totalPayment = emi * n;
    const totalInterest = Math.max(0, totalPayment - P);
    const intPct = totalPayment > 0 ? ((totalInterest / totalPayment) * 100) : 0;
    const princPct = 100 - intPct;

    resMonthlyEmi.textContent = formatINR(emi);
    resTotalPayment.textContent = formatINR(totalPayment + fee);
    resPrincipalAmt.textContent = formatINR(P);
    resTotalInterest.textContent = formatINR(totalInterest);
    resTenureSummary.textContent = `${Math.round(n/12)} Yrs (${n} Months)`;
    resSplitPct.textContent = `${intPct.toFixed(1)}% Interest / ${princPct.toFixed(1)}% Principal`;

    // Update Donut Chart
    const intCircum = intPct.toFixed(1);
    const princCircum = princPct.toFixed(1);
    svgDonutInterest.setAttribute('stroke-dasharray', `${intCircum} ${princCircum}`);
    txtLegendPrinc.textContent = `${formatINR(P)} (${princPct.toFixed(1)}%)`;
    txtLegendInt.textContent = `${formatINR(totalInterest)} (${intPct.toFixed(1)}%)`;

    // Generate Schedules
    const monthlyList = [];
    const yearlyList = [];
    let curBal = P;
    let yOpen = P;
    let yEmi = 0, yP = 0, yI = 0;

    for (let m = 1; m <= n; m++) {
      const iPaid = Math.round(curBal * r);
      const pPaid = m === n ? curBal : Math.min(curBal, emi - iPaid);
      const openBal = curBal;
      curBal = Math.max(0, curBal - pPaid);

      monthlyList.push({ m, open: openBal, emi, pPaid, iPaid, close: curBal });

      yEmi += emi;
      yP += pPaid;
      yI += iPaid;

      if (m % 12 === 0 || m === n) {
        yearlyList.push({ y: Math.ceil(m/12), open: yOpen, emi: yEmi, pPaid: yP, iPaid: yI, close: curBal });
        yOpen = curBal;
        yEmi = 0; yP = 0; yI = 0;
      }
    }

    lastCalculatedSchedules = { monthly: monthlyList, yearly: yearlyList };
    renderSchedule();

    resVisualBreakdown.classList.remove('hidden');
    resAmortizationCard.classList.remove('hidden');
    resPrepayCard.classList.add('hidden');
    resCompareCard.classList.add('hidden');
    emiResultsSection.classList.remove('hidden');
  }

  btnMainCalc.addEventListener('click', executeMainEmiCalc);

  btnMainClear.addEventListener('click', () => {
    inpLoanAmount.value = '1000000';
    inpInterestRate.value = '8.5';
    inpLoanTenure.value = '20';
    inpAssetPrice.value = '1200000';
    inpDownPayment.value = '200000';
    inpProcFee.value = '0';
    errMain.classList.add('hidden');
    emiResultsSection.classList.add('hidden');
  });

  // Render Amortization Schedule
  function renderSchedule() {
    if (activeScheduleView === 'yearly') {
      thScheduleTime.textContent = 'Year';
      scheduleTbody.innerHTML = lastCalculatedSchedules.yearly.map(r => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Year ${r.y}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(r.open)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(r.emi)}</td>
          <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-bold">${formatINR(r.pPaid)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-bold">${formatINR(r.iPaid)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(r.close)}</td>
        </tr>
      `).join('');
    } else {
      thScheduleTime.textContent = 'Month';
      scheduleTbody.innerHTML = lastCalculatedSchedules.monthly.map(r => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Mo ${r.m}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(r.open)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(r.emi)}</td>
          <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-bold">${formatINR(r.pPaid)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-bold">${formatINR(r.iPaid)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(r.close)}</td>
        </tr>
      `).join('');
    }
  }

  btnViewYearly.addEventListener('click', () => {
    activeScheduleView = 'yearly';
    btnViewYearly.className = 'rounded-lg bg-blue-600 px-2.5 py-1 text-white shadow-2xs cursor-pointer';
    btnViewMonthly.className = 'rounded-lg border border-slate-300 px-2.5 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer';
    renderSchedule();
  });

  btnViewMonthly.addEventListener('click', () => {
    activeScheduleView = 'monthly';
    btnViewMonthly.className = 'rounded-lg bg-blue-600 px-2.5 py-1 text-white shadow-2xs cursor-pointer';
    btnViewYearly.className = 'rounded-lg border border-slate-300 px-2.5 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer';
    renderSchedule();
  });

  // PDF Export Functionality
  const btnDownloadPdf = document.getElementById('btn-download-pdf');
  const txtBtnPdf = document.getElementById('txt-btn-pdf');

  async function generateAmortizationPdf() {
    const isYearly = activeScheduleView === 'yearly';
    const scheduleData = isYearly ? lastCalculatedSchedules.yearly : lastCalculatedSchedules.monthly;

    if (!scheduleData || scheduleData.length === 0) {
      alert('Please calculate your loan EMI first before downloading the PDF schedule.');
      return;
    }

    btnDownloadPdf.disabled = true;
    const originalText = txtBtnPdf.textContent;
    txtBtnPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

      const P = parseFloat(inpLoanAmount.value) || 0;
      const rate = parseFloat(inpInterestRate.value) || 0;
      const tenureVal = parseFloat(inpLoanTenure.value) || 0;
      const nMonths = tenureType === 'years' ? tenureVal * 12 : tenureVal;
      const emiText = resMonthlyEmi.textContent || '';
      const totalIntText = resTotalInterest.textContent || '';
      const totalPayText = resTotalPayment.textContent || '';
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      let loanName = 'General Loan';
      if (currentLoanType === 'home') loanName = 'Home Loan';
      else if (currentLoanType === 'car') loanName = 'Car Loan';
      else if (currentLoanType === 'personal') loanName = 'Personal Loan';
      else if (currentLoanType === 'bike') loanName = 'Bike Loan';

      // 1. Header & Website Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title (Reflects selected view)
      const pdfTitle = isYearly 
        ? 'Loan Repayment Amortization Schedule – Yearly Summary'
        : 'Loan Repayment Amortization Schedule – Monthly Schedule';

      doc.setTextColor(15, 23, 42); // Slate-900
      doc.setFontSize(12.5);
      doc.setFont('helvetica', 'bold');
      doc.text(pdfTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Loan Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 26, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('LOAN SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);

      doc.text(`Loan Type: ${loanName}`, 18, 44);
      doc.text(`Loan Principal: Rs. ${P.toLocaleString('en-IN')}`, 18, 49);
      doc.text(`Interest Rate: ${rate}% p.a.`, 18, 54);

      doc.text(`Tenure: ${tenureVal} ${tenureType === 'years' ? 'Years' : 'Months'} (${nMonths} Months)`, 85, 44);
      doc.text(`Monthly EMI: ${emiText.replace('₹', 'Rs.')}`, 85, 49);
      doc.text(`Total Interest: ${totalIntText.replace('₹', 'Rs.')}`, 85, 54);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(37, 99, 235);
      doc.text(`Total Repayment: ${totalPayText.replace('₹', 'Rs.')}`, 145, 49);

      // 4. Table Data Preparation based ONLY on active selected view
      let headRow = [];
      let tableData = [];

      if (isYearly) {
        headRow = [['Year', 'Opening Balance', 'Total EMI Paid', 'Principal Paid', 'Interest Paid', 'Closing Balance']];
        tableData = lastCalculatedSchedules.yearly.map((row) => [
          `Year ${row.y}`,
          `Rs. ${row.open.toLocaleString('en-IN')}`,
          `Rs. ${row.emi.toLocaleString('en-IN')}`,
          `Rs. ${row.pPaid.toLocaleString('en-IN')}`,
          `Rs. ${row.iPaid.toLocaleString('en-IN')}`,
          `Rs. ${row.close.toLocaleString('en-IN')}`
        ]);
      } else {
        headRow = [['Month', 'Opening Balance', 'EMI Payment', 'Principal Paid', 'Interest Paid', 'Closing Balance']];
        tableData = lastCalculatedSchedules.monthly.map((row) => [
          `Month ${row.m}`,
          `Rs. ${row.open.toLocaleString('en-IN')}`,
          `Rs. ${row.emi.toLocaleString('en-IN')}`,
          `Rs. ${row.pPaid.toLocaleString('en-IN')}`,
          `Rs. ${row.iPaid.toLocaleString('en-IN')}`,
          `Rs. ${row.close.toLocaleString('en-IN')}`
        ]);
      }

      doc.autoTable({
        startY: 63,
        head: headRow,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { halign: 'center', cellWidth: 20 },
          1: { halign: 'right' },
          2: { halign: 'right' },
          3: { halign: 'right', textColor: [37, 99, 235] },
          4: { halign: 'right', textColor: [16, 185, 129] },
          5: { halign: 'right', fontStyle: 'bold' }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      // 5. Filename formatting based on selected view
      const today = new Date().toISOString().split('T')[0];
      const filename = isYearly
        ? `loan-repayment-yearly-summary-${today}.pdf`
        : `loan-repayment-monthly-schedule-${today}.pdf`;

      doc.save(filename);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnDownloadPdf.disabled = false;
      txtBtnPdf.textContent = originalText;
    }
  }

  btnDownloadPdf.addEventListener('click', generateAmortizationPdf);

  // Calculate Prepayment Impact
  btnPrepayCalc.addEventListener('click', () => {
    errPrepay.classList.add('hidden');
    const p = parseFloat(prePrincipal.value) || 0;
    const r = (parseFloat(preRate.value) || 0) / 12 / 100;
    const remMonths = parseInt(preTenureMo.value) || 0;
    const prepayAmt = parseFloat(preAmount.value) || 0;

    if (p <= 0 || remMonths <= 0 || prepayAmt <= 0) {
      errPrepay.textContent = 'Please enter valid numbers for outstanding loan, tenure, and prepayment.';
      errPrepay.classList.remove('hidden');
      return;
    }

    // Base EMI
    const factor = Math.pow(1 + r, remMonths);
    const curEmi = Math.round((p * r * factor) / (factor - 1));
    const origTotInt = Math.max(0, (curEmi * remMonths) - p);

    const newPrincipal = Math.max(0, p - prepayAmt);
    let bal = newPrincipal;
    let newMonths = 0;
    let newTotInt = 0;

    while (bal > 0 && newMonths < remMonths) {
      newMonths++;
      const int = Math.round(bal * r);
      newTotInt += int;
      const pPaid = Math.min(bal, curEmi - int);
      bal -= pPaid;
    }

    const savedInt = Math.max(0, origTotInt - newTotInt);
    const reducedMo = Math.max(0, remMonths - newMonths);

    txtPrepaySaved.textContent = formatINR(savedInt);
    txtPrepayReduced.textContent = `${reducedMo} Months (~${(reducedMo/12).toFixed(1)} Yrs)`;
    txtPrepayNewtenure.textContent = `${newMonths} Months (~${(newMonths/12).toFixed(1)} Yrs)`;

    resPrepayCard.classList.remove('hidden');
    resVisualBreakdown.classList.add('hidden');
    resAmortizationCard.classList.add('hidden');
    resCompareCard.classList.add('hidden');

    resMonthlyEmi.textContent = formatINR(curEmi);
    resTotalPayment.textContent = formatINR(curEmi * newMonths + prepayAmt);
    resPrincipalAmt.textContent = formatINR(p);
    resTotalInterest.textContent = formatINR(newTotInt);
    resTenureSummary.textContent = `${newMonths} Months (Reduced by ${reducedMo} Mo)`;
    resSplitPct.textContent = `Saved ${formatINR(savedInt)} in Interest`;

    emiResultsSection.classList.remove('hidden');
  });

  btnPrepayClear.addEventListener('click', () => {
    prePrincipal.value = '4000000';
    preRate.value = '8.5';
    preTenureMo.value = '180';
    preAmount.value = '300000';
    errPrepay.classList.add('hidden');
    emiResultsSection.classList.add('hidden');
  });

  // Calculate 3-Loan Comparison
  btnCompareCalc.addEventListener('click', () => {
    const list = [
      { name: 'Loan Option A', p: parseFloat(cmpAp.value)||0, r: (parseFloat(cmpAr.value)||0)/12/100, yr: parseFloat(cmpAt.value)||0 },
      { name: 'Loan Option B', p: parseFloat(cmpBp.value)||0, r: (parseFloat(cmpBr.value)||0)/12/100, yr: parseFloat(cmpBt.value)||0 },
      { name: 'Loan Option C', p: parseFloat(cmpCp.value)||0, r: (parseFloat(cmpCr.value)||0)/12/100, yr: parseFloat(cmpCt.value)||0 }
    ];

    const results = list.map(item => {
      const n = item.yr * 12;
      const factor = Math.pow(1 + item.r, n);
      const emi = item.r === 0 ? Math.round(item.p / n) : Math.round((item.p * item.r * factor) / (factor - 1));
      const totalPay = emi * n;
      const totalInt = Math.max(0, totalPay - item.p);
      return { ...item, emi, totalPay, totalInt, n };
    });

    let minEmi = Math.min(...results.map(r => r.emi));
    let minInt = Math.min(...results.map(r => r.totalInt));

    compareTbody.innerHTML = results.map(r => `
      <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
        <td class="p-2.5 font-bold text-slate-900 dark:text-white">${r.name}</td>
        <td class="p-2.5 text-right font-black ${r.emi === minEmi ? 'text-emerald-600 dark:text-emerald-400' : 'text-blue-600 dark:text-blue-400'}">${formatINR(r.emi)} ${r.emi === minEmi ? '⭐' : ''}</td>
        <td class="p-2.5 text-right ${r.totalInt === minInt ? 'font-black text-emerald-600 dark:text-emerald-400' : ''}">${formatINR(r.totalInt)} ${r.totalInt === minInt ? '🏆' : ''}</td>
        <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(r.totalPay)}</td>
        <td class="p-2.5 text-center">${r.yr} Yrs</td>
      </tr>
    `).join('');

    resCompareCard.classList.remove('hidden');
    resPrepayCard.classList.add('hidden');
    resVisualBreakdown.classList.add('hidden');
    resAmortizationCard.classList.add('hidden');
    emiResultsSection.classList.remove('hidden');
  });

  btnCompareClear.addEventListener('click', () => {
    cmpAp.value = '1000000'; cmpAr.value = '8.5'; cmpAt.value = '20';
    cmpBp.value = '1000000'; cmpBr.value = '8.0'; cmpBt.value = '20';
    cmpCp.value = '1000000'; cmpCr.value = '9.0'; cmpCt.value = '15';
    emiResultsSection.classList.add('hidden');
  });

  // Preset Handlers
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-type');
      switchLoanType(type);

      if (btn.hasAttribute('data-amt')) inpLoanAmount.value = btn.getAttribute('data-amt');
      if (btn.hasAttribute('data-rate')) inpInterestRate.value = btn.getAttribute('data-rate');
      if (btn.hasAttribute('data-tenure')) inpLoanTenure.value = btn.getAttribute('data-tenure');
      if (btn.hasAttribute('data-price')) inpAssetPrice.value = btn.getAttribute('data-price');
      if (btn.hasAttribute('data-down')) inpDownPayment.value = btn.getAttribute('data-down');
    });
  });

  // Enter Key Support
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.click();
        }
      });
    });
  });
</script>
