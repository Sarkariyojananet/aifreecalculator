---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="EMI Calculator – Home, Car, Personal & Bike Loan EMI"
  description="Calculate your monthly EMI, total interest, total repayment amount, and complete loan repayment schedule for home, car, personal, and bike loans."
  category="Finance"
  calculatorName="EMI Calculator"
  slug="emi-calculator"
  keywords={[
    'EMI Calculator',
    'home loan emi calculator',
    'loan emi calculator',
    'car loan emi calculator',
    'personal loan emi calculator',
    'car emi calculator',
    'emi calculator home loan',
    'emi calculator car',
    'emi calculator for home loan',
    'bike emi calculator'
  ]}
>
  <div class="space-y-6">

    <!-- LOAN TYPE SELECTOR TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-loan-tab active shrink-0 rounded-lg bg-blue-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-type="general">General Loan</button>
        <button type="button" class="btn-loan-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="home">Home Loan 🏠</button>
        <button type="button" class="btn-loan-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="car">Car Loan 🚗</button>
        <button type="button" class="btn-loan-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="personal">Personal Loan 💼</button>
        <button type="button" class="btn-loan-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="bike">Bike Loan 🏍️</button>
        <button type="button" class="btn-loan-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="prepay">Prepayment Planner 💰</button>
        <button type="button" class="btn-loan-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="compare">Compare 3 Loans ⚖️</button>
      </div>
    </div>

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="home" data-amt="5000000" data-rate="8.5" data-tenure="20" data-tenure-type="years">🏠 Home Loan (₹50 Lakh @ 8.5%, 20 Yrs)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="car" data-price="1200000" data-down="200000" data-amt="1000000" data-rate="9.0" data-tenure="5" data-tenure-type="years">🚗 Car Loan (₹10 Lakh @ 9%, 5 Yrs)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="personal" data-amt="500000" data-rate="12.0" data-tenure="5" data-tenure-type="years">💼 Personal Loan (₹5 Lakh @ 12%, 5 Yrs)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="bike" data-price="250000" data-down="50000" data-amt="200000" data-rate="10.0" data-tenure="3" data-tenure-type="years">🏍️ Bike Loan (₹2 Lakh @ 10%, 3 Yrs)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR PANELS CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">

      <!-- 1. STANDARD & VEHICLE EMI FORM PANEL -->
      <div id="panel-standard-emi" class="space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 id="emi-panel-title" class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>💳</span> General Loan EMI Calculator
          </h2>
          <p id="emi-panel-desc" class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Enter your loan principal, annual interest rate, and repayment tenure to compute your monthly installment.
          </p>
        </div>

        <form id="form-main-emi" class="space-y-4" novalidate onsubmit="return false;">
          
          <!-- Optional Vehicle / Property Price & Down Payment Row (Hidden in General Mode) -->
          <div id="row-price-down" class="hidden grid grid-cols-1 gap-3 sm:grid-cols-2 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
            <div>
              <label for="inp-asset-price" id="lbl-asset-price" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Property / Vehicle Cost (₹)</label>
              <input type="number" id="inp-asset-price" value="1200000" step="10000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="12,00,000" />
            </div>
            <div>
              <label for="inp-down-payment" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Down Payment (₹)</label>
              <input type="number" id="inp-down-payment" value="200000" step="10000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="2,00,000" />
            </div>
          </div>

          <!-- Main 3 Core Inputs: Principal, Interest Rate, Tenure -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="inp-loan-amount" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Loan Amount (₹)</label>
              <input type="number" id="inp-loan-amount" value="1000000" step="10000" min="1000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10,00,000" />
            </div>
            <div>
              <label for="inp-interest-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Interest Rate (% p.a.)</label>
              <input type="number" id="inp-interest-rate" value="8.5" step="0.05" min="0" max="40" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="8.5" />
            </div>
            <div>
              <div class="flex items-center justify-between">
                <label for="inp-loan-tenure" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Loan Tenure</label>
                <div class="flex items-center gap-1 text-[11px] font-bold">
                  <button type="button" id="btn-tenure-yr" class="rounded px-1.5 py-0.5 bg-blue-600 text-white cursor-pointer">Years</button>
                  <button type="button" id="btn-tenure-mo" class="rounded px-1.5 py-0.5 text-slate-600 dark:text-slate-400 hover:text-blue-600 cursor-pointer">Months</button>
                </div>
              </div>
              <input type="number" id="inp-loan-tenure" value="20" step="1" min="1" max="40" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="20" />
            </div>
          </div>

          <!-- Optional Processing Fee Row (Hidden in General Mode) -->
          <div id="row-fee" class="hidden">
            <label for="inp-proc-fee" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Optional Processing Fee / Other Charges (₹)</label>
            <input type="number" id="inp-proc-fee" value="0" step="500" min="0" class="mt-1 w-full sm:w-1/3 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="0" />
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-main-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate EMI →
            </button>
            <button type="button" id="btn-main-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-main" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>
      </div>

      <!-- 2. PREPAYMENT PLANNER PANEL -->
      <div id="panel-prepay" class="hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>💰</span> Home Loan Prepayment Impact Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            See how making a lump-sum prepayment saves overall interest and reduces your remaining loan duration.
          </p>
        </div>

        <form id="form-prepay" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <div>
              <label for="pre-principal" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Outstanding Loan (₹)</label>
              <input type="number" id="pre-principal" value="4000000" step="50000" min="10000" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" />
            </div>
            <div>
              <label for="pre-rate" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Interest Rate (% p.a.)</label>
              <input type="number" id="pre-rate" value="8.5" step="0.05" min="0" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" />
            </div>
            <div>
              <label for="pre-tenure-mo" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Remaining Tenure (Months)</label>
              <input type="number" id="pre-tenure-mo" value="180" step="1" min="1" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" />
            </div>
            <div>
              <label for="pre-amount" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Prepayment Amount (₹)</label>
              <input type="number" id="pre-amount" value="300000" step="10000" min="0" class="mt-1.5 w-full rounded-xl border border-slate-300 p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" />
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-prepay-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Calculate Prepayment Impact →
            </button>
            <button type="button" id="btn-prepay-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-prepay" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>
      </div>

      <!-- 3. COMPARE 3 LOANS PANEL -->
      <div id="panel-compare" class="hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>⚖️</span> Compare 3 Loan Options
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Compare different lender offers side-by-side to find the lowest monthly installment and minimal overall interest.
          </p>
        </div>

        <form id="form-compare" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            
            <!-- Loan A -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 space-y-2">
              <span class="text-xs font-bold text-blue-600 dark:text-blue-400">Loan Option A</span>
              <input type="number" id="cmp-a-p" value="1000000" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Principal ₹" />
              <input type="number" id="cmp-a-r" value="8.5" step="0.1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Rate %" />
              <input type="number" id="cmp-a-t" value="20" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Tenure (Yrs)" />
            </div>

            <!-- Loan B -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 space-y-2">
              <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">Loan Option B</span>
              <input type="number" id="cmp-b-p" value="1000000" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Principal ₹" />
              <input type="number" id="cmp-b-r" value="8.0" step="0.1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Rate %" />
              <input type="number" id="cmp-b-t" value="20" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Tenure (Yrs)" />
            </div>

            <!-- Loan C -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 space-y-2">
              <span class="text-xs font-bold text-purple-600 dark:text-purple-400">Loan Option C</span>
              <input type="number" id="cmp-c-p" value="1000000" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Principal ₹" />
              <input type="number" id="cmp-c-r" value="9.0" step="0.1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Rate %" />
              <input type="number" id="cmp-c-t" value="15" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Tenure (Yrs)" />
            </div>

          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-compare-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
              Compare Loan Options →
            </button>
            <button type="button" id="btn-compare-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>
        </form>
      </div>

      <!-- RESULTS PRESENTATION SECTION (Hidden Initially) -->
      <div id="emi-results-section" class="hidden mt-6 space-y-5">
        
        <!-- Main EMI Highlight Card -->
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="res-emi-badge" class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Your Monthly Installment (EMI)</span>
              <div id="res-monthly-emi" class="mt-1 text-4xl sm:text-5xl font-black text-blue-600 dark:text-blue-400">₹ 8,678</div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Loan Repayment:</span>
              <div id="res-total-payment" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">₹ 20,82,720</div>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Principal Loan Amount</div>
              <div id="res-principal-amt" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹ 10,00,000</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Interest Payable</div>
              <div id="res-total-interest" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">₹ 10,82,720</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Loan Tenure</div>
              <div id="res-tenure-summary" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">20 Years (240 Mo)</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Interest / Principal Split</div>
              <div id="res-split-pct" class="mt-1 text-sm sm:text-base font-bold text-purple-600 dark:text-purple-400">52.0% / 48.0%</div>
            </div>
          </div>
        </div>

        <!-- VISUAL BREAKDOWN WITH SVG DONUT -->
        <div id="res-visual-breakdown" class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-1.5">
            <span>📊</span> Loan Amount vs Total Interest Breakdown
          </h3>
          <div class="flex flex-col sm:flex-row items-center justify-around gap-6">
            
            <!-- SVG Donut -->
            <div class="relative w-40 h-40 flex items-center justify-center">
              <svg viewBox="0 0 36 36" class="w-full h-full transform -rotate-90">
                <!-- Background circle (Principal) -->
                <circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="3.8"></circle>
                <!-- Foreground circle (Interest) -->
                <circle id="svg-donut-interest" cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="3.8" stroke-dasharray="52 48" stroke-dashoffset="0"></circle>
              </svg>
              <div class="absolute text-center">
                <span class="text-[11px] font-bold text-slate-400 block">SPLIT</span>
                <span id="txt-donut-center" class="text-xs font-black text-slate-800 dark:text-slate-200">100%</span>
              </div>
            </div>

            <!-- Legend & Stats -->
            <div class="space-y-3 text-xs w-full sm:w-auto">
              <div class="flex items-center justify-between gap-6 p-2 rounded-xl bg-blue-50/50 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/40">
                <span class="flex items-center gap-2 font-bold text-blue-700 dark:text-blue-300">
                  <span class="w-3 h-3 rounded-full bg-blue-600 inline-block"></span> Principal Amount:
                </span>
                <span id="txt-legend-princ" class="font-bold text-slate-900 dark:text-white font-mono">₹ 10,00,000 (48.0%)</span>
              </div>
              <div class="flex items-center justify-between gap-6 p-2 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40">
                <span class="flex items-center gap-2 font-bold text-emerald-700 dark:text-emerald-300">
                  <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Total Interest:
                </span>
