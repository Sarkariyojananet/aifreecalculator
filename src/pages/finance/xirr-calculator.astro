---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="XIRR Calculator - Calculate Annualized Return on Investments"
  description="Calculate the exact Extended Internal Rate of Return (XIRR) for SIPs, mutual funds, and irregular cash flows using real calendar dates and actual day differences."
  category="Finance"
  calculatorName="XIRR Calculator"
  slug="xirr-calculator"
  keywords={[
    'xirr calculator',
    'extended internal rate of return',
    'xirr return calculator',
    'xirr calculator india',
    'investment xirr calculator',
    'mutual fund xirr calculator',
    'sip xirr calculator',
    'annualized return calculator',
    'cagr vs xirr calculator'
  ]}
>
  <div class="space-y-6">

      <!-- MODE SELECTION TABS -->
      <div class="flex items-center gap-2 overflow-x-auto border-b border-slate-200 pb-2 text-sm dark:border-slate-800">
        <button
          type="button"
          id="tab-btn-recurring"
          class="btn-xirr-tab active shrink-0 rounded-xl bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5"
          data-tab="recurring"
        >
          <span>🔄</span>
          <span>Recurring Investment XIRR</span>
        </button>
        <button
          type="button"
          id="tab-btn-custom"
          class="btn-xirr-tab shrink-0 rounded-xl border border-slate-300 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-tab="custom"
        >
          <span>📝</span>
          <span>Custom Cash Flows XIRR</span>
        </button>
      </div>

      <p id="mode-desc" class="text-xs text-slate-500 dark:text-slate-400">
        Automatically generate periodic investment cash flows and compute the annualized XIRR on actual dates.
      </p>

      <!-- ═══════════════════════════════════════════════════════════════════════ -->
      <!-- TAB 1: RECURRING INVESTMENT XIRR -->
      <!-- ═══════════════════════════════════════════════════════════════════════ -->
      <div id="panel-recurring" class="xirr-panel space-y-6">
        
        <form id="form-rec-xirr" class="space-y-4" novalidate onsubmit="return false;">
          
          <!-- 1. Investment Frequency -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Investment Frequency <span class="text-red-500">*</span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-1.5 rounded-xl bg-slate-100 p-1 dark:bg-slate-800">
              <button
                type="button"
                data-freq="14days"
                class="btn-freq-opt rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer text-center"
              >
                14 Days
              </button>
              <button
                type="button"
                data-freq="monthly"
                class="btn-freq-opt rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer text-center"
              >
                Monthly
              </button>
              <button
                type="button"
                data-freq="quarterly"
                class="btn-freq-opt rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer text-center"
              >
                Quarterly
              </button>
              <button
                type="button"
                data-freq="halfyearly"
                class="btn-freq-opt rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer text-center"
              >
                Half Yearly
              </button>
              <button
                type="button"
                data-freq="yearly"
                class="btn-freq-opt active col-span-2 sm:col-span-1 rounded-lg py-2 text-xs font-bold transition-all bg-white text-blue-600 shadow-2xs dark:bg-slate-700 dark:text-blue-400 cursor-pointer text-center"
              >
                Yearly
              </button>
            </div>
            <p id="hint-freq-desc" class="text-[11px] text-slate-500 dark:text-slate-400">
              Recurring payments occur once every 12 months on the start date anniversary.
            </p>
          </div>

          <!-- 2. Date Pickers Grid -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <!-- Start Date -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-1.5">
              <label for="inp-rec-start" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Start Date (First Investment) <span class="text-red-500">*</span>
              </label>
              <input
                type="date"
                id="inp-rec-start"
                value="2021-01-01"
                class="w-full rounded-xl border border-slate-300 bg-white py-2 px-3 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
              <p class="text-[11px] text-slate-400">Date of initial recurring contribution</p>
            </div>

            <!-- Maturity Date -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-1.5">
              <label for="inp-rec-end" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Maturity Date (Redemption) <span class="text-red-500">*</span>
              </label>
              <input
                type="date"
                id="inp-rec-end"
                value="2024-01-01"
                class="w-full rounded-xl border border-slate-300 bg-white py-2 px-3 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
              <p class="text-[11px] text-slate-400">Must be strictly after the start date</p>
            </div>
          </div>

          <!-- 3. Currency Inputs Grid -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <!-- Recurring Investment Amount -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-rec-amt" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Recurring Investment <span class="text-red-500">*</span>
                </label>
                <div class="relative w-32 sm:w-36">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-bold text-slate-400">₹</span>
                  <input
                    type="number"
                    id="inp-rec-amt"
                    value="10000"
                    step="500"
                    min="100"
                    class="w-full rounded-xl border border-slate-300 bg-white py-1.5 pl-7 pr-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>
              </div>
              <!-- Quick preset pills -->
              <div class="flex flex-wrap gap-1.5 text-[11px] font-semibold text-slate-500">
                <button type="button" class="btn-rec-amt-pill rounded-md bg-slate-100 px-2 py-0.5 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-slate-700 cursor-pointer" data-val="5000">₹5k</button>
                <button type="button" class="btn-rec-amt-pill rounded-md bg-slate-100 px-2 py-0.5 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-slate-700 cursor-pointer" data-val="10000">₹10k</button>
                <button type="button" class="btn-rec-amt-pill rounded-md bg-slate-100 px-2 py-0.5 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-slate-700 cursor-pointer" data-val="25000">₹25k</button>
                <button type="button" class="btn-rec-amt-pill rounded-md bg-slate-100 px-2 py-0.5 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-slate-700 cursor-pointer" data-val="50000">₹50k</button>
              </div>
            </div>

            <!-- Total Maturity Amount -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-rec-mat" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Total Maturity Amount <span class="text-red-500">*</span>
                </label>
                <div class="relative w-32 sm:w-36">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-bold text-slate-400">₹</span>
                  <input
                    type="number"
                    id="inp-rec-mat"
                    value="60000"
                    step="1000"
                    min="100"
                    class="w-full rounded-xl border border-slate-300 bg-white py-1.5 pl-7 pr-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>
              </div>
              <!-- Quick preset pills -->
              <div class="flex flex-wrap gap-1.5 text-[11px] font-semibold text-slate-500">
                <button type="button" class="btn-mat-amt-pill rounded-md bg-slate-100 px-2 py-0.5 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-slate-700 cursor-pointer" data-val="50000">₹50k</button>
                <button type="button" class="btn-mat-amt-pill rounded-md bg-slate-100 px-2 py-0.5 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-slate-700 cursor-pointer" data-val="60000">₹60k</button>
                <button type="button" class="btn-mat-amt-pill rounded-md bg-slate-100 px-2 py-0.5 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-slate-700 cursor-pointer" data-val="100000">₹1 Lakh</button>
                <button type="button" class="btn-mat-amt-pill rounded-md bg-slate-100 px-2 py-0.5 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:hover:bg-slate-700 cursor-pointer" data-val="500000">₹5 Lakh</button>
              </div>
            </div>
          </div>

          <!-- ACTION BUTTONS -->
          <div class="flex items-center gap-2 pt-2">
            <button
              type="submit"
              id="btn-calc-rec-xirr"
              class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer text-center"
            >
              Calculate XIRR →
            </button>
            <button
              type="button"
              id="btn-clear-rec-xirr"
              class="rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Clear (✕)
            </button>
          </div>

          <p id="err-rec-xirr" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- LIVE INTERACTIVE GRAPH (Updates dynamically on input changes) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
            <div>
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>📈</span> Live Investment Timeline &amp; Cash Flow Progression
              </h3>
              <p class="text-[11px] text-slate-400">Updates live as you change frequency, dates, or investment amounts</p>
            </div>
            <div class="flex items-center gap-4 text-[11px] font-bold">
              <span class="flex items-center gap-1.5 text-blue-600 dark:text-blue-400">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span> Cumulative Invested
              </span>
              <span class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> Maturity Value
              </span>
            </div>
          </div>

          <!-- Interactive Responsive SVG Timeline Canvas -->
          <div class="relative w-full overflow-hidden">
            <svg id="svg-timeline-chart" viewBox="0 0 700 280" class="w-full h-auto select-none overflow-visible cursor-crosshair"></svg>
            <!-- Hover Floating Tooltip -->
            <div id="chart-tooltip" class="pointer-events-none absolute hidden z-20 rounded-xl bg-slate-900/95 p-2.5 text-xs text-white shadow-xl backdrop-blur-xs border border-slate-700 space-y-1 transition-opacity duration-150">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- Quick Cash Flow Indicator Pills -->
          <div class="flex flex-wrap items-center justify-between gap-2 pt-1 text-[11px] text-slate-500 dark:text-slate-400">
            <span id="txt-chart-summary-inflow">Maturity Inflow: <strong>₹60,000</strong></span>
            <span id="txt-chart-summary-invested">Total Invested: <strong>₹30,000 (3 installments)</strong></span>
            <span id="txt-chart-summary-tenure">Tenure: <strong>3.0 Years (1,095 Days)</strong></span>
          </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- RECURRING RESULTS CONTAINER (Hidden until button is clicked) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div id="rec-results-section" class="hidden space-y-6">
          
          <!-- Highlight Result Card -->
          <div class="overflow-hidden rounded-3xl border border-emerald-200 bg-linear-to-br from-white via-emerald-50/40 to-emerald-100/50 p-5 shadow-lg shadow-emerald-500/5 dark:border-emerald-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-emerald-950/30 sm:p-7">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-emerald-200/80 pb-4 dark:border-slate-800">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Estimated Annualized Return (XIRR)</span>
                <div id="res-rec-xirr" class="mt-1 text-3xl sm:text-5xl font-black text-emerald-600 dark:text-emerald-400">
                  38.92% p.a.
                </div>
              </div>
              <div class="sm:text-right">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Net Gain / Profit:</span>
                <div id="res-rec-profit" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
                  + ₹ 30,000
                </div>
              </div>
            </div>

            <!-- 6 Metrics Grid -->
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Invested Capital</div>
                <div id="res-rec-invested" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹ 30,000</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Maturity Value</div>
                <div id="res-rec-maturity" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">₹ 60,000</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Absolute Return</div>
                <div id="res-rec-abs-return" class="mt-1 text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400">+ 100.0%</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Number of Investments</div>
                <div id="res-rec-count" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">3 Installments</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Investment Frequency</div>
                <div id="res-rec-freq" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">Yearly</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Investment Period</div>
                <div id="res-rec-tenure" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">3.0 Years (1,095 Days)</div>
              </div>
            </div>
          </div>

          <!-- Detailed Cash Flow Schedule Table -->
          <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-4">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>📅</span> Detailed Cash Flow Schedule
            </h3>
            <div class="overflow-x-auto max-h-96 scrollbar-thin">
              <table class="w-full text-left text-xs">
                <thead class="sticky top-0 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold">
                  <tr>
                    <th class="p-2.5 rounded-l-lg">#</th>
                    <th class="p-2.5">Date</th>
                    <th class="p-2.5">Cash Flow Type</th>
                    <th class="p-2.5 text-right">Cash Flow Amount</th>
                    <th class="p-2.5 text-right rounded-r-lg">Cumulative Invested</th>
                  </tr>
                </thead>
                <tbody id="tbody-rec-schedule" class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono">
                  <!-- Dynamically populated -->
                </tbody>
              </table>
            </div>
          </div>

        </div>

      </div>

      <!-- ═══════════════════════════════════════════════════════════════════════ -->
      <!-- TAB 2: CUSTOM CASH FLOWS XIRR (Advanced Mode) -->
      <!-- ═══════════════════════════════════════════════════════════════════════ -->
      <div id="panel-custom" class="xirr-panel hidden space-y-6">
        
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
            <div>
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>📝</span> Custom Irregular Cash Flow Entries
              </h3>
              <p class="text-[11px] text-slate-400">Add arbitrary dates, investments (outflows), and redemptions (inflows)</p>
            </div>
            <!-- Preset Samples -->
            <div class="flex items-center gap-1.5 text-xs">
              <span class="text-[11px] text-slate-400 font-medium">Presets:</span>
              <button type="button" id="btn-custom-preset-sip" class="rounded-lg bg-slate-100 px-2 py-1 text-slate-700 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">3-Yr Annual</button>
              <button type="button" id="btn-custom-preset-trade" class="rounded-lg bg-slate-100 px-2 py-1 text-slate-700 hover:bg-blue-50 hover:text-blue-600 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">Irregular Trades</button>
            </div>
          </div>

          <!-- Dynamic Cash Flow Table -->
          <div class="overflow-x-auto max-h-96 scrollbar-thin">
            <table class="w-full text-left text-xs">
              <thead class="sticky top-0 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold">
                <tr>
                  <th class="p-2.5 rounded-l-lg w-12">#</th>
                  <th class="p-2.5 w-44">Date</th>
                  <th class="p-2.5 w-36">Type</th>
                  <th class="p-2.5">Amount (₹)</th>
                  <th class="p-2.5 text-center w-12 rounded-r-lg">Action</th>
                </tr>
              </thead>
              <tbody id="tbody-custom-cfs" class="divide-y divide-slate-100 dark:divide-slate-800/60">
                <!-- Dynamically populated rows -->
              </tbody>
            </table>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
            <button
              type="button"
              id="btn-add-custom-cf"
              class="rounded-xl border border-slate-300 bg-white hover:bg-slate-100 px-3.5 py-2 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer flex items-center gap-1.5"
            >
              <span>➕ Add Cash Flow</span>
            </button>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-calc-custom-xirr"
                class="rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-2.5 text-xs font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
              >
                Calculate Custom XIRR →
              </button>
              <button
                type="button"
                id="btn-clear-custom-cfs"
                class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
              >
                Reset
              </button>
            </div>
          </div>

          <p id="err-custom-xirr" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>
        </div>

        <!-- Custom Results Container -->
        <div id="custom-results-section" class="hidden space-y-6">
          <div class="overflow-hidden rounded-3xl border border-emerald-200 bg-linear-to-br from-white via-emerald-50/40 to-emerald-100/50 p-5 shadow-lg shadow-emerald-500/5 dark:border-emerald-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-emerald-950/30 sm:p-7">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-emerald-200/80 pb-4 dark:border-slate-800">
              <div>
