      // Hide results on modification (on-demand calculation requirement)
      handleRecurringInputModified();
    });
  });

  // Preset pills
  document.querySelectorAll('.btn-rec-amt-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      inpRecAmt.value = btn.getAttribute('data-val') || '10000';
      handleRecurringInputModified();
    });
  });

  document.querySelectorAll('.btn-mat-amt-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      inpRecMat.value = btn.getAttribute('data-val') || '60000';
      handleRecurringInputModified();
    });
  });

  function handleRecurringInputModified() {
    recResultsSection.classList.add('hidden');
    errRecXirr.classList.add('hidden');
    // Live update graph without waiting for calculate button
    renderLiveChart();
  }

  inpRecStart.addEventListener('change', handleRecurringInputModified);
  inpRecEnd.addEventListener('change', handleRecurringInputModified);
  inpRecAmt.addEventListener('input', handleRecurringInputModified);
  inpRecMat.addEventListener('input', handleRecurringInputModified);

  // ─────────────────────────────────────────────────────────────────────────
  // LIVE INTERACTIVE GRAPH ENGINE (SVG)
  // ─────────────────────────────────────────────────────────────────────────
  interface ChartDataPoint {
    date: string;
    label: string;
    amount: number;
    cumulative: number;
    type: 'investment' | 'maturity';
    x: number;
    y: number;
  }

  let currentChartPoints: ChartDataPoint[] = [];

  function renderLiveChart() {
    const startStr = inpRecStart.value;
    const endStr = inpRecEnd.value;
    const recAmt = parseFloat(inpRecAmt.value) || 0;
    const matAmt = parseFloat(inpRecMat.value) || 0;

    if (!startStr || !endStr || endStr <= startStr || recAmt <= 0 || matAmt <= 0) {
      svgTimelineChart.innerHTML = `
        <text x="350" y="140" fill="#94a3b8" font-size="12" font-weight="bold" text-anchor="middle">
          Please enter valid start date, maturity date (&gt; start), and positive amounts to view chart.
        </text>
      `;
      return;
    }

    let cashFlows: CashFlowItem[] = [];
    try {
      cashFlows = generateRecurringCashFlows({
        frequency: selectedFrequency,
        startDate: startStr,
        maturityDate: endStr,
        recurringAmount: recAmt,
        maturityAmount: matAmt,
      });
    } catch {
      return;
    }

    if (cashFlows.length < 2) return;

    const totalInvested = cashFlows
      .filter((c) => c.amount < 0)
      .reduce((sum, c) => sum + Math.abs(c.amount), 0);
    const investCount = cashFlows.filter((c) => c.amount < 0).length;

    txtChartSummaryInflow.innerHTML = `Maturity Inflow: <strong>${formatINR(matAmt)}</strong>`;
    txtChartSummaryInvested.innerHTML = `Total Invested: <strong>${formatINR(totalInvested)} (${investCount} installments)</strong>`;

    const dStart = new Date(startStr + 'T00:00:00').getTime();
    const dEnd = new Date(endStr + 'T00:00:00').getTime();
    const totalDays = Math.max(1, Math.round((dEnd - dStart) / (1000 * 60 * 60 * 24)));
    txtChartSummaryTenure.innerHTML = `Tenure: <strong>${(totalDays / 365).toFixed(1)} Yrs (${totalDays} Days)</strong>`;

    const W = 700;
    const H = 280;
    const padL = 60;
    const padR = 40;
    const padT = 30;
    const padB = 40;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;

    const maxVal = Math.max(matAmt, totalInvested) * 1.15;
    const minVal = 0;

    const getX = (dateStr: string) => {
      const t = new Date(dateStr + 'T00:00:00').getTime();
      const progress = Math.min(1, Math.max(0, (t - dStart) / (dEnd - dStart)));
      return padL + progress * chartW;
    };

    const getY = (val: number) => {
      const ratio = (val - minVal) / (maxVal - minVal);
      return padT + chartH - ratio * chartH;
    };

    // Calculate chart coordinates
    currentChartPoints = cashFlows.map((cf) => {
      const cx = getX(cf.date);
      const cy = cf.type === 'maturity' ? getY(matAmt) : getY(cf.cumulativeInvested || 0);
      return {
        date: cf.date,
        label: cf.type === 'maturity' ? 'Maturity Redemption' : `Investment #${cf.index}`,
        amount: cf.amount,
        cumulative: cf.cumulativeInvested || 0,
        type: cf.type === 'maturity' ? 'maturity' : 'investment',
        x: cx,
        y: cy,
      };
    });

    // Build cumulative step line and area path
    const investPoints = currentChartPoints.filter((p) => p.type === 'investment');
    let pathD = '';
    let areaD = '';

    if (investPoints.length > 0) {
      pathD = `M ${investPoints[0].x} ${investPoints[0].y}`;
      areaD = `M ${investPoints[0].x} ${padT + chartH} L ${investPoints[0].x} ${investPoints[0].y}`;

      for (let i = 1; i < investPoints.length; i++) {
        // Step line progression
        const prev = investPoints[i - 1];
        const curr = investPoints[i];
        pathD += ` L ${curr.x} ${prev.y} L ${curr.x} ${curr.y}`;
        areaD += ` L ${curr.x} ${prev.y} L ${curr.x} ${curr.y}`;
      }

      // Connect to maturity X coordinate
      const lastInvest = investPoints[investPoints.length - 1];
      const matPoint = currentChartPoints[currentChartPoints.length - 1];
      pathD += ` L ${matPoint.x} ${lastInvest.y}`;
      areaD += ` L ${matPoint.x} ${lastInvest.y} L ${matPoint.x} ${padT + chartH} Z`;
    }

    // Grid Y Lines (4 horizontal reference levels)
    let gridLinesSvg = '';
    for (let i = 0; i <= 4; i++) {
      const val = (maxVal / 4) * i;
      const y = getY(val);
      gridLinesSvg += `
        <line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="currentColor" class="text-slate-100 dark:text-slate-800/80" stroke-width="1" stroke-dasharray="3 3"></line>
        <text x="${padL - 8}" y="${y + 3}" fill="#94a3b8" font-size="9" font-weight="600" text-anchor="end">${formatINR(val)}</text>
      `;
    }

    // Date X Labels (Start, Mid, End)
    const midDateMs = dStart + (dEnd - dStart) / 2;
    const midDateStr = new Date(midDateMs).toISOString().split('T')[0];
    const xLabelsSvg = `
      <text x="${padL}" y="${H - 12}" fill="#64748b" font-size="10" font-weight="700" text-anchor="start">${startStr}</text>
      <text x="${padL + chartW / 2}" y="${H - 12}" fill="#94a3b8" font-size="9" font-weight="600" text-anchor="middle">${midDateStr}</text>
      <text x="${W - padR}" y="${H - 12}" fill="#10b981" font-size="10" font-weight="700" text-anchor="end">${endStr}</text>
    `;

    // Maturity Bar / Target Marker
    const matPoint = currentChartPoints[currentChartPoints.length - 1];
    const maturitySvg = `
      <line x1="${matPoint.x}" y1="${padT + chartH}" x2="${matPoint.x}" y2="${matPoint.y}" stroke="#10b981" stroke-width="3.5" stroke-linecap="round"></line>
      <circle cx="${matPoint.x}" cy="${matPoint.y}" r="6" fill="#10b981" stroke="#ffffff" stroke-width="2.5" class="shadow-md"></circle>
      <text x="${matPoint.x}" y="${matPoint.y - 10}" fill="#10b981" font-size="10" font-weight="900" text-anchor="middle">Maturity: ${formatINR(matAmt)}</text>
    `;

    // Investment points circles
    const investDotsSvg = investPoints.map((p) => `
      <circle cx="${p.x}" cy="${p.y}" r="4" fill="#3b82f6" stroke="#ffffff" stroke-width="1.5"></circle>
    `).join('');

    svgTimelineChart.innerHTML = `
      <defs>
        <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.25"></stop>
          <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.01"></stop>
        </linearGradient>
      </defs>
      ${gridLinesSvg}
      <path d="${areaD}" fill="url(#areaGrad)"></path>
      <path d="${pathD}" fill="none" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
      ${investDotsSvg}
      ${maturitySvg}
      ${xLabelsSvg}
      <line id="hover-line" x1="0" y1="${padT}" x2="0" y2="${padT + chartH}" stroke="#64748b" stroke-width="1" stroke-dasharray="2 2" class="hidden"></line>
    `;
  }

  // Interactive Hover Tooltip for SVG Chart
  svgTimelineChart.addEventListener('mousemove', (e) => {
    if (currentChartPoints.length === 0) return;
    const rect = svgTimelineChart.getBoundingClientRect();
    const clientX = e.clientX - rect.left;
    const scaleX = 700 / rect.width;
    const svgX = clientX * scaleX;

    // Find closest data point
    let closest = currentChartPoints[0];
    let minDist = Math.abs(currentChartPoints[0].x - svgX);

    for (let i = 1; i < currentChartPoints.length; i++) {
      const dist = Math.abs(currentChartPoints[i].x - svgX);
      if (dist < minDist) {
        minDist = dist;
        closest = currentChartPoints[i];
      }
    }

    const hoverLine = document.getElementById('hover-line');
    if (hoverLine) {
      hoverLine.setAttribute('x1', String(closest.x));
      hoverLine.setAttribute('x2', String(closest.x));
      hoverLine.classList.remove('hidden');
    }

    // Position tooltip
    const tooltipX = (closest.x / 700) * rect.width;
    const tooltipY = Math.max(10, (closest.y / 280) * rect.height - 70);

    chartTooltip.style.left = `${Math.min(rect.width - 150, Math.max(10, tooltipX - 60))}px`;
    chartTooltip.style.top = `${tooltipY}px`;
    chartTooltip.innerHTML = `
      <div class="font-bold text-slate-300">${closest.date}</div>
      <div class="font-black ${closest.type === 'maturity' ? 'text-emerald-400' : 'text-blue-400'}">
        ${closest.label}: ${closest.amount < 0 ? formatINR(closest.amount) : '+' + formatINR(closest.amount)}
      </div>
      <div class="text-[10px] text-slate-400">
        Cumulative Invested: <strong>${formatINR(closest.cumulative)}</strong>
      </div>
    `;
    chartTooltip.classList.remove('hidden');
  });

  svgTimelineChart.addEventListener('mouseleave', () => {
    chartTooltip.classList.add('hidden');
    const hoverLine = document.getElementById('hover-line');
    if (hoverLine) hoverLine.classList.add('hidden');
  });

  // ─────────────────────────────────────────────────────────────────────────
  // ON-DEMAND RECURRING CALCULATION (Executes on Calculate Button Click)
  // ─────────────────────────────────────────────────────────────────────────
  function executeRecurringXirrCalculation() {
    errRecXirr.classList.add('hidden');

    const startStr = inpRecStart.value;
    const endStr = inpRecEnd.value;
    const recAmt = parseFloat(inpRecAmt.value);
    const matAmt = parseFloat(inpRecMat.value);

    if (!startStr) {
      errRecXirr.textContent = 'Please select a valid Start Date.';
      errRecXirr.classList.remove('hidden');
      return;
    }
    if (!endStr) {
      errRecXirr.textContent = 'Please select a valid Maturity Date.';
      errRecXirr.classList.remove('hidden');
      return;
    }
    if (endStr <= startStr) {
      errRecXirr.textContent = 'Maturity Date must be strictly after the Start Date.';
      errRecXirr.classList.remove('hidden');
      return;
    }
    if (isNaN(recAmt) || recAmt <= 0) {
      errRecXirr.textContent = 'Recurring Investment Amount must be greater than zero.';
      errRecXirr.classList.remove('hidden');
      return;
    }
    if (isNaN(matAmt) || matAmt <= 0) {
      errRecXirr.textContent = 'Total Maturity Amount must be greater than zero.';
      errRecXirr.classList.remove('hidden');
      return;
    }

    try {
      const res = calculateRecurringXirr({
        frequency: selectedFrequency,
        startDate: startStr,
        maturityDate: endStr,
        recurringAmount: recAmt,
        maturityAmount: matAmt,
      });

      if (!res.converged || res.xirrPercent === null) {
        errRecXirr.textContent = res.errorMessage || 'Unable to converge on a valid rate of return.';
        errRecXirr.classList.remove('hidden');
        return;
      }

      // Populate Main Metrics
      resRecXirr.textContent = `${res.xirrPercent.toFixed(2)}% p.a.`;
      const isProfit = res.netProfit >= 0;
      resRecProfit.textContent = `${isProfit ? '+' : ''}${formatINR(res.netProfit)}`;
      resRecProfit.className = `text-2xl sm:text-3xl font-black ${isProfit ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`;

      resRecInvested.textContent = formatINR(res.totalInvested);
      resRecMaturity.textContent = formatINR(res.maturityAmount);
      resRecAbsReturn.textContent = `${res.absoluteReturnPercent >= 0 ? '+' : ''}${res.absoluteReturnPercent.toFixed(1)}%`;
      resRecCount.textContent = `${res.investmentCount} Installments`;
      resRecFreq.textContent = res.frequencyLabel || 'Yearly';
      resRecTenure.textContent = `${res.durationYears} Years (${res.durationDays} Days)`;

      // Populate Table
      tbodyRecSchedule.innerHTML = res.cashFlows.map((cf) => {
        const isMat = cf.type === 'maturity';
        return `
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
            <td class="p-2.5 font-bold text-slate-800 dark:text-slate-200">${cf.index}</td>
            <td class="p-2.5 text-slate-700 dark:text-slate-300">${cf.date}</td>
            <td class="p-2.5">
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold ${
                isMat
                  ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300'
                  : 'bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300'
              }">
                ${isMat ? 'Maturity Inflow' : 'Investment Outflow'}
              </span>
            </td>
            <td class="p-2.5 text-right font-bold ${isMat ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}">
              ${isMat ? '+' + formatINR(cf.amount) : formatINR(cf.amount)}
            </td>
            <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">
              ${formatINR(cf.cumulativeInvested || 0)}
            </td>
          </tr>
        `;
      }).join('');

      recResultsSection.classList.remove('hidden');
      recResultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (err: any) {
      errRecXirr.textContent = err.message || 'An error occurred during calculation.';
      errRecXirr.classList.remove('hidden');
    }
  }

  btnCalcRecXirr.addEventListener('click', executeRecurringXirrCalculation);

  btnClearRecXirr.addEventListener('click', () => {
    inpRecStart.value = '2021-01-01';
    inpRecEnd.value = '2024-01-01';
    inpRecAmt.value = '10000';
    inpRecMat.value = '60000';
    selectedFrequency = 'yearly';
    freqButtons.forEach((b) => {
      b.className = 'btn-freq-opt rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer text-center';
      if (b.getAttribute('data-freq') === 'yearly') {
        b.className = 'btn-freq-opt active rounded-lg py-2 text-xs font-bold transition-all bg-white text-blue-600 shadow-2xs dark:bg-slate-700 dark:text-blue-400 cursor-pointer text-center';
      }
    });
    hintFreqDesc.textContent = FREQ_DESCRIPTIONS['yearly'];
    handleRecurringInputModified();
  });

  // ─────────────────────────────────────────────────────────────────────────
  // TAB 2: CUSTOM CASH FLOW LOGIC
  // ─────────────────────────────────────────────────────────────────────────
  const tbodyCustomCfs = document.getElementById('tbody-custom-cfs') as HTMLTableSectionElement;
  const btnAddCustomCf = document.getElementById('btn-add-custom-cf') as HTMLButtonElement;
  const btnCalcCustomXirr = document.getElementById('btn-calc-custom-xirr') as HTMLButtonElement;
  const btnClearCustomCfs = document.getElementById('btn-clear-custom-cfs') as HTMLButtonElement;
  const errCustomXirr = document.getElementById('err-custom-xirr') as HTMLParagraphElement;

  const customResultsSection = document.getElementById('custom-results-section') as HTMLDivElement;
  const resCustomXirr = document.getElementById('res-custom-xirr') as HTMLDivElement;
  const resCustomProfit = document.getElementById('res-custom-profit') as HTMLDivElement;
  const resCustomInvested = document.getElementById('res-custom-invested') as HTMLDivElement;
  const resCustomMaturity = document.getElementById('res-custom-maturity') as HTMLDivElement;
  const resCustomAbsReturn = document.getElementById('res-custom-abs-return') as HTMLDivElement;
  const resCustomTenure = document.getElementById('res-custom-tenure') as HTMLDivElement;

  interface CustomRowData {
    id: string;
    date: string;
    type: 'outflow' | 'inflow';
    amount: number;
  }

  let customRows: CustomRowData[] = [
    { id: 'cf-1', date: '2022-01-01', type: 'outflow', amount: 50000 },
    { id: 'cf-2', date: '2023-01-01', type: 'outflow', amount: 50000 },
    { id: 'cf-3', date: '2024-01-01', type: 'inflow', amount: 130000 },
  ];

  function renderCustomRows() {
    tbodyCustomCfs.innerHTML = customRows.map((row, idx) => `
      <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50" data-id="${row.id}">
        <td class="p-2.5 font-bold text-slate-800 dark:text-slate-200">${idx + 1}</td>
        <td class="p-2.5">
          <input
            type="date"
            value="${row.date}"
            class="input-custom-date w-full rounded-lg border border-slate-300 bg-white py-1 px-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
          />
        </td>
        <td class="p-2.5">
          <select class="select-custom-type rounded-lg border border-slate-300 bg-white py-1 px-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
            <option value="outflow" ${row.type === 'outflow' ? 'selected' : ''}>Outflow (-)</option>
            <option value="inflow" ${row.type === 'inflow' ? 'selected' : ''}>Inflow (+)</option>
          </select>
        </td>
        <td class="p-2.5">
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-2 text-xs font-bold text-slate-400">₹</span>
            <input
              type="number"
              value="${row.amount}"
              step="500"
              min="1"
              class="input-custom-amount w-full rounded-lg border border-slate-300 bg-white py-1 pl-6 pr-2 text-right text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
          </div>
        </td>
        <td class="p-2.5 text-center">
          <button
            type="button"
            class="btn-delete-row text-red-500 hover:text-red-700 p-1 text-sm font-bold cursor-pointer"
            title="Delete Cash Flow"
          >
            ✕
          </button>
        </td>
      </tr>
    `).join('');

    // Attach row events
    tbodyCustomCfs.querySelectorAll('tr').forEach((tr, index) => {
      const dateInp = tr.querySelector('.input-custom-date') as HTMLInputElement;
      const typeSel = tr.querySelector('.select-custom-type') as HTMLSelectElement;
      const amtInp = tr.querySelector('.input-custom-amount') as HTMLInputElement;
      const delBtn = tr.querySelector('.btn-delete-row') as HTMLButtonElement;

      dateInp.addEventListener('change', () => {
        customRows[index].date = dateInp.value;
        customResultsSection.classList.add('hidden');
      });

      typeSel.addEventListener('change', () => {
        customRows[index].type = typeSel.value as 'outflow' | 'inflow';
        customResultsSection.classList.add('hidden');
      });

      amtInp.addEventListener('input', () => {
        customRows[index].amount = parseFloat(amtInp.value) || 0;
        customResultsSection.classList.add('hidden');
      });

      delBtn.addEventListener('click', () => {
        if (customRows.length <= 2) {
          errCustomXirr.textContent = 'At least two cash flows (one outflow and one inflow) are required.';
          errCustomXirr.classList.remove('hidden');
          return;
        }
        customRows.splice(index, 1);
        renderCustomRows();
        customResultsSection.classList.add('hidden');
      });
    });
  }

  btnAddCustomCf.addEventListener('click', () => {
    const lastDate = customRows.length > 0 ? customRows[customRows.length - 1].date : '2024-01-01';
    const nextParts = lastDate.split('-').map(Number);
    const nextYear = nextParts[0] + 1;
    const nextDateStr = `${nextYear}-${String(nextParts[1]).padStart(2, '0')}-${String(nextParts[2]).padStart(2, '0')}`;

    customRows.push({
      id: `cf-${Date.now()}`,
      date: nextDateStr,
      type: 'inflow',
      amount: 50000,
    });
    renderCustomRows();
    customResultsSection.classList.add('hidden');
  });

  btnClearCustomCfs.addEventListener('click', () => {
    customRows = [
      { id: 'cf-1', date: '2022-01-01', type: 'outflow', amount: 50000 },
      { id: 'cf-2', date: '2023-01-01', type: 'outflow', amount: 50000 },
      { id: 'cf-3', date: '2024-01-01', type: 'inflow', amount: 130000 },
    ];
    renderCustomRows();
    customResultsSection.classList.add('hidden');
    errCustomXirr.classList.add('hidden');
  });

  document.getElementById('btn-custom-preset-sip')?.addEventListener('click', () => {
    customRows = [
      { id: 'cf-1', date: '2021-01-01', type: 'outflow', amount: 10000 },
      { id: 'cf-2', date: '2022-01-01', type: 'outflow', amount: 10000 },
      { id: 'cf-3', date: '2023-01-01', type: 'outflow', amount: 10000 },
      { id: 'cf-4', date: '2024-01-01', type: 'inflow', amount: 60000 },
    ];
    renderCustomRows();
    executeCustomXirrCalculation();
  });

  document.getElementById('btn-custom-preset-trade')?.addEventListener('click', () => {
    customRows = [
      { id: 'cf-1', date: '2022-03-15', type: 'outflow', amount: 50000 },
      { id: 'cf-2', date: '2022-08-20', type: 'outflow', amount: 30000 },
      { id: 'cf-3', date: '2023-01-10', type: 'outflow', amount: 20000 },
      { id: 'cf-4', date: '2023-11-05', type: 'inflow', amount: 145000 },
    ];
    renderCustomRows();
    executeCustomXirrCalculation();
  });

  function executeCustomXirrCalculation() {
    errCustomXirr.classList.add('hidden');

    if (customRows.length < 2) {
      errCustomXirr.textContent = 'Please provide at least two cash flow entries.';
      errCustomXirr.classList.remove('hidden');
      return;
    }

    const items: CashFlowItem[] = customRows.map((r) => ({
      date: r.date,
      amount: r.type === 'outflow' ? -Math.abs(r.amount) : Math.abs(r.amount),
      type: r.type,
    }));

    try {
      const res = calculateCustomXirr(items);

      if (!res.converged || res.xirrPercent === null) {
        errCustomXirr.textContent = res.errorMessage || 'Calculation could not converge on a valid rate of return.';
        errCustomXirr.classList.remove('hidden');
        return;
      }

      resCustomXirr.textContent = `${res.xirrPercent.toFixed(2)}% p.a.`;
      const isProfit = res.netProfit >= 0;
      resCustomProfit.textContent = `${isProfit ? '+' : ''}${formatINR(res.netProfit)}`;
      resCustomProfit.className = `text-2xl sm:text-3xl font-black ${isProfit ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`;

      resCustomInvested.textContent = formatINR(res.totalInvested);
      resCustomMaturity.textContent = formatINR(res.maturityAmount);
      resCustomAbsReturn.textContent = `${res.absoluteReturnPercent >= 0 ? '+' : ''}${res.absoluteReturnPercent.toFixed(1)}%`;
      resCustomTenure.textContent = `${res.durationYears} Years (${res.durationDays} Days)`;

      customResultsSection.classList.remove('hidden');
      customResultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (err: any) {
      errCustomXirr.textContent = err.message || 'Error occurred during calculation.';
      errCustomXirr.classList.remove('hidden');
    }
  }

  btnCalcCustomXirr.addEventListener('click', executeCustomXirrCalculation);

  // Initial setup
  renderLiveChart();
  renderCustomRows();
</script>
