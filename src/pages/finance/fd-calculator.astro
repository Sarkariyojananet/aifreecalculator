---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="FD Calculator – Fixed Deposit Maturity & Interest Calculator"
  description="Calculate Fixed Deposit maturity amount, total interest earned, effective yield, and quarterly/monthly compounding for SBI, HDFC, ICICI, and all banks."
  category="Finance"
  calculatorName="FD Calculator"
  slug="fd-calculator"
  keywords={[
    'fd calculator',
    'fixed deposit calculator',
    'fd calculator india',
    'fd interest calculator',
    'fd maturity calculator',
    'sbi fd calculator',
    'hdfc fd calculator',
    'fd calculator monthly',
    'fixed deposit interest rate',
    'fd calculator online'
  ]}
>
  <div class="space-y-6">

    <!-- MODE TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-fd-tab active shrink-0 rounded-lg bg-blue-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="simple">Simple / Cumulative FD</button>
        <button type="button" class="btn-fd-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="compare">Compare 3 Banks ⚖️</button>
        <button type="button" class="btn-fd-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="senior">Senior Citizen FD 👴</button>
        <button type="button" class="btn-fd-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tax">Tax on FD Interest 💰</button>
      </div>
    </div>

    <!-- QUICK PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1"><span>⚡</span> Presets:</span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-p="100000" data-r="7.1" data-t="1" data-c="quarterly">🏦 SBI 1Yr ₹1L @ 7.1%</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-p="500000" data-r="7.5" data-t="3" data-c="quarterly">💎 ₹5L @ 7.5%, 3 Yrs</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-p="1000000" data-r="7.25" data-t="5" data-c="quarterly">🔒 Tax Saver ₹10L @ 7.25%, 5Y</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-p="250000" data-r="8.0" data-t="2" data-c="quarterly">🌟 Small Finance @ 8%, 2Y</button>
      </div>
    </div>

    <!-- Related Savings Schemes Strip -->
    <div class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-slate-200/90 bg-white p-3 px-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900 text-xs">
      <span class="font-bold text-slate-600 dark:text-slate-400">Explore Related Savings:</span>
      <div class="flex flex-wrap gap-2">
        <a href="/finance/rd-calculator/" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-semibold text-slate-700 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">🏦 RD Calculator →</a>
        <a href="/finance/epf-calculator/" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-semibold text-slate-700 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">💼 EPF / PF Calculator →</a>
        <a href="/finance/sukanya-samriddhi-yojana-calculator/" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 font-semibold text-slate-700 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">👧 Sukanya Samriddhi (SSY) →</a>
      </div>
    </div>

    <!-- MAIN PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">

      <!-- SIMPLE FD PANEL -->
      <div id="panel-simple" class="fd-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>🏦</span> Fixed Deposit Calculator</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Enter principal, interest rate, and tenure to calculate FD maturity amount and total interest earned.</p>
        </div>

        <form id="form-fd-simple" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="fd-principal" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Principal Amount (₹)</label>
              <input type="number" id="fd-principal" value="100000" step="1000" min="1000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="fd-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Annual Interest Rate (%)</label>
              <input type="number" id="fd-rate" value="7.1" step="0.05" min="0.1" max="20" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="fd-tenure" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Tenure</label>
              <div class="flex gap-2 mt-1.5">
                <input type="number" id="fd-tenure" value="1" step="1" min="1" class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <select id="fd-tenure-unit" class="w-28 rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">
                  <option value="years" selected>Years</option>
                  <option value="months">Months</option>
                  <option value="days">Days</option>
                </select>
              </div>
            </div>
            <div>
              <label for="fd-compound" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Compounding Frequency</label>
              <select id="fd-compound" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="quarterly" selected>Quarterly (Most Banks)</option>
                <option value="monthly">Monthly</option>
                <option value="annually">Annually</option>
                <option value="simple">Simple Interest (No Compounding)</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-fd-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">Calculate FD Maturity →</button>
            <button type="button" id="btn-fd-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
          <p id="err-fd" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert"></p>
        </form>
      </div>

      <!-- COMPARE BANKS PANEL -->
      <div id="panel-compare" class="fd-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>⚖️</span> Compare FD Rates Across 3 Banks</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Enter the same principal with different bank interest rates to find the best FD offer.</p>
        </div>
        <form id="form-fd-compare" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 space-y-2">
              <span class="text-xs font-bold text-blue-600 dark:text-blue-400">🏦 Bank A</span>
              <input type="number" id="cmp-a-p" value="100000" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Principal ₹" />
              <input type="number" id="cmp-a-r" value="7.1" step="0.1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Rate % (e.g. SBI 7.1)" />
              <input type="number" id="cmp-a-t" value="1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Tenure (Years)" />
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 space-y-2">
              <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">🏦 Bank B</span>
              <input type="number" id="cmp-b-p" value="100000" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Principal ₹" />
              <input type="number" id="cmp-b-r" value="7.5" step="0.1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Rate %" />
              <input type="number" id="cmp-b-t" value="1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Tenure (Years)" />
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 space-y-2">
              <span class="text-xs font-bold text-purple-600 dark:text-purple-400">🏦 Bank C</span>
              <input type="number" id="cmp-c-p" value="100000" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Principal ₹" />
              <input type="number" id="cmp-c-r" value="8.0" step="0.1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Rate %" />
              <input type="number" id="cmp-c-t" value="1" class="w-full rounded-xl border border-slate-300 p-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800" placeholder="Tenure (Years)" />
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="submit" id="btn-compare-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">Compare Banks →</button>
            <button type="button" id="btn-compare-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
        </form>
      </div>

      <!-- SENIOR CITIZEN PANEL -->
      <div id="panel-senior" class="fd-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>👴</span> Senior Citizen FD Calculator</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Senior citizens (60+ years) get an additional 0.25%–0.50% interest rate on most bank FDs. Calculate your extra benefit here.</p>
        </div>
        <form id="form-fd-senior" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div><label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Principal Amount (₹)</label><input type="number" id="sr-principal" value="500000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Regular Rate (%)</label><input type="number" id="sr-rate" value="7.1" step="0.05" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Senior Citizen Extra Rate (%)</label><input type="number" id="sr-extra" value="0.50" step="0.05" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Tenure (Years)</label><input type="number" id="sr-tenure" value="3" step="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
          </div>
          <div class="flex items-center gap-2">
            <button type="submit" id="btn-senior-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">Calculate Senior FD →</button>
            <button type="button" id="btn-senior-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
        </form>
      </div>

      <!-- TAX ON FD PANEL -->
      <div id="panel-tax" class="fd-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>💰</span> Tax on FD Interest Calculator</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">FD interest is taxable as per your income tax slab. TDS is deducted at 10% if annual interest exceeds ₹40,000 (₹50,000 for senior citizens).</p>
        </div>
        <form id="form-fd-tax" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div><label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Annual FD Interest Earned (₹)</label><input type="number" id="tax-interest" value="75000" step="1000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Your Tax Slab</label>
              <select id="tax-slab" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="0">0% – No Tax (&lt; ₹3L)</option>
                <option value="5">5% – (₹3L – ₹7L)</option>
                <option value="10">10% – (₹7L – ₹10L)</option>
                <option value="15">15% – (₹10L – ₹12L)</option>
                <option value="20">20% – (₹12L – ₹15L)</option>
                <option value="30" selected>30% – (&gt; ₹15L)</option>
              </select>
            </div>
            <div><label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Senior Citizen (60+)?</label>
              <select id="tax-senior" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="no" selected>No (TDS limit: ₹40,000)</option>
                <option value="yes">Yes (TDS limit: ₹50,000)</option>
              </select>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button type="submit" id="btn-tax-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">Calculate Tax on FD →</button>
            <button type="button" id="btn-tax-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
          </div>
        </form>
      </div>

      <!-- RESULTS SECTION -->
      <div id="fd-results" class="hidden mt-6 space-y-5">
        <!-- Hero Card -->
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="res-fd-badge" class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Maturity Amount</span>
              <div id="res-fd-maturity" class="mt-1 text-4xl sm:text-5xl font-black text-blue-600 dark:text-blue-400">₹1,07,271</div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Interest Earned:</span>
              <div id="res-fd-interest" class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400">₹7,271</div>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Principal</div>
              <div id="res-fd-principal" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">₹1,00,000</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Rate / Compounding</div>
              <div id="res-fd-rate-info" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">7.1% / Quarterly</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Effective Yield</div>
              <div id="res-fd-yield" class="mt-1 text-sm font-bold text-purple-600 dark:text-purple-400">7.27%</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Tenure</div>
              <div id="res-fd-tenure" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">1 Year</div>
            </div>
          </div>
        </div>

        <!-- Visual Breakdown -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-1.5"><span>📊</span> Principal vs Interest Breakdown</h3>
          <div class="flex flex-col sm:flex-row items-center justify-around gap-6">
            <div class="relative w-40 h-40 flex items-center justify-center">
              <svg viewBox="0 0 36 36" class="w-full h-full transform -rotate-90">
                <circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="3.8"></circle>
                <circle id="fd-donut-interest" cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="3.8" stroke-dasharray="7 93" stroke-dashoffset="0"></circle>
              </svg>
              <div class="absolute text-center">
                <span class="text-[11px] font-bold text-slate-400 block">RETURN</span>
                <span id="fd-donut-center" class="text-xs font-black text-slate-800 dark:text-slate-200">7.3%</span>
              </div>
            </div>
            <div class="space-y-3 text-xs w-full sm:w-auto">
