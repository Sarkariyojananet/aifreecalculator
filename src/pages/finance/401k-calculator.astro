<script is:inline>
  function fmt401k(n) {
    return "$" + Math.round(n).toLocaleString("en-US");
  }

  function calc401k() {
    const curAge = parseInt(document.getElementById("k-cur-age").value) || 30;
    const retAge = parseInt(document.getElementById("k-ret-age").value) || 65;
    const curBal = parseFloat(document.getElementById("k-cur-bal").value) || 0;
    let salary = parseFloat(document.getElementById("k-salary").value) || 80000;
    const contribPct =
      (parseFloat(document.getElementById("k-contrib-pct").value) || 8) / 100;
    const returnRate =
      (parseFloat(document.getElementById("k-return").value) || 7.5) / 100;
    const matchPct =
      (parseFloat(document.getElementById("k-match-pct").value) || 50) / 100;
    const matchCap =
      (parseFloat(document.getElementById("k-match-cap").value) || 6) / 100;
    const salGrowth =
      (parseFloat(document.getElementById("k-sal-growth").value) || 2.5) / 100;

    const years = Math.max(1, retAge - curAge);
    const months = years * 12;
    const monthlyRate = returnRate / 12;

    // Update annual contribution preview text
    const initAnnualCont = salary * contribPct;
    document.getElementById("k-contrib-dollars").textContent =
      `(${fmt401k(initAnnualCont)}/yr)`;

    let balance = curBal;
    let totalEmployeePrincipal = 0;
    let totalEmployerMatch = 0;

    for (let yr = 0; yr < years; yr++) {
      const ageNow = curAge + yr;
      // 2025 IRS Deferral limit: $23,500 under 50, $31,000 age 50+
      const irsLimit = ageNow >= 50 ? 31000 : 23500;

      // Employee annual contribution
      let empAnnual = salary * contribPct;
      if (empAnnual > irsLimit) empAnnual = irsLimit;

      // Employer match
      // Matches matchPct of employee contribution up to matchCap of salary
      const eligibleSalary = Math.min(salary * matchCap, empAnnual);
      const matchAnnual = eligibleSalary * matchPct;

      const monthlyEmp = empAnnual / 12;
      const monthlyMatch = matchAnnual / 12;
      const monthlyTotal = monthlyEmp + monthlyMatch;

      for (let m = 0; m < 12; m++) {
        balance = balance * (1 + monthlyRate) + monthlyTotal;
      }

      totalEmployeePrincipal += empAnnual;
      totalEmployerMatch += matchAnnual;
      salary *= 1 + salGrowth;
    }

    const totalContributions =
      curBal + totalEmployeePrincipal + totalEmployerMatch;
    const totalGrowth = Math.max(0, balance - totalContributions);
    const monthlyRetirementIncome = (balance * 0.04) / 12; // 4% rule monthly
    const annual4pct = balance * 0.04;

    // Update Hero UI
    document.getElementById("k-res-total").textContent = fmt401k(balance);
    document.getElementById("k-res-sub").textContent =
      `At age ${retAge} after ${years} years of compounding`;
    document.getElementById("k-res-principal").textContent = fmt401k(
      curBal + totalEmployeePrincipal,
    );
    document.getElementById("k-res-match").textContent =
      fmt401k(totalEmployerMatch);
    document.getElementById("k-res-growth").textContent = fmt401k(totalGrowth);
    document.getElementById("k-res-monthly").textContent =
      fmt401k(monthlyRetirementIncome) + "/mo";

    // Summary breakdown
    document.getElementById("k-summary-cont").textContent = fmt401k(
      curBal + totalEmployeePrincipal,
    );
    document.getElementById("k-summary-match").textContent =
      fmt401k(totalEmployerMatch);
    document.getElementById("k-summary-growth").textContent =
      fmt401k(totalGrowth);
    document.getElementById("k-summary-4pct").textContent =
      fmt401k(annual4pct) + " / yr";

    const growthRatio = Math.round((totalGrowth / balance) * 100) || 0;
    document.getElementById("k-res-growth-ratio").textContent =
      `${growthRatio}% from Growth`;

    // Bar ratios
    const pPct = Math.max(
      5,
      Math.round(((curBal + totalEmployeePrincipal) / balance) * 100),
    );
    const mPct = Math.max(3, Math.round((totalEmployerMatch / balance) * 100));
    const gPct = Math.max(5, 100 - pPct - mPct);
    document.getElementById("k-bar-prin").style.width = pPct + "%";
    document.getElementById("k-bar-match").style.width = mPct + "%";
    document.getElementById("k-bar-growth").style.width = gPct + "%";
  }

  function updateContribPreview() {
    const salary = parseFloat(document.getElementById("k-salary")?.value) || 0;
    const contribPct =
      (parseFloat(document.getElementById("k-contrib-pct")?.value) || 0) / 100;
    const initAnnualCont = salary * contribPct;
    const el = document.getElementById("k-contrib-dollars");
    if (el) el.textContent = `(${fmt401k(initAnnualCont)}/yr)`;
  }

  function execute401k() {
    const errEl = document.getElementById("err-401k");
    const resultsEl = document.getElementById("k-results-section");
    if (errEl) {
      errEl.classList.add("hidden");
      errEl.textContent = "";
    }

    const curAge = parseInt(document.getElementById("k-cur-age")?.value);
    const retAge = parseInt(document.getElementById("k-ret-age")?.value);
    const salary = parseFloat(document.getElementById("k-salary")?.value);

    if (isNaN(curAge) || curAge < 18 || curAge > 100) {
      if (errEl) {
        errEl.textContent =
          "Please enter a valid current age (between 18 and 100).";
        errEl.classList.remove("hidden");
      }
      if (resultsEl) resultsEl.classList.add("hidden");
      const bar = document.getElementById("calc-action-bar-container");
      if (bar) bar.classList.add("hidden");
      return;
    }

    if (isNaN(retAge) || retAge <= curAge || retAge > 100) {
      if (errEl) {
        errEl.textContent =
          "Retirement age must be greater than current age (e.g. 65).";
        errEl.classList.remove("hidden");
      }
      if (resultsEl) resultsEl.classList.add("hidden");
      const bar = document.getElementById("calc-action-bar-container");
      if (bar) bar.classList.add("hidden");
      return;
    }

    if (isNaN(salary) || salary <= 0) {
      if (errEl) {
        errEl.textContent = "Please enter a valid positive annual salary.";
        errEl.classList.remove("hidden");
      }
      if (resultsEl) resultsEl.classList.add("hidden");
      const bar = document.getElementById("calc-action-bar-container");
      if (bar) bar.classList.add("hidden");
      return;
    }

    calc401k();
    if (resultsEl) {
      resultsEl.classList.remove("hidden");
      resultsEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    // Reveal and sync "Save or share this calculation" action bar
    const bar = document.getElementById("calc-action-bar-container");
    if (bar) {
      bar.classList.remove("hidden");
    }
    try {
      document.dispatchEvent(new CustomEvent("calculator:updated"));
    } catch (e) {}
  }

  function clear401k() {
    document.getElementById("k-cur-age").value = "30";
    document.getElementById("k-ret-age").value = "65";
    document.getElementById("k-cur-bal").value = "25000";
    document.getElementById("k-salary").value = "80000";
    document.getElementById("k-contrib-pct").value = "8";
    document.getElementById("k-return").value = "7.5";
    document.getElementById("k-match-pct").value = "50";
    document.getElementById("k-match-cap").value = "6";
    document.getElementById("k-sal-growth").value = "2.5";

    updateContribPreview();

    const errEl = document.getElementById("err-401k");
    if (errEl) {
      errEl.classList.add("hidden");
      errEl.textContent = "";
    }

    const resultsEl = document.getElementById("k-results-section");
    if (resultsEl) {
      resultsEl.classList.add("hidden");
    }

    // Hide "Save or share this calculation" action bar
    const bar = document.getElementById("calc-action-bar-container");
    if (bar) {
      bar.classList.add("hidden");
    }
    try {
      document.dispatchEvent(new CustomEvent("calculator:updated"));
    } catch (e) {}
  }

  document.addEventListener("DOMContentLoaded", () => {
    updateContribPreview();

    // Calculate button
    const btnCalc = document.getElementById("btn-calc-401k");
    if (btnCalc) {
      btnCalc.addEventListener("click", (e) => {
        e.preventDefault();
        execute401k();
      });
    }

    // Clear button
    const btnClear = document.getElementById("btn-clear-401k");
    if (btnClear) {
      btnClear.addEventListener("click", (e) => {
        e.preventDefault();
        clear401k();
      });
    }

    // Update contribution preview on salary or percentage change
    ["k-salary", "k-contrib-pct"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener("input", updateContribPreview);
      }
    });

    // Enter key triggers calculation
    const form = document.getElementById("form-401k");
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        execute401k();
      });
      form.querySelectorAll("input").forEach((inp) => {
        inp.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            execute401k();
          }
        });
      });
    }

    // Preset buttons
    document.querySelectorAll(".btn-401k-preset").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.getElementById("k-cur-age").value = btn.dataset.age;
        document.getElementById("k-ret-age").value = btn.dataset.ret;
        document.getElementById("k-cur-bal").value = btn.dataset.bal;
        document.getElementById("k-salary").value = btn.dataset.sal;
        document.getElementById("k-contrib-pct").value = btn.dataset.cont;
        document.getElementById("k-match-pct").value = btn.dataset.match;
        document.getElementById("k-match-cap").value = btn.dataset.cap;
        document.getElementById("k-return").value = btn.dataset.retn;
        updateContribPreview();
        execute401k();
      });
    });

    // Tab buttons
    document.querySelectorAll(".btn-401k-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTab = btn.dataset.tab;
        document.querySelectorAll(".btn-401k-tab").forEach((b) => {
          if (b === btn) {
            b.className =
              "btn-401k-tab active shrink-0 rounded-lg bg-blue-700 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer";
          } else {
            b.className =
              "btn-401k-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer";
          }
        });

        document.querySelectorAll(".tab-401k-panel").forEach((p) => {
          if (p.id === "panel-401k-" + targetTab) {
            p.classList.remove("hidden");
          } else {
            p.classList.add("hidden");
          }
        });

        const bar = document.getElementById("calc-action-bar-container");
        if (bar) {
          const resultsEl = document.getElementById("k-results-section");
          if (
            targetTab === "growth" &&
            resultsEl &&
            !resultsEl.classList.contains("hidden")
          ) {
            bar.classList.remove("hidden");
          } else {
            bar.classList.add("hidden");
          }
        }
      });
    });
  });
</script>
