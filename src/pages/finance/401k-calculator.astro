---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
---

<CalculatorLayout
  title="401(k) Calculator – 2025 Retirement Growth & Employer Match Calculator"
  description="Calculate your 401(k) balance at retirement with employer match, compound investment growth, 2025 IRS contribution limits ($23,500), and projected monthly retirement income."
  category="Finance"
  calculatorName="401(k) Calculator"
  slug="401k-calculator"
  keywords={[
    "401k calculator",
    "401k retirement calculator",
    "401k employer match calculator",
    "401k growth calculator",
    "401k contribution calculator",
    "roth 401k vs traditional 401k",
    "401k limits 2025",
    "401k compound interest calculator",
  ]}
>
  <div class="space-y-6">
    <!-- TABS -->
    <div
      class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900"
    >
      <div
        class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin"
      >
        <button
          type="button"
          class="btn-401k-tab active shrink-0 rounded-lg bg-blue-700 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer"
          data-tab="growth">401(k) Growth & Match</button
        >
        <button
          type="button"
          class="btn-401k-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
          data-tab="compare">Traditional vs Roth 401(k) ⚖️</button
        >
        <button
          type="button"
          class="btn-401k-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
          data-tab="limits">2025 IRS Limits 📋</button
        >
      </div>
    </div>

    <!-- PRESETS -->
    <div
      class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900"
    >
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1"
          >⚡ Quick Scenarios:</span
        >
        <button
          type="button"
          class="btn-401k-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
          data-age="25"
          data-ret="65"
          data-bal="5000"
          data-sal="55000"
          data-cont="6"
          data-match="50"
          data-cap="6"
          data-retn="8">💼 Early Career: 25 yo, $55k, 6%</button
        >
        <button
          type="button"
          class="btn-401k-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
          data-age="35"
          data-ret="65"
          data-bal="65000"
          data-sal="95000"
          data-cont="10"
          data-match="100"
          data-cap="4"
          data-retn="7.5">📈 Mid Career: 35 yo, $95k, 10%</button
        >
        <button
          type="button"
          class="btn-401k-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
          data-age="45"
          data-ret="65"
          data-bal="250000"
          data-sal="150000"
          data-cont="15.6"
          data-match="50"
          data-cap="6"
          data-retn="7">🎯 Max Contrib: 45 yo, $150k, Max</button
        >
        <button
          type="button"
          class="btn-401k-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer"
          data-age="52"
          data-ret="67"
          data-bal="400000"
          data-sal="130000"
          data-cont="23.8"
          data-match="50"
          data-cap="5"
          data-retn="6.5">👴 Catch-up 50+: 52 yo, $31k Max</button
        >
      </div>
    </div>

    <!-- MAIN PANEL -->
    <div
      class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-blue-50/20 to-indigo-50/20 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/10 sm:p-7"
    >
      <!-- TAB 1: GROWTH -->
      <div id="panel-401k-growth" class="tab-401k-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2
            class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"
          >
            <span>🇺🇸</span> 401(k) Retirement Growth & Employer Match
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            See how your personal salary contributions, employer matching ("free
            money"), and compound market returns build your retirement nest egg.
          </p>
        </div>

        <form
          id="form-401k"
          class="space-y-4"
          novalidate
          onsubmit="return false;"
        >
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <label
                for="k-cur-age"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                >Current Age</label
              >
              <input
                type="number"
                id="k-cur-age"
                value="30"
                min="18"
                max="75"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
            </div>
            <div>
              <label
                for="k-ret-age"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                >Retirement Age</label
              >
              <input
                type="number"
                id="k-ret-age"
                value="65"
                min="40"
                max="85"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
            </div>
            <div>
              <label
                for="k-cur-bal"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                >Current 401(k) Balance ($)</label
              >
              <input
                type="number"
                id="k-cur-bal"
                value="25000"
                step="1000"
                min="0"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
            </div>
            <div>
              <label
                for="k-salary"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                >Annual Salary ($)</label
              >
              <input
                type="number"
                id="k-salary"
                value="80000"
                step="1000"
                min="10000"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
            </div>
            <div>
              <label
                for="k-contrib-pct"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                >Your Contribution (% of Salary)</label
              >
              <div class="flex items-center gap-2 mt-1.5">
                <input
                  type="number"
                  id="k-contrib-pct"
                  value="8"
                  step="0.5"
                  min="0"
                  max="80"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span
                  id="k-contrib-dollars"
                  class="text-xs font-semibold text-slate-500 whitespace-nowrap dark:text-slate-400"
                  >($6,400/yr)</span
                >
              </div>
            </div>
            <div>
              <label
                for="k-return"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                >Expected Annual Return (%)</label
              >
              <input
                type="number"
                id="k-return"
                value="7.5"
                step="0.1"
                min="1"
                max="15"
                class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
            </div>
          </div>

          <!-- Employer Match Section -->
          <div
            class="rounded-2xl border border-emerald-200/80 bg-emerald-50/40 p-4 dark:border-emerald-900/40 dark:bg-emerald-950/20"
          >
            <h3
              class="text-xs font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5 mb-3"
            >
              <span>🎁</span> Employer Match Settings (Free Money)
            </h3>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div>
                <label
                  for="k-match-pct"
                  class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
                  >Employer Matches (% of your contrib)</label
                >
                <input
                  type="number"
                  id="k-match-pct"
                  value="50"
                  step="5"
                  min="0"
                  max="200"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span class="text-[11px] text-slate-500 dark:text-slate-400"
                  >Typical: 50% or 100%</span
                >
              </div>
              <div>
                <label
                  for="k-match-cap"
                  class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
                  >Up to % of Your Salary</label
                >
                <input
                  type="number"
                  id="k-match-cap"
                  value="6"
                  step="0.5"
                  min="0"
                  max="20"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span class="text-[11px] text-slate-500 dark:text-slate-400"
                  >Typical: 4% to 6%</span
                >
              </div>
              <div>
                <label
                  for="k-sal-growth"
                  class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
                  >Annual Salary Raise (%)</label
                >
                <input
                  type="number"
                  id="k-sal-growth"
                  value="2.5"
                  step="0.5"
                  min="0"
                  max="10"
                  class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span class="text-[11px] text-slate-500 dark:text-slate-400"
                  >Annual merit increase</span
                >
              </div>
            </div>
          </div>

          <!-- ACTION BUTTONS -->
          <div class="flex items-center gap-2 pt-2">
            <button
              type="submit"
              id="btn-calc-401k"
              class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
            >
              Calculate 401(k) →
            </button>
            <button
              type="button"
              id="btn-clear-401k"
              class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Clear (✕)
            </button>
          </div>

          <!-- ACCESSIBLE ERROR -->
          <p
            id="err-401k"
            class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300"
            role="alert"
            aria-live="polite"
          >
          </p>
        </form>

        <!-- RESULTS GRID (Hidden Initially) -->
        <div id="k-results-section" class="hidden pt-2">
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
            <!-- Main Big Card (7 cols) -->
            <div
              class="rounded-3xl bg-linear-to-br from-blue-700 via-indigo-700 to-slate-900 p-6 text-white shadow-xl lg:col-span-7"
            >
              <div
                class="text-xs font-bold uppercase tracking-wider text-blue-200"
              >
                Projected 401(k) Balance at Retirement
              </div>
              <div
                id="k-res-total"
                class="mt-2 text-3xl sm:text-4xl font-black tracking-tight text-white"
              >
                $1,482,920
              </div>
              <div id="k-res-sub" class="mt-1 text-xs text-blue-100">
                At age 65 after 35 years of compounding
              </div>

              <div
                class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 border-t border-white/15 pt-4 text-xs"
              >
                <div>
                  <div class="text-blue-200 font-medium">Your Principal</div>
                  <div
                    id="k-res-principal"
                    class="mt-1 text-sm font-bold text-white"
                  >
                    $325,400
                  </div>
                </div>
                <div>
                  <div class="text-emerald-300 font-medium">Employer Match</div>
                  <div
                    id="k-res-match"
                    class="mt-1 text-sm font-bold text-emerald-300"
                  >
                    $122,025
                  </div>
                </div>
                <div>
                  <div class="text-amber-300 font-medium">Interest & Gains</div>
                  <div
                    id="k-res-growth"
                    class="mt-1 text-sm font-bold text-amber-300"
                  >
                    $1,035,495
                  </div>
                </div>
                <div>
                  <div class="text-blue-200 font-medium">Monthly Income</div>
                  <div
                    id="k-res-monthly"
                    class="mt-1 text-sm font-bold text-white"
                  >
                    $4,943/mo
                  </div>
                </div>
              </div>
            </div>

            <!-- Summary Breakdown Box (5 cols) -->
            <div
              class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 lg:col-span-5 space-y-3 text-xs"
            >
              <h3
                class="font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center justify-between"
              >
                <span>📊 Wealth Breakdown</span>
                <span
                  id="k-res-growth-ratio"
                  class="text-blue-600 dark:text-blue-400 font-bold"
                  >70% from Growth</span
                >
              </h3>

              <!-- Progress Bar -->
              <div
                class="h-4 w-full rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 flex"
              >
                <div
                  id="k-bar-prin"
                  class="bg-blue-600 h-full"
                  style="width: 25%"
                  title="Your Principal"
                >
                </div>
                <div
                  id="k-bar-match"
                  class="bg-emerald-500 h-full"
                  style="width: 10%"
                  title="Employer Match"
                >
                </div>
                <div
                  id="k-bar-growth"
                  class="bg-amber-400 h-full"
                  style="width: 65%"
                  title="Market Growth"
                >
                </div>
              </div>

              <div
                class="space-y-2 pt-2 divide-y divide-slate-100 dark:divide-slate-800"
              >
                <div class="flex justify-between py-1">
                  <span
                    class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5"
                    ><span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span> Your
                    Contributions</span
                  >
                  <span
                    id="k-summary-cont"
                    class="font-bold text-slate-900 dark:text-white"
                    >$325,400</span
                  >
                </div>
                <div class="flex justify-between py-1">
                  <span
                    class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5"
                    ><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"
                    ></span> Employer Match</span
                  >
                  <span
                    id="k-summary-match"
                    class="font-bold text-emerald-600 dark:text-emerald-400"
                    >$122,025</span
                  >
                </div>
                <div class="flex justify-between py-1">
                  <span
                    class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5"
                    ><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Total
                    Compound Growth</span
                  >
                  <span
                    id="k-summary-growth"
                    class="font-bold text-amber-600 dark:text-amber-400"
                    >$1,035,495</span
                  >
                </div>
                <div
                  class="flex justify-between py-1 font-semibold text-slate-700 dark:text-slate-300"
                >
                  <span>Safe Withdrawal Rate (4% Rule)</span>
                  <span
                    id="k-summary-4pct"
                    class="font-bold text-blue-700 dark:text-blue-400"
                    >$59,317 / yr</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 2: TRADITIONAL VS ROTH 401(k) -->
      <div id="panel-401k-compare" class="tab-401k-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2
            class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"
          >
            <span>⚖️</span> Traditional 401(k) vs Roth 401(k)
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Compare tax advantages today vs tax freedom in retirement to find
            out which account type puts more money in your pocket.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Traditional 401(k) -->
          <div
            class="rounded-3xl border-2 border-blue-200 bg-white p-5 dark:border-blue-900/50 dark:bg-slate-900"
          >
            <div class="flex items-center justify-between">
              <h3
                class="text-sm font-black text-blue-700 dark:text-blue-400 uppercase tracking-wider"
              >
                Traditional 401(k)
              </h3>
              <span
                class="rounded-full bg-blue-100 px-2.5 py-0.5 text-[11px] font-bold text-blue-800 dark:bg-blue-900/60 dark:text-blue-200"
                >Pre-Tax</span
              >
            </div>
            <ul
              class="mt-4 space-y-2.5 text-xs text-slate-600 dark:text-slate-300"
            >
              <li class="flex items-start gap-2">
                ✅ <strong>Immediate Tax Break:</strong> Contributions reduce your
                taxable income for the current year.
              </li>
              <li class="flex items-start gap-2">
                ✅ <strong>Higher Take-Home Pay:</strong> Save on income taxes today
                (Federal + State).
              </li>
              <li class="flex items-start gap-2">
                ⚠️ <strong>Taxes in Retirement:</strong> Every dollar withdrawn is
                taxed as ordinary income at your future tax rate.
              </li>
              <li class="flex items-start gap-2">
                ⚠️ <strong>RMDs:</strong> Required Minimum Distributions begin at
                age 73 (SECURE 2.0).
              </li>
              <li class="flex items-start gap-2">
                🎯 <strong>Best For:</strong> High earners today who expect to be
                in a lower tax bracket during retirement.
              </li>
            </ul>
          </div>

          <!-- Roth 401(k) -->
          <div
            class="rounded-3xl border-2 border-emerald-200 bg-white p-5 dark:border-emerald-900/50 dark:bg-slate-900"
          >
            <div class="flex items-center justify-between">
              <h3
                class="text-sm font-black text-emerald-700 dark:text-emerald-400 uppercase tracking-wider"
              >
                Roth 401(k)
              </h3>
              <span
                class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-200"
                >After-Tax</span
              >
            </div>
            <ul
              class="mt-4 space-y-2.5 text-xs text-slate-600 dark:text-slate-300"
            >
              <li class="flex items-start gap-2">
                ⚠️ <strong>No Tax Break Today:</strong> Contributions are made with
                after-tax earnings.
              </li>
              <li class="flex items-start gap-2">
                ✅ <strong>100% Tax-Free Retirement:</strong> All contributions AND
                compound earnings are tax-free upon withdrawal after age 59½.
              </li>
              <li class="flex items-start gap-2">
                ✅ <strong>No RMDs:</strong> SECURE 2.0 eliminated RMDs for Roth 401(k)
                accounts starting in 2024.
              </li>
              <li class="flex items-start gap-2">
                ✅ <strong>No Income Limit:</strong> Anyone can contribute up to the
                max $23,500 regardless of income (unlike Roth IRA).
              </li>
              <li class="flex items-start gap-2">
                🎯 <strong>Best For:</strong> Younger workers, people in lower/mid
                tax brackets, or those anticipating higher tax rates in the future.
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- TAB 3: 2025 IRS LIMITS -->
      <div id="panel-401k-limits" class="tab-401k-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2
            class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"
          >
            <span>📋</span> Official 2025 IRS 401(k) Contribution Limits
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            IRS Notice 2024-80 established higher contribution thresholds and
            new SECURE Act 2.0 catch-up provisions for tax year 2025.
          </p>
        </div>

        <div
          class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800"
        >
          <table
            class="w-full text-left text-xs text-slate-700 dark:text-slate-300"
          >
            <thead
              class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold"
            >
              <tr>
                <th class="p-3">Category</th>
                <th class="p-3">2024 Limit</th>
                <th class="p-3">2025 Limit</th>
                <th class="p-3">Who Qualifies</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <tr>
                <td class="p-3 font-bold">Employee Elective Deferral</td>
                <td class="p-3">$23,000</td>
                <td class="p-3 font-bold text-blue-700 dark:text-blue-400"
                  >$23,500</td
                >
                <td class="p-3">All employees under age 50</td>
              </tr>
