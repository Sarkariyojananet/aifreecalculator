<!-- CLIENT SIDE SCRIPT -->
<script>
  import { calculateSwp, type SwpResult } from '../../lib/calculators/swp';

  function formatINR(val: number): string {
    return '₹ ' + val.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // ─────────────────────────────────────────────────────────────────────────
  // TAB SWITCHING
  // ─────────────────────────────────────────────────────────────────────────
  const tabBtnSimple = document.getElementById('tab-btn-simple-swp') as HTMLButtonElement;
  const tabBtnInf = document.getElementById('tab-btn-inf-swp') as HTMLButtonElement;
  const panelSimple = document.getElementById('panel-simple-swp') as HTMLDivElement;
  const panelInf = document.getElementById('panel-inf-swp') as HTMLDivElement;
  const modeDesc = document.getElementById('swp-mode-desc') as HTMLDivElement;

  function switchTab(mode: 'simple' | 'inflation') {
    if (mode === 'simple') {
      tabBtnSimple.className = 'btn-swp-tab active shrink-0 rounded-xl bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5';
      tabBtnInf.className = 'btn-swp-tab shrink-0 rounded-xl border border-slate-300 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5';
      panelSimple.classList.remove('hidden');
      panelInf.classList.add('hidden');
      modeDesc.textContent = 'Estimate remaining corpus and total withdrawals with a fixed monthly payout.';
    } else {
      tabBtnInf.className = 'btn-swp-tab active shrink-0 rounded-xl bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5';
      tabBtnSimple.className = 'btn-swp-tab shrink-0 rounded-xl border border-slate-300 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5';
      panelInf.classList.remove('hidden');
      panelSimple.classList.add('hidden');
      modeDesc.textContent = 'Step up your monthly withdrawal once every 12 months to account for inflation.';
    }
  }

  tabBtnSimple.addEventListener('click', () => switchTab('simple'));
  tabBtnInf.addEventListener('click', () => switchTab('inflation'));

  // Slider sync helper with modification callback
  function setupSliderSync(input: HTMLInputElement, range: HTMLInputElement, onMod: () => void) {
    range.addEventListener('input', () => {
      input.value = range.value;
      onMod();
    });
    input.addEventListener('input', () => {
      range.value = input.value;
      onMod();
    });
  }

  // ─────────────────────────────────────────────────────────────────────────
  // 1. SIMPLE SWP LOGIC
  // ─────────────────────────────────────────────────────────────────────────
  const formSimple = document.getElementById('form-simple-swp') as HTMLFormElement;
  const inpSimInv = document.getElementById('inp-sim-inv') as HTMLInputElement;
  const rangeSimInv = document.getElementById('range-sim-inv') as HTMLInputElement;

  const inpSimWd = document.getElementById('inp-sim-wd') as HTMLInputElement;
  const rangeSimWd = document.getElementById('range-sim-wd') as HTMLInputElement;

  const inpSimRet = document.getElementById('inp-sim-ret') as HTMLInputElement;
  const rangeSimRet = document.getElementById('range-sim-ret') as HTMLInputElement;

  const inpSimYrs = document.getElementById('inp-sim-yrs') as HTMLInputElement;
  const rangeSimYrs = document.getElementById('range-sim-yrs') as HTMLInputElement;

  const btnCalcSimple = document.getElementById('btn-calc-simple-swp') as HTMLButtonElement;
  const btnClearSimple = document.getElementById('btn-clear-simple-swp') as HTMLButtonElement;
  const errSim = document.getElementById('err-sim-swp') as HTMLParagraphElement;

  const simResultsSection = document.getElementById('sim-results-section') as HTMLDivElement;
  const resSimTotalWd = document.getElementById('res-sim-total-wd') as HTMLDivElement;
  const resSimFinalBal = document.getElementById('res-sim-final-bal') as HTMLDivElement;
  const bannerSimDepleted = document.getElementById('banner-sim-depleted') as HTMLDivElement;
  const resSimInitInv = document.getElementById('res-sim-init-inv') as HTMLDivElement;
  const resSimReturns = document.getElementById('res-sim-returns') as HTMLDivElement;
  const resSimPayout = document.getElementById('res-sim-payout') as HTMLDivElement;
  const resSimDuration = document.getElementById('res-sim-duration') as HTMLDivElement;
  const resSimTiming = document.getElementById('res-sim-timing') as HTMLDivElement;
  const resSimStatus = document.getElementById('res-sim-status') as HTMLDivElement;

  const btnSimTimingBeg = document.getElementById('btn-sim-timing-beg') as HTMLButtonElement;
  const btnSimTimingEnd = document.getElementById('btn-sim-timing-end') as HTMLButtonElement;
  const hintSimTiming = document.getElementById('hint-sim-timing') as HTMLParagraphElement;

  let selectedSimTiming: 'beginning' | 'end' = 'beginning';

  const svgDonutSimCorpus = document.getElementById('svg-donut-sim-corpus') as unknown as SVGCircleElement;
  const txtDonutSimCenter = document.getElementById('txt-donut-sim-center') as HTMLSpanElement;
  const txtLegendSimWd = document.getElementById('txt-legend-sim-withdrawn') as HTMLSpanElement;
  const txtLegendSimBal = document.getElementById('txt-legend-sim-balance') as HTMLSpanElement;

  const tbodySimSchedule = document.getElementById('tbody-sim-schedule') as HTMLTableSectionElement;
  const btnSimViewYearly = document.getElementById('btn-sim-view-yearly') as HTMLButtonElement;
  const btnSimViewMonthly = document.getElementById('btn-sim-view-monthly') as HTMLButtonElement;
  const thSimPeriod = document.getElementById('th-sim-period') as HTMLTableCellElement;

  let currentSimResult: SwpResult | null = null;
  let currentSimViewMode: 'yearly' | 'monthly' = 'yearly';

  // IMPORTANT: Hide results when inputs/sliders/timing change
  function handleSimInputModification() {
    simResultsSection.classList.add('hidden');
    errSim.classList.add('hidden');
    currentSimResult = null;
  }

  function setSimTiming(timing: 'beginning' | 'end') {
    if (selectedSimTiming === timing) return;
    selectedSimTiming = timing;
    if (timing === 'beginning') {
      btnSimTimingBeg.className = 'timing-btn-sim rounded-lg py-2 text-xs font-bold transition-all bg-white text-blue-600 shadow-2xs dark:bg-slate-700 dark:text-blue-400 cursor-pointer';
      btnSimTimingEnd.className = 'timing-btn-sim rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
      hintSimTiming.textContent = 'The withdrawal is deducted at the start of each month, and investment growth is calculated on the remaining balance.';
    } else {
      btnSimTimingEnd.className = 'timing-btn-sim rounded-lg py-2 text-xs font-bold transition-all bg-white text-blue-600 shadow-2xs dark:bg-slate-700 dark:text-blue-400 cursor-pointer';
      btnSimTimingBeg.className = 'timing-btn-sim rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
      hintSimTiming.textContent = 'Investment growth is calculated first, and the withdrawal is deducted at the end of each month.';
    }
    // Changing timing must NOT automatically update the result
    handleSimInputModification();
  }

  btnSimTimingBeg.addEventListener('click', () => setSimTiming('beginning'));
  btnSimTimingEnd.addEventListener('click', () => setSimTiming('end'));

  setupSliderSync(inpSimInv, rangeSimInv, handleSimInputModification);
  setupSliderSync(inpSimWd, rangeSimWd, handleSimInputModification);
  setupSliderSync(inpSimRet, rangeSimRet, handleSimInputModification);
  setupSliderSync(inpSimYrs, rangeSimYrs, handleSimInputModification);

  function renderSimScheduleTable() {
    if (!currentSimResult) return;
    if (currentSimViewMode === 'yearly') {
      thSimPeriod.textContent = 'Year';
      tbodySimSchedule.innerHTML = currentSimResult.yearlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-800 dark:text-slate-200">Year ${row.year}</td>
          <td class="p-2.5 text-right font-medium text-slate-700 dark:text-slate-300">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatINR(row.annualWithdrawal)}</td>
          <td class="p-2.5 text-right font-medium text-blue-600 dark:text-blue-400">${formatINR(row.investmentGrowth)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    } else {
      thSimPeriod.textContent = 'Month';
      tbodySimSchedule.innerHTML = currentSimResult.monthlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-800 dark:text-slate-200">Mo ${row.month} (Yr ${row.year})</td>
          <td class="p-2.5 text-right font-medium text-slate-700 dark:text-slate-300">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatINR(row.actualWithdrawal)}</td>
          <td class="p-2.5 text-right font-medium text-blue-600 dark:text-blue-400">${formatINR(row.growthEarned)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    }
  }

  btnSimViewYearly.addEventListener('click', () => {
    currentSimViewMode = 'yearly';
    btnSimViewYearly.className = 'rounded-lg bg-blue-600 px-3 py-1 text-white shadow-2xs cursor-pointer';
    btnSimViewMonthly.className = 'rounded-lg border border-slate-300 px-3 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer';
    renderSimScheduleTable();
  });

  btnSimViewMonthly.addEventListener('click', () => {
    currentSimViewMode = 'monthly';
    btnSimViewMonthly.className = 'rounded-lg bg-blue-600 px-3 py-1 text-white shadow-2xs cursor-pointer';
    btnSimViewYearly.className = 'rounded-lg border border-slate-300 px-3 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer';
    renderSimScheduleTable();
  });

  function executeSimpleSwpCalculation() {
    errSim.classList.add('hidden');

    const inv = parseFloat(inpSimInv.value);
    const wd = parseFloat(inpSimWd.value);
    const ret = parseFloat(inpSimRet.value);
    const yrs = parseInt(inpSimYrs.value, 10);

    if (isNaN(inv) || inv <= 0) {
      errSim.textContent = 'Please enter a valid Initial Investment amount.';
      errSim.classList.remove('hidden');
      return;
    }
    if (isNaN(wd) || wd <= 0) {
      errSim.textContent = 'Please enter a valid Monthly Withdrawal amount.';
      errSim.classList.remove('hidden');
      return;
    }
    if (isNaN(ret) || ret < 0) {
      errSim.textContent = 'Please enter a valid Expected Annual Return rate.';
      errSim.classList.remove('hidden');
      return;
    }
    if (isNaN(yrs) || yrs <= 0) {
      errSim.textContent = 'Please enter a valid Time Period in years.';
      errSim.classList.remove('hidden');
      return;
    }

    const res = calculateSwp({
      initialInvestment: inv,
      monthlyWithdrawal: wd,
      annualReturnRate: ret,
      timePeriodYears: yrs,
      annualInflationRate: 0,
      withdrawalTiming: selectedSimTiming,
    });
    currentSimResult = res;

    // Highlight metrics
    resSimTotalWd.textContent = formatINR(res.totalWithdrawn);
    resSimFinalBal.textContent = formatINR(res.finalBalance);
    resSimInitInv.textContent = formatINR(res.initialInvestment);
    resSimReturns.textContent = formatINR(res.totalReturns);
    resSimPayout.textContent = `${formatINR(res.initialMonthlyWithdrawal)} / mo`;
    resSimDuration.textContent = `${res.timePeriodYears} Years (${res.totalMonths} Mo)`;
    resSimTiming.textContent = res.withdrawalTimingLabel;
    resSimStatus.textContent = res.isDepleted ? (res.depletedText ? 'Corpus Depleted' : 'Depleted') : 'Corpus Sustained';
    resSimStatus.className = `mt-1 text-sm sm:text-base font-bold ${res.isDepleted ? 'text-amber-600 dark:text-amber-400' : 'text-emerald-600 dark:text-emerald-400'}`;

    // Depletion banner
    if (res.isDepleted && res.depletedText) {
      bannerSimDepleted.innerHTML = `<strong>⚠️ Corpus Depletion Notice:</strong> ${res.depletedText} All available funds were paid out. Subsequent monthly withdrawals will be ₹0.`;
      bannerSimDepleted.classList.remove('hidden');
    } else {
      bannerSimDepleted.innerHTML = `<strong>✅ Corpus Sustained:</strong> Your remaining investment balance after ${res.timePeriodYears} years is <strong>${formatINR(res.finalBalance)}</strong>.`;
      bannerSimDepleted.className = 'mt-4 rounded-xl p-3.5 text-xs font-semibold bg-emerald-50 border border-emerald-300 dark:bg-emerald-950/40 dark:border-emerald-900/60 text-emerald-900 dark:text-emerald-200';
      bannerSimDepleted.classList.remove('hidden');
    }

    // Donut chart logic
    const totalPie = res.totalWithdrawn + res.finalBalance;
    const wdPct = totalPie > 0 ? (res.totalWithdrawn / totalPie) * 100 : 100;
    const balPct = totalPie > 0 ? (res.finalBalance / totalPie) * 100 : 0;

    svgDonutSimCorpus.setAttribute('stroke-dasharray', `${balPct.toFixed(1)} ${(100 - balPct).toFixed(1)}`);
    txtDonutSimCenter.textContent = '100%';
    txtLegendSimWd.textContent = `${formatINR(res.totalWithdrawn)} (${wdPct.toFixed(1)}%)`;
    txtLegendSimBal.textContent = `${formatINR(res.finalBalance)} (${balPct.toFixed(1)}%)`;

    renderSimScheduleTable();

    simResultsSection.classList.remove('hidden');
    simResultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  btnCalcSimple.addEventListener('click', executeSimpleSwpCalculation);

  btnClearSimple.addEventListener('click', () => {
    inpSimInv.value = '500000';
    rangeSimInv.value = '500000';
    inpSimWd.value = '10000';
    rangeSimWd.value = '10000';
    inpSimRet.value = '8';
    rangeSimRet.value = '8';
    inpSimYrs.value = '5';
    rangeSimYrs.value = '5';
    setSimTiming('beginning');
    handleSimInputModification();
  });

  document.querySelectorAll('.btn-preset-simple-swp').forEach((btn) => {
    btn.addEventListener('click', () => {
      inpSimInv.value = btn.getAttribute('data-inv') || '500000';
      rangeSimInv.value = inpSimInv.value;
      inpSimWd.value = btn.getAttribute('data-wd') || '10000';
      rangeSimWd.value = inpSimWd.value;
      inpSimRet.value = btn.getAttribute('data-ret') || '8';
      rangeSimRet.value = inpSimRet.value;
      inpSimYrs.value = btn.getAttribute('data-yrs') || '5';
      rangeSimYrs.value = inpSimYrs.value;

      handleSimInputModification();
      executeSimpleSwpCalculation();
    });
  });

  formSimple.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeSimpleSwpCalculation();
    }
  });

  // ─────────────────────────────────────────────────────────────────────────
  // 2. ADVANCED SWP WITH INFLATION LOGIC
  // ─────────────────────────────────────────────────────────────────────────
  const formInf = document.getElementById('form-inf-swp') as HTMLFormElement;
  const inpInfInv = document.getElementById('inp-inf-inv') as HTMLInputElement;
  const rangeInfInv = document.getElementById('range-inf-inv') as HTMLInputElement;

  const inpInfWd = document.getElementById('inp-inf-wd') as HTMLInputElement;
  const rangeInfWd = document.getElementById('range-inf-wd') as HTMLInputElement;

  const inpInfRet = document.getElementById('inp-inf-ret') as HTMLInputElement;
  const rangeInfRet = document.getElementById('range-inf-ret') as HTMLInputElement;

  const inpInfRate = document.getElementById('inp-inf-rate') as HTMLInputElement;
  const rangeInfRate = document.getElementById('range-inf-rate') as HTMLInputElement;

  const inpInfYrs = document.getElementById('inp-inf-yrs') as HTMLInputElement;
  const rangeInfYrs = document.getElementById('range-inf-yrs') as HTMLInputElement;

  const btnCalcInf = document.getElementById('btn-calc-inf-swp') as HTMLButtonElement;
  const btnClearInf = document.getElementById('btn-clear-inf-swp') as HTMLButtonElement;
  const errInf = document.getElementById('err-inf-swp') as HTMLParagraphElement;

  const infResultsSection = document.getElementById('inf-results-section') as HTMLDivElement;
  const resInfTotalWd = document.getElementById('res-inf-total-wd') as HTMLDivElement;
  const resInfFinalBal = document.getElementById('res-inf-final-bal') as HTMLDivElement;
  const bannerInfDepleted = document.getElementById('banner-inf-depleted') as HTMLDivElement;
  const resInfInitInv = document.getElementById('res-inf-init-inv') as HTMLDivElement;
  const resInfReturns = document.getElementById('res-inf-returns') as HTMLDivElement;
  const resInfInitPayout = document.getElementById('res-inf-init-payout') as HTMLDivElement;
  const resInfFinalPayout = document.getElementById('res-inf-final-payout') as HTMLDivElement;
  const resInfTiming = document.getElementById('res-inf-timing') as HTMLDivElement;
  const resInfInflationRate = document.getElementById('res-inf-inflation-rate') as HTMLDivElement;
  const resInfDuration = document.getElementById('res-inf-duration') as HTMLDivElement;
  const resInfStatus = document.getElementById('res-inf-status') as HTMLDivElement;

  const btnInfTimingBeg = document.getElementById('btn-inf-timing-beg') as HTMLButtonElement;
  const btnInfTimingEnd = document.getElementById('btn-inf-timing-end') as HTMLButtonElement;
  const hintInfTiming = document.getElementById('hint-inf-timing') as HTMLParagraphElement;

  let selectedInfTiming: 'beginning' | 'end' = 'beginning';

  const tbodyInfSchedule = document.getElementById('tbody-inf-schedule') as HTMLTableSectionElement;
  const btnInfViewYearly = document.getElementById('btn-inf-view-yearly') as HTMLButtonElement;
  const btnInfViewMonthly = document.getElementById('btn-inf-view-monthly') as HTMLButtonElement;
  const thInfPeriod = document.getElementById('th-inf-period') as HTMLTableCellElement;

  let currentInfResult: SwpResult | null = null;
  let currentInfViewMode: 'yearly' | 'monthly' = 'yearly';

  function handleInfInputModification() {
    infResultsSection.classList.add('hidden');
    errInf.classList.add('hidden');
    currentInfResult = null;
  }

  function setInfTiming(timing: 'beginning' | 'end') {
    if (selectedInfTiming === timing) return;
    selectedInfTiming = timing;
    if (timing === 'beginning') {
      btnInfTimingBeg.className = 'timing-btn-inf rounded-lg py-2 text-xs font-bold transition-all bg-white text-blue-600 shadow-2xs dark:bg-slate-700 dark:text-blue-400 cursor-pointer';
      btnInfTimingEnd.className = 'timing-btn-inf rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
      hintInfTiming.textContent = 'The withdrawal is deducted at the start of each month, and investment growth is calculated on the remaining balance.';
    } else {
      btnInfTimingEnd.className = 'timing-btn-inf rounded-lg py-2 text-xs font-bold transition-all bg-white text-blue-600 shadow-2xs dark:bg-slate-700 dark:text-blue-400 cursor-pointer';
      btnInfTimingBeg.className = 'timing-btn-inf rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
      hintInfTiming.textContent = 'Investment growth is calculated first, and the withdrawal is deducted at the end of each month.';
    }
    // Changing timing must NOT automatically update the result
    handleInfInputModification();
  }

  btnInfTimingBeg.addEventListener('click', () => setInfTiming('beginning'));
  btnInfTimingEnd.addEventListener('click', () => setInfTiming('end'));

  setupSliderSync(inpInfInv, rangeInfInv, handleInfInputModification);
  setupSliderSync(inpInfWd, rangeInfWd, handleInfInputModification);
  setupSliderSync(inpInfRet, rangeInfRet, handleInfInputModification);
  setupSliderSync(inpInfRate, rangeInfRate, handleInfInputModification);
  setupSliderSync(inpInfYrs, rangeInfYrs, handleInfInputModification);

  function renderInfScheduleTable() {
    if (!currentInfResult) return;
    if (currentInfViewMode === 'yearly') {
      thInfPeriod.textContent = 'Year';
      tbodyInfSchedule.innerHTML = currentInfResult.yearlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-800 dark:text-slate-200">Year ${row.year}</td>
          <td class="p-2.5 text-right font-medium text-slate-700 dark:text-slate-300">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right font-medium text-slate-900 dark:text-white">${formatINR(row.monthlyWithdrawal)}/mo</td>
          <td class="p-2.5 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatINR(row.annualWithdrawal)}</td>
          <td class="p-2.5 text-right font-medium text-blue-600 dark:text-blue-400">${formatINR(row.investmentGrowth)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    } else {
      thInfPeriod.textContent = 'Month';
      tbodyInfSchedule.innerHTML = currentInfResult.monthlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-800 dark:text-slate-200">Mo ${row.month} (Yr ${row.year})</td>
          <td class="p-2.5 text-right font-medium text-slate-700 dark:text-slate-300">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right font-medium text-slate-900 dark:text-white">${formatINR(row.requestedWithdrawal)}</td>
          <td class="p-2.5 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatINR(row.actualWithdrawal)}</td>
          <td class="p-2.5 text-right font-medium text-blue-600 dark:text-blue-400">${formatINR(row.growthEarned)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    }
  }

  btnInfViewYearly.addEventListener('click', () => {
    currentInfViewMode = 'yearly';
    btnInfViewYearly.className = 'rounded-lg bg-blue-600 px-3 py-1 text-white shadow-2xs cursor-pointer';
    btnInfViewMonthly.className = 'rounded-lg border border-slate-300 px-3 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer';
    renderInfScheduleTable();
  });

  btnInfViewMonthly.addEventListener('click', () => {
    currentInfViewMode = 'monthly';
    btnInfViewMonthly.className = 'rounded-lg bg-blue-600 px-3 py-1 text-white shadow-2xs cursor-pointer';
    btnInfViewYearly.className = 'rounded-lg border border-slate-300 px-3 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer';
    renderInfScheduleTable();
  });

  function executeInflationSwpCalculation() {
    errInf.classList.add('hidden');

    const inv = parseFloat(inpInfInv.value);
    const wd = parseFloat(inpInfWd.value);
    const ret = parseFloat(inpInfRet.value);
    const inf = parseFloat(inpInfRate.value) || 0;
    const yrs = parseInt(inpInfYrs.value, 10);

    if (isNaN(inv) || inv <= 0) {
      errInf.textContent = 'Please enter a valid Initial Investment amount.';
      errInf.classList.remove('hidden');
      return;
    }
    if (isNaN(wd) || wd <= 0) {
      errInf.textContent = 'Please enter a valid Initial Monthly Withdrawal amount.';
      errInf.classList.remove('hidden');
      return;
    }
    if (isNaN(ret) || ret < 0) {
      errInf.textContent = 'Please enter a valid Expected Annual Return rate.';
      errInf.classList.remove('hidden');
      return;
    }
    if (isNaN(inf) || inf < 0) {
      errInf.textContent = 'Inflation rate cannot be negative.';
      errInf.classList.remove('hidden');
      return;
    }
    if (isNaN(yrs) || yrs <= 0) {
      errInf.textContent = 'Please enter a valid Time Period in years.';
      errInf.classList.remove('hidden');
      return;
    }

    const res = calculateSwp({
      initialInvestment: inv,
      monthlyWithdrawal: wd,
      annualReturnRate: ret,
      timePeriodYears: yrs,
      annualInflationRate: inf,
      withdrawalTiming: selectedInfTiming,
    });
    currentInfResult = res;

    // Highlight metrics
    resInfTotalWd.textContent = formatINR(res.totalWithdrawn);
    resInfFinalBal.textContent = formatINR(res.finalBalance);
    resInfInitInv.textContent = formatINR(res.initialInvestment);
    resInfReturns.textContent = formatINR(res.totalReturns);
    resInfInitPayout.textContent = `${formatINR(res.initialMonthlyWithdrawal)} / mo`;
    resInfFinalPayout.textContent = `${formatINR(res.finalMonthlyWithdrawal)} / mo`;
    resInfTiming.textContent = res.withdrawalTimingLabel;
    resInfInflationRate.textContent = `${res.annualInflationRate}% p.a.`;
    resInfDuration.textContent = `${res.timePeriodYears} Years (${res.totalMonths} Mo)`;
    resInfStatus.textContent = res.isDepleted ? (res.depletedAtMonth ? `Depleted (Mo ${res.depletedAtMonth})` : 'Depleted') : 'Corpus Sustained';
    resInfStatus.className = `mt-1 text-sm sm:text-base font-bold ${res.isDepleted ? 'text-amber-600 dark:text-amber-400' : 'text-emerald-600 dark:text-emerald-400'}`;

    // Depletion banner
    if (res.isDepleted && res.depletedText) {
      bannerInfDepleted.innerHTML = `<strong>⚠️ Corpus Depletion Notice:</strong> ${res.depletedText} All available funds were paid out. Subsequent inflation-adjusted withdrawals will be ₹0.`;
      bannerInfDepleted.className = 'mt-4 rounded-xl p-3.5 text-xs font-semibold bg-amber-50 border border-amber-300 dark:bg-amber-950/40 dark:border-amber-900/60 text-amber-900 dark:text-amber-200';
      bannerInfDepleted.classList.remove('hidden');
    } else {
      bannerInfDepleted.innerHTML = `<strong>✅ Corpus Sustained:</strong> Your remaining investment balance after ${res.timePeriodYears} years is <strong>${formatINR(res.finalBalance)}</strong> even after increasing withdrawals by ${res.annualInflationRate}% each year.`;
      bannerInfDepleted.className = 'mt-4 rounded-xl p-3.5 text-xs font-semibold bg-emerald-50 border border-emerald-300 dark:bg-emerald-950/40 dark:border-emerald-900/60 text-emerald-900 dark:text-emerald-200';
      bannerInfDepleted.classList.remove('hidden');
    }

    renderInfScheduleTable();

    infResultsSection.classList.remove('hidden');
    infResultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  btnCalcInf.addEventListener('click', executeInflationSwpCalculation);

  btnClearInf.addEventListener('click', () => {
    inpInfInv.value = '500000';
    rangeInfInv.value = '500000';
    inpInfWd.value = '10000';
    rangeInfWd.value = '10000';
    inpInfRet.value = '8';
    rangeInfRet.value = '8';
    inpInfRate.value = '6';
    rangeInfRate.value = '6';
    inpInfYrs.value = '5';
    rangeInfYrs.value = '5';
    setInfTiming('beginning');
    handleInfInputModification();
  });

  document.querySelectorAll('.btn-preset-inf-swp').forEach((btn) => {
    btn.addEventListener('click', () => {
      inpInfInv.value = btn.getAttribute('data-inv') || '500000';
      rangeInfInv.value = inpInfInv.value;
      inpInfWd.value = btn.getAttribute('data-wd') || '10000';
      rangeInfWd.value = inpInfWd.value;
      inpInfRet.value = btn.getAttribute('data-ret') || '8';
      rangeInfRet.value = inpInfRet.value;
      inpInfRate.value = btn.getAttribute('data-inf') || '6';
      rangeInfRate.value = inpInfRate.value;
      inpInfYrs.value = btn.getAttribute('data-yrs') || '5';
      rangeInfYrs.value = inpInfYrs.value;

      handleInfInputModification();
      executeInflationSwpCalculation();
    });
  });

  formInf.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeInflationSwpCalculation();
    }
  });
</script>
