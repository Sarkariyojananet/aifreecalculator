---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="SWP Calculator – Systematic Withdrawal Plan with Inflation"
  description="Calculate monthly withdrawals, total withdrawn amount, remaining corpus, and inflation-adjusted systematic withdrawal schedules for mutual funds."
  category="Finance"
  calculatorName="SWP Calculator"
  slug="swp-calculator"
  keywords={[
    'swp calculator',
    'swp calculator with inflation',
    'best swp calculator',
    'swp calculator sbi',
    'sbi swp calculator',
    'systematic withdrawal plan calculator',
    'mutual fund swp calculator',
    'monthly swp calculator'
  ]}
>
  <div class="space-y-6">

    <!-- MODE TABS: SIMPLE VS INFLATION -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button
          type="button"
          id="tab-btn-simple-swp"
          class="btn-swp-tab active shrink-0 rounded-xl bg-blue-600 px-4 py-2 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5"
          data-mode="simple"
        >
          <span>⚡</span>
          <span>Simple SWP Calculator</span>
          <span class="hidden sm:inline text-[10px] font-normal opacity-90">(Fixed Monthly Payout)</span>
        </button>
        <button
          type="button"
          id="tab-btn-inf-swp"
          class="btn-swp-tab shrink-0 rounded-xl border border-slate-300 bg-white px-4 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-mode="inflation"
        >
          <span>📈</span>
          <span>SWP Calculator with Inflation</span>
          <span class="hidden sm:inline text-[10px] font-normal opacity-90">(Annual Step-Up)</span>
        </button>
      </div>
      <div id="swp-mode-desc" class="mt-2 px-1 text-[11px] font-medium text-slate-500 dark:text-slate-400">
        Estimate remaining corpus and total withdrawals with a fixed monthly payout.
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- 1. SIMPLE SWP CALCULATOR PANEL (Default)                          -->
    <!-- ================================================================= -->
    <div id="panel-simple-swp" class="space-y-6">
      
      <!-- SIMPLE PRESETS -->
      <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
            <span>⚡</span> Quick Presets:
          </span>
          <button type="button" class="btn-preset-simple-swp rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-inv="500000" data-wd="10000" data-ret="8" data-yrs="5">💼 ₹5L @ 8%, ₹10k/mo (5 Yrs)</button>
          <button type="button" class="btn-preset-simple-swp rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-inv="1000000" data-wd="8000" data-ret="10" data-yrs="10">🚀 ₹10L @ 10%, ₹8k/mo (10 Yrs)</button>
          <button type="button" class="btn-preset-simple-swp rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-inv="2500000" data-wd="20000" data-ret="12" data-yrs="15">📈 ₹25L @ 12%, ₹20k/mo (15 Yrs)</button>
          <button type="button" class="btn-preset-simple-swp rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-inv="5000000" data-wd="35000" data-ret="10" data-yrs="20">🏆 ₹50L @ 10%, ₹35k/mo (20 Yrs)</button>
        </div>
      </div>

      <!-- SIMPLE FORM CONTAINER -->
      <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
        
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>⚡</span> Simple SWP Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Simulate a fixed monthly cash flow from your mutual fund investment with investment compounding applied each month.
          </p>
        </div>

        <form id="form-simple-swp" class="mt-5 space-y-4" novalidate onsubmit="return false;">
          
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <!-- 1. Initial Investment -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-sim-inv" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Initial Investment (₹) <span class="text-red-500">*</span>
                </label>
                <div class="relative w-36">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-xs font-bold text-slate-400">₹</span>
                  <input
                    type="number"
                    id="inp-sim-inv"
                    value="500000"
                    step="10000"
                    min="1000"
                    class="w-full rounded-xl border border-slate-300 bg-white py-1.5 pl-6 pr-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>
              </div>
              <input
                type="range"
                id="range-sim-inv"
                value="500000"
                min="50000"
                max="5000000"
                step="10000"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
                aria-label="Initial Investment Slider"
              />
              <div class="flex justify-between text-[11px] font-semibold text-slate-400">
                <span>₹50,000</span>
                <span>₹25,00,000</span>
                <span>₹50,00,000+</span>
              </div>
            </div>

            <!-- 2. Monthly Withdrawal -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-sim-wd" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Monthly Withdrawal (₹) <span class="text-red-500">*</span>
                </label>
                <div class="relative w-32">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-xs font-bold text-slate-400">₹</span>
                  <input
                    type="number"
                    id="inp-sim-wd"
                    value="10000"
                    step="500"
                    min="100"
                    class="w-full rounded-xl border border-slate-300 bg-white py-1.5 pl-6 pr-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>
              </div>
              <input
                type="range"
                id="range-sim-wd"
                value="10000"
                min="500"
                max="100000"
                step="500"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
                aria-label="Monthly Withdrawal Slider"
              />
              <div class="flex justify-between text-[11px] font-semibold text-slate-400">
                <span>₹500</span>
                <span>₹50,000</span>
                <span>₹1,00,000</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <!-- 3. Expected Annual Return (%) -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-sim-ret" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Expected Return (% p.a.) <span class="text-red-500">*</span>
                </label>
                <div class="relative w-28">
                  <input
                    type="number"
                    id="inp-sim-ret"
                    value="8"
                    step="0.5"
                    min="1"
                    max="40"
                    class="w-full rounded-xl border border-slate-300 bg-white py-1.5 pl-3 pr-6 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                  <span class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-xs font-bold text-slate-400">%</span>
                </div>
              </div>
              <input
                type="range"
                id="range-sim-ret"
                value="8"
                min="1"
                max="30"
                step="0.5"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
                aria-label="Annual Return Slider"
              />
              <div class="flex justify-between text-[11px] font-semibold text-slate-400">
                <span>1%</span>
                <span>15%</span>
                <span>30%</span>
              </div>
            </div>

            <!-- 4. Time Period (Years) -->
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2">
              <div class="flex items-center justify-between">
                <label for="inp-sim-yrs" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Time Period (Years) <span class="text-red-500">*</span>
                </label>
                <div class="relative w-28">
                  <input
                    type="number"
                    id="inp-sim-yrs"
                    value="5"
                    step="1"
                    min="1"
                    max="40"
                    class="w-full rounded-xl border border-slate-300 bg-white py-1.5 px-3 text-right text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>
              </div>
              <input
                type="range"
                id="range-sim-yrs"
                value="5"
                min="1"
                max="30"
                step="1"
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600 dark:bg-slate-700 dark:accent-blue-500"
                aria-label="Time Period Slider"
              />
              <div class="flex justify-between text-[11px] font-semibold text-slate-400">
                <span>1 Year</span>
                <span>15 Years</span>
                <span>30 Years</span>
              </div>
            </div>
          </div>

          <!-- 5. Withdrawal Timing -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 space-y-2.5">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Withdrawal Timing <span class="text-red-500">*</span>
            </label>
            <div class="grid grid-cols-2 gap-2 rounded-xl bg-slate-100 p-1 dark:bg-slate-800">
              <button
                type="button"
                id="btn-sim-timing-beg"
                data-timing="beginning"
                class="timing-btn-sim rounded-lg py-2 text-xs font-bold transition-all bg-white text-blue-600 shadow-2xs dark:bg-slate-700 dark:text-blue-400 cursor-pointer"
              >
                Beginning of Month
              </button>
              <button
                type="button"
                id="btn-sim-timing-end"
                data-timing="end"
                class="timing-btn-sim rounded-lg py-2 text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer"
              >
                End of Month
              </button>
            </div>
            <p id="hint-sim-timing" class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">
              The withdrawal is deducted at the start of each month, and investment growth is calculated on the remaining balance.
            </p>
          </div>

          <!-- ACTION BUTTONS -->
          <div class="flex items-center gap-2 pt-2">
            <button
              type="submit"
              id="btn-calc-simple-swp"
              class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer text-center"
            >
              Calculate SWP →
            </button>
            <button
              type="button"
              id="btn-clear-simple-swp"
              class="rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Clear (✕)
            </button>
          </div>

          <p id="err-sim-swp" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        </form>

        <!-- SIMPLE RESULTS CONTAINER (Hidden until button is clicked) -->
        <div id="sim-results-section" class="hidden mt-6 space-y-6">
          
          <!-- Highlight Result Card -->
          <div class="overflow-hidden rounded-3xl border border-emerald-200 bg-linear-to-br from-white via-emerald-50/40 to-emerald-100/50 p-5 shadow-lg shadow-emerald-500/5 dark:border-emerald-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-emerald-950/30 sm:p-7">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-emerald-200/80 pb-4 dark:border-slate-800">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Total Withdrawn Amount</span>
                <div id="res-sim-total-wd" class="mt-1 text-3xl sm:text-5xl font-black text-emerald-600 dark:text-emerald-400">
                  ₹ 6,00,000.00
                </div>
              </div>
              <div class="sm:text-right">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Remaining Corpus Balance:</span>
                <div id="res-sim-final-bal" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
                  ₹ 10,154.29
                </div>
              </div>
            </div>

            <!-- Corpus Exhaustion Notice -->
            <div id="banner-sim-depleted" class="hidden mt-4 rounded-xl p-3.5 text-xs font-semibold bg-amber-50 border border-amber-300 dark:bg-amber-950/40 dark:border-amber-900/60 text-amber-900 dark:text-amber-200">
              <!-- Dynamically populated -->
            </div>

            <!-- 6 Metrics Grid -->
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Initial Investment</div>
                <div id="res-sim-init-inv" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹ 5,00,000</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Growth Returns</div>
                <div id="res-sim-returns" class="mt-1 text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400">₹ 1,05,255.83</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Monthly Withdrawal</div>
                <div id="res-sim-payout" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹ 10,000 / mo</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Duration</div>
                <div id="res-sim-duration" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">5 Years (60 Mo)</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Withdrawal Timing</div>
                <div id="res-sim-timing" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">Beginning of Month</div>
              </div>
              <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
                <div class="text-slate-500 dark:text-slate-400 font-semibold">Corpus Status</div>
                <div id="res-sim-status" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">Sustained</div>
              </div>
            </div>
          </div>

          <!-- VISUAL BREAKDOWN CARD -->
          <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-1.5">
              <span>📊</span> Capital Allocation &amp; Total Value Split
            </h3>
            <div class="flex flex-col sm:flex-row items-center justify-around gap-6">
              
              <!-- SVG Donut -->
              <div class="relative w-40 h-40 flex items-center justify-center">
                <svg viewBox="0 0 36 36" class="w-full h-full transform -rotate-90">
                  <circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="3.8"></circle>
                  <circle id="svg-donut-sim-corpus" cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="3.8" stroke-dasharray="1.7 98.3" stroke-dashoffset="0"></circle>
                </svg>
                <div class="absolute text-center">
                  <span class="text-[11px] font-bold text-slate-400 block">TOTAL VALUE</span>
                  <span id="txt-donut-sim-center" class="text-xs font-black text-slate-800 dark:text-slate-200">100%</span>
                </div>
              </div>

              <!-- Legend & Stats -->
              <div class="space-y-3 text-xs w-full sm:w-auto">
                <div class="flex items-center justify-between gap-6 p-2.5 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40">
                  <span class="flex items-center gap-2 font-bold text-emerald-700 dark:text-emerald-300">
                    <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Total Withdrawn:
                  </span>
                  <span id="txt-legend-sim-withdrawn" class="font-bold text-slate-900 dark:text-white font-mono">₹ 6,00,000 (98.3%)</span>
                </div>
                <div class="flex items-center justify-between gap-6 p-2.5 rounded-xl bg-blue-50/50 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/40">
                  <span class="flex items-center gap-2 font-bold text-blue-700 dark:text-blue-300">
                    <span class="w-3 h-3 rounded-full bg-blue-600 inline-block"></span> Remaining Corpus:
                  </span>
                  <span id="txt-legend-sim-balance" class="font-bold text-slate-900 dark:text-white font-mono">₹ 10,154 (1.7%)</span>
                </div>
              </div>

            </div>
          </div>

          <!-- SCHEDULE TABLE -->
          <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>📅</span> Year-Wise SWP Withdrawal Schedule
              </h3>
              <div class="flex items-center gap-2 text-xs font-bold">
                <button type="button" id="btn-sim-view-yearly" class="rounded-lg bg-blue-600 px-3 py-1 text-white shadow-2xs cursor-pointer">Yearly Summary</button>
                <button type="button" id="btn-sim-view-monthly" class="rounded-lg border border-slate-300 px-3 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer">Monthly View</button>
              </div>
            </div>

            <div class="overflow-x-auto max-h-96 scrollbar-thin">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold sticky top-0">
                  <tr>
                    <th id="th-sim-period" class="p-2.5 rounded-l-lg">Year</th>
                    <th class="p-2.5 text-right">Opening Balance</th>
                    <th class="p-2.5 text-right text-emerald-600 dark:text-emerald-400">Withdrawals</th>
                    <th class="p-2.5 text-right text-blue-600 dark:text-blue-400">Growth Earned</th>
                    <th class="p-2.5 text-right rounded-r-lg font-black text-slate-900 dark:text-white">Closing Balance</th>
                  </tr>
                </thead>
                <tbody id="tbody-sim-schedule" class="divide-y divide-slate-100 dark:divide-slate-800 font-mono">
                  <!-- Dynamically rendered -->
                </tbody>
              </table>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- ================================================================= -->
    <!-- 2. ADVANCED SWP CALCULATOR WITH INFLATION PANEL                   -->
    <!-- ================================================================= -->
    <div id="panel-inf-swp" class="hidden space-y-6">
      
      <!-- INFLATION PRESETS -->
      <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
            <span>⚡</span> Quick Presets:
          </span>
          <button type="button" class="btn-preset-inf-swp rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-inv="500000" data-wd="10000" data-ret="8" data-inf="6" data-yrs="5">🛡️ ₹5L @ 8%, ₹10k/mo, 6% Inf (5 Yrs)</button>
