<script is:inline>
  const rothTabs = document.querySelectorAll('.btn-roth-tab');
  const rothPanels = document.querySelectorAll('.roth-panel');
  const rothResults = document.getElementById('roth-results');

  rothTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      rothTabs.forEach(t => { t.classList.remove('bg-blue-700','text-white','shadow-xs'); t.classList.add('border','border-slate-300','bg-white','text-slate-700','dark:border-slate-700','dark:bg-slate-800','dark:text-slate-200'); });
      tab.classList.add('bg-blue-700','text-white','shadow-xs');
      tab.classList.remove('border','border-slate-300','bg-white','text-slate-700');
      rothPanels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');
      rothResults?.classList.add('hidden');
    });
  });

  document.querySelectorAll('.btn-roth-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('roth-age').value = btn.dataset.age;
      document.getElementById('roth-ret-age').value = btn.dataset.ret;
      document.getElementById('roth-contrib').value = btn.dataset.contrib;
      document.getElementById('roth-rate').value = btn.dataset.rate;
    });
  });

  function fmtUSD(n) { return '$' + Math.round(n).toLocaleString('en-US'); }

  function calcRothBalance(contrib, years, rate, existing) {
    const r = rate / 100;
    const fv = existing * Math.pow(1 + r, years) + contrib * (Math.pow(1 + r, years) - 1) / r * (1 + r);
    return fv;
  }

  function showRothResults(badge, balance, invested, taxRate) {
    const growth = balance - invested;
    const taxSaved = growth * taxRate / 100;
    const growthPct = Math.round(growth / balance * 100);

    document.getElementById('roth-badge').textContent = badge;
    document.getElementById('roth-res-balance').textContent = fmtUSD(balance);
    document.getElementById('roth-res-taxsaved').textContent = fmtUSD(taxSaved) + ' saved';
    document.getElementById('roth-res-invested').textContent = fmtUSD(invested);
    document.getElementById('roth-res-growth').textContent = fmtUSD(growth);

    document.getElementById('roth-donut').setAttribute('stroke-dasharray', growthPct + ' ' + (100 - growthPct));
    document.getElementById('roth-donut-center').textContent = growthPct + '%';
    document.getElementById('roth-legend-contrib').textContent = fmtUSD(invested);
    document.getElementById('roth-legend-growth').textContent = fmtUSD(growth);

    document.getElementById('vs-result-panel').classList.add('hidden');
    rothResults.classList.remove('hidden');
    rothResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('form-roth-growth')?.addEventListener('submit', () => {
    const age = parseFloat(document.getElementById('roth-age').value);
    const retAge = parseFloat(document.getElementById('roth-ret-age').value);
    const contrib = parseFloat(document.getElementById('roth-contrib').value);
    const existing = parseFloat(document.getElementById('roth-existing').value) || 0;
    const rate = parseFloat(document.getElementById('roth-rate').value);
    const taxRate = parseFloat(document.getElementById('roth-tax-rate').value);
    const years = retAge - age;
    if (years <= 0) return;
    const balance = calcRothBalance(contrib, years, rate, existing);
    document.getElementById('roth-res-years').textContent = years + ' Years';
    showRothResults('🇺🇸 Roth IRA Balance at Retirement (Tax-Free)', balance, contrib * years + existing, taxRate);
  });
  document.getElementById('btn-roth-clear')?.addEventListener('click', () => rothResults?.classList.add('hidden'));

  document.getElementById('form-vs')?.addEventListener('submit', () => {
    const contrib = parseFloat(document.getElementById('vs-contrib').value);
    const years = parseFloat(document.getElementById('vs-years').value);
    const rate = parseFloat(document.getElementById('vs-rate').value);
    const currentTax = parseFloat(document.getElementById('vs-current-tax').value) / 100;
    const retTax = parseFloat(document.getElementById('vs-ret-tax').value) / 100;

    // Roth: after-tax contributions, tax-free growth
    const rothBalance = calcRothBalance(contrib, years, rate, 0);
    const rothNet = rothBalance; // no tax on withdrawal

    // Traditional: pre-tax (same gross contrib), taxable at withdrawal
    const tradBalance = calcRothBalance(contrib / (1 - currentTax), years, rate, 0); // effectively same after-tax money invested more
    const tradTax = tradBalance * retTax;
    const tradNet = tradBalance - tradTax;

    showRothResults('⚖️ Roth vs Traditional IRA Comparison', rothBalance, contrib * years, 0);
    document.getElementById('vs-result-panel').classList.remove('hidden');
    document.getElementById('vs-roth-gross').textContent = fmtUSD(rothBalance);
    document.getElementById('vs-roth-net').textContent = fmtUSD(rothNet);
    document.getElementById('vs-trad-gross').textContent = fmtUSD(tradBalance);
    document.getElementById('vs-trad-tax').textContent = fmtUSD(tradTax);
    document.getElementById('vs-trad-net').textContent = fmtUSD(tradNet);
    const winner = rothNet >= tradNet ? 'roth' : 'trad';
    document.getElementById('vs-winner').textContent = winner === 'roth' ? '🏆 Roth IRA wins by ' + fmtUSD(rothNet - tradNet) + '!' : '🏆 Traditional IRA wins by ' + fmtUSD(tradNet - rothNet) + '!';
    document.getElementById('vs-winner').className = 'mt-3 p-3 rounded-xl text-xs font-bold text-center ' + (winner === 'roth' ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/30 dark:text-blue-300' : 'bg-amber-50 text-amber-700 dark:bg-amber-950/30 dark:text-amber-300');
    document.getElementById('roth-res-years').textContent = years + ' Years';
  });
  document.getElementById('btn-vs-clear')?.addEventListener('click', () => rothResults?.classList.add('hidden'));
</script>

