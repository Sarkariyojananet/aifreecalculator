---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Roth IRA Calculator – Tax-Free Retirement Growth Calculator 2025"
  description="Calculate your Roth IRA retirement balance, tax-free compound growth, annual contribution limits for 2025, and projected wealth at retirement age with this free Roth IRA calculator."
  category="Finance"
  calculatorName="Roth IRA Calculator"
  slug="roth-ira-calculator"
  keywords={[
    'roth ira calculator',
    'roth ira growth calculator',
    'roth ira contribution calculator',
    'roth ira retirement calculator',
    'roth ira vs traditional ira calculator',
    'roth ira compound interest calculator',
    'roth ira balance calculator',
    'roth ira limit 2025'
  ]}
>
  <div class="space-y-6">

    <!-- TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-roth-tab active shrink-0 rounded-lg bg-blue-700 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="growth">Roth IRA Growth Calculator</button>
        <button type="button" class="btn-roth-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="vs">Roth vs Traditional IRA ⚖️</button>
        <button type="button" class="btn-roth-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="limits">2025 Contribution Limits 📋</button>
      </div>
    </div>

    <!-- PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1">⚡ Quick Scenarios:</span>
        <button type="button" class="btn-roth-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-age="25" data-ret="65" data-contrib="7000" data-rate="7">🧑 Age 25 → Max $7,000/yr @ 7%</button>
        <button type="button" class="btn-roth-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-age="35" data-ret="65" data-contrib="7000" data-rate="7">👨 Age 35 → Max $7,000/yr @ 7%</button>
        <button type="button" class="btn-roth-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-age="50" data-ret="67" data-contrib="8000" data-rate="6">👴 Age 50 → Catch-up $8,000/yr @ 6%</button>
      </div>
    </div>

    <!-- MAIN PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-blue-50/20 to-indigo-50/20 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/10 sm:p-7">

      <!-- GROWTH PANEL -->
      <div id="panel-growth" class="roth-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>🇺🇸</span> Roth IRA Growth Calculator</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Calculate your Roth IRA balance at retirement. All growth is <strong>completely tax-free</strong> — you'll owe $0 in taxes on withdrawals in retirement.</p>
        </div>
        <form id="form-roth-growth" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div><label for="roth-age" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Current Age</label><input type="number" id="roth-age" value="30" min="18" max="72" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label for="roth-ret-age" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Retirement Age</label><input type="number" id="roth-ret-age" value="65" min="50" max="80" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label for="roth-contrib" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Annual Contribution ($)</label>
              <div class="flex items-center gap-2 mt-1.5">
                <input type="number" id="roth-contrib" value="7000" step="500" class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap">Max: $7,000</span>
              </div>
            </div>
            <div><label for="roth-existing" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Existing Roth IRA Balance ($)</label><input type="number" id="roth-existing" value="0" step="1000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label for="roth-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Expected Annual Return (%)</label><input type="number" id="roth-rate" value="7" step="0.5" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
            <div><label for="roth-tax-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Current Tax Rate (%) — for comparison</label><input type="number" id="roth-tax-rate" value="22" step="1" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" /></div>
