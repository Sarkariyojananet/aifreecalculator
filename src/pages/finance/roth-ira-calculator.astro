            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">💰 Tax Savings vs Taxable Account:</span>
              <div id="roth-res-taxsaved" class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400">$230,000 saved</div>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Total Contributed</div>
