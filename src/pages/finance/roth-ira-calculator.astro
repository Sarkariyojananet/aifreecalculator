      <!-- LIMITS PANEL -->
      <div id="panel-limits" class="roth-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>📋</span> 2025 Roth IRA Contribution Limits & Income Limits</h2>
        </div>
        <div class="space-y-4">
          <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-4 dark:border-blue-900/40 dark:bg-blue-950/20">
            <h3 class="font-bold text-blue-700 dark:text-blue-300 mb-2 text-sm">📌 2025 Contribution Limits</h3>
            <div class="space-y-1.5 text-xs">
              <div class="flex justify-between"><span>Under Age 50:</span><span class="font-bold">$7,000 per year</span></div>
              <div class="flex justify-between"><span>Age 50 and above (catch-up):</span><span class="font-bold">$8,000 per year</span></div>
              <div class="flex justify-between"><span>Combined (Roth + Traditional IRA):</span><span class="font-bold">Cannot exceed $7,000 / $8,000</span></div>
            </div>
          </div>
          <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-4 dark:border-amber-900/40 dark:bg-amber-950/20">
            <h3 class="font-bold text-amber-700 dark:text-amber-300 mb-2 text-sm">💰 2025 Income Limits (Phase-Out Ranges)</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-xs">
                <thead class="font-bold text-slate-600 dark:text-slate-400">
                  <tr><th class="p-1.5 text-left">Filing Status</th><th class="p-1.5 text-right">Full Contribution</th><th class="p-1.5 text-right">Phase-Out Range</th><th class="p-1.5 text-right">No Contribution</th></tr>
                </thead>
                <tbody class="divide-y divide-amber-100 dark:divide-amber-900/20">
                  <tr><td class="p-1.5 font-semibold">Single / Head of Household</td><td class="p-1.5 text-right">Up to $150,000</td><td class="p-1.5 text-right">$150K – $165K</td><td class="p-1.5 text-right">Above $165,000</td></tr>
                  <tr><td class="p-1.5 font-semibold">Married Filing Jointly</td><td class="p-1.5 text-right">Up to $236,000</td><td class="p-1.5 text-right">$236K – $246K</td><td class="p-1.5 text-right">Above $246,000</td></tr>
                  <tr><td class="p-1.5 font-semibold">Married Filing Separately</td><td class="p-1.5 text-right">$0</td><td class="p-1.5 text-right">$0 – $10,000</td><td class="p-1.5 text-right">Above $10,000</td></tr>
                </tbody>
              </table>
            </div>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">💡 <strong>Backdoor Roth IRA:</strong> If your income exceeds the limit, you can still contribute to a Traditional IRA and convert it to a Roth IRA — this is called a "backdoor Roth" and is legal.</p>
        </div>
      </div>

      <!-- RESULTS -->
      <div id="roth-results" class="hidden mt-6 space-y-5">
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-indigo-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="roth-badge" class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">🇺🇸 Roth IRA Balance at Retirement (Tax-Free)</span>
