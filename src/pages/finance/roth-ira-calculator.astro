            </div>
            <div class="space-y-3 text-xs w-full sm:w-auto">
              <div class="flex items-center justify-between gap-6 p-2 rounded-xl bg-blue-50/50 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/40">
                <span class="flex items-center gap-2 font-bold text-blue-700 dark:text-blue-300"><span class="w-3 h-3 rounded-full bg-blue-600 inline-block"></span> Contributed:</span>
                <span id="roth-legend-contrib" class="font-bold font-mono">$245,000</span>
              </div>
              <div class="flex items-center justify-between gap-6 p-2 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40">
                <span class="flex items-center gap-2 font-bold text-emerald-700 dark:text-emerald-300"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Tax-Free Growth:</span>
                <span id="roth-legend-growth" class="font-bold font-mono">$802,282</span>
              </div>
            </div>
          </div>
        </div>

        <!-- VS Comparison (hidden by default) -->
        <div id="vs-result-panel" class="hidden rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3">Roth IRA vs Traditional IRA — After-Tax Comparison</h3>
          <div class="grid grid-cols-2 gap-4 text-xs">
            <div class="rounded-xl border border-blue-200 bg-blue-50 p-4 dark:border-blue-800 dark:bg-blue-950/30">
              <div class="font-black text-blue-700 dark:text-blue-300 mb-2 text-sm">Roth IRA 🇺🇸</div>
              <div class="space-y-1 text-slate-600 dark:text-slate-300">
                <div class="flex justify-between"><span>Gross Balance:</span><span id="vs-roth-gross" class="font-bold">$—</span></div>
                <div class="flex justify-between"><span>Tax at Withdrawal:</span><span class="font-bold text-emerald-600">$0</span></div>
                <div class="flex justify-between font-bold"><span>Net After-Tax:</span><span id="vs-roth-net" class="text-blue-700">$—</span></div>
              </div>
            </div>
            <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 dark:border-amber-800 dark:bg-amber-950/30">
              <div class="font-black text-amber-700 dark:text-amber-300 mb-2 text-sm">Traditional IRA 📋</div>
              <div class="space-y-1 text-slate-600 dark:text-slate-300">
                <div class="flex justify-between"><span>Gross Balance:</span><span id="vs-trad-gross" class="font-bold">$—</span></div>
                <div class="flex justify-between"><span>Tax at Withdrawal:</span><span id="vs-trad-tax" class="font-bold text-red-600">$—</span></div>
                <div class="flex justify-between font-bold"><span>Net After-Tax:</span><span id="vs-trad-net" class="text-amber-700">$—</span></div>
              </div>
