            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Tax-Free Growth</div>
              <div id="roth-res-growth" class="mt-1 text-sm font-bold text-blue-600 dark:text-blue-400">$802,282</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Years Invested</div>
              <div id="roth-res-years" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">35 Years</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Tax on Withdrawal</div>
              <div class="mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400">$0 (Tax-Free!)</div>
            </div>
          </div>
        </div>

        <!-- Donut -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-1.5"><span>📊</span> Contributions vs Tax-Free Growth</h3>
          <div class="flex flex-col sm:flex-row items-center justify-around gap-6">
            <div class="relative w-40 h-40 flex items-center justify-center">
              <svg viewBox="0 0 36 36" class="w-full h-full transform -rotate-90">
                <circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="3.8"></circle>
                <circle id="roth-donut" cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="3.8" stroke-dasharray="77 23" stroke-dashoffset="0"></circle>
              </svg>
