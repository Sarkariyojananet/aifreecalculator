---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Loan Amortization Schedule Calculator – EMI, Interest & Repayment Table"
  description="Calculate your monthly loan payment, principal and interest breakdown, remaining balance, and complete loan amortization schedule."
  category="Finance"
  calculatorName="Loan Amortization Schedule Calculator"
  slug="amortization-calculator"
  keywords={[
    'loan amortization schedule calculator',
    'car loan amortization schedule calculator',
    'auto loan amortization schedule calculator',
    'commercial loan amortization schedule calculator',
    'loan amortization schedule calculator india',
    'home loan amortization schedule calculator india',
    'home loan amortization schedule calculator',
    'loan repayment schedule',
    'EMI repayment schedule',
    'principal and interest breakdown'
  ]}
>
  <div class="space-y-6">

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-am-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="general" data-amt="1000000" data-rate="8.5" data-term="60" data-freq="monthly" data-extra="0">💵 Personal ₹10L (8.5%, 5Y)</button>
        <button type="button" class="btn-am-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="home" data-amt="5000000" data-rate="8.5" data-term="240" data-freq="monthly" data-extra="5000">🏡 Home Loan ₹50L (8.5%, 20Y + ₹5k Extra)</button>
        <button type="button" class="btn-am-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="car" data-amt="1200000" data-rate="9.0" data-term="60" data-freq="monthly" data-extra="2000">🚗 Car Loan ₹12L (9%, 5Y + ₹2k Extra)</button>
        <button type="button" class="btn-am-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-type="commercial" data-amt="3000000" data-rate="10.5" data-term="84" data-freq="monthly" data-extra="0">🏢 Commercial ₹30L (10.5%, 7Y)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
        <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
          <span>📊</span> Loan Amortization Schedule Calculator
        </h2>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
          Calculate your regular payment, interest costs, principal reduction trajectory, and full amortization schedule.
        </p>
      </div>

      <form id="form-amortization" class="mt-4 space-y-4" novalidate onsubmit="return false;">
        
        <!-- LOAN TYPE SELECTOR -->
        <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Select Loan Type
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-xs font-bold">
            <button type="button" class="btn-loan-type active rounded-xl border border-blue-600 bg-blue-50 py-2.5 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer" data-type="general">General Loan</button>
            <button type="button" class="btn-loan-type rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer" data-type="home">Home Loan</button>
            <button type="button" class="btn-loan-type rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer" data-type="car">Car Loan</button>
            <button type="button" class="btn-loan-type rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer" data-type="auto">Auto Loan</button>
            <button type="button" class="btn-loan-type rounded-xl border border-slate-300 bg-white py-2.5 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer" data-type="commercial">Commercial Loan</button>
          </div>
        </div>

        <!-- MAIN LOAN INPUTS -->
        <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>💰</span> Loan Terms & Repayment Frequency
          </span>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <!-- Loan Amount -->
            <div>
              <label for="inp-am-amount" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Loan Amount (₹)</label>
              <input type="number" id="inp-am-amount" value="1000000" step="50000" min="1000" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10,00,000" />
            </div>

            <!-- Annual Interest Rate -->
            <div>
              <label for="inp-am-rate" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Annual Interest Rate (% p.a.)</label>
              <input type="number" id="inp-am-rate" value="8.5" step="0.1" min="0" max="40" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="8.5" />
            </div>

            <!-- Payment Frequency -->
            <div>
              <label for="sel-am-freq" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Payment Frequency</label>
              <select id="sel-am-freq" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">
                <option value="monthly" selected>Monthly (12 payments/year)</option>
                <option value="biweekly">Biweekly (26 payments/year)</option>
                <option value="weekly">Weekly (52 payments/year)</option>
              </select>
            </div>
          </div>

          <!-- Loan Term Inputs & Quick Presets -->
          <div class="pt-2 border-t border-slate-100 dark:border-slate-800 space-y-2">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label for="inp-am-term-val" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Loan Term</label>
                <div class="mt-1 flex rounded-xl border border-slate-300 bg-white dark:border-slate-700 dark:bg-slate-800">
                  <input type="number" id="inp-am-term-val" value="5" min="1" max="40" class="w-full rounded-l-xl border-0 p-2.5 text-sm font-bold text-slate-900 focus:ring-0 dark:bg-slate-800 dark:text-white" placeholder="5" />
                  <select id="sel-am-term-unit" class="rounded-r-xl border-l border-slate-300 bg-slate-50 px-3 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 cursor-pointer">
                    <option value="years" selected>Years</option>
                    <option value="months">Months</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="inp-am-start-date" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Loan Start Date</label>
                <input type="month" id="inp-am-start-date" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer" />
              </div>
            </div>

            <!-- Quick Term Buttons -->
            <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[11px]">
              <span class="text-slate-500 dark:text-slate-400 font-semibold mr-1">Quick Terms:</span>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="12">12M</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="24">24M</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="36">36M</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="48">48M</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="60">60M (5Y)</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="72">72M (6Y)</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="84">84M (7Y)</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="120">120M (10Y)</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="180">180M (15Y)</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="240">240M (20Y)</button>
              <button type="button" class="btn-am-term rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-months="300">300M (25Y)</button>
            </div>
          </div>
        </div>

        <!-- EXTRA LOAN PAYMENTS (ACCORDION) -->
        <details class="group rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            <span class="flex items-center gap-1.5">
              <span>🚀</span> Optional Extra Prepayments (Accelerate Payoff & Save Interest)
            </span>
            <span class="text-blue-600 dark:text-blue-400 font-semibold text-[11px] group-open:rotate-180 transition-transform">▼ Expand</span>
          </summary>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
            <div>
              <label for="inp-am-extra-period" class="block font-bold text-slate-700 dark:text-slate-300">Extra Payment Per Period (₹)</label>
              <input type="number" id="inp-am-extra-period" value="0" step="500" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>

            <div>
              <label for="inp-am-extra-annual" class="block font-bold text-slate-700 dark:text-slate-300">Annual Extra Payment (₹ / year)</label>
              <input type="number" id="inp-am-extra-annual" value="0" step="5000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>

            <div class="space-y-1">
              <label class="block font-bold text-slate-700 dark:text-slate-300">One-Time Lump Sum (₹ & Period #)</label>
              <div class="flex gap-2">
                <input type="number" id="inp-am-extra-onetime" value="0" step="10000" min="0" class="w-2/3 rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="₹ Amount" />
                <input type="number" id="inp-am-extra-onetime-period" value="12" min="1" max="360" class="w-1/3 rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" title="Period Number" placeholder="Period #" />
              </div>
            </div>
          </div>
        </details>

        <!-- ACTION BUTTONS -->
        <div class="flex items-center gap-2 pt-2">
          <button type="submit" id="btn-calc-am" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
            Calculate Amortization Schedule →
          </button>
          <button type="button" id="btn-clear-am" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
            Clear All (✕)
          </button>
        </div>

        <!-- ACCESSIBLE ERROR -->
        <p id="err-am" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

      </form>

      <!-- RESULTS PRESENTATION SECTION (Hidden initially) -->
      <div id="am-results-section" class="hidden mt-6 space-y-6">
        
        <!-- 1. MAIN PAYMENT RESULT HERO CARD -->
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="lbl-am-hero-payment" class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">ESTIMATED MONTHLY PAYMENT (EMI)</span>
              <div id="res-am-payment-hero" class="mt-1 text-3xl sm:text-4xl lg:text-5xl font-black text-blue-600 dark:text-blue-400">₹ 20,517</div>
              <div id="res-am-tagline" class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">Fixed principal & interest per payment period</div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Estimated Payoff Date:</span>
              <div id="res-am-payoff-date-hero" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">Sep 2031</div>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Loan Principal</div>
              <div id="res-am-principal" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹ 10,00,000</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Interest Rate & Term</div>
              <div id="res-am-rate-term" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">8.5% | 5 Yrs</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Interest Paid</div>
              <div id="res-am-total-int" class="mt-1 text-sm sm:text-base font-bold text-amber-600 dark:text-amber-400">₹ 2,30,992</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Amount Payable</div>
              <div id="res-am-total-payable" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹ 12,30,992</div>
            </div>
          </div>
        </div>

        <!-- 2. LOAN REPAYMENT SUMMARY -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-3">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>📋</span> Loan Repayment Summary
          </h3>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Loan Type</span>
              <span id="sum-am-type" class="font-bold text-slate-900 dark:text-white">General Loan</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Payment Frequency</span>
              <span id="sum-am-freq" class="font-bold text-slate-900 dark:text-white">Monthly</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Scheduled Payments</span>
              <span id="sum-am-periods-count" class="font-bold text-slate-900 dark:text-white">60 Payments</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Regular Installment</span>
              <span id="sum-am-reg-pay" class="font-bold text-slate-900 dark:text-white">₹ 20,517</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Total Principal</span>
              <span id="sum-am-principal" class="font-bold text-slate-900 dark:text-white">₹ 10,00,000</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Total Interest</span>
              <span id="sum-am-interest" class="font-bold text-amber-600 dark:text-amber-400">₹ 2,30,992</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Interest / Principal Ratio</span>
              <span id="sum-am-ratio" class="font-bold text-slate-900 dark:text-white">23.1%</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Payoff Date</span>
              <span id="sum-am-payoff" class="font-bold text-blue-600 dark:text-blue-400">Sep 2031</span>
            </div>
          </div>
        </div>

        <!-- 3. PRINCIPAL VS INTEREST ACCESSIBLE CHART -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>📈</span> Principal vs Interest Breakdown
            </h3>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">
              Visual proportion of total payments dedicated to borrowing costs
            </span>
          </div>

          <!-- Ratio Progress Bar -->
          <div class="space-y-2">
            <div class="h-4 w-full overflow-hidden rounded-full bg-slate-100 flex dark:bg-slate-800" role="progressbar" aria-label="Principal vs Interest Ratio">
              <div id="bar-am-principal" class="bg-emerald-500 transition-all duration-500" style="width: 81.2%;" title="Principal Portion"></div>
              <div id="bar-am-interest" class="bg-amber-500 transition-all duration-500" style="width: 18.8%;" title="Interest Portion"></div>
            </div>
            <div class="flex flex-wrap items-center justify-between text-xs font-semibold text-slate-600 dark:text-slate-400">
