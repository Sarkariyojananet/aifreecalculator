  // Tab-Selective Branded PDF Export
  async function generateAmortizationPdf() {
    if (!lastCalculatedAmortization) {
      alert('Please calculate your loan amortization schedule first.');
      return;
    }

    btnAmDownloadPdf.disabled = true;
    const originalText = txtBtnAmPdf.textContent;
    txtBtnAmPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      const pdfTitle = activeScheduleTab === 'yearly'
        ? 'Loan Amortization – Yearly Summary'
        : 'Loan Amortization – Detailed Repayment Schedule';

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(pdfTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 32, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('LOAN REPAYMENT SUMMARY', 18, 38);

      const typeNames = { general: 'General Loan', home: 'Home Loan', car: 'Car Loan', auto: 'Auto Loan', commercial: 'Commercial Loan' };
      const loanTypeName = typeNames[lastCalculatedAmortization.loanType] || 'General Loan';

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);
      doc.text(`Loan Type: ${loanTypeName}`, 18, 44);
      doc.text(`Loan Principal: Rs. ${Math.round(lastCalculatedAmortization.loanAmount).toLocaleString('en-IN')}`, 18, 49);
      doc.text(`Interest Rate: ${lastCalculatedAmortization.interestRateAnnual}% p.a.`, 18, 54);
      doc.text(`Loan Term: ${lastCalculatedAmortization.loanTermMonths} Months (${lastCalculatedAmortization.loanTermYears} Yrs)`, 18, 59);

      doc.text(`Payment Frequency: ${lastCalculatedAmortization.paymentFrequency.toUpperCase()}`, 85, 44);
      doc.text(`Regular Installment: Rs. ${Math.round(lastCalculatedAmortization.regularPayment).toLocaleString('en-IN')}`, 85, 49);
      doc.text(`Total Scheduled Payments: ${lastCalculatedAmortization.actualPeriodsCount}`, 85, 54);
      doc.text(`Payoff Date: ${lastCalculatedAmortization.payoffDate}`, 85, 59);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(217, 119, 6); // Amber
      doc.text(`Total Interest: Rs. ${Math.round(lastCalculatedAmortization.totalInterestPaid).toLocaleString('en-IN')}`, 145, 44);
      doc.setTextColor(15, 23, 42);
      doc.text(`Total Payable: Rs. ${Math.round(lastCalculatedAmortization.totalAmountPaid).toLocaleString('en-IN')}`, 145, 50);

      if (lastCalculatedAmortization.hasExtraPayments && lastCalculatedAmortization.interestSaved > 0) {
        doc.setTextColor(16, 185, 129); // Green
        doc.text(`Interest Saved: Rs. ${Math.round(lastCalculatedAmortization.interestSaved).toLocaleString('en-IN')}`, 145, 56);
      }

      // 4. Tab-Selective Table Data
      let tableHead = [];
      let tableData = [];

      if (activeScheduleTab === 'yearly') {
        tableHead = [['Year', 'Opening Bal', 'Principal Paid', 'Interest Paid', 'Extra Paid', 'Total Paid', 'Closing Balance']];
        tableData = lastCalculatedAmortization.yearlySchedule.map((r) => [
          `Year ${r.year}`,
          'Rs. ' + Math.round(r.openingBalance).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.principalPaid).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.interestPaid).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.extraPayments).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.totalPayments).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.closingBalance).toLocaleString('en-IN')
        ]);
      } else {
        tableHead = [['#', 'Date', 'Opening Bal', 'Payment', 'Principal', 'Interest', 'Extra', 'Total', 'Closing Bal']];
        tableData = lastCalculatedAmortization.detailedSchedule.map((r) => [
          `${r.period}`,
          r.dateStr,
          'Rs. ' + Math.round(r.openingBalance).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.regularPayment).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.principalPaid).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.interestPaid).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.extraPayment).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.totalPayment).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.closingBalance).toLocaleString('en-IN')
        ]);
      }

      doc.autoTable({
        startY: 70,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 7.5,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: activeScheduleTab === 'yearly' ? {
          0: { cellWidth: 16, halign: 'left', fontStyle: 'bold' },
          1: { halign: 'right' },
          2: { halign: 'right', fontStyle: 'bold', textColor: [16, 185, 129] },
          3: { halign: 'right', textColor: [217, 119, 6] },
          4: { halign: 'right', textColor: [37, 99, 235] },
          5: { halign: 'right', fontStyle: 'bold' },
          6: { halign: 'right', fontStyle: 'bold' }
        } : {
          0: { cellWidth: 10, halign: 'left', fontStyle: 'bold' },
          1: { cellWidth: 18, halign: 'left' },
          2: { halign: 'right' },
          3: { halign: 'right' },
          4: { halign: 'right', fontStyle: 'bold', textColor: [16, 185, 129] },
          5: { halign: 'right', textColor: [217, 119, 6] },
          6: { halign: 'right', textColor: [37, 99, 235] },
          7: { halign: 'right', fontStyle: 'bold' },
          8: { halign: 'right', fontStyle: 'bold' }
        },
        styles: {
          fontSize: 7,
          cellPadding: 1.8,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const todayStr = new Date().toISOString().split('T')[0];
      const filename = activeScheduleTab === 'yearly'
        ? `loan-amortization-yearly-summary-${todayStr}.pdf`
        : `loan-amortization-detailed-schedule-${todayStr}.pdf`;
      doc.save(filename);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnAmDownloadPdf.disabled = false;
      txtBtnAmPdf.textContent = originalText;
    }
  }

  btnAmDownloadPdf.addEventListener('click', generateAmortizationPdf);
</script>
