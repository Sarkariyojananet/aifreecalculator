  // Update detailed tab label based on frequency
  function updateDetailedTabLabel() {
    const freq = selAmFreq.value;
    if (freq === 'biweekly') {
      tabAmDetailed.textContent = 'Biweekly Schedule';
    } else if (freq === 'weekly') {
      tabAmDetailed.textContent = 'Weekly Schedule';
    } else {
      tabAmDetailed.textContent = 'Monthly Schedule';
    }
  }
  selAmFreq.addEventListener('change', updateDetailedTabLabel);

  // Helper date formatter
  function getPeriodDateStr(baseStr, period, frequency) {
    const baseDate = baseStr ? new Date(`${baseStr}-01`) : new Date();
    if (isNaN(baseDate.getTime())) baseDate.setTime(Date.now());

    if (frequency === 'monthly') {
      const d = new Date(baseDate.getFullYear(), baseDate.getMonth() + (period - 1), 1);
      return d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
    } else if (frequency === 'biweekly') {
      const d = new Date(baseDate.getTime() + (period - 1) * 14 * 24 * 60 * 60 * 1000);
      return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    } else {
      const d = new Date(baseDate.getTime() + (period - 1) * 7 * 24 * 60 * 60 * 1000);
      return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }
  }

  // Master Calculation Execution
  function executeAmortizationCalculation() {
    errAm.classList.add('hidden');

    const P = parseFloat(inpAmAmount.value);
    if (isNaN(P) || P <= 0) {
      errAm.textContent = 'Loan amount must be greater than 0.';
      errAm.classList.remove('hidden');
      amResultsSection.classList.add('hidden');
      return;
    }

    const annualRate = parseFloat(inpAmRate.value);
    if (isNaN(annualRate) || annualRate < 0) {
      errAm.textContent = 'Annual interest rate cannot be negative.';
      errAm.classList.remove('hidden');
      amResultsSection.classList.add('hidden');
      return;
    }

    const termRaw = parseFloat(inpAmTermVal.value);
    if (isNaN(termRaw) || termRaw <= 0) {
      errAm.textContent = 'Loan term must be greater than 0.';
      errAm.classList.remove('hidden');
      amResultsSection.classList.add('hidden');
      return;
    }

    const termUnit = selAmTermUnit.value;
    const termMonths = termUnit === 'years' ? Math.round(termRaw * 12) : Math.round(termRaw);
    const termYears = termMonths / 12;

    const freq = selAmFreq.value; // 'monthly' | 'biweekly' | 'weekly'
    let periodsPerYear = 12;
    if (freq === 'biweekly') periodsPerYear = 26;
    if (freq === 'weekly') periodsPerYear = 52;

    const totalScheduledPeriods = Math.round(termYears * periodsPerYear);
    const periodicRate = annualRate / periodsPerYear / 100;

    // Regular payment calculation
    let regularPayment = 0;
    if (periodicRate === 0) {
      regularPayment = P / totalScheduledPeriods;
    } else {
      const factor = Math.pow(1 + periodicRate, totalScheduledPeriods);
      regularPayment = (P * periodicRate * factor) / (factor - 1);
    }
    regularPayment = Math.round(regularPayment);

    const startDate = inpAmStartDate.value || curMonthStr;

    // Extra Payments
    const extraPeriod = Math.max(0, parseFloat(inpAmExtraPeriod.value) || 0);
    const extraAnnual = Math.max(0, parseFloat(inpAmExtraAnnual.value) || 0);
    const extraOneTime = Math.max(0, parseFloat(inpAmExtraOneTime.value) || 0);
    const extraOneTimePeriod = Math.max(1, parseInt(inpAmExtraOneTimePeriod.value) || 1);
    const hasExtra = extraPeriod > 0 || extraAnnual > 0 || extraOneTime > 0;

    // Baseline Total Interest (without extra payments)
    let baselineInterest = 0;
    let baseBal = P;
    for (let p = 1; p <= totalScheduledPeriods; p++) {
      const int = Math.round(baseBal * periodicRate);
      baselineInterest += int;
      let prin = regularPayment - int;
      if (baseBal <= prin) {
        baseBal = 0;
        break;
      } else {
        baseBal -= prin;
      }
    }
    const origPayoffDate = getPeriodDateStr(startDate, totalScheduledPeriods, freq);

    // Generate Full Schedule
    const detailedSchedule = [];
    let balance = P;
    let totalPrincipalPaid = 0;
    let totalInterestPaid = 0;
    let totalExtraPaid = 0;
    let period = 0;
    const maxPeriods = totalScheduledPeriods * 2;

    while (balance > 0.001 && period < maxPeriods) {
      period++;
      const openingBalance = balance;
      const interest = Math.round(balance * periodicRate);
      totalInterestPaid += interest;

      let scheduledPrincipal = regularPayment - interest;
      let extra = extraPeriod;

      if (extraOneTime > 0 && period === extraOneTimePeriod) {
        extra += extraOneTime;
      }
      if (extraAnnual > 0 && period % periodsPerYear === 0) {
        extra += extraAnnual;
      }

      let actualPrincipal = scheduledPrincipal;
      let periodTotalPayment = 0;

      if (balance <= scheduledPrincipal + extra) {
        actualPrincipal = balance;
        extra = Math.max(0, balance - scheduledPrincipal);
        if (extra > 0) {
          actualPrincipal = balance - extra;
        }
        periodTotalPayment = actualPrincipal + interest + extra;
        totalPrincipalPaid += actualPrincipal;
        totalExtraPaid += extra;
        balance = 0;
      } else {
        actualPrincipal = scheduledPrincipal;
        totalPrincipalPaid += actualPrincipal;
        totalExtraPaid += extra;
        balance = balance - (actualPrincipal + extra);
        periodTotalPayment = actualPrincipal + interest + extra;
      }

      detailedSchedule.push({
        period,
        dateStr: getPeriodDateStr(startDate, period, freq),
        openingBalance,
        regularPayment: actualPrincipal + interest,
        principalPaid: actualPrincipal,
        interestPaid: interest,
        extraPayment: extra,
        totalPayment: periodTotalPayment,
        closingBalance: Math.max(0, balance),
      });

      if (balance <= 0) break;
    }

    const actualPeriodsCount = period;
    const newPayoffDate = detailedSchedule[detailedSchedule.length - 1].dateStr;
    const totalAmountPaid = P + totalInterestPaid;

    // Yearly Rollup
    const yearlySchedule = [];
    let currentYear = 1;
    let yearOpen = P;
    let yearPrincipal = 0;
    let yearInterest = 0;
    let yearExtra = 0;
    let yearTotal = 0;

    for (let i = 0; i < detailedSchedule.length; i++) {
      const row = detailedSchedule[i];
      if (i === 0) yearOpen = row.openingBalance;

      yearPrincipal += row.principalPaid;
      yearInterest += row.interestPaid;
      yearExtra += row.extraPayment;
      yearTotal += row.totalPayment;

      const isYearEnd = (row.period % periodsPerYear === 0) || (i === detailedSchedule.length - 1);

      if (isYearEnd) {
        yearlySchedule.push({
          year: currentYear,
          openingBalance: yearOpen,
          principalPaid: yearPrincipal,
          interestPaid: yearInterest,
          extraPayments: yearExtra,
          totalPayments: yearTotal,
          closingBalance: row.closingBalance,
        });

        currentYear++;
        yearOpen = row.closingBalance;
        yearPrincipal = 0;
        yearInterest = 0;
        yearExtra = 0;
        yearTotal = 0;
      }
    }

    // Savings Calculation
    const interestSaved = Math.max(0, baselineInterest - totalInterestPaid);
    const periodsSaved = Math.max(0, totalScheduledPeriods - actualPeriodsCount);
    const timeSavedMonths = Math.round((periodsSaved / periodsPerYear) * 12);

    // Save State
    lastCalculatedAmortization = {
      loanType: currentLoanType,
      loanAmount: P,
      interestRateAnnual: annualRate,
      loanTermMonths: termMonths,
      loanTermYears: termYears,
      paymentFrequency: freq,
      periodsPerYear,
      totalPeriodsScheduled: totalScheduledPeriods,
      regularPayment,
      totalPrincipalPaid,
      totalInterestPaid,
      totalAmountPaid,
      totalExtraPaid,
      actualPeriodsCount,
      payoffDate: newPayoffDate,
      originalPayoffDate: origPayoffDate,
      hasExtraPayments: hasExtra,
      interestSaved,
      timeSavedMonths,
      yearlySchedule,
      detailedSchedule,
    };

    // Update Hero Card
    if (freq === 'biweekly') {
      lblAmHeroPayment.textContent = 'ESTIMATED BIWEEKLY PAYMENT';
    } else if (freq === 'weekly') {
      lblAmHeroPayment.textContent = 'ESTIMATED WEEKLY PAYMENT';
    } else {
      lblAmHeroPayment.textContent = 'ESTIMATED MONTHLY PAYMENT (EMI)';
    }

    resAmPaymentHero.textContent = formatINR(regularPayment);
    resAmPayoffDateHero.textContent = newPayoffDate;
    resAmPrincipal.textContent = formatINR(P);
    resAmRateTerm.textContent = `${annualRate}% | ${termYears >= 1 ? termYears + ' Yrs' : termMonths + ' Mos'}`;
    resAmTotalInt.textContent = formatINR(totalInterestPaid);
    resAmTotalPayable.textContent = formatINR(totalAmountPaid);

    // Update Summary Grid
    const typeNames = { general: 'General Loan', home: 'Home Loan', car: 'Car Loan', auto: 'Auto Loan', commercial: 'Commercial Loan' };
    sumAmType.textContent = typeNames[currentLoanType] || 'General Loan';
    sumAmFreq.textContent = freq.charAt(0).toUpperCase() + freq.slice(1);
    sumAmPeriodsCount.textContent = `${actualPeriodsCount} of ${totalScheduledPeriods}`;
    sumAmRegPay.textContent = formatINR(regularPayment);
    sumAmPrincipal.textContent = formatINR(P);
    sumAmInterest.textContent = formatINR(totalInterestPaid);
    sumAmRatio.textContent = `${((totalInterestPaid / P) * 100).toFixed(1)}%`;
    sumAmPayoff.textContent = newPayoffDate;

    // Update Ratio Chart
    const principalPct = totalAmountPaid > 0 ? (P / totalAmountPaid) * 100 : 100;
    const interestPct = totalAmountPaid > 0 ? (totalInterestPaid / totalAmountPaid) * 100 : 0;
    barAmPrincipal.style.width = `${principalPct.toFixed(1)}%`;
    barAmInterest.style.width = `${interestPct.toFixed(1)}%`;
    lblChartAmPrincipal.textContent = `Principal: ${formatINR(P)} (${principalPct.toFixed(1)}%)`;
    lblChartAmInterest.textContent = `Total Interest: ${formatINR(totalInterestPaid)} (${interestPct.toFixed(1)}%)`;

    // Update Extra Payment Comparison
    if (hasExtra && (interestSaved > 0 || periodsSaved > 0)) {
      cardAmExtraComp.classList.remove('hidden');
      badgeAmSavedTime.textContent = timeSavedMonths >= 12
        ? `Saved ${(timeSavedMonths / 12).toFixed(1)} Years`
        : `Saved ${timeSavedMonths} Months`;
      compAmIntSaved.textContent = formatINR(interestSaved);
      compAmTimeSaved.textContent = timeSavedMonths >= 12
        ? `${(timeSavedMonths / 12).toFixed(1)} Years (${timeSavedMonths} Months)`
        : `${timeSavedMonths} Months`;
      compAmOrigPayoff.textContent = origPayoffDate;
      compAmNewPayoff.textContent = newPayoffDate;
    } else {
      cardAmExtraComp.classList.add('hidden');
    }

    // Render Table
    renderAmScheduleTable();

    amResultsSection.classList.remove('hidden');
  }

  // Render Table
  function renderAmScheduleTable() {
    if (!lastCalculatedAmortization) return;

