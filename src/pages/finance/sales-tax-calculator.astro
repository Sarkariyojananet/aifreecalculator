<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // State
  let activeSalesTaxMode = 'add'; // 'add' | 'reverse' | 'car'
  let lastCalculatedSalesTax = null;

  // DOM Elements
  const lblStAmount = document.getElementById('lbl-st-amount');
  const inpStAmount = document.getElementById('inp-st-amount');
  const inpStRate = document.getElementById('inp-st-rate');
  const selStLocation = document.getElementById('sel-st-location');
  const badgeStLocation = document.getElementById('badge-st-location');
  const txtStSubtitle = document.getElementById('txt-st-subtitle');

  const secStCarInputs = document.getElementById('sec-st-car-inputs');
  const inpStTradeIn = document.getElementById('inp-st-tradein');
  const inpStRebate = document.getElementById('inp-st-rebate');
  const inpStFees = document.getElementById('inp-st-fees');

  const btnCalcSt = document.getElementById('btn-calc-st');
  const btnClearSt = document.getElementById('btn-clear-st');
  const errSt = document.getElementById('err-st');

  // Results Elements
  const stResultsSection = document.getElementById('st-results-section');
  const lblStHeroTitle = document.getElementById('lbl-st-hero-title');
  const resStHeroAmount = document.getElementById('res-st-hero-amount');
  const resStHeroSubtitle = document.getElementById('res-st-hero-subtitle');
  const lblStHeroSecondary = document.getElementById('lbl-st-hero-secondary');
  const resStHeroSecondary = document.getElementById('res-st-hero-secondary');

  const lblStGrid1 = document.getElementById('lbl-st-grid-1');
  const resStGrid1 = document.getElementById('res-st-grid-1');
  const resStGrid2 = document.getElementById('res-st-grid-2');
  const resStGrid3 = document.getElementById('res-st-grid-3');
  const lblStGrid4 = document.getElementById('lbl-st-grid-4');
  const resStGrid4 = document.getElementById('res-st-grid-4');

  const txtStFormulaName = document.getElementById('txt-st-formula-name');
  const txtStBreakdownFormula = document.getElementById('txt-st-breakdown-formula');
  const txtStBreakdownStep1 = document.getElementById('txt-st-breakdown-step1');
  const txtStBreakdownStep2 = document.getElementById('txt-st-breakdown-step2');

  const tblStComparison = document.getElementById('tbl-st-comparison');
  const btnStDownloadPdf = document.getElementById('btn-st-download-pdf');
  const txtBtnStPdf = document.getElementById('txt-btn-st-pdf');

  // Currency Formatter
  function formatMoney(val) {
    const num = Number(val);
    if (isNaN(num)) return '$0.00';
    return '$' + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Preset Location Rates Map
  const locationRates = {
    custom: 7.0,
    ca: 7.25,
    nj: 6.625,
    ny: 4.0,
    nyc: 8.875,
    mo: 4.225,
    oh: 5.75,
    mn: 6.875,
  };

  const locationNames = {
    custom: 'Custom Tax Rate',
    ca: 'California Estimate (7.25%)',
    nj: 'New Jersey Estimate (6.625%)',
    ny: 'New York State (4.00%)',
    nyc: 'New York City (8.875%)',
    mo: 'Missouri Estimate (4.225%)',
    oh: 'Ohio Estimate (5.75%)',
    mn: 'Minnesota Estimate (6.875%)',
  };

  // Location Selector Handler
  selStLocation.addEventListener('change', () => {
    const loc = selStLocation.value;
    if (loc in locationRates) {
      inpStRate.value = `${locationRates[loc]}`;
      if (loc === 'custom') {
        badgeStLocation.textContent = 'Custom Rate Applied';
      } else {
        badgeStLocation.textContent = locationNames[loc];
      }
    }
  });

  // Location Badges Handler
  document.querySelectorAll('.btn-st-loc-badge').forEach((btn) => {
    btn.addEventListener('click', () => {
      const loc = btn.getAttribute('data-loc');
      const rate = btn.getAttribute('data-rate');
      selStLocation.value = loc;
      inpStRate.value = rate;
      badgeStLocation.textContent = locationNames[loc] || 'Custom Rate Applied';
    });
  });

  // Manual Rate Edit
  inpStRate.addEventListener('input', () => {
    const r = parseFloat(inpStRate.value);
    let matched = false;
    for (const [key, val] of Object.entries(locationRates)) {
      if (key !== 'custom' && Math.abs(val - r) < 0.0001) {
        selStLocation.value = key;
        badgeStLocation.textContent = locationNames[key];
        matched = true;
        break;
      }
    }
    if (!matched) {
      selStLocation.value = 'custom';
      badgeStLocation.textContent = 'Custom Rate Applied';
    }
  });

  // Mode Switcher Handler
  document.querySelectorAll('.btn-st-mode').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-st-mode').forEach((b) => {
        b.className = 'btn-st-mode rounded-xl border border-slate-300 bg-white px-4 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center';
      });
      btn.className = 'btn-st-mode active rounded-xl border border-blue-600 bg-blue-50 px-4 py-2 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer text-center';
      
      activeSalesTaxMode = btn.getAttribute('data-mode') || 'add';
      stResultsSection.classList.add('hidden');
      lastCalculatedSalesTax = null;

      if (activeSalesTaxMode === 'add') {
        lblStAmount.textContent = 'Price Before Tax ($ / ₹)';
        inpStAmount.placeholder = '1,000';
        secStCarInputs.classList.add('hidden');
        txtStSubtitle.textContent = 'Calculate sales tax amount and total purchase cost using a custom or state estimated tax rate.';
      } else if (activeSalesTaxMode === 'reverse') {
        lblStAmount.textContent = 'Total Price Including Tax ($ / ₹)';
        inpStAmount.placeholder = '1,072.50';
        secStCarInputs.classList.add('hidden');
        txtStSubtitle.textContent = 'Extract the original price before tax and tax amount from a tax-inclusive total price.';
      } else {
        // Car Mode
        lblStAmount.textContent = 'Vehicle Purchase Price ($ / ₹)';
        inpStAmount.placeholder = '30,000';
        secStCarInputs.classList.remove('hidden');
        txtStSubtitle.textContent = 'Estimate vehicle sales tax factoring in trade-in allowances, rebates, and taxable dealer fees.';
      }
    });
  });

  // Master Calculation Execution
  function executeSalesTaxCalculation() {
    errSt.classList.add('hidden');

    const amt = parseFloat(inpStAmount.value);
    if (isNaN(amt) || amt < 0) {
      errSt.textContent = 'Please enter a valid price amount (0 or greater).';
      errSt.classList.remove('hidden');
      stResultsSection.classList.add('hidden');
      return;
    }

    if (activeSalesTaxMode === 'car' && amt <= 0) {
      errSt.textContent = 'Vehicle purchase price must be greater than 0.';
      errSt.classList.remove('hidden');
      stResultsSection.classList.add('hidden');
      return;
    }

    const rate = parseFloat(inpStRate.value);
    if (isNaN(rate) || rate < 0) {
      errSt.textContent = 'Sales tax rate cannot be negative.';
      errSt.classList.remove('hidden');
      stResultsSection.classList.add('hidden');
      return;
    }

    const tradeIn = activeSalesTaxMode === 'car' ? Math.max(0, parseFloat(inpStTradeIn.value) || 0) : 0;
    const rebate = activeSalesTaxMode === 'car' ? Math.max(0, parseFloat(inpStRebate.value) || 0) : 0;
    const fees = activeSalesTaxMode === 'car' ? Math.max(0, parseFloat(inpStFees.value) || 0) : 0;

    let priceBeforeTax = 0;
    let salesTaxAmount = 0;
    let totalPriceWithTax = 0;
    let taxableAmount = 0;

    let formulaText = '';
    let step1Text = '';
    let step2Text = '';

    if (activeSalesTaxMode === 'add') {
      priceBeforeTax = amt;
      salesTaxAmount = Number(((priceBeforeTax * rate) / 100).toFixed(2));
      totalPriceWithTax = Number((priceBeforeTax + salesTaxAmount).toFixed(2));

      formulaText = 'Tax = Price × (Rate ÷ 100) | Total = Price + Tax';
      step1Text = `${formatMoney(priceBeforeTax)} × (${rate}% ÷ 100) = ${formatMoney(salesTaxAmount)} Tax`;
      step2Text = `${formatMoney(priceBeforeTax)} + ${formatMoney(salesTaxAmount)} = ${formatMoney(totalPriceWithTax)} Total`;

      lblStHeroTitle.textContent = 'TOTAL PRICE INCLUDING TAX';
      resStHeroAmount.textContent = formatMoney(totalPriceWithTax);
      resStHeroSubtitle.textContent = `Calculated using ${rate}% Sales Tax Rate`;
      lblStHeroSecondary.textContent = 'Sales Tax Added:';
      resStHeroSecondary.textContent = `+ ${formatMoney(salesTaxAmount)}`;

      lblStGrid1.textContent = 'Price Before Tax';
      resStGrid1.textContent = formatMoney(priceBeforeTax);
      resStGrid2.textContent = `${rate}%`;
      resStGrid3.textContent = formatMoney(salesTaxAmount);
      lblStGrid4.textContent = 'Total Price';
      resStGrid4.textContent = formatMoney(totalPriceWithTax);
      txtStFormulaName.textContent = 'Standard Sales Tax Formula';
    } else if (activeSalesTaxMode === 'reverse') {
      totalPriceWithTax = amt;
      if (rate === 0) {
        priceBeforeTax = totalPriceWithTax;
        salesTaxAmount = 0;
      } else {
        priceBeforeTax = Number((totalPriceWithTax / (1 + rate / 100)).toFixed(2));
        salesTaxAmount = Number((totalPriceWithTax - priceBeforeTax).toFixed(2));
      }

      formulaText = 'Pre-Tax Price = Total Price ÷ (1 + Rate ÷ 100)';
      step1Text = `${formatMoney(totalPriceWithTax)} ÷ (1 + ${rate / 100}) = ${formatMoney(priceBeforeTax)} Base Price`;
      step2Text = `${formatMoney(totalPriceWithTax)} − ${formatMoney(priceBeforeTax)} = ${formatMoney(salesTaxAmount)} Tax Included`;

      lblStHeroTitle.textContent = 'ORIGINAL PRICE BEFORE TAX';
      resStHeroAmount.textContent = formatMoney(priceBeforeTax);
      resStHeroSubtitle.textContent = `Extracted from ${formatMoney(totalPriceWithTax)} at ${rate}% Tax`;
      lblStHeroSecondary.textContent = 'Sales Tax Included:';
      resStHeroSecondary.textContent = formatMoney(salesTaxAmount);

      lblStGrid1.textContent = 'Total Price (Gross)';
      resStGrid1.textContent = formatMoney(totalPriceWithTax);
      resStGrid2.textContent = `${rate}%`;
      resStGrid3.textContent = formatMoney(salesTaxAmount);
      lblStGrid4.textContent = 'Price Before Tax (Net)';
      resStGrid4.textContent = formatMoney(priceBeforeTax);
      txtStFormulaName.textContent = 'Reverse Sales Tax Formula';
    } else {
      // Car Mode
      const vehiclePrice = amt;
      taxableAmount = Math.max(0, vehiclePrice - tradeIn - rebate + fees);
      salesTaxAmount = Number(((taxableAmount * rate) / 100).toFixed(2));
      totalPriceWithTax = Number((vehiclePrice - tradeIn - rebate + fees + salesTaxAmount).toFixed(2));
      priceBeforeTax = vehiclePrice;

      formulaText = 'Taxable Amount = Price − Trade-in − Rebate + Fees | Tax = Taxable × Rate';
      step1Text = `(${formatMoney(vehiclePrice)} − ${formatMoney(tradeIn)} − ${formatMoney(rebate)} + ${formatMoney(fees)}) = ${formatMoney(taxableAmount)} Taxable`;
      step2Text = `${formatMoney(taxableAmount)} × ${rate}% = ${formatMoney(salesTaxAmount)} Tax | Total: ${formatMoney(totalPriceWithTax)}`;

      lblStHeroTitle.textContent = 'ESTIMATED VEHICLE SALES TAX';
      resStHeroAmount.textContent = formatMoney(salesTaxAmount);
      resStHeroSubtitle.textContent = `Applied to ${formatMoney(taxableAmount)} taxable basis at ${rate}%`;
      lblStHeroSecondary.textContent = 'Total Estimated Cost:';
      resStHeroSecondary.textContent = formatMoney(totalPriceWithTax);

      lblStGrid1.textContent = 'Vehicle Price';
      resStGrid1.textContent = formatMoney(vehiclePrice);
      resStGrid2.textContent = `${rate}% (Taxable: ${formatMoney(taxableAmount)})`;
      resStGrid3.textContent = formatMoney(salesTaxAmount);
      lblStGrid4.textContent = 'Final Out-of-Pocket';
      resStGrid4.textContent = formatMoney(totalPriceWithTax);
      txtStFormulaName.textContent = 'Vehicle Sales Tax Formula';
    }

    // Step-by-step UI Update
    txtStBreakdownFormula.textContent = formulaText;
    txtStBreakdownStep1.textContent = step1Text;
    txtStBreakdownStep2.textContent = step2Text;

    // Tax Rate Comparison Matrix
    const baseForComp = activeSalesTaxMode === 'car' ? taxableAmount : priceBeforeTax;
    const ratesList = [5.0, 6.0, 7.0, 8.0, 9.0];
    if (!ratesList.includes(rate)) {
      ratesList.push(rate);
      ratesList.sort((a, b) => a - b);
    }

    tblStComparison.innerHTML = ratesList.map((r) => {
      const tax = Number(((baseForComp * r) / 100).toFixed(2));
      const tot = Number((baseForComp + tax).toFixed(2));
      const isCur = Math.abs(r - rate) < 0.0001;

      return `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 ${isCur ? 'bg-blue-50/50 dark:bg-blue-950/30 font-bold' : ''}">
          <td class="p-2.5 font-sans font-bold text-slate-900 dark:text-white">
            ${r}% ${isCur ? '<span class="text-blue-600 dark:text-blue-400 text-[11px]">(Selected)</span>' : ''}
          </td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatMoney(tax)}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatMoney(tot)}</td>
        </tr>
      `;
    }).join('');

    // Save State
    lastCalculatedSalesTax = {
      mode: activeSalesTaxMode,
      locationName: selStLocation.options[selStLocation.selectedIndex].text,
      amount: amt,
      rate,
      priceBeforeTax,
      salesTaxAmount,
      totalPriceWithTax,
      tradeIn,
      rebate,
      fees,
      taxableAmount,
      ratesList: ratesList.map((r) => ({
        rate: r,
        tax: Number(((baseForComp * r) / 100).toFixed(2)),
        tot: Number((baseForComp + ((baseForComp * r) / 100)).toFixed(2)),
        isCurrent: Math.abs(r - rate) < 0.0001,
      })),
    };

    stResultsSection.classList.remove('hidden');
  }

  // Clear All Button
  btnClearSt.addEventListener('click', () => {
    const addModeBtn = document.querySelector('.btn-st-mode[data-mode="add"]');
    if (addModeBtn) addModeBtn.click();

    inpStAmount.value = '1000';
    inpStRate.value = '7.25';
    selStLocation.value = 'ca';
    badgeStLocation.textContent = 'California Estimate (7.25%)';

    inpStTradeIn.value = '5000';
    inpStRebate.value = '1500';
    inpStFees.value = '500';

    errSt.classList.add('hidden');
    stResultsSection.classList.add('hidden');
    lastCalculatedSalesTax = null;
  });

  // Calculate Button
  btnCalcSt.addEventListener('click', executeSalesTaxCalculation);

  // Enter Key Triggers Calculation
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeSalesTaxCalculation();
        }
      });
    });
  });

  // Tab-Selective Branded PDF Export
  async function generateSalesTaxPdf() {
    if (!lastCalculatedSalesTax) {
      alert('Please calculate your sales tax first.');
      return;
    }

    btnStDownloadPdf.disabled = true;
    const originalText = txtBtnStPdf.textContent;
    txtBtnStPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      let docTitle = 'Sales Tax Calculation';
      let filenamePrefix = 'sales-tax-calculation';
      if (lastCalculatedSalesTax.mode === 'reverse') {
        docTitle = 'Reverse Sales Tax Calculation';
        filenamePrefix = 'reverse-sales-tax-calculation';
      } else if (lastCalculatedSalesTax.mode === 'car') {
        docTitle = 'Car Sales Tax Calculation';
        filenamePrefix = 'car-sales-tax-calculation';
      }

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(docTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 32, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('SALES TAX SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);

      if (lastCalculatedSalesTax.mode === 'car') {
        doc.text(`Vehicle Price: $${lastCalculatedSalesTax.priceBeforeTax.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 44);
        doc.text(`Trade-In Credit: $${lastCalculatedSalesTax.tradeIn.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 49);
        doc.text(`Rebates / Discount: $${lastCalculatedSalesTax.rebate.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 54);
        doc.text(`Taxable Basis: $${lastCalculatedSalesTax.taxableAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 59);

        doc.text(`Tax Rate: ${lastCalculatedSalesTax.rate}%`, 85, 44);
        doc.text(`Location: ${lastCalculatedSalesTax.locationName}`, 85, 49);
        doc.text(`Taxable Fees: $${lastCalculatedSalesTax.fees.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 85, 54);

        doc.setFont('helvetica', 'bold');
        doc.setTextColor(16, 185, 129);
        doc.text(`Sales Tax: $${lastCalculatedSalesTax.salesTaxAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 145, 44);
        doc.setTextColor(37, 99, 235);
        doc.text(`Total Cost: $${lastCalculatedSalesTax.totalPriceWithTax.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 145, 50);
      } else {
        doc.text(`Pre-Tax Price: $${lastCalculatedSalesTax.priceBeforeTax.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 18, 44);
        doc.text(`Sales Tax Rate: ${lastCalculatedSalesTax.rate}%`, 18, 49);
        doc.text(`Location Preset: ${lastCalculatedSalesTax.locationName}`, 18, 54);

        doc.setFont('helvetica', 'bold');
        doc.setTextColor(16, 185, 129);
        doc.text(`Sales Tax Amount: $${lastCalculatedSalesTax.salesTaxAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 85, 44);
        doc.setTextColor(37, 99, 235);
        doc.text(`Total Amount: $${lastCalculatedSalesTax.totalPriceWithTax.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 85, 50);
      }

      // 4. Comparison Table
      const tableHead = [['Sales Tax Rate', 'Tax Amount', 'Total Purchase Price']];
      const tableData = lastCalculatedSalesTax.ratesList.map((r) => [
        `${r.rate}% ${r.isCurrent ? '(Selected)' : ''}`,
        `$${r.tax.toLocaleString('en-US', { minimumFractionDigits: 2 })}`,
        `$${r.tot.toLocaleString('en-US', { minimumFractionDigits: 2 })}`
      ]);

      doc.autoTable({
        startY: 70,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { halign: 'left', fontStyle: 'bold' },
          1: { halign: 'right', fontStyle: 'bold', textColor: [16, 185, 129] },
          2: { halign: 'right', fontStyle: 'bold', textColor: [37, 99, 235] }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2.2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const todayStr = new Date().toISOString().split('T')[0];
      doc.save(`${filenamePrefix}-${todayStr}.pdf`);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnStDownloadPdf.disabled = false;
      txtBtnStPdf.textContent = originalText;
    }
  }

  btnStDownloadPdf.addEventListener('click', generateSalesTaxPdf);
</script>
