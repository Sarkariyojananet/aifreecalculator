</style>

<script is:inline>
  const npsTabs = document.querySelectorAll('.btn-nps-tab');
  const npsPanels = document.querySelectorAll('.nps-panel');
  const npsResults = document.getElementById('nps-results');

  npsTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      npsTabs.forEach(t => { t.classList.remove('bg-blue-600','text-white','shadow-xs'); t.classList.add('border','border-slate-300','bg-white','text-slate-700','dark:border-slate-700','dark:bg-slate-800','dark:text-slate-200'); });
      tab.classList.add('bg-blue-600','text-white','shadow-xs');
      tab.classList.remove('border','border-slate-300','bg-white','text-slate-700');
      npsPanels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');
      npsResults?.classList.add('hidden');
    });
  });

  document.querySelectorAll('.btn-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('nps-age').value = btn.dataset.age;
      document.getElementById('nps-ret-age').value = btn.dataset.ret;
      document.getElementById('nps-contrib').value = btn.dataset.contrib;
      document.getElementById('nps-return').value = btn.dataset.retRate;
    });
  });

  function fmtINR(n) { return '₹' + Math.round(n).toLocaleString('en-IN'); }

  function showNPSResults(corpus, invested, badge) {
    const annuityPct = parseFloat(document.getElementById('nps-annuity').value) / 100;
    const annuityRate = parseFloat(document.getElementById('nps-annuity-rate').value);
    const annuityCorpus = corpus * annuityPct;
    const lumpSum = corpus * (1 - annuityPct);
    const monthlyPension = annuityCorpus * annuityRate / 100 / 12;
    const returns = corpus - invested;

    document.getElementById('nps-badge').textContent = badge;
    document.getElementById('nps-res-corpus').textContent = fmtINR(corpus);
    document.getElementById('nps-res-pension').textContent = fmtINR(monthlyPension) + '/month';
    document.getElementById('nps-res-invested').textContent = fmtINR(invested);
    document.getElementById('nps-res-returns').textContent = fmtINR(returns);
    document.getElementById('nps-res-lumpsum').textContent = fmtINR(lumpSum);
    document.getElementById('nps-res-annuity').textContent = fmtINR(annuityCorpus);

    const retPct = Math.round(returns / corpus * 100);
    document.getElementById('nps-donut').setAttribute('stroke-dasharray', retPct + ' ' + (100 - retPct));
    document.getElementById('nps-donut-center').textContent = retPct + '%';
    document.getElementById('nps-legend-inv').textContent = fmtINR(invested);
    document.getElementById('nps-legend-ret').textContent = fmtINR(returns);
    npsResults.classList.remove('hidden');
    npsResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('form-nps-corpus')?.addEventListener('submit', () => {
    const age = parseFloat(document.getElementById('nps-age').value);
    const retAge = parseFloat(document.getElementById('nps-ret-age').value);
    const P = parseFloat(document.getElementById('nps-contrib').value);
    const r = parseFloat(document.getElementById('nps-return').value) / 100 / 12;
    const n = (retAge - age) * 12;
    if (retAge <= age) { document.getElementById('err-nps').textContent = 'Retirement age must be greater than current age.'; document.getElementById('err-nps').classList.remove('hidden'); return; }
    document.getElementById('err-nps').classList.add('hidden');
    const corpus = P * (Math.pow(1 + r, n) - 1) / r * (1 + r);
    const invested = P * n;
    showNPSResults(corpus, invested, 'Total NPS Corpus at Retirement');
  });

  document.getElementById('btn-nps-clear')?.addEventListener('click', () => npsResults?.classList.add('hidden'));

  document.getElementById('form-nps-pension')?.addEventListener('submit', () => {
    const corpus = parseFloat(document.getElementById('pen-corpus').value);
    const annuityPct = parseFloat(document.getElementById('pen-annuity-pct').value) / 100;
    const annuityRate = parseFloat(document.getElementById('pen-annuity-rate').value);
    const annuityCorpus = corpus * annuityPct;
    const lumpSum = corpus - annuityCorpus;
    const monthlyPension = annuityCorpus * annuityRate / 100 / 12;
    document.getElementById('nps-badge').textContent = 'Monthly Pension Estimate';
    document.getElementById('nps-res-corpus').textContent = fmtINR(corpus);
    document.getElementById('nps-res-pension').textContent = fmtINR(monthlyPension) + '/month';
    document.getElementById('nps-res-invested').textContent = fmtINR(annuityCorpus);
    document.getElementById('nps-res-returns').textContent = fmtINR(monthlyPension * 12) + '/year';
    document.getElementById('nps-res-lumpsum').textContent = fmtINR(lumpSum);
    document.getElementById('nps-res-annuity').textContent = fmtINR(annuityCorpus);
    const retPct = Math.round(annuityPct * 100);
    document.getElementById('nps-donut').setAttribute('stroke-dasharray', retPct + ' ' + (100 - retPct));
    document.getElementById('nps-donut-center').textContent = retPct + '%\nAnnuity';
    npsResults.classList.remove('hidden');
  });

  document.getElementById('btn-pen-clear')?.addEventListener('click', () => npsResults?.classList.add('hidden'));

  document.getElementById('form-nps-tax')?.addEventListener('submit', () => {
    const contrib = parseFloat(document.getElementById('tax-contrib').value);
    const slab = parseFloat(document.getElementById('tax-slab-nps').value) / 100;
    const employer = parseFloat(document.getElementById('tax-employer').value) || 0;
    const deduction80C = Math.min(contrib, 150000);
    const deduction1B = Math.min(Math.max(0, contrib - 150000), 50000);
    const deductionEmployer = employer;
    const totalDeduction = deduction80C + deduction1B + deductionEmployer;
    const taxSaved = totalDeduction * slab * 1.04; // 4% cess
    document.getElementById('nps-badge').textContent = 'Total Tax Saved';
    document.getElementById('nps-res-corpus').textContent = '₹' + Math.round(taxSaved).toLocaleString('en-IN');
    document.getElementById('nps-res-pension').textContent = '₹' + deduction80C.toLocaleString('en-IN') + ' (80C)';
    document.getElementById('nps-res-invested').textContent = '₹' + contrib.toLocaleString('en-IN');
    document.getElementById('nps-res-returns').textContent = '₹' + deduction1B.toLocaleString('en-IN') + ' (80CCD-1B)';
    document.getElementById('nps-res-lumpsum').textContent = '₹' + deductionEmployer.toLocaleString('en-IN') + ' (Employer 80CCD-2)';
    document.getElementById('nps-res-annuity').textContent = '₹' + Math.round(totalDeduction).toLocaleString('en-IN');
    npsResults.classList.remove('hidden');
  });

  document.getElementById('btn-tax-nps-clear')?.addEventListener('click', () => npsResults?.classList.add('hidden'));
</script>

