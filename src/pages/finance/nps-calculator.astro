---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="NPS Calculator – National Pension Scheme Corpus & Pension Calculator"
  description="Calculate your NPS maturity corpus at retirement, monthly pension, lump sum withdrawal, tax benefits under 80CCD, and projected returns for Tier I and Tier II NPS accounts."
  category="Finance"
  calculatorName="NPS Calculator"
  slug="nps-calculator"
  keywords={[
    'nps calculator',
    'nps calculator india',
    'national pension scheme calculator',
    'nps maturity calculator',
    'nps return calculator',
    'nps pension calculator',
    'nps tier 1 calculator',
    'nps corpus calculator',
    'nps monthly pension calculator'
  ]}
>
  <div class="space-y-6">

    <!-- MODE TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-nps-tab active shrink-0 rounded-lg bg-blue-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="corpus">NPS Corpus Planner</button>
        <button type="button" class="btn-nps-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="pension">Monthly Pension Estimate 💸</button>
        <button type="button" class="btn-nps-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tax">Tax Savings 80CCD 💰</button>
      </div>
    </div>

    <!-- PRESETS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1"><span>⚡</span> Quick Presets:</span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-age="25" data-ret="60" data-contrib="5000" data-ret-rate="10">🧑 Age 25, ₹5K/mo, 10%</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-age="30" data-ret="60" data-contrib="10000" data-ret-rate="10">👨 Age 30, ₹10K/mo, 10%</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-age="35" data-ret="60" data-contrib="15000" data-ret-rate="10">👨‍💼 Age 35, ₹15K/mo, 10%</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-age="40" data-ret="60" data-contrib="20000" data-ret-rate="9">👴 Age 40, ₹20K/mo, 9%</button>
      </div>
    </div>

    <!-- MAIN INPUT PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">

      <!-- CORPUS PANEL -->
      <div id="panel-corpus" class="nps-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>🏛️</span> NPS Corpus Planner</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Calculate total NPS corpus at retirement based on your monthly contribution and expected investment return.</p>
        </div>
        <form id="form-nps-corpus" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <label for="nps-age" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Current Age (Years)</label>
              <input type="number" id="nps-age" name="current_age" value="30" min="18" max="65" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="nps-ret-age" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Retirement Age (Years)</label>
              <input type="number" id="nps-ret-age" name="retirement_age" value="60" min="50" max="75" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="nps-contrib" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Monthly Contribution (₹)</label>
              <input type="number" id="nps-contrib" name="monthly_contribution" value="5000" step="500" min="500" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="nps-return" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Expected Annual Return (%)</label>
              <input type="number" id="nps-return" name="expected_return" value="10" step="0.5" min="5" max="20" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="nps-annuity" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Annuity Purchase Rate (%)</label>
              <input type="number" id="nps-annuity" name="annuity_percent" value="40" step="5" min="40" max="100" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
              <p class="mt-1 text-[11px] text-slate-500">Min 40% mandatory to buy annuity for monthly pension</p>
            </div>
            <div>
              <label for="nps-annuity-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Annuity Return Rate (% p.a.)</label>
              <input type="number" id="nps-annuity-rate" name="annuity_rate" value="6" step="0.5" min="3" max="15" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>
          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-nps-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">Calculate NPS Corpus →</button>
            <button type="button" id="btn-nps-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Reset</button>
          </div>
          <p id="err-nps" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300"></p>
        </form>
      </div>

      <!-- PENSION PANEL -->
      <div id="panel-pension" class="nps-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>💸</span> Monthly Pension Estimator</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Estimate monthly pension payout and lump sum based on your accumulated NPS retirement corpus.</p>
        </div>
        <form id="form-nps-pension" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="pen-corpus" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Total NPS Corpus at Retirement (₹)</label>
              <input type="number" id="pen-corpus" name="pension_corpus" value="5000000" step="100000" min="100000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="pen-annuity-pct" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Annuity % (Min 40%)</label>
              <input type="number" id="pen-annuity-pct" name="pension_annuity_percent" value="40" step="5" min="40" max="100" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="pen-annuity-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Annuity Rate (% p.a.)</label>
              <input type="number" id="pen-annuity-rate" name="pension_annuity_rate" value="6" step="0.5" min="3" max="15" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>
          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-pen-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">Estimate Monthly Pension →</button>
            <button type="button" id="btn-pen-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Reset</button>
          </div>
        </form>
      </div>

      <!-- TAX PANEL -->
      <div id="panel-tax" class="nps-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>💰</span> NPS Tax Saving Calculator (Section 80CCD)</h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Calculate annual income tax deduction across 80CCD(1), exclusive ₹50K under 80CCD(1B), and employer contribution 80CCD(2).</p>
        </div>
        <form id="form-nps-tax" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="tax-contrib" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Annual NPS Contribution (₹)</label>
              <input type="number" id="tax-contrib" name="tax_contribution" value="200000" step="10000" min="1000" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="tax-slab-nps" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Income Tax Slab</label>
              <select id="tax-slab-nps" name="tax_slab" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
                <option value="5">5%</option>
                <option value="10">10%</option>
                <option value="15">15%</option>
                <option value="20">20%</option>
                <option value="30" selected>30%</option>
              </select>
            </div>
            <div>
              <label for="tax-employer" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Employer NPS Contribution (₹)</label>
              <input type="number" id="tax-employer" name="employer_tax_contrib" value="0" step="10000" min="0" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
              <p class="text-[11px] text-slate-500 mt-1">80CCD(2): Up to 10% of Basic+DA</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-tax-nps-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">Calculate Tax Savings →</button>
            <button type="button" id="btn-tax-nps-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Reset</button>
          </div>
        </form>
      </div>

      <!-- RESULTS SECTION -->
      <div id="nps-results" class="mt-6 space-y-5">

        <!-- Hero Highlights Box -->
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="nps-badge" class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Total NPS Corpus at Retirement</span>
              <div id="res-future-val" class="mt-1 text-3xl sm:text-4xl lg:text-5xl font-black text-blue-600 dark:text-blue-400">₹1,13,96,627</div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Est. Monthly Pension:</span>
              <div id="res-monthly-pension" class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400">₹22,793/month</div>
            </div>
          </div>

          <!-- 6-Metric Highlights Grid -->
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <span class="text-slate-500 font-semibold block uppercase text-[10.5px]">Total Invested</span>
              <div id="res-total-invested" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹18,00,000</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <span class="text-slate-500 font-semibold block uppercase text-[10.5px]">Returns Generated</span>
              <div id="res-total-returns" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">₹95,96,627</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <span class="text-slate-500 font-semibold block uppercase text-[10.5px]">Lump Sum (60%)</span>
              <div id="res-lumpsum-amount" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹68,37,976</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <span class="text-slate-500 font-semibold block uppercase text-[10.5px]">Annuity Corpus (40%)</span>
              <div id="res-annuity-corpus" class="mt-1 text-sm sm:text-base font-bold text-purple-600 dark:text-purple-400">₹45,58,651</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <span class="text-slate-500 font-semibold block uppercase text-[10.5px]">Annual Pension</span>
              <div id="res-annual-pension" class="mt-1 text-sm sm:text-base font-bold text-indigo-600 dark:text-indigo-400">₹2,73,519/yr</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <span class="text-slate-500 font-semibold block uppercase text-[10.5px]">Tax Saved (80CCD)</span>
              <div id="res-tax-saved" class="mt-1 text-sm sm:text-base font-bold text-amber-600 dark:text-amber-400">₹18,720</div>
            </div>
          </div>
        </div>

        <!-- Donut Visual Breakdown -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-1.5"><span>📊</span> Invested Capital vs Compound Gain Breakdown</h3>
          <div class="flex flex-col sm:flex-row items-center justify-around gap-6">
            <div class="relative w-44 h-44 flex items-center justify-center">
              <svg id="svg-nps-donut" class="donut-chart visual-diagram w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                <circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="3.8"></circle>
                <circle id="nps-donut" cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="3.8" stroke-dasharray="84 16" stroke-dashoffset="0"></circle>
              </svg>
              <div class="absolute text-center">
                <span class="text-[10px] font-bold text-slate-400 block tracking-widest uppercase">GAIN</span>
                <span id="nps-donut-center" class="text-sm font-black text-slate-800 dark:text-slate-200">84%</span>
              </div>
            </div>
            <div class="space-y-3 text-xs w-full sm:w-auto">
              <div class="flex items-center justify-between gap-6 p-2.5 rounded-xl bg-blue-50/60 dark:bg-blue-950/30 border border-blue-100 dark:border-blue-900/40">
                <span class="flex items-center gap-2 font-bold text-blue-700 dark:text-blue-300"><span class="w-3 h-3 rounded-full bg-blue-600 inline-block"></span> Total Invested Capital:</span>
                <span id="nps-legend-inv" class="font-bold text-slate-900 dark:text-white font-mono">₹18,00,000 (16%)</span>
              </div>
              <div class="flex items-center justify-between gap-6 p-2.5 rounded-xl bg-emerald-50/60 dark:bg-emerald-950/30 border border-emerald-100 dark:border-emerald-900/40">
                <span class="flex items-center gap-2 font-bold text-emerald-700 dark:text-emerald-300"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Compound Growth Gain:</span>
                <span id="nps-legend-ret" class="font-bold text-slate-900 dark:text-white font-mono">₹95,96,627 (84%)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Year-by-Year Growth Table Accordion -->
        <details id="nps-schedule-accordion" class="group rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 shadow-sm" open>
          <summary class="cursor-pointer list-none font-black text-xs sm:text-sm text-slate-800 dark:text-slate-200 flex items-center justify-between uppercase tracking-wider">
            <span class="flex items-center gap-2"><span>📈</span> Year-by-Year NPS Wealth Accumulation Schedule</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="mt-4 overflow-x-auto">
            <table id="nps-schedule-table" class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="border-b border-slate-200 bg-slate-50 text-slate-700 dark:border-slate-800 dark:bg-slate-800/80 dark:text-slate-300">
                  <th class="p-2.5 font-bold">Age</th>
                  <th class="p-2.5 font-bold">Year</th>
                  <th class="p-2.5 font-bold text-right">Annual Deposit</th>
                  <th class="p-2.5 font-bold text-right">Total Invested</th>
                  <th class="p-2.5 font-bold text-right">Interest Earned</th>
                  <th class="p-2.5 font-bold text-right">Closing NPS Corpus</th>
                  <th class="p-2.5 font-bold text-right">Lump Sum (60%)</th>
                  <th class="p-2.5 font-bold text-right">Annuity Value (40%)</th>
                </tr>
              </thead>
              <tbody id="nps-schedule-tbody" class="divide-y divide-slate-200/60 dark:divide-slate-800">
                <!-- Dynamically injected rows -->
              </tbody>
            </table>
          </div>
        </details>

      </div>
    </div>
  </div>

  <!-- SEO CONTENT -->
  <Fragment slot="content">
    <section class="nps-content">
      <h2>NPS Calculator – National Pension Scheme Corpus & Pension Estimator</h2>
      <p>The <strong>NPS Calculator</strong> is an essential retirement planning tool for salaried employees, self-employed professionals, and government workers in India. It helps you estimate your <strong>National Pension System (NPS) corpus</strong> at retirement age, calculate the expected <strong>monthly pension</strong>, lump sum withdrawal amount, and the significant <strong>tax savings</strong> available under Sections 80CCD(1), 80CCD(1B), and 80CCD(2) of the Income Tax Act.</p>

      <h2>What Is the National Pension System (NPS)?</h2>
      <p>The <strong>National Pension System (NPS)</strong> is a voluntary, long-term retirement savings scheme regulated by the Pension Fund Regulatory and Development Authority (PFRDA) of India. Launched in 2004 for government employees and opened to all citizens in 2009, NPS allows subscribers to systematically save for retirement while enjoying tax benefits under the new and old tax regimes.</p>
      <ul>
        <li><strong>Tier I Account:</strong> Primary retirement account — mandatory, contributions locked till age 60 (with exceptions)</li>
        <li><strong>Tier II Account:</strong> Optional, flexible savings account — no withdrawal restrictions, no additional tax benefit</li>
        <li><strong>Minimum Annual Contribution:</strong> ₹1,000 for Tier I; ₹250 for Tier II</li>
        <li><strong>Maturity:</strong> At age 60 — you can withdraw 60% as lump sum (tax-free); 40% must purchase annuity for pension</li>
      </ul>

      <h2>How Does the NPS Calculator Work?</h2>
      <p>The NPS corpus grows using the standard future value of an annuity formula:</p>
      <div class="my-4 rounded-2xl border border-slate-200 bg-slate-100/80 p-4 font-mono text-sm dark:border-slate-800 dark:bg-slate-900">
        <div>Corpus = P × [(1 + r)^n − 1] / r × (1 + r)</div>
        <div class="mt-1 text-slate-500">P = Monthly contribution | r = Monthly rate | n = Total months until retirement</div>
      </div>
      <p>Once the corpus is calculated, at least 40% must be used to purchase an annuity from a life insurance company. The annuity rate (typically 5%–8% per annum) determines your monthly pension.</p>

      <h2>NPS Tax Benefits</h2>
      <ul>
        <li><strong>Section 80CCD(1):</strong> Deduction up to 10% of salary (max ₹1.5 lakh, within overall 80C limit)</li>
        <li><strong>Section 80CCD(1B):</strong> Additional exclusive deduction of ₹50,000 per year — over and above the 80C limit</li>
        <li><strong>Section 80CCD(2):</strong> Employer's NPS contribution — deduction up to 10% of salary with no upper limit</li>
        <li><strong>Total Maximum Benefit:</strong> Up to ₹2,00,000 deduction — saves ₹62,400 in taxes for those in the 30% slab (including 4% cess)</li>
        <li><strong>Maturity Tax-Free:</strong> 60% lump sum withdrawal at retirement is completely tax-exempt</li>
      </ul>

      <h2>NPS Returns and Fund Options</h2>
      <p>NPS offers multiple asset class options managed by PFRDA-registered Pension Fund Managers (PFMs):</p>
      <ul>
        <li><strong>Equity (Class E):</strong> Up to 75% allocation, historically 10%–12% long-term returns</li>
        <li><strong>Corporate Bonds (Class C):</strong> 7%–9% returns</li>
        <li><strong>Government Securities (Class G):</strong> 6%–8% returns</li>
        <li><strong>Alternative Assets (Class A):</strong> Up to 5% of portfolio</li>
      </ul>

      <h2>NPS vs PPF vs FD – Which Is Better?</h2>
      <ul>
        <li><strong>NPS:</strong> Higher returns (10%–12%), best for long-term retirement, additional ₹50K tax benefit, market-linked risk</li>
        <li><strong>PPF:</strong> Guaranteed 7.1%, 15-year lock-in, fully tax-free, risk-free</li>
        <li><strong>FD:</strong> 6.5%–7.5%, flexible tenures, taxable interest, low risk</li>
      </ul>
      <p>For maximum tax efficiency and long-term wealth creation, financial advisors often recommend combining NPS (for the additional 80CCD(1B) benefit) with PPF and ELSS investments.</p>
    </section>
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <div class="space-y-4 text-xs sm:text-sm">
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800" open>
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">1. How much NPS corpus will I need for retirement?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">A common rule is to accumulate 25–30 times your annual expenses. If you spend ₹5 lakh per year, you need a corpus of ₹1.25–1.5 crore. Our NPS calculator helps estimate when you will reach this target based on your monthly contributions.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">2. What is the minimum contribution for NPS Tier I?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">The minimum contribution for NPS Tier I is ₹500 per contribution and ₹1,000 per financial year. There is no maximum contribution limit — the more you contribute, the larger your retirement corpus.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">3. Can I withdraw from NPS before retirement?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Yes, partial withdrawals are allowed after 3 years for specific purposes: higher education, marriage, home purchase, medical treatment. You can withdraw up to 25% of your own contributions. After age 60, 60% can be withdrawn as tax-free lump sum.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">4. What is the expected NPS return rate?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">NPS returns depend on your asset allocation. The Equity class (E) has historically given 10%–12% returns. Government bonds give 6%–8%. A balanced portfolio (50% E, 30% C, 20% G) typically yields 8%–10% long-term returns.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">5. How much extra tax do I save with NPS vs only PPF/ELSS?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">NPS offers an exclusive additional deduction of ₹50,000 under Section 80CCD(1B), over and above the ₹1.5 lakh 80C limit. For someone in the 30% tax slab, this saves approximately ₹15,600 in taxes (including 4% cess) per year — exclusively for NPS.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">6. Is NPS pension taxable after retirement?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">The 60% lump sum withdrawal at retirement is completely tax-free. The monthly pension received from the annuity is taxable as "Income from Other Sources" per your income tax slab at that time.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">7. What happens to my NPS if I die before retirement?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">In case of the subscriber's death, the entire NPS corpus is paid to the nominee/legal heir as a lump sum. The mandatory 40% annuity purchase rule does not apply in case of death — the family receives 100% of the corpus.</p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<style>
  .nps-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.5rem; font-weight: 800; color: #0f172a; }
  .nps-content h2:first-child { margin-top: 0; }
  .nps-content p { margin: 0 0 1rem; line-height: 1.75; color: #475569; }
  .nps-content ul, .nps-content ol { margin: 0.75rem 0 1.5rem; padding-left: 1.5rem; }
  .nps-content ul { list-style: disc; }
  .nps-content ol { list-style: decimal; }
  .nps-content li + li { margin-top: 0.5rem; }
  :global(.dark) .nps-content h2 { color: #f8fafc; }
  :global(.dark) .nps-content p, :global(.dark) .nps-content li { color: #cbd5e1; }
</style>

<script is:inline>
  (function () {
    const npsTabs = document.querySelectorAll('.btn-nps-tab');
    const npsPanels = document.querySelectorAll('.nps-panel');
    const npsResults = document.getElementById('nps-results');

    npsTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        npsTabs.forEach(t => {
          t.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
          t.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
        });
        tab.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
        tab.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700');
        npsPanels.forEach(p => p.classList.add('hidden'));
        document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');

        // Trigger corresponding calculation for the active tab
        if (tab.dataset.tab === 'corpus') calculateCorpus();
        else if (tab.dataset.tab === 'pension') calculatePension();
        else if (tab.dataset.tab === 'tax') calculateTax();
      });
    });

    document.querySelectorAll('.btn-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('nps-age').value = btn.dataset.age;
        document.getElementById('nps-ret-age').value = btn.dataset.ret;
        document.getElementById('nps-contrib').value = btn.dataset.contrib;
        document.getElementById('nps-return').value = btn.dataset.retRate;
        calculateCorpus();
      });
    });

    function fmtINR(n) {
      return '₹' + Math.round(n).toLocaleString('en-IN');
    }

    function calculateCorpus() {
      const age = parseFloat(document.getElementById('nps-age').value) || 30;
      const retAge = parseFloat(document.getElementById('nps-ret-age').value) || 60;
      const P = parseFloat(document.getElementById('nps-contrib').value) || 5000;
      const annualReturn = parseFloat(document.getElementById('nps-return').value) || 10;
      const annuityPct = (parseFloat(document.getElementById('nps-annuity').value) || 40) / 100;
      const annuityRate = parseFloat(document.getElementById('nps-annuity-rate').value) || 6;

      const errEl = document.getElementById('err-nps');
      if (retAge <= age) {
        if (errEl) {
          errEl.textContent = 'Retirement age must be strictly greater than current age.';
          errEl.classList.remove('hidden');
        }
        return;
      }
      if (errEl) errEl.classList.add('hidden');

      const years = retAge - age;
      const n = years * 12;
      const r = annualReturn / 100 / 12;

      // Future value of annuity: P * ((1+r)^n - 1) / r * (1+r)
      const corpus = P * (Math.pow(1 + r, n) - 1) / r * (1 + r);
      const invested = P * n;
      const returns = corpus - invested;
      const annuityCorpus = corpus * annuityPct;
      const lumpSum = corpus * (1 - annuityPct);
      const monthlyPension = (annuityCorpus * (annuityRate / 100)) / 12;
      const annualPension = monthlyPension * 12;

      // Calculate annual tax savings estimate under 80CCD
      const annualContrib = P * 12;
      const deduction80C = Math.min(annualContrib, 150000);
      const deduction1B = Math.min(Math.max(0, annualContrib - 150000), 50000);
      const taxSavedAnnual = (deduction80C + deduction1B) * 0.30 * 1.04;

      // Update Result Elements
      document.getElementById('nps-badge').textContent = 'Total NPS Corpus at Retirement';
      document.getElementById('res-future-val').textContent = fmtINR(corpus);
      document.getElementById('res-monthly-pension').textContent = fmtINR(monthlyPension) + '/month';
      document.getElementById('res-total-invested').textContent = fmtINR(invested);
      document.getElementById('res-total-returns').textContent = fmtINR(returns);
      document.getElementById('res-lumpsum-amount').textContent = fmtINR(lumpSum);
      document.getElementById('res-annuity-corpus').textContent = fmtINR(annuityCorpus);
      document.getElementById('res-annual-pension').textContent = fmtINR(annualPension) + '/yr';
      document.getElementById('res-tax-saved').textContent = fmtINR(taxSavedAnnual) + '/yr';

      // Update Donut Chart
      const retPct = Math.max(1, Math.min(99, Math.round((returns / corpus) * 100)));
      const invPct = 100 - retPct;
      const donutEl = document.getElementById('nps-donut');
      if (donutEl) donutEl.setAttribute('stroke-dasharray', retPct + ' ' + invPct);
      const donutCenterEl = document.getElementById('nps-donut-center');
      if (donutCenterEl) donutCenterEl.textContent = retPct + '%';
      const legendInv = document.getElementById('nps-legend-inv');
      if (legendInv) legendInv.textContent = fmtINR(invested) + ' (' + invPct + '%)';
      const legendRet = document.getElementById('nps-legend-ret');
      if (legendRet) legendRet.textContent = fmtINR(returns) + ' (' + retPct + '%)';

      // Generate Year-by-Year Growth Table
      renderScheduleTable(age, retAge, P, r, annualReturn, annuityPct);

      if (npsResults) npsResults.classList.remove('hidden');
      document.dispatchEvent(new CustomEvent('calculator:updated'));
    }

    function renderScheduleTable(startAge, endAge, monthlyDeposit, monthlyRate, annualReturn, annuityPct) {
      const tbody = document.getElementById('nps-schedule-tbody');
      if (!tbody) return;

      var currentBalance = 0;
      var cumulativeInvested = 0;
      var rowsHtml = '';
      var currentYear = new Date().getFullYear();

      for (var y = 1; y <= (endAge - startAge); y++) {
        var ageAtYear = startAge + y;
        var calendarYear = currentYear + y;
        var startBalYear = currentBalance;
        var annualDeposit = monthlyDeposit * 12;
        cumulativeInvested += annualDeposit;

        for (var m = 1; m <= 12; m++) {
          currentBalance = (currentBalance + monthlyDeposit) * (1 + monthlyRate);
        }

        var interestEarnedThisYear = currentBalance - startBalYear - annualDeposit;
        var lumpSumVal = currentBalance * (1 - annuityPct);
        var annuityVal = currentBalance * annuityPct;

        var bg = y % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-slate-50/70 dark:bg-slate-800/40';

        rowsHtml += '<tr class="' + bg + '">' +
          '<td class="p-2.5 font-bold text-slate-800 dark:text-slate-200">' + ageAtYear + ' yrs</td>' +
          '<td class="p-2.5 text-slate-600 dark:text-slate-400 font-mono">' + calendarYear + '</td>' +
          '<td class="p-2.5 text-right font-mono text-slate-700 dark:text-slate-300">' + fmtINR(annualDeposit) + '</td>' +
          '<td class="p-2.5 text-right font-mono text-slate-700 dark:text-slate-300">' + fmtINR(cumulativeInvested) + '</td>' +
          '<td class="p-2.5 text-right font-mono text-emerald-600 dark:text-emerald-400">+' + fmtINR(interestEarnedThisYear) + '</td>' +
          '<td class="p-2.5 text-right font-mono font-bold text-blue-600 dark:text-blue-400">' + fmtINR(currentBalance) + '</td>' +
          '<td class="p-2.5 text-right font-mono text-slate-600 dark:text-slate-400">' + fmtINR(lumpSumVal) + '</td>' +
          '<td class="p-2.5 text-right font-mono text-purple-600 dark:text-purple-400">' + fmtINR(annuityVal) + '</td>' +
          '</tr>';
      }

      tbody.innerHTML = rowsHtml;
    }

    function calculatePension() {
      const corpus = parseFloat(document.getElementById('pen-corpus').value) || 5000000;
      const annuityPct = (parseFloat(document.getElementById('pen-annuity-pct').value) || 40) / 100;
      const annuityRate = parseFloat(document.getElementById('pen-annuity-rate').value) || 6;

      const annuityCorpus = corpus * annuityPct;
      const lumpSum = corpus - annuityCorpus;
      const monthlyPension = (annuityCorpus * (annuityRate / 100)) / 12;
      const annualPension = monthlyPension * 12;

      document.getElementById('nps-badge').textContent = 'Monthly Pension Estimate';
      document.getElementById('res-future-val').textContent = fmtINR(corpus);
      document.getElementById('res-monthly-pension').textContent = fmtINR(monthlyPension) + '/month';
      document.getElementById('res-total-invested').textContent = fmtINR(annuityCorpus);
      document.getElementById('res-total-returns').textContent = fmtINR(annualPension) + '/year';
      document.getElementById('res-lumpsum-amount').textContent = fmtINR(lumpSum);
      document.getElementById('res-annuity-corpus').textContent = fmtINR(annuityCorpus);
      document.getElementById('res-annual-pension').textContent = fmtINR(annualPension) + '/yr';
      document.getElementById('res-tax-saved').textContent = 'N/A (At Retirement)';

      const pct = Math.round(annuityPct * 100);
      const donutEl = document.getElementById('nps-donut');
      if (donutEl) donutEl.setAttribute('stroke-dasharray', pct + ' ' + (100 - pct));
      const donutCenterEl = document.getElementById('nps-donut-center');
      if (donutCenterEl) donutCenterEl.textContent = pct + '%';
      const legendInv = document.getElementById('nps-legend-inv');
      if (legendInv) legendInv.textContent = fmtINR(annuityCorpus) + ' (' + pct + '% Annuity)';
      const legendRet = document.getElementById('nps-legend-ret');
      if (legendRet) legendRet.textContent = fmtINR(lumpSum) + ' (' + (100 - pct) + '% Lump Sum)';

      if (npsResults) npsResults.classList.remove('hidden');
      document.dispatchEvent(new CustomEvent('calculator:updated'));
    }

    function calculateTax() {
      const contrib = parseFloat(document.getElementById('tax-contrib').value) || 200000;
      const slab = (parseFloat(document.getElementById('tax-slab-nps').value) || 30) / 100;
      const employer = parseFloat(document.getElementById('tax-employer').value) || 0;

      const deduction80C = Math.min(contrib, 150000);
      const deduction1B = Math.min(Math.max(0, contrib - 150000), 50000);
      const deductionEmployer = employer;
      const totalDeduction = deduction80C + deduction1B + deductionEmployer;
      const taxSaved = totalDeduction * slab * 1.04; // 4% health and education cess

      document.getElementById('nps-badge').textContent = 'Total Annual Tax Saved';
      document.getElementById('res-future-val').textContent = fmtINR(taxSaved);
      document.getElementById('res-monthly-pension').textContent = fmtINR(taxSaved / 12) + '/month';
      document.getElementById('res-total-invested').textContent = fmtINR(contrib);
      document.getElementById('res-total-returns').textContent = fmtINR(deduction1B) + ' (80CCD 1B)';
      document.getElementById('res-lumpsum-amount').textContent = fmtINR(deduction80C) + ' (80C)';
      document.getElementById('res-annuity-corpus').textContent = fmtINR(deductionEmployer) + ' (80CCD 2)';
      document.getElementById('res-annual-pension').textContent = fmtINR(totalDeduction) + ' Total Ded.';
      document.getElementById('res-tax-saved').textContent = fmtINR(taxSaved) + ' / year';

      const taxRatio = Math.round((taxSaved / (contrib || 1)) * 100);
      const donutEl = document.getElementById('nps-donut');
      if (donutEl) donutEl.setAttribute('stroke-dasharray', taxRatio + ' ' + (100 - taxRatio));
      const donutCenterEl = document.getElementById('nps-donut-center');
      if (donutCenterEl) donutCenterEl.textContent = taxRatio + '%';
      const legendInv = document.getElementById('nps-legend-inv');
      if (legendInv) legendInv.textContent = fmtINR(contrib) + ' (Contribution)';
      const legendRet = document.getElementById('nps-legend-ret');
      if (legendRet) legendRet.textContent = fmtINR(taxSaved) + ' (Tax Saved)';

      if (npsResults) npsResults.classList.remove('hidden');
      document.dispatchEvent(new CustomEvent('calculator:updated'));
    }

    // Event listeners for forms and inputs
    document.getElementById('form-nps-corpus')?.addEventListener('submit', calculateCorpus);
    document.getElementById('btn-nps-calc')?.addEventListener('click', calculateCorpus);
    document.getElementById('form-nps-pension')?.addEventListener('submit', calculatePension);
    document.getElementById('btn-pen-calc')?.addEventListener('click', calculatePension);
    document.getElementById('form-nps-tax')?.addEventListener('submit', calculateTax);
    document.getElementById('btn-tax-nps-calc')?.addEventListener('click', calculateTax);

    // Live recalculate on input change
    const corpusInputs = ['nps-age', 'nps-ret-age', 'nps-contrib', 'nps-return', 'nps-annuity', 'nps-annuity-rate'];
    corpusInputs.forEach(id => {
      document.getElementById(id)?.addEventListener('input', calculateCorpus);
    });

    const pensionInputs = ['pen-corpus', 'pen-annuity-pct', 'pen-annuity-rate'];
    pensionInputs.forEach(id => {
      document.getElementById(id)?.addEventListener('input', calculatePension);
    });

    const taxInputs = ['tax-contrib', 'tax-slab-nps', 'tax-employer'];
    taxInputs.forEach(id => {
      document.getElementById(id)?.addEventListener('input', calculateTax);
    });

    // Reset handlers
    document.getElementById('btn-nps-clear')?.addEventListener('click', () => {
      document.getElementById('nps-age').value = '30';
      document.getElementById('nps-ret-age').value = '60';
      document.getElementById('nps-contrib').value = '5000';
      document.getElementById('nps-return').value = '10';
      document.getElementById('nps-annuity').value = '40';
      document.getElementById('nps-annuity-rate').value = '6';
      calculateCorpus();
    });

    document.getElementById('btn-pen-clear')?.addEventListener('click', () => {
      document.getElementById('pen-corpus').value = '5000000';
      document.getElementById('pen-annuity-pct').value = '40';
      document.getElementById('pen-annuity-rate').value = '6';
      calculatePension();
    });

    document.getElementById('btn-tax-nps-clear')?.addEventListener('click', () => {
      document.getElementById('tax-contrib').value = '200000';
      document.getElementById('tax-slab-nps').value = '30';
      document.getElementById('tax-employer').value = '0';
      calculateTax();
    });

    // Initial calculation on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', calculateCorpus);
    } else {
      calculateCorpus();
    }
  })();
</script>

