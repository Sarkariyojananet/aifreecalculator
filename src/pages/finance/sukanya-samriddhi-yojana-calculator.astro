---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="SSY Calculator – Sukanya Samriddhi Yojana Calculator 2025–26 | SBI & Post Office"
  description="Free online SSY Calculator: Calculate exact 21-year maturity amount, total interest earned, and year-wise growth for Sukanya Samriddhi Yojana at 8.2% interest. Compare SBI and Post Office returns."
  category="Finance"
  calculatorName="Sukanya Samriddhi Yojana Calculator"
  slug="sukanya-samriddhi-yojana-calculator"
  keywords={[
    'ssy calculator',
    'sukanya samriddhi yojana calculator',
    'sbi sukanya samriddhi yojana calculator',
    'post office sukanya samriddhi yojana calculator',
    'sukanya samriddhi yojana calculator sbi',
    'sukanya samriddhi yojana calculator post office',
    'ssy maturity calculator',
    'sukanya samriddhi interest rate 2026',
    'post office ssy calculator',
    'sbi ssy calculator 2026',
    'ssy tax benefit 80c'
  ]}
>
  <div class="space-y-6">

    <!-- PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Popular Scenarios:
        </span>
        <button type="button" class="btn-ssy-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="monthly" data-amt="2500" data-age="1">
          ₹2,500 / Month (Age 1)
        </button>
        <button type="button" class="btn-ssy-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="monthly" data-amt="5000" data-age="2">
          ₹5,000 / Month (Age 2)
        </button>
        <button type="button" class="btn-ssy-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="yearly" data-amt="100000" data-age="1">
          ₹1 Lakh / Year (Age 1)
        </button>
        <button type="button" class="btn-ssy-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="yearly" data-amt="150000" data-age="0">
          ₹1.5 Lakh Max / Year (Age 0)
        </button>
      </div>
    </div>

    <!-- MAIN CALCULATOR GRID -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      
      <!-- INPUT PANEL (7 cols) -->
      <div class="lg:col-span-7 space-y-5 rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:bg-slate-900 sm:p-7">
        
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>👧</span> SSY Deposit Parameters
        </h2>

        <!-- Deposit Frequency -->
        <div class="space-y-1.5">
          <label class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
            Deposit Frequency
          </label>
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              id="freq-yearly"
              class="btn-ssy-freq active rounded-xl bg-blue-600 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs cursor-pointer transition"
              data-freq="yearly"
            >
              Yearly (वार्षिक)
            </button>
            <button
              type="button"
              id="freq-monthly"
              class="btn-ssy-freq rounded-xl border border-slate-300 bg-white py-2.5 text-xs sm:text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
              data-freq="monthly"
            >
              Monthly (मासिक)
            </button>
          </div>
        </div>

        <!-- Deposit Amount -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
            <label for="ssy-amount" id="label-deposit-amount">Yearly Investment (₹)</label>
            <span class="font-mono text-blue-600 dark:text-blue-400 font-bold" id="display-ssy-amount">₹1,50,000</span>
          </div>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-sm">₹</span>
            <input
              type="number"
              id="ssy-amount"
              min="250"
              max="150000"
              step="500"
              value="150000"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 pl-8 pr-3 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
          </div>
          <input type="range" id="slider-ssy-amount" min="1000" max="150000" step="1000" value="150000" class="w-full accent-blue-600 cursor-pointer" />
          <p class="text-[11px] text-slate-500">Official limit: Min ₹250 to Max ₹1,50,000 per financial year in SBI or Post Office.</p>
        </div>

        <!-- Girl's Current Age -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
            <label for="ssy-girl-age">Girl Child Current Age</label>
            <span class="font-mono text-blue-600 dark:text-blue-400 font-bold" id="display-ssy-age">1 Year</span>
          </div>
          <select id="ssy-girl-age" class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 px-3 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white">
            <option value="0">0 Years (Infant &lt; 1 Year)</option>
            <option value="1" selected>1 Year</option>
            <option value="2">2 Years</option>
            <option value="3">3 Years</option>
            <option value="4">4 Years</option>
            <option value="5">5 Years</option>
            <option value="6">6 Years</option>
            <option value="7">7 Years</option>
            <option value="8">8 Years</option>
            <option value="9">9 Years</option>
            <option value="10">10 Years (Max Eligible Age)</option>
          </select>
        </div>

        <!-- Start Period (Year) -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
            <label for="slider-ssy-start-year">Account Opening Year (Start Period)</label>
            <div class="relative">
              <input
                type="number"
                id="ssy-start-year"
                min="2015"
                max="2035"
                step="1"
                value="2026"
                class="w-20 text-center font-mono font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 rounded-md py-1 px-2 text-sm border border-emerald-200/60 dark:border-emerald-800/60 focus:outline-hidden focus:ring-2 focus:ring-emerald-500"
              />
            </div>
          </div>
          <input
            type="range"
            id="slider-ssy-start-year"
            min="2015"
            max="2035"
            step="1"
            value="2026"
            class="w-full accent-emerald-500 cursor-pointer"
          />
          <p class="text-[11px] text-slate-500">SSY was launched in 2015. Select opening year (e.g. 2016-2025) to calculate past or future maturity.</p>
        </div>

        <!-- Interest Rate -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
            <label for="ssy-rate">Annual Interest Rate (%)</label>
            <span class="font-mono text-emerald-600 dark:text-emerald-400 font-bold" id="display-ssy-rate">8.2%</span>
          </div>
          <div class="relative">
            <input
              type="number"
              id="ssy-rate"
              min="5"
              max="12"
              step="0.1"
              value="8.2"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 pl-3 pr-8 text-sm font-semibold text-slate-900 focus:border-blue-600 focus:bg-white focus:outline-hidden dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
            <span class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 text-sm">%</span>
          </div>
          <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">★ Current Govt of India rate is 8.2% p.a. for both SBI and Post Office accounts.</p>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 pt-3 border-t border-slate-200 dark:border-slate-800">
          <button
            type="button"
            id="btn-calc-ssy"
            class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3.5 text-center text-sm font-black text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
          >
            Calculate SSY Maturity →
          </button>
          <button
            type="button"
            id="btn-clear-ssy"
            class="rounded-xl border border-slate-300 bg-white px-5 py-3.5 text-center text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 cursor-pointer"
          >
            Clear (✕)
          </button>
        </div>

      </div>

      <!-- RESULTS PLACEHOLDER (Visible until Calculate is clicked) -->
      <div id="ssy-results-placeholder" class="lg:col-span-5 flex flex-col items-center justify-center p-8 text-center rounded-3xl border border-dashed border-slate-300 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 min-h-85">
        <span class="text-4xl mb-3">👧</span>
        <h4 class="text-base font-bold text-slate-800 dark:text-slate-200">Ready to Calculate</h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs">Enter your daughter's age, annual or monthly deposit, then click <strong>Calculate SSY Maturity</strong> to see her 21-year tax-free wealth projection for SBI or Post Office.</p>
      </div>

      <!-- RESULTS PANEL (Hidden until Calculate is clicked) -->
      <div id="results-section" class="hidden lg:col-span-5 flex-col justify-between space-y-4 rounded-3xl border border-blue-200/80 bg-linear-to-b from-blue-50/60 to-white p-5 shadow-xl shadow-slate-900/5 dark:border-blue-900/40 dark:from-slate-900 dark:to-slate-950 sm:p-7">
        
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Total Maturity Value (21 Years)</div>
          <div class="mt-2">
            <div class="text-3xl sm:text-4xl font-black font-mono text-emerald-600 dark:text-emerald-400" id="res-maturity-amount">
              ₹69,80,000
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1" id="res-maturity-year-label">
              Matures in 2047 (Daughter's Age: 22 Years)
            </div>
          </div>
        </div>

        <!-- Metrics Grid -->
        <div class="grid grid-cols-2 gap-3 pt-2 border-t border-slate-200/80 dark:border-slate-800">
          <div class="rounded-xl border border-slate-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/80">
            <div class="text-[11px] font-medium text-slate-500">Total Investment (15 Yrs)</div>
            <div class="text-base sm:text-lg font-bold text-slate-900 dark:text-white font-mono" id="res-total-invested">₹22,50,000</div>
          </div>
          <div class="rounded-xl border border-slate-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/80">
            <div class="text-[11px] font-medium text-slate-500">Total Interest Earned</div>
            <div class="text-base sm:text-lg font-bold text-emerald-600 dark:text-emerald-400 font-mono" id="res-total-interest">₹47,30,000</div>
          </div>
        </div>

        <!-- Timeline Badge -->
        <div class="rounded-2xl border border-blue-200 bg-blue-50/80 p-4 dark:border-blue-900/60 dark:bg-blue-950/40 text-xs space-y-1.5">
          <div class="font-bold text-blue-900 dark:text-blue-200 flex items-center gap-1.5">
            <span>⏱️</span> Deposit vs Holding Period:
          </div>
          <div class="text-slate-600 dark:text-slate-300">
            • <strong>Years 1 to 15:</strong> You deposit money every year.<br />
            • <strong>Years 16 to 21 (6 Years):</strong> No deposits required! Your balance grows purely on compound interest.
          </div>
        </div>

        <!-- Tax Benefit Badge -->
        <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-3 text-[11px] text-amber-800 dark:border-amber-900/40 dark:bg-amber-950/30 dark:text-amber-300">
          🛡️ <strong>100% Tax-Free (EEE Status):</strong> Investment is tax-exempt under Section 80C, interest is non-taxable, and maturity payout has zero tax.
        </div>

      </div>

    </div>

    <!-- 21-YEAR SCHEDULE TABLE -->
    <div id="schedule-section" class="hidden rounded-3xl border border-slate-200/90 bg-white p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:bg-slate-900 sm:p-7">
      <details class="group" open>
        <summary class="flex cursor-pointer items-center justify-between font-bold text-slate-900 dark:text-white">
          <span class="flex items-center gap-2">
            <span>📈</span> View Complete 21-Year SSY Growth Breakdown Table
          </span>
          <span class="text-blue-600 text-xs font-semibold group-open:rotate-180 transition-transform">▼ Click to Toggle</span>
        </summary>

        <!-- View Mode Toggle Buttons (Year-wise vs Month-wise) -->
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3.5">
          <div class="text-xs text-slate-500 dark:text-slate-400">
            Switch between <strong>Annual Summary (21 Years)</strong> or <strong>Detailed Month-by-Month Compounding (252 Months)</strong>:
          </div>
          <div class="inline-flex rounded-xl border border-slate-200 bg-slate-100 p-1 dark:border-slate-800 dark:bg-slate-800/80 shrink-0">
            <button
              type="button"
              id="btn-schedule-yearly"
              class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs transition cursor-pointer"
            >
              📅 Year-wise (21 Yrs)
            </button>
            <button
              type="button"
              id="btn-schedule-monthly"
              class="rounded-lg px-3.5 py-1.5 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition cursor-pointer"
            >
              🗓️ Month-wise (252 Mos)
            </button>
          </div>
        </div>

        <div class="mt-3 overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead id="ssy-schedule-thead">
              <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold">
                <th class="p-2.5">Year</th>
                <th class="p-2.5">Girl's Age</th>
                <th class="p-2.5">Opening Balance</th>
                <th class="p-2.5">Deposit (₹)</th>
                <th class="p-2.5">Interest Earned (8.2%)</th>
                <th class="p-2.5">Closing Balance</th>
              </tr>
            </thead>
            <tbody id="ssy-schedule-tbody" class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </details>
    </div>

  </div>

  <!-- EDUCATIONAL CONTENT & COMPREHENSIVE SEO GUIDE -->
  <Fragment slot="content">
    <article class="prose prose-slate dark:prose-invert max-w-none text-sm leading-relaxed space-y-5 pt-4">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">Sukanya Samriddhi Yojana Calculator: Complete Maturity & Investment Guide</h2>
      <p>
        The <strong>Sukanya Samriddhi Yojana calculator</strong> is an indispensable financial planning tool designed to help Indian parents and legal guardians calculate the exact maturity wealth, total annual interest, and overall corpus accumulated for their daughter's future. Launched under the Government of India's flagship <em>"Beti Bachao, Beti Padhao"</em> initiative, Sukanya Samriddhi Yojana (SSY) guarantees unmatched financial security, sovereign capital backing, and the highest small savings interest rate in India—currently fixed at <strong>8.2% per annum</strong>.
      </p>
      <p>
        Whether you open an SSY account through a local post office or an authorized public/private commercial bank, using an accurate <strong>sukanya samriddhi yojana calculator</strong> enables you to project your returns year-by-year, understand the magic of long-term compounding, and optimize your annual contributions to secure your child's higher education and marriage without financial distress.
      </p>

      <h2 class="text-lg font-bold text-slate-900 dark:text-white">SBI Sukanya Samriddhi Yojana Calculator vs. Post Office Sukanya Samriddhi Yojana Calculator</h2>
      <p>
        Two of the most popular institutions where Indian families open and maintain SSY accounts are the <strong>State Bank of India (SBI)</strong> and the <strong>Department of Posts (India Post / Post Office)</strong>. Many parents frequently search for an <strong>sbi sukanya samriddhi yojana calculator</strong> or a <strong>post office sukanya samriddhi yojana calculator</strong> to discover whether one offers higher returns than the other.
      </p>
      <p>
        <strong>Crucial Clarification:</strong> The interest rate, compounding frequency, deposit ceiling, withdrawal conditions, and maturity formula for Sukanya Samriddhi Yojana are <em>strictly identical</em> across both State Bank of India and India Post. Both are regulated under the Government Savings Promotion Act rules by the Ministry of Finance, Government of India. Therefore, whether you use a <strong>sukanya samriddhi yojana calculator sbi</strong> or a <strong>sukanya samriddhi yojana calculator post office</strong>, the financial output and maturity corpus generated for identical deposit amounts are 100% the same.
      </p>

      <!-- COMPARISON TABLE: SBI VS POST OFFICE -->
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Detailed Comparison: SBI SSY Account vs. Post Office SSY Account</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse border border-slate-200 dark:border-slate-800">
          <thead>
            <tr class="bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200">
              <th class="p-2.5 font-bold">Key Feature / Parameter</th>
              <th class="p-2.5 font-bold text-blue-600 dark:text-blue-400">SBI Sukanya Samriddhi Account</th>
              <th class="p-2.5 font-bold text-amber-600 dark:text-amber-400">Post Office Sukanya Samriddhi Account</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-600 dark:text-slate-300">
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Governing Body & Rate</td>
              <td class="p-2.5 font-bold text-emerald-600">8.2% p.a. (Govt of India Sovereign)</td>
              <td class="p-2.5 font-bold text-emerald-600">8.2% p.a. (Govt of India Sovereign)</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Annual Deposit Limits</td>
              <td class="p-2.5">Min ₹250 / Max ₹1,50,000 per FY</td>
              <td class="p-2.5">Min ₹250 / Max ₹1,50,000 per FY</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Online Digital Banking</td>
              <td class="p-2.5">Seamless via <strong>SBI YONO App</strong> &amp; OnlineSBI Net Banking</td>
              <td class="p-2.5">Supported via <strong>IPPB Mobile App</strong> &amp; Dak Pay UPI</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Standing Instruction (SI)</td>
              <td class="p-2.5 text-blue-600 font-semibold">1-click auto-debit from SBI Savings Account</td>
              <td class="p-2.5">Supported via linked IPPB Savings Account</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Branch Footprint</td>
              <td class="p-2.5">22,400+ branches across urban &amp; semi-urban India</td>
              <td class="p-2.5 font-semibold text-slate-800 dark:text-slate-200">1,55,000+ branches with unrivaled rural reach</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Passbook &amp; Statements</td>
              <td class="p-2.5">Instant e-statements + physical branch passbook</td>
              <td class="p-2.5">Physical passbook stamped at branch counter</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-slate-900 dark:text-white">Transferability</td>
              <td class="p-2.5 text-emerald-600 font-semibold">Free transfer to any Post Office or Bank</td>
              <td class="p-2.5 text-emerald-600 font-semibold">Free transfer to SBI or any other Bank</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-lg font-bold text-slate-900 dark:text-white">How the SBI Sukanya Samriddhi Yojana Calculator Helps Investors</h2>
      <p>
        If you bank with State Bank of India, using the <strong>sbi sukanya samriddhi yojana calculator</strong> provides a transparent forecast of what your regular deposits will yield over the 21-year maturity horizon. SBI customers benefit immensely from automated standing instructions through the <strong>YONO SBI mobile app</strong> or the SBI Internet Banking portal (OnlineSBI).
      </p>
      <p>
        By setting up an automatic debit of, say, ₹10,000 every month on the 1st of each month directly from your SBI savings account, you ensure that you never miss the deposit deadline (5th of each month) to earn maximum compounding interest. The <strong>sukanya samriddhi yojana calculator sbi</strong> above lets you test either monthly contributions (e.g., ₹2,500, ₹5,000, or ₹12,500) or lump-sum annual investments up to the statutory maximum of ₹1,50,000.
      </p>

      <h2 class="text-lg font-bold text-slate-900 dark:text-white">How the Post Office Sukanya Samriddhi Yojana Calculator Works</h2>
      <p>
        India Post manages the largest network of SSY accounts in the country. With more than 1.55 lakh post offices spanning every rural block and urban pincode, a <strong>post office sukanya samriddhi yojana calculator</strong> is vital for millions of families wanting a dependable estimator.
      </p>
      <p>
        Depositing funds into a Post Office SSY account is no longer restricted to physical visits. Account holders can link their account with an <strong>India Post Payments Bank (IPPB)</strong> digital account. With the IPPB Mobile Banking application or the Dak Pay UPI app, parents can transfer their monthly or annual SSY deposits straight from their smartphone without waiting in post office queues. Using this <strong>sukanya samriddhi yojana calculator post office</strong>, you can calculate the exact maturity amount down to the single rupee based on your scheduled deposit amount.
      </p>

      <h2 class="text-lg font-bold text-slate-900 dark:text-white">The 15-Year Deposit vs. 21-Year Maturity Rule Explained</h2>
      <p>
        A frequent point of confusion among investors is the timeline. Sukanya Samriddhi Yojana has a unique structure that makes its compounding returns remarkably powerful:
      </p>
      <div class="rounded-2xl border border-blue-200 bg-blue-50/70 p-4 text-xs dark:border-blue-900/50 dark:bg-blue-950/30">
        <h4 class="font-bold text-blue-900 dark:text-blue-200 text-sm mb-1.5">Understanding the Two Distinct Phases</h4>
        <ul class="list-disc pl-5 space-y-1.5 text-blue-800 dark:text-blue-300">
          <li><strong>Phase 1: Active Deposit Phase (Years 1 to 15):</strong> You deposit funds annually or monthly for exactly 15 years from the date of account opening. For example, if you open an account in 2026, deposits will continue until 2040.</li>
          <li><strong>Phase 2: Compounding Accumulation Phase (Years 16 to 21):</strong> During the final 6 years, you are neither required nor allowed to make fresh deposits. However, your accumulated corpus remains fully invested and continues to compound annually at the prevailing sovereign interest rate (currently 8.2% p.a.). This 6-year holding period generates tens of lakhs in passive compound interest!</li>
        </ul>
      </div>

      <h2 class="text-lg font-bold text-slate-900 dark:text-white">Calculation Example: What Happens When You Invest ₹1.5 Lakh Annually?</h2>
      <p>
        When you maximize the ₹1,50,000 annual Section 80C ceiling starting from your daughter's 1st year at an interest rate of 8.2%:
      </p>
      <ol class="list-decimal pl-5 space-y-1.5 text-slate-700 dark:text-slate-300">
        <li><strong>Total Capital Invested (15 Years):</strong> ₹1,50,000 &times; 15 years = <strong>₹22,50,000</strong>.</li>
        <li><strong>Balance at the End of Year 15:</strong> Approximately <strong>₹43,90,000</strong> (comprising your ₹22.5 Lakh deposit + ₹21.4 Lakh earned interest).</li>
        <li><strong>Pure Interest Generated in Years 16 to 21 (Zero New Deposits):</strong> An additional <strong>₹25,90,000+</strong> generated purely from uninterrupted compounding.</li>
        <li><strong>Final Tax-Free Maturity Value (Year 21):</strong> An extraordinary payout of <strong>₹69,80,000+</strong> transferred tax-free to your daughter when she turns 21 or 22.</li>
      </ol>

      <h2 class="text-lg font-bold text-slate-900 dark:text-white">Step-by-Step: How to Deposit in SBI &amp; Post Office SSY Accounts Online</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 text-xs dark:border-slate-800 dark:bg-slate-900/50">
          <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-2 flex items-center gap-1.5">
            <span>🏦</span> SBI Online Deposit via YONO:
          </h4>
          <ol class="list-decimal pl-4 space-y-1 text-slate-600 dark:text-slate-300">
            <li>Log into the <strong>YONO SBI</strong> mobile app or OnlineSBI portal.</li>
            <li>Go to <strong>Deposits</strong> or <strong>Pay &amp; Transfer</strong>.</li>
            <li>Select your daughter's linked <strong>Sukanya Samriddhi Account</strong>.</li>
            <li>Enter deposit amount (up to ₹1,50,000/yr) and choose instant transfer.</li>
            <li>Set up a recurring monthly <strong>Standing Instruction (SI)</strong> for automated deposits.</li>
          </ol>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 text-xs dark:border-slate-800 dark:bg-slate-900/50">
          <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-2 flex items-center gap-1.5">
            <span>📮</span> Post Office Online Deposit via IPPB:
          </h4>
          <ol class="list-decimal pl-4 space-y-1 text-slate-600 dark:text-slate-300">
            <li>Open the <strong>IPPB Mobile Banking</strong> application.</li>
            <li>Navigate to <strong>DOP Services</strong> &rarr; <strong>Sukanya Samriddhi Account</strong>.</li>
            <li>Enter the Post Office SSY account number and your DOP Customer ID (CIF).</li>
            <li>Input the deposit amount and authenticate via MPIN/OTP.</li>
            <li>Receive instant confirmation and SMS notification from India Post.</li>
          </ol>
        </div>
      </div>

      <h2 class="text-lg font-bold text-slate-900 dark:text-white">Triple Tax Exemption (EEE Status)</h2>
      <p>
        Sukanya Samriddhi Yojana is one of the rare investment vehicles in India granted full <strong>EEE (Exempt-Exempt-Exempt)</strong> status under the Indian Income Tax Act:
      </p>
      <ul class="list-disc pl-5 space-y-1 text-slate-700 dark:text-slate-300">
        <li><strong>Exemption on Investment:</strong> Annual contributions up to ₹1,50,000 are eligible for deduction under Section 80C (Old Tax Regime).</li>
        <li><strong>Exemption on Accrued Interest:</strong> The 8.2% annual compound interest earned every financial year is 100% tax-free.</li>
        <li><strong>Exemption on Maturity Payout:</strong> The entire lump-sum proceeds paid upon 21-year maturity are completely non-taxable and exempt from capital gains tax.</li>
      </ul>
    </article>
  </Fragment>

  <!-- FAQS -->
  <Fragment slot="faq">
    <div class="space-y-3">
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900" open>
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">What is the difference between the SBI Sukanya Samriddhi Yojana calculator and the Post Office calculator?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">There is no mathematical or financial difference. Both SBI and the Post Office adhere to identical rules and interest rates (8.2% p.a.) set by the Ministry of Finance, Government of India. The only distinction is operational: SBI offers digital banking through the YONO app, whereas the Post Office offers access via the IPPB app along with an extensive network of 1.55+ lakh rural branches.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">What is the current interest rate for Sukanya Samriddhi Yojana in 2025–2026?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">The current interest rate is <strong>8.2% per annum</strong>, compounded annually. The rate is reviewed and notified on a quarterly basis by the Ministry of Finance, Government of India, and remains the highest among all government small savings instruments.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">Can I transfer my Sukanya Samriddhi Yojana account from Post Office to SBI (or vice versa)?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Yes. Under official rules, an SSY account can be transferred anywhere across India free of charge. You can easily transfer an account from a Post Office to an SBI branch, or from SBI to a Post Office, by submitting a transfer request form along with your original passbook and revised KYC documentation.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">What happens during years 16 to 21 when no deposits are made?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Under the scheme rules, parents only deposit funds for the first 15 years. From year 16 through year 21, zero fresh deposits are allowed or required; however, your entire accumulated corpus continues to earn full compound interest at the applicable government rate until the account reaches its 21-year maturity.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">What is the minimum and maximum amount I can deposit in SSY each year?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">The minimum annual deposit is ₹250 per financial year, and the maximum ceiling is ₹1,50,000 per financial year. You can deposit in multiples of ₹50 through lump sums or multiple installments throughout the financial year.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">Is Sukanya Samriddhi Yojana completely tax-free under Income Tax?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Yes, SSY enjoys coveted <strong>Exempt-Exempt-Exempt (EEE)</strong> tax status. Annual investments up to ₹1.5 Lakh are deductible under Section 80C, annual compounding interest is completely non-taxable, and the entire maturity proceeds paid to your daughter are 100% tax-free.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">How do I deposit money into a Post Office SSY account online?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">You can download the IPPB (India Post Payments Bank) mobile app, select 'DOP Services', choose 'Sukanya Samriddhi Account', enter your SSY account number and Customer ID (CIF), and pay directly via net banking or UPI.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white">Can partial withdrawals be made from an SSY account before 21 years?</summary>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">Yes, once the girl child turns 18 years old or passes the 10th standard, up to 50% of the accumulated balance at the end of the previous financial year can be withdrawn specifically for higher education expenses, supported by fee receipts or admission proofs.</p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<script is:inline>
(function initSsyCalculator() {
  let frequency = 'yearly';

  const amountInput = document.getElementById('ssy-amount');
  const sliderAmount = document.getElementById('slider-ssy-amount');
  const ageSelect = document.getElementById('ssy-girl-age');
  const startYearInput = document.getElementById('ssy-start-year');
  const sliderStartYear = document.getElementById('slider-ssy-start-year');
  const rateInput = document.getElementById('ssy-rate');

  const displayAmount = document.getElementById('display-ssy-amount');
  const displayAge = document.getElementById('display-ssy-age');
  const displayRate = document.getElementById('display-ssy-rate');
  const labelDepositAmount = document.getElementById('label-deposit-amount');

  const resMaturityAmount = document.getElementById('res-maturity-amount');
  const resMaturityYearLabel = document.getElementById('res-maturity-year-label');
  const resTotalInvested = document.getElementById('res-total-invested');
  const resTotalInterest = document.getElementById('res-total-interest');
  const scheduleTbody = document.getElementById('ssy-schedule-tbody');

  const btnYearly = document.getElementById('freq-yearly');
  const btnMonthly = document.getElementById('freq-monthly');

  function formatInr(val) {
    return '₹' + Math.round(val).toLocaleString('en-IN');
  }

  let scheduleViewMode = 'yearly';
  const btnScheduleYearly = document.getElementById('btn-schedule-yearly');
  const btnScheduleMonthly = document.getElementById('btn-schedule-monthly');
  const scheduleThead = document.getElementById('ssy-schedule-thead');

  const monthNames = ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'];

  function renderScheduleTable(yearlyData, monthlyData) {
    if (!scheduleTbody || !scheduleThead) return;

    if (scheduleViewMode === 'yearly') {
      scheduleThead.innerHTML = `
        <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold">
          <th class="p-2.5">Year</th>
          <th class="p-2.5">Girl's Age</th>
          <th class="p-2.5">Opening Balance</th>
          <th class="p-2.5">Deposit (₹)</th>
          <th class="p-2.5">Interest Earned (8.2%)</th>
          <th class="p-2.5">Closing Balance</th>
        </tr>
      `;
      scheduleTbody.innerHTML = yearlyData.map(row => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 ${!row.isDepositPeriod ? 'bg-blue-50/20 dark:bg-blue-950/20' : ''}">
          <td class="p-2.5 font-bold">Year ${row.year} (${row.calYear})</td>
          <td class="p-2.5">${row.girlAge} yrs</td>
          <td class="p-2.5">${formatInr(row.openBal)}</td>
          <td class="p-2.5 ${row.isDepositPeriod ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-slate-400 italic'}">
            ${row.isDepositPeriod ? formatInr(row.deposit) : 'No deposit'}
          </td>
          <td class="p-2.5 text-emerald-600 dark:text-emerald-400">+${formatInr(row.interest)}</td>
          <td class="p-2.5 font-bold">${formatInr(row.closeBal)}</td>
        </tr>
      `).join('');
    } else {
      scheduleThead.innerHTML = `
        <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold">
          <th class="p-2.5">Month</th>
          <th class="p-2.5">Year &amp; Age</th>
          <th class="p-2.5">Opening Balance</th>
          <th class="p-2.5">Monthly Deposit</th>
          <th class="p-2.5">Interest Accrued</th>
          <th class="p-2.5">Closing Balance</th>
        </tr>
      `;
      scheduleTbody.innerHTML = monthlyData.map(row => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 ${!row.isDepositPeriod ? 'bg-blue-50/20 dark:bg-blue-950/20' : ''}">
          <td class="p-2.5 font-bold whitespace-nowrap">Mo ${row.monthNumber} (${row.monthName} ${row.calYear})</td>
          <td class="p-2.5 whitespace-nowrap text-slate-600 dark:text-slate-300">Yr ${row.year} • ${row.girlAge} yrs</td>
          <td class="p-2.5">${formatInr(row.openBal)}</td>
          <td class="p-2.5 ${row.deposit > 0 ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-slate-400 italic'}">
            ${row.deposit > 0 ? formatInr(row.deposit) : '—'}
          </td>
          <td class="p-2.5 text-emerald-600 dark:text-emerald-400">+${formatInr(row.interest)}</td>
          <td class="p-2.5 font-bold">${formatInr(row.closeBal)}</td>
        </tr>
      `).join('');
    }
  }

  function calculate() {
    const rawAmt = parseFloat(amountInput?.value) || 0;
    const age = parseInt(ageSelect?.value) || 0;
    const rate = (parseFloat(rateInput?.value) || 8.2) / 100;
    const startYear = parseInt(startYearInput?.value) || 2026;

    if (displayAmount) displayAmount.textContent = formatInr(rawAmt);
    if (displayAge) displayAge.textContent = `${age} ${age === 1 ? 'Year' : 'Years'}`;
    if (displayRate) displayRate.textContent = `${(rate * 100).toFixed(1)}%`;
    if (sliderAmount) sliderAmount.value = rawAmt;
    if (sliderStartYear) sliderStartYear.value = startYear;

    const yearlyDeposit = frequency === 'monthly' ? rawAmt * 12 : rawAmt;

    let balance = 0;
    let totalInvested = 0;
    let totalInterest = 0;
    const scheduleYearly = [];
    const scheduleMonthly = [];

    const monthlyRate = rate / 12;

    for (let yr = 1; yr <= 21; yr++) {
      const calYear = startYear + (yr - 1);
      const girlAge = age + (yr - 1);
      const yrOpenBal = balance;
      const isDepositPeriod = yr <= 15;
      const yrDeposit = isDepositPeriod ? yearlyDeposit : 0;

      totalInvested += yrDeposit;
      const yrInterest = (yrOpenBal + yrDeposit) * rate;
      balance = yrOpenBal + yrDeposit + yrInterest;
      totalInterest += yrInterest;

      scheduleYearly.push({
        year: yr,
        calYear,
        girlAge,
        openBal: yrOpenBal,
        deposit: yrDeposit,
        interest: yrInterest,
        closeBal: balance,
        isDepositPeriod,
      });

      // Monthly simulation (12 months in this year)
      let mBal = yrOpenBal;
      for (let m = 1; m <= 12; m++) {
        const totM = (yr - 1) * 12 + m;
        const mOpenBal = mBal;
        let mDep = 0;
        if (isDepositPeriod) {
          if (frequency === 'monthly') {
            mDep = rawAmt;
          } else if (m === 1) {
            mDep = rawAmt;
          }
        }
        const mInt = (mOpenBal + mDep) * monthlyRate;
        mBal = mOpenBal + mDep + mInt;

        scheduleMonthly.push({
          monthNumber: totM,
          monthName: monthNames[m - 1],
          year: yr,
          calYear,
          girlAge,
          openBal: mOpenBal,
          deposit: mDep,
          interest: mInt,
          closeBal: mBal,
          isDepositPeriod,
        });
      }
    }

    if (resMaturityAmount) resMaturityAmount.textContent = formatInr(balance);
    if (resMaturityYearLabel) {
      resMaturityYearLabel.textContent = `Matures in ${startYear + 21} (Daughter's Age: ${age + 21} Years)`;
    }
    if (resTotalInvested) resTotalInvested.textContent = formatInr(totalInvested);
    if (resTotalInterest) resTotalInterest.textContent = formatInr(totalInterest);

    renderScheduleTable(scheduleYearly, scheduleMonthly);
  }

  btnScheduleYearly?.addEventListener('click', () => {
    if (scheduleViewMode === 'yearly') return;
    scheduleViewMode = 'yearly';
    btnScheduleYearly.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
    btnScheduleYearly.classList.remove('text-slate-600', 'dark:text-slate-300');
    btnScheduleMonthly?.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
    btnScheduleMonthly?.classList.add('text-slate-600', 'dark:text-slate-300');
    if (hasCalculated) calculate();
  });

  btnScheduleMonthly?.addEventListener('click', () => {
    if (scheduleViewMode === 'monthly') return;
    scheduleViewMode = 'monthly';
    btnScheduleMonthly.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
    btnScheduleMonthly.classList.remove('text-slate-600', 'dark:text-slate-300');
    btnScheduleYearly?.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
    btnScheduleYearly?.classList.add('text-slate-600', 'dark:text-slate-300');
    if (hasCalculated) calculate();
  });

  let hasCalculated = false;
  const btnCalc = document.getElementById('btn-calc-ssy');
  const btnClear = document.getElementById('btn-clear-ssy');
  const resultsPlaceholder = document.getElementById('ssy-results-placeholder');
  const resultsSection = document.getElementById('results-section');
  const scheduleSection = document.getElementById('schedule-section');

  function showResults() {
    hasCalculated = true;
    calculate();
    resultsPlaceholder?.classList.add('hidden');
    resultsSection?.classList.remove('hidden');
    resultsSection?.classList.add('flex');
    scheduleSection?.classList.remove('hidden');
    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.remove('hidden');
    resultsSection?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function clearCalculator() {
    hasCalculated = false;
    frequency = 'yearly';
    btnYearly?.classList.add('active', 'bg-blue-600', 'text-white');
    btnYearly?.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    btnMonthly?.classList.remove('active', 'bg-blue-600', 'text-white');
    btnMonthly?.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700');

    if (labelDepositAmount) labelDepositAmount.textContent = 'Yearly Investment (₹)';
    if (amountInput) {
      amountInput.max = '150000';
      amountInput.value = '150000';
    }
    if (sliderAmount) {
      sliderAmount.max = '150000';
      sliderAmount.value = '150000';
    }
    if (ageSelect) ageSelect.value = '1';
    if (startYearInput) startYearInput.value = '2026';
    if (sliderStartYear) sliderStartYear.value = '2026';
    if (rateInput) rateInput.value = '8.2';

    if (displayAmount) displayAmount.textContent = formatInr(150000);
    if (displayAge) displayAge.textContent = '1 Year Old';
    if (displayRate) displayRate.textContent = '8.2%';

    scheduleViewMode = 'yearly';
    btnScheduleYearly?.classList.add('bg-blue-600', 'text-white', 'shadow-xs');
    btnScheduleYearly?.classList.remove('text-slate-600', 'dark:text-slate-300');
    btnScheduleMonthly?.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
    btnScheduleMonthly?.classList.add('text-slate-600', 'dark:text-slate-300');

    resultsPlaceholder?.classList.remove('hidden');
    resultsSection?.classList.add('hidden');
    resultsSection?.classList.remove('flex');
    scheduleSection?.classList.add('hidden');
    const bar = document.getElementById('calc-action-bar-container');
    if (bar) bar.classList.add('hidden');
  }

  btnCalc?.addEventListener('click', showResults);
  btnClear?.addEventListener('click', clearCalculator);

  // Freq toggle
  btnYearly?.addEventListener('click', () => {
    frequency = 'yearly';
    btnYearly.classList.add('active', 'bg-blue-600', 'text-white');
    btnYearly.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    btnMonthly?.classList.remove('active', 'bg-blue-600', 'text-white');
    btnMonthly?.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    if (labelDepositAmount) labelDepositAmount.textContent = 'Yearly Investment (₹)';
    if (amountInput) {
      amountInput.max = '150000';
      if (parseFloat(amountInput.value) < 5000) amountInput.value = '150000';
    }
    if (sliderAmount) sliderAmount.max = '150000';
    if (hasCalculated) calculate();
  });

  btnMonthly?.addEventListener('click', () => {
    frequency = 'monthly';
    btnMonthly.classList.add('active', 'bg-blue-600', 'text-white');
    btnMonthly.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    btnYearly?.classList.remove('active', 'bg-blue-600', 'text-white');
    btnYearly?.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-700');
    if (labelDepositAmount) labelDepositAmount.textContent = 'Monthly Investment (₹)';
    if (amountInput) {
      amountInput.max = '12500';
      if (parseFloat(amountInput.value) > 12500) amountInput.value = '5000';
    }
    if (sliderAmount) sliderAmount.max = '12500';
    if (hasCalculated) calculate();
  });

  amountInput?.addEventListener('input', () => {
    const val = parseFloat(amountInput?.value) || 0;
    if (displayAmount) displayAmount.textContent = formatInr(val);
    if (sliderAmount) sliderAmount.value = val;
    if (hasCalculated) calculate();
  });

  sliderAmount?.addEventListener('input', (e) => {
    if (amountInput) amountInput.value = e.target.value;
    if (displayAmount) displayAmount.textContent = formatInr(parseFloat(e.target.value) || 0);
    if (hasCalculated) calculate();
  });

  ageSelect?.addEventListener('change', () => {
    const a = parseInt(ageSelect?.value) || 0;
    if (displayAge) displayAge.textContent = `${a} Year${a !== 1 ? 's' : ''} Old`;
    if (hasCalculated) calculate();
  });

  startYearInput?.addEventListener('input', (e) => {
    const val = parseInt(e.target.value) || 2026;
    if (sliderStartYear) sliderStartYear.value = val;
    if (hasCalculated) calculate();
  });

  sliderStartYear?.addEventListener('input', (e) => {
    const val = e.target.value;
    if (startYearInput) startYearInput.value = val;
    if (hasCalculated) calculate();
  });

  rateInput?.addEventListener('input', () => {
    const r = parseFloat(rateInput?.value) || 8.2;
    if (displayRate) displayRate.textContent = `${r.toFixed(1)}%`;
    if (hasCalculated) calculate();
  });

  // Quick presets
  document.querySelectorAll('.btn-ssy-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode;
      const amt = btn.dataset.amt;
      const age = btn.dataset.age;

      if (mode === 'monthly') btnMonthly?.click();
      else btnYearly?.click();

      if (amountInput) amountInput.value = amt;
      if (ageSelect) ageSelect.value = age;
      showResults();
    });
  });
})();
</script>
