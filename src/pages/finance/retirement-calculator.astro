<script is:inline>
  // State
  let lastCalculatedRetirement = null;
  let activeProjectionTab = 'accum'; // 'accum' | 'decum'

  // Input DOM Elements
  const inpRetCurAge = document.getElementById('inp-ret-cur-age');
  const inpRetRetAge = document.getElementById('inp-ret-ret-age');
  const inpRetLifeAge = document.getElementById('inp-ret-life-age');
  const badgeRetTimeline = document.getElementById('badge-ret-timeline');

  const inpRetExpenses = document.getElementById('inp-ret-expenses');
  const selRetExpBasis = document.getElementById('sel-ret-exp-basis');
  const selRetExpChange = document.getElementById('sel-ret-exp-change');
  const rowRetCustomExp = document.getElementById('row-ret-custom-exp');
  const inpRetCustomExpPct = document.getElementById('inp-ret-custom-exp-pct');
  const inpRetInf = document.getElementById('inp-ret-inf');

  const inpRetSavings = document.getElementById('inp-ret-savings');
  const inpRetMonthlyInv = document.getElementById('inp-ret-monthly-inv');
  const inpRetStepUp = document.getElementById('inp-ret-step-up');

  const inpRetPreReturn = document.getElementById('inp-ret-pre-return');
  const inpRetPostReturn = document.getElementById('inp-ret-post-return');

  const inpRetOtherIncome = document.getElementById('inp-ret-other-income');
  const selRetMethod = document.getElementById('sel-ret-method');
  const colRetSwr = document.getElementById('col-ret-swr');
  const inpRetSwr = document.getElementById('inp-ret-swr');

  const btnCalcRet = document.getElementById('btn-calc-ret');
  const btnClearRet = document.getElementById('btn-clear-ret');
  const errRet = document.getElementById('err-ret');

  // Results DOM Elements
  const retResultsSection = document.getElementById('ret-results-section');
  const resRetCorpusHero = document.getElementById('res-ret-corpus-hero');
  const resRetCorpusExact = document.getElementById('res-ret-corpus-exact');
  const resRetFutureMoHero = document.getElementById('res-ret-future-mo-hero');
  const resRetYearsLeft = document.getElementById('res-ret-years-left');
  const resRetDuration = document.getElementById('res-ret-duration');
  const resRetProjSavings = document.getElementById('res-ret-proj-savings');
  const lblRetGapTitle = document.getElementById('lbl-ret-gap-title');
  const resRetGapAmount = document.getElementById('res-ret-gap-amount');

  // Summary Elements
  const sumCurAge = document.getElementById('sum-cur-age');
  const sumRetAge = document.getElementById('sum-ret-age');
  const sumLifeAge = document.getElementById('sum-life-age');
  const sumCurExp = document.getElementById('sum-cur-exp');
  const sumInfRate = document.getElementById('sum-inf-rate');
  const sumCurSav = document.getElementById('sum-cur-sav');
  const sumMonthlyInv = document.getElementById('sum-monthly-inv');
  const sumReturns = document.getElementById('sum-returns');

  // Gap Analysis Elements
  const hdrGapStatus = document.getElementById('hdr-gap-status');
  const badgeGapStatus = document.getElementById('badge-gap-status');
  const txtExpCur = document.getElementById('txt-exp-cur');
  const txtExpInf = document.getElementById('txt-exp-inf');
  const txtExpFutureMo = document.getElementById('txt-exp-future-mo');
  const txtExpFutureYr = document.getElementById('txt-exp-future-yr');
  const boxGapAdvice = document.getElementById('box-gap-advice');

  // Chart Elements
  const barRetFunding = document.getElementById('bar-ret-funding');
  const lblChartProjSavings = document.getElementById('lbl-chart-proj-savings');
  const lblChartTargetCorpus = document.getElementById('lbl-chart-target-corpus');

  // Scenario Table
  const tblRetScenarios = document.getElementById('tbl-ret-scenarios');

  // Projection Table Elements
  const tabRetAccum = document.getElementById('tab-ret-accum');
  const tabRetDecum = document.getElementById('tab-ret-decum');
  const btnRetDownloadPdf = document.getElementById('btn-ret-download-pdf');
  const txtBtnRetPdf = document.getElementById('txt-btn-ret-pdf');
  const bannerRetDepletion = document.getElementById('banner-ret-depletion');
  const txtDepletionAge = document.getElementById('txt-depletion-age');
  const retSchedThead = document.getElementById('ret-sched-thead');
  const retSchedTbody = document.getElementById('ret-sched-tbody');

  // Format INR Currency
  function formatINR(val, compact = false) {
    const num = Number(val);
    if (isNaN(num)) return '₹ 0';
    if (compact) {
      if (Math.abs(num) >= 10000000) {
        return `₹ ${(num / 10000000).toFixed(2)} Crore`;
      }
      if (Math.abs(num) >= 100000) {
        return `₹ ${(num / 100000).toFixed(2)} Lakh`;
      }
    }
    return `₹ ${Math.round(num).toLocaleString('en-IN')}`;
  }

  // Update live timeline badge
  function updateTimelineBadge() {
    const cAge = parseInt(inpRetCurAge.value) || 0;
    const rAge = parseInt(inpRetRetAge.value) || 0;
    const lAge = parseInt(inpRetLifeAge.value) || 0;

    const yToRet = Math.max(0, rAge - cAge);
    const retSpan = Math.max(0, lAge - rAge);
    badgeRetTimeline.textContent = `${yToRet} Years to Retire | ${retSpan} Years in Retirement`;
  }

  [inpRetCurAge, inpRetRetAge, inpRetLifeAge].forEach((el) => {
    el.addEventListener('input', updateTimelineBadge);
  });
  updateTimelineBadge();

  // Custom Expense Change Toggle
  selRetExpChange.addEventListener('change', () => {
    if (selRetExpChange.value === 'custom') {
      rowRetCustomExp.classList.remove('hidden');
    } else {
      rowRetCustomExp.classList.add('hidden');
    }
  });

  // Safe Withdrawal Rate Toggle
  selRetMethod.addEventListener('change', () => {
    if (selRetMethod.value === 'withdrawal-rate') {
      colRetSwr.classList.remove('hidden');
    } else {
      colRetSwr.classList.add('hidden');
    }
  });

  // Master Calculation
  function executeRetirementCalculation() {
    errRet.classList.add('hidden');

    const curAge = parseInt(inpRetCurAge.value) || 0;
    const retAge = parseInt(inpRetRetAge.value) || 0;
    const lifeAge = parseInt(inpRetLifeAge.value) || 0;

    if (curAge <= 0) {
      errRet.textContent = 'Current age must be greater than 0.';
      errRet.classList.remove('hidden');
      retResultsSection.classList.add('hidden');
      return;
    }

    if (retAge <= curAge) {
      errRet.textContent = 'Retirement age must be greater than your current age.';
      errRet.classList.remove('hidden');
      retResultsSection.classList.add('hidden');
      return;
    }

    if (lifeAge <= retAge) {
      errRet.textContent = 'Life expectancy must be greater than your target retirement age.';
      errRet.classList.remove('hidden');
      retResultsSection.classList.add('hidden');
      return;
    }

    let rawExp = parseFloat(inpRetExpenses.value);
    if (isNaN(rawExp) || rawExp < 0) {
      errRet.textContent = 'Please enter a valid expense amount.';
      errRet.classList.remove('hidden');
      retResultsSection.classList.add('hidden');
      return;
    }

    const expBasis = selRetExpBasis.value; // 'monthly' | 'annual'
    const curExpensesMonthly = expBasis === 'annual' ? (rawExp / 12) : rawExp;

    let expenseChangePct = 0;
    if (selRetExpChange.value === 'custom') {
      expenseChangePct = parseFloat(inpRetCustomExpPct.value) || 0;
    } else {
      expenseChangePct = parseFloat(selRetExpChange.value) || 0;
    }

    const infRate = parseFloat(inpRetInf.value);
    if (isNaN(infRate) || infRate < 0) {
      errRet.textContent = 'Inflation rate cannot be negative.';
      errRet.classList.remove('hidden');
      retResultsSection.classList.add('hidden');
      return;
    }

    const curSavings = parseFloat(inpRetSavings.value) || 0;
    const monthlyInv = parseFloat(inpRetMonthlyInv.value) || 0;
    const stepUpPct = parseFloat(inpRetStepUp.value) || 0;

    const preReturn = parseFloat(inpRetPreReturn.value);
    const postReturn = parseFloat(inpRetPostReturn.value);

    if (isNaN(preReturn) || preReturn < 0 || isNaN(postReturn) || postReturn < 0) {
      errRet.textContent = 'Expected return rates cannot be negative.';
      errRet.classList.remove('hidden');
      retResultsSection.classList.add('hidden');
      return;
    }

    const otherIncomeMonthly = parseFloat(inpRetOtherIncome.value) || 0;
    const calcMethod = selRetMethod.value;
    const swrPct = parseFloat(inpRetSwr.value) || 4.0;

    const yearsToRetirement = retAge - curAge;
    const retirementDuration = lifeAge - retAge;

    // Adjusted monthly expense for lifestyle shift
    const baseMonthlyAfterShift = curExpensesMonthly * (1 + expenseChangePct / 100);

    // Future monthly expense at retirement (inflated across yearsToRetirement)
    const infFactor = Math.pow(1 + infRate / 100, yearsToRetirement);
    const futureMonthlyExpense = baseMonthlyAfterShift * infFactor;
    const futureAnnualExpense = futureMonthlyExpense * 12;

    // Net annual expense to be funded by corpus (subtracting other income)
    const netFutureMonthly = Math.max(0, futureMonthlyExpense - otherIncomeMonthly);
    const netFutureAnnual = netFutureMonthly * 12;

    // Required Corpus Calculation
    let requiredCorpus = 0;
    if (calcMethod === 'withdrawal-rate') {
      const swrDec = swrPct / 100;
      requiredCorpus = swrDec > 0 ? (netFutureAnnual / swrDec) : 0;
    } else {
      const infDec = infRate / 100;
      const postDec = postReturn / 100;
      const realRate = (postDec - infDec) / (1 + infDec);

      if (Math.abs(realRate) < 0.00001) {
        requiredCorpus = netFutureAnnual * retirementDuration;
      } else {
        const factor = (1 - Math.pow(1 + realRate, -retirementDuration)) / realRate;
        requiredCorpus = Math.max(0, netFutureAnnual * factor);
      }
    }
    requiredCorpus = Math.round(requiredCorpus);

    // Accumulation Phase Simulation
    const accumulationSchedule = [];
    let accumBalance = curSavings;
    let currentMonthlyContribution = monthlyInv;
    const monthlyPreRate = preReturn / 12 / 100;

    for (let y = 1; y <= yearsToRetirement; y++) {
      const age = curAge + y;
      const openingBalance = accumBalance;
      let yearContrib = 0;

      for (let m = 1; m <= 12; m++) {
        if (currentMonthlyContribution > 0) {
          accumBalance += currentMonthlyContribution;
          yearContrib += currentMonthlyContribution;
        }
        if (monthlyPreRate > 0) {
          accumBalance += accumBalance * monthlyPreRate;
        }
      }

      const growth = accumBalance - openingBalance - yearContrib;

      accumulationSchedule.push({
        year: y,
        age,
        openingBalance,
        annualContribution: yearContrib,
        investmentGrowth: growth,
        closingBalance: accumBalance,
      });

      if (stepUpPct > 0) {
        currentMonthlyContribution += currentMonthlyContribution * (stepUpPct / 100);
      }
    }

    const projectedSavingsAtRetirement = Math.round(accumBalance);

    // Gap Analysis
    const gap = requiredCorpus - projectedSavingsAtRetirement;
    const isSurplus = gap <= 0;
    const absGap = Math.abs(gap);

    // Additional SIP Calculation (if shortfall)
    let addlMonthlySip = 0;
    if (!isSurplus && yearsToRetirement > 0) {
      if (stepUpPct === 0) {
        const r = preReturn / 12 / 100;
        const n = yearsToRetirement * 12;
        if (r === 0) addlMonthlySip = absGap / n;
        else {
          const factor = ((Math.pow(1 + r, n) - 1) / r) * (1 + r);
          addlMonthlySip = absGap / factor;
        }
      } else {
        // Binary search for SIP with step-up
        let low = 1;
        let high = absGap;
        for (let iter = 0; iter < 35; iter++) {
          const mid = (low + high) / 2;
          let bal = 0;
          let mo = mid;
          for (let y = 1; y <= yearsToRetirement; y++) {
            for (let m = 1; m <= 12; m++) {
              bal += mo;
              if (monthlyPreRate > 0) bal += bal * monthlyPreRate;
            }
            if (stepUpPct > 0) mo += mo * (stepUpPct / 100);
          }
          if (bal < absGap) low = mid;
          else high = mid;
          addlMonthlySip = mid;
        }
      }
    }
    addlMonthlySip = Math.round(addlMonthlySip);

    // Decumulation Phase Simulation
    const decumulationSchedule = [];
    let decumCorpus = projectedSavingsAtRetirement > 0 ? projectedSavingsAtRetirement : requiredCorpus;
    let curAnnualExpenseDraw = futureAnnualExpense;
    let otherAnnualInc = otherIncomeMonthly * 12;
    let depletionAge = null;

    for (let y = 1; y <= retirementDuration; y++) {
      const age = retAge + y;
      const opening = decumCorpus;
      const growth = decumCorpus > 0 ? (decumCorpus * (postReturn / 100)) : 0;
      const grossExp = curAnnualExpenseDraw;
      const netWithdraw = Math.max(0, grossExp - otherAnnualInc);

      let closing = opening + growth - netWithdraw;
      let isDepleted = false;

      if (closing <= 0.001) {
        closing = 0;
        isDepleted = true;
        if (depletionAge === null) {
          depletionAge = age;
        }
      }

      decumulationSchedule.push({
        year: y,
        age,
        openingCorpus: opening,
        investmentGrowth: growth,
        annualExpenses: grossExp,
        otherIncomeAnnual: otherAnnualInc,
        netWithdrawal: netWithdraw,
        closingCorpus: closing,
        isDepleted,
      });

      decumCorpus = closing;
      curAnnualExpenseDraw += curAnnualExpenseDraw * (infRate / 100);
    }

    // Scenario Comparison Logic
    const scenarioData = [
      { name: 'Conservative', preR: Math.max(0, preReturn - 2), postR: Math.max(0, postReturn - 1.5), inf: infRate + 1 },
      { name: 'Balanced (Current)', preR: preReturn, postR: postReturn, inf: infRate },
      { name: 'Growth', preR: preReturn + 2, postR: postReturn + 1, inf: Math.max(0, infRate - 0.5) },
    ];

    const scenarioRows = scenarioData.map((sc) => {
      let scReq = 0;
      const scFutMo = baseMonthlyAfterShift * Math.pow(1 + sc.inf / 100, yearsToRetirement);
      const scNetYr = Math.max(0, scFutMo - otherIncomeMonthly) * 12;

      const scReal = (sc.postR / 100 - sc.inf / 100) / (1 + sc.inf / 100);
      if (Math.abs(scReal) < 0.00001) {
        scReq = scNetYr * retirementDuration;
      } else {
        scReq = scNetYr * ((1 - Math.pow(1 + scReal, -retirementDuration)) / scReal);
      }
      scReq = Math.round(scReq);

      // Accumulation with scenario preR
      let scBal = curSavings;
      let scMo = monthlyInv;
      const scMoRate = sc.preR / 12 / 100;
      for (let y = 1; y <= yearsToRetirement; y++) {
        for (let m = 1; m <= 12; m++) {
          if (scMo > 0) scBal += scMo;
          if (scMoRate > 0) scBal += scBal * scMoRate;
        }
        if (stepUpPct > 0) scMo += scMo * (stepUpPct / 100);
      }
      const scProj = Math.round(scBal);
      const scGap = scProj - scReq;

      return {
        name: sc.name,
        preR: sc.preR,
        postR: sc.postR,
        inf: sc.inf,
        reqCorpus: scReq,
        projSavings: scProj,
        gap: scGap,
      };
    });

    // Save State
    lastCalculatedRetirement = {
      curAge,
      retAge,
      lifeAge,
      yearsToRetirement,
      retirementDuration,
      curExpensesMonthly,
      expenseChangePct,
      infRate,
      curSavings,
      monthlyInv,
      stepUpPct,
      preReturn,
      postReturn,
      otherIncomeMonthly,
      futureMonthlyExpense,
      futureAnnualExpense,
      requiredCorpus,
      projectedSavingsAtRetirement,
      isSurplus,
      absGap,
      addlMonthlySip,
      accumulationSchedule,
      decumulationSchedule,
      depletionAge,
      scenarioRows,
    };

    // Update Result Hero Card
    resRetCorpusHero.textContent = formatINR(requiredCorpus, true);
    resRetCorpusExact.textContent = formatINR(requiredCorpus);
    resRetFutureMoHero.textContent = `${formatINR(futureMonthlyExpense)} / mo`;
    resRetYearsLeft.textContent = `${yearsToRetirement} Years`;
    resRetDuration.textContent = `${retirementDuration} Years`;
    resRetProjSavings.textContent = formatINR(projectedSavingsAtRetirement, true);

    if (isSurplus) {
      lblRetGapTitle.textContent = 'Estimated Surplus';
      lblRetGapTitle.className = 'text-slate-500 dark:text-slate-400 font-semibold';
      resRetGapAmount.textContent = `+ ${formatINR(absGap, true)}`;
      resRetGapAmount.className = 'mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400';
    } else {
      lblRetGapTitle.textContent = 'Estimated Shortfall';
      lblRetGapTitle.className = 'text-red-500 font-semibold';
      resRetGapAmount.textContent = `- ${formatINR(absGap, true)}`;
      resRetGapAmount.className = 'mt-1 text-sm sm:text-base font-bold text-red-600 dark:text-red-400';
    }

    // Update Summary Grid
    sumCurAge.textContent = `${curAge} Years`;
    sumRetAge.textContent = `${retAge} Years`;
    sumLifeAge.textContent = `${lifeAge} Years`;
    sumCurExp.textContent = `${formatINR(curExpensesMonthly)} / mo`;
    sumInfRate.textContent = `${infRate}% p.a.`;
    sumCurSav.textContent = formatINR(curSavings);
    sumMonthlyInv.textContent = `${formatINR(monthlyInv)} / mo`;
    sumReturns.textContent = `${preReturn}% / ${postReturn}%`;

    // Update Gap Analysis & Advice
    txtExpCur.textContent = `${formatINR(curExpensesMonthly)} / mo`;
    txtExpInf.textContent = `${infRate}% across ${yearsToRetirement} years`;
    txtExpFutureMo.textContent = `${formatINR(futureMonthlyExpense)} / mo`;
    txtExpFutureYr.textContent = `${formatINR(futureAnnualExpense)} / year`;

    if (isSurplus) {
      hdrGapStatus.innerHTML = `<span>🎉</span> Projected Retirement Surplus`;
      badgeGapStatus.textContent = 'On Track (Surplus)';
      badgeGapStatus.className = 'text-xs font-bold px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300';
      boxGapAdvice.className = 'rounded-2xl p-4 space-y-2 border border-emerald-200 bg-emerald-50/50 dark:border-emerald-900/40 dark:bg-emerald-950/20';
      boxGapAdvice.innerHTML = `
        <div class="font-bold text-emerald-900 dark:text-emerald-200">Estimated Surplus: ${formatINR(absGap, true)} (${formatINR(absGap)})</div>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
          Based on your current savings of <strong>${formatINR(curSavings)}</strong> and planned investments of <strong>${formatINR(monthlyInv)}/mo</strong>, your projected corpus exceeds your estimated requirement by retirement.
        </p>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 italic">
          * This is an educational projection based on selected assumptions and does not guarantee investment returns or future market performance.
        </div>
      `;
    } else {
      hdrGapStatus.innerHTML = `<span>⚠️</span> Estimated Retirement Shortfall`;
      badgeGapStatus.textContent = 'Gap Identified';
      badgeGapStatus.className = 'text-xs font-bold px-2.5 py-1 rounded-lg bg-red-100 text-red-800 dark:bg-red-950/60 dark:text-red-300';
      boxGapAdvice.className = 'rounded-2xl p-4 space-y-2 border border-red-200 bg-red-50/50 dark:border-red-900/40 dark:bg-red-950/20';
      boxGapAdvice.innerHTML = `
        <div class="font-bold text-red-900 dark:text-red-200">Estimated Shortfall: ${formatINR(absGap, true)} (${formatINR(absGap)})</div>
        <div class="text-slate-800 dark:text-slate-200 font-semibold">
          Recommended Additional Monthly Investment: <strong class="text-red-600 dark:text-red-400">${formatINR(addlMonthlySip)} / month</strong>
        </div>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-[11px]">
          Ways to bridge this gap: increase your monthly SIP gradually, start step-up investments (5–10% annually), optimize post-retirement living expenses, or consider extending your retirement age by a few years.
        </p>
      `;
    }

    // Update Funding Ratio Bar
    const fundingPct = requiredCorpus > 0
      ? Math.min(100, Math.max(0, (projectedSavingsAtRetirement / requiredCorpus) * 100))
      : 100;
    barRetFunding.style.width = `${fundingPct.toFixed(1)}%`;
    if (fundingPct >= 100) {
      barRetFunding.className = 'bg-emerald-500 transition-all duration-500';
    } else if (fundingPct >= 70) {
      barRetFunding.className = 'bg-blue-600 transition-all duration-500';
    } else {
      barRetFunding.className = 'bg-amber-500 transition-all duration-500';
    }

    lblChartProjSavings.textContent = `Projected Savings: ${formatINR(projectedSavingsAtRetirement, true)}`;
    lblChartTargetCorpus.textContent = `Target Corpus: ${formatINR(requiredCorpus, true)} (${((projectedSavingsAtRetirement / (requiredCorpus || 1)) * 100).toFixed(1)}% Funded)`;

    // Update Scenario Comparison Table
    tblRetScenarios.innerHTML = scenarioRows.map((sc) => `
      <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 ${sc.name.includes('Current') ? 'bg-blue-50/40 dark:bg-blue-950/20 font-bold' : ''}">
        <td class="p-2.5 font-sans font-bold text-slate-900 dark:text-white">${sc.name}</td>
        <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${sc.preR}% / ${sc.postR}%</td>
        <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${sc.inf}%</td>
        <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-semibold">${formatINR(sc.reqCorpus, true)}</td>
        <td class="p-2.5 text-right text-slate-900 dark:text-white font-semibold">${formatINR(sc.projSavings, true)}</td>
        <td class="p-2.5 text-right font-bold ${sc.gap >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}">
          ${sc.gap >= 0 ? '+' : '-'} ${formatINR(Math.abs(sc.gap), true)}
        </td>
      </tr>
    `).join('');

    // Depletion Warning
    if (depletionAge !== null && depletionAge <= lifeAge) {
      bannerRetDepletion.classList.remove('hidden');
      txtDepletionAge.textContent = `${depletionAge}`;
    } else {
      bannerRetDepletion.classList.add('hidden');
    }

    // Render Table
    renderScheduleTable();

    retResultsSection.classList.remove('hidden');
  }

  // Render Projection Table (Accumulation vs Decumulation)
  function renderScheduleTable() {
    if (!lastCalculatedRetirement) return;

    if (activeProjectionTab === 'accum') {
      retSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Year</th>
          <th class="p-2.5">Age</th>
          <th class="p-2.5 text-right">Opening Balance</th>
          <th class="p-2.5 text-right">Annual Contributions</th>
          <th class="p-2.5 text-right">Investment Growth</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Ending Balance</th>
        </tr>
      `;

      retSchedTbody.innerHTML = lastCalculatedRetirement.accumulationSchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Year ${row.year}</td>
          <td class="p-2.5 text-slate-600 dark:text-slate-400 font-semibold">Age ${row.age}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatINR(row.annualContribution)}</td>
          <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-semibold">${formatINR(row.investmentGrowth)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    } else {
      retSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Year</th>
          <th class="p-2.5">Age</th>
          <th class="p-2.5 text-right">Opening Corpus</th>
          <th class="p-2.5 text-right">Investment Growth</th>
          <th class="p-2.5 text-right">Annual Living Expense</th>
          <th class="p-2.5 text-right">Net Withdrawal</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Closing Corpus</th>
        </tr>
      `;

      retSchedTbody.innerHTML = lastCalculatedRetirement.decumulationSchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 ${row.isDepleted ? 'bg-red-50/50 dark:bg-red-950/20 text-red-700' : ''}">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Year ${row.year}</td>
          <td class="p-2.5 text-slate-600 dark:text-slate-400 font-semibold">Age ${row.age}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingCorpus)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatINR(row.investmentGrowth)}</td>
          <td class="p-2.5 text-right text-red-600 dark:text-red-400 font-semibold">${formatINR(row.annualExpenses)}</td>
          <td class="p-2.5 text-right text-slate-900 dark:text-white font-bold">${formatINR(row.netWithdrawal)}</td>
          <td class="p-2.5 text-right font-black ${row.closingCorpus <= 0 ? 'text-red-600 dark:text-red-400' : 'text-slate-900 dark:text-white'}">
            ${formatINR(row.closingCorpus)}
          </td>
        </tr>
      `).join('');
    }
  }

  // Switch Projection Tabs
  tabRetAccum.addEventListener('click', () => {
    activeProjectionTab = 'accum';
    tabRetAccum.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabRetDecum.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  tabRetDecum.addEventListener('click', () => {
    activeProjectionTab = 'decum';
    tabRetDecum.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabRetAccum.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  // Calculate Button
  btnCalcRet.addEventListener('click', executeRetirementCalculation);

  // Clear All Button
  btnClearRet.addEventListener('click', () => {
    inpRetCurAge.value = '35';
    inpRetRetAge.value = '60';
    inpRetLifeAge.value = '85';
    updateTimelineBadge();

    inpRetExpenses.value = '50000';
    selRetExpBasis.value = 'monthly';
    selRetExpChange.value = '0';
    rowRetCustomExp.classList.add('hidden');
    inpRetCustomExpPct.value = '0';
    inpRetInf.value = '6.0';

    inpRetSavings.value = '1000000';
    inpRetMonthlyInv.value = '20000';
    inpRetStepUp.value = '0';

    inpRetPreReturn.value = '10.0';
    inpRetPostReturn.value = '7.0';

    inpRetOtherIncome.value = '0';
    selRetMethod.value = 'inflation-adjusted';
    colRetSwr.classList.add('hidden');
    inpRetSwr.value = '4.0';

    errRet.classList.add('hidden');
    retResultsSection.classList.add('hidden');
    lastCalculatedRetirement = null;
    activeProjectionTab = 'accum';
    tabRetAccum.click();
  });

  // Preset Buttons Listener
  document.querySelectorAll('.btn-ret-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      inpRetCurAge.value = btn.getAttribute('data-curage') || '35';
      inpRetRetAge.value = btn.getAttribute('data-retage') || '60';
      inpRetLifeAge.value = btn.getAttribute('data-lifeage') || '85';
      updateTimelineBadge();

      inpRetExpenses.value = btn.getAttribute('data-exp') || '50000';
      selRetExpBasis.value = 'monthly';
      inpRetInf.value = btn.getAttribute('data-inf') || '6';

      inpRetSavings.value = btn.getAttribute('data-sav') || '1000000';
      inpRetMonthlyInv.value = btn.getAttribute('data-inv') || '20000';
      inpRetStepUp.value = btn.getAttribute('data-step') || '0';

      inpRetPreReturn.value = btn.getAttribute('data-prer') || '10';
      inpRetPostReturn.value = btn.getAttribute('data-postr') || '7';
    });
  });

  // Enter Key Triggers Calculation
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeRetirementCalculation();
        }
      });
    });
  });

  // Tab-Selective Branded PDF Export
  async function generateRetirementPdf() {
    if (!lastCalculatedRetirement) {
      alert('Please calculate your retirement corpus first.');
      return;
    }

    btnRetDownloadPdf.disabled = true;
    const originalText = txtBtnRetPdf.textContent;
    txtBtnRetPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      const pdfTitle = activeProjectionTab === 'accum'
        ? 'Retirement Savings Growth – Accumulation Projection'
        : 'Retirement Phase – Drawdown & Withdrawal Projection';

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text('Retirement Corpus Calculation', 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 32, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('RETIREMENT PLANNING SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);
      doc.text(`Current Age / Retirement: ${lastCalculatedRetirement.curAge} Yrs / ${lastCalculatedRetirement.retAge} Yrs`, 18, 44);
      doc.text(`Life Expectancy: ${lastCalculatedRetirement.lifeAge} Yrs (${lastCalculatedRetirement.retirementDuration} Yrs span)`, 18, 49);
      doc.text(`Current Expenses: Rs. ${Math.round(lastCalculatedRetirement.curExpensesMonthly).toLocaleString('en-IN')}/mo`, 18, 54);
      doc.text(`Expected Inflation: ${lastCalculatedRetirement.infRate}% p.a.`, 18, 59);

      doc.text(`Future Monthly Cost: Rs. ${Math.round(lastCalculatedRetirement.futureMonthlyExpense).toLocaleString('en-IN')}/mo`, 85, 44);
      doc.text(`Current Savings: Rs. ${Math.round(lastCalculatedRetirement.curSavings).toLocaleString('en-IN')}`, 85, 49);
      doc.text(`Monthly SIP: Rs. ${Math.round(lastCalculatedRetirement.monthlyInv).toLocaleString('en-IN')} (Step-up: ${lastCalculatedRetirement.stepUpPct}%)`, 85, 54);
      doc.text(`Returns (Pre/Post): ${lastCalculatedRetirement.preReturn}% / ${lastCalculatedRetirement.postReturn}%`, 85, 59);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(37, 99, 235);
      doc.text(`Target Corpus: Rs. ${Math.round(lastCalculatedRetirement.requiredCorpus).toLocaleString('en-IN')}`, 145, 44);
      doc.setTextColor(16, 185, 129);
      doc.text(`Projected: Rs. ${Math.round(lastCalculatedRetirement.projectedSavingsAtRetirement).toLocaleString('en-IN')}`, 145, 50);
      
      if (lastCalculatedRetirement.isSurplus) {
        doc.setTextColor(16, 185, 129);
        doc.text(`Surplus: +Rs. ${Math.round(lastCalculatedRetirement.absGap).toLocaleString('en-IN')}`, 145, 56);
      } else {
        doc.setTextColor(220, 38, 38);
        doc.text(`Shortfall: -Rs. ${Math.round(lastCalculatedRetirement.absGap).toLocaleString('en-IN')}`, 145, 56);
      }

      // 4. Tab-Selective Table Data
      let tableHead = [];
      let tableData = [];

      if (activeProjectionTab === 'accum') {
        tableHead = [['Year', 'Age', 'Opening Bal', 'Annual Contrib', 'Growth', 'Ending Balance']];
        tableData = lastCalculatedRetirement.accumulationSchedule.map((r) => [
          `Year ${r.year}`,
          `Age ${r.age}`,
          'Rs. ' + Math.round(r.openingBalance).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.annualContribution).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.investmentGrowth).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.closingBalance).toLocaleString('en-IN')
        ]);
      } else {
        tableHead = [['Year', 'Age', 'Opening Corpus', 'Growth', 'Annual Expense', 'Net Withdrawal', 'Closing Corpus']];
        tableData = lastCalculatedRetirement.decumulationSchedule.map((r) => [
          `Year ${r.year}`,
          `Age ${r.age}`,
          'Rs. ' + Math.round(r.openingCorpus).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.investmentGrowth).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.annualExpenses).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.netWithdrawal).toLocaleString('en-IN'),
          'Rs. ' + Math.round(r.closingCorpus).toLocaleString('en-IN')
        ]);
      }

      doc.autoTable({
        startY: 70,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { cellWidth: 16, halign: 'left', fontStyle: 'bold' },
          1: { cellWidth: 16, halign: 'left' },
          2: { halign: 'right' },
          3: { halign: 'right', fontStyle: 'bold', textColor: [16, 185, 129] },
          4: { halign: 'right', textColor: [37, 99, 235] },
          5: { halign: 'right', fontStyle: 'bold' },
          6: { halign: 'right', fontStyle: 'bold' }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const today = new Date().toISOString().split('T')[0];
      doc.save(`retirement-corpus-calculation-${today}.pdf`);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnRetDownloadPdf.disabled = false;
      txtBtnRetPdf.textContent = originalText;
    }
  }

  btnRetDownloadPdf.addEventListener('click', generateRetirementPdf);
</script>
