---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Retirement Corpus Calculator – Calculate Your Retirement Savings Goal"
  description="Estimate how much money you may need for retirement based on your current expenses, retirement age, inflation, life expectancy, savings, and expected investment returns."
  category="Finance"
  calculatorName="Retirement Corpus Calculator"
  slug="retirement-calculator"
  keywords={[
    'retirement corpus calculator',
    'retirement corpus calculator india',
    'retirement corpus calculator with inflation',
    'retirement corpus calculator excel',
    'best retirement corpus calculator india',
    'calculate retirement savings',
    'estimate your retirement fund',
    'retirement savings goal',
    'future retirement expenses',
    'retirement planning estimate'
  ]}
>
  <div class="space-y-6">

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-ret-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-curage="25" data-retage="60" data-lifeage="85" data-exp="35000" data-inf="6" data-sav="200000" data-inv="10000" data-step="10" data-prer="12" data-postr="7">🌱 Early Starter (Age 25→60, ₹35k Exp, 10% Step-Up)</button>
        <button type="button" class="btn-ret-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-curage="35" data-retage="60" data-lifeage="85" data-exp="50000" data-inf="6" data-sav="1000000" data-inv="20000" data-step="5" data-prer="10" data-postr="7">💼 Mid-Career (Age 35→60, ₹50k Exp, ₹10L Sav)</button>
        <button type="button" class="btn-ret-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-curage="30" data-retage="50" data-lifeage="85" data-exp="60000" data-inf="6.5" data-sav="1500000" data-inv="50000" data-step="10" data-prer="12" data-postr="7.5">🔥 Early FIRE (Age 30→50, ₹60k Exp, High SIP)</button>
        <button type="button" class="btn-ret-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-curage="45" data-retage="65" data-lifeage="85" data-exp="80000" data-inf="5.5" data-sav="3000000" data-inv="40000" data-step="0" data-prer="9.5" data-postr="6.5">⏳ Late Starter (Age 45→65, ₹80k Exp, ₹30L Sav)</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
        <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
          <span>🏖️</span> Retirement Corpus Calculator
        </h2>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
          Estimate your total retirement nest egg requirement, future inflated living expenses, and required monthly investments.
        </p>
      </div>

      <form id="form-ret" class="mt-4 space-y-4" novalidate onsubmit="return false;">
        
        <!-- SECTION 1: PERSONAL DETAILS (AGE SETTINGS) -->
        <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>👤</span> 1. Personal & Age Timeline
            </span>
            <span id="badge-ret-timeline" class="text-[11px] font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 px-2 py-0.5 rounded-md border border-blue-200 dark:border-blue-900/50">
              25 Years to Retire | 25 Years in Retirement
            </span>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="inp-ret-cur-age" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Current Age (Years)</label>
              <input type="number" id="inp-ret-cur-age" value="35" min="18" max="80" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="35" />
            </div>
            <div>
              <label for="inp-ret-ret-age" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Target Retirement Age (Years)</label>
              <input type="number" id="inp-ret-ret-age" value="60" min="25" max="90" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="60" />
            </div>
            <div>
              <label for="inp-ret-life-age" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Life Expectancy (Years)</label>
              <input type="number" id="inp-ret-life-age" value="85" min="50" max="110" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="85" />
            </div>
          </div>
        </div>

        <!-- SECTION 2: CURRENT EXPENSES & INFLATION -->
        <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>💰</span> 2. Current Living Expenses & Inflation
          </span>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <!-- Expense Amount & Unit -->
            <div>
              <label for="inp-ret-expenses" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Current Living Expenses (₹)</label>
              <div class="mt-1 flex rounded-xl border border-slate-300 bg-white dark:border-slate-700 dark:bg-slate-800">
                <input type="number" id="inp-ret-expenses" value="50000" step="5000" min="0" class="w-full rounded-l-xl border-0 p-2.5 text-sm font-bold text-slate-900 focus:ring-0 dark:bg-slate-800 dark:text-white" placeholder="50,000" />
                <select id="sel-ret-exp-basis" class="rounded-r-xl border-l border-slate-300 bg-slate-50 px-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 cursor-pointer">
                  <option value="monthly" selected>Monthly</option>
                  <option value="annual">Annual</option>
                </select>
              </div>
            </div>

            <!-- Expected Change in Expenses in Retirement -->
            <div>
              <label for="sel-ret-exp-change" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Retirement Expense Shift</label>
              <select id="sel-ret-exp-change" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">
                <option value="0" selected>Same as current expenses (100%)</option>
                <option value="-10">10% Lower expenses (90%)</option>
                <option value="-20">20% Lower expenses (80%)</option>
                <option value="10">10% Higher expenses (110%)</option>
                <option value="20">20% Higher expenses (120%)</option>
                <option value="custom">Custom Percentage...</option>
              </select>
            </div>

            <!-- Expected Inflation Rate -->
            <div>
              <label for="inp-ret-inf" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Expected Annual Inflation (% p.a.)</label>
              <input type="number" id="inp-ret-inf" value="6.0" step="0.25" min="0" max="25" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="6.0" />
            </div>
          </div>

          <!-- Custom Expense Change Input (Hidden unless Custom is picked) -->
          <div id="row-ret-custom-exp" class="hidden pt-1">
            <label for="inp-ret-custom-exp-pct" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Custom Expense Adjustment (% from current)</label>
            <input type="number" id="inp-ret-custom-exp-pct" value="0" step="5" min="-80" max="200" class="mt-1 w-48 rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. -15 for 15% reduction" />
          </div>
        </div>

        <!-- SECTION 3: SAVINGS, MONTHLY INVESTMENTS & STEP-UP -->
        <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>📈</span> 3. Current Savings & Planned Monthly Investments
          </span>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="inp-ret-savings" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Current Retirement Savings (₹)</label>
              <input type="number" id="inp-ret-savings" value="1000000" step="50000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10,00,000" />
            </div>

            <div>
              <label for="inp-ret-monthly-inv" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Planned Monthly Investment (₹)</label>
              <input type="number" id="inp-ret-monthly-inv" value="20000" step="1000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="20,000" />
            </div>

            <div>
              <label for="inp-ret-step-up" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Annual Investment Step-Up (% p.a.)</label>
              <input type="number" id="inp-ret-step-up" value="0" step="1" min="0" max="50" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>
          </div>
        </div>

        <!-- SECTION 4: EXPECTED INVESTMENT RETURNS -->
        <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>📊</span> 4. Expected Investment Return Assumptions
          </span>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label for="inp-ret-pre-return" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Pre-Retirement Return (% p.a. - Accumulation)</label>
              <input type="number" id="inp-ret-pre-return" value="10.0" step="0.5" min="0" max="30" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10.0" />
            </div>

            <div>
              <label for="inp-ret-post-return" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">Post-Retirement Return (% p.a. - Distribution)</label>
              <input type="number" id="inp-ret-post-return" value="7.0" step="0.5" min="0" max="30" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="7.0" />
            </div>
          </div>
        </div>

        <!-- SECTION 5: OTHER RETIREMENT INCOME & CALCULATION METHOD (ACCORDION) -->
        <details class="group rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            <span class="flex items-center gap-1.5">
              <span>🏛️</span> Optional Other Retirement Income & Calculation Method
            </span>
            <span class="text-blue-600 dark:text-blue-400 font-semibold text-[11px] group-open:rotate-180 transition-transform">▼ Expand</span>
          </summary>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
            <div>
              <label for="inp-ret-other-income" class="block font-bold text-slate-700 dark:text-slate-300">Expected Monthly Pension / Rent (₹)</label>
              <input type="number" id="inp-ret-other-income" value="0" step="2000" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
            </div>

            <div>
              <label for="sel-ret-method" class="block font-bold text-slate-700 dark:text-slate-300">Retirement Calculation Method</label>
              <select id="sel-ret-method" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer">
                <option value="inflation-adjusted" selected>Inflation-Adjusted Growing Annuity (Standard)</option>
                <option value="withdrawal-rate">Corpus Multiple / Safe Withdrawal Rate (e.g. 4%)</option>
              </select>
            </div>

            <div id="col-ret-swr" class="hidden">
              <label for="inp-ret-swr" class="block font-bold text-slate-700 dark:text-slate-300">Safe Withdrawal Rate (% p.a.)</label>
              <input type="number" id="inp-ret-swr" value="4.0" step="0.25" min="1" max="15" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="4.0" />
            </div>
          </div>
        </details>

        <!-- ACTION BUTTONS -->
        <div class="flex items-center gap-2 pt-2">
          <button type="submit" id="btn-calc-ret" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
            Calculate Retirement Corpus →
          </button>
          <button type="button" id="btn-clear-ret" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
            Clear All (✕)
          </button>
        </div>

        <!-- ACCESSIBLE ERROR -->
        <p id="err-ret" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

      </form>

      <!-- RESULTS PRESENTATION SECTION (Hidden initially) -->
      <div id="ret-results-section" class="hidden mt-6 space-y-6">
        
        <!-- 1. MAIN RESULT HERO CARD -->
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">ESTIMATED RETIREMENT CORPUS REQUIRED</span>
              <div id="res-ret-corpus-hero" class="mt-1 text-3xl sm:text-4xl lg:text-5xl font-black text-blue-600 dark:text-blue-400">₹ 3.52 Crore</div>
              <div id="res-ret-corpus-exact" class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">₹ 3,52,48,120</div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Future Monthly Expenses at 60:</span>
              <div id="res-ret-future-mo-hero" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">₹ 2,14,593 / mo</div>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Years Until Retirement</div>
              <div id="res-ret-years-left" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">25 Years</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Retirement Duration</div>
              <div id="res-ret-duration" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">25 Years</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Projected Savings at Retirement</div>
              <div id="res-ret-proj-savings" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">₹ 3.82 Crore</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div id="lbl-ret-gap-title" class="text-slate-500 dark:text-slate-400 font-semibold">Estimated Surplus</div>
              <div id="res-ret-gap-amount" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">+ ₹ 30.1 Lakh</div>
            </div>
          </div>
        </div>

        <!-- 2. RETIREMENT PLANNING SUMMARY -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-3">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>📋</span> Retirement Planning Summary
          </h3>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Current Age</span>
              <span id="sum-cur-age" class="font-bold text-slate-900 dark:text-white">35 Years</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Retirement Age</span>
              <span id="sum-ret-age" class="font-bold text-slate-900 dark:text-white">60 Years</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Life Expectancy</span>
              <span id="sum-life-age" class="font-bold text-slate-900 dark:text-white">85 Years</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Current Expenses</span>
              <span id="sum-cur-exp" class="font-bold text-slate-900 dark:text-white">₹ 50,000 / mo</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Expected Inflation</span>
              <span id="sum-inf-rate" class="font-bold text-slate-900 dark:text-white">6.0% p.a.</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Current Savings</span>
              <span id="sum-cur-sav" class="font-bold text-slate-900 dark:text-white">₹ 10,00,000</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Monthly Investment</span>
              <span id="sum-monthly-inv" class="font-bold text-slate-900 dark:text-white">₹ 20,000 / mo</span>
            </div>
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-2.5 dark:border-slate-800 dark:bg-slate-800/50">
              <span class="text-slate-500 dark:text-slate-400 block">Pre / Post Return</span>
              <span id="sum-returns" class="font-bold text-slate-900 dark:text-white">10% / 7%</span>
            </div>
          </div>
        </div>

        <!-- 3. FUTURE EXPENSES & SHORTFALL / SURPLUS CARD -->
        <div id="card-ret-gap-analysis" class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 shadow-sm space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-200 pb-3 dark:border-slate-800">
            <h3 class="text-sm font-black text-slate-900 dark:text-white flex items-center gap-1.5" id="hdr-gap-status">
