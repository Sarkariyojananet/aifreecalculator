<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // State
  let lastCalculatedPersonalLoan = null;
  let activeScheduleView = 'yearly'; // 'yearly' | 'monthly'

  // DOM Elements
  const inpLnAmt = document.getElementById('inp-ln-amt');
  const inpLnRate = document.getElementById('inp-ln-rate');
  const inpLnTerm = document.getElementById('inp-ln-term');
  const selLnTermUnit = document.getElementById('sel-ln-term-unit');
  const inpLnStartDate = document.getElementById('inp-ln-start-date');

  const inpLnExtraMo = document.getElementById('inp-ln-extra-mo');
  const inpLnExtraYr = document.getElementById('inp-ln-extra-yr');
  const inpLnExtraOnce = document.getElementById('inp-ln-extra-once');

  const btnCalcLn = document.getElementById('btn-calc-ln');
  const btnClearLn = document.getElementById('btn-clear-ln');
  const errLn = document.getElementById('err-ln');

  // Results Elements
  const lnResultsSection = document.getElementById('ln-results-section');
  const resLnMonthlyEmi = document.getElementById('res-ln-monthly-emi');
  const resLnTotalInt = document.getElementById('res-ln-total-int');
  const resLnPrincipal = document.getElementById('res-ln-principal');
  const resLnRateVal = document.getElementById('res-ln-rate-val');
  const resLnTotalPayable = document.getElementById('res-ln-total-payable');
  const resLnPayoffDate = document.getElementById('res-ln-payoff-date');

  const barLnPrincipal = document.getElementById('bar-ln-principal');
  const barLnInterest = document.getElementById('bar-ln-interest');
  const lblChartPrincipal = document.getElementById('lbl-chart-principal');
  const lblChartInterest = document.getElementById('lbl-chart-interest');

  const cardLnExtraComparison = document.getElementById('card-ln-extra-comparison');
  const resLnIntSaved = document.getElementById('res-ln-int-saved');
  const resLnTimeSaved = document.getElementById('res-ln-time-saved');
  const resLnNewDuration = document.getElementById('res-ln-new-duration');
  const resLnNewInt = document.getElementById('res-ln-new-int');

  const tabLnYearly = document.getElementById('tab-ln-yearly');
  const tabLnMonthly = document.getElementById('tab-ln-monthly');
  const btnLnDownloadPdf = document.getElementById('btn-ln-download-pdf');
  const txtBtnLnPdf = document.getElementById('txt-btn-ln-pdf');

  const lnSchedThead = document.getElementById('ln-sched-thead');
  const lnSchedTbody = document.getElementById('ln-sched-tbody');

  // Set default start date to current month
  const todayDate = new Date();
  const currentMonthStr = `${todayDate.getFullYear()}-${String(todayDate.getMonth() + 1).padStart(2, '0')}`;
  inpLnStartDate.value = currentMonthStr;

  // Currency Formatter
  function formatINR(val) {
    return `₹ ${Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  // Quick Term Buttons
  document.querySelectorAll('.btn-ln-quick-term').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-ln-quick-term').forEach((b) => {
        b.className = 'btn-ln-quick-term rounded-md border border-slate-300 bg-white px-2.5 py-0.5 font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer';
      });
      btn.className = 'btn-ln-quick-term active rounded-md bg-blue-600 px-2.5 py-0.5 font-bold text-white shadow-2xs cursor-pointer';
      inpLnTerm.value = btn.getAttribute('data-years');
      selLnTermUnit.value = 'years';
    });
  });

  // Calculate Personal Loan Logic
  function executePersonalLoanCalculation() {
    errLn.classList.add('hidden');

    const loanAmount = parseFloat(inpLnAmt.value) || 0;
    const rateAnnual = parseFloat(inpLnRate.value) || 0;
    const termVal = parseFloat(inpLnTerm.value) || 0;
    const termUnit = selLnTermUnit.value; // 'years' | 'months'

    const extraMo = parseFloat(inpLnExtraMo.value) || 0;
    const extraYr = parseFloat(inpLnExtraYr.value) || 0;
    const extraOnce = parseFloat(inpLnExtraOnce.value) || 0;

    if (loanAmount <= 0) {
      errLn.textContent = 'Please enter a valid loan amount greater than 0.';
      errLn.classList.remove('hidden');
      lnResultsSection.classList.add('hidden');
      return;
    }

    if (rateAnnual < 0) {
      errLn.textContent = 'Interest rate cannot be negative.';
      errLn.classList.remove('hidden');
      lnResultsSection.classList.add('hidden');
      return;
    }

    if (termVal <= 0) {
      errLn.textContent = 'Loan term must be greater than 0.';
      errLn.classList.remove('hidden');
      lnResultsSection.classList.add('hidden');
      return;
    }

    const totalMonths = termUnit === 'years' ? Math.round(termVal * 12) : Math.round(termVal);
    const r = rateAnnual / 12 / 100;

    // Monthly EMI
    let monthlyPayment = 0;
    if (r === 0) {
      monthlyPayment = loanAmount / totalMonths;
    } else {
      const factor = Math.pow(1 + r, totalMonths);
      monthlyPayment = (loanAmount * r * factor) / (factor - 1);
    }

    // Original baseline total interest without extra payments
    const originalTotalInterest = r > 0 ? (monthlyPayment * totalMonths - loanAmount) : 0;

    // Start Date Parsing
    let startYear = todayDate.getFullYear();
    let startMonth = todayDate.getMonth();
    if (inpLnStartDate.value) {
      const parts = inpLnStartDate.value.split('-');
      if (parts.length === 2) {
        startYear = parseInt(parts[0]) || startYear;
        startMonth = (parseInt(parts[1]) - 1) || startMonth;
      }
    }

    // Amortization Simulation
    const yearlySchedule = [];
    const monthlySchedule = [];

    let balance = loanAmount;
    let totalInterestPaid = 0;
    let totalPrincipalPaid = 0;
    let totalExtraPaid = 0;

    let currentYear = 1;
    let yearOpeningBalance = balance;
    let yearPrincipal = 0;
    let yearInterest = 0;
    let yearExtra = 0;
    let yearTotalPaid = 0;

    let month = 1;
    const maxSafety = totalMonths * 2;

    while (balance > 0.001 && month <= maxSafety) {
      const monthOpening = balance;
      const monthInterest = r > 0 ? balance * r : 0;

      let regularPrincipal = Math.min(balance, monthlyPayment - monthInterest);
      if (regularPrincipal < 0) regularPrincipal = 0;

      let schedPayment = regularPrincipal + monthInterest;

      let extraThisMonth = extraMo;
      if (extraYr > 0 && month % 12 === 1) extraThisMonth += extraYr;
      if (extraOnce > 0 && month === 1) extraThisMonth += extraOnce;

      const remAfterRegular = Math.max(0, balance - regularPrincipal);
      extraThisMonth = Math.min(remAfterRegular, extraThisMonth);

      const totalPrincipalThisMonth = regularPrincipal + extraThisMonth;
      const totalPaymentThisMonth = schedPayment + extraThisMonth;

      balance = Math.max(0, balance - totalPrincipalThisMonth);

      totalInterestPaid += monthInterest;
      totalPrincipalPaid += regularPrincipal;
      totalExtraPaid += extraThisMonth;

      yearPrincipal += regularPrincipal;
      yearInterest += monthInterest;
      yearExtra += extraThisMonth;
      yearTotalPaid += totalPaymentThisMonth;

      const paymentDate = new Date(startYear, startMonth + month, 1);
      const dateStr = paymentDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

      monthlySchedule.push({
        paymentNumber: month,
        paymentDateStr: dateStr,
        openingBalance: monthOpening,
        scheduledPayment: schedPayment,
        principalPaid: regularPrincipal,
        interestPaid: monthInterest,
        extraPayment: extraThisMonth,
        totalPayment: totalPaymentThisMonth,
        closingBalance: balance,
      });

      if (month % 12 === 0 || balance <= 0.001) {
        yearlySchedule.push({
          year: currentYear,
          openingBalance: yearOpeningBalance,
          principalPaid: yearPrincipal,
          interestPaid: yearInterest,
          extraPaid: yearExtra,
          totalPaid: yearTotalPaid,
          closingBalance: balance,
        });

        currentYear++;
        yearOpeningBalance = balance;
        yearPrincipal = 0;
        yearInterest = 0;
        yearExtra = 0;
        yearTotalPaid = 0;
      }

      if (balance <= 0.001) break;
      month++;
    }

    const actualPaymentsCount = monthlySchedule.length;
    const interestSaved = Math.max(0, originalTotalInterest - totalInterestPaid);
    const monthsSaved = Math.max(0, totalMonths - actualPaymentsCount);
    const yearsSaved = Math.floor(monthsSaved / 12);
    const remMonthsSaved = monthsSaved % 12;

    const payoffDate = new Date(startYear, startMonth + actualPaymentsCount, 1);
    const payoffMonthStr = payoffDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

    // Save calculation state
    lastCalculatedPersonalLoan = {
      loanAmount,
      rateAnnual,
      termVal,
      termUnit,
      totalMonths,
      monthlyPayment,
      totalInterestPaid,
      totalPrincipalPaid: totalPrincipalPaid + totalExtraPaid,
      totalAmountPayable: loanAmount + totalInterestPaid,
      payoffDateStr: payoffMonthStr,
      hasExtraPayments: (extraMo > 0 || extraYr > 0 || extraOnce > 0),
      interestSaved,
      monthsSaved,
      timeSavedStr: `${yearsSaved} Yrs ${remMonthsSaved} Mos`,
      actualPaymentsCount,
      yearlySchedule,
      monthlySchedule,
    };

    // Update Result Card
    resLnMonthlyEmi.textContent = formatINR(monthlyPayment);
    resLnTotalInt.textContent = formatINR(totalInterestPaid);
    resLnPrincipal.textContent = formatINR(loanAmount);
    resLnRateVal.textContent = `${rateAnnual}% per year`;
    resLnTotalPayable.textContent = formatINR(lastCalculatedPersonalLoan.totalAmountPayable);
    resLnPayoffDate.textContent = payoffMonthStr;

    // Update Chart
    const totalPie = lastCalculatedPersonalLoan.totalAmountPayable > 0 ? lastCalculatedPersonalLoan.totalAmountPayable : 1;
    const principalPct = ((loanAmount / totalPie) * 100).toFixed(1);
    const interestPct = ((totalInterestPaid / totalPie) * 100).toFixed(1);

    barLnPrincipal.style.width = `${principalPct}%`;
    barLnInterest.style.width = `${interestPct}%`;

    lblChartPrincipal.textContent = `Principal: ${formatINR(loanAmount)} (${principalPct}%)`;
    lblChartInterest.textContent = `Total Interest: ${formatINR(totalInterestPaid)} (${interestPct}%)`;

    // Extra Payments Drawer
    if (lastCalculatedPersonalLoan.hasExtraPayments && monthsSaved > 0) {
      cardLnExtraComparison.classList.remove('hidden');
      resLnIntSaved.textContent = formatINR(interestSaved);
      resLnTimeSaved.textContent = lastCalculatedPersonalLoan.timeSavedStr;
      resLnNewDuration.textContent = `${(actualPaymentsCount / 12).toFixed(1)} Years (${actualPaymentsCount} Mos)`;
      resLnNewInt.textContent = formatINR(totalInterestPaid);
    } else {
      cardLnExtraComparison.classList.add('hidden');
    }

    // Render Table
    renderScheduleTable();

    lnResultsSection.classList.remove('hidden');
  }

  // Render Active Schedule Table
  function renderScheduleTable() {
    if (!lastCalculatedPersonalLoan) return;

    if (activeScheduleView === 'yearly') {
      lnSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Year</th>
          <th class="p-2.5 text-right">Opening Balance</th>
          <th class="p-2.5 text-right">Principal Paid</th>
          <th class="p-2.5 text-right">Interest Paid</th>
          <th class="p-2.5 text-right">Extra Paid</th>
          <th class="p-2.5 text-right">Total Payments</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Closing Balance</th>
        </tr>
      `;

      lnSchedTbody.innerHTML = lastCalculatedPersonalLoan.yearlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Year ${row.year}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-semibold">${formatINR(row.principalPaid)}</td>
          <td class="p-2.5 text-right text-red-600 dark:text-red-400 font-semibold">${formatINR(row.interestPaid)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatINR(row.extraPaid)}</td>
          <td class="p-2.5 text-right text-slate-900 dark:text-white font-bold">${formatINR(row.totalPaid)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    } else {
      lnSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">#</th>
          <th class="p-2.5">Date</th>
          <th class="p-2.5 text-right">Opening Bal</th>
          <th class="p-2.5 text-right">Scheduled EMI</th>
          <th class="p-2.5 text-right">Principal</th>
          <th class="p-2.5 text-right">Interest</th>
          <th class="p-2.5 text-right">Extra Paid</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Closing Balance</th>
        </tr>
      `;

      lnSchedTbody.innerHTML = lastCalculatedPersonalLoan.monthlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">${row.paymentNumber}</td>
          <td class="p-2.5 text-slate-600 dark:text-slate-400 font-semibold">${row.paymentDateStr}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right text-slate-900 dark:text-white font-semibold">${formatINR(row.scheduledPayment)}</td>
          <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-semibold">${formatINR(row.principalPaid)}</td>
          <td class="p-2.5 text-right text-red-600 dark:text-red-400 font-semibold">${formatINR(row.interestPaid)}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">${formatINR(row.extraPayment)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    }
  }

  // Switch Schedule Tabs
  tabLnYearly.addEventListener('click', () => {
    activeScheduleView = 'yearly';
    tabLnYearly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabLnMonthly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  tabLnMonthly.addEventListener('click', () => {
    activeScheduleView = 'monthly';
    tabLnMonthly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabLnYearly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  btnCalcLn.addEventListener('click', executePersonalLoanCalculation);

  btnClearLn.addEventListener('click', () => {
    inpLnAmt.value = '500000';
    inpLnRate.value = '12';
    inpLnTerm.value = '5';
    selLnTermUnit.value = 'years';
    inpLnStartDate.value = currentMonthStr;
    inpLnExtraMo.value = '0';
    inpLnExtraYr.value = '0';
    inpLnExtraOnce.value = '0';
    errLn.classList.add('hidden');
    lnResultsSection.classList.add('hidden');
    lastCalculatedPersonalLoan = null;
    activeScheduleView = 'yearly';
    tabLnYearly.click();
  });

  // Preset Buttons Listener
  document.querySelectorAll('.btn-ln-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const amt = btn.getAttribute('data-amt');
      const rate = btn.getAttribute('data-rate');
      const term = btn.getAttribute('data-term');
      const extra = btn.getAttribute('data-extra');

      if (amt) inpLnAmt.value = amt;
      if (rate) inpLnRate.value = rate;
      if (term) inpLnTerm.value = term;
      if (extra) inpLnExtraMo.value = extra;
    });
  });

  // Enter Key Listener
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executePersonalLoanCalculation();
        }
      });
    });
  });

  // Tab-Selective PDF Download
  async function generateLnPdf() {
    if (!lastCalculatedPersonalLoan) {
      alert('Please calculate your loan first.');
      return;
    }

    btnLnDownloadPdf.disabled = true;
    const originalText = txtBtnLnPdf.textContent;
    txtBtnLnPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      const pdfTitle = activeScheduleView === 'yearly'
        ? 'Personal Loan Amortization – Yearly Summary'
        : 'Personal Loan Amortization – Monthly Schedule';

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(pdfTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 28, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('PERSONAL LOAN SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);
      doc.text(`Loan Principal: Rs. ${lastCalculatedPersonalLoan.loanAmount.toLocaleString('en-IN')}`, 18, 44);
      doc.text(`Interest Rate: ${lastCalculatedPersonalLoan.rateAnnual}% p.a.`, 18, 49);
      doc.text(`Tenure: ${lastCalculatedPersonalLoan.termVal} ${lastCalculatedPersonalLoan.termUnit}`, 18, 54);
      doc.text(`Payoff Date: ${lastCalculatedPersonalLoan.payoffDateStr}`, 18, 59);

      doc.text(`Monthly EMI: Rs. ${lastCalculatedPersonalLoan.monthlyPayment.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 85, 44);
      doc.text(`Total Payments: ${lastCalculatedPersonalLoan.actualPaymentsCount} Months`, 85, 49);
      doc.text(`View Mode: ${activeScheduleView === 'yearly' ? 'Yearly Summary' : 'Monthly Schedule'}`, 85, 54);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(220, 38, 38);
      doc.text(`Total Interest: Rs. ${lastCalculatedPersonalLoan.totalInterestPaid.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 140, 46);
      doc.setTextColor(37, 99, 235);
      doc.text(`Total Repayment: Rs. ${lastCalculatedPersonalLoan.totalAmountPayable.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 140, 52);

      // 4. Tab-Selective Table Data Generation
      let tableHead = [];
      let tableData = [];

      if (activeScheduleView === 'yearly') {
        tableHead = [['Year', 'Opening Bal', 'Principal Paid', 'Interest Paid', 'Extra Paid', 'Total Payments', 'Closing Balance']];
        tableData = lastCalculatedPersonalLoan.yearlySchedule.map((r) => [
          `Year ${r.year}`,
          'Rs. ' + r.openingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.principalPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.interestPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.extraPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.totalPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.closingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        ]);
      } else {
        tableHead = [['#', 'Date', 'Opening Bal', 'Scheduled EMI', 'Principal', 'Interest', 'Extra Paid', 'Closing Balance']];
        tableData = lastCalculatedPersonalLoan.monthlySchedule.map((r) => [
          `${r.paymentNumber}`,
          r.paymentDateStr,
          'Rs. ' + r.openingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.scheduledPayment.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.principalPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.interestPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.extraPayment.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.closingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        ]);
      }

      doc.autoTable({
        startY: 65,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { cellWidth: 16, halign: 'left', fontStyle: 'bold' },
          1: { cellWidth: 20, halign: 'left' },
          2: { halign: 'right' },
          3: { halign: 'right' },
          4: { halign: 'right', fontStyle: 'bold', textColor: [37, 99, 235] },
          5: { halign: 'right', textColor: [220, 38, 38] },
          6: { halign: 'right', textColor: [16, 185, 129] },
          7: { halign: 'right', fontStyle: 'bold' }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const today = new Date().toISOString().split('T')[0];
      const filename = activeScheduleView === 'yearly'
        ? `personal-loan-yearly-summary-${today}.pdf`
        : `personal-loan-monthly-schedule-${today}.pdf`;

      doc.save(filename);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnLnDownloadPdf.disabled = false;
      txtBtnLnPdf.textContent = originalText;
    }
  }

  btnLnDownloadPdf.addEventListener('click', generateLnPdf);
</script>
