<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // State
  let currentSalaryType = 'ctc'; // 'ctc' | 'gross' | 'monthly'
  let activeBreakdownView = 'monthly'; // 'monthly' | 'annual'
  let lastCalculatedSalary = null;

  // DOM Elements
  const typeButtons = document.querySelectorAll('.btn-sal-type');
  const salPanelTitle = document.getElementById('sal-panel-title');
  const lblSalAmount = document.getElementById('lbl-sal-amount');
  const inpSalAmount = document.getElementById('inp-sal-amount');
  const colSalBonus = document.getElementById('col-sal-bonus');
  const inpSalBonus = document.getElementById('inp-sal-bonus');
  const selSalRegime = document.getElementById('sel-sal-regime');

  const inpSalBasicPct = document.getElementById('inp-sal-basic-pct');
  const inpSalHraPct = document.getElementById('inp-sal-hra-pct');
  const inpSalPt = document.getElementById('inp-sal-pt');
  const inpSalOtherDeduct = document.getElementById('inp-sal-other-deduct');

  const btnCalcSal = document.getElementById('btn-calc-sal');
  const btnClearSal = document.getElementById('btn-clear-sal');
  const errSal = document.getElementById('err-sal');

  // Results Elements
  const salResultsSection = document.getElementById('sal-results-section');
  const resSalMonthlyInhand = document.getElementById('res-sal-monthly-inhand');
  const resSalAnnualInhand = document.getElementById('res-sal-annual-inhand');
  const resSalCtc = document.getElementById('res-sal-ctc');
  const resSalGrossMonthly = document.getElementById('res-sal-gross-monthly');
  const resSalTotalDeduct = document.getElementById('res-sal-total-deduct');
  const resSalTdsMonthly = document.getElementById('res-sal-tds-monthly');

  const barSalTakehome = document.getElementById('bar-sal-takehome');
  const barSalPf = document.getElementById('bar-sal-pf');
  const barSalTax = document.getElementById('bar-sal-tax');
  const lblChartTakehome = document.getElementById('lbl-chart-takehome');
  const lblChartPf = document.getElementById('lbl-chart-pf');
  const lblChartTax = document.getElementById('lbl-chart-tax');

  const cardSalComparison = document.getElementById('card-sal-comparison');
  const txtSalComparisonRec = document.getElementById('txt-sal-comparison-rec');
  const salCmpTbody = document.getElementById('sal-cmp-tbody');

  const tabSalMonthly = document.getElementById('tab-sal-monthly');
  const tabSalAnnual = document.getElementById('tab-sal-annual');
  const thSalAmount = document.getElementById('th-sal-amount');
  const salBreakdownTbody = document.getElementById('sal-breakdown-tbody');
  const btnSalDownloadPdf = document.getElementById('btn-sal-download-pdf');
  const txtBtnSalPdf = document.getElementById('txt-btn-sal-pdf');

  // Currency Formatter
  function formatINR(val) {
    return `₹ ${Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  // Switch Salary Type Mode
  function switchSalaryType(type) {
    currentSalaryType = type;
    typeButtons.forEach((btn) => {
      if (btn.getAttribute('data-type') === type) {
        btn.className = 'btn-sal-type active shrink-0 rounded-lg bg-blue-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-sal-type shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    if (type === 'ctc') {
      salPanelTitle.innerHTML = '<span>💼</span> CTC to In-Hand Salary Calculator';
      lblSalAmount.textContent = 'Annual CTC (₹)';
      colSalBonus.classList.remove('hidden');
    } else if (type === 'gross') {
      salPanelTitle.innerHTML = '<span>💰</span> Annual Gross Salary Calculator';
      lblSalAmount.textContent = 'Annual Gross Salary (₹)';
      colSalBonus.classList.remove('hidden');
    } else {
      salPanelTitle.innerHTML = '<span>🗓️</span> Monthly Gross Salary Calculator';
      lblSalAmount.textContent = 'Monthly Gross Salary (₹)';
      colSalBonus.classList.add('hidden');
    }
  }

  typeButtons.forEach((btn) => {
    btn.addEventListener('click', () => switchSalaryType(btn.getAttribute('data-type')));
  });

  // Tax Engine Helper
  function computeTax(gross, regime) {
    if (gross <= 0) return 0;
    if (regime === 'new') {
      const taxable = Math.max(0, gross - 75000);
      if (taxable <= 700000) return 0;
      let tax = 0;
      if (taxable > 1500000) tax = 140000 + (taxable - 1500000) * 0.30;
      else if (taxable > 1200000) tax = 80000 + (taxable - 1200000) * 0.20;
      else if (taxable > 1000000) tax = 50000 + (taxable - 1000000) * 0.15;
      else if (taxable > 700000) tax = 20000 + (taxable - 700000) * 0.10;
      else if (taxable > 300000) tax = (taxable - 300000) * 0.05;
      return Math.round(tax * 1.04);
    } else {
      const taxable = Math.max(0, gross - 50000 - 150000); // assume std ded + 80C
      if (taxable <= 500000) return 0;
      let tax = 0;
      if (taxable > 1000000) tax = 112500 + (taxable - 1000000) * 0.30;
      else if (taxable > 500000) tax = 12500 + (taxable - 500000) * 0.20;
      else if (taxable > 250000) tax = (taxable - 250000) * 0.05;
      return Math.round(tax * 1.04);
    }
  }

  // Calculate Salary Logic
  function executeSalaryCalculation() {
    errSal.classList.add('hidden');

    const rawAmount = parseFloat(inpSalAmount.value);
    if (isNaN(rawAmount) || rawAmount <= 0) {
      errSal.textContent = 'Please enter a valid salary amount greater than 0.';
      errSal.classList.remove('hidden');
      salResultsSection.classList.add('hidden');
      return;
    }

    const bonusAnnual = currentSalaryType === 'monthly' ? 0 : (parseFloat(inpSalBonus.value) || 0);
    const basicPct = Math.max(10, Math.min(80, parseFloat(inpSalBasicPct.value) || 45));
    const hraPct = Math.max(0, Math.min(50, parseFloat(inpSalHraPct.value) || 20));
    const ptMonthly = parseFloat(inpSalPt.value) || 0;
    const otherMonthly = parseFloat(inpSalOtherDeduct.value) || 0;
    const regime = selSalRegime.value; // 'new' | 'old' | 'compare'

    let annualCtc = 0;
    let annualGross = 0;
    let monthlyGross = 0;

    if (currentSalaryType === 'ctc') {
      annualCtc = rawAmount;
      const fixedCtc = Math.max(0, annualCtc - bonusAnnual);
      const estBasic = (fixedCtc * basicPct) / 100;
      const estEmployerPf = (estBasic * 0.12);
      annualGross = Math.max(0, fixedCtc - estEmployerPf);
      monthlyGross = Math.round(annualGross / 12);
    } else if (currentSalaryType === 'gross') {
      annualGross = rawAmount;
      monthlyGross = Math.round(annualGross / 12);
      const estBasic = (annualGross * basicPct) / 100;
      const estEmployerPf = (estBasic * 0.12);
      annualCtc = annualGross + estEmployerPf + bonusAnnual;
    } else {
      monthlyGross = rawAmount;
      annualGross = monthlyGross * 12;
      const estBasic = (annualGross * basicPct) / 100;
      const estEmployerPf = (estBasic * 0.12);
      annualCtc = annualGross + estEmployerPf + bonusAnnual;
    }

    const monthlyBasic = Math.round((monthlyGross * basicPct) / 100);
    const annualBasic = monthlyBasic * 12;

    const monthlyHra = Math.round((monthlyGross * hraPct) / 100);
    const annualHra = monthlyHra * 12;

    const monthlySpecial = Math.max(0, monthlyGross - monthlyBasic - monthlyHra);
    const annualSpecial = monthlySpecial * 12;

    const monthlyEmployeePf = Math.round(monthlyBasic * 0.12);
    const annualEmployeePf = monthlyEmployeePf * 12;

    const annualPt = ptMonthly * 12;
    const annualOther = otherMonthly * 12;

    // Compute Tax under New & Old
    const newTaxAnnual = computeTax(annualGross + bonusAnnual, 'new');
    const newMonthlyTds = Math.round(newTaxAnnual / 12);
    const newTotalMonthlyDeduct = monthlyEmployeePf + ptMonthly + newMonthlyTds + otherMonthly;
    const newInHandMonthly = Math.max(0, monthlyGross - newTotalMonthlyDeduct);
    const newInHandAnnual = newInHandMonthly * 12 + bonusAnnual;

    const oldTaxAnnual = computeTax(annualGross + bonusAnnual, 'old');
    const oldMonthlyTds = Math.round(oldTaxAnnual / 12);
    const oldTotalMonthlyDeduct = monthlyEmployeePf + ptMonthly + oldMonthlyTds + otherMonthly;
    const oldInHandMonthly = Math.max(0, monthlyGross - oldTotalMonthlyDeduct);
    const oldInHandAnnual = oldInHandMonthly * 12 + bonusAnnual;

    // Active Regime Result
    const activeRegime = regime === 'old' ? 'old' : 'new';
    const activeMonthlyTds = activeRegime === 'new' ? newMonthlyTds : oldMonthlyTds;
    const activeAnnualTds = activeRegime === 'new' ? newTaxAnnual : oldTaxAnnual;
    const activeTotalMonthlyDeduct = activeRegime === 'new' ? newTotalMonthlyDeduct : oldTotalMonthlyDeduct;
    const activeTotalAnnualDeduct = activeTotalMonthlyDeduct * 12;
    const activeInHandMonthly = activeRegime === 'new' ? newInHandMonthly : oldInHandMonthly;
    const activeInHandAnnual = activeRegime === 'new' ? newInHandAnnual : oldInHandAnnual;

    // Save calculation state
    lastCalculatedSalary = {
      salaryType: currentSalaryType,
      regime,
      annualCtc,
      annualGross,
      monthlyGross,
      annualBonus: bonusAnnual,
      monthlyBasic,
      annualBasic,
      monthlyHra,
      annualHra,
      monthlySpecial,
      annualSpecial,
      monthlyEmployeePf,
      annualEmployeePf,
      monthlyPt: ptMonthly,
      annualPt,
      monthlyOther: otherMonthly,
      annualOther,
      activeMonthlyTds,
      activeAnnualTds,
      activeTotalMonthlyDeduct,
      activeTotalAnnualDeduct,
      activeInHandMonthly,
      activeInHandAnnual,
      newRegime: { taxAnnual: newTaxAnnual, taxMonthly: newMonthlyTds, inHandMonthly: newInHandMonthly, inHandAnnual: newInHandAnnual },
      oldRegime: { taxAnnual: oldTaxAnnual, taxMonthly: oldMonthlyTds, inHandMonthly: oldInHandMonthly, inHandAnnual: oldInHandAnnual },
    };

    // Update Result Card
    resSalMonthlyInhand.textContent = formatINR(activeInHandMonthly);
    resSalAnnualInhand.textContent = formatINR(activeInHandAnnual);
    resSalCtc.textContent = formatINR(annualCtc);
    resSalGrossMonthly.textContent = formatINR(monthlyGross);
    resSalTotalDeduct.textContent = formatINR(activeTotalMonthlyDeduct);
    resSalTdsMonthly.textContent = formatINR(activeMonthlyTds);

    // Update Chart & Ratio Bar
    const totalPie = monthlyGross > 0 ? monthlyGross : 1;
    const inHandPct = ((activeInHandMonthly / totalPie) * 100).toFixed(1);
    const pfPct = (((monthlyEmployeePf + ptMonthly) / totalPie) * 100).toFixed(1);
    const taxPct = ((activeMonthlyTds / totalPie) * 100).toFixed(1);

    barSalTakehome.style.width = `${inHandPct}%`;
    barSalPf.style.width = `${pfPct}%`;
    barSalTax.style.width = `${taxPct}%`;

    lblChartTakehome.textContent = `Net Take-Home: ${formatINR(activeInHandMonthly)} (${inHandPct}%)`;
    lblChartPf.textContent = `EPF & PT: ${formatINR(monthlyEmployeePf + ptMonthly)} (${pfPct}%)`;
    lblChartTax.textContent = `Tax/TDS: ${formatINR(activeMonthlyTds)} (${taxPct}%)`;

    // Handle Comparison Drawer
    if (regime === 'compare') {
      cardSalComparison.classList.remove('hidden');
      const higher = newInHandMonthly >= oldInHandMonthly ? 'New Tax Regime' : 'Old Tax Regime';
      const monthlyDiff = Math.abs(newInHandMonthly - oldInHandMonthly);
      const annualDiff = Math.abs(newInHandAnnual - oldInHandAnnual);

      txtSalComparisonRec.textContent = `Based on standard allowances, ${higher} provides ₹${monthlyDiff.toLocaleString('en-IN')} higher monthly take-home pay (₹${annualDiff.toLocaleString('en-IN')}/yr savings)!`;

      salCmpTbody.innerHTML = `
        <tr><td class="p-2.5 font-bold">Estimated Annual Tax / TDS</td><td class="p-2.5 text-right font-bold text-blue-600">${formatINR(newTaxAnnual)}</td><td class="p-2.5 text-right font-bold">${formatINR(oldTaxAnnual)}</td></tr>
        <tr><td class="p-2.5">Estimated Monthly TDS</td><td class="p-2.5 text-right">${formatINR(newMonthlyTds)}</td><td class="p-2.5 text-right">${formatINR(oldMonthlyTds)}</td></tr>
        <tr class="bg-emerald-50/50 dark:bg-emerald-950/20 font-bold"><td class="p-2.5">Monthly Take-Home Pay</td><td class="p-2.5 text-right text-emerald-600">${formatINR(newInHandMonthly)}</td><td class="p-2.5 text-right text-slate-900 dark:text-white">${formatINR(oldInHandMonthly)}</td></tr>
        <tr class="bg-slate-50 dark:bg-slate-800/80 font-black text-sm"><td class="p-2.5">Annual Take-Home Pay</td><td class="p-2.5 text-right text-emerald-600">${formatINR(newInHandAnnual)}</td><td class="p-2.5 text-right text-slate-900 dark:text-white">${formatINR(oldInHandAnnual)}</td></tr>
      `;
    } else {
      cardSalComparison.classList.add('hidden');
    }

    // Render Table
    renderBreakdownTable();

    salResultsSection.classList.remove('hidden');
  }

  // Render Table
  function renderBreakdownTable() {
    if (!lastCalculatedSalary) return;

    const s = lastCalculatedSalary;
    const isMonthly = activeBreakdownView === 'monthly';
    thSalAmount.textContent = isMonthly ? 'Monthly Amount (₹)' : 'Annual Amount (₹)';

    const rows = [
      { name: 'Basic Salary', cat: 'Earning', val: isMonthly ? s.monthlyBasic : s.annualBasic, isEarn: true },
      { name: 'House Rent Allowance (HRA)', cat: 'Earning', val: isMonthly ? s.monthlyHra : s.annualHra, isEarn: true },
      { name: 'Special / Other Allowances', cat: 'Earning', val: isMonthly ? s.monthlySpecial : s.annualSpecial, isEarn: true },
    ];

    if (s.annualBonus > 0) {
      rows.push({
        name: 'Performance Bonus / Variable',
        cat: 'Earning',
        val: isMonthly ? Math.round(s.annualBonus / 12) : s.annualBonus,
        isEarn: true
      });
    }

    rows.push({
      name: 'Gross Total Salary',
      cat: 'Total Earning',
      val: isMonthly ? s.monthlyGross : s.annualGross + s.annualBonus,
      isBold: true
    });

    rows.push(
      { name: 'Employee Provident Fund (EPF 12%)', cat: 'Deduction', val: isMonthly ? s.monthlyEmployeePf : s.annualEmployeePf, isDeduct: true },
      { name: 'Professional Tax (PT)', cat: 'Deduction', val: isMonthly ? s.monthlyPt : s.annualPt, isDeduct: true },
      { name: 'Estimated Income Tax / TDS', cat: 'Deduction', val: isMonthly ? s.activeMonthlyTds : s.activeAnnualTds, isDeduct: true }
    );

    if (s.monthlyOther > 0) {
      rows.push({ name: 'Insurance & Other Deductions', cat: 'Deduction', val: isMonthly ? s.monthlyOther : s.annualOther, isDeduct: true });
    }

    rows.push({
      name: 'Total Deductions',
      cat: 'Total Deduction',
      val: isMonthly ? s.activeTotalMonthlyDeduct : s.activeTotalAnnualDeduct,
      isBold: true,
      isDeductTotal: true
    });

    rows.push({
      name: 'Net Take-Home Salary (In-Hand)',
      cat: 'Net Pay',
      val: isMonthly ? s.activeInHandMonthly : s.activeInHandAnnual,
      isFinal: true
    });

    salBreakdownTbody.innerHTML = rows.map((r) => {
      let trClass = 'hover:bg-slate-50 dark:hover:bg-slate-800/50';
      let valClass = 'text-slate-900 dark:text-white';

      if (r.isFinal) {
        trClass = 'bg-emerald-50 dark:bg-emerald-950/30 font-black text-sm';
        valClass = 'text-emerald-600 dark:text-emerald-400';
      } else if (r.isBold) {
        trClass = 'bg-slate-100/70 dark:bg-slate-800/80 font-bold';
      } else if (r.isDeduct) {
        valClass = 'text-red-600 dark:text-red-400';
      }

      return `
        <tr class="${trClass}">
          <td class="p-2.5 font-bold ${r.isFinal ? 'text-emerald-700 dark:text-emerald-300' : ''}">${r.name}</td>
          <td class="p-2.5 text-slate-500 dark:text-slate-400">${r.cat}</td>
          <td class="p-2.5 text-right font-bold ${valClass}">${r.isDeduct ? '- ' : ''}${formatINR(r.val)}</td>
        </tr>
      `;
    }).join('');
  }

  // Switch View Tabs
  tabSalMonthly.addEventListener('click', () => {
    activeBreakdownView = 'monthly';
    tabSalMonthly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabSalAnnual.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderBreakdownTable();
  });

  tabSalAnnual.addEventListener('click', () => {
    activeBreakdownView = 'annual';
    tabSalAnnual.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabSalMonthly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderBreakdownTable();
  });

  btnCalcSal.addEventListener('click', executeSalaryCalculation);

  btnClearSal.addEventListener('click', () => {
    inpSalAmount.value = '1200000';
    inpSalBonus.value = '100000';
    inpSalBasicPct.value = '45';
    inpSalHraPct.value = '20';
    inpSalPt.value = '200';
    inpSalOtherDeduct.value = '500';
    selSalRegime.value = 'new';
    errSal.classList.add('hidden');
    salResultsSection.classList.add('hidden');
    lastCalculatedSalary = null;
    switchSalaryType('ctc');
  });

  // Preset Buttons Listener
  document.querySelectorAll('.btn-sal-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-type');
      const amt = btn.getAttribute('data-amt');
      const bonus = btn.getAttribute('data-bonus');

      switchSalaryType(type);
      if (amt) inpSalAmount.value = amt;
      if (bonus) inpSalBonus.value = bonus;
    });
  });

  // Enter Key Listener
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeSalaryCalculation();
        }
      });
    });
  });

  // Download PDF Functionality
  async function generateSalPdf() {
    if (!lastCalculatedSalary) {
      alert('Please calculate your take-home pay first.');
      return;
    }

    btnSalDownloadPdf.disabled = true;
    const originalText = txtBtnSalPdf.textContent;
    txtBtnSalPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text('Salary & Take-Home Pay Calculation', 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 28, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('PAYROLL SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);
      doc.text(`Annual CTC: Rs. ${lastCalculatedSalary.annualCtc.toLocaleString('en-IN')}`, 18, 44);
      doc.text(`Monthly Gross: Rs. ${lastCalculatedSalary.monthlyGross.toLocaleString('en-IN')}`, 18, 49);
      doc.text(`Tax Regime: ${lastCalculatedSalary.regime === 'compare' ? 'Comparison Mode' : lastCalculatedSalary.regime === 'new' ? 'New Tax Regime' : 'Old Tax Regime'}`, 18, 54);

      doc.text(`Monthly EPF: Rs. ${lastCalculatedSalary.monthlyEmployeePf.toLocaleString('en-IN')}`, 85, 44);
      doc.text(`Monthly TDS: Rs. ${lastCalculatedSalary.activeMonthlyTds.toLocaleString('en-IN')}`, 85, 49);
      doc.text(`Monthly Deductions: Rs. ${lastCalculatedSalary.activeTotalMonthlyDeduct.toLocaleString('en-IN')}`, 85, 54);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(16, 185, 129);
      doc.text(`Monthly In-Hand: Rs. ${lastCalculatedSalary.activeInHandMonthly.toLocaleString('en-IN')}`, 140, 46);
      doc.setTextColor(37, 99, 235);
      doc.text(`Annual In-Hand: Rs. ${lastCalculatedSalary.activeInHandAnnual.toLocaleString('en-IN')}`, 140, 52);

      // 4. Breakdown Table
      const s = lastCalculatedSalary;
      const isMonthly = activeBreakdownView === 'monthly';

      const tableData = [
        ['Basic Salary', 'Earning', 'Rs. ' + (isMonthly ? s.monthlyBasic : s.annualBasic).toLocaleString('en-IN')],
        ['House Rent Allowance (HRA)', 'Earning', 'Rs. ' + (isMonthly ? s.monthlyHra : s.annualHra).toLocaleString('en-IN')],
        ['Special / Other Allowances', 'Earning', 'Rs. ' + (isMonthly ? s.monthlySpecial : s.annualSpecial).toLocaleString('en-IN')],
      ];

      if (s.annualBonus > 0) {
        tableData.push(['Performance Bonus', 'Earning', 'Rs. ' + (isMonthly ? Math.round(s.annualBonus / 12) : s.annualBonus).toLocaleString('en-IN')]);
      }

      tableData.push(
        ['Gross Total Salary', 'Total Earning', 'Rs. ' + (isMonthly ? s.monthlyGross : s.annualGross + s.annualBonus).toLocaleString('en-IN')],
        ['Employee EPF (12%)', 'Deduction', '- Rs. ' + (isMonthly ? s.monthlyEmployeePf : s.annualEmployeePf).toLocaleString('en-IN')],
        ['Professional Tax (PT)', 'Deduction', '- Rs. ' + (isMonthly ? s.monthlyPt : s.annualPt).toLocaleString('en-IN')],
        ['Estimated Income Tax / TDS', 'Deduction', '- Rs. ' + (isMonthly ? s.activeMonthlyTds : s.activeAnnualTds).toLocaleString('en-IN')]
      );

      if (s.monthlyOther > 0) {
        tableData.push(['Insurance / Other', 'Deduction', '- Rs. ' + (isMonthly ? s.monthlyOther : s.annualOther).toLocaleString('en-IN')]);
      }

      tableData.push(
        ['Total Deductions', 'Total Deduction', '- Rs. ' + (isMonthly ? s.activeTotalMonthlyDeduct : s.activeTotalAnnualDeduct).toLocaleString('en-IN')],
        ['Net Take-Home Pay (In-Hand)', 'Net Pay', 'Rs. ' + (isMonthly ? s.activeInHandMonthly : s.activeInHandAnnual).toLocaleString('en-IN')]
      );

      doc.autoTable({
        startY: 65,
        head: [['Component', 'Category', isMonthly ? 'Monthly Amount' : 'Annual Amount']],
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { cellWidth: 80, halign: 'left', fontStyle: 'bold' },
          1: { halign: 'center' },
          2: { halign: 'right', fontStyle: 'bold' }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const today = new Date().toISOString().split('T')[0];
      doc.save(`salary-take-home-pay-${today}.pdf`);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnSalDownloadPdf.disabled = false;
      txtBtnSalPdf.textContent = originalText;
    }
  }

  btnSalDownloadPdf.addEventListener('click', generateSalPdf);
</script>
