<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // State
  let currentSipMode = 'regular'; // 'regular' or 'stepup'
  let activeScheduleTab = 'yearly'; // 'yearly' or 'monthly'
  let lastCalculatedSip = { monthly: [], yearly: [] };

  // DOM Elements
  const sipTabs = document.querySelectorAll('.btn-sip-tab');
  const sipPanelTitle = document.getElementById('sip-panel-title');
  const sipPanelDesc = document.getElementById('sip-panel-desc');
  const rowStepUpConfig = document.getElementById('row-stepup-config');
  const selStepUpType = document.getElementById('sel-stepup-type');
  const lblStepUpVal = document.getElementById('lbl-stepup-val');
  const inpStepUpVal = document.getElementById('inp-stepup-val');

  const inpMonthlySip = document.getElementById('inp-monthly-sip');
  const inpReturnRate = document.getElementById('inp-return-rate');
  const inpInvestmentYears = document.getElementById('inp-investment-years');

  const btnCalcSip = document.getElementById('btn-calc-sip');
  const btnClearSip = document.getElementById('btn-clear-sip');
  const errSip = document.getElementById('err-sip');

  // Results Elements
  const sipResultsSection = document.getElementById('sip-results-section');
  const resFutureVal = document.getElementById('res-future-val');
  const resWealthMultiplier = document.getElementById('res-wealth-multiplier');
  const resTotalInvested = document.getElementById('res-total-invested');
  const resEstReturns = document.getElementById('res-est-returns');
  const resDurationText = document.getElementById('res-duration-text');
  const resFinalSip = document.getElementById('res-final-sip');

  const svgDonutReturns = document.getElementById('svg-donut-returns');
  const txtLegendInvested = document.getElementById('txt-legend-invested');
  const txtLegendReturns = document.getElementById('txt-legend-returns');

  const btnSipYearly = document.getElementById('btn-sip-yearly');
  const btnSipMonthly = document.getElementById('btn-sip-monthly');
  const btnSipDownloadPdf = document.getElementById('btn-sip-download-pdf');
  const txtBtnSipPdf = document.getElementById('txt-btn-sip-pdf');

  const thSipPeriod = document.getElementById('th-sip-period');
  const thSipDeposit = document.getElementById('th-sip-deposit');
  const sipScheduleTbody = document.getElementById('sip-schedule-tbody');

  // Number Formatting Helper
  function formatINR(val) {
    return `₹ ${Math.round(val).toLocaleString('en-IN')}`;
  }

  // Switch Mode
  function switchSipMode(mode) {
    currentSipMode = mode;
    sipTabs.forEach((btn) => {
      if (btn.getAttribute('data-mode') === mode) {
        btn.className = 'btn-sip-tab active shrink-0 rounded-lg bg-blue-600 px-4 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-sip-tab shrink-0 rounded-lg border border-slate-300 bg-white px-4 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    if (mode === 'stepup') {
      sipPanelTitle.innerHTML = '<span>🚀</span> Step Up SIP (Top-Up) Calculator';
      sipPanelDesc.textContent = 'Project investment growth with automatic annual increases in monthly SIP contributions.';
      rowStepUpConfig.classList.remove('hidden');
    } else {
      sipPanelTitle.innerHTML = '<span>📈</span> Mutual Fund SIP Calculator';
      sipPanelDesc.textContent = 'Calculate estimated wealth accumulation, total investment, and compounding returns on monthly mutual fund SIPs.';
      rowStepUpConfig.classList.add('hidden');
    }
  }

  sipTabs.forEach((btn) => {
    btn.addEventListener('click', () => switchSipMode(btn.getAttribute('data-mode')));
  });

  // Step-up type change
  selStepUpType.addEventListener('change', () => {
    if (selStepUpType.value === 'percentage') {
      lblStepUpVal.textContent = 'Annual Increase (%)';
      inpStepUpVal.value = '10';
      inpStepUpVal.step = '1';
    } else {
      lblStepUpVal.textContent = 'Annual Increase Amount (₹)';
      inpStepUpVal.value = '500';
      inpStepUpVal.step = '100';
    }
  });

  // Execute Calculation
  function executeSipCalculation() {
    errSip.classList.add('hidden');
    const initialP = parseFloat(inpMonthlySip.value) || 0;
    const annualR = parseFloat(inpReturnRate.value);
    const years = parseFloat(inpInvestmentYears.value) || 0;
    const isStepUp = currentSipMode === 'stepup';
    const stepUpType = selStepUpType.value;
    const stepUpVal = parseFloat(inpStepUpVal.value) || 0;

    if (initialP <= 0) {
      errSip.textContent = 'Please enter a valid monthly investment amount greater than zero.';
      errSip.classList.remove('hidden');
      sipResultsSection.classList.add('hidden');
      return;
    }

    if (isNaN(annualR) || annualR < 0) {
      errSip.textContent = 'Please enter a valid expected return rate (0% or greater).';
      errSip.classList.remove('hidden');
      sipResultsSection.classList.add('hidden');
      return;
    }

    if (years <= 0) {
      errSip.textContent = 'Investment duration must be greater than zero.';
      errSip.classList.remove('hidden');
      sipResultsSection.classList.add('hidden');
      return;
    }

    const totalMonths = Math.round(years * 12);
    const monthlyRate = annualR / 12 / 100;

    let currentP = initialP;
    let runningInvested = 0;
    let runningValue = 0;

    const monthlyList = [];
    const yearlyList = [];
    let annualInvested = 0;

    for (let m = 1; m <= totalMonths; m++) {
      if (isStepUp && m > 1 && (m - 1) % 12 === 0) {
        if (stepUpType === 'percentage') {
          currentP = Math.round(currentP * (1 + stepUpVal / 100));
        } else {
          currentP = currentP + stepUpVal;
        }
      }

      runningInvested += currentP;
      annualInvested += currentP;

      if (monthlyRate === 0) {
        runningValue = runningInvested;
      } else {
        runningValue = (runningValue + currentP) * (1 + monthlyRate);
      }

      const curValRound = Math.round(runningValue);
      const curReturns = Math.max(0, curValRound - runningInvested);

      monthlyList.push({
        m,
        monthlySip: currentP,
        invested: runningInvested,
        returns: curReturns,
        val: curValRound
      });

      if (m % 12 === 0 || m === totalMonths) {
        yearlyList.push({
          y: Math.ceil(m / 12),
          annualInv: annualInvested,
          invested: runningInvested,
          returns: curReturns,
          val: curValRound,
          currentSip: currentP
        });
        annualInvested = 0;
      }
    }

    const totalMaturity = Math.round(runningValue);
    const totalReturns = Math.max(0, totalMaturity - runningInvested);
    const multiplier = runningInvested > 0 ? (totalMaturity / runningInvested).toFixed(2) : 0;

    const investedPct = totalMaturity > 0 ? ((runningInvested / totalMaturity) * 100) : 100;
    const returnsPct = Math.max(0, 100 - investedPct);

    resFutureVal.textContent = formatINR(totalMaturity);
    resWealthMultiplier.textContent = `${multiplier}x`;
    resTotalInvested.textContent = formatINR(runningInvested);
    resEstReturns.textContent = formatINR(totalReturns);
    resDurationText.textContent = `${years} Years (${totalMonths} Mo)`;
    resFinalSip.textContent = `${formatINR(currentP)} / mo`;

    // Update Donut
    const returnsCircum = returnsPct.toFixed(1);
    const investedCircum = investedPct.toFixed(1);
    svgDonutReturns.setAttribute('stroke-dasharray', `${returnsCircum} ${investedCircum}`);
    txtLegendInvested.textContent = `${formatINR(runningInvested)} (${investedPct.toFixed(1)}%)`;
    txtLegendReturns.textContent = `${formatINR(totalReturns)} (${returnsPct.toFixed(1)}%)`;

    lastCalculatedSip = { monthly: monthlyList, yearly: yearlyList };
    renderSipSchedule();

    sipResultsSection.classList.remove('hidden');
  }

  btnCalcSip.addEventListener('click', executeSipCalculation);

  btnClearSip.addEventListener('click', () => {
    inpMonthlySip.value = '5000';
    inpReturnRate.value = '12';
    inpInvestmentYears.value = '10';
    inpStepUpVal.value = '10';
    selStepUpType.value = 'percentage';
    errSip.classList.add('hidden');
    sipResultsSection.classList.add('hidden');
  });

  // Render Schedule
  function renderSipSchedule() {
    if (activeScheduleTab === 'yearly') {
      thSipPeriod.textContent = 'Year';
      thSipDeposit.textContent = 'Annual Investment';
      sipScheduleTbody.innerHTML = lastCalculatedSip.yearly.map((r) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Year ${r.y}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(r.annualInv)}</td>
          <td class="p-2.5 text-right font-bold text-blue-600 dark:text-blue-400">${formatINR(r.invested)}</td>
          <td class="p-2.5 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatINR(r.returns)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(r.val)}</td>
        </tr>
      `).join('');
    } else {
      thSipPeriod.textContent = 'Month';
      thSipDeposit.textContent = 'Monthly Deposit';
      sipScheduleTbody.innerHTML = lastCalculatedSip.monthly.map((r) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Mo ${r.m}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(r.monthlySip)}</td>
          <td class="p-2.5 text-right font-bold text-blue-600 dark:text-blue-400">${formatINR(r.invested)}</td>
          <td class="p-2.5 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatINR(r.returns)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(r.val)}</td>
        </tr>
      `).join('');
    }
  }

  btnSipYearly.addEventListener('click', () => {
    activeScheduleTab = 'yearly';
    btnSipYearly.className = 'rounded-lg bg-blue-600 px-2.5 py-1 text-white shadow-2xs cursor-pointer';
    btnSipMonthly.className = 'rounded-lg border border-slate-300 px-2.5 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer';
    renderSipSchedule();
  });

  btnSipMonthly.addEventListener('click', () => {
    activeScheduleTab = 'monthly';
    btnSipMonthly.className = 'rounded-lg bg-blue-600 px-2.5 py-1 text-white shadow-2xs cursor-pointer';
    btnSipYearly.className = 'rounded-lg border border-slate-300 px-2.5 py-1 text-slate-700 dark:border-slate-700 dark:text-slate-300 cursor-pointer';
    renderSipSchedule();
  });

  // Dynamic Tab-Selective PDF Download
  async function generateSipPdf() {
    const isYearly = activeScheduleTab === 'yearly';
    const scheduleData = isYearly ? lastCalculatedSip.yearly : lastCalculatedSip.monthly;

    if (!scheduleData || scheduleData.length === 0) {
      alert('Please calculate your SIP investment first before downloading the PDF schedule.');
      return;
    }

    btnSipDownloadPdf.disabled = true;
    const originalText = txtBtnSipPdf.textContent;
    txtBtnSipPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

      const initialP = parseFloat(inpMonthlySip.value) || 0;
      const rate = parseFloat(inpReturnRate.value) || 0;
      const years = parseFloat(inpInvestmentYears.value) || 0;
      const totalMonths = years * 12;
      const futureValText = resFutureVal.textContent || '';
      const totalInvText = resTotalInvested.textContent || '';
      const returnsText = resEstReturns.textContent || '';
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      const isStepUp = currentSipMode === 'stepup';
      const stepType = selStepUpType.value === 'percentage' ? `${inpStepUpVal.value}% / Year` : `Rs. ${inpStepUpVal.value} / Year`;

      // 1. Header & Website Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title (Reflects selected view)
      const pdfTitle = isYearly
        ? 'SIP Investment Schedule – Yearly Summary'
        : 'SIP Investment Schedule – Monthly Schedule';

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(12.5);
      doc.setFont('helvetica', 'bold');
      doc.text(pdfTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Investment Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 26, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('INVESTMENT SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);

      doc.text(`Type: ${isStepUp ? 'Step Up SIP (Top-Up)' : 'Regular Monthly SIP'}`, 18, 44);
      doc.text(`Initial SIP: Rs. ${initialP.toLocaleString('en-IN')}`, 18, 49);
      doc.text(`Expected Return: ${rate}% p.a.`, 18, 54);

      doc.text(`Duration: ${years} Years (${totalMonths} Months)`, 85, 44);
      doc.text(`Total Invested: ${totalInvText.replace('₹', 'Rs.')}`, 85, 49);
      doc.text(`Estimated Returns: ${returnsText.replace('₹', 'Rs.')}`, 85, 54);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(16, 185, 129); // Emerald-600
      doc.text(`Maturity Value: ${futureValText.replace('₹', 'Rs.')}`, 145, 49);

      if (isStepUp) {
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(71, 85, 105);
        doc.text(`Step-Up: ${stepType}`, 145, 54);
      }

      // 4. Table Data Preparation based ONLY on active selected view
      let headRow = [];
      let tableData = [];

      if (isYearly) {
        headRow = [['Year', 'Annual Investment', 'Total Invested', 'Estimated Returns', 'Portfolio Value']];
        tableData = lastCalculatedSip.yearly.map((row) => [
          `Year ${row.y}`,
          `Rs. ${row.annualInv.toLocaleString('en-IN')}`,
          `Rs. ${row.invested.toLocaleString('en-IN')}`,
          `Rs. ${row.returns.toLocaleString('en-IN')}`,
          `Rs. ${row.val.toLocaleString('en-IN')}`
        ]);
      } else {
        headRow = [['Month', 'Monthly Deposit', 'Total Invested', 'Estimated Returns', 'Portfolio Value']];
        tableData = lastCalculatedSip.monthly.map((row) => [
          `Month ${row.m}`,
          `Rs. ${row.monthlySip.toLocaleString('en-IN')}`,
          `Rs. ${row.invested.toLocaleString('en-IN')}`,
          `Rs. ${row.returns.toLocaleString('en-IN')}`,
          `Rs. ${row.val.toLocaleString('en-IN')}`
        ]);
      }

      doc.autoTable({
        startY: 63,
        head: headRow,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { halign: 'center', cellWidth: 20 },
          1: { halign: 'right' },
          2: { halign: 'right', textColor: [37, 99, 235] },
          3: { halign: 'right', textColor: [16, 185, 129] },
          4: { halign: 'right', fontStyle: 'bold' }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      // 5. Filename formatting based on selected view
      const today = new Date().toISOString().split('T')[0];
      const filename = isYearly
        ? `sip-investment-yearly-summary-${today}.pdf`
        : `sip-investment-monthly-schedule-${today}.pdf`;

      doc.save(filename);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnSipDownloadPdf.disabled = false;
      txtBtnSipPdf.textContent = originalText;
    }
  }

  btnSipDownloadPdf.addEventListener('click', generateSipPdf);

  // Preset Clicks
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-mode');
      switchSipMode(mode);

      if (btn.hasAttribute('data-amt')) inpMonthlySip.value = btn.getAttribute('data-amt');
      if (btn.hasAttribute('data-rate')) inpReturnRate.value = btn.getAttribute('data-rate');
      if (btn.hasAttribute('data-years')) inpInvestmentYears.value = btn.getAttribute('data-years');
      if (btn.hasAttribute('data-step-type')) {
        selStepUpType.value = btn.getAttribute('data-step-type');
        selStepUpType.dispatchEvent(new Event('change'));
      }
      if (btn.hasAttribute('data-step-val')) inpStepUpVal.value = btn.getAttribute('data-step-val');
    });
  });

  // Enter Key Support
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.click();
        }
      });
    });
  });
</script>
