<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // State
  let lastCalculatedSi = null;
  let activeScheduleView = 'yearly'; // 'yearly' | 'monthly'

  // DOM Elements
  const inpSiP = document.getElementById('inp-si-principal');
  const inpSiR = document.getElementById('inp-si-rate');
  const inpSiT = document.getElementById('inp-si-time');
  const selSiUnit = document.getElementById('sel-si-unit');

  const btnCalcSi = document.getElementById('btn-calc-si');
  const btnClearSi = document.getElementById('btn-clear-si');
  const errSi = document.getElementById('err-si');

  // Results Elements
  const siResultsSection = document.getElementById('si-results-section');
  const resSiInterest = document.getElementById('res-si-interest');
  const resSiMaturity = document.getElementById('res-si-maturity');
  const resSiPrincipal = document.getElementById('res-si-principal');
  const resSiRate = document.getElementById('res-si-rate');
  const resSiPeriod = document.getElementById('res-si-period');
  const resSiMonthly = document.getElementById('res-si-monthly');

  const resSiFormula = document.getElementById('res-si-formula');
  const resSiArithmetic = document.getElementById('res-si-arithmetic');

  const tabSiYearly = document.getElementById('tab-si-yearly');
  const tabSiMonthly = document.getElementById('tab-si-monthly');
  const btnSiDownloadPdf = document.getElementById('btn-si-download-pdf');
  const txtBtnSiPdf = document.getElementById('txt-btn-si-pdf');

  const siSchedThead = document.getElementById('si-sched-thead');
  const siSchedTbody = document.getElementById('si-sched-tbody');

  // Currency Formatter
  function formatINR(val) {
    return `₹ ${Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  // Calculation Engine
  function executeSiCalculation() {
    errSi.classList.add('hidden');

    const principal = parseFloat(inpSiP.value);
    const rate = parseFloat(inpSiR.value);
    const timeVal = parseFloat(inpSiT.value);
    const timeUnit = selSiUnit.value; // 'years' | 'months' | 'days'

    if (isNaN(principal) || principal <= 0) {
      errSi.textContent = 'Please enter a valid principal amount greater than 0.';
      errSi.classList.remove('hidden');
      siResultsSection.classList.add('hidden');
      return;
    }

    if (isNaN(rate) || rate < 0) {
      errSi.textContent = 'Please enter a valid annual interest rate.';
      errSi.classList.remove('hidden');
      siResultsSection.classList.add('hidden');
      return;
    }

    if (isNaN(timeVal) || timeVal <= 0) {
      errSi.textContent = 'Please enter a valid duration greater than 0.';
      errSi.classList.remove('hidden');
      siResultsSection.classList.add('hidden');
      return;
    }

    let timeInYears = timeVal;
    let periodLabel = `${timeVal} Years`;
    let formulaText = 'Formula: Simple Interest = (P × R × T) ÷ 100';
    let arithmeticText = `₹${principal.toLocaleString('en-IN')} × ${rate} × ${timeVal} ÷ 100`;

    if (timeUnit === 'months') {
      timeInYears = timeVal / 12;
      periodLabel = `${timeVal} Months (${timeInYears.toFixed(2)} Yrs)`;
      formulaText = 'Formula: Simple Interest = (P × R × Months) ÷ (100 × 12)';
      arithmeticText = `₹${principal.toLocaleString('en-IN')} × ${rate} × ${timeVal} ÷ 1200`;
    } else if (timeUnit === 'days') {
      timeInYears = timeVal / 365;
      periodLabel = `${timeVal} Days (${timeInYears.toFixed(3)} Yrs)`;
      formulaText = 'Formula: Simple Interest = (P × R × Days) ÷ (100 × 365)';
      arithmeticText = `₹${principal.toLocaleString('en-IN')} × ${rate} × ${timeVal} ÷ 36500`;
    }

    const interestEarned = (principal * rate * timeInYears) / 100;
    const totalMaturity = principal + interestEarned;
    const monthlyYield = (principal * rate) / (12 * 100);

    // 1. Generate Yearly Summary Rows
    const yearlySchedule = [];
    const fullYears = Math.max(1, Math.ceil(timeInYears));
    const annualInterest = (principal * rate) / 100;
    let runningYearlyInterest = 0;

    for (let y = 1; y <= fullYears; y++) {
      let currentYearInterest = annualInterest;
      if (y === fullYears && timeInYears % 1 !== 0) {
        const remainingFraction = timeInYears - Math.floor(timeInYears);
        currentYearInterest = annualInterest * remainingFraction;
      }
      runningYearlyInterest += currentYearInterest;
      yearlySchedule.push({
        year: y,
        openingPrincipal: principal,
        interestForYear: currentYearInterest,
        cumulativeInterest: runningYearlyInterest,
        totalAmount: principal + runningYearlyInterest,
      });
    }

    // 2. Generate Monthly Schedule Rows
    const totalMonths = Math.max(1, Math.ceil(timeInYears * 12));
    const monthlySchedule = [];
    const standardMonthInterest = (principal * rate) / 1200;
    let runningMonthlyInterest = 0;

    for (let m = 1; m <= totalMonths; m++) {
      let currentMonthInterest = standardMonthInterest;
      if (m === totalMonths && (timeInYears * 12) % 1 !== 0) {
        const remainingFraction = (timeInYears * 12) - Math.floor(timeInYears * 12);
        currentMonthInterest = standardMonthInterest * remainingFraction;
      }
      runningMonthlyInterest += currentMonthInterest;
      monthlySchedule.push({
        month: m,
        principal: principal,
        monthlyInterest: currentMonthInterest,
        cumulativeInterest: runningMonthlyInterest,
        totalAmount: principal + runningMonthlyInterest,
      });
    }

    // Save calculation state
    lastCalculatedSi = {
      principal,
      rate,
      timeVal,
      timeUnit,
      periodLabel,
      interestEarned,
      totalMaturity,
      monthlyYield,
      yearlySchedule,
      monthlySchedule,
    };

    // Update Result Card
    resSiInterest.textContent = formatINR(interestEarned);
    resSiMaturity.textContent = formatINR(totalMaturity);
    resSiPrincipal.textContent = formatINR(principal);
    resSiRate.textContent = `${rate}% p.a.`;
    resSiPeriod.textContent = periodLabel;
    resSiMonthly.textContent = formatINR(monthlyYield);

    // Update Breakdown
    resSiFormula.textContent = formulaText;
    resSiArithmetic.textContent = `${arithmeticText} = ${formatINR(interestEarned)}`;

    // Render Schedule
    renderScheduleTable();

    siResultsSection.classList.remove('hidden');
  }

  // Render Active Schedule Table
  function renderScheduleTable() {
    if (!lastCalculatedSi) return;

    if (activeScheduleView === 'yearly') {
      siSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Year</th>
          <th class="p-2.5 text-right">Opening Principal</th>
          <th class="p-2.5 text-right">Interest for Year</th>
          <th class="p-2.5 text-right">Cumulative Interest</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Total Amount</th>
        </tr>
      `;

      siSchedTbody.innerHTML = lastCalculatedSi.yearlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Year ${row.year}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingPrincipal)}</td>
          <td class="p-2.5 text-right font-bold text-blue-600 dark:text-blue-400">${formatINR(row.interestForYear)}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.cumulativeInterest)}</td>
          <td class="p-2.5 text-right font-black text-emerald-600 dark:text-emerald-400">${formatINR(row.totalAmount)}</td>
        </tr>
      `).join('');
    } else {
      siSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Month</th>
          <th class="p-2.5 text-right">Principal</th>
          <th class="p-2.5 text-right">Monthly Interest</th>
          <th class="p-2.5 text-right">Cumulative Interest</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Total Amount</th>
        </tr>
      `;

      siSchedTbody.innerHTML = lastCalculatedSi.monthlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Month ${row.month}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.principal)}</td>
          <td class="p-2.5 text-right font-bold text-blue-600 dark:text-blue-400">${formatINR(row.monthlyInterest)}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.cumulativeInterest)}</td>
          <td class="p-2.5 text-right font-black text-emerald-600 dark:text-emerald-400">${formatINR(row.totalAmount)}</td>
        </tr>
      `).join('');
    }
  }

  // Switch Schedule Tabs
  tabSiYearly.addEventListener('click', () => {
    activeScheduleView = 'yearly';
    tabSiYearly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabSiMonthly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  tabSiMonthly.addEventListener('click', () => {
    activeScheduleView = 'monthly';
    tabSiMonthly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabSiYearly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  btnCalcSi.addEventListener('click', executeSiCalculation);

  btnClearSi.addEventListener('click', () => {
    inpSiP.value = '100000';
    inpSiR.value = '10';
    inpSiT.value = '5';
    selSiUnit.value = 'years';
    errSi.classList.add('hidden');
    siResultsSection.classList.add('hidden');
    lastCalculatedSi = null;
    activeScheduleView = 'yearly';
    tabSiYearly.click();
  });

  // Preset Buttons Listener
  document.querySelectorAll('.btn-si-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-p');
      const r = btn.getAttribute('data-r');
      const t = btn.getAttribute('data-t');
      const u = btn.getAttribute('data-u');

      if (p) inpSiP.value = p;
      if (r) inpSiR.value = r;
      if (t) inpSiT.value = t;
      if (u) selSiUnit.value = u;
    });
  });

  // Enter Key Listener
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeSiCalculation();
        }
      });
    });
  });

  // Tab-Selective PDF Download
  async function generateSiPdf() {
    if (!lastCalculatedSi) {
      alert('Please calculate the interest first.');
      return;
    }

    btnSiDownloadPdf.disabled = true;
    const originalText = txtBtnSiPdf.textContent;
    txtBtnSiPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      const pdfTitle = activeScheduleView === 'yearly'
        ? 'Simple Interest Schedule – Yearly Summary'
        : 'Simple Interest Schedule – Monthly Schedule';

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(pdfTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 26, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('CALCULATION SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);
      doc.text(`Principal Amount: Rs. ${lastCalculatedSi.principal.toLocaleString('en-IN')}`, 18, 44);
      doc.text(`Interest Rate: ${lastCalculatedSi.rate}% p.a.`, 18, 49);
      doc.text(`Time Duration: ${lastCalculatedSi.periodLabel}`, 18, 54);

      doc.text(`Monthly Yield: Rs. ${lastCalculatedSi.monthlyYield.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 85, 44);
      doc.text(`View: ${activeScheduleView === 'yearly' ? 'Yearly Summary' : 'Monthly Schedule'}`, 85, 49);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(16, 185, 129);
      doc.text(`Total Interest: Rs. ${lastCalculatedSi.interestEarned.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 140, 44);
      doc.setTextColor(37, 99, 235);
      doc.text(`Final Amount: Rs. ${lastCalculatedSi.totalMaturity.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 140, 50);

      // 4. Tab-Selective Table Data Generation
      let tableHead = [];
      let tableData = [];

      if (activeScheduleView === 'yearly') {
        tableHead = [['Year', 'Opening Principal', 'Interest for Year', 'Cumulative Interest', 'Total Amount']];
        tableData = lastCalculatedSi.yearlySchedule.map((r) => [
          `Year ${r.year}`,
          'Rs. ' + r.openingPrincipal.toLocaleString('en-IN'),
          'Rs. ' + r.interestForYear.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.cumulativeInterest.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        ]);
      } else {
        tableHead = [['Month', 'Principal', 'Monthly Interest', 'Cumulative Interest', 'Total Amount']];
        tableData = lastCalculatedSi.monthlySchedule.map((r) => [
          `Month ${r.month}`,
          'Rs. ' + r.principal.toLocaleString('en-IN'),
          'Rs. ' + r.monthlyInterest.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.cumulativeInterest.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        ]);
      }

      doc.autoTable({
        startY: 63,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { cellWidth: 35, halign: 'left', fontStyle: 'bold' },
          1: { halign: 'right' },
          2: { halign: 'right' },
          3: { halign: 'right' },
          4: { halign: 'right', fontStyle: 'bold', textColor: [16, 185, 129] }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const today = new Date().toISOString().split('T')[0];
      const filename = activeScheduleView === 'yearly'
        ? `simple-interest-yearly-summary-${today}.pdf`
        : `simple-interest-monthly-schedule-${today}.pdf`;

      doc.save(filename);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnSiDownloadPdf.disabled = false;
      txtBtnSiPdf.textContent = originalText;
    }
  }

  btnSiDownloadPdf.addEventListener('click', generateSiPdf);
</script>
