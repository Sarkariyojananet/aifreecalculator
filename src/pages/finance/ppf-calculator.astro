---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="PPF Calculator – Public Provident Fund Interest & Maturity Calculator"
  description="Calculate exact PPF maturity amount, interest earned, and year-wise growth for annual or monthly investments with our free Public Provident Fund calculator."
  category="Finance"
  calculatorName="PPF Calculator"
  slug="ppf-calculator"
  keywords={[
    'ppf calculator',
    'public provident fund calculator',
    'ppf interest calculator',
    'ppf maturity calculator',
    'ppf calculator india',
    'ppf calculator monthly',
    'ppf investment calculator',
    'ppf scheme interest',
    'ppf return calculator',
    'ppf maturity amount'
  ]}
>
  <div class="space-y-6">

    <!-- MODE SELECTION TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button
          type="button"
          id="tab-btn-simple"
          class="btn-ppf-tab active shrink-0 rounded-lg bg-blue-600 px-4 py-1.5 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5"
          data-mode="simple"
        >
          <span>🌱</span>
          <span>Simple PPF Calculator</span>
        </button>
        <button
          type="button"
          id="tab-btn-advanced"
          class="btn-ppf-tab shrink-0 rounded-lg border border-slate-300 bg-white px-4 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5"
          data-mode="advanced"
        >
          <span>⚙️</span>
          <span>Advanced PPF Calculator (Extensions &amp; Withdrawals)</span>
        </button>
      </div>
    </div>

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-amt="10000" data-years="15" data-timing="beginning_of_year">
          ₹10k / Year (15 Yrs)
        </button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-amt="50000" data-years="15" data-timing="beginning_of_year">
          ₹50k / Year (15 Yrs)
        </button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-amt="150000" data-years="15" data-timing="beginning_of_year">
          ⭐ Max ₹1.5L / Year (15 Yrs)
        </button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-amt="150000" data-years="20" data-timing="beginning_of_year">
          🚀 ₹1.5L / Year Extended (20 Yrs)
        </button>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
        <h2 id="ppf-panel-title" class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
          <span>🏦</span> Public Provident Fund (PPF) Calculator
        </h2>
        <p id="ppf-panel-desc" class="mt-1 text-xs text-slate-600 dark:text-slate-400">
          Calculate interest and projected maturity wealth under Indian PPF guidelines with flexible contribution frequencies and deposit timing assumptions.
        </p>
      </div>

      <form id="form-ppf" class="mt-4 space-y-4" novalidate onsubmit="return false;">

        <!-- Advanced Mode: Contribution Frequency Toggle -->
        <div id="row-adv-freq" class="hidden rounded-2xl border border-blue-200 bg-white p-3.5 dark:border-blue-900/60 dark:bg-slate-900">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">Contribution Frequency</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="btn-freq-yearly" class="btn-freq-toggle active rounded-xl bg-blue-600 py-2 text-xs font-bold text-white transition cursor-pointer" data-freq="yearly">
              Yearly Deposit (Once a year)
            </button>
            <button type="button" id="btn-freq-monthly" class="btn-freq-toggle rounded-xl border border-slate-300 bg-white py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer" data-freq="monthly">
              Monthly Contribution (12 times/yr)
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          
          <!-- Investment Amount -->
          <div>
            <div class="flex items-center justify-between">
              <label for="inp-investment-amt" id="lbl-investment-amt" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Yearly Investment (₹)
              </label>
              <span class="text-[10px] text-slate-500 font-semibold">Max ₹1,50,000/yr</span>
            </div>
            <div class="relative mt-1.5">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-sm font-bold text-slate-400">₹</span>
              <input
                type="number"
                id="inp-investment-amt"
                value="10000"
                step="500"
                min="500"
                max="150000"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pl-7 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                placeholder="10,000"
              />
            </div>
            <div class="flex items-center gap-1 mt-1.5">
              <button type="button" class="btn-amt-quick text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 dark:bg-slate-800 dark:text-slate-300" data-amt="10000">₹10K</button>
              <button type="button" class="btn-amt-quick text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 dark:bg-slate-800 dark:text-slate-300" data-amt="50000">₹50K</button>
              <button type="button" class="btn-amt-quick text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 dark:bg-slate-800 dark:text-slate-300" data-amt="100000">₹1L</button>
              <button type="button" class="btn-amt-quick text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-600 dark:bg-slate-800 dark:text-slate-300" data-amt="150000">Max ₹1.5L</button>
            </div>
          </div>

          <!-- Time Horizon / Duration -->
          <div>
            <div class="flex items-center justify-between">
              <label for="sel-tenure-years" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Investment Period
              </label>
              <span class="text-[10px] text-slate-500 font-semibold">Min 15 Years</span>
            </div>
            <select
              id="sel-tenure-years"
              class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
            >
              <option value="15" selected>15 Years (Standard Lock-in)</option>
              <option value="20">20 Years (1 Block Extension)</option>
              <option value="25">25 Years (2 Block Extensions)</option>
              <option value="30">30 Years (3 Block Extensions)</option>
            </select>
            <p class="mt-1.5 text-[10px] text-slate-400">
              PPF accounts mature in 15 full financial years, extendable in 5-year tranches.
            </p>
          </div>

          <!-- Assumed Annual Interest Rate -->
          <div>
            <div class="flex items-center justify-between">
              <label for="inp-interest-rate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Assumed Interest Rate
              </label>
              <span class="text-[10px] text-blue-600 dark:text-blue-400 font-bold">Current: 7.1%</span>
            </div>
            <div class="relative mt-1.5">
              <input
                type="number"
                id="inp-interest-rate"
                value="7.1"
                step="0.05"
                min="1"
                max="20"
                class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-8 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                placeholder="7.1"
              />
              <span class="absolute inset-y-0 right-0 flex items-center pr-3 text-xs font-bold text-slate-400">% p.a.</span>
            </div>
            <p class="mt-1.5 text-[10px] text-slate-400">
              * Rates set quarterly by Govt. of India. Not permanently fixed.
            </p>
          </div>

        </div>

        <!-- Deposit Timing Option -->
        <div class="rounded-2xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900 space-y-1">
          <label for="sel-deposit-timing" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Deposit Timing Assumption
          </label>
          <select
            id="sel-deposit-timing"
            class="w-full rounded-xl border border-slate-300 bg-white p-2.5 text-xs sm:text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
          >
            <option value="beginning_of_year" selected>
              ⭐ Beginning of Financial Year (On or before April 5) — Highest Interest Returns
            </option>
            <option value="end_of_year">
              End of Financial Year (Deposited at Year End) — Conservative Estimate
            </option>
            <option value="monthly_before_5th">
              Monthly Contribution (On or before 5th of every month)
            </option>
            <option value="monthly_after_5th">
              Monthly Contribution (Deposited after 5th of every month)
            </option>
          </select>
          <p id="hint-timing-desc" class="text-[11px] text-slate-500 dark:text-slate-400 pt-1">
            Depositing between April 1 and April 5 earns compounding interest for all 12 months in the financial year.
          </p>
        </div>

        <!-- Advanced Mode Only: Existing Balance & Partial Withdrawal -->
        <div id="row-adv-options" class="hidden rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/60 space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>⚙️</span> Ongoing Account &amp; Partial Withdrawal Parameters
          </span>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="inp-existing-bal" class="block text-xs font-semibold text-slate-600 dark:text-slate-400">
                Current Existing PPF Balance (Optional)
              </label>
              <div class="relative mt-1">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-bold text-slate-400">₹</span>
                <input
                  type="number"
                  id="inp-existing-bal"
                  value="0"
                  step="1000"
                  min="0"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2 pl-7 text-xs sm:text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  placeholder="0"
                />
              </div>
              <span class="text-[10px] text-slate-400">If continuing an active account from past years</span>
            </div>

            <div>
              <label for="inp-withdrawal-amt" class="block text-xs font-semibold text-slate-600 dark:text-slate-400">
                Planned Partial Withdrawal (Optional)
              </label>
              <div class="flex items-center gap-2 mt-1">
                <div class="relative flex-1">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-bold text-slate-400">₹</span>
                  <input
                    type="number"
                    id="inp-withdrawal-amt"
                    value="0"
                    step="5000"
                    min="0"
                    class="w-full rounded-xl border border-slate-300 bg-white p-2 pl-7 text-xs sm:text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                    placeholder="0"
                  />
                </div>
                <select
                  id="sel-withdrawal-year"
                  class="w-32 rounded-xl border border-slate-300 bg-white p-2 text-xs font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"
                >
                  <option value="7">In Year 7</option>
                  <option value="8">In Year 8</option>
                  <option value="9">In Year 9</option>
                  <option value="10">In Year 10</option>
                  <option value="12">In Year 12</option>
                </select>
              </div>
              <span class="text-[10px] text-slate-400">PPF permits 1 partial withdrawal per FY starting from Year 7</span>
            </div>
          </div>
        </div>

        <!-- Submit & Clear Buttons -->
        <div class="flex items-center gap-2 pt-2">
          <button
            type="submit"
            id="btn-calc-ppf"
            class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer"
          >
            Calculate PPF Maturity →
          </button>
          <button
            type="button"
            id="btn-clear-ppf"
            class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
          >
            Reset (✕)
          </button>
        </div>

        <!-- Error Notification Banner -->
        <p
          id="err-ppf"
          class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300"
          role="alert"
          aria-live="polite"
        ></p>

      </form>

      <!-- RESULTS SECTION (Displayed on Demand) -->
      <div id="ppf-results-section" class="hidden mt-6 space-y-6">

        <!-- Highlight Card: Maturity & Multiplier -->
        <div class="overflow-hidden rounded-3xl border border-emerald-200 bg-linear-to-br from-white via-emerald-50/40 to-emerald-100/50 p-5 shadow-lg shadow-emerald-500/5 dark:border-emerald-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-emerald-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-emerald-200/80 pb-4 dark:border-slate-800">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">
                Estimated PPF Maturity Amount (Tax-Free)
              </span>
              <div id="res-maturity-amt" class="mt-1 text-3xl sm:text-5xl font-black text-emerald-600 dark:text-emerald-400">
                ₹ 2,71,214
              </div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Wealth Multiplier:
              </span>
              <div id="res-wealth-multiplier" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
                1.81x
              </div>
              <span class="text-[10px] text-slate-400">EEE Tax Exempt Status</span>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Investment</div>
              <div id="res-total-invested" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">₹ 1,50,000</div>
            </div>
            <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Interest Earned</div>
              <div id="res-total-interest" class="mt-1 text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400">₹ 1,21,214</div>
            </div>
            <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Duration Period</div>
              <div id="res-tenure-display" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">15 Years</div>
            </div>
            <div class="rounded-xl border border-emerald-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Assumed Rate &amp; Timing</div>
              <div id="res-rate-display" class="mt-1 text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400">7.1% p.a.</div>
            </div>
          </div>
        </div>

        <!-- VISUAL SPLIT & INTERACTIVE TIMELINE CHARTS -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

          <!-- DONUT SPLIT CHART -->
          <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-4">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>📊</span> Capital vs Interest Split
            </h3>

            <div class="relative w-40 h-40 mx-auto flex items-center justify-center">
              <svg viewBox="0 0 36 36" class="w-full h-full transform -rotate-90">
                <!-- Invested Circle (Blue) -->
                <circle cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="4"></circle>
                <!-- Interest Circle (Emerald) -->
                <circle id="svg-donut-interest" cx="18" cy="18" r="15.91549430918954" fill="transparent" stroke="#10b981" stroke-width="4" stroke-dasharray="44.7 55.3" stroke-dashoffset="0"></circle>
              </svg>
              <div class="absolute text-center">
                <span class="text-[10px] font-bold text-slate-400 block uppercase">Returns</span>
                <span id="donut-center-pct" class="text-sm font-black text-emerald-600 dark:text-emerald-400">44.7%</span>
              </div>
            </div>

            <div class="space-y-2 text-xs pt-1">
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-blue-50/60 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/40">
                <span class="flex items-center gap-2 font-bold text-blue-700 dark:text-blue-300">
                  <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span> Total Invested:
                </span>
                <span id="txt-legend-invested" class="font-bold text-slate-900 dark:text-white font-mono">₹ 1,50,000 (55.3%)</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-emerald-50/60 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40">
                <span class="flex items-center gap-2 font-bold text-emerald-700 dark:text-emerald-300">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> Interest Earned:
                </span>
                <span id="txt-legend-interest" class="font-bold text-slate-900 dark:text-white font-mono">₹ 1,21,214 (44.7%)</span>
              </div>
            </div>
          </div>

          <!-- INTERACTIVE TIMELINE WEALTH GROWTH (SVG) -->
          <div class="lg:col-span-2 rounded-3xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 border-b border-slate-100 pb-2 dark:border-slate-800">
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>📈</span> PPF Wealth Accumulation Timeline
              </h3>
              <span class="text-[11px] text-slate-400">Hover over points to inspect year-by-year corpus</span>
            </div>

            <!-- SVG Container with dynamic tooltips -->
            <div class="relative w-full overflow-hidden">
              <svg id="svg-ppf-chart" viewBox="0 0 700 280" class="w-full h-56 sm:h-64 select-none cursor-crosshair">
                <!-- Dynamically populated -->
              </svg>

              <!-- Floating Tooltip Box -->
              <div id="chart-tooltip" class="hidden pointer-events-none absolute z-20 rounded-xl border border-slate-700 bg-slate-900/95 p-2.5 text-xs text-white shadow-xl backdrop-blur-xs transition-all space-y-1">
                <!-- Injected by JavaScript -->
              </div>
            </div>

            <!-- Graph Legends -->
            <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-600 dark:text-slate-400 pt-1">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-0.5 bg-blue-500 inline-block rounded-full"></span>
                <span>Cumulative Invested Capital</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-0.5 bg-emerald-500 inline-block rounded-full"></span>
                <span>Total PPF Corpus (Maturity Value)</span>
              </div>
            </div>
          </div>

        </div>

        <!-- DETAILED YEAR-WISE SCHEDULE TABLE & PDF EXPORT -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-3 dark:border-slate-800">
            <div>
              <h3 class="text-xs sm:text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                <span>📅</span> Year-Wise PPF Growth Schedule
              </h3>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">
                Opening Balance + Deposit + Interest - Withdrawal = Closing Balance
              </p>
            </div>
            <button
              type="button"
              id="btn-download-pdf"
