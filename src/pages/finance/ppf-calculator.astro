</CalculatorLayout>

<script>
  import { calculatePpf, formatPpfINR, type PpfDepositTiming, type PpfContributionMode, type PpfCalculationResult } from '../../lib/calculators/ppf';

  // Mode Tabs
  const tabBtnSimple = document.getElementById('tab-btn-simple') as HTMLButtonElement;
  const tabBtnAdvanced = document.getElementById('tab-btn-advanced') as HTMLButtonElement;
  const rowAdvFreq = document.getElementById('row-adv-freq') as HTMLDivElement;
  const rowAdvOptions = document.getElementById('row-adv-options') as HTMLDivElement;
  const ppfPanelTitle = document.getElementById('ppf-panel-title') as HTMLHeadingElement;
  const ppfPanelDesc = document.getElementById('ppf-panel-desc') as HTMLParagraphElement;

  // Form Inputs
  const formPpf = document.getElementById('form-ppf') as HTMLFormElement;
  const lblInvestmentAmt = document.getElementById('lbl-investment-amt') as HTMLLabelElement;
  const inpInvestmentAmt = document.getElementById('inp-investment-amt') as HTMLInputElement;
  const selTenureYears = document.getElementById('sel-tenure-years') as HTMLSelectElement;
  const inpInterestRate = document.getElementById('inp-interest-rate') as HTMLInputElement;
  const selDepositTiming = document.getElementById('sel-deposit-timing') as HTMLSelectElement;
  const hintTimingDesc = document.getElementById('hint-timing-desc') as HTMLParagraphElement;

  // Advanced Inputs
  const btnFreqYearly = document.getElementById('btn-freq-yearly') as HTMLButtonElement;
  const btnFreqMonthly = document.getElementById('btn-freq-monthly') as HTMLButtonElement;
  const inpExistingBal = document.getElementById('inp-existing-bal') as HTMLInputElement;
  const inpWithdrawalAmt = document.getElementById('inp-withdrawal-amt') as HTMLInputElement;
  const selWithdrawalYear = document.getElementById('sel-withdrawal-year') as HTMLSelectElement;

  // Actions & Alerts
  const btnCalcPpf = document.getElementById('btn-calc-ppf') as HTMLButtonElement;
  const btnClearPpf = document.getElementById('btn-clear-ppf') as HTMLButtonElement;
  const errPpf = document.getElementById('err-ppf') as HTMLParagraphElement;

  // Result Section Elements
  const ppfResultsSection = document.getElementById('ppf-results-section') as HTMLDivElement;
  const resMaturityAmt = document.getElementById('res-maturity-amt') as HTMLDivElement;
  const resWealthMultiplier = document.getElementById('res-wealth-multiplier') as HTMLDivElement;
  const resTotalInvested = document.getElementById('res-total-invested') as HTMLDivElement;
  const resTotalInterest = document.getElementById('res-total-interest') as HTMLDivElement;
  const resTenureDisplay = document.getElementById('res-tenure-display') as HTMLDivElement;
  const resRateDisplay = document.getElementById('res-rate-display') as HTMLDivElement;

  // Donut & Chart Elements
  const svgDonutInterest = document.getElementById('svg-donut-interest') as unknown as SVGCircleElement;
  const donutCenterPct = document.getElementById('donut-center-pct') as HTMLSpanElement;
  const txtLegendInvested = document.getElementById('txt-legend-invested') as HTMLSpanElement;
  const txtLegendInterest = document.getElementById('txt-legend-interest') as HTMLSpanElement;

  const svgPpfChart = document.getElementById('svg-ppf-chart') as unknown as SVGSVGElement;
  const chartTooltip = document.getElementById('chart-tooltip') as HTMLDivElement;
  const tbodyPpfSchedule = document.getElementById('tbody-ppf-schedule') as HTMLTableSectionElement;
  const btnDownloadPdf = document.getElementById('btn-download-pdf') as HTMLButtonElement;

  let activeMode: 'simple' | 'advanced' = 'simple';
  let contributionMode: PpfContributionMode = 'yearly';
  let latestResult: PpfCalculationResult | null = null;

  // Mode Switch Handler
  function switchMode(mode: 'simple' | 'advanced') {
    activeMode = mode;
    if (mode === 'simple') {
      tabBtnSimple.className = 'btn-ppf-tab active shrink-0 rounded-lg bg-blue-600 px-4 py-1.5 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5';
      tabBtnAdvanced.className = 'btn-ppf-tab shrink-0 rounded-lg border border-slate-300 bg-white px-4 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5';
      rowAdvFreq.classList.add('hidden');
      rowAdvOptions.classList.add('hidden');
      ppfPanelTitle.innerHTML = '<span>🌱</span> Simple Public Provident Fund (PPF) Calculator';
      ppfPanelDesc.textContent = 'Calculate interest and projected maturity wealth under Indian PPF guidelines with standard yearly or monthly deposit timing assumptions.';
      setContributionFrequency('yearly');
    } else {
      tabBtnAdvanced.className = 'btn-ppf-tab active shrink-0 rounded-lg bg-blue-600 px-4 py-1.5 font-bold text-white shadow-xs cursor-pointer transition flex items-center gap-1.5';
      tabBtnSimple.className = 'btn-ppf-tab shrink-0 rounded-lg border border-slate-300 bg-white px-4 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition flex items-center gap-1.5';
      rowAdvFreq.classList.remove('hidden');
      rowAdvOptions.classList.remove('hidden');
      ppfPanelTitle.innerHTML = '<span>⚙️</span> Advanced PPF Calculator (Extensions &amp; Partial Withdrawals)';
      ppfPanelDesc.textContent = 'Model ongoing accounts with existing balances, 5-year block extensions, monthly SIP contributions, and planned partial withdrawals.';
    }
    handleInputChanged();
  }

  tabBtnSimple.addEventListener('click', () => switchMode('simple'));
  tabBtnAdvanced.addEventListener('click', () => switchMode('advanced'));

  // Frequency Toggle (Yearly vs Monthly)
  function setContributionFrequency(freq: PpfContributionMode) {
    contributionMode = freq;
    if (freq === 'yearly') {
      btnFreqYearly.className = 'btn-freq-toggle active rounded-xl bg-blue-600 py-2 text-xs font-bold text-white transition cursor-pointer';
      btnFreqMonthly.className = 'btn-freq-toggle rounded-xl border border-slate-300 bg-white py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer';
      lblInvestmentAmt.textContent = 'Yearly Investment (₹)';
      if (parseFloat(inpInvestmentAmt.value) <= 12500) {
        inpInvestmentAmt.value = '10000';
      }
      inpInvestmentAmt.max = '150000';
      if (selDepositTiming.value.startsWith('monthly')) {
        selDepositTiming.value = 'beginning_of_year';
      }
    } else {
      btnFreqMonthly.className = 'btn-freq-toggle active rounded-xl bg-blue-600 py-2 text-xs font-bold text-white transition cursor-pointer';
      btnFreqYearly.className = 'btn-freq-toggle rounded-xl border border-slate-300 bg-white py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer';
      lblInvestmentAmt.textContent = 'Monthly Investment (₹)';
      if (parseFloat(inpInvestmentAmt.value) > 12500) {
        inpInvestmentAmt.value = '5000';
      }
      inpInvestmentAmt.max = '12500';
      if (!selDepositTiming.value.startsWith('monthly')) {
        selDepositTiming.value = 'monthly_before_5th';
      }
    }
    updateTimingDescription();
    handleInputChanged();
  }

  btnFreqYearly.addEventListener('click', () => setContributionFrequency('yearly'));
  btnFreqMonthly.addEventListener('click', () => setContributionFrequency('monthly'));

  // Timing description updater
  function updateTimingDescription() {
    const val = selDepositTiming.value;
    if (val === 'beginning_of_year') {
      hintTimingDesc.textContent = 'Depositing between April 1 and April 5 earns compounding interest for all 12 months in the financial year.';
    } else if (val === 'end_of_year') {
      hintTimingDesc.textContent = 'Depositing at year-end provides 0 interest on that deposit during the current year; only previous balance earns interest.';
    } else if (val === 'monthly_before_5th') {
      hintTimingDesc.textContent = 'Depositing on or before 5th of each month qualifies that installment for interest in that calendar month.';
    } else {
      hintTimingDesc.textContent = 'Depositing after the 5th earns interest starting from the following calendar month.';
    }
  }

  selDepositTiming.addEventListener('change', () => {
    updateTimingDescription();
    handleInputChanged();
  });

  // Presets Handlers
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const amt = btn.getAttribute('data-amt');
      const years = btn.getAttribute('data-years');
      const timing = btn.getAttribute('data-timing');
      if (amt) inpInvestmentAmt.value = amt;
      if (years) selTenureYears.value = years;
      if (timing) {
        selDepositTiming.value = timing;
        updateTimingDescription();
      }
      setContributionFrequency('yearly');
      executeCalculation();
    });
  });

  // Quick Amount Buttons
  document.querySelectorAll('.btn-amt-quick').forEach((btn) => {
    btn.addEventListener('click', () => {
      const amt = btn.getAttribute('data-amt');
      if (amt) {
        inpInvestmentAmt.value = amt;
        handleInputChanged();
      }
    });
  });

  function handleInputChanged() {
    errPpf.classList.add('hidden');
    // Live update chart preview if results already rendered
    if (latestResult && !ppfResultsSection.classList.contains('hidden')) {
      renderLivePpfGraph();
    }
  }

  inpInvestmentAmt.addEventListener('input', handleInputChanged);
  selTenureYears.addEventListener('change', handleInputChanged);
  inpInterestRate.addEventListener('input', handleInputChanged);
  inpExistingBal?.addEventListener('input', handleInputChanged);
  inpWithdrawalAmt?.addEventListener('input', handleInputChanged);
  selWithdrawalYear?.addEventListener('change', handleInputChanged);

  // Core Execution Function
  function executeCalculation() {
    errPpf.classList.add('hidden');

    const amt = parseFloat(inpInvestmentAmt.value);
    const tenure = parseInt(selTenureYears.value, 10) || 15;
    const rate = parseFloat(inpInterestRate.value);
    const timing = selDepositTiming.value as PpfDepositTiming;

    const existingBal = activeMode === 'advanced' ? (parseFloat(inpExistingBal.value) || 0) : 0;
    const withdrawalAmt = activeMode === 'advanced' ? (parseFloat(inpWithdrawalAmt.value) || 0) : 0;
    const withdrawalYear = activeMode === 'advanced' ? parseInt(selWithdrawalYear.value, 10) : 7;

    // Validation
    if (isNaN(amt) || amt < 500) {
      errPpf.textContent = 'Minimum deposit in PPF is ₹500 per year.';
      errPpf.classList.remove('hidden');
      return;
    }

    if (contributionMode === 'yearly' && amt > 150000) {
      errPpf.textContent = 'Maximum allowable PPF investment is ₹1,50,000 per financial year.';
      errPpf.classList.remove('hidden');
      return;
    }

    if (contributionMode === 'monthly' && amt > 12500) {
      errPpf.textContent = 'Monthly PPF deposit cannot exceed ₹12,500 (annual cap of ₹1,50,000).';
      errPpf.classList.remove('hidden');
      return;
    }

    if (isNaN(rate) || rate <= 0 || rate > 25) {
      errPpf.textContent = 'Please enter a valid assumed annual interest rate (e.g. 7.1%).';
      errPpf.classList.remove('hidden');
      return;
    }

    const res = calculatePpf({
      contributionMode,
      yearlyInvestment: contributionMode === 'yearly' ? amt : undefined,
      monthlyInvestment: contributionMode === 'monthly' ? amt : undefined,
      tenureYears: tenure,
      annualInterestRate: rate,
      depositTiming: timing,
      existingBalance: existingBal,
      partialWithdrawal: withdrawalAmt > 0 ? { afterYear: withdrawalYear, amount: withdrawalAmt } : undefined,
    });

    latestResult = res;

    // Populate Metrics
    resMaturityAmt.textContent = formatPpfINR(res.maturityAmount);
    resWealthMultiplier.textContent = `${res.wealthGainMultiplier.toFixed(2)}x`;
    resTotalInvested.textContent = formatPpfINR(res.totalInvestment);
    resTotalInterest.textContent = formatPpfINR(res.totalInterestEarned);
    resTenureDisplay.textContent = `${res.tenureYears} Years`;
    resRateDisplay.textContent = `${res.annualInterestRate}% p.a.`;

    // Update Donut Split
    const interestPct = res.interestPercentage;
    const investedPct = res.investedPercentage;
    svgDonutInterest.setAttribute('stroke-dasharray', `${interestPct.toFixed(1)} ${investedPct.toFixed(1)}`);
    donutCenterPct.textContent = `${interestPct.toFixed(1)}%`;
    txtLegendInvested.textContent = `${formatPpfINR(res.totalInvestment - res.totalWithdrawals)} (${investedPct.toFixed(1)}%)`;
    txtLegendInterest.textContent = `${formatPpfINR(res.totalInterestEarned)} (${interestPct.toFixed(1)}%)`;

    // Populate Year-Wise Schedule Table
    tbodyPpfSchedule.innerHTML = res.schedule.map((item) => `
      <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
        <td class="p-2.5 font-bold text-slate-800 dark:text-slate-200">Year ${item.year}</td>
        <td class="p-2.5 text-right">${formatPpfINR(item.openingBalance)}</td>
        <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-semibold">${formatPpfINR(item.deposit)}</td>
        <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-semibold">+${formatPpfINR(item.interestEarned)}</td>
        <td class="p-2.5 text-right text-amber-600 dark:text-amber-400">${item.withdrawal > 0 ? '-' + formatPpfINR(item.withdrawal) : '₹ 0'}</td>
        <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatPpfINR(item.closingBalance)}</td>
      </tr>
    `).join('');

    // Render Timeline Graph
    renderLivePpfGraph();

    // Reveal results and scroll smoothly
    ppfResultsSection.classList.remove('hidden');
    ppfResultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Form Submit Listener
  formPpf.addEventListener('submit', (e) => {
    e.preventDefault();
    executeCalculation();
  });

  btnClearPpf.addEventListener('click', () => {
    inpInvestmentAmt.value = '10000';
    selTenureYears.value = '15';
    inpInterestRate.value = '7.1';
    selDepositTiming.value = 'beginning_of_year';
    if (inpExistingBal) inpExistingBal.value = '0';
    if (inpWithdrawalAmt) inpWithdrawalAmt.value = '0';
    ppfResultsSection.classList.add('hidden');
    errPpf.classList.add('hidden');
    latestResult = null;
  });

  // SVG Timeline Growth Chart
  interface PpfChartPoint {
    year: number;
    invested: number;
    closing: number;
    interest: number;
    x: number;
    yInvested: number;
    yClosing: number;
  }

  let chartPoints: PpfChartPoint[] = [];

  function renderLivePpfGraph() {
    if (!latestResult) return;

    const schedule = latestResult.schedule;
    const maxVal = Math.max(...schedule.map((s) => s.closingBalance)) * 1.12;
    const minVal = 0;

    const W = 700;
    const H = 280;
    const padL = 70;
    const padR = 40;
    const padT = 30;
    const padB = 40;
    const chartW = W - padL - padR;
    const chartH = H - padT - padB;

    const getX = (year: number) => {
      const progress = (year - 1) / (schedule.length - 1);
      return padL + progress * chartW;
    };

    const getY = (val: number) => {
      const ratio = Math.min(1, Math.max(0, (val - minVal) / (maxVal - minVal)));
      return padT + chartH - ratio * chartH;
    };

    chartPoints = schedule.map((item) => ({
      year: item.year,
      invested: item.cumulativeInvestment,
      closing: item.closingBalance,
      interest: item.cumulativeInterest,
      x: getX(item.year),
      yInvested: getY(item.cumulativeInvestment),
      yClosing: getY(item.closingBalance),
    }));

    // Area & Line paths for Closing Balance (Emerald)
    let closingAreaD = `M ${chartPoints[0].x} ${padT + chartH} L ${chartPoints[0].x} ${chartPoints[0].yClosing}`;
    let closingLineD = `M ${chartPoints[0].x} ${chartPoints[0].yClosing}`;

    // Area & Line paths for Cumulative Investment (Blue)
    let investedAreaD = `M ${chartPoints[0].x} ${padT + chartH} L ${chartPoints[0].x} ${chartPoints[0].yInvested}`;
    let investedLineD = `M ${chartPoints[0].x} ${chartPoints[0].yInvested}`;

    for (let i = 1; i < chartPoints.length; i++) {
      closingAreaD += ` L ${chartPoints[i].x} ${chartPoints[i].yClosing}`;
      closingLineD += ` L ${chartPoints[i].x} ${chartPoints[i].yClosing}`;
      investedAreaD += ` L ${chartPoints[i].x} ${chartPoints[i].yInvested}`;
      investedLineD += ` L ${chartPoints[i].x} ${chartPoints[i].yInvested}`;
    }

    closingAreaD += ` L ${chartPoints[chartPoints.length - 1].x} ${padT + chartH} Z`;
    investedAreaD += ` L ${chartPoints[chartPoints.length - 1].x} ${padT + chartH} Z`;

    // 4 Horizontal Grid Lines
    let gridLinesSvg = '';
    for (let i = 0; i <= 4; i++) {
      const val = (maxVal / 4) * i;
      const y = getY(val);
      gridLinesSvg += `
        <line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="currentColor" class="text-slate-100 dark:text-slate-800/80" stroke-width="1" stroke-dasharray="3 3"></line>
        <text x="${padL - 8}" y="${y + 3}" fill="#94a3b8" font-size="9" font-weight="600" text-anchor="end">${formatPpfINR(val)}</text>
      `;
    }

    // X Axis Labels (Every 3-5 years)
    let xLabelsSvg = '';
    const step = schedule.length > 20 ? 5 : schedule.length > 10 ? 3 : 1;
    for (let i = 0; i < schedule.length; i += step) {
      const pt = chartPoints[i];
      xLabelsSvg += `
        <text x="${pt.x}" y="${H - 12}" fill="#64748b" font-size="9" font-weight="700" text-anchor="middle">Yr ${pt.year}</text>
      `;
    }
    // Ensure final year label
    const lastPt = chartPoints[chartPoints.length - 1];
    xLabelsSvg += `
      <text x="${lastPt.x}" y="${H - 12}" fill="#10b981" font-size="10" font-weight="900" text-anchor="middle">Yr ${lastPt.year}</text>
    `;

    // Dots on curves
    const dotsSvg = chartPoints.map((p) => `
      <circle cx="${p.x}" cy="${p.yClosing}" r="3.5" fill="#10b981" stroke="#ffffff" stroke-width="1.5"></circle>
      <circle cx="${p.x}" cy="${p.yInvested}" r="3" fill="#3b82f6" stroke="#ffffff" stroke-width="1"></circle>
    `).join('');

    svgPpfChart.innerHTML = `
      <defs>
        <linearGradient id="ppfGreenGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#10b981" stop-opacity="0.3"></stop>
          <stop offset="100%" stop-color="#10b981" stop-opacity="0.02"></stop>
        </linearGradient>
        <linearGradient id="ppfBlueGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.2"></stop>
          <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.01"></stop>
        </linearGradient>
      </defs>
      ${gridLinesSvg}
      <path d="${closingAreaD}" fill="url(#ppfGreenGrad)"></path>
      <path d="${investedAreaD}" fill="url(#ppfBlueGrad)"></path>
      <path d="${closingLineD}" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="${investedLineD}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-dasharray="4 2" stroke-linecap="round"></path>
      ${dotsSvg}
      ${xLabelsSvg}
      <line id="ppf-hover-line" x1="0" y1="${padT}" x2="0" y2="${padT + chartH}" stroke="#64748b" stroke-width="1" stroke-dasharray="2 2" class="hidden"></line>
    `;
  }

  // Interactive Hover Tooltips on Chart
  svgPpfChart.addEventListener('mousemove', (e) => {
    if (chartPoints.length === 0) return;

    const rect = svgPpfChart.getBoundingClientRect();
    const svgX = ((e.clientX - rect.left) / rect.width) * 700;

    // Find closest year point
    let closest = chartPoints[0];
    let minDist = Math.abs(chartPoints[0].x - svgX);

    for (let i = 1; i < chartPoints.length; i++) {
      const dist = Math.abs(chartPoints[i].x - svgX);
      if (dist < minDist) {
        minDist = dist;
        closest = chartPoints[i];
      }
    }

    const hoverLine = document.getElementById('ppf-hover-line');
    if (hoverLine) {
      hoverLine.setAttribute('x1', String(closest.x));
      hoverLine.setAttribute('x2', String(closest.x));
      hoverLine.classList.remove('hidden');
    }

    // Position and content
    const tooltipX = (closest.x / 700) * rect.width;
    const tooltipY = Math.max(10, (closest.yClosing / 280) * rect.height - 85);

    chartTooltip.style.left = `${Math.min(rect.width - 160, Math.max(10, tooltipX - 70))}px`;
    chartTooltip.style.top = `${tooltipY}px`;
    chartTooltip.innerHTML = `
      <div class="font-bold text-slate-300">Year ${closest.year} Summary</div>
      <div class="font-black text-emerald-400">Total Corpus: ${formatPpfINR(closest.closing)}</div>
      <div class="text-[10px] text-blue-300">Cumulative Invested: ${formatPpfINR(closest.invested)}</div>
      <div class="text-[10px] text-slate-400">Total Interest to Date: ${formatPpfINR(closest.interest)}</div>
    `;
    chartTooltip.classList.remove('hidden');
  });

  svgPpfChart.addEventListener('mouseleave', () => {
    chartTooltip.classList.add('hidden');
    const hoverLine = document.getElementById('ppf-hover-line');
    if (hoverLine) hoverLine.classList.add('hidden');
  });

  // PDF Download Handler
  btnDownloadPdf.addEventListener('click', () => {
    window.print();
  });

  // Initial Calculation on Page Load
  executeCalculation();
</script>

