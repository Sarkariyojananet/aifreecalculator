<script is:inline>
  const cryptoTabs = document.querySelectorAll('.btn-crypto-tab');
  const cryptoPanels = document.querySelectorAll('.crypto-panel');
  const cryptoResults = document.getElementById('crypto-results');

  cryptoTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      cryptoTabs.forEach(t => { t.classList.remove('bg-orange-500','text-white','shadow-xs'); t.classList.add('border','border-slate-300','bg-white','text-slate-700','dark:border-slate-700','dark:bg-slate-800','dark:text-slate-200'); });
      tab.classList.add('bg-orange-500','text-white','shadow-xs');
      tab.classList.remove('border','border-slate-300','bg-white','text-slate-700');
      cryptoPanels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');
      cryptoResults?.classList.add('hidden');
    });
  });

  document.querySelectorAll('.btn-crypto-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('c-coin').value = btn.dataset.coin;
      document.getElementById('c-buy').value = btn.dataset.buy;
      document.getElementById('c-sell').value = btn.dataset.sell;
      document.getElementById('c-qty').value = btn.dataset.qty;
    });
  });

  function fmtCrypto(n) { return (n >= 0 ? '+' : '') + '₹' + Math.round(Math.abs(n)).toLocaleString('en-IN') + (n < 0 ? ' (Loss)' : ''); }
  function fmtVal(n) { return '₹' + Math.round(n).toLocaleString('en-IN'); }

  function showCryptoResults(badge, profit, roi, buyVal, sellVal, tax, tds) {
    document.getElementById('crypto-badge').textContent = badge;
    document.getElementById('crypto-res-profit').textContent = fmtCrypto(profit);
    document.getElementById('crypto-res-profit').className = 'mt-1 text-4xl sm:text-5xl font-black ' + (profit >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400');
    document.getElementById('crypto-res-roi').textContent = (roi >= 0 ? '+' : '') + roi.toFixed(2) + '%';
    document.getElementById('crypto-res-buy').textContent = fmtVal(buyVal);
    document.getElementById('crypto-res-sell').textContent = fmtVal(sellVal);
    document.getElementById('crypto-res-tax').textContent = fmtVal(tax || 0);
    document.getElementById('crypto-res-tds').textContent = fmtVal(tds || 0);
    cryptoResults.classList.remove('hidden');
    cryptoResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('form-crypto-pnl')?.addEventListener('submit', () => {
    const qty = parseFloat(document.getElementById('c-qty').value);
    const buy = parseFloat(document.getElementById('c-buy').value);
    const sell = parseFloat(document.getElementById('c-sell').value);
    const indTax = document.getElementById('indian-tax').checked;

    const buyVal = qty * buy;
    const sellVal = qty * sell;
    const grossProfit = sellVal - buyVal;
    let tax = 0, tds = 0;
    if (indTax && grossProfit > 0) {
      tax = grossProfit * 0.312; // 30% + 4% cess
      tds = sellVal * 0.01;
    }
    const netProfit = grossProfit - tax;
    const roi = (netProfit / buyVal) * 100;
    showCryptoResults(indTax ? 'Net Profit (After Indian Tax)' : 'Gross Profit / Loss', netProfit, roi, buyVal, sellVal, tax, tds);
  });
  document.getElementById('btn-pnl-clear')?.addEventListener('click', () => cryptoResults?.classList.add('hidden'));

  document.getElementById('btn-add-entry')?.addEventListener('click', () => {
    const n = document.querySelectorAll('.avg-entry').length + 1;
    const div = document.createElement('div');
    div.className = 'avg-entry grid grid-cols-2 gap-3';
    div.innerHTML = `<div><label class="text-xs font-bold text-slate-600 dark:text-slate-400 block">Buy Price (Entry ${n})</label><input type="number" class="avg-price mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" step="any" /></div><div><label class="text-xs font-bold text-slate-600 dark:text-slate-400 block">Quantity (Entry ${n})</label><input type="number" class="avg-qty mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" step="any" /></div>`;
    document.getElementById('avg-entries').appendChild(div);
  });

  document.getElementById('form-avg')?.addEventListener('submit', () => {
    const prices = Array.from(document.querySelectorAll('.avg-price')).map(el => parseFloat(el.value));
    const qtys = Array.from(document.querySelectorAll('.avg-qty')).map(el => parseFloat(el.value));
    let totalInvested = 0, totalCoins = 0;
    for (let i = 0; i < prices.length; i++) {
      if (prices[i] && qtys[i]) { totalInvested += prices[i] * qtys[i]; totalCoins += qtys[i]; }
    }
    const avgPrice = totalInvested / totalCoins;
    document.getElementById('crypto-badge').textContent = '📊 Your Average Buy Price';
    document.getElementById('crypto-res-profit').textContent = '₹' + avgPrice.toLocaleString('en-IN', { maximumFractionDigits: 2 });
    document.getElementById('crypto-res-profit').className = 'mt-1 text-4xl sm:text-5xl font-black text-orange-500 dark:text-orange-400';
    document.getElementById('crypto-res-roi').textContent = totalCoins.toFixed(6) + ' coins total';
    document.getElementById('crypto-res-buy').textContent = '₹' + Math.round(totalInvested).toLocaleString('en-IN');
    document.getElementById('crypto-res-sell').textContent = totalPrices ? 'N/A' : 'N/A';
    document.getElementById('crypto-res-tax').textContent = 'Breakeven';
    document.getElementById('crypto-res-tds').textContent = 'avg ₹' + Math.round(avgPrice).toLocaleString('en-IN');
    cryptoResults.classList.remove('hidden');
  });
  document.getElementById('btn-avg-clear')?.addEventListener('click', () => cryptoResults?.classList.add('hidden'));

  document.getElementById('form-target')?.addEventListener('submit', () => {
    const buy = parseFloat(document.getElementById('tgt-buy').value);
    const pct = parseFloat(document.getElementById('tgt-pct').value);
    const incTax = document.getElementById('tgt-indian-tax').checked;
    let requiredGrossPct = pct;
    if (incTax) { requiredGrossPct = pct / (1 - 0.312); } // reverse calculate: needed gross profit to net X% after 31.2% tax
    const targetPrice = buy * (1 + requiredGrossPct / 100);
    const grossProfit = targetPrice - buy;
    const tax = incTax ? grossProfit * 0.312 : 0;
    const netProfit = grossProfit - tax;
    showCryptoResults('🎯 Target Sell Price for ' + pct + '% Net Profit', netProfit, pct, buy, targetPrice, tax, 0);
    document.getElementById('crypto-res-sell').textContent = '₹' + targetPrice.toLocaleString('en-IN', { maximumFractionDigits: 2 });
  });
  document.getElementById('btn-target-clear')?.addEventListener('click', () => cryptoResults?.classList.add('hidden'));

  document.getElementById('form-tax-crypto')?.addEventListener('submit', () => {
    const buyVal = parseFloat(document.getElementById('itax-buy-val').value);
    const sellVal = parseFloat(document.getElementById('itax-sell-val').value);
    const grossProfit = sellVal - buyVal;
    const tax = grossProfit > 0 ? grossProfit * 0.312 : 0;
    const tds = sellVal * 0.01;
    const netProfit = grossProfit - tax;
    showCryptoResults('🇮🇳 Net Crypto Income After Indian Tax', netProfit, (netProfit / buyVal) * 100, buyVal, sellVal, tax, tds);
  });
  document.getElementById('btn-tax-crypto-clear')?.addEventListener('click', () => cryptoResults?.classList.add('hidden'));
</script>

