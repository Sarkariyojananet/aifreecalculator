<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // State
  let currentRegion = 'india'; // 'india' | 'us_federal' | 'us_california' | 'us_texas'
  let lastTaxResult = null; // Single result or comparison result

  // DOM Elements
  const regionTabs = document.querySelectorAll('.btn-region-tab');
  const taxPanelTitle = document.getElementById('tax-panel-title');
  const taxPanelDesc = document.getElementById('tax-panel-desc');

  const colAySelect = document.getElementById('col-ay-select');
  const colRegimeSelect = document.getElementById('col-regime-select');
  const colFilingStatus = document.getElementById('col-filing-status');

  const selAy = document.getElementById('sel-ay');
  const selRegime = document.getElementById('sel-regime');
  const selFilingStatus = document.getElementById('sel-filing-status');

  const gridIndiaIncome = document.getElementById('grid-india-income');
  const gridUsIncome = document.getElementById('grid-us-income');
  const boxIndiaDeductions = document.getElementById('box-india-deductions');

  const inpSalary = document.getElementById('inp-salary');
  const inpHouseProp = document.getElementById('inp-house-prop');
  const inpOtherInc = document.getElementById('inp-other-inc');

  const inpUsGross = document.getElementById('inp-us-gross');
  const inpUsItemized = document.getElementById('inp-us-itemized');

  const inp80c = document.getElementById('inp-80c');
  const inp80d = document.getElementById('inp-80d');
  const inp24b = document.getElementById('inp-24b');
  const inpHra = document.getElementById('inp-hra');

  const btnCalcTax = document.getElementById('btn-calc-tax');
  const btnClearTax = document.getElementById('btn-clear-tax');
  const errTax = document.getElementById('err-tax');

  // Results Elements
  const taxResultsSection = document.getElementById('tax-results-section');
  const cardSingleResult = document.getElementById('card-single-result');
  const resBadgeLabel = document.getElementById('res-badge-label');
  const resTotalTax = document.getElementById('res-total-tax');
  const resEffectiveRate = document.getElementById('res-effective-rate');
  const resGrossIncome = document.getElementById('res-gross-income');
  const resTotalDeduct = document.getElementById('res-total-deduct');
  const resTaxableIncome = document.getElementById('res-taxable-income');
  const resNetTakehome = document.getElementById('res-net-takehome');

  const cardComparisonResult = document.getElementById('card-comparison-result');
  const txtComparisonRec = document.getElementById('txt-comparison-recommendation');
  const cmpTbody = document.getElementById('cmp-tbody');

  const slabTbody = document.getElementById('slab-tbody');
  const btnExportExcel = document.getElementById('btn-export-excel');
  const btnTaxDownloadPdf = document.getElementById('btn-tax-download-pdf');
  const txtBtnTaxPdf = document.getElementById('txt-btn-tax-pdf');

  // Currency Formatter
  function formatCurrency(val, cur = '₹') {
    if (cur === '₹') {
      return `₹ ${Math.round(val).toLocaleString('en-IN')}`;
    }
    return `$ ${Math.round(val).toLocaleString('en-US')}`;
  }

  // Switch Region Handler
  function switchRegion(region) {
    currentRegion = region;
    regionTabs.forEach((btn) => {
      if (btn.getAttribute('data-region') === region) {
        btn.className = 'btn-region-tab active shrink-0 rounded-lg bg-blue-600 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-region-tab shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    if (region === 'india') {
      taxPanelTitle.innerHTML = '<span>🇮🇳</span> India Income Tax Calculator';
      taxPanelDesc.textContent = 'Calculate income tax, Section 87A rebate, surcharges, and compare New vs Old Tax Regime slabs.';
      colAySelect.classList.remove('hidden');
      colRegimeSelect.classList.remove('hidden');
      colFilingStatus.classList.add('hidden');
      gridIndiaIncome.classList.remove('hidden');
      gridUsIncome.classList.add('hidden');
      updateIndiaDeductionVisibility();
    } else {
      let usLabel = 'US Federal';
      if (region === 'us_california') usLabel = 'US (California)';
      else if (region === 'us_texas') usLabel = 'US (Texas 0% State)';

      taxPanelTitle.innerHTML = `<span>🇺🇸</span> ${usLabel} Income Tax Calculator`;
      taxPanelDesc.textContent = 'Estimate US Federal and state income taxes based on filing status and standard deductions.';
      colAySelect.classList.add('hidden');
      colRegimeSelect.classList.add('hidden');
      colFilingStatus.classList.remove('hidden');
      gridIndiaIncome.classList.add('hidden');
      gridUsIncome.classList.remove('hidden');
      boxIndiaDeductions.classList.add('hidden');
    }
  }

  function updateIndiaDeductionVisibility() {
    if (currentRegion === 'india') {
      if (selRegime.value === 'old' || selRegime.value === 'compare') {
        boxIndiaDeductions.classList.remove('hidden');
      } else {
        boxIndiaDeductions.classList.add('hidden');
      }
    }
  }

  selRegime.addEventListener('change', updateIndiaDeductionVisibility);

  regionTabs.forEach((btn) => {
    btn.addEventListener('click', () => switchRegion(btn.getAttribute('data-region')));
  });

  // Calculate Tax Execution
  function executeTaxCalculation() {
    errTax.classList.add('hidden');

    if (currentRegion === 'india') {
      const salary = parseFloat(inpSalary.value) || 0;
      const house = parseFloat(inpHouseProp.value) || 0;
      const other = parseFloat(inpOtherInc.value) || 0;
      const gross = salary + house + other;

      if (gross < 0) {
        errTax.textContent = 'Gross income cannot be negative.';
        errTax.classList.remove('hidden');
        taxResultsSection.classList.add('hidden');
        return;
      }

      const ay = selAy.value;
      const regimeMode = selRegime.value;

      const c80 = Math.min(150000, parseFloat(inp80c.value) || 0);
      const d80 = Math.min(100000, parseFloat(inp80d.value) || 0);
      const b24 = Math.min(200000, parseFloat(inp24b.value) || 0);
      const hra = parseFloat(inpHra.value) || 0;

      // New Regime Slabs & Calculation
      const newStd = salary > 0 ? Math.min(salary, 75000) : 0;
      const newTaxable = Math.max(0, gross - newStd);
      let newTaxBefore = 0;
      const newSlabs = [];

      const newSlabDefs = [
        { min: 0, max: 300000, rate: 0, label: '₹0 to ₹3,00,000' },
        { min: 300000, max: 700000, rate: 5, label: '₹3,00,001 to ₹7,00,000' },
        { min: 700000, max: 1000000, rate: 10, label: '₹7,00,001 to ₹10,00,000' },
        { min: 1000000, max: 1200000, rate: 15, label: '₹10,00,001 to ₹12,00,000' },
        { min: 1200000, max: 1500000, rate: 20, label: '₹12,00,001 to ₹15,00,000' },
        { min: 1500000, max: Infinity, rate: 30, label: 'Above ₹15,00,000' },
      ];

      for (const s of newSlabDefs) {
        if (newTaxable > s.min) {
          const tInSlab = Math.min(newTaxable - s.min, s.max - s.min);
          const sTax = (tInSlab * s.rate) / 100;
          newTaxBefore += sTax;
          newSlabs.push({ slab: s.label, taxable: tInSlab, rate: s.rate, tax: Math.round(sTax) });
        } else {
          newSlabs.push({ slab: s.label, taxable: 0, rate: s.rate, tax: 0 });
        }
      }

      let newRebate = 0;
      if (newTaxable <= 700000) newRebate = newTaxBefore;
      const newTaxAfterRebate = Math.max(0, newTaxBefore - newRebate);
      const newCess = Math.round(newTaxAfterRebate * 0.04);
      const newTotalTax = Math.round(newTaxAfterRebate + newCess);

      // Old Regime Slabs & Calculation
      const oldStd = salary > 0 ? Math.min(salary, 50000) : 0;
      const oldTotalDeduct = oldStd + c80 + d80 + b24 + hra;
      const oldTaxable = Math.max(0, gross - oldTotalDeduct);
      let oldTaxBefore = 0;
      const oldSlabs = [];

      const oldSlabDefs = [
        { min: 0, max: 250000, rate: 0, label: '₹0 to ₹2,50,000' },
        { min: 250000, max: 500000, rate: 5, label: '₹2,50,001 to ₹5,00,000' },
        { min: 500000, max: 1000000, rate: 20, label: '₹5,00,001 to ₹10,00,000' },
        { min: 1000000, max: Infinity, rate: 30, label: 'Above ₹10,00,000' },
      ];

      for (const s of oldSlabDefs) {
        if (oldTaxable > s.min) {
          const tInSlab = Math.min(oldTaxable - s.min, s.max - s.min);
          const sTax = (tInSlab * s.rate) / 100;
          oldTaxBefore += sTax;
          oldSlabs.push({ slab: s.label, taxable: tInSlab, rate: s.rate, tax: Math.round(sTax) });
        } else {
          oldSlabs.push({ slab: s.label, taxable: 0, rate: s.rate, tax: 0 });
        }
      }

      let oldRebate = 0;
      if (oldTaxable <= 500000) oldRebate = Math.min(12500, oldTaxBefore);
      const oldTaxAfterRebate = Math.max(0, oldTaxBefore - oldRebate);
      const oldCess = Math.round(oldTaxAfterRebate * 0.04);
      const oldTotalTax = Math.round(oldTaxAfterRebate + oldCess);

      // Save calculation state
      lastTaxResult = {
        isIndia: true,
        gross,
        ay,
        regimeMode,
        new: { totalTax: newTotalTax, taxable: newTaxable, deduct: newStd, cess: newCess, rebate: newRebate, slabs: newSlabs },
        old: { totalTax: oldTotalTax, taxable: oldTaxable, deduct: oldTotalDeduct, cess: oldCess, rebate: oldRebate, slabs: oldSlabs },
      };

      if (regimeMode === 'compare') {
        cardComparisonResult.classList.remove('hidden');
        const savings = Math.abs(oldTotalTax - newTotalTax);
        const lower = newTotalTax <= oldTotalTax ? 'New Tax Regime' : 'Old Tax Regime';
        txtComparisonRec.textContent = `Based on your declarations, ${lower} offers estimated tax savings of ₹ ${savings.toLocaleString('en-IN')}!`;

        cmpTbody.innerHTML = `
          <tr><td class="p-2.5 font-bold">Gross Total Income</td><td class="p-2.5 text-right font-bold text-blue-600">${formatCurrency(gross)}</td><td class="p-2.5 text-right font-bold">${formatCurrency(gross)}</td></tr>
          <tr><td class="p-2.5">Total Deductions</td><td class="p-2.5 text-right">${formatCurrency(newStd)}</td><td class="p-2.5 text-right">${formatCurrency(oldTotalDeduct)}</td></tr>
          <tr><td class="p-2.5 font-bold">Taxable Income</td><td class="p-2.5 text-right font-bold text-blue-600">${formatCurrency(newTaxable)}</td><td class="p-2.5 text-right font-bold">${formatCurrency(oldTaxable)}</td></tr>
          <tr><td class="p-2.5">Section 87A Rebate</td><td class="p-2.5 text-right">${formatCurrency(newRebate)}</td><td class="p-2.5 text-right">${formatCurrency(oldRebate)}</td></tr>
          <tr><td class="p-2.5">Health & Education Cess (4%)</td><td class="p-2.5 text-right">${formatCurrency(newCess)}</td><td class="p-2.5 text-right">${formatCurrency(oldCess)}</td></tr>
          <tr class="bg-slate-50 dark:bg-slate-800/80 font-black text-sm"><td class="p-2.5">Total Estimated Tax</td><td class="p-2.5 text-right text-emerald-600">${formatCurrency(newTotalTax)}</td><td class="p-2.5 text-right text-slate-900 dark:text-white">${formatCurrency(oldTotalTax)}</td></tr>
        `;

        // Default Single card to the recommended regime
        const chosen = newTotalTax <= oldTotalTax ? lastTaxResult.new : lastTaxResult.old;
        const chosenLabel = newTotalTax <= oldTotalTax ? 'New Tax Regime (Recommended)' : 'Old Tax Regime (Recommended)';
        renderSingleCard(chosen.totalTax, gross, chosen.deduct, chosen.taxable, chosenLabel, '₹');
        renderSlabTable(chosen.slabs, '₹');
      } else {
        cardComparisonResult.classList.add('hidden');
        const activeData = regimeMode === 'new' ? lastTaxResult.new : lastTaxResult.old;
        const label = regimeMode === 'new' ? 'New Tax Regime' : 'Old Tax Regime';
        renderSingleCard(activeData.totalTax, gross, activeData.deduct, activeData.taxable, label, '₹');
        renderSlabTable(activeData.slabs, '₹');
      }
    } else {
      // US Tax Calculation
      const gross = parseFloat(inpUsGross.value) || 0;
      const itemized = parseFloat(inpUsItemized.value) || 0;
      const status = selFilingStatus.value;

      const stdDeductions = { single: 15000, married_joint: 30000, married_separate: 15000, head_household: 22500 };
      const totalDeduct = Math.max(stdDeductions[status] || 15000, itemized);
      const taxable = Math.max(0, gross - totalDeduct);

      // US Federal Brackets
      const fedBrackets = [
        { rate: 10, single: [0, 11925], married_joint: [0, 23850], married_separate: [0, 11925], head_household: [0, 17000] },
        { rate: 12, single: [11925, 48475], married_joint: [23850, 96950], married_separate: [11925, 48475], head_household: [17000, 64850] },
        { rate: 22, single: [48475, 103350], married_joint: [96950, 206700], married_separate: [48475, 103350], head_household: [64850, 103350] },
        { rate: 24, single: [103350, 197300], married_joint: [206700, 394600], married_separate: [103350, 197300], head_household: [103350, 197300] },
        { rate: 32, single: [197300, 250525], married_joint: [394600, 501050], married_separate: [197300, 250525], head_household: [197300, 250525] },
        { rate: 35, single: [250525, 626350], married_joint: [501050, 751600], married_separate: [250525, 375800], head_household: [250525, 626350] },
        { rate: 37, single: [626350, Infinity], married_joint: [751600, Infinity], married_separate: [375800, Infinity], head_household: [626350, Infinity] },
      ];

      let fedTax = 0;
      const usSlabs = [];
      for (const b of fedBrackets) {
        const [min, max] = b[status];
        if (taxable > min) {
          const tInSlab = Math.min(taxable - min, max - min);
          const sTax = (tInSlab * b.rate) / 100;
          fedTax += sTax;
          usSlabs.push({
            slab: `$${min.toLocaleString()} to ${max === Infinity ? 'Above' : '$' + max.toLocaleString()}`,
            taxable: tInSlab,
            rate: b.rate,
            tax: Math.round(sTax),
          });
        } else {
          usSlabs.push({
            slab: `$${min.toLocaleString()} to ${max === Infinity ? 'Above' : '$' + max.toLocaleString()}`,
            taxable: 0,
            rate: b.rate,
            tax: 0,
          });
        }
      }

      let stateTax = 0;
      if (currentRegion === 'us_california') {
        const caStd = status === 'married_joint' ? 11080 : 5540;
        const caTaxable = Math.max(0, gross - caStd);
        if (caTaxable > 1000000) stateTax = 100000 + (caTaxable - 1000000) * 0.133;
        else if (caTaxable > 350000) stateTax = 30000 + (caTaxable - 350000) * 0.113;
        else if (caTaxable > 100000) stateTax = 6000 + (caTaxable - 100000) * 0.093;
        else if (caTaxable > 50000) stateTax = 1500 + (caTaxable - 50000) * 0.06;
        else stateTax = caTaxable * 0.02;
      }

      const totalTax = Math.round(fedTax + stateTax);
      lastTaxResult = {
        isIndia: false,
        gross,
        status,
        totalTax,
        taxable,
        deduct: totalDeduct,
        stateTax,
        slabs: usSlabs,
      };

      cardComparisonResult.classList.add('hidden');
      renderSingleCard(totalTax, gross, totalDeduct, taxable, `${selFilingStatus.options[selFilingStatus.selectedIndex].text} (US)`, '$');
      renderSlabTable(usSlabs, '$');
    }

    taxResultsSection.classList.remove('hidden');
  }

  function renderSingleCard(totalTax, gross, deduct, taxable, label, cur) {
    resBadgeLabel.textContent = `Estimated Tax Liability (${label})`;
    resTotalTax.textContent = formatCurrency(totalTax, cur);
    resGrossIncome.textContent = formatCurrency(gross, cur);
    resTotalDeduct.textContent = formatCurrency(deduct, cur);
    resTaxableIncome.textContent = formatCurrency(taxable, cur);
    resNetTakehome.textContent = formatCurrency(Math.max(0, gross - totalTax), cur);
    resEffectiveRate.textContent = gross > 0 ? `${((totalTax / gross) * 100).toFixed(2)}%` : '0%';
  }

  function renderSlabTable(slabs, cur) {
    slabTbody.innerHTML = slabs.map((s) => `
      <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
        <td class="p-2.5 font-bold text-slate-900 dark:text-white">${s.slab}</td>
        <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatCurrency(s.taxable, cur)}</td>
        <td class="p-2.5 text-right font-bold text-blue-600 dark:text-blue-400">${s.rate}%</td>
        <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatCurrency(s.tax, cur)}</td>
      </tr>
    `).join('');
  }

  btnCalcTax.addEventListener('click', executeTaxCalculation);

  btnClearTax.addEventListener('click', () => {
    inpSalary.value = '1200000';
    inpHouseProp.value = '0';
    inpOtherInc.value = '0';
    inpUsGross.value = '85000';
    inpUsItemized.value = '0';
    inp80c.value = '150000';
    inp80d.value = '25000';
    inp24b.value = '0';
    inpHra.value = '0';
    errTax.classList.add('hidden');
    taxResultsSection.classList.add('hidden');
    lastTaxResult = null;
  });

  // Export Excel / CSV Functionality
  btnExportExcel.addEventListener('click', () => {
    if (!lastTaxResult) {
      alert('Please calculate your income tax first before downloading the Excel sheet.');
      return;
    }

    let csvContent = 'data:text/csv;charset=utf-8,';
    csvContent += 'Income Tax Calculation Summary - AIFreecalculator.com\n\n';

    if (lastTaxResult.isIndia) {
      csvContent += `Assessment Year,${lastTaxResult.ay}\n`;
      csvContent += `Gross Total Income,Rs. ${lastTaxResult.gross}\n\n`;

      if (lastTaxResult.regimeMode === 'compare') {
        csvContent += 'Parameter,New Tax Regime,Old Tax Regime\n';
        csvContent += `Total Deductions,Rs. ${lastTaxResult.new.deduct},Rs. ${lastTaxResult.old.deduct}\n`;
        csvContent += `Taxable Income,Rs. ${lastTaxResult.new.taxable},Rs. ${lastTaxResult.old.taxable}\n`;
        csvContent += `Section 87A Rebate,Rs. ${lastTaxResult.new.rebate},Rs. ${lastTaxResult.old.rebate}\n`;
        csvContent += `Cess (4%),Rs. ${lastTaxResult.new.cess},Rs. ${lastTaxResult.old.cess}\n`;
        csvContent += `Total Tax Payable,Rs. ${lastTaxResult.new.totalTax},Rs. ${lastTaxResult.old.totalTax}\n\n`;
      } else {
        const active = lastTaxResult.regimeMode === 'new' ? lastTaxResult.new : lastTaxResult.old;
        csvContent += `Regime,${lastTaxResult.regimeMode === 'new' ? 'New Tax Regime' : 'Old Tax Regime'}\n`;
        csvContent += `Total Deductions,Rs. ${active.deduct}\n`;
        csvContent += `Taxable Income,Rs. ${active.taxable}\n`;
        csvContent += `Total Estimated Tax,Rs. ${active.totalTax}\n\n`;

        csvContent += 'Income Slab,Taxable in Slab,Rate %,Tax Amount\n';
        active.slabs.forEach((s) => {
          csvContent += `"${s.slab}",Rs. ${s.taxable},${s.rate}%,Rs. ${s.tax}\n`;
        });
      }
    } else {
      csvContent += `Filing Status,${lastTaxResult.status}\n`;
      csvContent += `Gross Income,$${lastTaxResult.gross}\n`;
      csvContent += `Deductions,$${lastTaxResult.deduct}\n`;
      csvContent += `Taxable Income,$${lastTaxResult.taxable}\n`;
      csvContent += `Total Estimated Tax,$${lastTaxResult.totalTax}\n\n`;

      csvContent += 'Income Bracket,Taxable Amount,Rate %,Tax Amount\n';
      lastTaxResult.slabs.forEach((s) => {
        csvContent += `"${s.slab}",$${s.taxable},${s.rate}%,$${s.tax}\n`;
      });
    }

    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `income-tax-calculation-${new Date().toISOString().split('T')[0]}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Download PDF Functionality
  async function generateTaxPdf() {
    if (!lastTaxResult) {
      alert('Please calculate your income tax first before downloading the PDF.');
      return;
    }

    btnTaxDownloadPdf.disabled = true;
    const originalText = txtBtnTaxPdf.textContent;
    txtBtnTaxPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header & Website Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text('Income Tax Calculation Summary', 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Tax Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 26, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('TAX SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);

      if (lastTaxResult.isIndia) {
        doc.text(`Assessment Year: ${lastTaxResult.ay}`, 18, 44);
        doc.text(`Gross Income: Rs. ${lastTaxResult.gross.toLocaleString('en-IN')}`, 18, 49);
        doc.text(`Regime: ${lastTaxResult.regimeMode === 'compare' ? 'Comparison Mode' : lastTaxResult.regimeMode === 'new' ? 'New Tax Regime' : 'Old Tax Regime'}`, 18, 54);

        const chosen = lastTaxResult.regimeMode === 'old' ? lastTaxResult.old : lastTaxResult.new;
        doc.text(`Taxable Income: Rs. ${chosen.taxable.toLocaleString('en-IN')}`, 85, 44);
        doc.text(`Total Deductions: Rs. ${chosen.deduct.toLocaleString('en-IN')}`, 85, 49);
        doc.text(`Cess (4%): Rs. ${chosen.cess.toLocaleString('en-IN')}`, 85, 54);

        doc.setFont('helvetica', 'bold');
        doc.setTextColor(16, 185, 129);
        doc.text(`Estimated Tax: Rs. ${chosen.totalTax.toLocaleString('en-IN')}`, 145, 49);
      } else {
        doc.text(`Region: US (${lastTaxResult.status})`, 18, 44);
        doc.text(`Gross Income: $${lastTaxResult.gross.toLocaleString('en-US')}`, 18, 49);
        doc.text(`Taxable Income: $${lastTaxResult.taxable.toLocaleString('en-US')}`, 85, 44);
        doc.text(`Deductions: $${lastTaxResult.deduct.toLocaleString('en-US')}`, 85, 49);

        doc.setFont('helvetica', 'bold');
        doc.setTextColor(16, 185, 129);
        doc.text(`Estimated Tax: $${lastTaxResult.totalTax.toLocaleString('en-US')}`, 145, 49);
      }

      // 4. Slab Breakdown Table
      const slabsToExport = lastTaxResult.isIndia
        ? (lastTaxResult.regimeMode === 'old' ? lastTaxResult.old.slabs : lastTaxResult.new.slabs)
        : lastTaxResult.slabs;

      const tableData = slabsToExport.map((s) => [
        s.slab,
        (lastTaxResult.isIndia ? 'Rs. ' : '$') + s.taxable.toLocaleString(),
        `${s.rate}%`,
        (lastTaxResult.isIndia ? 'Rs. ' : '$') + s.tax.toLocaleString()
      ]);

      doc.autoTable({
        startY: 63,
        head: [['Income Slab / Bracket', 'Taxable in Slab', 'Rate', 'Tax Amount']],
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { cellWidth: 70 },
          1: { halign: 'right' },
          2: { halign: 'center' },
          3: { halign: 'right', fontStyle: 'bold' }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const today = new Date().toISOString().split('T')[0];
      doc.save(`income-tax-calculation-${today}.pdf`);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnTaxDownloadPdf.disabled = false;
      txtBtnTaxPdf.textContent = originalText;
    }
  }

  btnTaxDownloadPdf.addEventListener('click', generateTaxPdf);

  // Enter Key Calculation
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeTaxCalculation();
        }
      });
    });
  });
</script>
