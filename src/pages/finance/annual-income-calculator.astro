    updateCurrencyLabels();
    executeIncomeCalculation();
  });

  // Mode Switcher Handler
  document.querySelectorAll('.btn-income-mode').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-income-mode').forEach((b) => {
        b.className = 'btn-income-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center';
      });
      btn.className = 'btn-income-mode active rounded-xl border border-blue-600 bg-blue-50 px-3 py-2 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer text-center';

      activeIncomeMode = btn.getAttribute('data-mode') || 'hourly_to_annual';
      errIncome.classList.add('hidden');

      secHourlyAnnual.classList.add('hidden');
      secAnnualHourly.classList.add('hidden');
      secSolveHours.classList.add('hidden');
      secSolveWeeks.classList.add('hidden');
      secNetGross.classList.add('hidden');

      if (activeIncomeMode === 'hourly_to_annual') {
        secHourlyAnnual.classList.remove('hidden');
        txtPanelTitle.innerHTML = '<span>💼</span> Hourly to Annual Income Calculator';
        txtPanelSubtitle.textContent = 'Calculate your gross annual income, net take-home pay, and salary period breakdown from hourly pay and hours worked.';
      } else if (activeIncomeMode === 'annual_to_hourly') {
        secAnnualHourly.classList.remove('hidden');
        txtPanelTitle.innerHTML = '<span>🔄</span> Annual Salary to Hourly Wage Calculator';
        txtPanelSubtitle.textContent = 'Reverse calculate your equivalent hourly pay rate from your total annual salary and scheduled work hours.';
      } else if (activeIncomeMode === 'solve_hours') {
        secSolveHours.classList.remove('hidden');
        txtPanelTitle.innerHTML = '<span>⏱️</span> Required Working Hours Calculator';
        txtPanelSubtitle.textContent = 'Determine how many hours you need to work per week to hit your desired annual income at your current hourly rate.';
      } else if (activeIncomeMode === 'solve_weeks') {
        secSolveWeeks.classList.remove('hidden');
        txtPanelTitle.innerHTML = '<span>📅</span> Required Working Weeks Calculator';
        txtPanelSubtitle.textContent = 'Calculate how many weeks of work per year are needed to achieve your target annual revenue.';
      } else if (activeIncomeMode === 'net_to_gross') {
        secNetGross.classList.remove('hidden');
        txtPanelTitle.innerHTML = '<span>🧾</span> Net to Gross Annual Income Calculator';
        txtPanelSubtitle.textContent = 'Calculate the gross pre-tax salary required to achieve a specific net take-home income after taxes.';
      }

      executeIncomeCalculation();
    });
  });

  // Quick Work Schedule Presets
  document.querySelectorAll('.btn-hour-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const hrs = btn.getAttribute('data-hours') || '40';
      if (activeIncomeMode === 'hourly_to_annual') {
        inpHaHours.value = hrs;
      } else if (activeIncomeMode === 'annual_to_hourly') {
        inpAhHours.value = hrs;
      } else if (activeIncomeMode === 'solve_weeks') {
        inpSwHours.value = hrs;
      }
      executeIncomeCalculation();
    });
  });

  // Master Calculation Execution (100% Client-Side)
  function executeIncomeCalculation() {
    errIncome.classList.add('hidden');

    const unpaidWeeks = Math.max(0, parseFloat(inpUnpaidWeeks.value) || 0);
    const taxRate = Math.max(0, parseFloat(inpTaxRate.value) || 0);

    if (unpaidWeeks < 0 || unpaidWeeks >= 52) {
      showError('Unpaid leave weeks must be between 0 and 51.');
      return;
    }
    if (taxRate < 0 || taxRate >= 100) {
      showError('Estimated tax rate must be between 0% and 99.99%.');
      return;
    }

    let hourlyWage = 0;
    let hoursPerWeek = 40;
    let workingWeeks = 52 - unpaidWeeks;
    let grossAnnual = 0;
    let netAnnual = 0;
    let taxAmount = 0;

    let heroLabel = 'GROSS ANNUAL INCOME';
    let heroValueStr = '';
    let heroSubtitle = '';

    let formulaName = '';
    let formulaEq = '';
    const steps = [];

    if (activeIncomeMode === 'hourly_to_annual') {
      hourlyWage = parseFloat(inpHaWage.value);
      hoursPerWeek = parseFloat(inpHaHours.value);
      const specifiedWeeks = parseFloat(inpHaWeeks.value);

      if (isNaN(hourlyWage) || hourlyWage < 0) {
        showError('Please enter a valid non-negative hourly wage.');
        return;
      }
      if (isNaN(hoursPerWeek) || hoursPerWeek <= 0 || hoursPerWeek > 168) {
        showError('Working hours per week must be between 1 and 168.');
        return;
      }
      if (isNaN(specifiedWeeks) || specifiedWeeks <= 0 || specifiedWeeks > 52) {
        showError('Working weeks per year must be between 1 and 52.');
        return;
      }

      workingWeeks = Math.max(1, specifiedWeeks - unpaidWeeks);
      grossAnnual = hourlyWage * hoursPerWeek * workingWeeks;
      taxAmount = grossAnnual * (taxRate / 100);
      netAnnual = grossAnnual - taxAmount;

      heroLabel = 'GROSS ANNUAL INCOME';
      heroValueStr = formatMoney(grossAnnual);
      heroSubtitle = `Based on ${formatMoney(hourlyWage)}/hr × ${hoursPerWeek} hrs/wk × ${workingWeeks} wks`;

      formulaName = 'Hourly Wage to Annual Salary Formula';
      formulaEq = 'Annual Income = Hourly Wage × Hours per Week × Working Weeks';

      steps.push(`Step 1 (Weekly Earnings): ${formatMoney(hourlyWage)} × ${hoursPerWeek} hrs = <strong>${formatMoney(hourlyWage * hoursPerWeek)}/week</strong>`);
      steps.push(`Step 2 (Gross Annual): ${formatMoney(hourlyWage * hoursPerWeek)} × ${workingWeeks} weeks = <strong>${formatMoney(grossAnnual)}/year</strong>`);
      if (taxRate > 0) {
        steps.push(`Step 3 (Taxes & Net Take-Home): ${formatMoney(grossAnnual)} × ${taxRate}% = ${formatMoney(taxAmount)} tax; Net = <strong>${formatMoney(netAnnual)}</strong>`);
      }

    } else if (activeIncomeMode === 'annual_to_hourly') {
      grossAnnual = parseFloat(inpAhGross.value);
      hoursPerWeek = parseFloat(inpAhHours.value);
      const specifiedWeeks = parseFloat(inpAhWeeks.value);

      if (isNaN(grossAnnual) || grossAnnual <= 0) {
        showError('Annual salary must be greater than zero.');
        return;
      }
      if (isNaN(hoursPerWeek) || hoursPerWeek <= 0 || hoursPerWeek > 168) {
        showError('Working hours per week must be between 1 and 168.');
        return;
      }
      if (isNaN(specifiedWeeks) || specifiedWeeks <= 0 || specifiedWeeks > 52) {
        showError('Weeks per year must be between 1 and 52.');
        return;
      }

      workingWeeks = Math.max(1, specifiedWeeks - unpaidWeeks);
      hourlyWage = grossAnnual / (hoursPerWeek * workingWeeks);
      taxAmount = grossAnnual * (taxRate / 100);
      netAnnual = grossAnnual - taxAmount;

      heroLabel = 'EQUIVALENT HOURLY WAGE';
      heroValueStr = `${formatMoney(hourlyWage)}/hr`;
      heroSubtitle = `Annual Gross: ${formatMoney(grossAnnual)} across ${(hoursPerWeek * workingWeeks).toLocaleString()} working hours`;

      formulaName = 'Annual Salary to Hourly Wage Formula';
      formulaEq = 'Hourly Wage = Gross Annual Income ÷ (Hours per Week × Working Weeks)';

      steps.push(`Step 1 (Total Yearly Hours): ${hoursPerWeek} hrs × ${workingWeeks} wks = <strong>${(hoursPerWeek * workingWeeks).toLocaleString()} hours/year</strong>`);
      steps.push(`Step 2 (Hourly Rate): ${formatMoney(grossAnnual)} ÷ ${(hoursPerWeek * workingWeeks).toLocaleString()} hrs = <strong>${formatMoney(hourlyWage)}/hr</strong>`);

    } else if (activeIncomeMode === 'solve_hours') {
      grossAnnual = parseFloat(inpShGross.value);
      hourlyWage = parseFloat(inpShWage.value);
      const specifiedWeeks = parseFloat(inpShWeeks.value);

      if (isNaN(grossAnnual) || grossAnnual <= 0) {
        showError('Desired annual income must be greater than zero.');
        return;
      }
      if (isNaN(hourlyWage) || hourlyWage <= 0) {
        showError('Hourly wage must be greater than zero.');
        return;
      }
      if (isNaN(specifiedWeeks) || specifiedWeeks <= 0 || specifiedWeeks > 52) {
        showError('Weeks per year must be between 1 and 52.');
        return;
      }

      workingWeeks = Math.max(1, specifiedWeeks - unpaidWeeks);
      hoursPerWeek = grossAnnual / (hourlyWage * workingWeeks);
      taxAmount = grossAnnual * (taxRate / 100);
      netAnnual = grossAnnual - taxAmount;

      heroLabel = 'REQUIRED HOURS PER WEEK';
      heroValueStr = `${hoursPerWeek.toFixed(1)} hrs/week`;
      heroSubtitle = `To earn ${formatMoney(grossAnnual)} at ${formatMoney(hourlyWage)}/hr across ${workingWeeks} weeks`;

      formulaName = 'Required Weekly Hours Formula';
      formulaEq = 'Hours/Week = Desired Annual Income ÷ (Hourly Wage × Working Weeks)';

      steps.push(`Step 1 (Total Hours Required): ${formatMoney(grossAnnual)} ÷ ${formatMoney(hourlyWage)} = <strong>${(grossAnnual / hourlyWage).toFixed(1)} hrs/year</strong>`);
      steps.push(`Step 2 (Weekly Hours): ${(grossAnnual / hourlyWage).toFixed(1)} hrs ÷ ${workingWeeks} wks = <strong>${hoursPerWeek.toFixed(2)} hrs/week</strong>`);

    } else if (activeIncomeMode === 'solve_weeks') {
      grossAnnual = parseFloat(inpSwGross.value);
      hourlyWage = parseFloat(inpSwWage.value);
      hoursPerWeek = parseFloat(inpSwHours.value);

      if (isNaN(grossAnnual) || grossAnnual <= 0) {
        showError('Target annual income must be greater than zero.');
        return;
      }
      if (isNaN(hourlyWage) || hourlyWage <= 0) {
        showError('Hourly wage must be greater than zero.');
        return;
      }
      if (isNaN(hoursPerWeek) || hoursPerWeek <= 0 || hoursPerWeek > 168) {
        showError('Working hours per week must be between 1 and 168.');
        return;
      }

      workingWeeks = grossAnnual / (hourlyWage * hoursPerWeek);
      taxAmount = grossAnnual * (taxRate / 100);
      netAnnual = grossAnnual - taxAmount;

      heroLabel = 'REQUIRED WORKING WEEKS';
      heroValueStr = `${workingWeeks.toFixed(1)} weeks/year`;
      heroSubtitle = `To earn ${formatMoney(grossAnnual)} at ${formatMoney(hourlyWage)}/hr and ${hoursPerWeek} hrs/wk`;

      formulaName = 'Required Working Weeks Formula';
      formulaEq = 'Working Weeks = Desired Annual Income ÷ (Hourly Wage × Hours per Week)';

      steps.push(`Step 1 (Weekly Income): ${formatMoney(hourlyWage)} × ${hoursPerWeek} hrs = <strong>${formatMoney(hourlyWage * hoursPerWeek)}/week</strong>`);
      steps.push(`Step 2 (Working Weeks): ${formatMoney(grossAnnual)} ÷ ${formatMoney(hourlyWage * hoursPerWeek)} = <strong>${workingWeeks.toFixed(1)} weeks</strong>`);

    } else if (activeIncomeMode === 'net_to_gross') {
      netAnnual = parseFloat(inpNgNet.value);
      const customTax = parseFloat(inpNgTax.value);

      if (isNaN(netAnnual) || netAnnual <= 0) {
        showError('Desired net income must be greater than zero.');
        return;
      }
      if (isNaN(customTax) || customTax < 0 || customTax >= 100) {
        showError('Tax rate must be between 0% and 99.99%.');
        return;
      }

      grossAnnual = netAnnual / (1 - customTax / 100);
      taxAmount = grossAnnual - netAnnual;
      hoursPerWeek = 40;
      workingWeeks = 52 - unpaidWeeks;
      hourlyWage = grossAnnual / (hoursPerWeek * workingWeeks);

      heroLabel = 'REQUIRED GROSS ANNUAL SALARY';
      heroValueStr = formatMoney(grossAnnual);
      heroSubtitle = `To take home ${formatMoney(netAnnual)} after ${customTax}% taxes`;

      formulaName = 'Required Gross from Net Take-Home Formula';
      formulaEq = 'Gross Annual Income = Net Annual Income ÷ (1 - Tax Rate ÷ 100)';

      steps.push(`Step 1 (Required Gross): ${formatMoney(netAnnual)} ÷ (1 - ${customTax} ÷ 100) = <strong>${formatMoney(grossAnnual)}</strong>`);
      steps.push(`Step 2 (Taxes Paid): ${formatMoney(grossAnnual)} - ${formatMoney(netAnnual)} = <strong>${formatMoney(taxAmount)}</strong>`);
    }

    // Save calculation state for PDF export
    lastCalculatedIncome = {
      mode: activeIncomeMode,
      currency: activeCurrency,
      hourlyWage,
      hoursPerWeek,
      workingWeeks,
      unpaidWeeks,
      grossAnnual,
      taxRate,
      taxAmount,
      netAnnual,
      heroLabel,
      heroValueStr,
    };

    // Render Hero Card
    lblHeroTitle.textContent = heroLabel;
    resHeroAmount.textContent = heroValueStr;
    resHeroSubtitle.textContent = heroSubtitle;
    resHeroNet.textContent = formatMoney(netAnnual);
    resHeroTaxBadge.textContent = `Est. Tax: ${formatMoney(taxAmount)} (${taxRate.toFixed(1)}%)`;

    // Render 6-Box Grid
    const weeklyGross = hourlyWage * hoursPerWeek;
    const dailyGross = hoursPerWeek > 0 ? weeklyGross / (hoursPerWeek / 8) : hourlyWage * 8;
    const biweeklyGross = weeklyGross * 2;
    const monthlyGross = grossAnnual / 12;

    resGridHourly.textContent = `${formatMoney(hourlyWage)}/hr`;
    resGridDaily.textContent = formatMoney(dailyGross);
    resGridWeekly.textContent = formatMoney(weeklyGross);
    resGridBiweekly.textContent = formatMoney(biweeklyGross);
    resGridMonthly.textContent = formatMoney(monthlyGross);
    resGridWeeks.textContent = `${workingWeeks.toFixed(0)} weeks`;

    // Render Breakdown
    txtBreakdownTitle.textContent = formulaName;
    txtBreakdownFormula.textContent = formulaEq;
    boxBreakdownSteps.innerHTML = steps.map((s) => `<div>${s}</div>`).join('');

    // Render Frequency Comparison Table
    const tableData = [
      { label: 'Hourly', gross: hourlyWage, tax: hourlyWage * (taxRate / 100), net: hourlyWage * (1 - taxRate / 100) },
      { label: 'Daily (8 hrs)', gross: hourlyWage * 8, tax: hourlyWage * 8 * (taxRate / 100), net: hourlyWage * 8 * (1 - taxRate / 100) },
      { label: 'Weekly', gross: weeklyGross, tax: weeklyGross * (taxRate / 100), net: weeklyGross * (1 - taxRate / 100) },
      { label: 'Bi-Weekly (Every 2 wks)', gross: biweeklyGross, tax: biweeklyGross * (taxRate / 100), net: biweeklyGross * (1 - taxRate / 100) },
      { label: 'Monthly (Average)', gross: monthlyGross, tax: monthlyGross * (taxRate / 100), net: netAnnual / 12 },
      { label: 'Quarterly', gross: grossAnnual / 4, tax: (grossAnnual / 4) * (taxRate / 100), net: netAnnual / 4 },
      { label: 'Annual (Yearly Total)', gross: grossAnnual, tax: taxAmount, net: netAnnual },
    ];

    tblFrequency.innerHTML = tableData.map((row) => {
      const isAnnual = row.label.startsWith('Annual');
      const rowClass = isAnnual
        ? 'bg-blue-50/80 dark:bg-blue-950/50 font-bold text-blue-700 dark:text-blue-300'
        : 'hover:bg-slate-50 dark:hover:bg-slate-800/40 text-slate-700 dark:text-slate-300';

      return `
        <tr class="${rowClass}">
          <td class="p-2.5 rounded-l-lg">${row.label}</td>
          <td class="p-2.5 text-right font-bold text-slate-900 dark:text-white">${formatMoney(row.gross)}</td>
          <td class="p-2.5 text-right text-red-600 dark:text-red-400">${formatMoney(row.tax)}</td>
          <td class="p-2.5 text-right rounded-r-lg font-bold text-emerald-600 dark:text-emerald-400">${formatMoney(row.net)}</td>
        </tr>
      `;
    }).join('');

    incomeResultsSection.classList.remove('hidden');
  }

  function showError(msg) {
    errIncome.textContent = msg;
    errIncome.classList.remove('hidden');
  }

  // Live Auto-Calculation on inputs (No network hits, pure browser JS)
  [
    inpHaWage, inpHaHours, inpHaWeeks,
    inpAhGross, inpAhHours, inpAhWeeks,
    inpShGross, inpShWage, inpShWeeks,
    inpSwGross, inpSwWage, inpSwHours,
    inpNgNet, inpNgTax,
    inpUnpaidWeeks, inpTaxRate,
  ].forEach((input) => {
    input?.addEventListener('input', () => {
      executeIncomeCalculation();
    });
  });

  // Calculate Button
  btnCalcIncome.addEventListener('click', (e) => {
    e.preventDefault();
    executeIncomeCalculation();
  });

  // Reset Button
  btnClearIncome.addEventListener('click', () => {
    if (activeIncomeMode === 'hourly_to_annual') {
      inpHaWage.value = '500';
      inpHaHours.value = '40';
      inpHaWeeks.value = '52';
    } else if (activeIncomeMode === 'annual_to_hourly') {
      inpAhGross.value = '1040000';
      inpAhHours.value = '40';
      inpAhWeeks.value = '52';
    } else if (activeIncomeMode === 'solve_hours') {
      inpShGross.value = '1200000';
      inpShWage.value = '500';
      inpShWeeks.value = '48';
    } else if (activeIncomeMode === 'solve_weeks') {
      inpSwGross.value = '1000000';
      inpSwWage.value = '500';
      inpSwHours.value = '40';
    } else if (activeIncomeMode === 'net_to_gross') {
      inpNgNet.value = '900000';
      inpNgTax.value = '10';
    }
    inpUnpaidWeeks.value = '0';
    inpTaxRate.value = '10';
    executeIncomeCalculation();
  });

  // PDF Export
  btnDownloadPdf.addEventListener('click', async () => {
    if (!lastCalculatedIncome) return;

    btnDownloadPdf.disabled = true;
    btnDownloadPdf.textContent = 'Generating PDF...';

    try {
      if (typeof window.jspdf !== 'undefined') {
        generatePdfDoc(window.jspdf.jsPDF);
      } else {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
        script.onload = () => {
          if (window.jspdf) {
            generatePdfDoc(window.jspdf.jsPDF);
          } else {
            window.print();
          }
        };
        script.onerror = () => window.print();
        document.body.appendChild(script);
      }
    } catch {
      window.print();
    } finally {
      setTimeout(() => {
        btnDownloadPdf.disabled = false;
        btnDownloadPdf.innerHTML = '<span>📄</span> <span>Download PDF Report</span>';
      }, 1000);
    }
  });

  function generatePdfDoc(jsPDF) {
    const doc = new jsPDF();
    const data = lastCalculatedIncome;

    doc.setFontSize(18);
    doc.text('Annual Income Calculation Report', 14, 20);

    doc.setFontSize(10);
    doc.setTextColor(100);
    doc.text(`Generated on ${new Date().toLocaleDateString()} | aifreecalculator.com/finance/annual-income-calculator/`, 14, 28);

    doc.setDrawColor(200);
    doc.line(14, 32, 196, 32);

    doc.setFontSize(12);
    doc.setTextColor(30);
    doc.text('Summary of Annual Earnings:', 14, 42);

    doc.setFontSize(10);
    doc.text(`• Hourly Wage: ${formatMoney(data.hourlyWage)}/hr`, 18, 50);
    doc.text(`• Weekly Schedule: ${data.hoursPerWeek} hrs/week across ${data.workingWeeks} paid weeks`, 18, 58);
    doc.text(`• Gross Annual Income: ${formatMoney(data.grossAnnual)}`, 18, 66);
    doc.text(`• Estimated Tax Deductions (${data.taxRate}%): ${formatMoney(data.taxAmount)}`, 18, 74);
    doc.text(`• Net Take-Home Annual Income: ${formatMoney(data.netAnnual)}`, 18, 82);

    doc.line(14, 90, 196, 90);

    doc.setFontSize(11);
    doc.text('Pay Frequency Conversions:', 14, 100);
    doc.setFontSize(9);
    doc.text(`• Weekly Pay: ${formatMoney(data.hourlyWage * data.hoursPerWeek)}`, 18, 108);
    doc.text(`• Monthly Equivalent: ${formatMoney(data.grossAnnual / 12)} (Net: ${formatMoney(data.netAnnual / 12)})`, 18, 115);
    doc.text(`• Bi-Weekly Pay: ${formatMoney(data.hourlyWage * data.hoursPerWeek * 2)}`, 18, 122);

    doc.save('annual-income-report.pdf');
  }

  // Initial calculation on load
  executeIncomeCalculation();
</script>
