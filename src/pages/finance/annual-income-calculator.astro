---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Annual Income Calculator – Calculate Yearly Salary & Net Income"
  description="Calculate your annual income from hourly pay, working hours and weeks per year. Estimate gross and net yearly income with our free annual income calculator."
  category="Finance"
  calculatorName="Annual Income Calculator"
  slug="annual-income-calculator"
  keywords={[
    'annual income calculator',
    'yearly income calculator',
    'annual salary calculator',
    'yearly salary calculator',
    'gross annual income calculator',
    'net annual income calculator',
    'hourly to annual salary calculator',
    'annual income formula',
    'how to calculate annual income',
    'hourly to yearly'
  ]}
>
  <div class="space-y-6">

    <!-- CALCULATION MODE SELECTOR TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 hidden md:inline">
          Calculation Mode:
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-1.5 w-full md:w-auto text-xs font-bold">
          <button type="button" class="btn-income-mode active rounded-xl border border-blue-600 bg-blue-50 px-3 py-2 text-blue-700 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 transition cursor-pointer text-center" data-mode="hourly_to_annual">
            💼 Hourly → Annual
          </button>
          <button type="button" class="btn-income-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="annual_to_hourly">
            🔄 Salary → Hourly
          </button>
          <button type="button" class="btn-income-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="solve_hours">
            ⏱️ Find Hours/Wk
          </button>
          <button type="button" class="btn-income-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="solve_weeks">
            📅 Find Working Wks
          </button>
          <button type="button" class="btn-income-mode rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 hover:border-slate-400 transition cursor-pointer text-center" data-mode="net_to_gross">
            🧾 Net → Gross
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN CALCULATOR FORM CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-200/80 pb-3 dark:border-slate-800">
        <div>
          <h2 id="txt-panel-title" class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>💼</span> Annual Income &amp; Salary Calculator
          </h2>
          <p id="txt-panel-subtitle" class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Calculate your gross annual income, net take-home pay, and salary period breakdown from hourly pay and hours worked.
          </p>
        </div>

        <!-- Currency Selector -->
        <div class="flex items-center gap-1.5 shrink-0 text-xs">
          <label for="sel-income-cur" class="font-bold text-slate-600 dark:text-slate-400">Currency:</label>
          <select id="sel-income-cur" class="rounded-xl border border-slate-300 bg-white px-2.5 py-1.5 font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
            <option value="₹" selected>₹ INR (Rupee)</option>
            <option value="$">$ USD (Dollar)</option>
            <option value="€">€ EUR (Euro)</option>
            <option value="£">£ GBP (Pound)</option>
            <option value="¥">¥ JPY (Yen)</option>
          </select>
        </div>
      </div>

      <form id="form-income" class="mt-4 space-y-4" novalidate onsubmit="return false;">
        
        <!-- SECTION: DYNAMIC INPUT FIELDS ACCORDING TO MODE -->

        <!-- Mode 1: Hourly to Annual -->
        <div id="sec-mode-hourly-annual" class="space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="inp-ha-wage" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Hourly Pay Rate (<span class="txt-cur-symbol">₹</span>/hr)
              </label>
              <input type="number" id="inp-ha-wage" value="500" step="10" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. 500" />
            </div>

            <div>
              <label for="inp-ha-hours" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Working Hours per Week
              </label>
              <input type="number" id="inp-ha-hours" value="40" step="1" min="1" max="168" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="40" />
            </div>

            <div>
              <label for="inp-ha-weeks" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Working Weeks per Year
              </label>
              <input type="number" id="inp-ha-weeks" value="52" step="1" min="1" max="52" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="52" />
            </div>
          </div>

          <!-- Quick Work Hours Presets -->
          <div class="flex flex-wrap items-center gap-1.5 text-xs pt-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mr-1">Work Schedules:</span>
            <button type="button" class="btn-hour-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-hours="20">20 hrs (Part-Time)</button>
            <button type="button" class="btn-hour-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-hours="35">35 hrs (Standard 7h)</button>
            <button type="button" class="btn-hour-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-hours="40">40 hrs (Full-Time 8h)</button>
            <button type="button" class="btn-hour-preset rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer" data-hours="48">48 hrs (6-Day Week)</button>
          </div>
        </div>

        <!-- Mode 2: Annual Salary to Hourly Wage -->
        <div id="sec-mode-annual-hourly" class="hidden space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="inp-ah-gross" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Gross Annual Salary (<span class="txt-cur-symbol">₹</span>)
              </label>
              <input type="number" id="inp-ah-gross" value="1040000" step="10000" min="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. 1,040,000" />
            </div>

            <div>
              <label for="inp-ah-hours" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Hours per Week
              </label>
              <input type="number" id="inp-ah-hours" value="40" step="1" min="1" max="168" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="40" />
            </div>

            <div>
              <label for="inp-ah-weeks" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Paid Weeks per Year
              </label>
              <input type="number" id="inp-ah-weeks" value="52" step="1" min="1" max="52" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="52" />
            </div>
          </div>
        </div>

        <!-- Mode 3: Find Required Hours per Week -->
        <div id="sec-mode-solve-hours" class="hidden space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="inp-sh-gross" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Desired Annual Income (<span class="txt-cur-symbol">₹</span>)
              </label>
              <input type="number" id="inp-sh-gross" value="1200000" step="10000" min="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. 1,200,000" />
            </div>

            <div>
              <label for="inp-sh-wage" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Hourly Pay Rate (<span class="txt-cur-symbol">₹</span>/hr)
              </label>
              <input type="number" id="inp-sh-wage" value="500" step="10" min="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. 500" />
            </div>

            <div>
              <label for="inp-sh-weeks" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Working Weeks per Year
              </label>
              <input type="number" id="inp-sh-weeks" value="48" step="1" min="1" max="52" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="48" />
            </div>
          </div>
        </div>

        <!-- Mode 4: Find Required Working Weeks -->
        <div id="sec-mode-solve-weeks" class="hidden space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="inp-sw-gross" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Target Annual Income (<span class="txt-cur-symbol">₹</span>)
              </label>
              <input type="number" id="inp-sw-gross" value="1000000" step="10000" min="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. 1,000,000" />
            </div>

            <div>
              <label for="inp-sw-wage" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Hourly Pay Rate (<span class="txt-cur-symbol">₹</span>/hr)
              </label>
              <input type="number" id="inp-sw-wage" value="500" step="10" min="0.1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. 500" />
            </div>

            <div>
              <label for="inp-sw-hours" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Hours per Week
              </label>
              <input type="number" id="inp-sw-hours" value="40" step="1" min="1" max="168" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="40" />
            </div>
          </div>
        </div>

        <!-- Mode 5: Net to Gross Income -->
        <div id="sec-mode-net-gross" class="hidden space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="inp-ng-net" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Desired Net Take-Home Income (<span class="txt-cur-symbol">₹</span>)
              </label>
              <input type="number" id="inp-ng-net" value="900000" step="10000" min="1" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="e.g. 900,000" />
            </div>

            <div>
              <label for="inp-ng-tax" class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                Estimated Tax Rate (%)
              </label>
              <input type="number" id="inp-ng-tax" value="10" step="0.5" min="0" max="99" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10" />
            </div>
          </div>
        </div>

        <!-- COMMON OPTIONS: UNPAID LEAVE & TAX RATE ACCORDION -->
        <div class="rounded-2xl border border-slate-200 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-900/50 space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span>⚙️</span> Additional Adjustments: Unpaid Leave &amp; Estimated Tax
          </span>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 text-xs">
            <div>
              <label for="inp-unpaid-weeks" class="block font-semibold text-slate-700 dark:text-slate-300">
                Unpaid Leave / Weeks Not Worked
              </label>
              <div class="mt-1 flex items-center gap-2">
                <input type="number" id="inp-unpaid-weeks" value="0" min="0" max="51" step="1" class="w-24 rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="0" />
                <span class="text-slate-500 dark:text-slate-400">weeks (deducted from 52 weeks)</span>
              </div>
            </div>

            <div>
              <label for="inp-tax-rate" class="block font-semibold text-slate-700 dark:text-slate-300">
                Estimated Tax &amp; Payroll Deduction Rate (%)
              </label>
              <div class="mt-1 flex items-center gap-2">
                <input type="number" id="inp-tax-rate" value="10" min="0" max="99.99" step="0.5" class="w-24 rounded-xl border border-slate-300 bg-white p-2 font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" placeholder="10" />
                <span class="text-slate-500 dark:text-slate-400">% (computes net take-home pay)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="flex items-center gap-2 pt-2">
          <button type="submit" id="btn-calc-income" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition active:scale-[0.98] cursor-pointer">
            Calculate Annual Income →
          </button>
          <button type="button" id="btn-clear-income" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer" title="Reset all inputs">
            Reset (✕)
          </button>
        </div>

        <!-- ACCESSIBLE ERROR -->
        <p id="err-income" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

      </form>

      <!-- RESULTS PRESENTATION SECTION -->
      <div id="income-results-section" class="mt-6 space-y-6">
        
        <!-- 1. MAIN RESULT HERO CARD -->
        <div class="overflow-hidden rounded-3xl border border-blue-200 bg-linear-to-br from-white via-blue-50/40 to-blue-100/50 p-5 shadow-lg shadow-blue-500/5 dark:border-blue-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-blue-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-blue-200/80 pb-4 dark:border-slate-800">
            <div>
              <span id="lbl-hero-title" class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">
                GROSS ANNUAL INCOME
              </span>
              <div id="res-hero-amount" class="mt-1 text-3xl sm:text-4xl lg:text-5xl font-black text-blue-600 dark:text-blue-400">
                ₹ 10,40,000.00
              </div>
              <div id="res-hero-subtitle" class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">
                Based on ₹500/hr × 40 hrs/wk × 52 weeks
              </div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Estimated Net Take-Home:</span>
              <div id="res-hero-net" class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400">
                ₹ 9,36,000.00
              </div>
              <div id="res-hero-tax-badge" class="text-xs font-bold text-slate-600 dark:text-slate-300 mt-0.5">
                Est. Tax: ₹ 1,04,000.00 (10%)
              </div>
            </div>
          </div>

          <!-- 6-Box Periodic Income Summary -->
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 text-xs">
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Hourly Rate</div>
              <div id="res-grid-hourly" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">₹ 500.00</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Daily (8 hrs)</div>
              <div id="res-grid-daily" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">₹ 4,000.00</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Weekly Gross</div>
              <div id="res-grid-weekly" class="mt-1 text-sm font-bold text-blue-600 dark:text-blue-400">₹ 20,000.00</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Bi-Weekly Gross</div>
              <div id="res-grid-biweekly" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">₹ 40,000.00</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Monthly Equiv.</div>
              <div id="res-grid-monthly" class="mt-1 text-sm font-bold text-emerald-600 dark:text-emerald-400">₹ 86,666.67</div>
            </div>
            <div class="rounded-xl border border-blue-200/60 bg-white/80 p-2.5 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Working Weeks</div>
              <div id="res-grid-weeks" class="mt-1 text-sm font-bold text-purple-600 dark:text-purple-400">52 weeks</div>
            </div>
          </div>
        </div>

        <!-- 2. STEP-BY-STEP CALCULATION BREAKDOWN -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-200 pb-3 dark:border-slate-800">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>📐</span> Step-by-Step Mathematical Breakdown
            </h3>
            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono" id="txt-breakdown-title">
              Hourly Wage to Annual Salary
            </span>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-950/40 space-y-2 text-xs font-mono">
            <div class="text-slate-600 dark:text-slate-400">
              Formula: <strong id="txt-breakdown-formula" class="text-slate-900 dark:text-white font-mono">Annual Income = Hourly Wage × Hours/Week × Working Weeks</strong>
            </div>
            <div id="box-breakdown-steps" class="pt-1 border-t border-slate-200/80 dark:border-slate-800 space-y-1.5">
              <!-- Steps injected dynamically -->
            </div>
          </div>
        </div>

        <!-- 3. SALARY FREQUENCY COMPARISON MATRIX & PDF EXPORT -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-2">
            <div>
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                <span>📊</span> Pay Frequency Breakdown (Gross vs. Net)
              </h3>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">
                Detailed earnings breakdown across hourly, daily, weekly, bi-weekly, monthly, and yearly pay cycles.
              </p>
            </div>

            <!-- Download PDF Button -->
            <button type="button" id="btn-download-pdf" class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 px-3.5 py-1.5 text-xs font-bold text-white shadow-xs transition active:scale-[0.98] cursor-pointer" title="Download calculation as PDF">
