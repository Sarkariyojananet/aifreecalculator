<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // State
  let lastCalculatedCi = null;
  let activeScheduleView = 'yearly'; // 'yearly' | 'monthly'

  // DOM Elements
  const inpCiP = document.getElementById('inp-ci-principal');
  const inpCiR = document.getElementById('inp-ci-rate');
  const inpCiDur = document.getElementById('inp-ci-duration');
  const selCiDurUnit = document.getElementById('sel-ci-dur-unit');
  const selCiFreq = document.getElementById('sel-ci-freq');

  const inpCiContrib = document.getElementById('inp-ci-contrib');
  const selCiContribFreq = document.getElementById('sel-ci-contrib-freq');
  const selCiContribTiming = document.getElementById('sel-ci-contrib-timing');

  const btnCalcCi = document.getElementById('btn-calc-ci');
  const btnClearCi = document.getElementById('btn-clear-ci');
  const errCi = document.getElementById('err-ci');

  // Results Elements
  const ciResultsSection = document.getElementById('ci-results-section');
  const resCiFutureVal = document.getElementById('res-ci-future-val');
  const resCiTotalInterest = document.getElementById('res-ci-total-interest');
  const resCiInitial = document.getElementById('res-ci-initial');
  const resCiContribTotal = document.getElementById('res-ci-contrib-total');
  const resCiTotalInvested = document.getElementById('res-ci-total-invested');
  const resCiRule72 = document.getElementById('res-ci-rule72');

  const barCiPrincipal = document.getElementById('bar-ci-principal');
  const barCiInterest = document.getElementById('bar-ci-interest');
  const lblChartPrincipal = document.getElementById('lbl-chart-principal');
  const lblChartInterest = document.getElementById('lbl-chart-interest');
  const txtCiExplanation = document.getElementById('txt-ci-explanation');

  const tabCiYearly = document.getElementById('tab-ci-yearly');
  const tabCiMonthly = document.getElementById('tab-ci-monthly');
  const btnCiDownloadPdf = document.getElementById('btn-ci-download-pdf');
  const txtBtnCiPdf = document.getElementById('txt-btn-ci-pdf');

  const ciSchedThead = document.getElementById('ci-sched-thead');
  const ciSchedTbody = document.getElementById('ci-sched-tbody');

  // Currency Formatter
  function formatINR(val) {
    return `₹ ${Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  // Calculation Engine
  function executeCiCalculation() {
    errCi.classList.add('hidden');

    const principal = parseFloat(inpCiP.value) || 0;
    const annualRate = parseFloat(inpCiR.value) || 0;
    const durationVal = parseFloat(inpCiDur.value) || 0;
    const durationUnit = selCiDurUnit.value; // 'years' | 'months'
    const compoundingFreq = selCiFreq.value; // 'annually' | 'quarterly' | 'monthly' | 'daily'

    const regularContribution = parseFloat(inpCiContrib.value) || 0;
    const contributionFreq = selCiContribFreq.value; // 'monthly' | 'yearly'
    const contributionTiming = selCiContribTiming.value; // 'end' | 'beginning'

    if (principal < 0 || regularContribution < 0) {
      errCi.textContent = 'Investment amounts cannot be negative.';
      errCi.classList.remove('hidden');
      ciResultsSection.classList.add('hidden');
      return;
    }

    if (principal === 0 && regularContribution === 0) {
      errCi.textContent = 'Please enter an initial principal or a regular contribution amount.';
      errCi.classList.remove('hidden');
      ciResultsSection.classList.add('hidden');
      return;
    }

    if (annualRate < 0) {
      errCi.textContent = 'Annual return rate cannot be negative.';
      errCi.classList.remove('hidden');
      ciResultsSection.classList.add('hidden');
      return;
    }

    if (durationVal <= 0) {
      errCi.textContent = 'Please enter a valid duration greater than 0.';
      errCi.classList.remove('hidden');
      ciResultsSection.classList.add('hidden');
      return;
    }

    let durationYears = durationVal;
    let durationMonths = durationVal * 12;

    if (durationUnit === 'months') {
      durationYears = durationVal / 12;
      durationMonths = durationVal;
    }

    const freqMap = { annually: 1, quarterly: 4, monthly: 12, daily: 365 };
    const n = freqMap[compoundingFreq] || 1;
    const r = annualRate / 100;

    const totalSimMonths = Math.max(1, Math.round(durationMonths));
    const yearlySchedule = [];
    const monthlySchedule = [];

    let currentBalance = principal;
    let totalPrincipalInvested = principal;
    let totalContributions = 0;

    const monthlyInterestRate = r > 0 ? Math.pow(1 + r / n, n / 12) - 1 : 0;

    let yearOpeningBalance = principal;
    let yearContributions = 0;
    let yearInterest = 0;

    for (let m = 1; m <= totalSimMonths; m++) {
      const monthOpening = currentBalance;
      let monthContribution = 0;

      if (regularContribution > 0) {
        if (contributionFreq === 'monthly') {
          monthContribution = regularContribution;
        } else if (contributionFreq === 'yearly' && m % 12 === 1) {
          monthContribution = regularContribution;
        }
      }

      let monthInterest = 0;

      if (contributionTiming === 'beginning') {
        currentBalance += monthContribution;
        monthInterest = currentBalance * monthlyInterestRate;
        currentBalance += monthInterest;
      } else {
        monthInterest = currentBalance * monthlyInterestRate;
        currentBalance += monthInterest;
        currentBalance += monthContribution;
      }

      totalContributions += monthContribution;
      totalPrincipalInvested += monthContribution;

      yearContributions += monthContribution;
      yearInterest += monthInterest;

      monthlySchedule.push({
        month: m,
        openingBalance: monthOpening,
        contribution: monthContribution,
        interestEarned: monthInterest,
        closingBalance: currentBalance,
      });

      if (m % 12 === 0 || m === totalSimMonths) {
        const yearIndex = Math.ceil(m / 12);
        const totalInterestSoFar = currentBalance - totalPrincipalInvested;

        yearlySchedule.push({
          year: yearIndex,
          openingBalance: yearOpeningBalance,
          contributionsDuringYear: yearContributions,
          interestEarned: yearInterest,
          closingBalance: currentBalance,
          totalInvestedSoFar: totalPrincipalInvested,
          totalInterestSoFar: Math.max(0, totalInterestSoFar),
        });

        yearOpeningBalance = currentBalance;
        yearContributions = 0;
        yearInterest = 0;
      }
    }

    const estimatedFutureValue = currentBalance;
    const totalInterestEarned = Math.max(0, estimatedFutureValue - totalPrincipalInvested);
    const rule72 = annualRate > 0 ? (72 / annualRate).toFixed(1) : 0;

    // Save calculation state
    lastCalculatedCi = {
      principal,
      annualRate,
      durationYears,
      durationMonths: totalSimMonths,
      durationLabel: durationUnit === 'years' ? `${durationVal} Years` : `${durationVal} Months (${durationYears.toFixed(2)} Yrs)`,
      compoundingFreq,
      n,
      regularContribution,
      contributionFreq,
      contributionTiming,
      totalContributions,
      totalPrincipalInvested,
      totalInterestEarned,
      estimatedFutureValue,
      rule72,
      yearlySchedule,
      monthlySchedule,
    };

    // Update Result Card
    resCiFutureVal.textContent = formatINR(estimatedFutureValue);
    resCiTotalInterest.textContent = formatINR(totalInterestEarned);
    resCiInitial.textContent = formatINR(principal);
    resCiContribTotal.textContent = formatINR(totalContributions);
    resCiTotalInvested.textContent = formatINR(totalPrincipalInvested);
    resCiRule72.textContent = `${rule72} Years`;

    // Update Chart & Ratio Bar
    const totalPie = estimatedFutureValue > 0 ? estimatedFutureValue : 1;
    const principalPct = ((totalPrincipalInvested / totalPie) * 100).toFixed(1);
    const interestPct = ((totalInterestEarned / totalPie) * 100).toFixed(1);

    barCiPrincipal.style.width = `${principalPct}%`;
    barCiInterest.style.width = `${interestPct}%`;

    lblChartPrincipal.textContent = `Principal Invested: ${formatINR(totalPrincipalInvested)} (${principalPct}%)`;
    lblChartInterest.textContent = `Compound Interest: ${formatINR(totalInterestEarned)} (${interestPct}%)`;

    // Dynamic Explanation
    let freqLabel = 'annually';
    if (compoundingFreq === 'quarterly') freqLabel = 'quarterly (4 times/yr)';
    else if (compoundingFreq === 'monthly') freqLabel = 'monthly (12 times/yr)';
    else if (compoundingFreq === 'daily') freqLabel = 'daily (365 times/yr)';

    let contribText = '';
    if (regularContribution > 0) {
      contribText = ` with ${formatINR(regularContribution)} ${contributionFreq} additions (${contributionTiming} of period)`;
    }

    txtCiExplanation.textContent = `Initial investment of ${formatINR(principal)}${contribText} compounded ${freqLabel} at ${annualRate}% p.a. over ${lastCalculatedCi.durationLabel}.`;

    // Render Schedule
    renderScheduleTable();

    ciResultsSection.classList.remove('hidden');
  }

  // Render Active Schedule Table
  function renderScheduleTable() {
    if (!lastCalculatedCi) return;

    if (activeScheduleView === 'yearly') {
      ciSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Year</th>
          <th class="p-2.5 text-right">Opening Balance</th>
          <th class="p-2.5 text-right">Contributions</th>
          <th class="p-2.5 text-right">Interest Earned</th>
          <th class="p-2.5 text-right">Invested So Far</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Closing Balance</th>
        </tr>
      `;

      ciSchedTbody.innerHTML = lastCalculatedCi.yearlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Year ${row.year}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.contributionsDuringYear)}</td>
          <td class="p-2.5 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatINR(row.interestEarned)}</td>
          <td class="p-2.5 text-right text-blue-600 dark:text-blue-400 font-semibold">${formatINR(row.totalInvestedSoFar)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    } else {
      ciSchedThead.innerHTML = `
        <tr>
          <th class="p-2.5 rounded-l-lg">Month</th>
          <th class="p-2.5 text-right">Opening Balance</th>
          <th class="p-2.5 text-right">Contribution</th>
          <th class="p-2.5 text-right">Monthly Interest</th>
          <th class="p-2.5 text-right rounded-r-lg font-bold text-slate-900 dark:text-white">Closing Balance</th>
        </tr>
      `;

      ciSchedTbody.innerHTML = lastCalculatedCi.monthlySchedule.map((row) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <td class="p-2.5 font-bold text-slate-900 dark:text-white">Month ${row.month}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.openingBalance)}</td>
          <td class="p-2.5 text-right text-slate-600 dark:text-slate-400">${formatINR(row.contribution)}</td>
          <td class="p-2.5 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatINR(row.interestEarned)}</td>
          <td class="p-2.5 text-right font-black text-slate-900 dark:text-white">${formatINR(row.closingBalance)}</td>
        </tr>
      `).join('');
    }
  }

  // Switch Schedule Tabs
  tabCiYearly.addEventListener('click', () => {
    activeScheduleView = 'yearly';
    tabCiYearly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabCiMonthly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  tabCiMonthly.addEventListener('click', () => {
    activeScheduleView = 'monthly';
    tabCiMonthly.className = 'active rounded-lg bg-white px-3 py-1 text-slate-900 shadow-xs dark:bg-slate-900 dark:text-white cursor-pointer';
    tabCiYearly.className = 'rounded-lg px-3 py-1 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer';
    renderScheduleTable();
  });

  btnCalcCi.addEventListener('click', executeCiCalculation);

  btnClearCi.addEventListener('click', () => {
    inpCiP.value = '100000';
    inpCiR.value = '10';
    inpCiDur.value = '10';
    selCiDurUnit.value = 'years';
    selCiFreq.value = 'annually';
    inpCiContrib.value = '0';
    selCiContribFreq.value = 'monthly';
    selCiContribTiming.value = 'end';
    errCi.classList.add('hidden');
    ciResultsSection.classList.add('hidden');
    lastCalculatedCi = null;
    activeScheduleView = 'yearly';
    tabCiYearly.click();
  });

  // Preset Buttons Listener
  document.querySelectorAll('.btn-ci-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-p');
      const r = btn.getAttribute('data-r');
      const t = btn.getAttribute('data-t');
      const u = btn.getAttribute('data-u');
      const f = btn.getAttribute('data-f');
      const c = btn.getAttribute('data-c');
      const cf = btn.getAttribute('data-cf');
      const ct = btn.getAttribute('data-ct');

      if (p) inpCiP.value = p;
      if (r) inpCiR.value = r;
      if (t) inpCiDur.value = t;
      if (u) selCiDurUnit.value = u;
      if (f) selCiFreq.value = f;
      if (c) inpCiContrib.value = c;
      if (cf) selCiContribFreq.value = cf;
      if (ct) selCiContribTiming.value = ct;
    });
  });

  // Enter Key Listener
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeCiCalculation();
        }
      });
    });
  });

  // Tab-Selective PDF Download
  async function generateCiPdf() {
    if (!lastCalculatedCi) {
      alert('Please calculate compound interest first.');
      return;
    }

    btnCiDownloadPdf.disabled = true;
    const originalText = txtBtnCiPdf.textContent;
    txtBtnCiPdf.textContent = 'Generating PDF...';

    try {
      if (!window.jspdf) {
        await new Promise((resolve, reject) => {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js';
            s2.onload = resolve;
            s2.onerror = reject;
            document.head.appendChild(s2);
          };
          s1.onerror = reject;
          document.head.appendChild(s1);
        });
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

      // 1. Header Branding
      doc.setFillColor(37, 99, 235); // Blue #2563eb
      doc.rect(0, 0, 210, 20, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15);
      doc.setFont('helvetica', 'bold');
      doc.text('AIFreecalculator.com', 14, 13);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.text('Free Online Calculator Tools', 210 - 14, 13, { align: 'right' });

      // 2. Document Title
      const pdfTitle = activeScheduleView === 'yearly'
        ? 'Compound Interest Growth – Yearly Summary'
        : 'Compound Interest Growth – Monthly Schedule';

      doc.setTextColor(15, 23, 42);
      doc.setFontSize(13);
      doc.setFont('helvetica', 'bold');
      doc.text(pdfTitle, 14, 29);

      doc.setFontSize(8);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Generated on: ${dateStr}`, 210 - 14, 29, { align: 'right' });

      // 3. Calculation Summary Box
      doc.setDrawColor(226, 232, 240);
      doc.setFillColor(248, 250, 252);
      doc.roundedRect(14, 33, 182, 28, 2, 2, 'FD');

      doc.setFontSize(8);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(51, 65, 85);
      doc.text('CALCULATION SUMMARY', 18, 38);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(71, 85, 105);
      doc.text(`Initial Investment: Rs. ${lastCalculatedCi.principal.toLocaleString('en-IN')}`, 18, 44);
      doc.text(`Annual Rate: ${lastCalculatedCi.annualRate}% p.a.`, 18, 49);
      doc.text(`Duration: ${lastCalculatedCi.durationLabel}`, 18, 54);
      doc.text(`Compounding: ${lastCalculatedCi.compoundingFreq.toUpperCase()}`, 18, 59);

      doc.text(`Contributions: Rs. ${lastCalculatedCi.totalContributions.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 85, 44);
      doc.text(`Total Invested: Rs. ${lastCalculatedCi.totalPrincipalInvested.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 85, 49);
      doc.text(`View Mode: ${activeScheduleView === 'yearly' ? 'Yearly Summary' : 'Monthly Schedule'}`, 85, 54);

      doc.setFont('helvetica', 'bold');
      doc.setTextColor(16, 185, 129);
      doc.text(`Interest Earned: Rs. ${lastCalculatedCi.totalInterestEarned.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 140, 46);
      doc.setTextColor(37, 99, 235);
      doc.text(`Future Value: Rs. ${lastCalculatedCi.estimatedFutureValue.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`, 140, 52);

      // 4. Tab-Selective Table Data Generation
      let tableHead = [];
      let tableData = [];

      if (activeScheduleView === 'yearly') {
        tableHead = [['Year', 'Opening Bal', 'Contributions', 'Interest Earned', 'Total Invested', 'Closing Balance']];
        tableData = lastCalculatedCi.yearlySchedule.map((r) => [
          `Year ${r.year}`,
          'Rs. ' + r.openingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.contributionsDuringYear.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.interestEarned.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.totalInvestedSoFar.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.closingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        ]);
      } else {
        tableHead = [['Month', 'Opening Balance', 'Contribution', 'Monthly Interest', 'Closing Balance']];
        tableData = lastCalculatedCi.monthlySchedule.map((r) => [
          `Month ${r.month}`,
          'Rs. ' + r.openingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.contribution.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.interestEarned.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
          'Rs. ' + r.closingBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        ]);
      }

      doc.autoTable({
        startY: 65,
        head: tableHead,
        body: tableData,
        theme: 'grid',
        headStyles: {
          fillColor: [37, 99, 235],
          textColor: [255, 255, 255],
          fontSize: 8,
          fontStyle: 'bold',
          halign: 'center'
        },
        columnStyles: {
          0: { cellWidth: 25, halign: 'left', fontStyle: 'bold' },
          1: { halign: 'right' },
          2: { halign: 'right' },
          3: { halign: 'right', textColor: [16, 185, 129], fontStyle: 'bold' },
          4: { halign: 'right' },
          5: { halign: 'right', fontStyle: 'bold', textColor: [37, 99, 235] }
        },
        styles: {
          fontSize: 7.5,
          cellPadding: 2,
          font: 'helvetica'
        },
        alternateRowStyles: {
          fillColor: [248, 250, 252]
        },
        margin: { top: 22, bottom: 18, left: 14, right: 14 },
        didDrawPage: function (data) {
          const pageCount = doc.internal.getNumberOfPages();
          const currentPage = data.pageNumber;

          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');
          doc.setTextColor(148, 163, 184);

          doc.text('Generated using AIFreecalculator.com', 14, 290);
          doc.text(`Page ${currentPage} of ${pageCount}`, 210 - 14, 290, { align: 'right' });
        }
      });

      const today = new Date().toISOString().split('T')[0];
      const filename = activeScheduleView === 'yearly'
        ? `compound-interest-yearly-summary-${today}.pdf`
        : `compound-interest-monthly-schedule-${today}.pdf`;

      doc.save(filename);
    } catch (err) {
      console.error('PDF Generation Error:', err);
      alert('An error occurred while generating the PDF. Please try again.');
    } finally {
      btnCiDownloadPdf.disabled = false;
      txtBtnCiPdf.textContent = originalText;
    }
  }

  btnCiDownloadPdf.addEventListener('click', generateCiPdf);
</script>
