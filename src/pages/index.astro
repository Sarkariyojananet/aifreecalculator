---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import HomeFAQ, { homeFaqs } from '../components/home/HomeFAQ.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import AdSlotTop from '../components/ads/AdSlotTop.astro';
import AdSlotFooter from '../components/ads/AdSlotFooter.astro';
import { calculators } from '../data/calculators';
import { getCalculatorOverrides } from '../lib/admin/content-store';
import { getLivePageMeta } from '../lib/seo/page-metadata';

// Focused 8 popular calculators across core categories
const popularSlugs = [
  'emi-calculator',
  'sip-calculator',
  'income-tax-calculator',
  'rcc-slab-steel-calculator',
  'bmi-calculator',
  'age-calculator',
  'percentage-calculator',
  'calorie-calculator',
];

const popularCalculators = popularSlugs
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter(Boolean) as typeof calculators;

const overrides = await getCalculatorOverrides(Astro.locals);
const override = overrides['core:home'] || {};
const liveMeta = getLivePageMeta('core:home');

const effectiveTitle = override.metaTitle || liveMeta.title;
const effectiveDescription = override.metaDescription || liveMeta.description;
const effectiveCanonical = override.canonicalUrl;
const effectiveRobots = override.robots;

// Client-side search dataset
const searchDataJson = JSON.stringify(
  calculators.map((c) => ({
    name: c.name,
    category: c.category,
    desc: c.description,
    path: c.path,
    slug: c.slug,
    keywords: c.keywords || [],
    aliases: c.aliases || [],
  }))
);
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
  noindex={effectiveRobots?.includes('noindex')}
  ogImage="/og/default.png"
>
  <Fragment slot="head">
    <!-- WebSite, Organization & FAQPage JSON-LD Schema -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            name: 'AIFreeCalculator',
            url: 'https://aifreecalculator.com/',
            description: 'Free online calculators for finance, health, construction, education, percentages, conversions, time and everyday calculations.',
            potentialAction: {
              '@type': 'SearchAction',
              target: 'https://aifreecalculator.com/all-calculators/?q={search_term_string}',
              'query-input': 'required name=search_term_string',
            },
          },
          {
            '@type': 'Organization',
            name: 'AIFreeCalculator',
            url: 'https://aifreecalculator.com/',
            logo: 'https://aifreecalculator.com/favicon.svg',
          },
          {
            '@type': 'FAQPage',
            mainEntity: homeFaqs.map((faq) => ({
              '@type': 'Question',
              name: faq.question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: faq.answer,
              },
            })),
          },
        ],
      })}
    />
  </Fragment>

  <!-- 1. Hero Section + Prominent Search -->
  <HomeHero />

  <!-- 2. Recently Used Calculators (Localstorage, only shown if history exists) -->
  <section id="recently-used-section" class="hidden border-b border-slate-200 bg-slate-50/60 px-4 py-6 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-7xl space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Recently Used Calculators
        </h3>
        <button
          type="button"
          id="btn-clear-recents"
          class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition cursor-pointer"
        >
          Clear History ✕
        </button>
      </div>

      <div id="recently-used-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <!-- Populated via JS -->
      </div>
    </div>
  </section>

  <!-- Top Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotTop />
  </div>

  <!-- 3. Browse by Category -->
  <CategoryGrid />

  <!-- 4. Popular Calculators -->
  <section class="border-b border-slate-200 bg-white px-4 py-12 sm:py-16 dark:border-slate-800 dark:bg-slate-900/60" id="popular-calculators">
    <div class="mx-auto max-w-7xl">
      
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
            Popular Calculators
          </h2>
          <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">
            Frequently used tools for loan planning, investments, civil estimates, fitness, and daily calculations.
          </p>
        </div>

        <a
          href="/all-calculators/"
          class="text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400 shrink-0 self-start sm:self-auto"
        >
          View All {calculators.length}+ Tools →
        </a>
      </div>

      <!-- 8 Focused Cards Grid -->
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {popularCalculators.map((calculator, idx) => (
          <CalculatorCard calculator={calculator} featured={idx === 0} />
        ))}
      </div>

    </div>
  </section>

  <!-- 5. Compact Discovery: Explore All Calculators -->
  <section class="border-b border-slate-200 bg-slate-50/50 px-4 py-12 sm:py-16 dark:border-slate-800 dark:bg-slate-950/40" id="all-calculators">
    <div class="mx-auto max-w-3xl text-center space-y-4">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
        More Calculators for Everyday Tasks
      </h2>
      <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400 max-w-xl mx-auto">
        Explore 42+ calculators for finance, civil construction, health biometrics, mathematics, and everyday calculations.
      </p>

      <div class="pt-2">
        <a
          href="/all-calculators/"
          class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 transition"
        >
          <span>Browse All Calculators</span>
          <span>→</span>
        </a>
      </div>

      <!-- Category Quick Filter Pills -->
      <div class="pt-3 flex flex-wrap items-center justify-center gap-2 text-xs">
        <a href="/finance/" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-medium text-slate-600 hover:text-blue-600 hover:border-blue-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 transition">
          Finance (12)
        </a>
        <a href="/construction/" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-medium text-slate-600 hover:text-blue-600 hover:border-blue-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 transition">
          Construction (9)
        </a>
        <a href="/health/" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-medium text-slate-600 hover:text-blue-600 hover:border-blue-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 transition">
          Health (4)
        </a>
        <a href="/math/" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-medium text-slate-600 hover:text-blue-600 hover:border-blue-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 transition">
          Math (5)
        </a>
        <a href="/general/" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-medium text-slate-600 hover:text-blue-600 hover:border-blue-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 transition">
          General (6)
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Why Use This Website -->
  <WhyChooseUs />

  <!-- 7. Concise Informational Content -->
  <section class="border-b border-slate-200 bg-white px-4 py-12 sm:py-16 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-3xl space-y-4 text-slate-700 dark:text-slate-300 text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">
        About Our Online Calculators
      </h2>
      <p>
        AIFreeCalculator is an open collection of practical calculation tools created to solve common math, financial, engineering, and personal planning questions. Whether you are calculating monthly loan installments, checking structural reinforcement for civil construction, or planning a fitness goal, each tool is designed to provide quick, understandable answers without unnecessary steps.
      </p>
      <p>
        Every calculator runs directly in your web browser. This means your numbers, financial figures, and measurements remain private on your own device and are never sent to external servers. Formulas are aligned with standard engineering codes (such as IS 456 for concrete and steel) and verified mathematical models to ensure dependable estimates.
      </p>
    </div>
  </section>

  <!-- 8. FAQ Section with Accordion + JSON-LD Schema -->
  <HomeFAQ />

  <!-- Bottom Ad Slot -->
  <div class="mx-auto max-w-7xl px-4 py-4">
    <AdSlotFooter />
  </div>

  <!-- Embedded Search Data -->
  <script is:inline define:vars={{ searchDataJson }}>
    window.__CALCULATORS_SEARCH_DATA__ = JSON.parse(searchDataJson);
  </script>

  <!-- Client-side Smart Search & Recent History Engine -->
  <script is:inline>
    (function initHomeSearch() {
      const searchInput = document.getElementById('home-main-search');
      const searchClear = document.getElementById('home-search-clear');
      const searchDropdown = document.getElementById('home-search-dropdown');
      const dropdownItems = document.getElementById('home-dropdown-items');
      const matchCountLabel = document.getElementById('home-match-count');
      const quickTags = document.querySelectorAll('.home-quick-tag');

      const data = window.__CALCULATORS_SEARCH_DATA__ || [];

      let searchLogTimer = null;
      function logSearch(query, hasResults) {
        if (!query || query.length < 2) return;
        clearTimeout(searchLogTimer);
        searchLogTimer = setTimeout(() => {
          try {
            fetch('/api/search-log', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ query: query, hasResults: Boolean(hasResults) }),
            }).catch(() => {});
          } catch {}
        }, 700);
      }

      function filterSearch(query) {
        const q = (query || '').toLowerCase().trim();
        if (!q) {
          if (searchDropdown) searchDropdown.classList.add('hidden');
          if (searchClear) {
            searchClear.classList.add('hidden');
            searchClear.classList.remove('flex');
          }
          return;
        }

        if (searchClear) {
          searchClear.classList.remove('hidden');
          searchClear.classList.add('flex');
        }

        const matches = data.filter((item) => {
          const nameMatch = item.name.toLowerCase().includes(q);
          const catMatch = item.category.toLowerCase().includes(q);
          const descMatch = (item.desc || '').toLowerCase().includes(q);
          const kwMatch = (item.keywords || []).some((k) => k.toLowerCase().includes(q));
          const aliasMatch = (item.aliases || []).some((a) => a.toLowerCase().includes(q));
          return nameMatch || catMatch || descMatch || kwMatch || aliasMatch;
        });

        if (q) {
          logSearch(q, matches.length > 0);
        }

        if (matchCountLabel) {
          matchCountLabel.textContent = `${matches.length} ${matches.length === 1 ? 'calculator' : 'calculators'} match`;
        }

        if (dropdownItems) {
          if (matches.length === 0) {
            dropdownItems.innerHTML = `
              <div class="py-6 text-center text-xs text-slate-500 dark:text-slate-400">
                <p class="font-bold text-slate-700 dark:text-slate-200 text-sm">No calculators matching "${q}"</p>
                <p class="mt-1">Try keywords like 'EMI', 'Slab', 'Sariya', 'Tax', 'BMI', or 'Percentage'</p>
              </div>
            `;
          } else {
            dropdownItems.innerHTML = matches.slice(0, 7).map((item) => `
              <a
                href="${item.path}"
                class="flex items-center justify-between p-2.5 rounded-lg transition hover:bg-slate-50 dark:hover:bg-slate-800/80 group"
              >
                <div class="min-w-0 pr-3">
                  <div class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">
                    ${item.name}
                  </div>
                  <div class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 mt-0.5">
                    ${item.desc}
                  </div>
                </div>
                <div class="shrink-0 flex items-center gap-1.5">
                  <span class="rounded bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    ${item.category}
                  </span>
                  <span class="text-slate-400 text-xs group-hover:translate-x-0.5 transition-transform">→</span>
                </div>
              </a>
            `).join('');
          }
        }

        if (searchDropdown) searchDropdown.classList.remove('hidden');
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => filterSearch(e.target.value));
        searchInput.addEventListener('focus', () => {
          if (searchInput.value.trim()) filterSearch(searchInput.value);
        });
      }

      if (searchClear) {
        searchClear.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            searchInput.focus();
            filterSearch('');
          }
        });
      }

      quickTags.forEach((btn) => {
        btn.addEventListener('click', () => {
          const q = btn.getAttribute('data-query') || '';
          if (searchInput) {
            searchInput.value = q;
            searchInput.focus();
            filterSearch(q);
          }
        });
      });

      document.addEventListener('click', (e) => {
        if (!searchInput?.contains(e.target) && !searchDropdown?.contains(e.target)) {
          if (searchDropdown) searchDropdown.classList.add('hidden');
        }
      });

      // Escape key closes search dropdown
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && searchDropdown) {
          searchDropdown.classList.add('hidden');
        }
      });

      // 2. Recently Used Calculators (Localstorage)
      const recentsSection = document.getElementById('recently-used-section');
      const recentsGrid = document.getElementById('recently-used-grid');
      const btnClearRecents = document.getElementById('btn-clear-recents');

      try {
        const rawHistory = localStorage.getItem('recent_calculators');
        if (rawHistory && recentsSection && recentsGrid) {
          const recentSlugs = JSON.parse(rawHistory);
          if (Array.isArray(recentSlugs) && recentSlugs.length > 0) {
            const matchedTools = recentSlugs
              .map((slug) => data.find((d) => d.slug === slug || d.slug === `${slug}-calculator`))
              .filter(Boolean)
              .slice(0, 5);

            if (matchedTools.length > 0) {
              recentsGrid.innerHTML = matchedTools.map((t) => `
                <a
                  href="${t.path}"
                  class="flex items-center justify-between rounded-lg border border-slate-200 bg-white p-2.5 shadow-2xs hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900 transition group"
                >
                  <div class="min-w-0 pr-2">
                    <div class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">${t.name}</div>
                    <div class="text-[10px] text-slate-400">${t.category}</div>
                  </div>
                  <span class="text-slate-400 text-xs shrink-0 group-hover:translate-x-0.5 transition-transform">→</span>
                </a>
              `).join('');

              recentsSection.classList.remove('hidden');
            }
          }
        }
      } catch {}

      btnClearRecents?.addEventListener('click', () => {
        try {
          localStorage.removeItem('recent_calculators');
        } catch {}
        if (recentsSection) recentsSection.classList.add('hidden');
      });
    })();
  </script>
</BaseLayout>
