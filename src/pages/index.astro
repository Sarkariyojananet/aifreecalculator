  <!-- Client-side Interactive Search & Category Filter Script inside BaseLayout -->
  <script is:inline>
    (function initHomePageEngine() {
      const searchInput = document.getElementById('main-calculator-search');
      const searchClearBtn = document.getElementById('hero-search-clear');
      const searchDropdown = document.getElementById('hero-search-dropdown');
      const dropdownItems = document.getElementById('hero-dropdown-items');
      const matchCountLabel = document.getElementById('hero-match-count');
      const jumpDirectoryBtn = document.getElementById('hero-jump-directory-btn');

      const items = Array.from(document.querySelectorAll('.calculator-item'));
      const noResults = document.getElementById('no-results');
      const filterBtns = Array.from(document.querySelectorAll('.directory-filter-btn'));
      const directoryCountLabel = document.getElementById('directory-count-label');
      const resetFilterBtn = document.getElementById('reset-filter-btn');
      const quickSuggestBtns = Array.from(document.querySelectorAll('.quick-suggest-btn'));

      let activeCategory = 'all';
      let currentQuery = '';

      function filterDirectory() {
        let matchCount = 0;
        const q = currentQuery.toLowerCase().trim();

        items.forEach((item) => {
          const name = item.getAttribute('data-name') || '';
          const cat = item.getAttribute('data-category') || '';
          const kw = item.getAttribute('data-keywords') || '';
          const desc = item.getAttribute('data-desc') || '';

          const matchCat = activeCategory === 'all' || cat === activeCategory.toLowerCase();
          const matchQ = !q || name.includes(q) || cat.includes(q) || kw.includes(q) || desc.includes(q);

          if (matchCat && matchQ) {
            item.classList.remove('hidden');
            matchCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (noResults) {
          if (matchCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }

        if (directoryCountLabel) {
          if (!q && activeCategory === 'all') {
            directoryCountLabel.textContent = `Showing all ${items.length} calculators`;
          } else if (q && activeCategory !== 'all') {
            directoryCountLabel.textContent = `Found ${matchCount} ${activeCategory} calculators for "${q}"`;
          } else if (q) {
            directoryCountLabel.textContent = `Found ${matchCount} calculators matching "${q}"`;
          } else {
            directoryCountLabel.textContent = `Showing ${matchCount} ${activeCategory} calculators`;
          }
        }

        if (resetFilterBtn) {
          if (q || activeCategory !== 'all') {
            resetFilterBtn.classList.remove('hidden');
          } else {
            resetFilterBtn.classList.add('hidden');
          }
        }
      }

      function updateHeroDropdown() {
        const q = currentQuery.toLowerCase().trim();
        if (!q) {
          if (searchDropdown) searchDropdown.classList.add('hidden');
          if (searchClearBtn) searchClearBtn.classList.add('hidden');
          return;
        }

        if (searchClearBtn) searchClearBtn.classList.remove('hidden');

        const allData = window.__CALCULATORS_DATA__ || [];
        const matches = allData.filter((c) => {
          const nameMatch = c.name.toLowerCase().includes(q);
          const descMatch = (c.desc || '').toLowerCase().includes(q);
          const kwMatch = (c.keywords || []).some((k) => k.toLowerCase().includes(q));
          const catMatch = c.category.toLowerCase().includes(q);
          return nameMatch || descMatch || kwMatch || catMatch;
        });

        if (matchCountLabel) {
          matchCountLabel.textContent = `${matches.length} ${matches.length === 1 ? 'tool' : 'tools'} match`;
        }

        if (dropdownItems) {
          if (matches.length === 0) {
            dropdownItems.innerHTML = `
              <div class="py-4 text-center text-xs text-slate-400">
                <p class="font-semibold text-slate-600 dark:text-slate-300">No calculators found for "${q}"</p>
                <p class="mt-0.5">Try searching 'EMI', 'Concrete', 'Tax', or 'BMI'</p>
              </div>
            `;
          } else {
            dropdownItems.innerHTML = matches.slice(0, 5).map((item) => `
              <a
                href="${item.path}"
                class="flex items-center justify-between p-2.5 rounded-xl transition hover:bg-blue-50/80 dark:hover:bg-slate-800/80 group"
              >
                <div class="flex items-center gap-2.5 min-w-0 pr-2">
                  <span class="text-xl shrink-0 p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800">${item.icon}</span>
                  <div class="min-w-0">
                    <div class="font-bold text-xs text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">
                      ${item.name}
                    </div>
                    <div class="text-[11px] text-slate-400 line-clamp-1">
                      ${item.desc}
                    </div>
                  </div>
                </div>
                <div class="shrink-0 flex items-center gap-1">
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    ${item.category}
                  </span>
                  <span class="text-slate-400 text-xs group-hover:translate-x-0.5 transition-transform">→</span>
                </div>
              </a>
            `).join('');
          }
        }

        if (searchDropdown) searchDropdown.classList.remove('hidden');
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          filterDirectory();
          updateHeroDropdown();
        });

        searchInput.addEventListener('focus', () => {
          if (currentQuery.trim()) {
            updateHeroDropdown();
          }
        });

        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (searchDropdown) searchDropdown.classList.add('hidden');
          } else if (e.key === 'Enter') {
            if (searchDropdown) searchDropdown.classList.add('hidden');
            const target = document.getElementById('all-calculators');
            if (target) target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }

      if (searchClearBtn) {
        searchClearBtn.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            currentQuery = '';
            searchInput.focus();
          }
          filterDirectory();
          updateHeroDropdown();
        });
      }

      if (jumpDirectoryBtn) {
        jumpDirectoryBtn.addEventListener('click', () => {
          if (searchDropdown) searchDropdown.classList.add('hidden');
          const target = document.getElementById('all-calculators');
          if (target) target.scrollIntoView({ behavior: 'smooth' });
        });
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!searchInput?.contains(e.target) && !searchDropdown?.contains(e.target)) {
          if (searchDropdown) searchDropdown.classList.add('hidden');
        }
      });

      // Category filter buttons in directory
      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.className = 'directory-filter-btn inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 transition-all';
          });
          btn.className = 'directory-filter-btn active inline-flex shrink-0 items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold transition-all bg-blue-600 text-white shadow-md shadow-blue-500/20';

          activeCategory = btn.getAttribute('data-category') || 'all';
          filterDirectory();
        });
      });

      // Reset filter button
      if (resetFilterBtn) {
        resetFilterBtn.addEventListener('click', () => {
          activeCategory = 'all';
          currentQuery = '';
          if (searchInput) searchInput.value = '';
          if (searchClearBtn) searchClearBtn.classList.add('hidden');
          if (searchDropdown) searchDropdown.classList.add('hidden');

          filterBtns.forEach((b) => {
            if (b.getAttribute('data-category') === 'all') {
              b.className = 'directory-filter-btn active inline-flex shrink-0 items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold transition-all bg-blue-600 text-white shadow-md shadow-blue-500/20';
            } else {
              b.className = 'directory-filter-btn inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 hover:border-slate-300 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 transition-all';
            }
          });

          filterDirectory();
        });
      }

      // Quick suggest buttons in empty state
      quickSuggestBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const q = btn.getAttribute('data-query') || '';
          currentQuery = q;
          if (searchInput) {
            searchInput.value = q;
            searchInput.focus();
          }
          filterDirectory();
        });
      });
    })();
  </script>
</BaseLayout>