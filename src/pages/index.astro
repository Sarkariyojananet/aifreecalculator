---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import ConstructionSpotlight from '../components/home/ConstructionSpotlight.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import HomeFAQ, { homeFaqs } from '../components/home/HomeFAQ.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import AdSlotTop from '../components/ads/AdSlotTop.astro';
import AdSlotFooter from '../components/ads/AdSlotFooter.astro';
import {
  calculators,
  getPopularCalculators,
  getFeaturedCalculators,
} from '../data/calculators';

const popularCalculators = getPopularCalculators(6);
const featuredCalculators = getFeaturedCalculators().filter(
  (c) => !popularCalculators.some((p) => p.slug === c.slug)
).slice(0, 6);

// Client-side search dataset with aliases
const searchDataJson = JSON.stringify(
  calculators.map((c) => ({
    name: c.name,
    category: c.category,
    desc: c.description,
    icon: c.icon,
    path: c.path,
    slug: c.slug,
    keywords: c.keywords || [],
    aliases: c.aliases || [],
  }))
);
---

<BaseLayout
  title="Free Online Calculators for Finance, Health, Construction & Math | AIFreeCalculator"
  description="Calculate loans, investments, civil engineering quantities, health biometrics, percentages, and scientific math with 42+ verified free online calculators."
  ogImage="/og/default.png"
>
  <Fragment slot="head">
    <!-- WebSite, Organization & FAQPage JSON-LD Schema -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            name: 'AIFreeCalculator',
            url: 'https://aifreecalculator.com/',
            description: 'Free online calculators for finance, health, construction, education, percentages, conversions, time and everyday calculations.',
            potentialAction: {
              '@type': 'SearchAction',
              target: 'https://aifreecalculator.com/?q={search_term_string}',
              'query-input': 'required name=search_term_string',
            },
          },
          {
            '@type': 'Organization',
            name: 'AIFreeCalculator',
            url: 'https://aifreecalculator.com/',
            logo: 'https://aifreecalculator.com/favicon.svg',
          },
          {
            '@type': 'FAQPage',
            mainEntity: homeFaqs.map((faq) => ({
              '@type': 'Question',
              name: faq.question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: faq.answer,
              },
            })),
          },
        ],
      })}
    />
  </Fragment>

  <!-- 1. Hero Section + Smart Search -->
  <HomeHero />

  <!-- 2. Recently Used Calculators (Client-Side LocalStorage, Non-blocking) -->
  <section id="recently-used-section" class="hidden border-b border-slate-200/80 bg-blue-50/30 px-4 py-8 dark:border-slate-800 dark:bg-slate-900/30">
    <div class="mx-auto max-w-7xl space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-sm">🕒</span>
          <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
            Recently Used Calculators
          </h3>
        </div>
        <button
          type="button"
          id="btn-clear-recents"
          class="text-[11px] font-bold text-slate-400 hover:text-red-600 dark:hover:text-red-400 transition cursor-pointer"
        >
          Clear History ✕
        </button>
      </div>

      <div id="recently-used-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <!-- Injected via JavaScript from localStorage -->
      </div>
    </div>
  </section>

  <!-- Top Ad Slot (Safe Non-intrusive Placement) -->
  <div class="mx-auto max-w-7xl px-4">
    <AdSlotTop />
  </div>

  <!-- 3. Popular / Most Used Calculators -->
  <section class="border-b border-slate-200/80 bg-white px-4 py-14 sm:py-18 dark:border-slate-800 dark:bg-slate-900/40" id="popular-calculators">
    <div class="mx-auto max-w-7xl space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">
            <span>🔥</span> High Utility Tools
          </div>
          <h2 class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            Popular Calculators
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Most frequently used tools for loan planning, wealth accumulation, engineering estimates, and wellness.
          </p>
        </div>

        <a
          href="/general/"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 hover:underline dark:text-blue-400 shrink-0 self-start sm:self-auto"
        >
          <span>View All Categories</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {popularCalculators.map((calculator) => (
          <CalculatorCard calculator={calculator} />
        ))}
      </div>

    </div>
  </section>

  <!-- 4. Browse By Category -->
  <CategoryGrid />

  <!-- 5. Construction Calculator Spotlight -->
  <ConstructionSpotlight />

  <!-- 6. Featured & Daily Utilities Discovery -->
  <section class="border-b border-slate-200/80 bg-slate-50/70 px-4 py-14 sm:py-18 dark:border-slate-800 dark:bg-slate-950/60" id="featured-calculators">
    <div class="mx-auto max-w-7xl space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
            <span>⭐</span> Everyday Calculations
          </div>
          <h2 class="mt-2 text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            Featured Calculation Engines
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Handy calculation engines for salary breakdowns, compound interest compounding, daily calories, and math.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featuredCalculators.map((calculator) => (
          <CalculatorCard calculator={calculator} />
        ))}
      </div>

    </div>
  </section>

  <!-- 7. Why Use AI Free Calculator -->
  <WhyChooseUs />

  <!-- 8. FAQ Section with Accordion + JSON-LD Schema -->
  <HomeFAQ />

  <!-- 9. Compact SEO Summary & Internal Linking -->
  <section class="border-t border-slate-200/80 bg-white px-4 py-14 dark:border-slate-800 dark:bg-slate-900/30">
    <div class="mx-auto max-w-4xl space-y-10 text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
      
      <div class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
          Free, Accurate Calculation Utilities for Work, Study &amp; Daily Planning
        </h2>
        <p>
          AIFreeCalculator.com delivers a centralized directory of 42+ verified calculation tools. Whether calculating monthly EMI payments for personal loans, estimating mutual fund SIP compounding, checking body mass index (BMI) thresholds, or calculating structural bar bending schedules (BBS) for RCC slabs and beams, each tool operates instantly and privately in your browser.
        </p>
      </div>

      <!-- Quick Category Directory Links -->
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 text-xs sm:text-sm">
        <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <span>💰</span> <a href="/finance/" class="hover:text-blue-600 dark:hover:text-blue-400 underline decoration-slate-300">Finance &amp; Banking Calculators</a>
          </h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs">
            Loan EMI schedules, SIP wealth forecasting, GST, Indian income tax comparisons, and salary estimators.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <span>🏗️</span> <a href="/construction/" class="hover:text-blue-600 dark:hover:text-blue-400 underline decoration-slate-300">Civil &amp; Construction Calculators</a>
          </h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs">
            RCC slab and beam steel weight, concrete mix dry volume (1.54), brickwork mortar counts, and plastering BOQ.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <span>❤️</span> <a href="/health/" class="hover:text-blue-600 dark:hover:text-blue-400 underline decoration-slate-300">Health &amp; Fitness Calculators</a>
          </h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs">
            Basal Metabolic Rate (BMR), daily calorie needs (TDEE), and US Navy body fat percentage tools.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
            <span>📐</span> <a href="/math/" class="hover:text-blue-600 dark:hover:text-blue-400 underline decoration-slate-300">Math &amp; General Utilities</a>
          </h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs">
            Academic GPA planning, percentage changes, date difference calculators, and scientific math tools.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Bottom Ad Slot -->
  <div class="mx-auto max-w-7xl px-4">
    <AdSlotFooter />
  </div>

  <!-- Embedded Search Data -->
  <script is:inline define:vars={{ searchDataJson }}>
    window.__CALCULATORS_SEARCH_DATA__ = JSON.parse(searchDataJson);
  </script>

  <!-- Lightweight Client Engine (Smart Search & Recently Used) -->
  <script is:inline>
    (function initHomeSmartEngine() {
      const searchInput = document.getElementById('home-main-search');
      const searchClear = document.getElementById('home-search-clear');
      const searchDropdown = document.getElementById('home-search-dropdown');
      const dropdownItems = document.getElementById('home-dropdown-items');
      const matchCountLabel = document.getElementById('home-match-count');
      const quickTags = document.querySelectorAll('.home-quick-tag');

      const data = window.__CALCULATORS_SEARCH_DATA__ || [];

      let homeSearchLogTimer = null;
      function logHomeSearch(query, hasResults) {
        if (!query || query.length < 2) return;
        clearTimeout(homeSearchLogTimer);
        homeSearchLogTimer = setTimeout(() => {
          try {
            fetch('/api/search-log', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ query: query, hasResults: Boolean(hasResults) }),
            }).catch(() => {});
          } catch {}
        }, 700);
      }

      // 1. Smart Search Filter Function
      function filterSearch(query) {
        const q = (query || '').toLowerCase().trim();
        if (!q) {
          if (searchDropdown) searchDropdown.classList.add('hidden');
          if (searchClear) searchClear.classList.add('hidden');
          return;
        }

        if (searchClear) searchClear.classList.remove('hidden');

        const matches = data.filter((item) => {
          const nameMatch = item.name.toLowerCase().includes(q);
          const catMatch = item.category.toLowerCase().includes(q);
          const descMatch = (item.desc || '').toLowerCase().includes(q);
          const kwMatch = (item.keywords || []).some((k) => k.toLowerCase().includes(q));
          const aliasMatch = (item.aliases || []).some((a) => a.toLowerCase().includes(q));
          return nameMatch || catMatch || descMatch || kwMatch || aliasMatch;
        });

        if (q) {
          logHomeSearch(q, matches.length > 0);
        }

        if (matchCountLabel) {
          matchCountLabel.textContent = `${matches.length} ${matches.length === 1 ? 'calculator' : 'calculators'} match`;
        }

        if (dropdownItems) {
          if (matches.length === 0) {
            dropdownItems.innerHTML = `
              <div class="py-6 text-center text-xs text-slate-400">
                <p class="font-bold text-slate-600 dark:text-slate-300 text-sm">No calculators matching "${q}"</p>
                <p class="mt-1">Try keywords like 'EMI', 'Slab', 'Sariya', 'Tax', 'BMI', or 'Mortar'</p>
              </div>
            `;
          } else {
            dropdownItems.innerHTML = matches.slice(0, 6).map((item) => `
              <a
                href="${item.path}"
                class="flex items-center justify-between p-3 rounded-xl transition hover:bg-blue-50/80 dark:hover:bg-slate-800/80 group"
              >
                <div class="flex items-center gap-3 min-w-0 pr-3">
                  <span class="text-2xl shrink-0 p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800">${item.icon}</span>
                  <div class="min-w-0">
                    <div class="font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">
                      ${item.name}
                    </div>
                    <div class="text-[11px] text-slate-400 line-clamp-1">
                      ${item.desc}
                    </div>
                  </div>
                </div>
                <div class="shrink-0 flex items-center gap-1.5">
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[9px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    ${item.category}
                  </span>
                  <span class="text-slate-400 text-xs group-hover:translate-x-1 transition-transform">→</span>
                </div>
              </a>
            `).join('');
          }
        }

        if (searchDropdown) searchDropdown.classList.remove('hidden');
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => filterSearch(e.target.value));
        searchInput.addEventListener('focus', () => {
          if (searchInput.value.trim()) filterSearch(searchInput.value);
        });
      }

      if (searchClear) {
        searchClear.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            searchInput.focus();
            filterSearch('');
          }
        });
      }

      quickTags.forEach((btn) => {
        btn.addEventListener('click', () => {
          const q = btn.getAttribute('data-query') || '';
          if (searchInput) {
            searchInput.value = q;
            searchInput.focus();
            filterSearch(q);
          }
        });
      });

      // Close dropdown on click outside
      document.addEventListener('click', (e) => {
        if (!searchInput?.contains(e.target) && !searchDropdown?.contains(e.target)) {
          if (searchDropdown) searchDropdown.classList.add('hidden');
        }
      });

      // 2. Recently Used Calculators (Localstorage only, non-blocking)
      const recentsSection = document.getElementById('recently-used-section');
      const recentsGrid = document.getElementById('recently-used-grid');
      const btnClearRecents = document.getElementById('btn-clear-recents');

      try {
        const rawHistory = localStorage.getItem('recent_calculators');
        if (rawHistory && recentsSection && recentsGrid) {
          const recentSlugs = JSON.parse(rawHistory);
          if (Array.isArray(recentSlugs) && recentSlugs.length > 0) {
            const matchedTools = recentSlugs
              .map((slug) => data.find((d) => d.slug === slug || d.slug === `${slug}-calculator`))
              .filter(Boolean)
              .slice(0, 5);

            if (matchedTools.length > 0) {
              recentsGrid.innerHTML = matchedTools.map((t) => `
                <a
                  href="${t.path}"
                  class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 shadow-xs hover:border-blue-400 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 transition group"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 shrink-0">${t.icon}</span>
                  <div class="min-w-0">
                    <div class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">${t.name}</div>
                    <div class="text-[10px] text-slate-400">${t.category}</div>
                  </div>
                </a>
              `).join('');

              recentsSection.classList.remove('hidden');
            }
          }
        }
      } catch {}

      btnClearRecents?.addEventListener('click', () => {
        try {
          localStorage.removeItem('recent_calculators');
        } catch {}
        if (recentsSection) recentsSection.classList.add('hidden');
      });
    })();
  </script>
</BaseLayout>
