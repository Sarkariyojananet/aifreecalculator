---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How do I convert WebP images to PNG online?",
    answer: "Drag and drop or select your WebP file. Our tool instantly decodes the WebP graphic and re-encodes it as a lossless PNG image inside your browser. Click Download PNG to save your converted file."
  },
  {
    question: "Does converting WebP to PNG preserve transparency?",
    answer: "Yes! The PNG format fully preserves alpha channel transparency present in your original WebP image."
  },
  {
    question: "Are my files uploaded to an external server?",
    answer: "No. The entire conversion process occurs 100% on your device using HTML5 Canvas APIs, ensuring absolute privacy and zero latency."
  },
  {
    question: "Why should I convert WebP to PNG?",
    answer: "While WebP is excellent for modern web browsing, older software, desktop image viewers, legacy office suites, and specialized editing programs may only accept PNG."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  layoutVariant="workspace"
  title="WebP to PNG Converter - Convert WebP to PNG Free"
  description="Convert WebP images to lossless PNG format online for free. Full transparency preservation, instant browser conversion, 100% private with no server uploads."
  category="Image Tools"
  calculatorName="WebP to PNG Converter"
  slug="webp-to-png"
  keywords={[
    'webp to png',
    'convert webp to png',
    'webp to png converter',
    'webp to png online free',
    'convert webp transparent png',
    'batch webp to png',
    'webp converter'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- Privacy Banner -->
    <div class="flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-950/30 dark:text-emerald-300">
      <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold">
        🛡️
      </div>
      <div>
        <span class="font-bold">100% Client-Side Privacy:</span>
        Your WebP files are converted directly in your browser. No files are uploaded to any server.
      </div>
    </div>

    <!-- Upload Zone -->
    <section id="upload-zone" class="transition-all">
      <div
        id="drop-zone"
        tabindex="0"
        role="button"
        aria-label="Upload WebP image: Click or drag and drop to convert to PNG"
        class="group relative flex flex-col items-center justify-center rounded-3xl border-2 border-dashed border-slate-300 bg-slate-50/50 p-8 text-center transition-all duration-200 hover:border-blue-500 hover:bg-blue-50/40 focus:border-blue-500 focus:outline-hidden focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900/40 dark:hover:border-blue-500 dark:hover:bg-blue-950/20 sm:p-12 cursor-pointer"
      >
        <input
          type="file"
          id="file-input"
          accept="image/webp"
          class="sr-only"
        />
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-3xl text-blue-600 transition group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white dark:bg-blue-950 dark:text-blue-400">
          🔄
        </div>
        <h2 class="mt-4 text-lg font-bold text-slate-900 dark:text-white sm:text-xl">
          Choose a WebP image or drag & drop here
        </h2>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 sm:text-sm max-w-md">
          Converts WebP to high-definition PNG format with transparency support.
        </p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            id="btn-select"
            class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-xs transition hover:bg-blue-700 cursor-pointer sm:text-sm"
          >
            📁 Select WebP File
          </button>
          <span class="text-xs text-slate-400">or paste from clipboard (Ctrl+V)</span>
        </div>
      </div>
    </section>

    <!-- Conversion Results Workspace -->
    <section id="workspace-zone" class="hidden space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- WebP Card -->
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Source: WebP</span>
              <span id="src-size" class="text-xs font-bold text-slate-700 dark:text-slate-300">0 KB</span>
            </div>
            <div class="flex items-center justify-center rounded-xl bg-slate-100 p-2 dark:bg-slate-950 min-h-[220px] max-h-[300px] overflow-hidden">
              <img id="src-preview" src="" alt="WebP original" class="max-h-[260px] w-auto max-w-full rounded object-contain" />
            </div>
          </div>
          <div class="mt-3 text-[11px] text-slate-500">
            Dimensions: <strong id="src-dims" class="text-slate-700 dark:text-slate-300">-- × -- px</strong>
          </div>
        </div>

        <!-- PNG Card -->
        <div class="rounded-2xl border border-emerald-200 bg-white p-4 shadow-2xs dark:border-emerald-900/40 dark:bg-slate-900 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Target: PNG Lossless</span>
              <span id="target-size" class="text-xs font-bold text-slate-900 dark:text-white">0 KB</span>
            </div>
            <div class="flex items-center justify-center rounded-xl bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:12px_12px] bg-slate-50 p-2 dark:bg-slate-950 dark:[radial-gradient(#334155_1px,transparent_1px)] min-h-[220px] max-h-[300px] overflow-hidden">
              <img id="target-preview" src="" alt="PNG converted" class="max-h-[260px] w-auto max-w-full rounded object-contain" />
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] text-slate-500">
            <span>Dimensions: <strong id="target-dims" class="text-emerald-600 dark:text-emerald-400">-- × -- px</strong></span>
            <span class="text-emerald-600 font-semibold">✓ Alpha Transparency Preserved</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <button
          type="button"
          id="btn-reset"
          class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
        >
          🔄 Convert Another File
        </button>

        <a
          id="btn-download"
          href="#"
          download="converted-image.png"
          class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-bold text-white shadow-md hover:bg-blue-700 cursor-pointer transition"
        >
          ⬇️ Download PNG Image
        </a>
      </div>
    </section>
  </div>

  <!-- Educational Guide -->
  <div class="mt-12 space-y-8 text-slate-700 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-200 pt-8 dark:border-slate-800">
    <section class="space-y-3">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">
        Why Convert WebP to PNG?
      </h2>
      <p>
        WebP is a modern raster graphic format developed by Google that achieves smaller file sizes on web browsers. However, PNG remains the gold standard for graphic design, print layout, transparent overlays, and maximum compatibility with desktop photo editors.
      </p>
    </section>
  </div>

  <script>
    (function initWebpToPng() {
      const uploadZone = document.getElementById('upload-zone');
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
      const btnSelect = document.getElementById('btn-select');
      const workspaceZone = document.getElementById('workspace-zone');
      const btnReset = document.getElementById('btn-reset');
      const btnDownload = document.getElementById('btn-download') as HTMLAnchorElement | null;

      const srcPreview = document.getElementById('src-preview') as HTMLImageElement | null;
      const targetPreview = document.getElementById('target-preview') as HTMLImageElement | null;
      const srcSize = document.getElementById('src-size');
      const targetSize = document.getElementById('target-size');
      const srcDims = document.getElementById('src-dims');
      const targetDims = document.getElementById('target-dims');

      function formatBytes(bytes: number): string {
        if (bytes <= 0) return '0 B';
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
      }

      function handleFile(file: File) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            if (srcPreview) srcPreview.src = img.src;
            if (srcSize) srcSize.textContent = formatBytes(file.size);
            if (srcDims) srcDims.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;

            // Convert to PNG via Canvas
            const canvas = document.createElement('canvas');
            canvas.width = img.naturalWidth;
            canvas.height = img.naturalHeight;
            const ctx = canvas.getContext('2d');
            if (ctx) {
              ctx.drawImage(img, 0, 0);
              canvas.toBlob((blob) => {
                if (!blob) return;
                const pngUrl = URL.createObjectURL(blob);
                if (targetPreview) targetPreview.src = pngUrl;
                if (targetSize) targetSize.textContent = formatBytes(blob.size);
                if (targetDims) targetDims.textContent = `${canvas.width} × ${canvas.height} px`;

                if (btnDownload) {
                  btnDownload.href = pngUrl;
                  const baseName = file.name.replace(/\.[^/.]+$/, '') || 'image';
                  btnDownload.download = `${baseName}.png`;
                }

                if (uploadZone) uploadZone.classList.add('hidden');
                if (workspaceZone) workspaceZone.classList.remove('hidden');
              }, 'image/png');
            }
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      }

      btnSelect?.addEventListener('click', () => fileInput?.click());
      dropZone?.addEventListener('click', (e) => {
        if (e.target !== btnSelect) fileInput?.click();
      });

      fileInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) handleFile(file);
      });

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-blue-500', 'bg-blue-50/50');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-blue-500', 'bg-blue-50/50');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-blue-500', 'bg-blue-50/50');
        const file = e.dataTransfer?.files?.[0];
        if (file) handleFile(file);
      });

      document.addEventListener('paste', (e) => {
        const items = e.clipboardData?.items;
        if (!items) return;
        for (let i = 0; i < items.length; i++) {
          if (items[i].type.indexOf('image') !== -1) {
            const file = items[i].getAsFile();
            if (file) handleFile(file);
            break;
          }
        }
      });

      btnReset?.addEventListener('click', () => {
        if (fileInput) fileInput.value = '';
        if (uploadZone) uploadZone.classList.remove('hidden');
        if (workspaceZone) workspaceZone.classList.add('hidden');
      });
    })();
  </script>
</CalculatorLayout>
