---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "How do I convert WebP images to JPG online?",
    answer: "Select or drag and drop your WebP image into our tool, adjust the JPG quality slider if desired, and click Download JPG Image. The conversion executes instantly in your browser."
  },
  {
    question: "What happens to transparent areas when converting WebP to JPG?",
    answer: "Because the JPG format does not support transparency, transparent areas are filled with a clean background color (white by default, or customizable). You can select your preferred background fill color."
  },
  {
    question: "Is there a limit on file size or number of conversions?",
    answer: "No. Since all conversions run locally on your device without server limits, you can convert as many WebP images as you need for free."
  },
  {
    question: "Why should I convert WebP to JPG?",
    answer: "JPG is universally supported across virtually all digital devices, operating systems, photo printing services, email clients, and desktop applications."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<CalculatorLayout
  layoutVariant="workspace"
  title="WebP to JPG Converter - Convert WebP to JPG Online"
  description="Convert WebP images to standard JPG/JPEG format online for free. Custom compression quality, background fill color, 100% private in-browser conversion."
  category="Image Tools"
  calculatorName="WebP to JPG Converter"
  slug="webp-to-jpg"
  keywords={[
    'webp to jpg',
    'convert webp to jpg',
    'webp to jpeg converter',
    'webp to jpg online free',
    'convert webp to jpeg',
    'webp to jpg batch',
    'browser image converter'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- Privacy Banner -->
    <div class="flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-3.5 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-950/30 dark:text-emerald-300">
      <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold">
        🛡️
      </div>
      <div>
        <span class="font-bold">100% Client-Side Privacy:</span>
        Your images are converted locally inside your browser. No files are uploaded to our server.
      </div>
    </div>

    <!-- Upload Section -->
    <section id="upload-zone" class="transition-all">
      <div
        id="drop-zone"
        tabindex="0"
        role="button"
        aria-label="Upload WebP image: Click or drag and drop to convert to JPG"
        class="group relative flex flex-col items-center justify-center rounded-3xl border-2 border-dashed border-slate-300 bg-slate-50/50 p-8 text-center transition-all duration-200 hover:border-blue-500 hover:bg-blue-50/40 focus:border-blue-500 focus:outline-hidden focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-900/40 dark:hover:border-blue-500 dark:hover:bg-blue-950/20 sm:p-12 cursor-pointer"
      >
        <input
          type="file"
          id="file-input"
          accept="image/webp"
          class="sr-only"
        />
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-3xl text-blue-600 transition group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white dark:bg-blue-950 dark:text-blue-400">
          🔄
        </div>
        <h2 class="mt-4 text-lg font-bold text-slate-900 dark:text-white sm:text-xl">
          Choose a WebP image or drag & drop here
        </h2>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 sm:text-sm max-w-md">
          Converts WebP images to universal JPG/JPEG format with customizable quality.
        </p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            id="btn-select"
            class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-xs transition hover:bg-blue-700 cursor-pointer sm:text-sm"
          >
            📁 Select WebP File
          </button>
          <span class="text-xs text-slate-400">or paste from clipboard (Ctrl+V)</span>
        </div>
      </div>
    </section>

    <!-- Workspace Zone -->
    <section id="workspace-zone" class="hidden space-y-6">

      <!-- Settings Toolbar -->
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900 sm:p-5 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex-1 space-y-1">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-300">
              <span>JPG Output Quality:</span>
              <span id="quality-display" class="text-blue-600 dark:text-blue-400">92%</span>
            </div>
            <input type="range" id="quality-slider" min="40" max="100" value="92" class="w-full accent-blue-600 cursor-pointer" />
          </div>

          <div class="flex items-center gap-2 text-xs">
            <label for="bg-color-picker" class="font-bold text-slate-600 dark:text-slate-300">Background Fill:</label>
            <input type="color" id="bg-color-picker" value="#ffffff" class="h-8 w-10 rounded border border-slate-200 cursor-pointer" title="Fill color for transparent background areas" />
          </div>
        </div>
      </div>

      <!-- Preview Comparison Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Source: WebP</span>
              <span id="src-size" class="text-xs font-bold text-slate-700 dark:text-slate-300">0 KB</span>
            </div>
            <div class="flex items-center justify-center rounded-xl bg-slate-100 p-2 dark:bg-slate-950 min-h-[220px] max-h-[300px] overflow-hidden">
              <img id="src-preview" src="" alt="WebP original" class="max-h-[260px] w-auto max-w-full rounded object-contain" />
            </div>
          </div>
          <div class="mt-3 text-[11px] text-slate-500">
            Dimensions: <strong id="src-dims" class="text-slate-700 dark:text-slate-300">-- × -- px</strong>
          </div>
        </div>

        <div class="rounded-2xl border border-blue-200 bg-white p-4 shadow-2xs dark:border-blue-900/40 dark:bg-slate-900 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-3 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Target: JPG Universal</span>
              <span id="target-size" class="text-xs font-bold text-slate-900 dark:text-white">0 KB</span>
            </div>
            <div class="flex items-center justify-center rounded-xl bg-slate-100 p-2 dark:bg-slate-950 min-h-[220px] max-h-[300px] overflow-hidden">
              <img id="target-preview" src="" alt="JPG converted" class="max-h-[260px] w-auto max-w-full rounded object-contain" />
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] text-slate-500">
            <span>Dimensions: <strong id="target-dims" class="text-blue-600 dark:text-blue-400">-- × -- px</strong></span>
            <span class="text-blue-600 font-semibold">✓ 100% Universal Compatibility</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <button
          type="button"
          id="btn-reset"
          class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 cursor-pointer"
        >
          🔄 Convert Another File
        </button>

        <a
          id="btn-download"
          href="#"
          download="converted-image.jpg"
          class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-bold text-white shadow-md hover:bg-blue-700 cursor-pointer transition"
        >
          ⬇️ Download JPG Image
        </a>
      </div>
    </section>
  </div>

  <!-- Educational Guide -->
  <div class="mt-12 space-y-8 text-slate-700 dark:text-slate-300 text-sm leading-relaxed border-t border-slate-200 pt-8 dark:border-slate-800">
    <section class="space-y-3">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">
        WebP vs JPG Image Formats
      </h2>
      <p>
        WebP provides outstanding compression efficiency for online applications. However, many desktop programs (like older Microsoft Word, Photoshop versions, CAD tools, and photo printing kiosks) do not open WebP files natively. Converting your WebP photos to JPG guarantees hassle-free compatibility everywhere.
      </p>
    </section>
  </div>

  <script>
    (function initWebpToJpg() {
      let currentImage: HTMLImageElement | null = null;
      let currentFile: File | null = null;

      const uploadZone = document.getElementById('upload-zone');
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
      const btnSelect = document.getElementById('btn-select');
      const workspaceZone = document.getElementById('workspace-zone');
      const btnReset = document.getElementById('btn-reset');
      const btnDownload = document.getElementById('btn-download') as HTMLAnchorElement | null;

      const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement | null;
      const qualityDisplay = document.getElementById('quality-display');
      const bgColorPicker = document.getElementById('bg-color-picker') as HTMLInputElement | null;

      const srcPreview = document.getElementById('src-preview') as HTMLImageElement | null;
      const targetPreview = document.getElementById('target-preview') as HTMLImageElement | null;
      const srcSize = document.getElementById('src-size');
      const targetSize = document.getElementById('target-size');
      const srcDims = document.getElementById('src-dims');
      const targetDims = document.getElementById('target-dims');

      function formatBytes(bytes: number): string {
        if (bytes <= 0) return '0 B';
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
      }

      function handleFile(file: File) {
        if (!file) return;
        currentFile = file;
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            currentImage = img;
            if (srcPreview) srcPreview.src = img.src;
            if (srcSize) srcSize.textContent = formatBytes(file.size);
            if (srcDims) srcDims.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;

            if (uploadZone) uploadZone.classList.add('hidden');
            if (workspaceZone) workspaceZone.classList.remove('hidden');

            renderJpg();
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      }

      function renderJpg() {
        if (!currentImage || !currentFile) return;

        const canvas = document.createElement('canvas');
        canvas.width = currentImage.naturalWidth;
        canvas.height = currentImage.naturalHeight;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        // Fill background color
        const bgColor = bgColorPicker?.value || '#ffffff';
        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Draw image
        ctx.drawImage(currentImage, 0, 0);

        const quality = (Number(qualitySlider?.value) || 92) / 100;
        canvas.toBlob((blob) => {
          if (!blob) return;
          const jpgUrl = URL.createObjectURL(blob);
          if (targetPreview) targetPreview.src = jpgUrl;
          if (targetSize) targetSize.textContent = formatBytes(blob.size);
          if (targetDims) targetDims.textContent = `${canvas.width} × ${canvas.height} px`;

          if (btnDownload) {
            btnDownload.href = jpgUrl;
            const baseName = currentFile?.name.replace(/\.[^/.]+$/, '') || 'image';
            btnDownload.download = `${baseName}.jpg`;
          }
        }, 'image/jpeg', quality);
      }

      qualitySlider?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (qualityDisplay) qualityDisplay.textContent = `${val}%`;
        renderJpg();
      });

      bgColorPicker?.addEventListener('input', renderJpg);

      btnSelect?.addEventListener('click', () => fileInput?.click());
      dropZone?.addEventListener('click', (e) => {
        if (e.target !== btnSelect) fileInput?.click();
      });

      fileInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) handleFile(file);
      });

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-blue-500', 'bg-blue-50/50');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-blue-500', 'bg-blue-50/50');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-blue-500', 'bg-blue-50/50');
        const file = e.dataTransfer?.files?.[0];
        if (file) handleFile(file);
      });

      document.addEventListener('paste', (e) => {
        const items = e.clipboardData?.items;
        if (!items) return;
        for (let i = 0; i < items.length; i++) {
          if (items[i].type.indexOf('image') !== -1) {
            const file = items[i].getAsFile();
            if (file) handleFile(file);
            break;
          }
        }
      });

      btnReset?.addEventListener('click', () => {
        if (fileInput) fileInput.value = '';
        if (uploadZone) uploadZone.classList.remove('hidden');
        if (workspaceZone) workspaceZone.classList.add('hidden');
      });
    })();
  </script>
</CalculatorLayout>
