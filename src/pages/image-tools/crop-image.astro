---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  layoutVariant="workspace"
  title="Crop Image Online - Free In-Browser Image Cropper"
  description="Crop JPG, PNG, and WebP images online for free. Interactive crop box, aspect ratio presets (1:1, 16:9, 4:3, 9:16), and instant client-side download."
  category="Image Tools"
  calculatorName="Crop Image Online"
  slug="crop-image"
  keywords={[
    'crop image online',
    'image cropper',
    'photo cropper',
    'crop picture online',
    'cut image',
    'square crop 1:1',
    '16:9 image crop',
    'free online image cropper'
  ]}
>
  <div class="space-y-6">
    <!-- Header & Trust Badges -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z" />
        </svg>
        <span>100% Client-Side • Lossless Precision • 100% Free &amp; Private</span>
      </div>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Crop JPG, PNG, and WebP images online with freeform or standard social media aspect ratios directly in your browser.
      </p>

      <div class="inline-flex items-center gap-2.5 text-xs sm:text-sm font-medium text-emerald-800 dark:text-emerald-300 bg-emerald-50/80 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 px-4 py-2.5 rounded-xl text-left shadow-2xs">
        <svg class="w-5 h-5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong>100% Local Privacy:</strong> Your photos are cropped directly on your device using HTML5 Canvas. Zero images are transmitted over the network.</span>
      </div>
    </div>

    <!-- Upload Section (Section 6.2) -->
    <section id="upload-zone" class="transition-all">
      <div
        id="drop-zone"
        tabindex="0"
        role="button"
        aria-label="Upload image area: Click or drag and drop an image to crop"
        class="group relative flex flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/40 p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-blue-500 hover:bg-blue-50/40 dark:hover:border-blue-500 dark:hover:bg-blue-950/20 focus:outline-hidden focus:ring-4 focus:ring-blue-500/20"
      >
        <input
          type="file"
          id="file-input"
          accept="image/jpeg,image/png,image/webp"
          class="sr-only"
        />
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-3xl text-blue-600 dark:bg-blue-950/80 dark:text-blue-400 transition group-hover:scale-105 shadow-xs">
          ✂️
        </div>
        <div class="space-y-1.5 max-w-md">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            Choose an image or drag &amp; drop here
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            Supports <strong>JPG, JPEG, PNG, and WebP</strong>. Crop freely or choose standard aspect ratios.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-3">
          <button
            type="button"
            id="btn-select"
            class="inline-flex items-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs transition cursor-pointer focus:outline-hidden focus:ring-2 focus:ring-blue-500"
          >
            📁 Select Image
          </button>
          <span class="text-xs text-slate-400 dark:text-slate-500">or paste from clipboard (Ctrl+V)</span>
        </div>
      </div>
    </section>

    <!-- Cropping Workspace (Hidden until image selected) -->
    <section id="workspace-zone" class="hidden space-y-5">
      <!-- Aspect Ratio & Format Controls Bar (Section 6.5) -->
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 sm:p-5 shadow-xs space-y-4">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Aspect Ratio Preset</span>
            <div class="mt-2 flex flex-wrap gap-2">
              <button type="button" data-ratio="free" class="ratio-btn active rounded-lg border-2 border-blue-600 bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-600 dark:border-blue-500 dark:bg-blue-950/60 dark:text-blue-300 cursor-pointer shadow-2xs">
                Freeform
              </button>
              <button type="button" data-ratio="1:1" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700 hover:border-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition-colors">
                1:1 Square
              </button>
              <button type="button" data-ratio="16:9" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700 hover:border-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition-colors">
                16:9 Banner
              </button>
              <button type="button" data-ratio="4:3" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700 hover:border-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition-colors">
                4:3 Standard
              </button>
              <button type="button" data-ratio="9:16" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700 hover:border-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition-colors">
                9:16 Story
              </button>
              <button type="button" data-ratio="3:2" class="ratio-btn rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700 hover:border-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition-colors">
                3:2 Photo
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2.5 text-xs">
            <label for="format-select" class="font-bold text-slate-700 dark:text-slate-300">Format:</label>
            <select
              id="format-select"
              class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 font-semibold text-slate-800 dark:text-slate-200 shadow-2xs focus:border-blue-600 focus:outline-hidden"
            >
              <option value="image/png" selected>PNG (Lossless)</option>
              <option value="image/jpeg">JPG / JPEG</option>
              <option value="image/webp">WebP</option>
            </select>
          </div>
        </div>

        <!-- Telemetry Dimension Badges (Section 6.4) -->
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="text-slate-500 dark:text-slate-400">Crop Size:</span>
            <span id="crop-stats" class="font-mono font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50 px-2 py-0.5 rounded border border-blue-200/60 dark:border-blue-900/40">-- × -- px</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-slate-500 dark:text-slate-400">Original Size:</span>
            <span id="orig-dims" class="font-mono font-semibold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded">-- × -- px</span>
          </div>
        </div>
      </div>

      <!-- Interactive Canvas Cropping Stage (Section 6.5) -->
      <div class="relative flex flex-col items-center justify-center rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-950 p-4 shadow-inner min-h-95 max-h-160 overflow-hidden select-none canvas-checkerboard">
        <canvas id="crop-canvas" class="max-w-full max-h-125 object-contain cursor-crosshair rounded-lg"></canvas>
      </div>

      <!-- Action Buttons Footer -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <button
          type="button"
          id="btn-reset"
          class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-200 transition cursor-pointer shadow-2xs"
        >
          🔄 Choose Another Image
        </button>

        <button
          type="button"
          id="btn-perform-crop"
          class="inline-flex items-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition cursor-pointer focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
        >
          ✂️ Crop &amp; Download Image
        </button>
      </div>
    </section>
  </div>

  <Fragment slot="content">
    <div class="space-y-12 text-slate-700 dark:text-slate-300">
      <!-- Section 1: Overview -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Crop Image Online: Free In-Browser Photo Cropper
        </h2>
        <p class="leading-relaxed text-base sm:text-lg">
          Whether you need to frame an avatar for social media, prepare a banner graphic, or focus on a portrait subject, our <strong>crop image online</strong> utility provides pixel-accurate cropping with zero software installation.
        </p>
        <p class="leading-relaxed">
          The interactive cropping stage renders directly on your computer or smartphone using client-side HTML5 canvas algorithms. Your photos never leave your device, ensuring maximum privacy and instant processing speed.
        </p>
      </section>

      <!-- Section 2: Ratio Presets Breakdown -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          Standard Aspect Ratio Presets Explained
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            {
              ratio: '1:1 Square',
              useCase: 'Instagram Feed, LinkedIn Profile, Avatars',
              desc: 'Perfect symmetry for social profiles, square product galleries, and thumbnails.'
            },
            {
              ratio: '16:9 Widescreen',
              useCase: 'YouTube Thumbnails, Twitter/X Banners',
              desc: 'The global standard for widescreen video, landscape presentations, and desktop hero images.'
            },
            {
              ratio: '9:16 Vertical Story',
              useCase: 'Instagram Stories, Reels, TikTok, Shorts',
              desc: 'Full-bleed mobile vertical orientation optimized for modern smartphone viewing.'
            },
            {
              ratio: '4:3 Standard',
              useCase: 'Classic Photography, Slides, Tablets',
              desc: 'Traditional camera sensor format widely used in presentations and tablet displays.'
            },
            {
              ratio: '3:2 DSLR Photo',
              useCase: '35mm Film, DSLR Cameras, Photo Prints',
              desc: 'The classic photographic ratio ideal for standard 4×6 photo prints and artistic framing.'
            },
            {
              ratio: 'Freeform',
              useCase: 'Custom Dimensions & Arbitrary Cuts',
              desc: 'Drag corner and edge handles freely to isolate any specific region without fixed constraints.'
            }
          ].map(({ ratio, useCase, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 shadow-sm">
              <span class="inline-block px-2.5 py-1 text-xs font-bold text-blue-700 dark:text-blue-300 bg-blue-100 dark:bg-blue-950/80 rounded-md">
                {ratio}
              </span>
              <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">{useCase}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 3: How to Crop in 3 Steps -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
          How to Crop an Image Online in 3 Simple Steps
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {[
            {
              step: '1',
              title: 'Upload Image',
              desc: 'Drop your JPG, PNG, or WebP photo into the upload box or click "Select Image".'
            },
            {
              step: '2',
              title: 'Adjust Crop Box',
              desc: 'Select an aspect ratio preset or drag the corner handles to position your crop boundaries.'
            },
            {
              step: '3',
              title: 'Download Cropped File',
              desc: 'Choose your desired output format (PNG, JPG, or WebP) and click "Crop & Download Image".'
            }
          ].map(({ step, title, desc }) => (
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 space-y-2 relative">
              <span class="inline-block px-2 py-0.5 text-xs font-extrabold text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-950/80 rounded-md uppercase tracking-wider">
                Step {step}
              </span>
              <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: Related Image Tools -->
      <section class="pt-6 border-t border-slate-200 dark:border-slate-800 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Explore More Free Online Image Utilities
        </h3>
        <div class="flex flex-wrap gap-2 text-xs sm:text-sm">
          <a href="/free-online-tools/image-compressor/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Compress Images Online →
          </a>
          <a href="/free-online-tools/image-to-pdf/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Images to PDF Converter →
          </a>
          <a href="/free-online-tools/pdf-to-image/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-orange-600 dark:text-orange-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            PDF to Image Converter →
          </a>
          <a href="/pdf-tools/pdf-compress/" class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium">
            Compress PDF Online →
          </a>
        </div>
      </section>
    </div>
  </Fragment>


  <script>
    (function initImageCropper() {
      let originalImage: HTMLImageElement | null = null;
      let originalFile: File | null = null;
      let selectedRatio: string = 'free'; // 'free', '1:1', '16:9', '4:3', '9:16', '3:2'

      const uploadZone = document.getElementById('upload-zone');
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
      const btnSelect = document.getElementById('btn-select');
      const workspaceZone = document.getElementById('workspace-zone');
      const btnReset = document.getElementById('btn-reset');
      const btnPerformCrop = document.getElementById('btn-perform-crop');
      const formatSelect = document.getElementById('format-select') as HTMLSelectElement | null;
      const canvas = document.getElementById('crop-canvas') as HTMLCanvasElement | null;
      const cropStats = document.getElementById('crop-stats');
      const origDims = document.getElementById('orig-dims');
      const ratioBtns = document.querySelectorAll<HTMLButtonElement>('.ratio-btn');

      // Crop box state in image coordinate system
      let cropX = 0;
      let cropY = 0;
      let cropW = 0;
      let cropH = 0;

      // Dragging state
      let isDragging = false;
      let dragHandle: string | null = null; // 'center', 'tl', 'tr', 'bl', 'br'
      let startMouseX = 0;
      let startMouseY = 0;
      let startCropX = 0;
      let startCropY = 0;
      let startCropW = 0;
      let startCropH = 0;

      function handleFile(file: File) {
        if (!file || !file.type.startsWith('image/')) return;
        originalFile = file;
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            originalImage = img;
            if (origDims) origDims.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;

            // Initialize default crop to center 80%
            cropW = Math.round(img.naturalWidth * 0.8);
            cropH = Math.round(img.naturalHeight * 0.8);
            cropX = Math.round((img.naturalWidth - cropW) / 2);
            cropY = Math.round((img.naturalHeight - cropH) / 2);

            applyAspectConstraint();

            if (uploadZone) uploadZone.classList.add('hidden');
            if (workspaceZone) workspaceZone.classList.remove('hidden');

            renderCanvas();
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      }

      function applyAspectConstraint() {
        if (!originalImage || selectedRatio === 'free') return;
        const [rW, rH] = selectedRatio.split(':').map(Number);
        const targetAspect = rW / rH;

        let newW = cropW;
        let newH = Math.round(newW / targetAspect);

        if (newH > originalImage.naturalHeight) {
          newH = originalImage.naturalHeight;
          newW = Math.round(newH * targetAspect);
        }
        if (newW > originalImage.naturalWidth) {
          newW = originalImage.naturalWidth;
          newH = Math.round(newW / targetAspect);
        }

        cropW = Math.max(20, newW);
        cropH = Math.max(20, newH);

        // Keep within bounds
        if (cropX + cropW > originalImage.naturalWidth) {
          cropX = Math.max(0, originalImage.naturalWidth - cropW);
        }
        if (cropY + cropH > originalImage.naturalHeight) {
          cropY = Math.max(0, originalImage.naturalHeight - cropH);
        }
      }

      function renderCanvas() {
        if (!canvas || !originalImage) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        canvas.width = originalImage.naturalWidth;
        canvas.height = originalImage.naturalHeight;

        // Draw main image
        ctx.drawImage(originalImage, 0, 0);

        // Draw dark overlay outside crop region
        ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
        ctx.fillRect(0, 0, canvas.width, cropY); // top
        ctx.fillRect(0, cropY + cropH, canvas.width, canvas.height - (cropY + cropH)); // bottom
        ctx.fillRect(0, cropY, cropX, cropH); // left
        ctx.fillRect(cropX + cropW, cropY, canvas.width - (cropX + cropW), cropH); // right

        // Draw crop border
        ctx.strokeStyle = '#3b82f6';
        ctx.lineWidth = Math.max(2, Math.round(canvas.width / 400));
        ctx.strokeRect(cropX, cropY, cropW, cropH);

        // Draw rule of thirds grid
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        // vertical thirds
        ctx.moveTo(cropX + cropW / 3, cropY);
        ctx.lineTo(cropX + cropW / 3, cropY + cropH);
        ctx.moveTo(cropX + (2 * cropW) / 3, cropY);
        ctx.lineTo(cropX + (2 * cropW) / 3, cropY + cropH);
        // horizontal thirds
        ctx.moveTo(cropX, cropY + cropH / 3);
        ctx.lineTo(cropX + cropW, cropY + cropH / 3);
        ctx.moveTo(cropX, cropY + (2 * cropH) / 3);
        ctx.lineTo(cropX + cropW, cropY + (2 * cropH) / 3);
        ctx.stroke();

        // Draw corner handles
        const handleSize = Math.max(12, Math.round(canvas.width / 80));
        ctx.fillStyle = '#ffffff';
        ctx.strokeStyle = '#2563eb';
        ctx.lineWidth = 2;

        const handles = [
          [cropX, cropY], // TL
          [cropX + cropW, cropY], // TR
          [cropX, cropY + cropH], // BL
          [cropX + cropW, cropY + cropH], // BR
        ];

        handles.forEach(([hx, hy]) => {
          ctx.fillRect(hx - handleSize / 2, hy - handleSize / 2, handleSize, handleSize);
          ctx.strokeRect(hx - handleSize / 2, hy - handleSize / 2, handleSize, handleSize);
        });

        if (cropStats) {
          cropStats.textContent = `${Math.round(cropW)} × ${Math.round(cropH)} px`;
        }
      }

      function getCanvasCoords(e: MouseEvent): { x: number; y: number } {
        if (!canvas) return { x: 0, y: 0 };
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        return {
          x: (e.clientX - rect.left) * scaleX,
          y: (e.clientY - rect.top) * scaleY,
        };
      }

      function getHandleAt(x: number, y: number): string | null {
        if (!canvas) return null;
        const handleSize = Math.max(18, Math.round(canvas.width / 60));
        const dist = (x1: number, y1: number, x2: number, y2: number) => Math.hypot(x1 - x2, y1 - y2);

        if (dist(x, y, cropX, cropY) < handleSize) return 'tl';
        if (dist(x, y, cropX + cropW, cropY) < handleSize) return 'tr';
        if (dist(x, y, cropX, cropY + cropH) < handleSize) return 'bl';
        if (dist(x, y, cropX + cropW, cropY + cropH) < handleSize) return 'br';

        if (x >= cropX && x <= cropX + cropW && y >= cropY && y <= cropY + cropH) {
          return 'center';
        }
        return null;
      }

      canvas?.addEventListener('mousedown', (e) => {
        const { x, y } = getCanvasCoords(e);
        const handle = getHandleAt(x, y);
        if (handle) {
          isDragging = true;
          dragHandle = handle;
          startMouseX = x;
          startMouseY = y;
          startCropX = cropX;
          startCropY = cropY;
          startCropW = cropW;
          startCropH = cropH;
        }
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging || !originalImage || !dragHandle) return;
        const { x, y } = getCanvasCoords(e);
        const dx = x - startMouseX;
        const dy = y - startMouseY;

        if (dragHandle === 'center') {
          cropX = Math.max(0, Math.min(originalImage.naturalWidth - cropW, startCropX + dx));
          cropY = Math.max(0, Math.min(originalImage.naturalHeight - cropH, startCropY + dy));
        } else {
          let newW = startCropW;
          let newH = startCropH;
          let newX = startCropX;
          let newY = startCropY;

          if (dragHandle === 'br') {
            newW = Math.max(30, startCropW + dx);
            newH = Math.max(30, startCropH + dy);
          } else if (dragHandle === 'tr') {
            newW = Math.max(30, startCropW + dx);
            newH = Math.max(30, startCropH - dy);
            newY = startCropY + (startCropH - newH);
          } else if (dragHandle === 'bl') {
            newW = Math.max(30, startCropW - dx);
            newH = Math.max(30, startCropH + dy);
            newX = startCropX + (startCropW - newW);
          } else if (dragHandle === 'tl') {
            newW = Math.max(30, startCropW - dx);
            newH = Math.max(30, startCropH - dy);
            newX = startCropX + (startCropW - newW);
            newY = startCropY + (startCropH - newH);
          }

          if (selectedRatio !== 'free') {
            const [rW, rH] = selectedRatio.split(':').map(Number);
            newH = Math.round(newW / (rW / rH));
          }

          // Boundary checks
          if (newX >= 0 && newX + newW <= originalImage.naturalWidth) {
            cropX = newX;
            cropW = newW;
          }
          if (newY >= 0 && newY + newH <= originalImage.naturalHeight) {
            cropY = newY;
            cropH = newH;
          }
        }
        renderCanvas();
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
        dragHandle = null;
      });

      // Ratio Button Switching
      ratioBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          ratioBtns.forEach((b) => {
            b.classList.remove('active', 'border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-600', 'dark:border-blue-500', 'dark:bg-blue-950/60', 'dark:text-blue-300');
            b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');
          });
          btn.classList.add('active', 'border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-600', 'dark:border-blue-500', 'dark:bg-blue-950/60', 'dark:text-blue-300');
          btn.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-700', 'dark:border-slate-700', 'dark:bg-slate-800', 'dark:text-slate-200');

          selectedRatio = btn.getAttribute('data-ratio') || 'free';
          applyAspectConstraint();
          renderCanvas();
        });
      });

      // Export Cropped Result
      btnPerformCrop?.addEventListener('click', () => {
        if (!originalImage) return;
        const outCanvas = document.createElement('canvas');
        outCanvas.width = Math.round(cropW);
        outCanvas.height = Math.round(cropH);
        const outCtx = outCanvas.getContext('2d');
        if (!outCtx) return;

        outCtx.drawImage(
          originalImage,
          Math.round(cropX),
          Math.round(cropY),
          Math.round(cropW),
          Math.round(cropH),
          0,
          0,
          outCanvas.width,
          outCanvas.height
        );

        const mime = formatSelect?.value || 'image/png';
        const ext = mime === 'image/png' ? 'png' : mime === 'image/webp' ? 'webp' : 'jpg';
        const baseName = originalFile?.name.replace(/\.[^/.]+$/, '') || 'cropped-image';

        outCanvas.toBlob((blob) => {
          if (!blob) return;
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${baseName}-cropped.${ext}`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 2000);
        }, mime, 0.95);
      });

      btnSelect?.addEventListener('click', () => fileInput?.click());
      dropZone?.addEventListener('click', (e) => {
        if (e.target !== btnSelect) fileInput?.click();
      });

      fileInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) handleFile(file);
      });

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-blue-500', 'bg-blue-50/50');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-blue-500', 'bg-blue-50/50');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-blue-500', 'bg-blue-50/50');
        const file = e.dataTransfer?.files?.[0];
        if (file) handleFile(file);
      });

      document.addEventListener('paste', (e) => {
        const items = e.clipboardData?.items;
        if (!items) return;
        for (let i = 0; i < items.length; i++) {
          if (items[i].type.indexOf('image') !== -1) {
            const file = items[i].getAsFile();
            if (file) handleFile(file);
            break;
          }
        }
      });

      btnReset?.addEventListener('click', () => {
        if (fileInput) fileInput.value = '';
        if (uploadZone) uploadZone.classList.remove('hidden');
        if (workspaceZone) workspaceZone.classList.add('hidden');
      });
    })();
  </script>
</CalculatorLayout>

<style>
  .canvas-checkerboard {
    background-color: #090d16;
    background-image:
      linear-gradient(45deg, #131a29 25%, transparent 25%),
      linear-gradient(-45deg, #131a29 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #131a29 75%),
      linear-gradient(-45deg, transparent 75%, #131a29 75%);
    background-size: 20px 20px;
    background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
  }
</style>
