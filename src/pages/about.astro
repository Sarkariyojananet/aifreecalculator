---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, calculators } from '../data/calculators';
import { getCalculatorOverrides } from '../lib/admin/content-store';
import { getLivePageMeta } from '../lib/seo/page-metadata';

const totalTools = calculators.length;
const totalCategories = categories.length;

const overrides = await getCalculatorOverrides(Astro.locals);
const override = overrides['core:about'] || {};
const liveMeta = getLivePageMeta('core:about');

const effectiveTitle = override.metaTitle || liveMeta.title;
const effectiveDescription = override.metaDescription || liveMeta.description;
const effectiveCanonical = override.canonicalUrl;
const effectiveRobots = override.robots;
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
  noindex={effectiveRobots?.includes('noindex')}
>
  <!-- Hero Section -->
  <div class="border-b border-slate-200 bg-linear-to-b from-blue-50/50 via-white to-slate-50 px-4 py-16 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-24">
    <div class="mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1 text-xs font-bold text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/50 dark:text-blue-300 shadow-xs">
        <span>🚀</span> Accurate • Instant • 100% Free
      </div>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
        Precision Calculation Tools for Everyone
      </h1>
      <p class="mt-6 text-base font-normal leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl mx-auto sm:text-lg">
        AI Free Calculator is built to simplify complex math, engineering estimation, and financial budgeting into instant, user-friendly web calculators without signups, paywalls, or privacy invasive tracking.
      </p>

      <!-- Key KPI Stats -->
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 max-w-3xl mx-auto">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/90">
          <div class="text-3xl font-black text-blue-600 dark:text-blue-400">{totalTools}+</div>
          <div class="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">Active Calculators</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/90">
          <div class="text-3xl font-black text-emerald-600 dark:text-emerald-400">{totalCategories}</div>
          <div class="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">Core Domains</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/90">
          <div class="text-3xl font-black text-indigo-600 dark:text-indigo-400">100%</div>
          <div class="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">Free Access</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/90">
          <div class="text-3xl font-black text-amber-600 dark:text-amber-400">0</div>
          <div class="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">Logins Required</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Body -->
  <main class="mx-auto max-w-5xl px-4 py-16 space-y-16 text-slate-700 dark:text-slate-300">
    
    <!-- Mission & Story -->
    <section class="grid gap-8 md:grid-cols-2 items-center">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          <span>🎯</span> Our Vision &amp; Story
        </div>
        <h2 class="text-2xl font-black text-slate-900 dark:text-white sm:text-3xl">
          Why We Built AI Free Calculator
        </h2>
        <p class="leading-relaxed text-sm">
          Whether you are a civil site engineer computing steel reinforcement quantities, a homeowner calculating monthly loan installments, or a fitness enthusiast monitoring daily caloric expenditure, traditional math formulas are cumbersome and error-prone.
        </p>
        <p class="leading-relaxed text-sm">
          Many existing online calculation tools are cluttered with popups, require mandatory registration, or send your sensitive financial figures to remote databases. We created <strong>AI Free Calculator</strong> to offer a modern, clean, instant alternative with formula transparency and strict client-side data privacy.
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900/60 space-y-4 shadow-sm">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>💎</span> Core Engineering Values
        </h3>
        <ul class="space-y-3 text-xs leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600 font-bold dark:bg-blue-950 dark:text-blue-300">1</span>
            <span><strong>Formula Accuracy:</strong> Algorithms built according to recognized standards (IS codes, banking compound schedules, Harris-Benedict biometrics).</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600 font-bold dark:bg-emerald-950 dark:text-emerald-300">2</span>
            <span><strong>Client-Side Processing:</strong> Calculations evaluate in your browser in milliseconds without server roundtrips.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-purple-100 text-purple-600 font-bold dark:bg-purple-950 dark:text-purple-300">3</span>
            <span><strong>Universal Accessibility:</strong> Clean, responsive user interfaces optimized for smartphones, tablets, and high-resolution desktop screens.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Category Showcase -->
    <section class="space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white sm:text-3xl">
          Comprehensive Tool Suites
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Explore specialized calculation suites built for engineering, finance, health, and mathematics.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        
        <!-- Category 1: Construction -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 hover:shadow-md transition dark:border-slate-800 dark:bg-slate-900">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-2xl dark:bg-amber-950/50">
            🏗️
          </div>
          <h3 class="mt-4 font-bold text-slate-900 dark:text-white">Civil &amp; Construction</h3>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            RCC Slab, Beam, Column &amp; Footing steel weight, Concrete mix design ratios, Brickwork quantities, Plaster, Paint, and BOQ estimation.
          </p>
          <a href="/construction/" class="mt-4 inline-flex items-center gap-1 text-xs font-bold text-amber-600 hover:underline dark:text-amber-400">
            Explore Civil Tools →
          </a>
        </div>

        <!-- Category 2: Finance -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 hover:shadow-md transition dark:border-slate-800 dark:bg-slate-900">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-2xl dark:bg-emerald-950/50">
            💰
          </div>
          <h3 class="mt-4 font-bold text-slate-900 dark:text-white">Finance &amp; Banking</h3>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Loan EMI schedules, SIP mutual fund wealth forecasting, GST inclusive/exclusive rates, Income Tax breakdown, and Amortization tables.
          </p>
          <a href="/finance/" class="mt-4 inline-flex items-center gap-1 text-xs font-bold text-emerald-600 hover:underline dark:text-emerald-400">
            Explore Finance Tools →
          </a>
        </div>

        <!-- Category 3: Health -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 hover:shadow-md transition dark:border-slate-800 dark:bg-slate-900">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-50 text-2xl dark:bg-rose-950/50">
            ❤️
          </div>
          <h3 class="mt-4 font-bold text-slate-900 dark:text-white">Health &amp; Fitness</h3>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Body Mass Index (BMI), Basal Metabolic Rate (BMR), Daily Caloric intake for weight loss/gain, and US Navy Body Fat estimation.
          </p>
          <a href="/health/" class="mt-4 inline-flex items-center gap-1 text-xs font-bold text-rose-600 hover:underline dark:text-rose-400">
            Explore Health Tools →
          </a>
        </div>

        <!-- Category 4: General Math -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 hover:shadow-md transition dark:border-slate-800 dark:bg-slate-900">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-2xl dark:bg-blue-950/50">
            📐
          </div>
          <h3 class="mt-4 font-bold text-slate-900 dark:text-white">General &amp; Math</h3>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Universal Unit Converters, Age &amp; Date difference calculators, Percentage math, GPA calculators, and Scientific computations.
          </p>
          <a href="/general/" class="mt-4 inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:underline dark:text-blue-400">
            Explore Math Tools →
          </a>
        </div>

      </div>
    </section>

    <!-- Authoritative Standards & Methodology -->
    <section class="space-y-6">
      <div class="text-center max-w-3xl mx-auto space-y-2">
        <div class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          <span>📐</span> Rigorous Foundations
        </div>
        <h2 class="text-2xl font-black text-slate-900 dark:text-white sm:text-3xl">
          Recognized Standards &amp; Calculation Methodologies
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          We do not invent ad-hoc calculation rules. Every tool is built on published engineering specifications, clinical guidelines, and standard retail banking mathematics.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 shadow-xs space-y-3">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl dark:bg-amber-950/50">🏗️</span>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">Civil &amp; Structural Engineering</h3>
              <p class="text-[11px] text-amber-600 dark:text-amber-400 font-semibold">IS 456:2000, SP 34 &amp; CPWD Specifications</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Concrete mix ratios, RCC beam and slab reinforcement computations, and steel weight formulas adhere to Indian Standard IS 456:2000 (Plain and Reinforced Concrete - Code of Practice) and SP 34 (Handbook on Concrete Reinforcement and Detailing). Material consumption factors reflect standard Central Public Works Department (CPWD) schedules with a transparent 5%–10% cutting and wastage allowance.
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 shadow-xs space-y-3">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl dark:bg-emerald-950/50">💰</span>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">Financial Mathematics &amp; Taxation</h3>
              <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">Standard Banking Amortization &amp; Income Tax Act</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Loan installments use standard retail banking reducing-balance amortization algorithms with periodic monthly compounding. SIP wealth forecasts and compound interest projections apply standard financial equations. Tax computations reflect Section 115BAC of the Indian Income Tax Act (New Regime vs. Old Regime Chapter VI-A deductions) and are updated in accordance with Union Budget notifications.
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 shadow-xs space-y-3">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-xl dark:bg-rose-950/50">❤️</span>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">Clinical Health &amp; Biometrics</h3>
              <p class="text-[11px] text-rose-600 dark:text-rose-400 font-semibold">WHO Classifications &amp; Mifflin-St Jeor Equations</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Body Mass Index (BMI) ranges follow World Health Organization (WHO) international clinical cutoffs for underweight, normal weight, overweight, and obesity classes. Basal Metabolic Rate (BMR) models implement the clinically validated Mifflin-St Jeor and Revised Harris-Benedict formulas, paired with Katch-McArdle models for lean mass analysis.
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 shadow-xs space-y-3">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-xl dark:bg-indigo-950/50">🛡️</span>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">Web Utilities &amp; Cryptography</h3>
              <p class="text-[11px] text-indigo-600 dark:text-indigo-400 font-semibold">W3C Web Cryptography API &amp; ISO 32000-1</p>
            </div>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Random password and token generation utilizes the cryptographically secure <code>window.crypto.getRandomValues</code> API defined by the W3C Web Cryptography Working Group. PDF utilities comply with the ISO 32000-1 document architecture, and image resizing/conversion operates via HTML5 Canvas 2D without server-side processing.
          </p>
        </div>
      </div>
    </section>

    <!-- Editorial Standards & Quality Review Process -->
    <section class="rounded-3xl border border-slate-200 bg-slate-50/70 p-8 dark:border-slate-800 dark:bg-slate-900/60 space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <div class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
          <span>✅</span> Editorial Integrity
        </div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-white sm:text-2xl">
          Editorial Standards &amp; Review Policy
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          How we maintain absolute accuracy, resilience, and freshness across all 129+ online tools.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-3 text-xs leading-relaxed">
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/90 space-y-2">
          <div class="text-lg">🔬</div>
          <h3 class="font-bold text-slate-900 dark:text-white">Multi-Tier Verification</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Before publication, algorithms are cross-referenced with academic textbooks, official government circulars, and standard engineering handbooks to ensure formula fidelity.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/90 space-y-2">
          <div class="text-lg">🧪</div>
          <h3 class="font-bold text-slate-900 dark:text-white">Automated Test Suites</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Automated test suites evaluate edge cases, boundary inputs, zero-division hazards, and IEEE 754 floating-point precision on every build to prevent calculation regressions.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/90 space-y-2">
          <div class="text-lg">🔄</div>
          <h3 class="font-bold text-slate-900 dark:text-white">Quarterly Review Cycle</h3>
          <p class="text-slate-600 dark:text-slate-400">
            Tax slabs, benchmark interest assumptions, and building code updates are reviewed quarterly or immediately following official fiscal budget enactments.
          </p>
        </div>
      </div>

      <!-- Peer Review & Feedback Channel -->
      <div class="rounded-2xl border border-blue-200/80 bg-blue-50/50 p-5 dark:border-blue-900/40 dark:bg-blue-950/20 text-xs text-slate-700 dark:text-slate-300 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🤝</span> Peer Review &amp; Bug Bounty
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-[11px] leading-relaxed">
            We welcome constructive feedback from civil engineers, chartered accountants, educators, and software developers. Spot a formula nuance or discrepancy? Let us know and we will investigate immediately.
          </p>
        </div>
        <a
          href="/contact/"
          class="shrink-0 rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white hover:bg-blue-700 transition cursor-pointer"
        >
          Submit Feedback →
        </a>
      </div>
    </section>

    <!-- Disclaimers & Professional Advice Boundaries -->
    <section class="rounded-3xl border border-amber-200/80 bg-amber-50/40 p-6 sm:p-8 dark:border-amber-900/40 dark:bg-amber-950/20 space-y-3">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">
        <span>⚠️</span> Educational Purpose &amp; Professional Boundaries
      </div>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
        All calculations, equations, and simulations provided on AI Free Calculator are designed for educational, informational, and preliminary planning purposes. While our team takes extreme care to ensure mathematical accuracy against authoritative standards, online calculations should never substitute for certified structural design drawings by a licensed civil engineer, formal tax filings prepared by a chartered accountant, or clinical medical evaluations by a qualified physician. Always independently verify mission-critical figures before executing financial investments or structural construction work.
      </p>
    </section>

    <!-- Call to Action -->
    <section class="text-center rounded-3xl bg-blue-600 p-8 sm:p-12 text-white shadow-xl shadow-blue-500/20 space-y-4">
      <h2 class="text-2xl font-black sm:text-3xl">Ready to Start Calculating?</h2>
      <p class="text-xs sm:text-sm text-blue-100 max-w-xl mx-auto">
        Browse our complete library of 129+ verified tools and calculators and get instant, accurate results now.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="rounded-xl bg-white px-6 py-3 text-xs font-bold text-blue-600 shadow-md hover:bg-blue-50 transition cursor-pointer"
        >
          View All Calculators →
        </a>
        <a
          href="/contact/"
          class="rounded-xl border border-blue-400 px-6 py-3 text-xs font-bold text-white hover:bg-blue-700 transition cursor-pointer"
        >
          Suggest a Calculator
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
