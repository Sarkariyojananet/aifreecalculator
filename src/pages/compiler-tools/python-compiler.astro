---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "What is an online Python compiler?",
    answer: "An online Python compiler is a web-based code editor and execution engine that allows you to write, test, and run Python 3 scripts directly inside your web browser without downloading Python or configuring virtual environments."
  },
  {
    question: "How does this Python compiler execute code?",
    answer: "This compiler uses WebAssembly (Pyodide) to execute Python code 100% locally in your browser sandbox. Your code executes with near-native speed without being sent to external third-party servers, guaranteeing complete privacy."
  },
  {
    question: "Can I use Python standard libraries?",
    answer: "Yes. You can import standard modules including math, random, json, datetime, collections, re, itertools, statistics, and more."
  },
  {
    question: "Can I take user input in Python?",
    answer: "Yes, you can specify custom standard input (stdin) values in the console or pass parameters to interactive programs."
  },
  {
    question: "Is this online Python compiler free?",
    answer: "Yes, our Python compiler is 100% free with unlimited runs, zero watermarks, and no sign-up or credit card required."
  },
  {
    question: "Can I download my Python script?",
    answer: "Yes. Clicking the 'Download' button instantly exports your code as a clean main.py file directly to your computer or mobile device."
  },
  {
    question: "What keyboard shortcut runs the Python code?",
    answer: "You can press Ctrl + Enter (or Cmd + Enter on Mac) while inside the code editor to execute your Python script immediately."
  },
  {
    question: "Can I run Python on mobile phones or tablets?",
    answer: "Yes, the editor is fully responsive and touch-friendly, allowing you to code and run Python programs on iPhones, Android phones, iPads, and Chromebooks."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
const defaultCode = `# Python 3 - Hello World
print("Hello, World!")
name = "Developer"
print(f"Welcome to AI Free Calculator Python Compiler, {name}!")

# Simple Loop Calculation
squares = [x**2 for x in range(1, 11)]
print(f"First 10 squares: {squares}")
`;
---

<CalculatorLayout
  layoutVariant="workspace"
  title="Online Python Compiler - Run Python 3 in Browser Free"
  description="Run Python 3 scripts online directly in your browser with instant WebAssembly execution, standard libraries, and interactive console output."
  category="Compiler Tools"
  calculatorName="Online Python Compiler"
  slug="python-compiler"
  keywords={[
    'online python compiler',
    'python compiler',
    'run python online',
    'python online compiler',
    'python 3 compiler',
    'python interpreter online',
    'python editor online'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- Header Hero Intro -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <span>🐍</span>
        <span>Python 3.11 • In-Browser WASM Execution • Zero Setup</span>
      </div>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Write, run, and debug <strong>Python 3 scripts</strong> online directly in your browser. Powered by client-side WebAssembly with standard libraries, console terminal output, sample code templates, and zero server tracking.
      </p>
    </div>

    <!-- Interactive Code Editor Widget -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-xl dark:border-slate-800 dark:bg-slate-900 overflow-hidden">
      <!-- Editor Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-950">
        <div class="flex items-center gap-2">
          <span class="flex h-3 w-3 rounded-full bg-emerald-500"></span>
          <span class="font-mono text-xs font-bold text-slate-700 dark:text-slate-200">main.py</span>
          <span class="text-xs text-slate-400">|</span>
          <label class="text-xs text-slate-500 dark:text-slate-400">Template:</label>
          <select id="python-template-select" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <option value="hello">Hello World</option>
            <option value="math">Math & Statistics</option>
            <option value="fibonacci">Fibonacci Sequence</option>
            <option value="sorting">Bubble Sort</option>
            <option value="oop">OOP & Classes</option>
          </select>
        </div>

        <div class="flex items-center gap-2">
          <button id="python-copy-btn" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            📋 Copy
          </button>
          <button id="python-download-btn" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            💾 Download .py
          </button>
          <button id="python-clear-btn" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:border-slate-700 dark:bg-slate-800 dark:text-rose-400 dark:hover:bg-slate-700">
            🗑️ Clear
          </button>
          <button id="python-run-btn" type="button" class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-1.5 text-xs font-bold text-white shadow-md hover:bg-emerald-700 active:scale-95 transition">
            ▶ Run Code <span class="hidden sm:inline text-[10px] opacity-80">(Ctrl+Enter)</span>
          </button>
        </div>
      </div>

      <!-- Code Textarea Editor -->
      <div class="relative bg-[#1e1e2e]">
        <textarea
          id="python-code-input"
          class="w-full h-80 sm:h-96 p-4 font-mono text-sm leading-relaxed text-[#cdd6f4] bg-transparent resize-y focus:outline-none border-0"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          set:text={defaultCode}
        />
      </div>

      <!-- Output Terminal Console -->
      <div class="border-t border-slate-800 bg-[#11111b] p-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80 mb-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="font-mono text-slate-400 uppercase tracking-wider font-bold">Terminal Output</span>
            <span id="python-status-badge" class="text-xs px-2.5 py-0.5 rounded-full font-medium bg-slate-800 text-slate-300">Ready</span>
          </div>
          <div class="flex items-center gap-3 text-slate-400 font-mono text-xs">
            <span>Execution Time: <strong id="python-exec-time" class="text-slate-200">0ms</strong></span>
          </div>
        </div>

        <pre id="python-output-console" class="font-mono text-xs sm:text-sm text-[#a6e3a1] min-h-30 max-h-72 overflow-y-auto whitespace-pre-wrap select-text leading-relaxed">Click "Run Code" or press Ctrl+Enter to execute Python code in your browser.</pre>
      </div>
    </div>
  </div>

  <script is:inline src="/js/tools/python-compiler.js"></script>
</CalculatorLayout>
