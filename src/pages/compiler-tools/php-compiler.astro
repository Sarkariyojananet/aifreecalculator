---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "What is an online PHP compiler?",
    answer: "An online PHP compiler is an interactive web-based sandbox that allows you to write, test, and run PHP scripts directly in your browser without setting up Apache, Nginx, or local PHP runtimes like XAMPP or MAMP."
  },
  {
    question: "Which PHP functions and statements are supported?",
    answer: "Standard PHP constructs including echo, print, arrays, foreach loops, functions, string manipulation, and mathematical functions are supported."
  },
  {
    question: "How does output display in the terminal?",
    answer: "All output generated by echo, print, or print_r statements is captured and displayed line-by-line in the terminal window below the editor."
  },
  {
    question: "Can I download my PHP file?",
    answer: "Yes, clicking the 'Download .php' button saves your code locally as index.php."
  },
  {
    question: "Is this online PHP compiler free?",
    answer: "Yes, our PHP compiler is 100% free with unlimited executions, zero ads during testing, and no account required."
  },
  {
    question: "What keyboard shortcut runs the code?",
    answer: "Press Ctrl + Enter (Cmd + Enter on macOS) while inside the code editor to execute your PHP script immediately."
  },
  {
    question: "Can I test array manipulation in PHP?",
    answer: "Yes, associative arrays, indexed arrays, array_map, and array_filter operations can be tested interactively."
  },
  {
    question: "Is my PHP code private?",
    answer: "Yes. All processing happens in your browser session with zero server tracking or permanent storage."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
const defaultCode = `<?php
echo "Hello, World from Online PHP Compiler!\n";

$language = "PHP";
$version = 8.3;

echo "Runtime: " . $language . " " . $version . "\n";
?>`;

const templatesJson = JSON.stringify({
  hello: `<?php\necho "Hello, World!\\n";\n$today = date("Y-m-d");\necho "Current date: " . $today . "\\n";\n?>`,
  arrays: `<?php\n$products = [\n    ["name" => "Laptop", "price" => 899.99],\n    ["name" => "Mouse", "price" => 25.50],\n    ["name" => "Keyboard", "price" => 65.00]\n];\n\necho "Available Catalog:\\n";\nforeach ($products as $p) {\n    echo "- " . $p["name"] . ": $" . $p["price"] . "\\n";\n}\n?>`,
  functions: `<?php\nfunction calculateDiscount($price, $discountPercent) {\n    return $price - ($price * ($discountPercent / 100));\n}\n\n$original = 120.00;\n$discounted = calculateDiscount($original, 20);\necho "Original: $" . $original . "\\n";\necho "Final Price after 20% discount: $" . $discounted . "\\n";\n?>`
});
---

<CalculatorLayout
  layoutVariant="workspace"
  title="Online PHP Compiler - Run & Test PHP Scripts Online"
  description="Execute PHP scripts online directly in your browser. Test syntax, algorithms, string operations, and arrays with instant output rendering."
  category="Compiler Tools"
  calculatorName="Online PHP Compiler"
  slug="php-compiler"
  keywords={[
    'online php compiler',
    'php compiler',
    'run php online',
    'php online compiler',
    'test php code',
    'php sandbox'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- Header Hero Intro -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-violet-50 dark:bg-violet-950/60 border border-violet-200 dark:border-violet-800/80 text-violet-700 dark:text-violet-300 text-xs font-semibold tracking-wide">
        <span>🐘</span>
        <span>PHP 8.3 • Real-Time Echo Capture • No Local Server Required</span>
      </div>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Test, debug, and run <strong>PHP scripts online</strong> directly in your browser. Verify syntax, experiment with array algorithms, and test server-side logic with instant terminal output and zero setup.
      </p>
    </div>

    <!-- Interactive Code Editor Widget -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-xl dark:border-slate-800 dark:bg-slate-900 overflow-hidden">
      <!-- Editor Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-950">
        <div class="flex items-center gap-2">
          <span class="flex h-3 w-3 rounded-full bg-violet-500"></span>
          <span class="font-mono text-xs font-bold text-slate-700 dark:text-slate-200">index.php</span>
          <span class="text-xs text-slate-400">|</span>
          <label class="text-xs text-slate-500 dark:text-slate-400">Template:</label>
          <select id="code-runner-templates" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <option value="hello">Hello World</option>
            <option value="arrays">Associative Arrays</option>
            <option value="functions">Custom Functions</option>
          </select>
        </div>

        <div class="flex items-center gap-2">
          <button id="code-runner-copy" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            📋 Copy
          </button>
          <button id="code-runner-download" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            💾 Download .php
          </button>
          <button id="code-runner-clear" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:border-slate-700 dark:bg-slate-800 dark:text-rose-400 dark:hover:bg-slate-700">
            🗑️ Clear
          </button>
          <button id="code-runner-btn" type="button" class="inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-4 py-1.5 text-xs font-bold text-white shadow-md hover:bg-violet-700 active:scale-95 transition">
            ▶ Run Code <span class="hidden sm:inline text-[10px] opacity-80">(Ctrl+Enter)</span>
          </button>
        </div>
      </div>

      <!-- Code Textarea Editor -->
      <div class="relative bg-[#1e1e2e]">
        <textarea
          id="code-runner-input"
          class="w-full h-80 sm:h-96 p-4 font-mono text-sm leading-relaxed text-[#cdd6f4] bg-transparent resize-y focus:outline-none border-0"
          spellcheck="false"
          set:text={defaultCode}
        />
      </div>

      <!-- Output Terminal Console -->
      <div class="border-t border-slate-800 bg-[#11111b] p-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80 mb-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="font-mono text-slate-400 uppercase tracking-wider font-bold">Terminal Output</span>
            <span id="code-runner-status" class="text-xs px-2.5 py-0.5 rounded-full font-medium bg-slate-800 text-slate-300">Ready</span>
          </div>
          <div class="flex items-center gap-3 text-slate-400 font-mono text-xs">
            <span>Execution Time: <strong id="code-runner-time" class="text-slate-200">0ms</strong></span>
          </div>
        </div>

        <pre id="code-runner-output" class="font-mono text-xs sm:text-sm text-[#a6e3a1] min-h-30 max-h-72 overflow-y-auto whitespace-pre-wrap select-text leading-relaxed">Click "Run Code" or press Ctrl+Enter to execute your PHP script.</pre>
      </div>
    </div>
  </div>

  <script is:inline set:html={`document.body.setAttribute('data-tool-lang', 'php'); window.__COMPILER_TEMPLATES = ${templatesJson};`} />
  <script is:inline src="/js/tools/compiler-runner.js"></script>
</CalculatorLayout>
