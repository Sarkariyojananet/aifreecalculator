---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "What is an online JavaScript compiler?",
    answer: "An online JavaScript compiler (or runner) is a browser-based development environment that executes modern ECMAScript (ES6+) code directly, capturing console output, return values, and runtime errors in real time."
  },
  {
    question: "Does it support async/await and Promises?",
    answer: "Yes, modern asynchronous JavaScript syntax including async/await, Promise chains, setTimeout/delay, and fetch operations are fully supported."
  },
  {
    question: "How are console logs displayed?",
    answer: "Calls to console.log, console.info, console.warn, console.error, and console.table are intercepted and formatted into clean terminal lines below the editor."
  },
  {
    question: "Is running JavaScript in the browser secure?",
    answer: "Yes. Your code executes in a sandboxed client environment with zero server uploads, keeping your proprietary logic and test data completely private."
  },
  {
    question: "Can I download my JavaScript code as a file?",
    answer: "Yes, click the 'Download .js' button to save your code locally as script.js."
  },
  {
    question: "Can I format objects and arrays?",
    answer: "Yes, objects and arrays printed to the console are automatically formatted with JSON syntax indentation."
  },
  {
    question: "What keyboard shortcut triggers execution?",
    answer: "You can press Ctrl + Enter (Cmd + Enter on macOS) from inside the code editor to run your JavaScript immediately."
  },
  {
    question: "Is this JavaScript compiler free?",
    answer: "Yes, it is 100% free with unlimited runs, zero watermarks, and no sign-up or credit card required."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
const defaultCode = `// JavaScript ES6+ - Hello World
console.log("Hello, World!");
const developer = {
  name: "Coder",
  platform: "AI Free Calculator",
  skills: ["JavaScript", "HTML", "CSS", "Python"]
};
console.log("Welcome!", developer);

// Array Mapping Example
const numbers = [1, 2, 3, 4, 5];
const doubled = numbers.map(n => n * 2);
console.log("Doubled numbers:", doubled);
`;
---

<CalculatorLayout
  title="Online JavaScript Compiler - Run JS Code in Browser"
  description="Execute modern ES6+ JavaScript code in a secure browser sandbox with live console output, error logging, and performance benchmarks."
  category="Compiler Tools"
  calculatorName="Online JavaScript Compiler"
  slug="javascript-compiler"
  keywords={[
    'online javascript compiler',
    'javascript compiler',
    'js online compiler',
    'run javascript online',
    'js runner',
    'online js editor'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- Header Hero Intro -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/80 text-amber-700 dark:text-amber-300 text-xs font-semibold tracking-wide">
        <span>⚡</span>
        <span>Modern ES6+ • In-Browser Sandboxed Execution • Async/Await Ready</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Online JavaScript Compiler
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Execute modern <strong>ES6+ JavaScript code</strong> in a secure client-side sandbox. Instant console output, asynchronous runtime support, performance benchmarking, and zero server roundtrips.
      </p>
    </div>

    <!-- Interactive Code Editor Widget -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-xl dark:border-slate-800 dark:bg-slate-900 overflow-hidden">
      <!-- Editor Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-950">
        <div class="flex items-center gap-2">
          <span class="flex h-3 w-3 rounded-full bg-amber-500"></span>
          <span class="font-mono text-xs font-bold text-slate-700 dark:text-slate-200">index.js</span>
          <span class="text-xs text-slate-400">|</span>
          <label class="text-xs text-slate-500 dark:text-slate-400">Template:</label>
          <select id="js-template-select" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <option value="hello">Hello World</option>
            <option value="async">Async / Await & Promises</option>
            <option value="algorithms">Array Methods & Data</option>
            <option value="math">Prime Numbers Algorithm</option>
          </select>
        </div>

        <div class="flex items-center gap-2">
          <button id="js-copy-btn" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            📋 Copy
          </button>
          <button id="js-download-btn" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            💾 Download .js
          </button>
          <button id="js-clear-btn" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:border-slate-700 dark:bg-slate-800 dark:text-rose-400 dark:hover:bg-slate-700">
            🗑️ Clear
          </button>
          <button id="js-run-btn" type="button" class="inline-flex items-center gap-1.5 rounded-lg bg-amber-600 px-4 py-1.5 text-xs font-bold text-white shadow-md hover:bg-amber-700 active:scale-95 transition">
            ▶ Run Code <span class="hidden sm:inline text-[10px] opacity-80">(Ctrl+Enter)</span>
          </button>
        </div>
      </div>

      <!-- Code Textarea Editor -->
      <div class="relative bg-[#1e1e2e]">
        <textarea
          id="js-code-input"
          class="w-full h-80 sm:h-96 p-4 font-mono text-sm leading-relaxed text-[#cdd6f4] bg-transparent resize-y focus:outline-none border-0"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          set:text={defaultCode}
        />
      </div>

      <!-- Output Terminal Console -->
      <div class="border-t border-slate-800 bg-[#11111b] p-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80 mb-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="font-mono text-slate-400 uppercase tracking-wider font-bold">Terminal Output</span>
            <span id="js-status-badge" class="text-xs px-2.5 py-0.5 rounded-full font-medium bg-slate-800 text-slate-300">Ready</span>
          </div>
          <div class="flex items-center gap-3 text-slate-400 font-mono text-xs">
            <span>Execution Time: <strong id="js-exec-time" class="text-slate-200">0ms</strong></span>
          </div>
        </div>

        <pre id="js-output-console" class="font-mono text-xs sm:text-sm text-[#a6e3a1] min-h-30 max-h-72 overflow-y-auto whitespace-pre-wrap select-text leading-relaxed">Click "Run Code" or press Ctrl+Enter to execute JavaScript in your browser.</pre>
      </div>
    </div>
  </div>

  <script is:inline src="/js/tools/javascript-compiler.js"></script>
</CalculatorLayout>
