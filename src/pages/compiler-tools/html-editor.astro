---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "What is an online HTML editor?",
    answer: "An online HTML editor is a browser-based coding tool that allows you to write, edit, and preview HTML, CSS, and JavaScript code simultaneously in real time."
  },
  {
    question: "How does the live preview work?",
    answer: "The live preview dynamically renders your markup, styles, and scripts in an isolated preview frame right next to or below your code, showing changes instantly."
  },
  {
    question: "Can I test responsive viewport sizes?",
    answer: "Yes, you can toggle between Desktop (100%), Tablet (768px), and Mobile (375px) viewports to verify how your web designs adapt to different screen dimensions."
  },
  {
    question: "Can I download my finished webpage?",
    answer: "Yes, clicking the 'Download' button bundles your HTML, CSS, and JavaScript into a single, clean index.html file that you can host anywhere."
  },
  {
    question: "Can I import external CSS or font frameworks?",
    answer: "Yes, you can add standard link tags for Google Fonts, Tailwind CSS, Bootstrap, and FontAwesome directly into the HTML editor panel."
  },
  {
    question: "Is this HTML editor completely free?",
    answer: "Yes, it is 100% free with unlimited edits, zero subscriptions, and no registration or sign-up required."
  },
  {
    question: "Does this editor save my code if I refresh?",
    answer: "You can download your code as a standalone HTML file at any time to preserve your progress locally on your computer."
  },
  {
    question: "Are my files uploaded to your servers?",
    answer: "No. Everything runs strictly inside your local browser frame, ensuring your designs, proprietary copy, and code remain 100% confidential."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
const defaultHtml = `<div class="card">
  <div class="badge">LIVE PREVIEW</div>
  <h1>Interactive HTML Card</h1>
  <p>Edit HTML, CSS, and JS tabs to watch the preview update instantly!</p>
  <button id="demo-btn">Click Me!</button>
  <p id="counter">Clicks: 0</p>
</div>`;

const defaultCss = `body {
  font-family: system-ui, -apple-system, sans-serif;
  background: #f8fafc;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 90vh;
  margin: 0;
  padding: 16px;
}
.card {
  background: white;
  padding: 32px;
  border-radius: 16px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
  max-width: 400px;
  text-align: center;
}
.badge {
  display: inline-block;
  padding: 4px 12px;
  background: #dbeafe;
  color: #1e40af;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 12px;
}
h1 {
  font-size: 22px;
  color: #0f172a;
  margin: 0 0 8px;
}
p {
  color: #64748b;
  font-size: 14px;
  line-height: 1.5;
}
button {
  background: #2563eb;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  margin-top: 12px;
  transition: transform 0.1s;
}
button:active {
  transform: scale(0.96);
}`;

const defaultJs = `let count = 0;
const btn = document.getElementById('demo-btn');
const counterText = document.getElementById('counter');

btn.addEventListener('click', () => {
  count++;
  counterText.textContent = "Clicks: " + count;
  btn.style.backgroundColor = count % 2 === 0 ? '#2563eb' : '#059669';
});`;
---

<CalculatorLayout
  title="Online HTML Editor - Live HTML, CSS & JS Code Playground"
  description="Live interactive HTML, CSS, and JavaScript editor with real-time browser preview, responsive device toggle, and clean code exporting."
  category="Compiler Tools"
  calculatorName="Online HTML Editor"
  slug="html-editor"
  keywords={[
    'online html editor',
    'html editor',
    'live html preview',
    'html css js editor',
    'html playground',
    'html code runner'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- Header Hero Intro -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <span>🌐</span>
        <span>Live Preview • HTML5, CSS3 & JavaScript • Responsive Device Simulator</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Online HTML Editor
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Design and test web pages interactively with our <strong>live online HTML editor</strong>. Edit HTML, CSS, and JavaScript with synchronized real-time preview, device screen toggling, and instant file exporting.
      </p>
    </div>

    <!-- Interactive HTML Editor Widget -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-xl dark:border-slate-800 dark:bg-slate-900 overflow-hidden">
      <!-- Top Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-950">
        <!-- Tabs -->
        <div class="flex items-center gap-1.5">
          <button data-tab="html" type="button" class="code-tab-btn rounded-lg px-3 py-1.5 text-xs font-bold transition bg-blue-600 text-white shadow-xs">
            HTML
          </button>
          <button data-tab="css" type="button" class="code-tab-btn rounded-lg px-3 py-1.5 text-xs font-bold transition bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700">
            CSS
          </button>
          <button data-tab="js" type="button" class="code-tab-btn rounded-lg px-3 py-1.5 text-xs font-bold transition bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700">
            JavaScript
          </button>
        </div>

        <!-- Controls -->
        <div class="flex items-center gap-2">
          <!-- Device Switcher -->
          <div class="hidden sm:flex items-center rounded-lg border border-slate-200 bg-slate-100 p-0.5 text-xs dark:border-slate-700 dark:bg-slate-800">
            <button data-device="desktop" type="button" class="device-preview-btn rounded px-2 py-1 font-semibold text-slate-700 dark:text-slate-200 bg-slate-300 dark:bg-slate-700">
              🖥️ Desktop
            </button>
            <button data-device="tablet" type="button" class="device-preview-btn rounded px-2 py-1 font-semibold text-slate-700 dark:text-slate-200">
              📱 Tablet
            </button>
            <button data-device="mobile" type="button" class="device-preview-btn rounded px-2 py-1 font-semibold text-slate-700 dark:text-slate-200">
              📲 Mobile
            </button>
          </div>

          <button id="html-download-btn" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            💾 Download
          </button>
          <button id="html-clear-btn" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:border-slate-700 dark:bg-slate-800 dark:text-rose-400 dark:hover:bg-slate-700">
            🗑️ Clear
          </button>
          <button id="html-run-btn" type="button" class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition">
            ▶ Update Preview
          </button>
        </div>
      </div>

      <!-- Split Layout: Code Editor + Live Preview -->
      <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800">
        <!-- Editor Column -->
        <div class="bg-[#1e1e2e]">
          <!-- HTML Panel -->
          <div id="html-panel" class="code-editor-panel p-3">
            <textarea
              id="html-code-input"
              class="w-full h-80 sm:h-96 font-mono text-sm leading-relaxed text-[#cdd6f4] bg-transparent resize-y focus:outline-none border-0"
              spellcheck="false"
              set:text={defaultHtml}
            />
          </div>

          <!-- CSS Panel -->
          <div id="css-panel" class="code-editor-panel p-3 hidden">
            <textarea
              id="css-code-input"
              class="w-full h-80 sm:h-96 font-mono text-sm leading-relaxed text-[#cdd6f4] bg-transparent resize-y focus:outline-none border-0"
              spellcheck="false"
              set:text={defaultCss}
            />
          </div>

          <!-- JS Panel -->
          <div id="js-panel" class="code-editor-panel p-3 hidden">
            <textarea
              id="js-code-input"
              class="w-full h-80 sm:h-96 font-mono text-sm leading-relaxed text-[#cdd6f4] bg-transparent resize-y focus:outline-none border-0"
              spellcheck="false"
              set:text={defaultJs}
            />
          </div>
        </div>

        <!-- Live Preview Column -->
        <div class="bg-slate-100 dark:bg-slate-950 p-4 flex items-center justify-center min-h-90">
          <div id="preview-frame-wrapper" class="w-full h-full min-h-85 transition-all duration-300 mx-auto shadow-sm rounded-xl overflow-hidden bg-white">
            <iframe id="html-preview-frame" class="w-full h-full min-h-85 border-0" sandbox="allow-scripts allow-modals"></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="/js/tools/html-editor.js"></script>
</CalculatorLayout>

