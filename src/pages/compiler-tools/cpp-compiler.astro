---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    question: "What is an online C++ compiler?",
    answer: "An online C++ compiler is a web-based integrated tool that lets you write, compile, and run C++ code without having to install GCC, Clang, or Visual Studio locally on your computer."
  },
  {
    question: "Which C++ standard is supported?",
    answer: "The environment supports modern C++ standards including C++17 and C++20 with standard library (STL) headers such as vector, map, string, algorithm, and iostream."
  },
  {
    question: "How do I provide standard input (cin)?",
    answer: "You can type your inputs directly into the custom STDIN panel before clicking 'Run Code', and std::cin will read them sequentially during execution."
  },
  {
    question: "Can I download my C++ source code?",
    answer: "Yes, click 'Download .cpp' to save your complete program locally to your computer or mobile device."
  },
  {
    question: "Is this C++ compiler free to use?",
    answer: "Yes, our online C++ compiler is 100% free with unlimited runs, zero account setup, and no subscriptions."
  },
  {
    question: "What keyboard shortcut runs the program?",
    answer: "Press Ctrl + Enter (or Cmd + Enter on macOS) while inside the editor to compile and execute immediately."
  },
  {
    question: "Does it support common algorithms and data structures?",
    answer: "Yes. You can write, test, and debug sorting algorithms, binary search trees, graph algorithms, and competitive programming problems."
  },
  {
    question: "Are my C++ files saved securely?",
    answer: "Everything executes in a clean client-side session with zero tracking, ensuring your assignments and algorithmic code remain private."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
const defaultCode = `#include <iostream>
#include <vector>
#include <numeric>

int main() {
    std::cout << "Hello, World from Online C++ Compiler!" << std::endl;

    std::vector<int> numbers = {10, 25, 40, 55, 70};
    int total = std::accumulate(numbers.begin(), numbers.end(), 0);

    std::cout << "Vector Size: " << numbers.size() << std::endl;
    std::cout << "Total Sum: " << total << std::endl;

    return 0;
}
`;

const templatesJson = JSON.stringify({
  hello: `#include <iostream>\n\nint main() {\n    std::cout << "Hello, World!" << std::endl;\n    return 0;\n}`,
  vector: `#include <iostream>\n#include <vector>\n#include <algorithm>\n\nint main() {\n    std::vector<int> nums = {45, 12, 85, 32, 89, 39, 69};\n    std::sort(nums.begin(), nums.end());\n    std::cout << "Sorted elements: ";\n    for(int n : nums) std::cout << n << " ";\n    std::cout << std::endl;\n    return 0;\n}`,
  fibonacci: `#include <iostream>\n\nint fibonacci(int n) {\n    if (n <= 1) return n;\n    return fibonacci(n - 1) + fibonacci(n - 2);\n}\n\nint main() {\n    int term = 10;\n    std::cout << "Fibonacci term " << term << " is: " << fibonacci(term) << std::endl;\n    return 0;\n}`,
  oop: `#include <iostream>\n#include <string>\n\nclass Student {\npublic:\n    std::string name;\n    int grade;\n    void display() {\n        std::cout << "Student: " << name << ", Grade: " << grade << std::endl;\n    }\n};\n\nint main() {\n    Student s;\n    s.name = "Jordan";\n    s.grade = 95;\n    s.display();\n    return 0;\n}`
});
---

<CalculatorLayout
  layoutVariant="workspace"
  title="Online C++ Compiler - Compile & Run C++ Programs Online"
  description="Write, compile, and execute C++ programs online with standard template libraries, custom input stdin, and real-time terminal output."
  category="Compiler Tools"
  calculatorName="Online C++ Compiler"
  slug="cpp-compiler"
  keywords={[
    'online cpp compiler',
    'online c++ compiler',
    'c++ compiler online',
    'run cpp online',
    'c++ code runner',
    'cpp ide online'
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-6">
    <!-- Header Hero Intro -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-blue-700 dark:text-blue-300 text-xs font-semibold tracking-wide">
        <span>⚙️</span>
        <span>Modern C++20 • STL Libraries • Interactive Terminal & STDIN</span>
      </div>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Compile, run, and test <strong>C++ programs online</strong> in real time. Full support for C++ STL containers, algorithms, interactive console input, and instant error debugging with zero installation.
      </p>
    </div>

    <!-- Interactive Code Editor Widget -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-xl dark:border-slate-800 dark:bg-slate-900 overflow-hidden">
      <!-- Editor Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-950">
        <div class="flex items-center gap-2">
          <span class="flex h-3 w-3 rounded-full bg-blue-500"></span>
          <span class="font-mono text-xs font-bold text-slate-700 dark:text-slate-200">main.cpp</span>
          <span class="text-xs text-slate-400">|</span>
          <label class="text-xs text-slate-500 dark:text-slate-400">Template:</label>
          <select id="code-runner-templates" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <option value="hello">Hello World</option>
            <option value="vector">STL Vector & Sorting</option>
            <option value="fibonacci">Fibonacci Function</option>
            <option value="oop">OOP Class Structure</option>
          </select>
        </div>

        <div class="flex items-center gap-2">
          <button id="code-runner-copy" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            📋 Copy
          </button>
          <button id="code-runner-download" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            💾 Download .cpp
          </button>
          <button id="code-runner-clear" type="button" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:border-slate-700 dark:bg-slate-800 dark:text-rose-400 dark:hover:bg-slate-700">
            🗑️ Clear
          </button>
          <button id="code-runner-btn" type="button" class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition">
            ▶ Run Code <span class="hidden sm:inline text-[10px] opacity-80">(Ctrl+Enter)</span>
          </button>
        </div>
      </div>

      <!-- Code Textarea Editor -->
      <div class="relative bg-[#1e1e2e]">
        <textarea
          id="code-runner-input"
          class="w-full h-80 sm:h-96 p-4 font-mono text-sm leading-relaxed text-[#cdd6f4] bg-transparent resize-y focus:outline-none border-0"
          spellcheck="false"
          set:text={defaultCode}
        />
      </div>

      <!-- Standard Input (STDIN) -->
      <div class="border-t border-slate-800 bg-[#181825] px-4 py-2">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
          <span class="font-mono">Standard Input (STDIN):</span>
        </div>
        <input
          id="code-runner-stdin"
          type="text"
          placeholder="Enter input values for std::cin here..."
          class="w-full bg-[#11111b] border border-slate-700 rounded px-3 py-1.5 text-xs font-mono text-slate-200 focus:outline-none focus:border-blue-500"
        />
      </div>

      <!-- Output Terminal Console -->
      <div class="border-t border-slate-800 bg-[#11111b] p-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80 mb-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="font-mono text-slate-400 uppercase tracking-wider font-bold">Terminal Output</span>
            <span id="code-runner-status" class="text-xs px-2.5 py-0.5 rounded-full font-medium bg-slate-800 text-slate-300">Ready</span>
          </div>
          <div class="flex items-center gap-3 text-slate-400 font-mono text-xs">
            <span>Execution Time: <strong id="code-runner-time" class="text-slate-200">0ms</strong></span>
          </div>
        </div>

        <pre id="code-runner-output" class="font-mono text-xs sm:text-sm text-[#a6e3a1] min-h-30 max-h-72 overflow-y-auto whitespace-pre-wrap select-text leading-relaxed">Click "Run Code" or press Ctrl+Enter to compile and run your C++ program.</pre>
      </div>
    </div>
  </div>

  <script is:inline set:html={`document.body.setAttribute('data-tool-lang', 'cpp'); window.__COMPILER_TEMPLATES = ${templatesJson};`} />
  <script is:inline src="/js/tools/compiler-runner.js"></script>
</CalculatorLayout>
