---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Percentage Calculator – Calculate Percentages, Marks, CGPA, Attendance and More"
  description="Free online percentage calculator. Solve what is X% of Y, marks percentage, CGPA to percentage, salary hike, attendance target, body fat %, win rate, average %, and percentage increase/decrease."
  category="General"
  calculatorName="Percentage Calculator"
  slug="percentage-calculator"
  keywords={[
    'Percentage Calculator',
    'marks percentage calculator',
    'cgpa to percentage calculator',
    'body fat percentage calculator',
    'hike percentage calculator',
    'percentage calculator marks',
    'love percentage calculator',
    'mark percentage calculator',
    'percentage calculator of marks',
    'attendance percentage calculator',
    'grade percentage calculator',
    'win percentage calculator',
    'weight loss percentage calculator',
    'increase percentage calculator',
    'average percentage calculator'
  ]}
>
  <div class="space-y-8">
    
    <!-- QUICK NAVIGATION ANCHOR BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <span class="text-slate-500 dark:text-slate-400 shrink-0 mr-1 flex items-center gap-1">
          <span>⚡</span> Jump to Tool:
        </span>
        <a href="#calc-main" class="shrink-0 rounded-lg bg-blue-50 px-2.5 py-1 text-blue-700 hover:bg-blue-100 dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-blue-900">General %</a>
        <a href="#calc-marks" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Marks & Grade</a>
        <a href="#calc-cgpa" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">CGPA to %</a>
        <a href="#calc-attendance" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Attendance</a>
        <a href="#calc-hike" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Salary Hike</a>
        <a href="#calc-inc-dec" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Increase / Decrease</a>
        <a href="#calc-average" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Average %</a>
        <a href="#calc-win" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Win Rate</a>
        <a href="#calc-weight-loss" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Weight Loss %</a>
        <a href="#calc-body-fat" class="shrink-0 rounded-lg bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Body Fat %</a>
        <a href="#calc-love" class="shrink-0 rounded-lg bg-pink-50 px-2.5 py-1 text-pink-700 hover:bg-pink-100 dark:bg-pink-950/60 dark:text-pink-300 dark:hover:bg-pink-900">Love % 💕</a>
      </div>
    </div>

    <!-- 1. PRIMARY ALL-IN-ONE PERCENTAGE CALCULATOR -->
    <div id="calc-main" class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/40 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- Top Title & Mode Selector -->
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>％</span> Universal Percentage Calculator
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Select calculation mode, enter values, and click <strong>Calculate</strong>.
            </p>
          </div>
          <span class="rounded-full bg-blue-100 px-3 py-1 text-[11px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
            Multi-Mode Engine
          </span>
        </div>

        <!-- Mode Tabs -->
        <div class="mt-4 flex flex-wrap gap-1.5 text-xs">
          <button type="button" class="btn-main-mode active rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-mode="percent_of">What is X% of Y?</button>
          <button type="button" class="btn-main-mode rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="is_what_percent">X is what % of Y?</button>
          <button type="button" class="btn-main-mode rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_change">% Change (Inc/Dec)</button>
          <button type="button" class="btn-main-mode rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_diff">% Difference</button>
          <button type="button" class="btn-main-mode rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="value_after">Value after %</button>
        </div>
      </div>

      <!-- Quick Preset Chips -->
      <div class="mt-4 rounded-2xl border border-slate-200/80 bg-slate-50/70 p-3 dark:border-slate-800 dark:bg-slate-900/50">
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
            <span>⚡</span> Popular Presets:
          </span>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_of" data-v1="10" data-v2="100">10% of 100</button>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_of" data-v1="20" data-v2="500">20% of 500</button>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_of" data-v1="25" data-v2="1000">25% of 1000</button>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_of" data-v1="50" data-v2="200">50% of 200</button>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_of" data-v1="75" data-v2="400">75% of 400</button>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_change" data-v1="100" data-v2="110">10% Increase</button>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_change" data-v1="100" data-v2="120">20% Increase</button>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_change" data-v1="100" data-v2="75">25% Decrease</button>
          <button type="button" class="btn-main-preset rounded-lg border border-slate-300 bg-white px-2 py-0.5 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-mode="percent_change" data-v1="100" data-v2="50">50% Decrease</button>
        </div>
      </div>

      <!-- Main Inputs Form -->
      <form id="form-main" class="mt-5 space-y-4" novalidate onsubmit="return false;">
        
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-12 items-end">
          
          <div class="sm:col-span-4">
            <label id="lbl-main-v1" for="input-main-v1" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Percentage (%)
            </label>
            <input
              type="number"
              id="input-main-v1"
              placeholder="e.g. 20"
              step="any"
              class="mt-1.5 w-full rounded-xl border-2 border-slate-300 bg-white px-3.5 py-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="sm:col-span-4">
            <label id="lbl-main-v2" for="input-main-v2" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Total / Whole Value
            </label>
            <input
              type="number"
              id="input-main-v2"
              placeholder="e.g. 500"
              step="any"
              class="mt-1.5 w-full rounded-xl border-2 border-slate-300 bg-white px-3.5 py-2.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <!-- Action buttons -->
          <div class="sm:col-span-4 flex items-center gap-2">
            <button
              type="submit"
              id="btn-main-calc"
              class="w-full inline-flex items-center justify-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-sm font-extrabold text-white shadow-lg shadow-blue-600/20 transition active:scale-[0.98] cursor-pointer"
            >
              <span>Calculate</span>
              <span>→</span>
            </button>
            <button
              type="button"
              id="btn-main-clear"
              class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              ✕
            </button>
          </div>

        </div>

        <p id="err-main" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        <!-- Main Results Container -->
        <div id="res-main-card" class="hidden mt-4 rounded-2xl border border-blue-200 bg-blue-50/50 p-4 sm:p-5 dark:border-blue-900/60 dark:bg-slate-900">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-blue-200/80 pb-3 dark:border-slate-800">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Calculation Result</span>
            <span id="res-main-subtext" class="text-xs text-slate-500 dark:text-slate-400 font-mono">Formula: (20 / 100) × 500</span>
          </div>

          <div class="mt-3 flex flex-wrap items-baseline gap-3">
            <span id="res-main-value" class="text-3xl sm:text-4xl font-black tracking-tight text-blue-600 dark:text-blue-400">100</span>
            <span id="res-main-badge" class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">20% of 500</span>
          </div>

          <div id="res-main-explanation" class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-mono">
            20% of 500 is equal to 100.
          </div>
        </div>

      </form>
    </div>


    <!-- 2. MARKS PERCENTAGE CALCULATOR & GRADE CALCULATOR -->
    <div id="calc-marks" class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-7">
      <div class="border-b border-slate-100 pb-4 dark:border-slate-800">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🎓</span> Marks Percentage & Grade Calculator
            </h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Calculate exam marks percentage, grade breakdown, and multi-subject overall marks.
            </p>
          </div>
          <div class="flex items-center gap-1 text-xs">
            <button type="button" id="tab-marks-single" class="tab-marks active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer">Single Total</button>
            <button type="button" id="tab-marks-multi" class="tab-marks rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">Multi-Subject</button>
          </div>
        </div>
      </div>

      <form id="form-marks" class="mt-4 space-y-4" novalidate onsubmit="return false;">
        
        <!-- Single Mode Inputs -->
        <div id="marks-single-mode" class="grid grid-cols-1 gap-3 sm:grid-cols-12 items-end">
          <div class="sm:col-span-5">
            <label for="input-marks-obtained" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Obtained Marks
            </label>
            <input
              type="number"
              id="input-marks-obtained"
              placeholder="e.g. 450"
              step="any"
              min="0"
              class="mt-1.5 w-full rounded-xl border-2 border-slate-300 bg-white px-3.5 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="sm:col-span-4">
            <label for="input-marks-total" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Total Maximum Marks
            </label>
            <input
              type="number"
              id="input-marks-total"
              placeholder="e.g. 500"
              step="any"
              min="1"
              class="mt-1.5 w-full rounded-xl border-2 border-slate-300 bg-white px-3.5 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="sm:col-span-3 flex items-center gap-2">
            <button
              type="submit"
              id="btn-marks-calc"
              class="w-full inline-flex items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-700 px-4 py-2 text-sm font-bold text-white shadow-sm transition active:scale-[0.98] cursor-pointer"
            >
              Calculate
            </button>
            <button
              type="button"
              id="btn-marks-clear"
              class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              ✕
            </button>
          </div>
        </div>

        <!-- Multi-Subject Mode Container (Hidden initially) -->
        <div id="marks-multi-mode" class="hidden space-y-3">
          <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-300">
            <span>Subject-wise Marks List:</span>
            <button type="button" id="btn-add-subject" class="inline-flex items-center gap-1 rounded-lg bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700 hover:bg-blue-100 dark:bg-blue-950 dark:text-blue-300 cursor-pointer">
              <span>+ Add Subject</span>
            </button>
          </div>

          <div id="subject-rows-container" class="space-y-2">
            <!-- Row 1 -->
            <div class="subject-row flex items-center gap-2">
              <input type="text" placeholder="Subject 1 (e.g. Math)" class="sub-name w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="Subject 1" />
              <input type="number" placeholder="Obtained" class="sub-obtained w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="85" />
              <input type="number" placeholder="Total" class="sub-total w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="100" />
            </div>
            <!-- Row 2 -->
            <div class="subject-row flex items-center gap-2">
              <input type="text" placeholder="Subject 2" class="sub-name w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="Subject 2" />
              <input type="number" placeholder="Obtained" class="sub-obtained w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="92" />
              <input type="number" placeholder="Total" class="sub-total w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="100" />
            </div>
            <!-- Row 3 -->
            <div class="subject-row flex items-center gap-2">
              <input type="text" placeholder="Subject 3" class="sub-name w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="Subject 3" />
              <input type="number" placeholder="Obtained" class="sub-obtained w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="78" />
              <input type="number" placeholder="Total" class="sub-total w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="100" />
            </div>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button
              type="button"
              id="btn-multi-marks-calc"
              class="rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2 text-sm font-bold text-white shadow-sm transition active:scale-[0.98] cursor-pointer"
            >
              Calculate Overall Percentage
            </button>
            <button
              type="button"
              id="btn-multi-marks-clear"
              class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Clear
            </button>
          </div>
        </div>

        <p id="err-marks" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        <!-- Marks Results Card -->
        <div id="res-marks-box" class="hidden pt-3 border-t border-slate-100 dark:border-slate-800">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 text-xs">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/60">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Marks Percentage</div>
              <div id="res-marks-pct" class="mt-1 text-xl sm:text-2xl font-black text-blue-600 dark:text-blue-400">90.00%</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/60">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Overall Grade</div>
              <div id="res-marks-grade" class="mt-1 text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400">A+</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/60">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Obtained Marks</div>
              <div id="res-marks-obt-val" class="mt-1 text-base sm:text-lg font-bold text-slate-900 dark:text-white">450</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/60">
              <div class="text-slate-500 dark:text-slate-400 font-semibold">Total Maximum</div>
              <div id="res-marks-tot-val" class="mt-1 text-base sm:text-lg font-bold text-slate-900 dark:text-white">500</div>
            </div>
          </div>
        </div>

      </form>
    </div>


    <!-- 3. CGPA TO PERCENTAGE CALCULATOR -->
    <div id="calc-cgpa" class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-7">
      <div class="border-b border-slate-100 pb-4 dark:border-slate-800">
