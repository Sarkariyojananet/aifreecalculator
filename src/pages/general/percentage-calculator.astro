<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // ==========================================
  // 1. PRIMARY MULTI-MODE PERCENTAGE TOOL
  // ==========================================
  let currentMainMode = 'percent_of'; // 'percent_of' | 'is_what_percent' | 'percent_change' | 'percent_diff' | 'value_after'

  const btnMainModes = document.querySelectorAll('.btn-main-mode');
  const lblMainV1 = document.getElementById('lbl-main-v1');
  const lblMainV2 = document.getElementById('lbl-main-v2');
  const inputMainV1 = document.getElementById('input-main-v1');
  const inputMainV2 = document.getElementById('input-main-v2');
  const btnMainCalc = document.getElementById('btn-main-calc');
  const btnMainClear = document.getElementById('btn-main-clear');
  const errMain = document.getElementById('err-main');
  const resMainCard = document.getElementById('res-main-card');
  const resMainValue = document.getElementById('res-main-value');
  const resMainBadge = document.getElementById('res-main-badge');
  const resMainSubtext = document.getElementById('res-main-subtext');
  const resMainExplanation = document.getElementById('res-main-explanation');

  function updateMainModeLabels() {
    switch (currentMainMode) {
      case 'percent_of':
        lblMainV1.textContent = 'Percentage (%)';
        inputMainV1.placeholder = 'e.g. 20';
        lblMainV2.textContent = 'Total / Whole Value';
        inputMainV2.placeholder = 'e.g. 500';
        break;
      case 'is_what_percent':
        lblMainV1.textContent = 'Part Value (X)';
        inputMainV1.placeholder = 'e.g. 50';
        lblMainV2.textContent = 'Whole Value (Y)';
        inputMainV2.placeholder = 'e.g. 200';
        break;
      case 'percent_change':
        lblMainV1.textContent = 'Original Value';
        inputMainV1.placeholder = 'e.g. 100';
        lblMainV2.textContent = 'New Value';
        inputMainV2.placeholder = 'e.g. 150';
        break;
      case 'percent_diff':
        lblMainV1.textContent = 'First Value (V1)';
        inputMainV1.placeholder = 'e.g. 100';
        lblMainV2.textContent = 'Second Value (V2)';
        inputMainV2.placeholder = 'e.g. 120';
        break;
      case 'value_after':
        lblMainV1.textContent = 'Original Value';
        inputMainV1.placeholder = 'e.g. 100';
        lblMainV2.textContent = 'Percentage Increase (%)';
        inputMainV2.placeholder = 'e.g. 20';
        break;
    }
  }

  btnMainModes.forEach((btn) => {
    btn.addEventListener('click', () => {
      btnMainModes.forEach((b) => {
        b.className = 'btn-main-mode rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      });
      btn.className = 'btn-main-mode active rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      currentMainMode = btn.getAttribute('data-mode');
      updateMainModeLabels();
      errMain.classList.add('hidden');
      resMainCard.classList.add('hidden');
    });
  });

  function executeMainCalculation() {
    const v1Str = inputMainV1.value.trim();
    const v2Str = inputMainV2.value.trim();

    if (!v1Str || !v2Str) {
      errMain.textContent = 'Please enter both values to calculate.';
      errMain.classList.remove('hidden');
      resMainCard.classList.add('hidden');
      return;
    }

    const v1 = parseFloat(v1Str);
    const v2 = parseFloat(v2Str);

    if (isNaN(v1) || isNaN(v2)) {
      errMain.textContent = 'Please enter valid numeric values.';
      errMain.classList.remove('hidden');
      resMainCard.classList.add('hidden');
      return;
    }

    errMain.classList.add('hidden');

    let resultVal = '';
    let badgeText = '';
    let formulaText = '';
    let explanationText = '';

    switch (currentMainMode) {
      case 'percent_of': {
        const res = (v1 / 100) * v2;
        resultVal = Number(res.toFixed(4)).toString();
        badgeText = `${v1}% of ${v2}`;
        formulaText = `(${v1} ÷ 100) × ${v2} = ${resultVal}`;
        explanationText = `${v1}% of ${v2} is exactly ${resultVal}.`;
        break;
      }
      case 'is_what_percent': {
        if (v2 === 0) {
          errMain.textContent = 'Whole value cannot be zero.';
          errMain.classList.remove('hidden');
          return;
        }
        const res = (v1 / v2) * 100;
        resultVal = `${Number(res.toFixed(2))}%`;
        badgeText = `${v1} of ${v2}`;
        formulaText = `(${v1} ÷ ${v2}) × 100 = ${resultVal}`;
        explanationText = `${v1} is ${resultVal} of ${v2}.`;
        break;
      }
      case 'percent_change': {
        if (v1 === 0) {
          errMain.textContent = 'Original value cannot be zero for percentage change.';
          errMain.classList.remove('hidden');
          return;
        }
        const diff = v2 - v1;
        const pct = (diff / Math.abs(v1)) * 100;
        const isInc = diff >= 0;
        resultVal = `${isInc ? '+' : ''}${Number(pct.toFixed(2))}%`;
        badgeText = isInc ? 'Percentage Increase' : 'Percentage Decrease';
        formulaText = `((${v2} - ${v1}) ÷ |${v1}|) × 100 = ${resultVal}`;
        explanationText = `From ${v1} to ${v2} is an absolute change of ${Math.abs(diff)} (${Math.abs(Number(pct.toFixed(2)))}% ${isInc ? 'increase' : 'decrease'}).`;
        break;
      }
      case 'percent_diff': {
        const avg = (v1 + v2) / 2;
        if (avg === 0) {
          errMain.textContent = 'Average of both values cannot be zero.';
          errMain.classList.remove('hidden');
          return;
        }
        const diff = Math.abs(v1 - v2);
        const res = (diff / Math.abs(avg)) * 100;
        resultVal = `${Number(res.toFixed(2))}%`;
        badgeText = `Difference between ${v1} & ${v2}`;
        formulaText = `(|${v1} - ${v2}| ÷ ((${v1} + ${v2}) ÷ 2)) × 100 = ${resultVal}`;
        explanationText = `The percentage difference between ${v1} and ${v2} is ${resultVal}.`;
        break;
      }
      case 'value_after': {
        const change = (v2 / 100) * v1;
        const finalVal = v1 + change;
        resultVal = Number(finalVal.toFixed(4)).toString();
        badgeText = `${v1} + ${v2}%`;
        formulaText = `${v1} + (${v2}% of ${v1}) = ${resultVal}`;
        explanationText = `Increasing ${v1} by ${v2}% adds ${Number(change.toFixed(4))}, resulting in ${resultVal}.`;
        break;
      }
    }

    resMainValue.textContent = resultVal;
    resMainBadge.textContent = badgeText;
    resMainSubtext.textContent = `Formula: ${formulaText}`;
    resMainExplanation.textContent = explanationText;
    resMainCard.classList.remove('hidden');
  }

  btnMainCalc.addEventListener('click', (e) => {
    e.preventDefault();
    executeMainCalculation();
  });

  inputMainV1.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeMainCalculation();
    }
  });

  inputMainV2.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeMainCalculation();
    }
  });

  btnMainClear.addEventListener('click', () => {
    inputMainV1.value = '';
    inputMainV2.value = '';
    errMain.classList.add('hidden');
    resMainCard.classList.add('hidden');
    inputMainV1.focus();
  });

  // Preset Chips
  document.querySelectorAll('.btn-main-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-mode');
      const v1 = btn.getAttribute('data-v1');
      const v2 = btn.getAttribute('data-v2');

      const targetTab = document.querySelector(`.btn-main-mode[data-mode="${mode}"]`);
      if (targetTab) targetTab.click();

      inputMainV1.value = v1;
      inputMainV2.value = v2;
      executeMainCalculation();
    });
  });


  // ==========================================
  // 2. MARKS & GRADE CALCULATOR
  // ==========================================
  let isMultiMarks = false;

  const tabMarksSingle = document.getElementById('tab-marks-single');
  const tabMarksMulti = document.getElementById('tab-marks-multi');
  const marksSingleMode = document.getElementById('marks-single-mode');
  const marksMultiMode = document.getElementById('marks-multi-mode');

  const inputMarksObtained = document.getElementById('input-marks-obtained');
  const inputMarksTotal = document.getElementById('input-marks-total');
  const btnMarksCalc = document.getElementById('btn-marks-calc');
  const btnMarksClear = document.getElementById('btn-marks-clear');
  const errMarks = document.getElementById('err-marks');
  const resMarksBox = document.getElementById('res-marks-box');
  const resMarksPct = document.getElementById('res-marks-pct');
  const resMarksGrade = document.getElementById('res-marks-grade');
  const resMarksObtVal = document.getElementById('res-marks-obt-val');
  const resMarksTotVal = document.getElementById('res-marks-tot-val');

  const btnAddSubject = document.getElementById('btn-add-subject');
  const subjectRowsContainer = document.getElementById('subject-rows-container');
  const btnMultiMarksCalc = document.getElementById('btn-multi-marks-calc');
  const btnMultiMarksClear = document.getElementById('btn-multi-marks-clear');

  function getGrade(pct) {
    if (pct >= 90) return 'A+';
    if (pct >= 80) return 'A';
    if (pct >= 70) return 'B';
    if (pct >= 60) return 'C';
    if (pct >= 50) return 'D';
    return 'F';
  }

  tabMarksSingle.addEventListener('click', () => {
    isMultiMarks = false;
    tabMarksSingle.className = 'tab-marks active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
    tabMarksMulti.className = 'tab-marks rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
    marksSingleMode.classList.remove('hidden');
    marksMultiMode.classList.add('hidden');
    resMarksBox.classList.add('hidden');
  });

  tabMarksMulti.addEventListener('click', () => {
    isMultiMarks = true;
    tabMarksMulti.className = 'tab-marks active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
    tabMarksSingle.className = 'tab-marks rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
    marksSingleMode.classList.add('hidden');
    marksMultiMode.classList.remove('hidden');
    resMarksBox.classList.add('hidden');
  });

  let subjectCount = 3;
  btnAddSubject.addEventListener('click', () => {
    subjectCount++;
    const row = document.createElement('div');
    row.className = 'subject-row flex items-center gap-2';
    row.innerHTML = `
      <input type="text" placeholder="Subject ${subjectCount}" class="sub-name w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="Subject ${subjectCount}" />
      <input type="number" placeholder="Obtained" class="sub-obtained w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="80" />
      <input type="number" placeholder="Total" class="sub-total w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="100" />
    `;
    subjectRowsContainer.appendChild(row);
  });

  function executeMarksCalculation() {
    errMarks.classList.add('hidden');
    let totalObt = 0;
    let totalMax = 0;

    if (!isMultiMarks) {
      const obtStr = inputMarksObtained.value.trim();
      const totStr = inputMarksTotal.value.trim();

      if (!obtStr || !totStr) {
        errMarks.textContent = 'Please enter both obtained marks and total maximum marks.';
        errMarks.classList.remove('hidden');
        resMarksBox.classList.add('hidden');
        return;
      }

      totalObt = parseFloat(obtStr);
      totalMax = parseFloat(totStr);
    } else {
      const rows = document.querySelectorAll('.subject-row');
      rows.forEach((r) => {
        const obt = parseFloat(r.querySelector('.sub-obtained').value) || 0;
        const tot = parseFloat(r.querySelector('.sub-total').value) || 0;
        totalObt += obt;
        totalMax += tot;
      });
    }

    if (isNaN(totalObt) || isNaN(totalMax) || totalMax <= 0) {
      errMarks.textContent = 'Please enter valid numbers with total marks greater than 0.';
      errMarks.classList.remove('hidden');
      resMarksBox.classList.add('hidden');
      return;
    }

    const pct = Number(((totalObt / totalMax) * 100).toFixed(2));
    const grade = getGrade(pct);

    resMarksPct.textContent = `${pct}%`;
    resMarksGrade.textContent = grade;
    resMarksObtVal.textContent = totalObt.toString();
    resMarksTotVal.textContent = totalMax.toString();
    resMarksBox.classList.remove('hidden');
  }

  btnMarksCalc.addEventListener('click', executeMarksCalculation);
  btnMultiMarksCalc.addEventListener('click', executeMarksCalculation);

  btnMarksClear.addEventListener('click', () => {
    inputMarksObtained.value = '';
    inputMarksTotal.value = '';
    errMarks.classList.add('hidden');
    resMarksBox.classList.add('hidden');
  });

  btnMultiMarksClear.addEventListener('click', () => {
    subjectRowsContainer.innerHTML = `
      <div class="subject-row flex items-center gap-2">
        <input type="text" placeholder="Subject 1" class="sub-name w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="Subject 1" />
        <input type="number" placeholder="Obtained" class="sub-obtained w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="" />
        <input type="number" placeholder="Total" class="sub-total w-1/3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="100" />
      </div>
    `;
    subjectCount = 1;
    errMarks.classList.add('hidden');
    resMarksBox.classList.add('hidden');
  });


  // ==========================================
  // 3. CGPA TO PERCENTAGE CALCULATOR
  // ==========================================
  const inputCgpaVal = document.getElementById('input-cgpa-val');
  const selectCgpaMethod = document.getElementById('select-cgpa-method');
  const cgpaCustomFactorBox = document.getElementById('cgpa-custom-factor-box');
  const inputCgpaCustom = document.getElementById('input-cgpa-custom');
  const btnCgpaCalc = document.getElementById('btn-cgpa-calc');
  const btnCgpaClear = document.getElementById('btn-cgpa-clear');
  const errCgpa = document.getElementById('err-cgpa');
  const resCgpaBox = document.getElementById('res-cgpa-box');
  const resCgpaPct = document.getElementById('res-cgpa-pct');
  const resCgpaNote = document.getElementById('res-cgpa-note');

  selectCgpaMethod.addEventListener('change', () => {
    if (selectCgpaMethod.value === 'custom') {
      cgpaCustomFactorBox.classList.remove('hidden');
    } else {
      cgpaCustomFactorBox.classList.add('hidden');
    }
  });

  function executeCgpaCalculation() {
    const cgpaStr = inputCgpaVal.value.trim();
    if (!cgpaStr) {
      errCgpa.textContent = 'Please enter your CGPA value.';
      errCgpa.classList.remove('hidden');
      resCgpaBox.classList.add('hidden');
      return;
    }

    const cgpa = parseFloat(cgpaStr);
    if (isNaN(cgpa) || cgpa < 0 || cgpa > 10) {
      errCgpa.textContent = 'Please enter a valid CGPA between 0 and 10.';
      errCgpa.classList.remove('hidden');
      resCgpaBox.classList.add('hidden');
      return;
    }

    errCgpa.classList.add('hidden');

    const method = selectCgpaMethod.value;
    let pct = 0;
    let note = '';

    if (method === 'cbse') {
      pct = cgpa * 9.5;
      note = `${cgpa} × 9.5 = ${pct.toFixed(2)}% (CBSE 9.5 Factor)`;
    } else if (method === 'ten_point') {
      pct = cgpa * 10;
      note = `${cgpa} × 10 = ${pct.toFixed(2)}% (10-Point Scale Multiplier)`;
    } else if (method === 'aicte') {
      pct = Math.max(0, (cgpa - 0.75) * 10);
      note = `(${cgpa} - 0.75) × 10 = ${pct.toFixed(2)}% (AICTE Formula)`;
    } else if (method === 'custom') {
      const factor = parseFloat(inputCgpaCustom.value) || 9.5;
      pct = cgpa * factor;
      note = `${cgpa} × ${factor} = ${pct.toFixed(2)}% (Custom Multiplier)`;
    }

    resCgpaPct.textContent = `${pct.toFixed(2)}%`;
    resCgpaNote.textContent = note;
    resCgpaBox.classList.remove('hidden');
  }

  btnCgpaCalc.addEventListener('click', executeCgpaCalculation);

  btnCgpaClear.addEventListener('click', () => {
    inputCgpaVal.value = '';
    selectCgpaMethod.value = 'cbse';
    cgpaCustomFactorBox.classList.add('hidden');
    errCgpa.classList.add('hidden');
    resCgpaBox.classList.add('hidden');
  });


  // ==========================================
  // 4. ATTENDANCE CALCULATOR
  // ==========================================
  const inputAttAttended = document.getElementById('input-att-attended');
  const inputAttTotal = document.getElementById('input-att-total');
  const inputAttTarget = document.getElementById('input-att-target');
  const btnAttCalc = document.getElementById('btn-att-calc');
  const btnAttClear = document.getElementById('btn-att-clear');
  const errAtt = document.getElementById('err-att');
  const resAttBox = document.getElementById('res-att-box');
  const resAttPct = document.getElementById('res-att-pct');
  const resAttBadge = document.getElementById('res-att-badge');
  const resAttPlan = document.getElementById('res-att-plan');

  function executeAttendanceCalculation() {
    const attStr = inputAttAttended.value.trim();
    const totStr = inputAttTotal.value.trim();
    const tgtStr = inputAttTarget.value.trim();

    if (!attStr || !totStr) {
      errAtt.textContent = 'Please enter both attended classes and total classes.';
      errAtt.classList.remove('hidden');
      resAttBox.classList.add('hidden');
      return;
    }

    const attended = parseInt(attStr, 10);
    const total = parseInt(totStr, 10);
    const target = parseFloat(tgtStr) || 75;

    if (isNaN(attended) || isNaN(total) || total <= 0 || attended < 0 || attended > total) {
      errAtt.textContent = 'Please enter valid numbers with attended classes ≤ total classes.';
      errAtt.classList.remove('hidden');
      resAttBox.classList.add('hidden');
      return;
    }

    errAtt.classList.add('hidden');

    const curPct = Number(((attended / total) * 100).toFixed(2));
    resAttPct.textContent = `${curPct}%`;

    if (curPct >= target) {
      resAttBadge.textContent = `Target Met (≥ ${target}%)`;
      resAttBadge.className = 'rounded-full bg-emerald-100 px-2.5 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
      resAttPlan.textContent = `Great job! Your attendance satisfies the ${target}% requirement.`;
    } else {
      resAttBadge.textContent = `Below Target (< ${target}%)`;
      resAttBadge.className = 'rounded-full bg-amber-100 px-2.5 py-0.5 text-[10px] font-bold text-amber-800 dark:bg-amber-950 dark:text-amber-300';
      
      const num = target * total - 100 * attended;
      const den = 100 - target;
      const needed = Math.ceil(num / den);
      resAttPlan.textContent = `You must attend the next ${needed} consecutive classes without missing to reach ${target}%.`;
    }

    resAttBox.classList.remove('hidden');
  }

  btnAttCalc.addEventListener('click', executeAttendanceCalculation);

  btnAttClear.addEventListener('click', () => {
    inputAttAttended.value = '';
    inputAttTotal.value = '';
    inputAttTarget.value = '75';
    errAtt.classList.add('hidden');
    resAttBox.classList.add('hidden');
  });


  // ==========================================
  // 5. SALARY HIKE CALCULATOR
  // ==========================================
  const inputHikeCurrent = document.getElementById('input-hike-current');
  const inputHikeNew = document.getElementById('input-hike-new');
  const btnHikeCalc = document.getElementById('btn-hike-calc');
  const btnHikeClear = document.getElementById('btn-hike-clear');
  const errHike = document.getElementById('err-hike');
  const resHikeBox = document.getElementById('res-hike-box');
  const resHikePct = document.getElementById('res-hike-pct');
  const resHikeAmt = document.getElementById('res-hike-amt');
  const resHikeMonthly = document.getElementById('res-hike-monthly');

  function executeHikeCalculation() {
    const curStr = inputHikeCurrent.value.trim();
    const newStr = inputHikeNew.value.trim();

    if (!curStr || !newStr) {
      errHike.textContent = 'Please enter both current salary and new salary.';
      errHike.classList.remove('hidden');
      resHikeBox.classList.add('hidden');
      return;
    }

    const cur = parseFloat(curStr);
    const newVal = parseFloat(newStr);

    if (isNaN(cur) || isNaN(newVal) || cur <= 0) {
      errHike.textContent = 'Please enter valid salary amounts greater than 0.';
      errHike.classList.remove('hidden');
      resHikeBox.classList.add('hidden');
      return;
    }

    errHike.classList.add('hidden');

    const diff = newVal - cur;
    const pct = Number(((diff / cur) * 100).toFixed(2));
    const monthly = Number((diff / 12).toFixed(2));

    resHikePct.textContent = `${pct >= 0 ? '+' : ''}${pct}% Hike`;
    resHikeAmt.textContent = `Total Increase: ${diff.toLocaleString()}`;
    resHikeMonthly.textContent = `${monthly >= 0 ? '+' : ''}${monthly.toLocaleString()} / month`;
    resHikeBox.classList.remove('hidden');
  }

  btnHikeCalc.addEventListener('click', executeHikeCalculation);

  btnHikeClear.addEventListener('click', () => {
    inputHikeCurrent.value = '';
    inputHikeNew.value = '';
    errHike.classList.add('hidden');
    resHikeBox.classList.add('hidden');
  });


  // ==========================================
  // 6. PERCENTAGE INCREASE & DECREASE
  // ==========================================
  const inputIncOrig = document.getElementById('input-inc-orig');
  const inputIncNew = document.getElementById('input-inc-new');
  const btnIncCalc = document.getElementById('btn-inc-calc');
  const btnIncClear = document.getElementById('btn-inc-clear');
  const errInc = document.getElementById('err-inc');
  const resIncBox = document.getElementById('res-inc-box');
  const resIncPct = document.getElementById('res-inc-pct');
  const resIncDiff = document.getElementById('res-inc-diff');

  function executeIncCalculation() {
    const origStr = inputIncOrig.value.trim();
    const newStr = inputIncNew.value.trim();

    if (!origStr || !newStr) {
      errInc.textContent = 'Please enter both original and new values.';
      errInc.classList.remove('hidden');
      resIncBox.classList.add('hidden');
      return;
    }

    const orig = parseFloat(origStr);
    const newVal = parseFloat(newStr);

    if (isNaN(orig) || isNaN(newVal) || orig === 0) {
      errInc.textContent = 'Original value cannot be zero.';
      errInc.classList.remove('hidden');
      resIncBox.classList.add('hidden');
      return;
    }

    errInc.classList.add('hidden');

    const diff = newVal - orig;
    const pct = (diff / Math.abs(orig)) * 100;
    const isInc = diff >= 0;

    resIncPct.textContent = `${isInc ? '+' : ''}${pct.toFixed(2)}% ${isInc ? 'Increase' : 'Decrease'}`;
    resIncPct.className = isInc ? 'mt-1 text-2xl font-black text-emerald-600 dark:text-emerald-400' : 'mt-1 text-2xl font-black text-red-600 dark:text-red-400';
    resIncDiff.textContent = `Absolute difference: ${Math.abs(diff)}`;
    resIncBox.classList.remove('hidden');
  }

  btnIncCalc.addEventListener('click', executeIncCalculation);

  btnIncClear.addEventListener('click', () => {
    inputIncOrig.value = '';
    inputIncNew.value = '';
    errInc.classList.add('hidden');
    resIncBox.classList.add('hidden');
  });


  // ==========================================
  // 7. AVERAGE PERCENTAGE
  // ==========================================
  let isWeightedAvg = false;
  const tabAvgStd = document.getElementById('tab-avg-std');
  const tabAvgWeighted = document.getElementById('tab-avg-weighted');
  const avgStdContainer = document.getElementById('avg-std-container');
  const avgWeightedContainer = document.getElementById('avg-weighted-container');
  const avgStdInputs = document.getElementById('avg-std-inputs');
  const weightedRowsContainer = document.getElementById('weighted-rows-container');
  const btnAddAvgVal = document.getElementById('btn-add-avg-val');
  const btnAddWeightedRow = document.getElementById('btn-add-weighted-row');
  const btnAvgCalc = document.getElementById('btn-avg-calc');
  const btnAvgClear = document.getElementById('btn-avg-clear');
  const errAvg = document.getElementById('err-avg');
  const resAvgBox = document.getElementById('res-avg-box');
  const resAvgPct = document.getElementById('res-avg-pct');
  const resAvgNote = document.getElementById('res-avg-note');

  tabAvgStd.addEventListener('click', () => {
    isWeightedAvg = false;
    tabAvgStd.className = 'tab-avg active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
    tabAvgWeighted.className = 'tab-avg rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
    avgStdContainer.classList.remove('hidden');
    avgWeightedContainer.classList.add('hidden');
    resAvgBox.classList.add('hidden');
  });

  tabAvgWeighted.addEventListener('click', () => {
    isWeightedAvg = true;
    tabAvgWeighted.className = 'tab-avg active rounded-lg bg-blue-600 px-2.5 py-1 font-bold text-white shadow-xs cursor-pointer';
    tabAvgStd.className = 'tab-avg rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
    avgStdContainer.classList.add('hidden');
    avgWeightedContainer.classList.remove('hidden');
    resAvgBox.classList.add('hidden');
  });

  btnAddAvgVal.addEventListener('click', () => {
    const inp = document.createElement('input');
    inp.type = 'number';
    inp.step = 'any';
    inp.placeholder = 'Value (%)';
    inp.className = 'avg-input rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white';
    avgStdInputs.appendChild(inp);
  });

  btnAddWeightedRow.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'weighted-row flex items-center gap-2';
    row.innerHTML = `
      <input type="number" placeholder="Percentage (%)" class="wt-val w-1/2 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
      <input type="number" placeholder="Weight / Credits" class="wt-weight w-1/2 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
    `;
    weightedRowsContainer.appendChild(row);
  });

  function executeAvgCalculation() {
    errAvg.classList.add('hidden');

    if (!isWeightedAvg) {
      const inputs = document.querySelectorAll('.avg-input');
      const vals = [];
      inputs.forEach((inp) => {
        const v = parseFloat(inp.value);
        if (!isNaN(v)) vals.push(v);
      });

      if (vals.length === 0) {
        errAvg.textContent = 'Please enter at least one percentage value.';
        errAvg.classList.remove('hidden');
        resAvgBox.classList.add('hidden');
        return;
      }

      const sum = vals.reduce((a, b) => a + b, 0);
      const avg = sum / vals.length;

      resAvgPct.textContent = `${avg.toFixed(2)}%`;
      resAvgNote.textContent = `Sum: ${sum} ÷ ${vals.length} values`;
      resAvgBox.classList.remove('hidden');
    } else {
      const rows = document.querySelectorAll('.weighted-row');
      let totalWeightedSum = 0;
      let totalWeight = 0;

      rows.forEach((r) => {
        const v = parseFloat(r.querySelector('.wt-val').value);
        const w = parseFloat(r.querySelector('.wt-weight').value);
        if (!isNaN(v) && !isNaN(w) && w > 0) {
          totalWeightedSum += v * w;
          totalWeight += w;
        }
      });

      if (totalWeight === 0) {
        errAvg.textContent = 'Please enter valid percentage and positive weight pairs.';
        errAvg.classList.remove('hidden');
        resAvgBox.classList.add('hidden');
        return;
      }

      const wAvg = totalWeightedSum / totalWeight;
      resAvgPct.textContent = `${wAvg.toFixed(2)}%`;
      resAvgNote.textContent = `Weighted Sum: ${totalWeightedSum.toFixed(2)} ÷ Total Weight: ${totalWeight}`;
      resAvgBox.classList.remove('hidden');
    }
  }

  btnAvgCalc.addEventListener('click', executeAvgCalculation);

  btnAvgClear.addEventListener('click', () => {
    document.querySelectorAll('.avg-input').forEach((inp) => (inp.value = ''));
    document.querySelectorAll('.wt-val').forEach((inp) => (inp.value = ''));
    document.querySelectorAll('.wt-weight').forEach((inp) => (inp.value = ''));
    errAvg.classList.add('hidden');
    resAvgBox.classList.add('hidden');
  });


  // ==========================================
  // 8. WIN PERCENTAGE
  // ==========================================
  const inputWinWins = document.getElementById('input-win-wins');
  const inputWinLosses = document.getElementById('input-win-losses');
  const inputWinDraws = document.getElementById('input-win-draws');
  const btnWinCalc = document.getElementById('btn-win-calc');
  const btnWinClear = document.getElementById('btn-win-clear');
  const errWin = document.getElementById('err-win');
  const resWinBox = document.getElementById('res-win-box');
  const resWinPct = document.getElementById('res-win-pct');
  const resWinTotal = document.getElementById('res-win-total');
  const resWinLoss = document.getElementById('res-win-loss');
  const resWinDraw = document.getElementById('res-win-draw');

  function executeWinCalculation() {
    const w = parseFloat(inputWinWins.value) || 0;
    const l = parseFloat(inputWinLosses.value) || 0;
    const d = parseFloat(inputWinDraws.value) || 0;
    const total = w + l + d;

    if (total <= 0) {
      errWin.textContent = 'Please enter at least one match result (wins, losses, or draws).';
      errWin.classList.remove('hidden');
      resWinBox.classList.add('hidden');
      return;
    }

    errWin.classList.add('hidden');

    const effectiveWins = w + d * 0.5;
    const winPct = (effectiveWins / total) * 100;
    const lossPct = (l / total) * 100;
    const drawPct = (d / total) * 100;

    resWinPct.textContent = `${winPct.toFixed(2)}%`;
    resWinTotal.textContent = `${total} Total Games (${w}W - ${l}L - ${d}D)`;
    resWinLoss.textContent = `Loss Rate: ${lossPct.toFixed(2)}%`;
    resWinDraw.textContent = `Draw Rate: ${drawPct.toFixed(2)}%`;
    resWinBox.classList.remove('hidden');
  }

  btnWinCalc.addEventListener('click', executeWinCalculation);

  btnWinClear.addEventListener('click', () => {
    inputWinWins.value = '';
    inputWinLosses.value = '';
    inputWinDraws.value = '0';
    errWin.classList.add('hidden');
    resWinBox.classList.add('hidden');
  });


  // ==========================================
  // 9. WEIGHT LOSS / GAIN
  // ==========================================
  const inputWtStart = document.getElementById('input-wt-start');
  const inputWtCurrent = document.getElementById('input-wt-current');
  const btnWtLossCalc = document.getElementById('btn-wt-loss-calc');
  const btnWtLossClear = document.getElementById('btn-wt-loss-clear');
  const errWtLoss = document.getElementById('err-wt-loss');
  const resWtLossBox = document.getElementById('res-wt-loss-box');
  const resWtLossPct = document.getElementById('res-wt-loss-pct');
  const resWtLossAmt = document.getElementById('res-wt-loss-amt');

  function executeWtLossCalculation() {
    const startStr = inputWtStart.value.trim();
    const curStr = inputWtCurrent.value.trim();

    if (!startStr || !curStr) {
      errWtLoss.textContent = 'Please enter starting and current weight.';
      errWtLoss.classList.remove('hidden');
      resWtLossBox.classList.add('hidden');
      return;
    }

    const start = parseFloat(startStr);
    const cur = parseFloat(curStr);

    if (isNaN(start) || isNaN(cur) || start <= 0) {
      errWtLoss.textContent = 'Starting weight must be greater than 0.';
      errWtLoss.classList.remove('hidden');
      resWtLossBox.classList.add('hidden');
      return;
    }

    errWtLoss.classList.add('hidden');

    const diff = cur - start;
    const pct = (Math.abs(diff) / start) * 100;
    const isLoss = diff <= 0;

    if (isLoss) {
      resWtLossPct.textContent = `${pct.toFixed(2)}% Weight Lost`;
      resWtLossPct.className = 'mt-1 text-2xl font-black text-emerald-600 dark:text-emerald-400';
      resWtLossAmt.textContent = `${Math.abs(diff).toFixed(2)} units lost from baseline`;
    } else {
      resWtLossPct.textContent = `+${pct.toFixed(2)}% Weight Gained`;
      resWtLossPct.className = 'mt-1 text-2xl font-black text-amber-600 dark:text-amber-400';
      resWtLossAmt.textContent = `${Math.abs(diff).toFixed(2)} units gained`;
    }

    resWtLossBox.classList.remove('hidden');
  }

  btnWtLossCalc.addEventListener('click', executeWtLossCalculation);

  btnWtLossClear.addEventListener('click', () => {
    inputWtStart.value = '';
    inputWtCurrent.value = '';
    errWtLoss.classList.add('hidden');
    resWtLossBox.classList.add('hidden');
  });


  // ==========================================
  // 10. BODY FAT % (U.S. Navy Method)
  // ==========================================
  const bfGenderM = document.getElementById('bf-gender-m');
  const bfGenderF = document.getElementById('bf-gender-f');
  const bfHipCol = document.getElementById('bf-hip-col');
  const inputBfHeight = document.getElementById('input-bf-height');
  const inputBfWeight = document.getElementById('input-bf-weight');
  const inputBfWaist = document.getElementById('input-bf-waist');
  const inputBfNeck = document.getElementById('input-bf-neck');
  const inputBfHip = document.getElementById('input-bf-hip');
  const btnBfCalc = document.getElementById('btn-bf-calc');
  const btnBfClear = document.getElementById('btn-bf-clear');
  const errBf = document.getElementById('err-bf');
  const resBfBox = document.getElementById('res-bf-box');
  const resBfPct = document.getElementById('res-bf-pct');
  const resBfCat = document.getElementById('res-bf-cat');
  const resBfFat = document.getElementById('res-bf-fat');
  const resBfLean = document.getElementById('res-bf-lean');

  bfGenderM.addEventListener('change', () => {
    bfHipCol.classList.add('hidden');
  });

  bfGenderF.addEventListener('change', () => {
    bfHipCol.classList.remove('hidden');
  });

  function executeBfCalculation() {
    const isMale = bfGenderM.checked;
    const h = parseFloat(inputBfHeight.value);
    const wt = parseFloat(inputBfWeight.value);
    const waist = parseFloat(inputBfWaist.value);
    const neck = parseFloat(inputBfNeck.value);
    const hip = parseFloat(inputBfHip.value) || 0;

    if (isNaN(h) || isNaN(wt) || isNaN(waist) || isNaN(neck) || h <= 0 || wt <= 0) {
      errBf.textContent = 'Please enter valid body measurements in centimeters and kg.';
      errBf.classList.remove('hidden');
      resBfBox.classList.add('hidden');
      return;
    }

    errBf.classList.add('hidden');

    let bf = 0;
    if (isMale) {
      const diff = waist - neck;
      if (diff <= 0) {
        errBf.textContent = 'Waist measurement must be greater than neck measurement.';
        errBf.classList.remove('hidden');
        return;
      }
      bf = 495 / (1.0324 - 0.19077 * Math.log10(diff) + 0.15456 * Math.log10(h)) - 450;
    } else {
      const sum = waist + hip - neck;
      if (sum <= 0) {
        errBf.textContent = 'Sum of waist and hip must be greater than neck measurement.';
        errBf.classList.remove('hidden');
        return;
      }
      bf = 495 / (1.29579 - 0.35004 * Math.log10(sum) + 0.22100 * Math.log10(h)) - 450;
    }

    bf = Math.max(3, Math.min(65, Number(bf.toFixed(1))));
    const fatMass = Number(((bf / 100) * wt).toFixed(1));
    const leanMass = Number((wt - fatMass).toFixed(1));

    let cat = 'Average';
    if (isMale) {
      if (bf < 6) cat = 'Essential Fat';
      else if (bf < 14) cat = 'Athletes';
      else if (bf < 18) cat = 'Fitness';
      else if (bf < 25) cat = 'Average';
      else cat = 'Obese';
    } else {
      if (bf < 14) cat = 'Essential Fat';
      else if (bf < 21) cat = 'Athletes';
      else if (bf < 25) cat = 'Fitness';
      else if (bf < 32) cat = 'Average';
      else cat = 'Obese';
    }

    resBfPct.textContent = `${bf}%`;
    resBfCat.textContent = cat;
    resBfFat.textContent = `${fatMass} kg`;
    resBfLean.textContent = `${leanMass} kg`;
    resBfBox.classList.remove('hidden');
  }

  btnBfCalc.addEventListener('click', executeBfCalculation);

  btnBfClear.addEventListener('click', () => {
    inputBfHeight.value = '175';
    inputBfWeight.value = '75';
    inputBfWaist.value = '85';
    inputBfNeck.value = '38';
    inputBfHip.value = '95';
    errBf.classList.add('hidden');
    resBfBox.classList.add('hidden');
  });


  // ==========================================
  // 11. LOVE PERCENTAGE CALCULATOR (Entertainment)
  // ==========================================
  const inputLoveN1 = document.getElementById('input-love-n1');
  const inputLoveN2 = document.getElementById('input-love-n2');
  const btnLoveCalc = document.getElementById('btn-love-calc');
  const btnLoveClear = document.getElementById('btn-love-clear');
  const errLove = document.getElementById('err-love');
  const resLoveBox = document.getElementById('res-love-box');
  const resLovePct = document.getElementById('res-love-pct');
  const resLoveMsg = document.getElementById('res-love-msg');

  function executeLoveCalculation() {
    const n1 = inputLoveN1.value.trim();
    const n2 = inputLoveN2.value.trim();

    if (!n1 || !n2) {
      errLove.textContent = 'Please enter both names to test compatibility.';
      errLove.classList.remove('hidden');
      resLoveBox.classList.add('hidden');
      return;
    }

    errLove.classList.add('hidden');

    const sortedPair = [n1.toLowerCase(), n2.toLowerCase()].sort().join('&');
    let hash = 0;
    for (let i = 0; i < sortedPair.length; i++) {
      hash = (hash << 5) - hash + sortedPair.charCodeAt(i);
      hash |= 0;
    }

    const pct = 50 + (Math.abs(hash) % 50);
    let msg = 'Great Compatibility! ❤️ You share wonderful chemistry and mutual understanding.';
    if (pct >= 90) msg = 'Soulmate Match! 🌟 Incredible celestial bond and deep understanding.';
    else if (pct >= 80) msg = 'High Chemistry! ❤️ Strong connection filled with warmth and laughter.';
    else if (pct >= 70) msg = 'Sweet Spark! ✨ Balanced connection with great potential.';
    else if (pct >= 60) msg = 'Growing Bond! 🌱 With patience and listening, your connection blooms.';
    else msg = 'Friendly Connection! 🤝 Understanding each other makes every relationship stronger.';

    resLovePct.textContent = `${pct}% 💕`;
    resLoveMsg.textContent = msg;
    resLoveBox.classList.remove('hidden');
  }

  btnLoveCalc.addEventListener('click', executeLoveCalculation);

  btnLoveClear.addEventListener('click', () => {
    inputLoveN1.value = '';
    inputLoveN2.value = '';
    errLove.classList.add('hidden');
    resLoveBox.classList.add('hidden');
  });

</script>
