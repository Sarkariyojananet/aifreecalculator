---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Tip Calculator – Restaurant Bill Split & Gratuity Calculator"
  description="Calculate the tip amount, total bill per person, and split the check evenly for restaurants, hotels, and delivery services. Supports 10%, 15%, 18%, 20%, 25% tip rates."
  category="General"
  calculatorName="Tip Calculator"
  slug="tip-calculator"
  keywords={[
    'tip calculator',
    'tip calculator restaurant',
    'how much to tip calculator',
    'split bill calculator',
    'restaurant tip calculator',
    'bill split calculator',
    'gratuity tip calculator',
    'tip per person calculator',
    '15 percent tip calculator',
    '20 percent tip calculator'
  ]}
>
  <div class="space-y-6">

    <!-- QUICK TIP BUTTONS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1">⚡ Quick Tip %:</span>
        <button type="button" class="btn-tip-pct rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tip="10">10% (Poor)</button>
        <button type="button" class="btn-tip-pct rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tip="15">15% (Okay)</button>
        <button type="button" class="btn-tip-pct rounded-lg border border-amber-400 bg-amber-50 px-3 py-1.5 font-bold text-amber-700 dark:border-amber-600 dark:bg-amber-950/30 dark:text-amber-300 cursor-pointer" data-tip="18">18% ⭐ Standard</button>
        <button type="button" class="btn-tip-pct rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tip="20">20% (Good)</button>
        <button type="button" class="btn-tip-pct rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tip="25">25% (Excellent)</button>
        <button type="button" class="btn-tip-pct rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-bold text-slate-700 hover:border-amber-500 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tip="30">30% (Exceptional)</button>
      </div>
    </div>

    <!-- MAIN PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-amber-50/20 to-orange-50/20 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-amber-950/10 sm:p-7">
      <div class="border-b border-slate-200/80 pb-3 mb-5 dark:border-slate-800">
        <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2"><span>🍽️</span> Restaurant Tip & Bill Splitter</h2>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">Enter your bill amount, select tip percentage, and number of people to split the check evenly.</p>
      </div>

      <form id="form-tip" class="space-y-4" novalidate onsubmit="return false;">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="tip-bill" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Bill Amount ($)</label>
            <div class="relative mt-1.5">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">$</span>
              <input type="number" id="tip-bill" value="75.00" step="0.01" min="0" class="w-full rounded-xl border border-slate-300 bg-white pl-7 pr-3 py-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>
          <div>
            <label for="tip-pct" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Tip Percentage (%)</label>
            <input type="number" id="tip-pct" value="18" step="1" min="0" max="100" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
          <div>
            <label for="tip-people" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Number of People</label>
            <div class="flex items-center gap-2 mt-1.5">
              <button type="button" id="btn-less-people" class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-300 bg-white text-lg font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">−</button>
              <input type="number" id="tip-people" value="2" min="1" max="50" class="flex-1 rounded-xl border border-slate-300 bg-white p-2.5 text-center text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
              <button type="button" id="btn-more-people" class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-300 bg-white text-lg font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">+</button>
            </div>
          </div>
          <div>
            <label for="tip-currency" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Currency</label>
            <select id="tip-currency" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer">
              <option value="$">$ USD (US Dollar)</option>
              <option value="£">£ GBP (British Pound)</option>
              <option value="€">€ EUR (Euro)</option>
              <option value="₹">₹ INR (Indian Rupee)</option>
              <option value="CA$">CA$ CAD (Canadian Dollar)</option>
              <option value="A$">A$ AUD (Australian Dollar)</option>
            </select>
          </div>
        </div>

        <!-- Round Up Option -->
        <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800">
          <input type="checkbox" id="tip-round" class="h-4 w-4 rounded border-slate-300 text-amber-600 cursor-pointer" />
          <label for="tip-round" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">Round up total to nearest dollar (common tip etiquette in USA)</label>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <button type="submit" id="btn-tip-calc" class="flex-1 rounded-xl bg-amber-500 hover:bg-amber-600 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-amber-500/25 transition active:scale-[0.98] cursor-pointer">Calculate Tip →</button>
          <button type="button" id="btn-tip-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Clear (✕)</button>
        </div>
      </form>

      <!-- RESULTS -->
      <div id="tip-results" class="hidden mt-6 space-y-5">
        <!-- Hero Card -->
        <div class="overflow-hidden rounded-3xl border border-amber-200 bg-linear-to-br from-white via-amber-50/40 to-orange-100/50 p-5 shadow-lg shadow-amber-500/5 dark:border-amber-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-amber-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-amber-200/80 pb-4 dark:border-slate-800">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300">💵 Per Person (Total)</span>
              <div id="tip-res-per-person" class="mt-1 text-4xl sm:text-5xl font-black text-amber-600 dark:text-amber-400">$44.25</div>
            </div>
            <div class="sm:text-right">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Bill (incl. tip):</span>
              <div id="tip-res-total" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">$88.50</div>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="rounded-xl border border-amber-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Bill Amount</div>
              <div id="tip-res-bill" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">$75.00</div>
            </div>
            <div class="rounded-xl border border-amber-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Tip Amount</div>
              <div id="tip-res-tip" class="mt-1 text-sm font-bold text-amber-600 dark:text-amber-400">$13.50</div>
            </div>
            <div class="rounded-xl border border-amber-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Tip per Person</div>
              <div id="tip-res-tip-per" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">$6.75</div>
            </div>
            <div class="rounded-xl border border-amber-200/60 bg-white/80 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <div class="text-slate-500 font-semibold">Bill per Person</div>
              <div id="tip-res-bill-per" class="mt-1 text-sm font-bold text-slate-900 dark:text-white">$37.50</div>
            </div>
          </div>
        </div>

        <!-- Tip Guide -->
        <div class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-1.5"><span>📊</span> Tip Comparison — Same Bill, Different Rates</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold">
                <tr><th class="p-2.5">Tip %</th><th class="p-2.5 text-right">Tip Amt</th><th class="p-2.5 text-right">Total</th><th class="p-2.5 text-right">Per Person</th><th class="p-2.5 text-center">Rating</th></tr>
              </thead>
              <tbody id="tip-comparison-tbody" class="divide-y divide-slate-100 dark:divide-slate-800 font-mono"></tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- SEO CONTENT -->
  <Fragment slot="content">
    <section class="tip-content">
      <h2>Tip Calculator – How Much Should You Tip?</h2>
      <p>Our <strong>Tip Calculator</strong> makes it easy to calculate the exact tip amount, total bill, and per-person share when splitting the check at a restaurant, bar, hotel, or for delivery services. Whether you're in the USA, UK, Canada, or Australia, our calculator supports multiple currencies and helps you practice proper tipping etiquette.</p>

      <h2>Standard Tipping Rates by Service Type</h2>
      <ul>
        <li><strong>Restaurants (USA):</strong> 15%–20% for standard service; 20%–25% for excellent service; 10% for poor service</li>
        <li><strong>Bartenders:</strong> $1–$2 per drink, or 15%–20% of the bar tab</li>
        <li><strong>Food Delivery:</strong> 10%–20% of the order total (minimum $2–$5)</li>
        <li><strong>Pizza Delivery:</strong> $3–$5 for local delivery; more for large orders</li>
        <li><strong>Hotel Housekeeping:</strong> $2–$5 per night</li>
        <li><strong>Hotel Bellhop:</strong> $1–$2 per bag</li>
        <li><strong>Taxi / Uber / Lyft:</strong> 15%–20% of fare</li>
        <li><strong>Hair Salon:</strong> 15%–20% of total service cost</li>
        <li><strong>Spa Services:</strong> 15%–20% of service cost</li>
        <li><strong>Valet Parking:</strong> $2–$5 when your car is returned</li>
      </ul>

      <h2>Tipping in India</h2>
      <p>Tipping is not mandatory in India but is appreciated. Typical amounts:</p>
      <ul>
        <li><strong>Restaurants:</strong> 5%–10% of the bill (service charge of 5%–10% is often already included)</li>
        <li><strong>Auto/Taxi:</strong> Round up to nearest ₹10–₹20, or tip 10%</li>
        <li><strong>Food Delivery (Swiggy/Zomato):</strong> ₹20–₹50 per order</li>
        <li><strong>Hotel Staff:</strong> ₹50–₹100 per service</li>
      </ul>

      <h2>How to Split a Bill Evenly</h2>
      <p>Splitting the bill evenly divides the <strong>total bill including tip</strong> by the number of people. Our calculator does this automatically:</p>
      <div class="my-4 rounded-2xl border border-slate-200 bg-slate-100/80 p-4 font-mono text-sm dark:border-slate-800 dark:bg-slate-900">
        <div>Tip Amount = Bill × (Tip % / 100)</div>
        <div class="mt-1">Total = Bill + Tip Amount</div>
        <div class="mt-1">Per Person = Total / Number of People</div>
      </div>

      <h2>Should You Tip Before or After Tax?</h2>
      <p>This is a common debate! Technically, tipping on the <strong>pre-tax amount</strong> is correct, since the tax isn't part of the service provided. However, in practice, most Americans tip on the post-tax amount since it's simpler. The difference is usually small — on a $75 bill with 8% tax ($6), tipping 20% on pre-tax ($75) vs post-tax ($81) is only a $1.20 difference.</p>

      <h2>How to Calculate a 15%, 18%, 20% Tip Mentally</h2>
      <ul>
        <li><strong>10% Tip:</strong> Move the decimal one place left. $75 → $7.50</li>
        <li><strong>15% Tip:</strong> Find 10%, then add half. $75 → $7.50 + $3.75 = $11.25</li>
        <li><strong>20% Tip:</strong> Find 10%, then double it. $75 → $7.50 × 2 = $15.00</li>
        <li><strong>18% Tip:</strong> Find 20% and subtract 10% of that. $75 → $15 − $1.50 = $13.50</li>
        <li><strong>25% Tip:</strong> Find 10%, then add two-and-a-half times. $75 → $7.50 × 2.5 = $18.75</li>
      </ul>

      <h2>Tipping in Different Countries</h2>
      <ul>
        <li><strong>USA & Canada:</strong> Expected 15%–20%; seen as part of server's income</li>
        <li><strong>UK:</strong> 10%–15% at sit-down restaurants; check if "service charge" is already included</li>
        <li><strong>Australia:</strong> Not mandatory, but 10% appreciated for good service</li>
        <li><strong>Japan:</strong> Tipping is considered rude — do not tip!</li>
        <li><strong>France/Italy:</strong> Leave small change or round up; formal tipping uncommon</li>
        <li><strong>India:</strong> Not mandatory; 5%–10% appreciated, especially if no service charge</li>
      </ul>
    </section>
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <div class="space-y-4 text-xs sm:text-sm">
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800" open>
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">1. How much should I tip at a restaurant in the USA?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Standard restaurant tipping in the USA is 15%–20% for adequate service, 20%–25% for excellent service. In major cities like New York, 20% has become the standard baseline. Never tip less than 10% unless the service was truly terrible.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">2. Should I tip on the pre-tax or post-tax amount?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Technically, tipping on the pre-tax amount is more correct. However, in practice, most Americans tip on the post-tax amount for simplicity. The difference is usually small — about $1–$2 on a typical restaurant bill.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">3. How do you calculate a 20% tip quickly in your head?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Move the decimal left by one place to get 10%, then double it for 20%. Example: $65 bill → $6.50 (10%) → $13.00 (20%). For 15%, find 10% and add half: $6.50 + $3.25 = $9.75.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">4. Is tipping mandatory in India?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Tipping is not mandatory in India, but it is appreciated. Many restaurants include a 5%–10% service charge in the bill. If no service charge is included, 5%–10% tip is appropriate. For food delivery (Swiggy, Zomato), ₹20–₹50 per order is considerate.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">5. Do Uber drivers expect tips?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">In the USA, tipping Uber and Lyft drivers is appreciated but not mandatory. The standard is 10%–20%. Consider tipping more if the driver helped with heavy luggage, kept the car extra clean, or handled a long or difficult trip graciously.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">6. What does "round up to the nearest dollar" mean for tips?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Rounding up the total means if your total comes to $47.63, you pay $48.00 — making it easier to handle cash and giving the server a small extra tip. Our calculator has an optional "round up" checkbox for this.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">7. How do you split a restaurant bill with different orders?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">The simplest method is to split the total bill (including tip) evenly among all diners. Alternatively, each person calculates their portion plus tip. Our calculator handles even splitting automatically — just enter the total bill and number of people.</p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<style>
  .tip-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.5rem; font-weight: 800; color: #0f172a; }
  .tip-content h2:first-child { margin-top: 0; }
  .tip-content p { margin: 0 0 1rem; line-height: 1.75; color: #475569; }
  .tip-content ul { margin: 0.75rem 0 1.5rem; padding-left: 1.5rem; list-style: disc; }
  .tip-content li + li { margin-top: 0.5rem; }
  :global(.dark) .tip-content h2 { color: #f8fafc; }
  :global(.dark) .tip-content p, :global(.dark) .tip-content li { color: #cbd5e1; }
</style>

<script is:inline>
  const tipResults = document.getElementById('tip-results');

  document.querySelectorAll('.btn-tip-pct').forEach(btn => {
    btn.addEventListener('click', () => { document.getElementById('tip-pct').value = btn.dataset.tip; });
  });

  document.getElementById('btn-less-people')?.addEventListener('click', () => {
    const el = document.getElementById('tip-people');
    el.value = Math.max(1, parseInt(el.value) - 1);
  });
  document.getElementById('btn-more-people')?.addEventListener('click', () => {
    const el = document.getElementById('tip-people');
    el.value = Math.min(50, parseInt(el.value) + 1);
  });

  function fmt(n, sym) { return sym + n.toFixed(2); }

  document.getElementById('form-tip')?.addEventListener('submit', () => {
    const bill = parseFloat(document.getElementById('tip-bill').value);
    const pct = parseFloat(document.getElementById('tip-pct').value);
    const people = parseInt(document.getElementById('tip-people').value);
    const currency = document.getElementById('tip-currency').value;
    const roundUp = document.getElementById('tip-round').checked;

    let tip = bill * pct / 100;
    let total = bill + tip;
    if (roundUp) total = Math.ceil(total);
    const perPerson = total / people;
    const tipPerPerson = tip / people;
    const billPerPerson = bill / people;

    document.getElementById('tip-res-per-person').textContent = fmt(perPerson, currency);
    document.getElementById('tip-res-total').textContent = fmt(total, currency);
    document.getElementById('tip-res-bill').textContent = fmt(bill, currency);
    document.getElementById('tip-res-tip').textContent = fmt(tip, currency);
    document.getElementById('tip-res-tip-per').textContent = fmt(tipPerPerson, currency);
    document.getElementById('tip-res-bill-per').textContent = fmt(billPerPerson, currency);

    const pcts = [10, 15, 18, 20, 25];
    const tbody = document.getElementById('tip-comparison-tbody');
    tbody.innerHTML = '';
    const ratings = { 10: '😐 Poor', 15: '👍 Okay', 18: '⭐ Standard', 20: '🌟 Good', 25: '🏆 Excellent' };
    pcts.forEach(p => {
      const t = bill * p / 100;
      const tot = (bill + t) / people;
      const isCurrent = p == pct;
      tbody.innerHTML += `<tr class="${isCurrent ? 'bg-amber-50 dark:bg-amber-950/20 font-bold' : ''}">
        <td class="p-2.5">${p}%</td>
        <td class="p-2.5 text-right">${fmt(t, currency)}</td>
        <td class="p-2.5 text-right">${fmt(bill + t, currency)}</td>
        <td class="p-2.5 text-right">${fmt(tot, currency)}</td>
        <td class="p-2.5 text-center">${ratings[p] || ''} ${isCurrent ? '← You' : ''}</td>
      </tr>`;
    });

    tipResults.classList.remove('hidden');
    tipResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  document.getElementById('btn-tip-clear')?.addEventListener('click', () => {
    document.getElementById('tip-bill').value = '75.00';
    document.getElementById('tip-pct').value = '18';
    document.getElementById('tip-people').value = '2';
    tipResults?.classList.add('hidden');
  });
</script>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
