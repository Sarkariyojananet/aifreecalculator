---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { getUnitConverterContent } from '../../data/content/unit-converter';
import { extractLocaleFromPath } from '../../i18n/utils';
import { isValidLocale, type Locale } from '../../i18n/config';

const detected = extractLocaleFromPath(Astro.url.pathname);
const rawLang = (Astro.params.lang as string) || (Astro.locals as any)?.locale || detected.lang || 'en';
const lang: Locale = isValidLocale(rawLang) ? rawLang : 'en';

const content = getUnitConverterContent(lang);
---

<CalculatorLayout
  title={content.meta.title}
  description={content.meta.description}
  category="General"
  calculatorName={content.meta.h1}
  slug="unit-converter"
  keywords={content.meta.keywords}
  lang={lang}
  useSlotContent={true}
>
  <div class="space-y-6">

    <!-- CATEGORY TABS (16 Categories) -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin" id="category-tabs-container">
        {content.categories.map((cat, idx) => (
          <button
            type="button"
            class={`btn-unit-cat shrink-0 rounded-lg px-3.5 py-1.5 font-semibold transition cursor-pointer ${
              idx === 0
                ? 'active bg-blue-700 text-white font-bold shadow-xs'
                : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200'
            }`}
            data-cat={cat.id}
          >
            {cat.id === 'length' && '📏 '}
            {cat.id === 'area' && '🗺️ '}
            {cat.id === 'volume' && '🧪 '}
            {cat.id === 'mass' && '⚖️ '}
            {cat.id === 'temperature' && '🌡️ '}
            {cat.id === 'time' && '⏱️ '}
            {cat.id === 'speed' && '🚀 '}
            {cat.id === 'pressure' && '🌪️ '}
            {cat.id === 'energy' && '⚡ '}
            {cat.id === 'power' && '💡 '}
            {cat.id === 'data' && '💾 '}
            {cat.id === 'data_rate' && '🌐 '}
            {cat.id === 'frequency' && '📡 '}
            {cat.id === 'angle' && '📐 '}
            {cat.id === 'fuel' && '⛽ '}
            {cat.id === 'cooking' && '🍳 '}
            <span>{cat.name}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- PRESET SHORTCUTS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-700 dark:text-slate-300 mr-1">{content.ui.quickConversionsTitle}</span>
        {content.presets.map((preset) => (
          <button
            type="button"
            class="btn-preset-conv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition"
            data-cat={preset.cat}
            data-from={preset.from}
            data-to={preset.to}
            data-val={preset.val}
          >
            {preset.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Indian Land Area Converter Banner -->
    <a
      href={lang === 'en' ? '/general/land-area-converter/' : `/${lang}/general/land-area-converter/`}
      class="flex items-center justify-between rounded-2xl border border-emerald-200 bg-emerald-50/80 p-3.5 px-4 text-xs font-semibold text-emerald-900 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 transition hover:bg-emerald-100 dark:hover:bg-emerald-900/60"
    >
      <span class="flex items-center gap-2">
        <span>🗺️</span>
        <span>{content.ui.indianLandBannerText}</span>
      </span>
      <span class="rounded-lg bg-emerald-600 text-white px-3 py-1 text-[11px] font-bold shrink-0 shadow-2xs">
        {content.ui.indianLandBannerBtn}
      </span>
    </a>

    <!-- MAIN CONVERTER PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-blue-50/20 to-indigo-50/20 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/10 sm:p-7">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">

        <!-- CONVERTER INPUTS (7 cols) -->
        <div class="space-y-4 lg:col-span-7">
          <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
            <h2 id="cat-title" class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>📏</span> <span id="cat-title-text">{content.categories[0].name}</span>
            </h2>
            <p id="cat-desc" class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              {content.categories[0].desc}
            </p>
          </div>

          <!-- FROM CARD -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 shadow-2xs">
            <div class="flex items-center justify-between mb-2">
              <label for="unit-from-val" class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                {content.ui.fromLabel}
              </label>
              <select
                id="unit-from-select"
                aria-label={content.ui.fromLabel}
                class="rounded-lg border border-slate-300 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer focus:ring-2 focus:ring-blue-500 focus:outline-hidden"
              ></select>
            </div>
            <input
              type="number"
              id="unit-from-val"
              value=""
              placeholder={content.ui.enterValuePlaceholder}
              step="any"
              class="w-full text-2xl font-black text-slate-900 bg-transparent border-0 focus:ring-0 p-0 placeholder:text-slate-400 placeholder:text-lg placeholder:font-normal dark:text-white"
            />
          </div>

          <!-- SWAP BUTTON -->
          <div class="flex justify-center -my-2 relative z-10">
            <button
              type="button"
              id="btn-swap-units"
              class="flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold text-blue-700 shadow-md hover:bg-blue-50 dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 dark:hover:bg-slate-700 cursor-pointer transition transform hover:scale-105 active:scale-95"
            >
              <span class="text-sm font-black">⇅</span> {content.ui.swapButton}
            </button>
          </div>

          <!-- TO CARD -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 shadow-2xs">
            <div class="flex items-center justify-between mb-2">
              <label for="unit-to-val" class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                {content.ui.toLabel}
              </label>
              <select
                id="unit-to-select"
                aria-label={content.ui.toLabel}
                class="rounded-lg border border-slate-300 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer focus:ring-2 focus:ring-blue-500 focus:outline-hidden"
              ></select>
            </div>
            <input
              type="text"
              id="unit-to-val"
              readonly
              value=""
              placeholder={content.ui.resultPlaceholder}
              class="w-full text-2xl font-black text-blue-700 bg-transparent border-0 focus:ring-0 p-0 placeholder:text-slate-400 placeholder:text-lg placeholder:font-normal dark:text-blue-400 select-all"
            />
          </div>

          <!-- FORMULA HELPER -->
          <div class="rounded-xl bg-blue-50 p-3 text-xs text-blue-900 dark:bg-blue-950/40 dark:text-blue-200 border border-blue-100 dark:border-blue-900/50 flex items-center justify-between">
            <span class="font-semibold flex items-center gap-1.5 truncate mr-2">
              <span>{content.ui.formulaLabel}:</span>
              <code id="unit-formula" class="font-mono font-bold truncate">—</code>
            </span>
            <button
              type="button"
              id="btn-copy-result"
              class="text-[11px] font-bold text-blue-700 dark:text-blue-300 underline hover:text-blue-900 dark:hover:text-white cursor-pointer shrink-0 transition"
            >
              {content.ui.copyButton}
            </button>
          </div>
        </div>

        <!-- HERO RESULT & STATS (5 cols) -->
        <div class="space-y-4 lg:col-span-5">
          <!-- Main Highlight Result Box -->
          <div class="rounded-3xl bg-linear-to-br from-blue-700 via-indigo-700 to-slate-900 p-6 text-white shadow-xl flex flex-col justify-between min-h-55">
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-blue-200">
                {content.ui.convertedValueHeader}
              </div>
              <div id="hero-result-display" class="mt-2 text-2xl sm:text-3xl font-black tracking-tight break-all text-white">
                —
              </div>
              <div id="hero-sub-display" class="mt-2 text-xs text-blue-100/90 leading-relaxed">
                {content.ui.emptyHeroSub}
              </div>
            </div>

            <div class="mt-5 grid grid-cols-2 gap-2.5 border-t border-white/15 pt-4 text-xs">
              <div>
                <div class="text-blue-200 font-medium">{content.ui.precisionLabel}</div>
                <div class="font-bold text-white">{content.ui.precisionValue}</div>
              </div>
              <div>
                <div class="text-blue-200 font-medium">{content.ui.standardUnitLabel}</div>
                <div id="hero-base-unit" class="font-bold text-white truncate">Meter (m)</div>
              </div>
            </div>
          </div>

          <!-- ALL OTHER CONVERSIONS TABLE -->
          <div class="rounded-3xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 shadow-2xs">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2.5 flex items-center justify-between">
              <span>{content.ui.equivalentHeader}</span>
            </h3>
            <div class="max-h-56 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800 text-xs pr-1 scrollbar-thin" id="all-units-table">
              <!-- Dynamically populated via client-side engine -->
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- CONTENT SECTION (SEO 1000+ Words with Strict Content Parity) -->
  <Fragment slot="content">
    <article class="prose prose-slate max-w-none dark:prose-invert unit-content">
      <h2>{content.article.h2Overview}</h2>
      <p>{content.article.pOverview1}</p>
      <p>{content.article.pOverview2}</p>

      <h2>{content.article.categoriesHeader}</h2>
      {content.article.categoriesList.map((cat) => (
        <div class="my-6">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{cat.title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 mb-3">{cat.description}</p>
          <ul class="space-y-1.5 my-2 list-disc pl-5 text-sm text-slate-600 dark:text-slate-300">
            {cat.bulletPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
          {cat.ruleOfThumb && (
            <div class="my-3 rounded-xl border border-blue-200 bg-blue-50/60 p-3 text-xs text-blue-900 dark:border-blue-900/50 dark:bg-blue-950/30 dark:text-blue-200 font-medium">
              💡 {cat.ruleOfThumb}
            </div>
          )}
        </div>
      ))}

      <h2>{content.article.comparisonHeader}</h2>
      <p>{content.article.comparisonText}</p>
      <ul class="space-y-2 my-3 list-disc pl-5 text-sm text-slate-600 dark:text-slate-300">
        {content.article.comparisonPoints.map((pt) => (
          <li>{pt}</li>
        ))}
      </ul>

      <h2>{content.article.formulasHeader}</h2>
      <p>{content.article.formulasIntro}</p>
      
      <div class="my-6 overflow-x-auto">
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-3">{content.article.benchmarksTitle}</h3>
        <table class="w-full text-xs text-left border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden">
          <thead class="bg-slate-100 dark:bg-slate-800 font-bold text-slate-800 dark:text-slate-200">
            <tr>
              <th class="p-2.5 border border-slate-200 dark:border-slate-700">{content.article.benchmarksHeaders.condition}</th>
              <th class="p-2.5 border border-slate-200 dark:border-slate-700">{content.article.benchmarksHeaders.celsius}</th>
              <th class="p-2.5 border border-slate-200 dark:border-slate-700">{content.article.benchmarksHeaders.fahrenheit}</th>
              <th class="p-2.5 border border-slate-200 dark:border-slate-700">{content.article.benchmarksHeaders.kelvin}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {content.article.benchmarksRows.map((row) => (
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                <td class="p-2.5 border border-slate-200 dark:border-slate-800 font-semibold text-slate-900 dark:text-white">{row.condition}</td>
                <td class="p-2.5 border border-slate-200 dark:border-slate-800 font-mono">{row.celsius}</td>
                <td class="p-2.5 border border-slate-200 dark:border-slate-800 font-mono">{row.fahrenheit}</td>
                <td class="p-2.5 border border-slate-200 dark:border-slate-800 font-mono">{row.kelvin}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>{content.article.useCasesHeader}</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 my-4">
        {content.article.useCasesList.map((uc) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/50">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1.5">{uc.title}</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{uc.description}</p>
          </div>
        ))}
      </div>

      <h2>{content.article.limitationsHeader}</h2>
      <ul class="space-y-2 my-3 list-disc pl-5 text-sm text-slate-600 dark:text-slate-300">
        {content.article.limitationsList.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </article>
  </Fragment>

  <!-- FAQ SECTION (Strict Parity: All 14 FAQs in Every Language) -->
  <Fragment slot="faq">
    <div class="space-y-3">
      {content.faqs.map((faq, idx) => (
        <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-900/30 transition" open={idx === 0}>
          <summary class="cursor-pointer list-none">
            <h3 class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">
              <span>{faq.question}</span>
              <span class="ml-2 text-xs font-bold text-slate-400 group-open:rotate-180 transition-transform">▼</span>
            </h3>
          </summary>
          <p class="mt-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </Fragment>
</CalculatorLayout>

<style>
  .unit-content h2 { margin-top: 2.25rem; margin-bottom: 0.75rem; font-size: 1.35rem; font-weight: 800; color: #0f172a; }
  .unit-content h2:first-child { margin-top: 0; }
  .unit-content p { margin: 0 0 1rem; line-height: 1.75; color: #475569; }
  .unit-content ul { margin: 0.75rem 0 1.5rem; padding-left: 1.5rem; list-style: disc; }
  .unit-content li { margin-bottom: 0.4rem; line-height: 1.6; }
  .unit-content code { background-color: #f1f5f9; padding: 0.15rem 0.35rem; border-radius: 0.25rem; font-size: 0.875em; }
  :global(.dark) .unit-content h2 { color: #f8fafc; }
  :global(.dark) .unit-content p, :global(.dark) .unit-content li { color: #cbd5e1; }
  :global(.dark) .unit-content code { background-color: #1e293b; color: #93c5fd; }
</style>

<!-- 100% Client-Side Conversion Engine Script -->
<script is:inline define:vars={{
  i18nData: {
    categories: content.categories,
    ui: content.ui
  }
}}>
  (function () {
    const UNIT_CONFIG = {
      length: {
        id: 'length',
        icon: '📏',
        base: 'meter',
        defaultFrom: 'meter',
        defaultTo: 'foot',
        units: {
          meter: { name: 'Meter (m)', sym: 'm', toBase: function(x) { return x; }, fromBase: function(x) { return x; } },
          kilometer: { name: 'Kilometer (km)', sym: 'km', toBase: function(x) { return x * 1000; }, fromBase: function(x) { return x / 1000; } },
          centimeter: { name: 'Centimeter (cm)', sym: 'cm', toBase: function(x) { return x * 0.01; }, fromBase: function(x) { return x / 0.01; } },
          millimeter: { name: 'Millimeter (mm)', sym: 'mm', toBase: function(x) { return x * 0.001; }, fromBase: function(x) { return x / 0.001; } },
          micrometer: { name: 'Micrometer (µm)', sym: 'µm', toBase: function(x) { return x * 1e-6; }, fromBase: function(x) { return x / 1e-6; } },
          nanometer: { name: 'Nanometer (nm)', sym: 'nm', toBase: function(x) { return x * 1e-9; }, fromBase: function(x) { return x / 1e-9; } },
          mile: { name: 'Mile (mi)', sym: 'mi', toBase: function(x) { return x * 1609.344; }, fromBase: function(x) { return x / 1609.344; } },
          yard: { name: 'Yard (yd)', sym: 'yd', toBase: function(x) { return x * 0.9144; }, fromBase: function(x) { return x / 0.9144; } },
          foot: { name: 'Foot (ft)', sym: 'ft', toBase: function(x) { return x * 0.3048; }, fromBase: function(x) { return x / 0.3048; } },
          inch: { name: 'Inch (in)', sym: 'in', toBase: function(x) { return x * 0.0254; }, fromBase: function(x) { return x / 0.0254; } },
          nautical_mile: { name: 'Nautical Mile (nmi)', sym: 'nmi', toBase: function(x) { return x * 1852; }, fromBase: function(x) { return x / 1852; } }
        }
      },
      area: {
        id: 'area',
        icon: '🗺️',
        base: 'sqm',
        defaultFrom: 'acre',
        defaultTo: 'sqft',
        units: {
          sqm: { name: 'Square Meter (m²)', sym: 'm²', toBase: function(x) { return x; }, fromBase: function(x) { return x; } },
          sqkm: { name: 'Square Kilometer (km²)', sym: 'km²', toBase: function(x) { return x * 1e6; }, fromBase: function(x) { return x / 1e6; } },
          sqcm: { name: 'Square Centimeter (cm²)', sym: 'cm²', toBase: function(x) { return x * 1e-4; }, fromBase: function(x) { return x / 1e-4; } },
          sqmm: { name: 'Square Millimeter (mm²)', sym: 'mm²', toBase: function(x) { return x * 1e-6; }, fromBase: function(x) { return x / 1e-6; } },
          hectare: { name: 'Hectare (ha)', sym: 'ha', toBase: function(x) { return x * 10000; }, fromBase: function(x) { return x / 10000; } },
          acre: { name: 'Acre (ac)', sym: 'ac', toBase: function(x) { return x * 4046.8564224; }, fromBase: function(x) { return x / 4046.8564224; } },
          sqmi: { name: 'Square Mile (mi²)', sym: 'mi²', toBase: function(x) { return x * 2589988.110336; }, fromBase: function(x) { return x / 2589988.110336; } },
          sqyd: { name: 'Square Yard (yd²)', sym: 'yd²', toBase: function(x) { return x * 0.83612736; }, fromBase: function(x) { return x / 0.83612736; } },
          sqft: { name: 'Square Foot (sq ft)', sym: 'sq ft', toBase: function(x) { return x * 0.09290304; }, fromBase: function(x) { return x / 0.09290304; } },
          sqin: { name: 'Square Inch (sq in)', sym: 'sq in', toBase: function(x) { return x * 0.00064516; }, fromBase: function(x) { return x / 0.00064516; } }
        }
      },
      volume: {
        id: 'volume',
        icon: '🧪',
        base: 'liter',
        defaultFrom: 'liter',
        defaultTo: 'us_gallon',
        units: {
          liter: { name: 'Liter (L)', sym: 'L', toBase: function(x) { return x; }, fromBase: function(x) { return x; } },
          milliliter: { name: 'Milliliter (mL)', sym: 'mL', toBase: function(x) { return x * 0.001; }, fromBase: function(x) { return x / 0.001; } },
          cubic_meter: { name: 'Cubic Meter (m³)', sym: 'm³', toBase: function(x) { return x * 1000; }, fromBase: function(x) { return x / 1000; } },
          cubic_centimeter: { name: 'Cubic Centimeter (cm³)', sym: 'cm³', toBase: function(x) { return x * 0.001; }, fromBase: function(x) { return x / 0.001; } },
          us_gallon: { name: 'US Gallon (gal)', sym: 'gal', toBase: function(x) { return x * 3.785411784; }, fromBase: function(x) { return x / 3.785411784; } },
          us_quart: { name: 'US Quart (qt)', sym: 'qt', toBase: function(x) { return x * 0.946352946; }, fromBase: function(x) { return x / 0.946352946; } },
          us_pint: { name: 'US Pint (pt)', sym: 'pt', toBase: function(x) { return x * 0.473176473; }, fromBase: function(x) { return x / 0.473176473; } },
          us_cup: { name: 'US Cup (cup)', sym: 'cup', toBase: function(x) { return x * 0.2365882365; }, fromBase: function(x) { return x / 0.2365882365; } },
          us_fl_oz: { name: 'US Fluid Ounce (fl oz)', sym: 'fl oz', toBase: function(x) { return x * 0.0295735295625; }, fromBase: function(x) { return x / 0.0295735295625; } },
          uk_gallon: { name: 'UK Gallon (imp gal)', sym: 'imp gal', toBase: function(x) { return x * 4.54609; }, fromBase: function(x) { return x / 4.54609; } },
          uk_fl_oz: { name: 'UK Fluid Ounce (imp fl oz)', sym: 'imp fl oz', toBase: function(x) { return x * 0.0284130625; }, fromBase: function(x) { return x / 0.0284130625; } },
          cubic_foot: { name: 'Cubic Foot (ft³)', sym: 'ft³', toBase: function(x) { return x * 28.316846592; }, fromBase: function(x) { return x / 28.316846592; } },
          cubic_inch: { name: 'Cubic Inch (in³)', sym: 'in³', toBase: function(x) { return x * 0.016387064; }, fromBase: function(x) { return x / 0.016387064; } }
        }
      },
      mass: {
        id: 'mass',
        icon: '⚖️',
        base: 'kilogram',
        defaultFrom: 'kilogram',
