    let currentCat = 'length';
    const categoryMetaMap = {};
    i18nData.categories.forEach(function (c) {
      categoryMetaMap[c.id] = c;
    });

    function formatNum(val) {
      if (isNaN(val) || !isFinite(val)) return '';
      if (val === 0) return '0';
      if (Math.abs(val) >= 1e9 || (Math.abs(val) > 0 && Math.abs(val) < 1e-6)) {
        return val.toExponential(4);
      }
      const fixed = val.toFixed(8);
      return parseFloat(fixed).toString();
    }

    function populateSelects(catKey, selectFrom, selectTo) {
      const cat = UNIT_CONFIG[catKey];
      if (!cat) return;
      const fromSel = document.getElementById('unit-from-select');
      const toSel = document.getElementById('unit-to-select');

      fromSel.innerHTML = '';
      toSel.innerHTML = '';

      Object.keys(cat.units).forEach(function (key) {
        const opt1 = document.createElement('option');
        opt1.value = key;
        opt1.textContent = cat.units[key].name;
        fromSel.appendChild(opt1);

        const opt2 = document.createElement('option');
        opt2.value = key;
        opt2.textContent = cat.units[key].name;
        toSel.appendChild(opt2);
      });

      fromSel.value = selectFrom || cat.defaultFrom;
      toSel.value = selectTo || cat.defaultTo;
    }

    function updateConverter() {
      const cat = UNIT_CONFIG[currentCat];
      if (!cat) return;

      const fromSel = document.getElementById('unit-from-select');
      const toSel = document.getElementById('unit-to-select');
      const fromValInput = document.getElementById('unit-from-val');
      const toValInput = document.getElementById('unit-to-val');
      const heroResult = document.getElementById('hero-result-display');
      const heroSub = document.getElementById('hero-sub-display');
      const formulaEl = document.getElementById('unit-formula');
      const baseUnitEl = document.getElementById('hero-base-unit');
      const tableEl = document.getElementById('all-units-table');

      const fromUnitKey = fromSel.value;
      const toUnitKey = toSel.value;
      const fromUnit = cat.units[fromUnitKey];
      const toUnit = cat.units[toUnitKey];

      if (!fromUnit || !toUnit) return;

      const baseUnitObj = cat.units[cat.base] || cat.units[Object.keys(cat.units)[0]];
      baseUnitEl.textContent = baseUnitObj ? baseUnitObj.name : cat.base;

      const rawVal = fromValInput.value.trim();

      // Case 1: Input is empty - respect initial empty values requirement
      if (rawVal === '') {
        toValInput.value = '';
        heroResult.textContent = '—';
        heroSub.textContent = i18nData.ui.emptyHeroSub;
        formulaEl.textContent = '—';

        tableEl.innerHTML = '';
        Object.keys(cat.units).forEach(function (key) {
          const u = cat.units[key];
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between py-1.5 ' +
            (key === toUnitKey ? 'font-bold text-blue-700 dark:text-blue-400 bg-blue-50/50 dark:bg-blue-950/20 px-1 rounded' : 'text-slate-600 dark:text-slate-300');
          row.innerHTML =
            '<span class="truncate max-w-[140px] sm:max-w-[190px]">' + u.name + '</span>' +
            '<span class="font-mono text-xs font-semibold text-slate-400">—</span>';
          tableEl.appendChild(row);
        });
        return;
      }

      // Case 2: Numerical input provided
      const inputNum = parseFloat(rawVal);
      if (isNaN(inputNum)) {
        toValInput.value = '';
        heroResult.textContent = '—';
        formulaEl.textContent = '—';
        return;
      }

      const baseVal = fromUnit.toBase(inputNum);
      const resultVal = toUnit.fromBase(baseVal);
      const formattedResult = formatNum(resultVal);

      toValInput.value = formattedResult;
      heroResult.textContent = formattedResult + ' ' + toUnit.sym;

      const fromNameShort = fromUnit.name.split(' (')[0];
      const toNameShort = toUnit.name.split(' (')[0];
      heroSub.textContent = inputNum + ' ' + fromNameShort + ' = ' + formattedResult + ' ' + toNameShort;

      // 1 Unit to Target Unit Formula
      const oneBase = fromUnit.toBase(1);
      const oneResult = toUnit.fromBase(oneBase);
      formulaEl.textContent = '1 ' + fromUnit.sym + ' = ' + formatNum(oneResult) + ' ' + toUnit.sym;

      // Equivalent across all category units
      tableEl.innerHTML = '';
      Object.keys(cat.units).forEach(function (key) {
        const u = cat.units[key];
        const equivVal = u.fromBase(baseVal);
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between py-1.5 ' +
          (key === toUnitKey ? 'font-bold text-blue-700 dark:text-blue-400 bg-blue-50/50 dark:bg-blue-950/20 px-1 rounded' : 'text-slate-600 dark:text-slate-300');
        row.innerHTML =
          '<span class="truncate max-w-[140px] sm:max-w-[190px]">' + u.name + '</span>' +
          '<span class="font-mono text-xs font-semibold select-all text-slate-800 dark:text-slate-200">' + formatNum(equivVal) + '</span>';
        tableEl.appendChild(row);
      });
    }

    function setCategory(catKey, prefFrom, prefTo, prefVal) {
      if (!UNIT_CONFIG[catKey]) return;
      currentCat = catKey;
      const cat = UNIT_CONFIG[catKey];
      const meta = categoryMetaMap[catKey] || { name: catKey, desc: '' };

      const titleEl = document.getElementById('cat-title');
      const descEl = document.getElementById('cat-desc');

      if (titleEl) {
        titleEl.innerHTML = '<span>' + cat.icon + '</span> <span>' + meta.name + '</span>';
      }
      if (descEl) {
        descEl.textContent = meta.desc;
      }

      document.querySelectorAll('.btn-unit-cat').forEach(function (b) {
        if (b.dataset.cat === catKey) {
          b.className = 'btn-unit-cat active shrink-0 rounded-lg bg-blue-700 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer';
        } else {
          b.className = 'btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
        }
      });

      populateSelects(catKey, prefFrom, prefTo);

      const valInput = document.getElementById('unit-from-val');
      if (prefVal !== undefined) {
        valInput.value = prefVal;
      }
      updateConverter();
    }

    function init() {
      setCategory('length');

      document.querySelectorAll('.btn-unit-cat').forEach(function (btn) {
        btn.addEventListener('click', function () {
          setCategory(btn.dataset.cat);
        });
      });

      document.querySelectorAll('.btn-preset-conv').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const cat = btn.dataset.cat;
          const from = btn.dataset.from;
          const to = btn.dataset.to;
          const val = btn.dataset.val;
          setCategory(cat, from, to, val);
        });
      });

      const valInput = document.getElementById('unit-from-val');
      if (valInput) {
        valInput.addEventListener('input', updateConverter);
      }

      const fromSel = document.getElementById('unit-from-select');
      if (fromSel) {
        fromSel.addEventListener('change', updateConverter);
      }

      const toSel = document.getElementById('unit-to-select');
      if (toSel) {
        toSel.addEventListener('change', updateConverter);
      }

      const swapBtn = document.getElementById('btn-swap-units');
      if (swapBtn) {
        swapBtn.addEventListener('click', function () {
          const fromVal = fromSel.value;
          const toVal = toSel.value;
          fromSel.value = toVal;
          toSel.value = fromVal;
          updateConverter();
        });
      }

      const copyBtn = document.getElementById('btn-copy-result');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          const resVal = document.getElementById('unit-to-val').value;
          if (!resVal) return;
          navigator.clipboard.writeText(resVal).then(function () {
            const orig = copyBtn.textContent;
            copyBtn.textContent = i18nData.ui.copied || 'Copied! ✓';
            setTimeout(function () { copyBtn.textContent = orig; }, 1500);
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
