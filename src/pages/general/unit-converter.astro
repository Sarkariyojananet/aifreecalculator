---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Unit Converter – Free Online Metric & Imperial Conversion Calculator"
  description="Free online mega unit converter. Instantly convert length, weight, temperature, area, volume, speed, time, and digital storage between metric and imperial units with accurate formulas."
  category="General"
  calculatorName="Unit Converter"
  slug="unit-converter"
  keywords={[
    'unit converter',
    'online unit converter',
    'metric to imperial converter',
    'length converter',
    'weight converter',
    'temperature converter',
    'celsius to fahrenheit',
    'kg to lbs converter',
    'inches to cm converter',
    'miles to km converter',
    'area converter',
    'volume converter',
    'data storage converter'
  ]}
>
  <div class="space-y-6">

    <!-- CATEGORY TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-unit-cat active shrink-0 rounded-lg bg-blue-700 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-cat="length">📏 Length</button>
        <button type="button" class="btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="weight">⚖️ Weight & Mass</button>
        <button type="button" class="btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="temperature">🌡️ Temperature</button>
        <button type="button" class="btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="area">🗺️ Area</button>
        <button type="button" class="btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="volume">🧪 Volume</button>
        <button type="button" class="btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="speed">🚀 Speed</button>
        <button type="button" class="btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="time">⏱️ Time</button>
        <button type="button" class="btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="data">💾 Data Storage</button>
      </div>
    </div>

    <!-- PRESET SHORTCUTS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1">⚡ Quick Conversions:</span>
        <button type="button" class="btn-preset-conv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="length" data-from="mile" data-to="kilometer" data-val="1">1 Mile to Km</button>
        <button type="button" class="btn-preset-conv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="length" data-from="inch" data-to="centimeter" data-val="1">1 Inch to cm</button>
        <button type="button" class="btn-preset-conv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="weight" data-from="kilogram" data-to="pound" data-val="1">1 Kg to Lbs</button>
        <button type="button" class="btn-preset-conv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="temperature" data-from="celsius" data-to="fahrenheit" data-val="100">100°C to °F</button>
        <button type="button" class="btn-preset-conv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="area" data-from="acre" data-to="sqft" data-val="1">1 Acre to Sq Ft</button>
        <button type="button" class="btn-preset-conv rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-cat="data" data-from="gigabyte" data-to="megabyte" data-val="1">1 GB to MB</button>
      </div>
    </div>

    <!-- MAIN CONVERTER PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-blue-50/20 to-indigo-50/20 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/10 sm:p-7">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">

        <!-- CONVERTER INPUTS (7 cols) -->
        <div class="space-y-4 lg:col-span-7">
          <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
            <h2 id="cat-title" class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>📏</span> Length Converter
            </h2>
            <p id="cat-desc" class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Convert between metric (meters, kilometers, cm) and imperial (miles, feet, inches) measurements instantly.
            </p>
          </div>

          <!-- FROM CARD -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between mb-1.5">
              <label for="unit-from-val" class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">From Value</label>
              <select id="unit-from-select" class="rounded-lg border border-slate-300 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"></select>
            </div>
            <input type="number" id="unit-from-val" value="1" step="any" class="w-full text-2xl font-black text-slate-900 bg-transparent border-0 focus:ring-0 p-0 dark:text-white" />
          </div>

          <!-- SWAP BUTTON -->
          <div class="flex justify-center -my-2 relative z-10">
            <button type="button" id="btn-swap-units" class="flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold text-blue-700 shadow-md hover:bg-blue-50 dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 dark:hover:bg-slate-700 cursor-pointer transition-transform hover:scale-105 active:scale-95">
              <span class="text-sm font-black">⇅</span> Swap Units
            </button>
          </div>

          <!-- TO CARD -->
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between mb-1.5">
              <label for="unit-to-val" class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">Converted Result</label>
              <select id="unit-to-select" class="rounded-lg border border-slate-300 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:text-white cursor-pointer"></select>
            </div>
            <input type="number" id="unit-to-val" readonly class="w-full text-2xl font-black text-blue-700 bg-transparent border-0 focus:ring-0 p-0 dark:text-blue-400 select-all" />
          </div>

          <!-- FORMULA HELPER -->
          <div class="rounded-xl bg-blue-50 p-3 text-xs text-blue-900 dark:bg-blue-950/40 dark:text-blue-200 border border-blue-100 dark:border-blue-900/50 flex items-center justify-between">
            <span class="font-semibold">Formula: <code id="unit-formula" class="font-mono font-bold">1 m = 3.28084 ft</code></span>
            <button type="button" id="btn-copy-result" class="text-[11px] font-bold underline hover:text-blue-600 dark:hover:text-blue-300 cursor-pointer">Copy Result</button>
          </div>
        </div>

        <!-- HERO RESULT & STATS (5 cols) -->
        <div class="space-y-4 lg:col-span-5">
          <!-- Main Highlight Result Box -->
          <div class="rounded-3xl bg-linear-to-br from-blue-700 via-indigo-700 to-slate-900 p-6 text-white shadow-xl">
            <div class="text-xs font-bold uppercase tracking-wider text-blue-200">Converted Value</div>
            <div id="hero-result-display" class="mt-2 text-2xl sm:text-3xl font-black tracking-tight break-all">3.28084 ft</div>
            <div id="hero-sub-display" class="mt-1 text-xs text-blue-100">1 Meter equals approx 3.28 Feet</div>

            <div class="mt-5 grid grid-cols-2 gap-2.5 border-t border-white/15 pt-4 text-xs">
              <div>
                <div class="text-blue-200 font-medium">Precision</div>
                <div class="font-bold text-white">Up to 8 decimals</div>
              </div>
              <div>
                <div class="text-blue-200 font-medium">Standard Unit</div>
                <div id="hero-base-unit" class="font-bold text-white">Meter (m)</div>
              </div>
            </div>
          </div>

          <!-- ALL OTHER CONVERSIONS TABLE -->
          <div class="rounded-3xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2 flex items-center justify-between">
              <span>📋 Equivalent in Other Units</span>
            </h3>
            <div class="max-h-56 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800 text-xs pr-1 scrollbar-thin" id="all-units-table">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- CONTENT SECTION (SEO 800+ Words) -->
  <Fragment slot="content">
    <article class="prose prose-slate max-w-none dark:prose-invert unit-content">
      <h2>Comprehensive Guide to Unit Conversions: Metric, Imperial & Standard Systems</h2>
      <p>
        Whether you are solving engineering calculations, baking a recipe from an international cookbook, planning an overseas road trip, or managing digital storage on a cloud server, unit conversions are an indispensable part of daily life. The modern world relies heavily on two primary measurement systems: the <strong>International System of Units (SI Metric)</strong>, adopted by virtually every country across the globe, and the <strong>US Customary / Imperial System</strong>, predominantly used in the United States, the United Kingdom, and a few other jurisdictions.
      </p>
      <p>
        This free <strong>Mega Unit Converter</strong> gives you accurate, real-time conversions across 8 major categories: <em>Length & Distance</em>, <em>Weight & Mass</em>, <em>Temperature</em>, <em>Area</em>, <em>Volume & Liquid Capacity</em>, <em>Speed & Velocity</em>, <em>Time</em>, and <em>Digital Storage</em>. Every conversion is calculated with double-precision floating-point arithmetic up to 8 decimal places for maximum scientific and everyday precision.
      </p>

      <h2>1. Length and Distance Conversions</h2>
      <p>
        Length measures the distance between two points in one dimension. The base SI unit of length is the <strong>meter (m)</strong>. The imperial system relies on inches, feet, yards, and miles.
      </p>
      <ul>
        <li><strong>1 Inch (in) = 2.54 Centimeters (cm)</strong> (exact international standard since 1959).</li>
        <li><strong>1 Foot (ft) = 12 Inches = 0.3048 Meters (m)</strong>.</li>
        <li><strong>1 Yard (yd) = 3 Feet = 0.9144 Meters</strong>.</li>
        <li><strong>1 Mile (mi) = 5,280 Feet = 1,760 Yards = 1.609344 Kilometers (km)</strong>.</li>
        <li><strong>1 Nautical Mile (nmi) = 1,852 Meters = 1.15078 Statute Miles</strong> (used in aviation and maritime navigation).</li>
      </ul>
      <p>
        <strong>Quick Rule of Thumb:</strong> To quickly convert kilometers to miles in your head, multiply by 0.6 (e.g., 100 km/h ≈ 60 mph). To convert centimeters to inches, divide by 2.5 (e.g., 25 cm ≈ 10 inches).
      </p>

      <h2>2. Weight and Mass Conversions</h2>
      <p>
        While mass is a measure of the amount of matter in an object and weight is the force exerted on it by gravity, in everyday commercial settings the terms are used interchangeably. The SI base unit is the <strong>kilogram (kg)</strong>, while imperial systems utilize pounds (avoirdupois pound) and ounces.
      </p>
      <ul>
        <li><strong>1 Kilogram (kg) = 2.2046226218 Pounds (lbs) = 1,000 Grams (g)</strong>.</li>
        <li><strong>1 Pound (lb) = 16 Ounces (oz) = 453.59237 Grams = 0.453592 Kilograms</strong>.</li>
        <li><strong>1 Metric Ton (tonne) = 1,000 kg ≈ 2,204.62 lbs</strong>.</li>
        <li><strong>1 US Short Ton = 2,000 lbs = 907.185 kg</strong>.</li>
        <li><strong>1 Stone (st, UK) = 14 lbs = 6.35029 kg</strong>.</li>
      </ul>

      <h2>3. Temperature Conversions: Formulas and Key Benchmarks</h2>
      <p>
        Unlike length or weight, temperature conversion is affine rather than multiplicative because different scales have different zero points:
      </p>
      <ul>
        <li><strong>Celsius to Fahrenheit:</strong> <code>°F = (°C × 9/5) + 32</code> or <code>°F = (°C × 1.8) + 32</code></li>
        <li><strong>Fahrenheit to Celsius:</strong> <code>°C = (°F - 32) × 5/9</code> or <code>°C = (°F - 32) ÷ 1.8</code></li>
        <li><strong>Celsius to Kelvin:</strong> <code>K = °C + 273.15</code></li>
        <li><strong>Kelvin to Celsius:</strong> <code>°C = K - 273.15</code></li>
      </ul>
      <div class="overflow-x-auto my-4">
        <table class="w-full text-xs text-left border border-slate-200 dark:border-slate-800">
          <thead class="bg-slate-100 dark:bg-slate-800 font-bold">
            <tr>
              <th class="p-2 border">Condition</th>
              <th class="p-2 border">Celsius (°C)</th>
              <th class="p-2 border">Fahrenheit (°F)</th>
              <th class="p-2 border">Kelvin (K)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="p-2 border font-semibold">Absolute Zero</td><td class="p-2 border">-273.15°C</td><td class="p-2 border">-459.67°F</td><td class="p-2 border">0 K</td></tr>
            <tr><td class="p-2 border font-semibold">Freezing Point of Water</td><td class="p-2 border">0°C</td><td class="p-2 border">32°F</td><td class="p-2 border">273.15 K</td></tr>
            <tr><td class="p-2 border font-semibold">Room Temperature</td><td class="p-2 border">20°C to 22°C</td><td class="p-2 border">68°F to 71.6°F</td><td class="p-2 border">293.15 K</td></tr>
            <tr><td class="p-2 border font-semibold">Average Human Body Temp</td><td class="p-2 border">37°C</td><td class="p-2 border">98.6°F</td><td class="p-2 border">310.15 K</td></tr>
            <tr><td class="p-2 border font-semibold">Boiling Point of Water</td><td class="p-2 border">100°C</td><td class="p-2 border">212°F</td><td class="p-2 border">373.15 K</td></tr>
          </tbody>
        </table>
      </div>

      <h2>4. Area Conversions: Land, Real Estate & Architecture</h2>
      <p>
        Area represents two-dimensional space. In real estate, knowing how to convert between square feet, square meters, acres, and local units (like Bigha and Guntha in India) is critical for home buyers and real estate investors:
      </p>
      <ul>
        <li><strong>1 Acre = 43,560 Square Feet (sq ft) = 4,046.86 Square Meters (m²) ≈ 0.4047 Hectares</strong>.</li>
        <li><strong>1 Hectare = 10,000 Square Meters = 2.47105 Acres</strong>.</li>
        <li><strong>1 Square Meter (m²) = 10.7639 Square Feet (sq ft)</strong>.</li>
        <li><strong>1 Square Kilometer (km²) = 100 Hectares = 247.105 Acres = 0.3861 Square Miles</strong>.</li>
        <li><strong>1 Bigha (India standard) ≈ 27,000 sq ft (varies between 14,400 to 27,225 sq ft by state)</strong>.</li>
      </ul>

      <h2>5. Volume & Liquid Capacity Conversions</h2>
      <p>
        Cooking, chemistry, fuel efficiency, and water usage require frequent volume conversions. Notice that a US liquid gallon is different from a UK Imperial gallon:
      </p>
      <ul>
        <li><strong>1 US Liquid Gallon = 3.78541 Liters = 128 US Fluid Ounces = 4 Quarts = 8 Pints</strong>.</li>
        <li><strong>1 UK Imperial Gallon = 4.54609 Liters = 160 UK Fluid Ounces</strong> (~20% larger than US gallon).</li>
        <li><strong>1 Liter (L) = 1,000 Milliliters (mL) = 0.264172 US Gallons = 33.814 US fl oz</strong>.</li>
        <li><strong>1 Cubic Meter (m³) = 1,000 Liters = 264.172 US Gallons = 35.3147 Cubic Feet</strong>.</li>
        <li><strong>1 US Cup = 8 Fluid Ounces = 236.588 mL</strong> (standard culinary measure).</li>
      </ul>

      <h2>6. Speed & Velocity Conversions</h2>
      <p>
        Speed measures the rate at which an object covers distance:
      </p>
      <ul>
        <li><strong>1 Kilometer per hour (km/h) = 0.621371 Miles per hour (mph) = 0.277778 Meters per second (m/s)</strong>.</li>
        <li><strong>1 Mile per hour (mph) = 1.609344 km/h = 0.44704 m/s = 0.868976 Knots</strong>.</li>
        <li><strong>1 Knot (kn) = 1 Nautical Mile per hour = 1.852 km/h = 1.15078 mph</strong>.</li>
        <li><strong>Mach 1 (Speed of Sound at sea level, 20°C) ≈ 1,235 km/h ≈ 767 mph ≈ 343 m/s</strong>.</li>
      </ul>

      <h2>7. Digital Storage & Data Capacity Conversions</h2>
      <p>
        In computing, memory can be calculated using decimal (powers of 1,000, SI) or binary (powers of 1,024, IEC):
      </p>
      <ul>
        <li><strong>1 Kilobyte (KB) = 1,024 Bytes</strong> (or 1,000 Bytes in storage manufacturer marketing).</li>
        <li><strong>1 Megabyte (MB) = 1,024 KB = 1,048,576 Bytes</strong>.</li>
        <li><strong>1 Gigabyte (GB) = 1,024 MB = 1,073,741,824 Bytes</strong>.</li>
        <li><strong>1 Terabyte (TB) = 1,024 GB = 1,048,576 MB</strong>.</li>
        <li><strong>1 Petabyte (PB) = 1,024 TB</strong>.</li>
      </ul>
      <p>
        <em>Note:</em> Hard drive and SSD manufacturers report capacity in decimal (1 GB = 1,000,000,000 bytes). This is why a brand new "1 TB" drive shows only ~931 GB in Windows OS (which calculates in binary GiB).
      </p>
    </article>
  </Fragment>

  <!-- FAQ SECTION -->
  <Fragment slot="faq">
    <div class="space-y-3">
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800" open>
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">1. How accurate is this online unit converter?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">All conversion ratios are based on the latest NIST (National Institute of Standards and Technology) and ISO international standards. Calculations use 64-bit IEEE 754 floating point arithmetic, ensuring precision down to 8 significant decimal places.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">2. What is the difference between Metric and Imperial systems?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">The Metric system is decimal-based (powers of 10), making scaling between millimeters, centimeters, meters, and kilometers intuitive. The Imperial system is based on historical units with arbitrary conversion factors (12 inches in a foot, 3 feet in a yard, 16 ounces in a pound, 5,280 feet in a mile).</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">3. Why is a US Gallon different from a UK Imperial Gallon?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">A US gallon is defined as 231 cubic inches (~3.785 liters), based on the old Queen Anne wine gallon. The British Imperial gallon was redefined in 1824 as the volume of 10 pounds of water at 62°F (~4.546 liters). Consequently, a UK gallon is approximately 20% larger than a US gallon.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">4. How do I convert temperature between Celsius and Fahrenheit?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">To convert Celsius to Fahrenheit, multiply by 1.8 and add 32: (°C × 1.8) + 32 = °F. To convert Fahrenheit to Celsius, subtract 32 and divide by 1.8: (°F - 32) ÷ 1.8 = °C. At -40°, both scales intersect (-40°C = -40°F).</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">5. How many square feet are in 1 Acre and 1 Hectare?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">One acre equals exactly 43,560 square feet (about 4,046.86 square meters). One hectare equals 10,000 square meters, which is approximately 107,639 square feet or 2.471 acres.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none"><h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">6. Why does my 1 TB hard drive show as 931 GB in Windows?<span class="group-open:rotate-180 transition-transform">▼</span></h3></summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Drive manufacturers use decimal prefix (1 TB = 10^12 = 1,000,000,000,000 bytes). Microsoft Windows calculates storage using binary gibibytes (GiB, 2^30 = 1,073,741,824 bytes per GB). Dividing 1,000,000,000,000 by 1,073,741,824 gives ~931.32 GB.</p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<style>
  .unit-content h2 { margin-top: 2.25rem; margin-bottom: 0.75rem; font-size: 1.4rem; font-weight: 800; color: #0f172a; }
  .unit-content h2:first-child { margin-top: 0; }
  .unit-content p { margin: 0 0 1rem; line-height: 1.75; color: #475569; }
  .unit-content ul { margin: 0.75rem 0 1.5rem; padding-left: 1.5rem; list-style: disc; }
  .unit-content li { margin-bottom: 0.4rem; line-height: 1.6; }
  .unit-content code { background-color: #f1f5f9; padding: 0.15rem 0.35rem; border-radius: 0.25rem; font-size: 0.875em; }
  :global(.dark) .unit-content h2 { color: #f8fafc; }
  :global(.dark) .unit-content p, :global(.dark) .unit-content li { color: #cbd5e1; }
  :global(.dark) .unit-content code { background-color: #1e293b; color: #93c5fd; }
</style>

<script is:inline>
  const UNIT_CONFIG = {
    length: {
      name: 'Length & Distance',
      icon: '📏',
      base: 'meter',
      desc: 'Convert meters, kilometers, miles, yards, feet, inches, and nautical miles.',
      units: {
        meter: { name: 'Meter (m)', toBase: x => x, fromBase: x => x },
        kilometer: { name: 'Kilometer (km)', toBase: x => x * 1000, fromBase: x => x / 1000 },
        centimeter: { name: 'Centimeter (cm)', toBase: x => x * 0.01, fromBase: x => x / 0.01 },
        millimeter: { name: 'Millimeter (mm)', toBase: x => x * 0.001, fromBase: x => x / 0.001 },
        mile: { name: 'Mile (mi)', toBase: x => x * 1609.344, fromBase: x => x / 1609.344 },
        yard: { name: 'Yard (yd)', toBase: x => x * 0.9144, fromBase: x => x / 0.9144 },
        foot: { name: 'Foot (ft)', toBase: x => x * 0.3048, fromBase: x => x / 0.3048 },
        inch: { name: 'Inch (in)', toBase: x => x * 0.0254, fromBase: x => x / 0.0254 },
        nautical_mile: { name: 'Nautical Mile (nmi)', toBase: x => x * 1852, fromBase: x => x / 1852 }
      },
      defaultFrom: 'meter',
      defaultTo: 'foot'
    },
    weight: {
      name: 'Weight & Mass',
      icon: '⚖️',
      base: 'kilogram',
      desc: 'Convert kilograms, grams, milligrams, pounds (lbs), ounces (oz), and metric tons.',
      units: {
        kilogram: { name: 'Kilogram (kg)', toBase: x => x, fromBase: x => x },
        gram: { name: 'Gram (g)', toBase: x => x * 0.001, fromBase: x => x / 0.001 },
        milligram: { name: 'Milligram (mg)', toBase: x => x * 0.000001, fromBase: x => x / 0.000001 },
        pound: { name: 'Pound (lb)', toBase: x => x * 0.45359237, fromBase: x => x / 0.45359237 },
        ounce: { name: 'Ounce (oz)', toBase: x => x * 0.028349523125, fromBase: x => x / 0.028349523125 },
        tonne: { name: 'Metric Ton (t)', toBase: x => x * 1000, fromBase: x => x / 1000 },
        stone: { name: 'Stone (st)', toBase: x => x * 6.35029318, fromBase: x => x / 6.35029318 }
      },
      defaultFrom: 'kilogram',
      defaultTo: 'pound'
    },
    temperature: {
      name: 'Temperature',
      icon: '🌡️',
      base: 'celsius',
      desc: 'Convert temperature between Celsius (°C), Fahrenheit (°F), and Kelvin (K).',
      units: {
        celsius: { name: 'Celsius (°C)', toBase: x => x, fromBase: x => x },
        fahrenheit: { name: 'Fahrenheit (°F)', toBase: x => (x - 32) * (5 / 9), fromBase: x => (x * 9 / 5) + 32 },
        kelvin: { name: 'Kelvin (K)', toBase: x => x - 273.15, fromBase: x => x + 273.15 }
      },
      defaultFrom: 'celsius',
      defaultTo: 'fahrenheit'
    },
    area: {
      name: 'Area & Land Measure',
      icon: '🗺️',
      base: 'sqm',
      desc: 'Convert square meters, square feet, acres, hectares, square kilometers, and square miles.',
      units: {
        sqm: { name: 'Square Meter (m²)', toBase: x => x, fromBase: x => x },
        sqft: { name: 'Square Foot (sq ft)', toBase: x => x * 0.092903, fromBase: x => x / 0.092903 },
        acre: { name: 'Acre (ac)', toBase: x => x * 4046.8564224, fromBase: x => x / 4046.8564224 },
        hectare: { name: 'Hectare (ha)', toBase: x => x * 10000, fromBase: x => x / 10000 },
        sqkm: { name: 'Square Kilometer (km²)', toBase: x => x * 1000000, fromBase: x => x / 1000000 },
        sqmi: { name: 'Square Mile (mi²)', toBase: x => x * 2589988.11, fromBase: x => x / 2589988.11 },
        sqyd: { name: 'Square Yard (yd²)', toBase: x => x * 0.836127, fromBase: x => x / 0.836127 }
      },
      defaultFrom: 'acre',
      defaultTo: 'sqft'
    },
    volume: {
      name: 'Volume & Capacity',
      icon: '🧪',
      base: 'liter',
      desc: 'Convert liters, milliliters, US gallons, UK gallons, cups, quarts, pints, and cubic meters.',
      units: {
        liter: { name: 'Liter (L)', toBase: x => x, fromBase: x => x },
        milliliter: { name: 'Milliliter (mL)', toBase: x => x * 0.001, fromBase: x => x / 0.001 },
        us_gallon: { name: 'US Gallon (gal)', toBase: x => x * 3.785411784, fromBase: x => x / 3.785411784 },
        uk_gallon: { name: 'UK Gallon (imp gal)', toBase: x => x * 4.54609, fromBase: x => x / 4.54609 },
        cubic_meter: { name: 'Cubic Meter (m³)', toBase: x => x * 1000, fromBase: x => x / 1000 },
        us_cup: { name: 'US Cup (cup)', toBase: x => x * 0.2365882365, fromBase: x => x / 0.2365882365 },
        us_fl_oz: { name: 'US Fluid Ounce (fl oz)', toBase: x => x * 0.0295735295625, fromBase: x => x / 0.0295735295625 },
        us_quart: { name: 'US Quart (qt)', toBase: x => x * 0.946352946, fromBase: x => x / 0.946352946 }
      },
      defaultFrom: 'liter',
      defaultTo: 'us_gallon'
    },
    speed: {
      name: 'Speed & Velocity',
      icon: '🚀',
      base: 'mps',
      desc: 'Convert kilometers per hour, miles per hour, meters per second, knots, and mach.',
      units: {
        kmh: { name: 'Kilometer per Hour (km/h)', toBase: x => x / 3.6, fromBase: x => x * 3.6 },
        mph: { name: 'Mile per Hour (mph)', toBase: x => x * 0.44704, fromBase: x => x / 0.44704 },
        mps: { name: 'Meter per Second (m/s)', toBase: x => x, fromBase: x => x },
        knot: { name: 'Knot (kn)', toBase: x => x * 0.514444, fromBase: x => x / 0.514444 },
        mach: { name: 'Mach (speed of sound)', toBase: x => x * 343, fromBase: x => x / 343 }
      },
      defaultFrom: 'kmh',
      defaultTo: 'mph'
    },
    time: {
      name: 'Time',
      icon: '⏱️',
      base: 'second',
      desc: 'Convert seconds, minutes, hours, days, weeks, months, and years.',
      units: {
        second: { name: 'Second (s)', toBase: x => x, fromBase: x => x },
        minute: { name: 'Minute (min)', toBase: x => x * 60, fromBase: x => x / 60 },
        hour: { name: 'Hour (h)', toBase: x => x * 3600, fromBase: x => x / 3600 },
        day: { name: 'Day (d)', toBase: x => x * 86400, fromBase: x => x / 86400 },
        week: { name: 'Week (wk)', toBase: x => x * 604800, fromBase: x => x / 604800 },
        month: { name: 'Month (avg 30.43d)', toBase: x => x * 2629746, fromBase: x => x / 2629746 },
        year: { name: 'Year (365d)', toBase: x => x * 31536000, fromBase: x => x / 31536000 }
      },
      defaultFrom: 'hour',
      defaultTo: 'minute'
    },
    data: {
      name: 'Digital Storage & Data',
      icon: '💾',
      base: 'byte',
      desc: 'Convert bytes, kilobytes (KB), megabytes (MB), gigabytes (GB), terabytes (TB), and petabytes (PB).',
      units: {
        byte: { name: 'Byte (B)', toBase: x => x, fromBase: x => x },
        kilobyte: { name: 'Kilobyte (KB, 1024 B)', toBase: x => x * 1024, fromBase: x => x / 1024 },
        megabyte: { name: 'Megabyte (MB, 1024 KB)', toBase: x => x * 1048576, fromBase: x => x / 1048576 },
        gigabyte: { name: 'Gigabyte (GB, 1024 MB)', toBase: x => x * 1073741824, fromBase: x => x / 1073741824 },
        terabyte: { name: 'Terabyte (TB, 1024 GB)', toBase: x => x * 1099511627776, fromBase: x => x / 1099511627776 },
        petabyte: { name: 'Petabyte (PB, 1024 TB)', toBase: x => x * 1125899906842624, fromBase: x => x / 1125899906842624 }
      },
      defaultFrom: 'gigabyte',
      defaultTo: 'megabyte'
    }
  };

  let currentCat = 'length';

  function formatNum(val) {
    if (isNaN(val) || !isFinite(val)) return '0';
    if (Math.abs(val) >= 1e9 || (Math.abs(val) > 0 && Math.abs(val) < 1e-6)) {
      return val.toExponential(4);
    }
    const fixed = val.toFixed(6);
    return parseFloat(fixed).toString();
  }

  function populateSelects(catKey, selectFrom, selectTo) {
    const cat = UNIT_CONFIG[catKey];
    const fromSel = document.getElementById('unit-from-select');
    const toSel = document.getElementById('unit-to-select');

    fromSel.innerHTML = '';
    toSel.innerHTML = '';

    Object.keys(cat.units).forEach(key => {
      const opt1 = document.createElement('option');
      opt1.value = key;
      opt1.textContent = cat.units[key].name;
      fromSel.appendChild(opt1);

      const opt2 = document.createElement('option');
      opt2.value = key;
      opt2.textContent = cat.units[key].name;
      toSel.appendChild(opt2);
    });

    fromSel.value = selectFrom || cat.defaultFrom;
    toSel.value = selectTo || cat.defaultTo;
  }

  function updateConverter() {
    const cat = UNIT_CONFIG[currentCat];
    const fromUnitKey = document.getElementById('unit-from-select').value;
    const toUnitKey = document.getElementById('unit-to-select').value;
    const inputVal = parseFloat(document.getElementById('unit-from-val').value) || 0;

    const fromUnit = cat.units[fromUnitKey];
    const toUnit = cat.units[toUnitKey];

    if (!fromUnit || !toUnit) return;

    const baseVal = fromUnit.toBase(inputVal);
    const resultVal = toUnit.fromBase(baseVal);

    document.getElementById('unit-to-val').value = formatNum(resultVal);

    const toNameShort = toUnit.name.split(' (')[0];
    const fromNameShort = fromUnit.name.split(' (')[0];
    document.getElementById('hero-result-display').textContent = formatNum(resultVal) + ' ' + (toUnit.name.match(/\(([^)]+)\)/)?.[1] || '');
    document.getElementById('hero-sub-display').textContent = `${inputVal} ${fromNameShort} equals ${formatNum(resultVal)} ${toNameShort}`;
    document.getElementById('hero-base-unit').textContent = cat.units[cat.base] ? cat.units[cat.base].name : cat.base;

    const oneBase = fromUnit.toBase(1);
    const oneResult = toUnit.fromBase(oneBase);
    const formulaText = `1 ${fromUnit.name.split(' ')[0]} = ${formatNum(oneResult)} ${toUnit.name.split(' ')[0]}`;
    document.getElementById('unit-formula').textContent = formulaText;

    const tableEl = document.getElementById('all-units-table');
    tableEl.innerHTML = '';
    Object.keys(cat.units).forEach(key => {
      const u = cat.units[key];
      const equivVal = u.fromBase(baseVal);
      const row = document.createElement('div');
      row.className = `flex items-center justify-between py-1.5 ${key === toUnitKey ? 'font-bold text-blue-700 dark:text-blue-400 bg-blue-50/50 dark:bg-blue-950/20 px-1 rounded' : 'text-slate-600 dark:text-slate-300'}`;
      row.innerHTML = `
        <span class="truncate max-w-[130px] sm:max-w-[180px]">${u.name}</span>
        <span class="font-mono text-xs font-semibold select-all">${formatNum(equivVal)}</span>
      `;
      tableEl.appendChild(row);
    });
  }

  function setCategory(catKey, prefFrom, prefTo, prefVal) {
    currentCat = catKey;
    const cat = UNIT_CONFIG[catKey];

    document.getElementById('cat-title').innerHTML = `<span>${cat.icon}</span> ${cat.name} Converter`;
    document.getElementById('cat-desc').textContent = cat.desc;

    document.querySelectorAll('.btn-unit-cat').forEach(b => {
      if (b.dataset.cat === catKey) {
        b.className = 'btn-unit-cat active shrink-0 rounded-lg bg-blue-700 px-3.5 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        b.className = 'btn-unit-cat shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    populateSelects(catKey, prefFrom, prefTo);
    if (prefVal !== undefined) {
      document.getElementById('unit-from-val').value = prefVal;
    }
    updateConverter();
  }

  document.addEventListener('DOMContentLoaded', () => {
    setCategory('length');

    document.querySelectorAll('.btn-unit-cat').forEach(btn => {
      btn.addEventListener('click', () => {
        setCategory(btn.dataset.cat);
      });
    });

    document.querySelectorAll('.btn-preset-conv').forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat;
        const from = btn.dataset.from;
        const to = btn.dataset.to;
        const val = btn.dataset.val;
        setCategory(cat, from, to, val);
      });
    });

    document.getElementById('unit-from-val').addEventListener('input', updateConverter);
    document.getElementById('unit-from-select').addEventListener('change', updateConverter);
    document.getElementById('unit-to-select').addEventListener('change', updateConverter);

    document.getElementById('btn-swap-units').addEventListener('click', () => {
      const fromSel = document.getElementById('unit-from-select');
      const toSel = document.getElementById('unit-to-select');
      const fromVal = fromSel.value;
      const toVal = toSel.value;
      fromSel.value = toVal;
      toSel.value = fromVal;
      updateConverter();
    });

    document.getElementById('btn-copy-result').addEventListener('click', () => {
      const resVal = document.getElementById('unit-to-val').value;
      navigator.clipboard.writeText(resVal).then(() => {
        const btn = document.getElementById('btn-copy-result');
        const orig = btn.textContent;
        btn.textContent = 'Copied! ✓';
        setTimeout(() => { btn.textContent = orig; }, 1500);
      });
    });
  });
</script>
