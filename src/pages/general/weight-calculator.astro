<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // Conversion factors to 1 kg
  const TO_KG = {
    kg: 1,
    lb: 0.45359237,
    g: 0.001,
    oz: 0.028349523125,
    stone: 6.35029318,
    tonne: 1000,
    mg: 0.000001,
    mcg: 0.000000001,
    us_ton: 907.18474,
    long_ton: 1016.0469088,
    quintal: 100,
    troy_oz: 0.0311034768,
  };

  const UNIT_SYMBOLS = {
    kg: 'kg',
    lb: 'lbs',
    g: 'g',
    oz: 'oz',
    stone: 'st',
    tonne: 't',
    mg: 'mg',
    mcg: 'mcg',
    us_ton: 'tn',
    long_ton: 'long tn',
    quintal: 'q',
    troy_oz: 'oz t',
  };

  const UNIT_NAMES = {
    kg: 'Kilograms',
    lb: 'Pounds',
    g: 'Grams',
    oz: 'Ounces',
    stone: 'Stones',
    tonne: 'Metric Tonnes',
    mg: 'Milligrams',
    mcg: 'Micrograms',
    us_ton: 'US Short Tons',
    long_ton: 'Imperial Long Tons',
    quintal: 'Quintals',
    troy_oz: 'Troy Ounces',
  };

  const UNIT_DECIMALS = {
    kg: 3,
    lb: 3,
    g: 2,
    oz: 2,
    stone: 2,
    tonne: 4,
    mg: 0,
    mcg: 0,
    us_ton: 4,
    long_ton: 4,
    quintal: 3,
    troy_oz: 3,
  };

  // DOM Elements - Main Tool
  const inputWeightVal = document.getElementById('input-weight-val');
  const selectFromUnit = document.getElementById('select-from-unit');
  const selectToUnit = document.getElementById('select-to-unit');
  const btnConvert = document.getElementById('btn-convert');
  const btnClear = document.getElementById('btn-clear');
  const weightError = document.getElementById('weight-error');
  const resultsPlaceholder = document.getElementById('results-placeholder');
  const resultsCard = document.getElementById('results-card');

  // Results DOM Elements
  const resHeaderTitle = document.getElementById('res-header-title');
  const resPrimaryLabel = document.getElementById('res-primary-label');
  const resPrimaryVal = document.getElementById('res-primary-val');
  const resPrimarySymbol = document.getElementById('res-primary-symbol');
  const resPrimaryFormula = document.getElementById('res-primary-formula');
  const resStoneCompound = document.getElementById('res-stone-compound');
  const btnCopySummary = document.getElementById('btn-copy-summary');
  const copySummaryText = document.getElementById('copy-summary-text');

  // Format Helper
  function formatNum(num, decimals) {
    if (num === 0) return '0';
    if (isNaN(num) || !isFinite(num)) return '0';

    const abs = Math.abs(num);
    if (abs >= 1e12 || (abs > 0 && abs < 1e-6)) {
      return num.toExponential(4);
    }

    let effDec = decimals;
    if (abs >= 1000000) effDec = 0;
    else if (abs >= 1000) effDec = Math.min(2, decimals);
    else if (abs < 0.001) effDec = Math.max(4, decimals);

    const rounded = Number(num.toFixed(effDec));
    const parts = rounded.toString().split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return parts.join('.');
  }

  // Perform Main Weight Conversion
  function executeWeightConversion() {
    const rawValStr = inputWeightVal.value.trim();

    // Validation
    if (!rawValStr) {
      showWeightError('Please enter a weight or mass value to convert.');
      inputWeightVal.focus();
      return;
    }

    const val = parseFloat(rawValStr);
    if (isNaN(val)) {
      showWeightError('Please enter a valid numeric value.');
      inputWeightVal.focus();
      return;
    }

    if (val < 0) {
      showWeightError('Weight cannot be negative. Please enter a positive value.');
      inputWeightVal.focus();
      return;
    }

    // Hide any previous error
    hideWeightError();

    const fromUnit = selectFromUnit.value;
    const toUnitChoice = selectToUnit.value;
    const fromFactor = TO_KG[fromUnit] || 1;
    const baseKg = val * fromFactor;

    // Determine highlighted target unit
    let primaryTarget = toUnitChoice;
    if (primaryTarget === 'auto' || !primaryTarget) {
      primaryTarget = fromUnit === 'kg' ? 'lb' : fromUnit === 'lb' ? 'kg' : fromUnit === 'g' ? 'oz' : 'kg';
    }

    // Update Header
    resHeaderTitle.textContent = `${formatNum(val, 3)} ${UNIT_NAMES[fromUnit]} (${UNIT_SYMBOLS[fromUnit]}) equals:`;

    // Populate All Result Cards
    const allKeys = Object.keys(TO_KG);
    let summaryText = `Weight Conversion for ${val} ${UNIT_SYMBOLS[fromUnit]}:\n`;

    allKeys.forEach((key) => {
      const targetFactor = TO_KG[key];
      const rawConverted = baseKg / targetFactor;
      const formatted = formatNum(rawConverted, UNIT_DECIMALS[key]);
      
      const valEl = document.getElementById(`card-val-${key}`);
      const formEl = document.getElementById(`card-formula-${key}`);

      if (valEl) {
        valEl.textContent = `${formatted} ${UNIT_SYMBOLS[key]}`;
      }

      if (formEl) {
        if (key === fromUnit) {
          formEl.textContent = `Source Unit (${val} ${UNIT_SYMBOLS[fromUnit]})`;
        } else {
          const ratio = fromFactor / targetFactor;
          formEl.textContent = `${val} × ${ratio >= 1 ? ratio.toFixed(4) : (1 / ratio).toFixed(4)} = ${formatted} ${UNIT_SYMBOLS[key]}`;
        }
      }

      summaryText += `• ${UNIT_NAMES[key]}: ${formatted} ${UNIT_SYMBOLS[key]}\n`;
    });

    // Populate Primary Highlight Hero
    const primaryFactor = TO_KG[primaryTarget];
    const primaryConverted = baseKg / primaryFactor;
    const primaryFormatted = formatNum(primaryConverted, UNIT_DECIMALS[primaryTarget]);

    resPrimaryLabel.textContent = `${UNIT_NAMES[primaryTarget]} (${UNIT_SYMBOLS[primaryTarget]})`;
    resPrimaryVal.textContent = primaryFormatted;
    resPrimarySymbol.textContent = UNIT_SYMBOLS[primaryTarget];

    if (primaryTarget === fromUnit) {
      resPrimaryFormula.textContent = `${val} ${UNIT_SYMBOLS[fromUnit]} = ${val} ${UNIT_SYMBOLS[fromUnit]}`;
    } else {
      const ratio = fromFactor / primaryFactor;
      resPrimaryFormula.textContent = `${val} ${UNIT_SYMBOLS[fromUnit]} × ${ratio >= 1 ? ratio.toFixed(4) : (1 / ratio).toFixed(4)} = ${primaryFormatted} ${UNIT_SYMBOLS[primaryTarget]}`;
    }

    // Stone + Pounds Compound breakdown
    const totalLbs = baseKg / TO_KG.lb;
    const stPart = Math.floor(totalLbs / 14);
    const lbsRemainder = Number((totalLbs % 14).toFixed(2));
    resStoneCompound.textContent = `${stPart} st ${lbsRemainder} lbs`;

    // Show Results Card, Hide Placeholder
    resultsPlaceholder.classList.add('hidden');
    resultsCard.classList.remove('hidden');

    // Store summary on copy button dataset
    btnCopySummary.dataset.summary = summaryText;
  }

  function showWeightError(msg) {
    weightError.textContent = msg;
    weightError.classList.remove('hidden');
    resultsCard.classList.add('hidden');
  }

  function hideWeightError() {
    weightError.textContent = '';
    weightError.classList.add('hidden');
  }

  function clearWeightCalculator() {
    inputWeightVal.value = '';
    selectFromUnit.value = 'kg';
    selectToUnit.value = 'auto';
    hideWeightError();
    resultsCard.classList.add('hidden');
    resultsPlaceholder.classList.remove('hidden');
    inputWeightVal.focus();
  }

  // Event Listeners - Main Tool
  btnConvert.addEventListener('click', (e) => {
    e.preventDefault();
    executeWeightConversion();
  });

  inputWeightVal.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeWeightConversion();
    }
  });

  btnClear.addEventListener('click', clearWeightCalculator);

  // Quick Preset Chips
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-val');
      const unit = btn.getAttribute('data-unit');
      inputWeightVal.value = val;
      selectFromUnit.value = unit;
      selectToUnit.value = unit === 'kg' ? 'lb' : 'kg';
      executeWeightConversion();
    });
  });

  // Copy Summary Handler
  btnCopySummary.addEventListener('click', async () => {
    const text = btnCopySummary.dataset.summary || '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copySummaryText.textContent = 'Copied! ✓';
      setTimeout(() => {
        copySummaryText.textContent = 'Copy Results';
      }, 2000);
    } catch (err) {
      console.error('Clipboard copy failed', err);
    }
  });


  // ==========================================
  // SUB-TOOL 1: GOLD WEIGHT CONVERTER
  // ==========================================
  const inputGoldVal = document.getElementById('input-gold-val');
  const selectGoldUnit = document.getElementById('select-gold-unit');
  const btnGoldConvert = document.getElementById('btn-gold-convert');
  const btnGoldClear = document.getElementById('btn-gold-clear');
  const goldError = document.getElementById('gold-error');
  const goldResultsBox = document.getElementById('gold-results-box');

  const goldResTroy = document.getElementById('gold-res-troy');
  const goldResGrams = document.getElementById('gold-res-grams');
  const goldResKg = document.getElementById('gold-res-kg');
  const goldResMg = document.getElementById('gold-res-mg');
  const goldResTola = document.getElementById('gold-res-tola');

  function executeGoldConversion() {
    const rawValStr = inputGoldVal.value.trim();
    if (!rawValStr) {
      goldError.textContent = 'Please enter a gold weight value.';
      goldError.classList.remove('hidden');
      goldResultsBox.classList.add('hidden');
      inputGoldVal.focus();
      return;
    }

    const val = parseFloat(rawValStr);
    if (isNaN(val) || val < 0) {
      goldError.textContent = 'Please enter a valid positive weight.';
      goldError.classList.remove('hidden');
      goldResultsBox.classList.add('hidden');
      inputGoldVal.focus();
      return;
    }

    goldError.classList.add('hidden');

    const unit = selectGoldUnit.value;
    let grams = 0;

    if (unit === 'g') grams = val;
    else if (unit === 'kg') grams = val * 1000;
    else if (unit === 'mg') grams = val / 1000;
    else if (unit === 'troy_oz') grams = val * 31.1034768;
    else if (unit === 'tola') grams = val * 11.6638038;

    const troyOz = grams / 31.1034768;
    const kg = grams / 1000;
    const mg = grams * 1000;
    const tola = grams / 11.6638038;

    goldResTroy.textContent = `${formatNum(troyOz, 4)} oz t`;
    goldResGrams.textContent = `${formatNum(grams, 3)} g`;
    goldResKg.textContent = `${formatNum(kg, 5)} kg`;
    goldResMg.textContent = `${formatNum(mg, 1)} mg`;
    goldResTola.textContent = `${formatNum(tola, 4)} tolas`;

    goldResultsBox.classList.remove('hidden');
  }

  btnGoldConvert.addEventListener('click', (e) => {
    e.preventDefault();
    executeGoldConversion();
  });

  inputGoldVal.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeGoldConversion();
    }
  });

  btnGoldClear.addEventListener('click', () => {
    inputGoldVal.value = '';
    selectGoldUnit.value = 'troy_oz';
    goldError.classList.add('hidden');
    goldResultsBox.classList.add('hidden');
  });


  // ==========================================
  // SUB-TOOL 2: HEIGHT WEIGHT BMI TOOL
  // ==========================================
  let currentHwSystem = 'metric'; // 'metric' | 'us'

  const hwTabMetric = document.getElementById('hw-tab-metric');
  const hwTabUs = document.getElementById('hw-tab-us');

  const hwMetricHeightCol = document.getElementById('hw-metric-height-col');
  const hwUsHeightCol = document.getElementById('hw-us-height-col');
  const hwWeightLabel = document.getElementById('hw-weight-label');

  const inputHwHeightCm = document.getElementById('input-hw-height-cm');
  const inputHwHeightFt = document.getElementById('input-hw-height-ft');
  const inputHwHeightIn = document.getElementById('input-hw-height-in');
  const inputHwWeight = document.getElementById('input-hw-weight');

  const btnHwCalculate = document.getElementById('btn-hw-calculate');
  const btnHwClear = document.getElementById('btn-hw-clear');
  const hwError = document.getElementById('hw-error');
  const hwResultsBox = document.getElementById('hw-results-box');

  const hwResBmi = document.getElementById('hw-res-bmi');
  const hwResBadge = document.getElementById('hw-res-badge');
  const hwResRangeKg = document.getElementById('hw-res-range-kg');
  const hwResRangeLbs = document.getElementById('hw-res-range-lbs');

  hwTabMetric.addEventListener('click', () => {
    currentHwSystem = 'metric';
    hwTabMetric.className = 'hw-tab active rounded-lg bg-emerald-600 px-3 py-1 font-bold text-white shadow-xs cursor-pointer';
    hwTabUs.className = 'hw-tab rounded-lg border border-slate-300 bg-white px-3 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
    hwMetricHeightCol.classList.remove('hidden');
    hwUsHeightCol.classList.add('hidden');
    hwWeightLabel.textContent = 'Weight (kg)';
    inputHwWeight.placeholder = 'e.g. 70';
  });

  hwTabUs.addEventListener('click', () => {
    currentHwSystem = 'us';
    hwTabUs.className = 'hw-tab active rounded-lg bg-emerald-600 px-3 py-1 font-bold text-white shadow-xs cursor-pointer';
    hwTabMetric.className = 'hw-tab rounded-lg border border-slate-300 bg-white px-3 py-1 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
    hwMetricHeightCol.classList.add('hidden');
    hwUsHeightCol.classList.remove('hidden');
    hwWeightLabel.textContent = 'Weight (lbs)';
    inputHwWeight.placeholder = 'e.g. 154';
  });

  function executeHwCalculation() {
    let heightM = 0;
    let weightKg = 0;

    if (currentHwSystem === 'metric') {
      const cm = parseFloat(inputHwHeightCm.value);
      if (isNaN(cm) || cm <= 0) {
        showHwError('Please enter a valid height in centimeters.');
        return;
      }
      heightM = cm / 100;

      const kg = parseFloat(inputHwWeight.value);
      if (isNaN(kg) || kg <= 0) {
        showHwError('Please enter a valid weight in kilograms.');
        return;
      }
      weightKg = kg;
    } else {
      const ft = parseFloat(inputHwHeightFt.value) || 0;
      const inches = parseFloat(inputHwHeightIn.value) || 0;
      const totalInches = ft * 12 + inches;
      if (totalInches <= 0) {
        showHwError('Please enter a valid height in feet and inches.');
        return;
      }
      heightM = (totalInches * 2.54) / 100;

      const lbs = parseFloat(inputHwWeight.value);
      if (isNaN(lbs) || lbs <= 0) {
        showHwError('Please enter a valid weight in pounds.');
        return;
      }
      weightKg = lbs * 0.45359237;
    }

    hwError.classList.add('hidden');

    const bmi = Number((weightKg / (heightM * heightM)).toFixed(1));
    const healthyMinKg = Number((18.5 * heightM * heightM).toFixed(1));
    const healthyMaxKg = Number((24.9 * heightM * heightM).toFixed(1));
    const healthyMinLbs = Number((healthyMinKg * 2.20462).toFixed(1));
    const healthyMaxLbs = Number((healthyMaxKg * 2.20462).toFixed(1));

    hwResBmi.textContent = bmi.toString();

    if (bmi < 18.5) {
      hwResBadge.textContent = 'Underweight';
      hwResBadge.className = 'rounded-full bg-blue-100 px-2.5 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300';
    } else if (bmi >= 18.5 && bmi <= 24.9) {
      hwResBadge.textContent = 'Normal Weight';
      hwResBadge.className = 'rounded-full bg-emerald-100 px-2.5 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
    } else if (bmi >= 25.0 && bmi <= 29.9) {
      hwResBadge.textContent = 'Overweight';
      hwResBadge.className = 'rounded-full bg-amber-100 px-2.5 py-0.5 text-[10px] font-bold text-amber-800 dark:bg-amber-950 dark:text-amber-300';
    } else {
      hwResBadge.textContent = 'Obese';
      hwResBadge.className = 'rounded-full bg-red-100 px-2.5 py-0.5 text-[10px] font-bold text-red-800 dark:bg-red-950 dark:text-red-300';
    }

    hwResRangeKg.textContent = `${healthyMinKg} - ${healthyMaxKg} kg`;
    hwResRangeLbs.textContent = `${healthyMinLbs} - ${healthyMaxLbs} lbs`;

    hwResultsBox.classList.remove('hidden');
  }

  function showHwError(msg) {
    hwError.textContent = msg;
    hwError.classList.remove('hidden');
    hwResultsBox.classList.add('hidden');
  }

  btnHwCalculate.addEventListener('click', (e) => {
    e.preventDefault();
    executeHwCalculation();
  });

  btnHwClear.addEventListener('click', () => {
    inputHwHeightCm.value = '';
    inputHwHeightFt.value = '';
    inputHwHeightIn.value = '';
    inputHwWeight.value = '';
    hwError.classList.add('hidden');
    hwResultsBox.classList.add('hidden');
  });

</script>
