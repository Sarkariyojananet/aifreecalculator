---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Weight Converter Calculator – Convert KG, LBS, Grams and More"
  description="Free online weight converter calculator. Accurately convert weight and mass between kilograms (kg), pounds (lbs), grams (g), ounces (oz), stones, metric tonnes, gold Troy ounces, and calculate height-weight BMI."
  category="General"
  calculatorName="Weight Converter Calculator"
  slug="weight-calculator"
  keywords={[
    'weight converter',
    'weight converter calculator',
    'weight converter lbs to kg',
    'mass to weight converter',
    'weight converter kg to lbs',
    'gold weight converter',
    'height weight converter',
    'kg to lbs',
    'lbs to kg',
    'grams to ounces',
    'stones to kg',
    'troy ounce to grams'
  ]}
>
  <div class="space-y-8">
    
    <!-- MAIN CALCULATOR CARD -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/40 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- Top Header & Instructions -->
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>⚖️</span> Mass & Weight Unit Converter
            </h2>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Enter your weight value, choose source and target units, and click <strong>Convert</strong> to view accurate conversions.
            </p>
          </div>
          <span class="rounded-full bg-blue-100 px-3 py-1 text-[11px] font-bold text-blue-800 dark:bg-blue-950/80 dark:text-blue-300">
            Precision Engine
          </span>
        </div>
      </div>

      <!-- Main Inputs Form -->
      <form id="weight-form" class="mt-5 space-y-5" novalidate onsubmit="return false;">
        
        <!-- Input Row: Value + From Unit + To Unit -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-12">
          
          <!-- Weight / Mass Value Input -->
          <div class="sm:col-span-5">
            <label for="input-weight-val" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Weight / Mass Value <span class="text-red-500">*</span>
            </label>
            <div class="relative mt-2">
              <input
                type="number"
                id="input-weight-val"
                placeholder="e.g. 75"
                step="any"
                min="0"
                required
                class="w-full rounded-xl border-2 border-slate-300 bg-white px-3.5 py-2.5 text-sm font-bold text-slate-900 shadow-2xs transition focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                aria-describedby="weight-error"
              />
            </div>
          </div>

          <!-- From Unit Dropdown -->
          <div class="sm:col-span-4">
            <label for="select-from-unit" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              From Unit <span class="text-red-500">*</span>
            </label>
            <div class="relative mt-2">
              <select
                id="select-from-unit"
                class="w-full rounded-xl border-2 border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 shadow-2xs transition focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer"
              >
                <optgroup label="Metric Units">
                  <option value="kg" selected>Kilograms (kg)</option>
                  <option value="g">Grams (g)</option>
                  <option value="mg">Milligrams (mg)</option>
                  <option value="mcg">Micrograms (mcg)</option>
                  <option value="tonne">Metric Tonnes (t)</option>
                  <option value="quintal">Quintals (q)</option>
                </optgroup>
                <optgroup label="Imperial & US Units">
                  <option value="lb">Pounds (lbs)</option>
                  <option value="oz">Ounces (oz)</option>
                  <option value="stone">Stones (st)</option>
                  <option value="us_ton">US Short Tons (2,000 lbs)</option>
                  <option value="long_ton">Imperial Long Tons (2,240 lbs)</option>
                </optgroup>
                <optgroup label="Precious Metals & Traditional">
                  <option value="troy_oz">Troy Ounces (oz t - Gold)</option>
                </optgroup>
              </select>
            </div>
          </div>

          <!-- Optional To Unit Dropdown -->
          <div class="sm:col-span-3">
            <label for="select-to-unit" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Highlight Unit
            </label>
            <div class="relative mt-2">
              <select
                id="select-to-unit"
                class="w-full rounded-xl border-2 border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 shadow-2xs transition focus:border-blue-600 focus:ring-2 focus:ring-blue-500/20 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white cursor-pointer"
              >
                <option value="auto" selected>Auto (Popular Pair)</option>
                <option value="lb">Pounds (lbs)</option>
                <option value="kg">Kilograms (kg)</option>
                <option value="g">Grams (g)</option>
                <option value="oz">Ounces (oz)</option>
                <option value="stone">Stones (st)</option>
                <option value="tonne">Metric Tonnes (t)</option>
                <option value="mg">Milligrams (mg)</option>
                <option value="mcg">Micrograms (mcg)</option>
                <option value="us_ton">US Short Tons (tn)</option>
                <option value="long_ton">Imperial Long Tons</option>
                <option value="quintal">Quintals (q)</option>
                <option value="troy_oz">Troy Ounces (oz t)</option>
              </select>
            </div>
          </div>

        </div>

        <!-- Quick Presets Bar -->
        <div class="rounded-2xl border border-slate-200/80 bg-slate-50/70 p-3 dark:border-slate-800 dark:bg-slate-900/50">
          <div class="flex flex-wrap items-center gap-1.5 text-xs">
            <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
              <span>⚡</span> Quick Presets:
            </span>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="1" data-unit="kg">1 kg → lbs</button>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="5" data-unit="kg">5 kg → lbs</button>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="10" data-unit="kg">10 kg → lbs</button>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="50" data-unit="kg">50 kg → lbs</button>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="100" data-unit="kg">100 kg → lbs</button>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="1" data-unit="lb">1 lb → kg</button>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="10" data-unit="lb">10 lbs → kg</button>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="50" data-unit="lb">50 lbs → kg</button>
            <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400 transition cursor-pointer" data-val="100" data-unit="lb">100 lbs → kg</button>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button
            type="submit"
            id="btn-convert"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-7 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-600/25 transition hover:-translate-y-0.5 hover:bg-blue-700 active:scale-[0.98] cursor-pointer"
          >
            <span>Convert</span>
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-xs font-bold">→</span>
          </button>
          
          <button
            type="button"
            id="btn-clear"
            class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-2xs transition hover:bg-slate-100 active:scale-[0.98] dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 cursor-pointer"
          >
            <span>✕</span>
            <span>Clear</span>
          </button>
        </div>

        <!-- Validation Error Message Alert -->
        <p
          id="weight-error"
          class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300"
          role="alert"
          aria-live="polite"
        ></p>

      </form>
    </div>

    <!-- INITIAL PLACEHOLDER STATE (Shown before conversion) -->
    <div id="results-placeholder" class="rounded-3xl border border-dashed border-slate-300 bg-slate-50/60 p-8 text-center dark:border-slate-800 dark:bg-slate-950/40">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-xl text-blue-700 dark:bg-blue-950 dark:text-blue-300">
        ⚖️
      </div>
      <h3 class="mt-3 text-sm font-bold text-slate-900 dark:text-white">Ready for Conversion</h3>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto">
        Enter a value and select your unit above, then click the blue <strong>"Convert →"</strong> button or press <strong>Enter</strong> to calculate complete metric, imperial, and specialty weight results.
      </p>
    </div>

    <!-- CONVERSION RESULTS SECTION (Revealed only on submit) -->
    <div id="results-card" class="hidden space-y-6">
      
      <!-- Top Results Header & Primary Conversion Banner -->
      <div class="rounded-3xl border border-blue-200 bg-linear-to-r from-blue-50 via-white to-blue-50/40 p-5 shadow-sm dark:border-blue-900/50 dark:from-slate-900 dark:via-slate-900 dark:to-blue-950/30 sm:p-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-200 pb-4 dark:border-slate-800">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
              Conversion Result
            </span>
            <div id="res-header-title" class="mt-0.5 text-base sm:text-lg font-bold text-slate-800 dark:text-slate-200">
              75 Kilograms (kg) equals:
            </div>
          </div>
          <button
            type="button"
            id="btn-copy-summary"
            class="self-start sm:self-auto inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 shadow-2xs dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
          >
            <span>📋</span>
            <span id="copy-summary-text">Copy Results</span>
          </button>
        </div>

        <!-- Highlighted Primary Conversion Hero -->
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl bg-white p-4 sm:p-5 shadow-sm border border-slate-100 dark:border-slate-800 dark:bg-slate-950/80">
          <div>
            <div id="res-primary-label" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Pounds (lbs)
            </div>
            <div class="mt-1 flex flex-wrap items-baseline gap-2">
              <span id="res-primary-val" class="text-3xl sm:text-4xl font-black tracking-tight text-blue-600 dark:text-blue-400">
                165.347
              </span>
              <span id="res-primary-symbol" class="text-lg font-bold text-slate-700 dark:text-slate-300">
                lbs
              </span>
            </div>
            <div id="res-primary-formula" class="mt-1 text-xs text-slate-500 dark:text-slate-400 font-mono">
              75 kg × 2.20462 = 165.347 lbs
            </div>
          </div>

          <div id="res-stone-compound-box" class="rounded-xl bg-slate-50 px-4 py-3 border border-slate-200 dark:border-slate-800 dark:bg-slate-900 text-xs">
            <div class="text-slate-500 dark:text-slate-400 font-semibold">Compound Stone & Lbs:</div>
            <div id="res-stone-compound" class="mt-0.5 text-sm font-bold text-slate-900 dark:text-white">
              11 st 11.35 lbs
            </div>
          </div>
        </div>

      </div>

      <!-- Complete Units Grid -->
      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-6">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-1.5">
          <span>📊</span> All Converted Units
        </h3>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 text-xs">
          
          <!-- Kilograms -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 dark:hover:border-blue-700 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Kilograms (kg)</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Metric Base</span>
            </div>
            <div id="card-val-kg" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-kg" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- Pounds -->
          <div class="unit-result-card relative rounded-2xl border border-blue-200/80 bg-blue-50/30 p-3.5 dark:border-blue-900/60 dark:bg-blue-950/20 hover:border-blue-400 transition">
            <div class="flex items-center justify-between text-blue-700 dark:text-blue-300">
              <span class="font-bold">Pounds (lbs)</span>
              <span class="rounded bg-blue-100 px-1.5 py-0.5 text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">US / Imperial</span>
            </div>
            <div id="card-val-lb" class="mt-2 text-base sm:text-lg font-black text-blue-600 dark:text-blue-400">--</div>
            <div id="card-formula-lb" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- Grams -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Grams (g)</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Metric</span>
            </div>
            <div id="card-val-g" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-g" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- Ounces -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Ounces (oz)</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">US / Imperial</span>
            </div>
            <div id="card-val-oz" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-oz" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- Stones -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Stones (st)</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">UK / Imperial</span>
            </div>
            <div id="card-val-stone" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-stone" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- Metric Tonnes -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Metric Tonnes (t)</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">1,000 kg</span>
            </div>
            <div id="card-val-tonne" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-tonne" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- Milligrams -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Milligrams (mg)</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Metric</span>
            </div>
            <div id="card-val-mg" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-mg" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- Micrograms -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Micrograms (mcg)</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Scientific</span>
            </div>
            <div id="card-val-mcg" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-mcg" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- US Short Tons -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">US Short Tons (tn)</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">2,000 lbs</span>
            </div>
            <div id="card-val-us_ton" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-us_ton" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

          <!-- Imperial Long Tons -->
          <div class="unit-result-card relative rounded-2xl border border-slate-200 bg-slate-50/70 p-3.5 dark:border-slate-800 dark:bg-slate-950/60 hover:border-blue-300 transition">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400">
              <span class="font-semibold">Imperial Long Tons</span>
              <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">2,240 lbs</span>
            </div>
            <div id="card-val-long_ton" class="mt-2 text-base sm:text-lg font-black text-slate-900 dark:text-white">--</div>
            <div id="card-formula-long_ton" class="mt-1 text-[11px] text-slate-500 dark:text-slate-400 font-mono truncate">--</div>
          </div>

