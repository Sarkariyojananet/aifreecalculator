---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Weight Converter Calculator - Convert KG, LBS, Grams & Freight Mass"
  description="Free online weight converter calculator. Accurately convert weight and mass between kilograms, pounds, grams, ounces, stones, tonnes, and check industrial shipping weights."
  category="General"
  calculatorName="Weight Converter Calculator"
  slug="weight-calculator"
  keywords={[
    'weight converter',
    'weight converter calculator',
    'converter weight',
    'torque converter weight',
    '4l60e torque converter weight',
    'catalytic converter weight',
    'weight converter lbs to kg',
    'mass to weight converter',
    'weight converter kg to lbs',
    'gold weight converter',
    'kg to lbs',
    'lbs to kg',
    'grams to ounces',
    'stones to kg',
    'troy ounce to grams',
  ]}
>
  <div class="wx-shell">

    <!-- ================= MASS EXCHANGE TERMINAL ================= -->
    <section class="wx-terminal">
      <header class="wx-terminal__bar">
        <div class="wx-terminal__id">
          <span class="wx-terminal__glyph" aria-hidden="true">⚖️</span>
          <div>
            <h2 class="wx-terminal__title">Mass Exchange Terminal</h2>
            <p class="wx-terminal__sub">12 mass units &middot; converts live as you type</p>
          </div>
        </div>
        <span class="wx-terminal__live"><span class="wx-dot" aria-hidden="true"></span>LIVE</span>
      </header>

      <form id="weight-form" class="wx-form" novalidate onsubmit="return false;">

        <!-- Two-panel exchange -->
        <div class="wx-exchange">

          <!-- FROM panel -->
          <div class="wx-side">
            <label class="wx-cap" for="input-weight-val">From</label>
            <input
              type="number"
              id="input-weight-val"
              class="wx-input"
              placeholder="0"
              step="any"
              min="0"
              inputmode="decimal"
              autocomplete="off"
              aria-describedby="weight-error"
            />
            <select id="select-from-unit" class="wx-select" aria-label="Convert from unit">
              <optgroup label="Metric">
                <option value="kg" selected>Kilograms (kg)</option>
                <option value="g">Grams (g)</option>
                <option value="mg">Milligrams (mg)</option>
                <option value="mcg">Micrograms (mcg)</option>
                <option value="tonne">Metric Tonnes (t)</option>
                <option value="quintal">Quintals (q)</option>
              </optgroup>
              <optgroup label="Imperial &amp; US">
                <option value="lb">Pounds (lbs)</option>
                <option value="oz">Ounces (oz)</option>
                <option value="stone">Stones (st)</option>
                <option value="us_ton">US Short Tons (2,000 lbs)</option>
                <option value="long_ton">Imperial Long Tons (2,240 lbs)</option>
              </optgroup>
              <optgroup label="Bullion &amp; Traditional">
                <option value="troy_oz">Troy Ounces (oz t)</option>
              </optgroup>
            </select>
          </div>

          <!-- SWAP -->
          <button
            type="button"
            id="btn-swap-units"
            class="wx-swap"
            title="Swap the From and To units"
            aria-label="Swap the From and To units"
          >
            <span aria-hidden="true">⇅</span>
          </button>

          <!-- TO panel -->
          <div class="wx-side wx-side--to">
            <span class="wx-cap">To</span>
            <output id="wx-out" class="wx-out" for="input-weight-val" aria-live="polite">
              <span id="res-primary-val" class="wx-out__num">--</span>
              <span id="res-primary-symbol" class="wx-out__sym">lbs</span>
            </output>
            <select id="select-to-unit" class="wx-select" aria-label="Convert to unit">
              <option value="auto" selected>Auto &mdash; popular pair</option>
              <option value="lb">Pounds (lbs)</option>
              <option value="kg">Kilograms (kg)</option>
              <option value="g">Grams (g)</option>
              <option value="oz">Ounces (oz)</option>
              <option value="stone">Stones (st)</option>
              <option value="tonne">Metric Tonnes (t)</option>
              <option value="mg">Milligrams (mg)</option>
              <option value="mcg">Micrograms (mcg)</option>
              <option value="us_ton">US Short Tons (tn)</option>
              <option value="long_ton">Imperial Long Tons</option>
              <option value="quintal">Quintals (q)</option>
              <option value="troy_oz">Troy Ounces (oz t)</option>
            </select>
          </div>
        </div>

        <!-- Live rate strip -->
        <div class="wx-rate">
          <span class="wx-rate__tag">Rate</span>
          <code id="res-rate-text" class="wx-rate__val">1 kg = 2.2046 lbs</code>
          <code id="res-primary-formula" class="wx-rate__step">--</code>
        </div>

        <!-- Unit rail: tap any stop to set the target unit -->
        <div class="wx-rail">
          <div class="wx-rail__head">
            <span class="wx-rail__tag">Unit Rail</span>
            <span id="wx-rail-read" class="wx-rail__read">Enter a value to populate every unit</span>
          </div>
          <ol id="wx-rail-track" class="wx-rail__track"></ol>
        </div>

        <!-- Quick presets -->
        <div class="wx-presets" role="group" aria-label="Quick conversion presets">
          <span class="wx-presets__tag" aria-hidden="true">⚡</span>
          <button type="button" class="btn-preset wx-chip" data-val="1" data-unit="kg">1 kg → lbs</button>
          <button type="button" class="btn-preset wx-chip" data-val="5" data-unit="kg">5 kg → lbs</button>
          <button type="button" class="btn-preset wx-chip" data-val="10" data-unit="kg">10 kg → lbs</button>
          <button type="button" class="btn-preset wx-chip" data-val="50" data-unit="kg">50 kg → lbs</button>
          <button type="button" class="btn-preset wx-chip" data-val="100" data-unit="kg">100 kg → lbs</button>
          <button type="button" class="btn-preset wx-chip" data-val="1" data-unit="lb">1 lb → kg</button>
          <button type="button" class="btn-preset wx-chip" data-val="10" data-unit="lb">10 lbs → kg</button>
          <button type="button" class="btn-preset wx-chip" data-val="50" data-unit="lb">50 lbs → kg</button>
          <button type="button" class="btn-preset wx-chip" data-val="100" data-unit="lb">100 lbs → kg</button>
          <button type="button" class="btn-preset wx-chip" data-val="1" data-unit="g">1 g → oz</button>
          <button type="button" class="btn-preset wx-chip" data-val="1" data-unit="stone">1 st → kg</button>
          <button type="button" class="btn-preset wx-chip" data-val="1" data-unit="troy_oz">1 oz t → g</button>
        </div>

        <p id="weight-error" class="hidden wx-error" role="alert" aria-live="polite"></p>

        <!-- Actions -->
        <div class="wx-actions">
          <button type="submit" id="btn-convert" class="wx-go">
            Convert <span aria-hidden="true">→</span>
          </button>
          <button type="button" id="btn-clear" class="wx-ghost">
            <span aria-hidden="true">✕</span> Clear
          </button>
          <button type="button" id="btn-copy-summary" class="wx-ghost">
            <span aria-hidden="true">📋</span> <span id="copy-summary-text">Copy Results</span>
          </button>
        </div>

      </form>
    </section>

    <!-- ================= FULL READOUT ================= -->
    <section class="wx-readout">
      <header class="wx-readout__bar">
        <h3 class="wx-readout__title"><span aria-hidden="true">📊</span> Full Readout &mdash; All 12 Mass Units</h3>
        <span class="wx-readout__stone">
          <span class="wx-readout__stone-cap">Stone &amp; lbs</span>
          <strong id="res-stone-compound">--</strong>
        </span>
      </header>

      <div class="wx-readout__grid">

        <div class="wx-row" data-unit-row="kg">
          <div class="wx-row__top">
            <span class="wx-row__sym">kg</span>
            <span class="wx-row__name">Kilograms</span>
            <span id="card-val-kg" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-kg" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="lb">
          <div class="wx-row__top">
            <span class="wx-row__sym">lbs</span>
            <span class="wx-row__name">Pounds</span>
            <span id="card-val-lb" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-lb" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="g">
          <div class="wx-row__top">
            <span class="wx-row__sym">g</span>
            <span class="wx-row__name">Grams</span>
            <span id="card-val-g" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-g" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="oz">
          <div class="wx-row__top">
            <span class="wx-row__sym">oz</span>
            <span class="wx-row__name">Ounces</span>
            <span id="card-val-oz" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-oz" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="stone">
          <div class="wx-row__top">
            <span class="wx-row__sym">st</span>
            <span class="wx-row__name">Stones</span>
            <span id="card-val-stone" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-stone" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="tonne">
          <div class="wx-row__top">
            <span class="wx-row__sym">t</span>
            <span class="wx-row__name">Metric Tonnes</span>
            <span id="card-val-tonne" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-tonne" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="mg">
          <div class="wx-row__top">
            <span class="wx-row__sym">mg</span>
            <span class="wx-row__name">Milligrams</span>
            <span id="card-val-mg" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-mg" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="mcg">
          <div class="wx-row__top">
            <span class="wx-row__sym">mcg</span>
            <span class="wx-row__name">Micrograms</span>
            <span id="card-val-mcg" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-mcg" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="us_ton">
          <div class="wx-row__top">
            <span class="wx-row__sym">tn</span>
            <span class="wx-row__name">US Short Tons</span>
            <span id="card-val-us_ton" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-us_ton" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="long_ton">
          <div class="wx-row__top">
            <span class="wx-row__sym">long tn</span>
            <span class="wx-row__name">Imperial Long Tons</span>
            <span id="card-val-long_ton" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-long_ton" class="wx-row__step">--</code>
        </div>

        <div class="wx-row" data-unit-row="quintal">
          <div class="wx-row__top">
            <span class="wx-row__sym">q</span>
            <span class="wx-row__name">Quintals</span>
            <span id="card-val-quintal" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-quintal" class="wx-row__step">--</code>
        </div>

        <div class="wx-row wx-row--bullion" data-unit-row="troy_oz">
          <div class="wx-row__top">
            <span class="wx-row__sym">oz t</span>
            <span class="wx-row__name">Troy Ounces</span>
            <span id="card-val-troy_oz" class="wx-row__val">--</span>
          </div>
          <code id="card-formula-troy_oz" class="wx-row__step">--</code>
        </div>

      </div>
    </section>

    <!-- DEDICATED SECTION 1: GOLD WEIGHT CONVERTER -->
    <div id="gold-converter-section" class="overflow-hidden rounded-3xl border border-amber-200/90 bg-linear-to-br from-amber-50/50 via-white to-amber-100/30 p-5 shadow-sm dark:border-amber-900/40 dark:from-slate-950 dark:via-slate-950 dark:to-amber-950/20 sm:p-7">
      <div class="border-b border-amber-200/80 pb-4 dark:border-amber-900/60">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
              <span>🪙</span> Gold & Precious Metals Weight Converter
            </h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Convert gold, silver, and precious bullion weights accurately between <strong>Troy Ounces (oz t)</strong>, <strong>Grams</strong>, <strong>Kilograms</strong>, and <strong>Tolas</strong>.
            </p>
          </div>
          <span class="rounded-full bg-amber-100 px-3 py-1 text-[11px] font-bold text-amber-900 dark:bg-amber-950 dark:text-amber-300">
            1 oz t = 31.1035 g
          </span>
        </div>
      </div>

      <!-- Gold Important Note Box -->
      <div class="mt-4 rounded-2xl border border-amber-300/80 bg-amber-50/90 p-3.5 text-xs text-amber-900 dark:border-amber-900/80 dark:bg-amber-950/40 dark:text-amber-200">
        <div class="flex items-start gap-2">
          <span class="text-base shrink-0">💡</span>
          <div>
            <strong>Troy Ounce vs Regular Ounce:</strong> Precious metals are measured strictly in <strong>Troy Ounces (31.1034768 g)</strong>, NOT standard avoirdupois ounces (28.3495231 g). A Troy Ounce is approximately <strong>9.7% heavier</strong> than a standard kitchen ounce.
          </div>
        </div>
      </div>

      <!-- Gold Converter Form -->
      <form id="gold-form" class="mt-4 space-y-4" novalidate onsubmit="return false;">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-12 items-end">
          
          <div class="sm:col-span-5">
            <label for="input-gold-val" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Gold Weight Value
            </label>
            <input
              type="number"
              id="input-gold-val"
              placeholder="e.g. 1"
              step="any"
              min="0"
              class="mt-1.5 w-full rounded-xl border-2 border-amber-300 bg-white px-3.5 py-2 text-sm font-bold text-slate-900 shadow-2xs focus:border-amber-600 focus:outline-hidden dark:border-amber-800 dark:bg-slate-900 dark:text-white"
            />
          </div>

          <div class="sm:col-span-4">
            <label for="select-gold-unit" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Precious Unit
            </label>
            <select
              id="select-gold-unit"
              class="mt-1.5 w-full rounded-xl border-2 border-amber-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-900 shadow-2xs focus:border-amber-600 focus:outline-hidden dark:border-amber-800 dark:bg-slate-900 dark:text-white cursor-pointer"
            >
              <option value="troy_oz" selected>Troy Ounces (oz t)</option>
              <option value="g">Grams (g)</option>
              <option value="kg">Kilograms (kg)</option>
              <option value="mg">Milligrams (mg)</option>
              <option value="tola">Tolas (Traditional 11.664 g)</option>
            </select>
          </div>

          <div class="sm:col-span-3 flex items-center gap-2">
            <button
              type="submit"
              id="btn-gold-convert"
              class="w-full inline-flex items-center justify-center gap-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 px-4 py-2 text-sm font-bold text-white shadow-sm transition active:scale-[0.98] cursor-pointer"
            >
              Convert Gold
            </button>
            <button
              type="button"
              id="btn-gold-clear"
              class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              ✕
            </button>
          </div>

        </div>

        <p id="gold-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

        <!-- Gold Results Grid (Hidden initially) -->
        <div id="gold-results-box" class="hidden pt-3 border-t border-amber-200/80 dark:border-amber-900/60">
          <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-5 text-xs">
            <div class="rounded-xl border border-amber-200 bg-white p-3 dark:border-amber-900/70 dark:bg-slate-900">
              <div class="text-amber-800 dark:text-amber-300 font-semibold">Troy Ounces (oz t)</div>
              <div id="gold-res-troy" class="mt-1 text-sm sm:text-base font-black text-slate-900 dark:text-white">--</div>
            </div>
            <div class="rounded-xl border border-amber-200 bg-white p-3 dark:border-amber-900/70 dark:bg-slate-900">
              <div class="text-amber-800 dark:text-amber-300 font-semibold">Grams (g)</div>
              <div id="gold-res-grams" class="mt-1 text-sm sm:text-base font-black text-amber-600 dark:text-amber-400">--</div>
            </div>
            <div class="rounded-xl border border-amber-200 bg-white p-3 dark:border-amber-900/70 dark:bg-slate-900">
              <div class="text-amber-800 dark:text-amber-300 font-semibold">Kilograms (kg)</div>
              <div id="gold-res-kg" class="mt-1 text-sm sm:text-base font-black text-slate-900 dark:text-white">--</div>
            </div>
            <div class="rounded-xl border border-amber-200 bg-white p-3 dark:border-amber-900/70 dark:bg-slate-900">
              <div class="text-amber-800 dark:text-amber-300 font-semibold">Milligrams (mg)</div>
              <div id="gold-res-mg" class="mt-1 text-sm sm:text-base font-black text-slate-900 dark:text-white">--</div>
            </div>
            <div class="rounded-xl border border-amber-200 bg-white p-3 dark:border-amber-900/70 dark:bg-slate-900 col-span-2 sm:col-span-1">
              <div class="text-amber-800 dark:text-amber-300 font-semibold">Tolas</div>
              <div id="gold-res-tola" class="mt-1 text-sm sm:text-base font-black text-slate-900 dark:text-white">--</div>
            </div>
          </div>
        </div>

      </form>
    </div>

  </div>

  <!-- EDUCATIONAL CONTENT SLOT -->
  <Fragment slot="content">
    <section class="weight-calculator-content">
      <h2>How Mass and Weight Conversion Operates in the Real World</h2>
      <p>
        You book an international flight and stare at a luggage scale calibrated in kilograms when your home scale reads pounds. You prepare a French pastry recipe measured in grams, or prepare an international freight manifest where ocean cargo requires metric tonnes while domestic freight bills use short tons.
      </p>
      <p>
        A reliable <strong>weight converter</strong> makes these unit shifts effortless. Whether you need a quick <strong>weight converter lbs to kg</strong> formula, a fast <strong>weight converter kg to lbs</strong> calculation, or need to assess shipping specifications for heavy mechanical freight, understanding how mass units translate prevents costly mistakes.
      </p>

      <h3>The Everyday Mathematics of Pounds and Kilograms</h3>
      <p>
        The relationship between pounds and kilograms is governed by the 1959 International Yard and Pound Agreement. That international treaty defined one international avoirdupois pound as exactly 0.45359237 kilograms.
      </p>
      <p>
        When converting <strong>kg to lbs</strong>, the formula multiplies your kilograms by 2.20462262:
      </p>
      <div class="my-4 rounded-2xl border border-slate-200 bg-slate-100/80 p-4 font-mono text-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="font-bold text-blue-600 dark:text-blue-400">Exact Conversion Equations:</div>
        <div class="mt-1">Pounds (lbs) = Kilograms (kg) × 2.20462262</div>
        <div class="mt-1">Kilograms (kg) = Pounds (lbs) × 0.45359237</div>
      </div>
      <p>
        For everyday mental math, double your kilogram number and add ten percent. For instance, if a person weighs 70 kg, doubling gives 140. Adding 10 percent (14) yields 154 lbs, which matches the exact mathematical calculation (154.32 lbs) within a fraction of a percent.
      </p>

      <h3>Common Weight Conversion Quick Reference</h3>
      <p>
        Use this conversion table to quickly look up equivalent mass values across kilograms, pounds, stones, and grams:
      </p>

      <div class="overflow-x-auto my-4">
        <table class="min-w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900">
              <th class="py-3 px-3 font-bold">Kilograms (kg)</th>
              <th class="py-3 px-3 font-bold">Pounds (lbs)</th>
              <th class="py-3 px-3 font-bold">Stones &amp; Pounds</th>
              <th class="py-3 px-3 font-bold">Grams (g)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <tr>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">1 kg</td>
              <td class="py-2.5 px-3">2.2046 lbs</td>
              <td class="py-2.5 px-3">0 st 2.20 lbs</td>
              <td class="py-2.5 px-3">1,000 g</td>
            </tr>
            <tr>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">5 kg</td>
              <td class="py-2.5 px-3">11.0231 lbs</td>
              <td class="py-2.5 px-3">0 st 11.02 lbs</td>
              <td class="py-2.5 px-3">5,000 g</td>
            </tr>
            <tr>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">10 kg</td>
              <td class="py-2.5 px-3">22.0462 lbs</td>
              <td class="py-2.5 px-3">1 st 8.05 lbs</td>
              <td class="py-2.5 px-3">10,000 g</td>
            </tr>
            <tr>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">20 kg</td>
              <td class="py-2.5 px-3">44.0925 lbs</td>
              <td class="py-2.5 px-3">3 st 2.09 lbs</td>
              <td class="py-2.5 px-3">20,000 g</td>
            </tr>
            <tr>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">50 kg</td>
              <td class="py-2.5 px-3">110.2311 lbs</td>
              <td class="py-2.5 px-3">7 st 12.23 lbs</td>
              <td class="py-2.5 px-3">50,000 g</td>
            </tr>
            <tr>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">70 kg</td>
              <td class="py-2.5 px-3">154.3236 lbs</td>
              <td class="py-2.5 px-3">11 st 0.32 lbs</td>
              <td class="py-2.5 px-3">70,000 g</td>
            </tr>
            <tr>
              <td class="py-2.5 px-3 font-bold text-blue-600 dark:text-blue-400">100 kg</td>
              <td class="py-2.5 px-3">220.4623 lbs</td>
              <td class="py-2.5 px-3">15 st 10.46 lbs</td>
              <td class="py-2.5 px-3">100,000 g</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3>Mass versus Weight: The Physics Behind the Scale</h3>
      <p>
        In everyday conversation, people use mass and weight interchangeably, but engineers and physicists draw a clear distinction.
      </p>
      <p>
        Mass represents the quantity of matter inside an object, measured in kilograms (kg) or grams (g). That quantity never changes, whether you measure it on a sea-level beach, on top of Mount Everest, or on the surface of the moon.
      </p>
      <p>
        Weight represents the force of gravity pulling on that mass. Scientifically, weight is a force measured in Newtons (N) via the formula: weight equals mass multiplied by gravitational acceleration (approximately 9.80665 meters per second squared on Earth). Because Earth exerts a relatively uniform gravitational field across populated elevations, everyday commercial scales measure downward force and display the calibrated mass reading in kilograms or pounds.
      </p>

      <h3>Bullion and Precious Metals: The Troy Weight Difference</h3>
      <p>
        If you purchase physical gold, silver, or platinum bullion, standard kitchen and postal scales can lead to expensive errors. Precious metals trade internationally under the Troy weight system rather than the standard avoirdupois system:
      </p>
      <ul class="my-3 space-y-1.5 list-disc pl-5">
        <li>1 Troy Ounce (oz t) equals exactly 31.1034768 grams.</li>
        <li>1 Standard Avoirdupois Ounce (oz) equals 28.349523125 grams.</li>
      </ul>
      <p>
        A Troy ounce contains approximately 9.7 percent more metal than an everyday ounce. If you weigh an ingot on a household postal scale showing 1.00 oz, you possess only 0.9115 Troy ounces of precious bullion. In Indian and South Asian gold bazaars, jewelers also quote prices in Tolas, where 1 standard metric Tola equals exactly 11.6638 grams (3/8 of a Troy ounce).
      </p>

      <h3>Automotive and Freight Converter Weights: Torque and Catalytic Converters</h3>
      <p>
        Mechanics, scrap metal recyclers, and shipping departments frequently search for <strong>converter weight</strong> figures when calculating freight parcel charges or evaluating scrap component salvage values. In the automotive industry, the term converter refers to two entirely different heavy assemblies:
      </p>
      
      <ol class="my-3 space-y-2 list-decimal pl-5">
        <li>
          <strong>Torque Converters:</strong> A fluid coupling device positioned between an automatic transmission and an internal combustion engine. Because a torque converter houses a heavy steel impeller, turbine, stator, and lockup clutch, its bare dry weight typically ranges between 25 and 45 pounds (11.3 to 20.4 kg). However, residual automatic transmission fluid (ATF) trapped inside internal chambers adds substantial weight. A drained unit that still holds fluid in its vanes can weigh 3 to 6 pounds more than its dry specification, raising shipping costs if you package it for core return.
        </li>
        <li>
          <strong>4L60E Torque Converters:</strong> Found in millions of General Motors trucks, SUVs, and rear-wheel-drive sedans, a stock GM 4L60E 300 mm torque converter weighs approximately 31 to 33 pounds (14 to 15 kg) when empty and dry. When filled with transmission fluid during active operation, total weight climbs to between 38 and 42 pounds (17.2 to 19 kg). Aftermarket high-stall performance converters for the 4L60E often drop in diameter to 245 mm or 258 mm, lowering dry weight to around 22 to 26 pounds.
        </li>
        <li>
          <strong>Catalytic Converters:</strong> An emissions control device installed in the exhaust system that converts harmful exhaust gases into less noxious compounds through catalytic precious metals (platinum, palladium, and rhodium). A standard passenger vehicle catalytic converter weighs between 8 and 20 pounds (3.6 to 9 kg). Heavy-duty commercial trucks and diesel particulate filter (DPF) units can weigh anywhere from 25 to 50 pounds (11.3 to 22.7 kg) due to thick stainless steel heat shielding and dense ceramic monolith honeycomb bricks.
        </li>
      </ol>

      <h3>Pairing Body Weight with Stature for Health Benchmarks</h3>
      <p>
        Mass measurements provide vital insight when paired with bodily stature. While weight alone cannot tell you whether your physique is balanced, combining your scale weight with your stature lets you calculate clinically recognized biometric indicators:
      </p>
      <ul class="my-3 space-y-1.5 list-disc pl-5">
        <li>Check your height in centimeters or feet with our <a href="/general/height-calculator/" class="font-medium text-blue-600 underline dark:text-blue-400">height converter</a>.</li>
        <li>Calculate your body mass index and healthy weight range using our <a href="/health/bmi-calculator/" class="font-medium text-blue-600 underline dark:text-blue-400">BMI calculator</a>.</li>
        <li>Estimate body composition and lean muscle mass with our <a href="/health/body-fat-calculator/" class="font-medium text-blue-600 underline dark:text-blue-400">body fat calculator</a>.</li>
        <li>Align your daily caloric intake for weight loss or muscle gain using our <a href="/health/calorie-calculator/" class="font-medium text-blue-600 underline dark:text-blue-400">calorie calculator</a> and target macronutrient breakdown with our <a href="/health/macro-calculator/" class="font-medium text-blue-600 underline dark:text-blue-400">macro calculator</a>.</li>
      </ul>

      <h3>Official Measurement Standards and Universal Conversions</h3>
      <p>
        All weight conversion constants on this platform follow dimensional standards established by the National Institute of Standards and Technology (<a href="https://www.nist.gov/pml/weights-and-measures" target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 underline dark:text-blue-400">NIST Weights and Measures</a>). For broader conversions covering velocity, temperature, volume, and land area, explore our universal <a href="/general/unit-converter/" class="font-medium text-blue-600 underline dark:text-blue-400">unit converter</a>.
      </p>
    </section>
