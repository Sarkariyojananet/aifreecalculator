<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
  // Conversion factors to 1 kg
  const TO_KG = {
    kg: 1,
    lb: 0.45359237,
    g: 0.001,
    oz: 0.028349523125,
    stone: 6.35029318,
    tonne: 1000,
    mg: 0.000001,
    mcg: 0.000000001,
    us_ton: 907.18474,
    long_ton: 1016.0469088,
    quintal: 100,
    troy_oz: 0.0311034768,
  };

  const UNIT_SYMBOLS = {
    kg: 'kg',
    lb: 'lbs',
    g: 'g',
    oz: 'oz',
    stone: 'st',
    tonne: 't',
    mg: 'mg',
    mcg: 'mcg',
    us_ton: 'tn',
    long_ton: 'long tn',
    quintal: 'q',
    troy_oz: 'oz t',
  };

  const UNIT_NAMES = {
    kg: 'Kilograms',
    lb: 'Pounds',
    g: 'Grams',
    oz: 'Ounces',
    stone: 'Stones',
    tonne: 'Metric Tonnes',
    mg: 'Milligrams',
    mcg: 'Micrograms',
    us_ton: 'US Short Tons',
    long_ton: 'Imperial Long Tons',
    quintal: 'Quintals',
    troy_oz: 'Troy Ounces',
  };

  const UNIT_DECIMALS = {
    kg: 3,
    lb: 3,
    g: 2,
    oz: 2,
    stone: 2,
    tonne: 4,
    mg: 0,
    mcg: 0,
    us_ton: 4,
    long_ton: 4,
    quintal: 3,
    troy_oz: 3,
  };

  // Unit order along the rail — ascending by magnitude
  const RAIL_ORDER = ['mcg', 'mg', 'g', 'oz', 'troy_oz', 'lb', 'kg', 'stone', 'quintal', 'us_ton', 'tonne', 'long_ton'];

  // Magnitude bands expressed in kilograms
  const MAGNITUDE_BANDS = [
    { max: 1e-6, label: 'Micro-scale (lab / pharmaceutical)' },
    { max: 1e-3, label: 'Milligram scale (dosage / assay)' },
    { max: 1, label: 'Gram scale (kitchen / bullion)' },
    { max: 100, label: 'Human & household scale' },
    { max: 1000, label: 'Pallet & small freight scale' },
    { max: Infinity, label: 'Vehicle & bulk freight scale' },
  ];

  // DOM Elements - Mass Exchange Terminal
  const inputWeightVal = document.getElementById('input-weight-val');
  const selectFromUnit = document.getElementById('select-from-unit');
  const selectToUnit = document.getElementById('select-to-unit');
  const btnSwapUnits = document.getElementById('btn-swap-units');
  const btnConvert = document.getElementById('btn-convert');
  const btnClear = document.getElementById('btn-clear');
  const weightError = document.getElementById('weight-error');

  // Terminal readouts
  const resPrimaryVal = document.getElementById('res-primary-val');
  const resPrimarySymbol = document.getElementById('res-primary-symbol');
  const resPrimaryFormula = document.getElementById('res-primary-formula');
  const resRateText = document.getElementById('res-rate-text');
  const resStoneCompound = document.getElementById('res-stone-compound');
  const btnCopySummary = document.getElementById('btn-copy-summary');
  const copySummaryText = document.getElementById('copy-summary-text');

  // Rail
  const railTrack = document.getElementById('wx-rail-track');
  const railRead = document.getElementById('wx-rail-read');

  // Format Helper
  function formatNum(num, decimals) {
    if (num === 0) return '0';
    if (isNaN(num) || !isFinite(num)) return '0';

    const abs = Math.abs(num);
    if (abs >= 1e12 || (abs > 0 && abs < 1e-6)) {
      return num.toExponential(4);
    }

    let effDec = decimals;
    if (abs >= 1000000) effDec = 0;
    else if (abs >= 1000) effDec = Math.min(2, decimals);
    else if (abs < 0.001) effDec = Math.max(4, decimals);

    const rounded = Number(num.toFixed(effDec));
    // Never print a non-zero mass as "0" — fall back to significant digits
    if (rounded === 0) return num.toPrecision(3);
    const parts = rounded.toString().split('.');
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return parts.join('.');
  }

  // Compact formatter for the narrow rail stops
  function formatRail(n) {
    if (!isFinite(n) || n === 0) return '0';
    const a = Math.abs(n);
    if (a >= 1e6 || a < 0.001) return n.toExponential(2);
    return formatNum(n, a >= 100 ? 1 : 3);
  }

  // Build the "× factor" or "÷ factor" step so the printed equation is always true
  function buildStep(val, fromUnit, toUnit, fromFactor, toFactor, formatted) {
    const fromSym = UNIT_SYMBOLS[fromUnit];
    const toSym = UNIT_SYMBOLS[toUnit];
    if (fromUnit === toUnit) {
      return `${formatNum(val, 3)} ${fromSym} = ${formatNum(val, 3)} ${toSym}`;
    }
    const ratio = fromFactor / toFactor;
    return ratio >= 1
      ? `${formatNum(val, 3)} ${fromSym} × ${ratio.toFixed(6).replace(/0+$/, '').replace(/\.$/, '')} = ${formatted} ${toSym}`
      : `${formatNum(val, 3)} ${fromSym} ÷ ${(1 / ratio).toFixed(6).replace(/0+$/, '').replace(/\.$/, '')} = ${formatted} ${toSym}`;
  }

  // Resolve the effective target unit ("auto" = popular pair)
  function resolveTarget(fromUnit, toUnitChoice) {
    if (toUnitChoice && toUnitChoice !== 'auto') return toUnitChoice;
    if (fromUnit === 'kg') return 'lb';
    if (fromUnit === 'lb') return 'kg';
    if (fromUnit === 'g') return 'oz';
    if (fromUnit === 'oz') return 'g';
    if (fromUnit === 'stone') return 'kg';
    if (fromUnit === 'troy_oz') return 'g';
    if (fromUnit === 'mcg' || fromUnit === 'mg') return 'g';
    return 'kg';
  }

  // Magnitude band label for a mass expressed in kg
  function magnitudeLabel(baseKg) {
    for (const band of MAGNITUDE_BANDS) {
      if (baseKg <= band.max) return band.label;
    }
    return MAGNITUDE_BANDS[MAGNITUDE_BANDS.length - 1].label;
  }

  // One-time rail scaffold (12 tappable stops)
  function buildRail() {
    if (!railTrack) return;
    railTrack.innerHTML = RAIL_ORDER.map(
      (key) => `
        <li class="wx-stop" data-rail-unit="${key}">
          <span class="wx-stop__u">${UNIT_SYMBOLS[key]}</span>
          <button type="button" class="wx-stop__v" data-rail-pick="${key}" aria-label="Set ${UNIT_NAMES[key]} as the target unit">
            <span data-rail-val="${key}">--</span>
          </button>
        </li>`
    ).join('');
  }

  // Reset the terminal to its dormant state
  function resetReadouts() {
    if (resPrimaryVal) resPrimaryVal.textContent = '--';
    if (resPrimarySymbol && selectFromUnit && selectToUnit) resPrimarySymbol.textContent = UNIT_SYMBOLS[resolveTarget(selectFromUnit.value, selectToUnit.value)] || '';
    if (resRateText && selectFromUnit) resRateText.textContent = `1 ${UNIT_SYMBOLS[selectFromUnit.value] || ''} = --`;
    if (resPrimaryFormula) resPrimaryFormula.textContent = '--';
    if (resStoneCompound) resStoneCompound.textContent = '--';

    Object.keys(TO_KG).forEach((key) => {
      const valEl = document.getElementById(`card-val-${key}`);
      const stepEl = document.getElementById(`card-formula-${key}`);
      if (valEl) valEl.textContent = '--';
      if (stepEl) stepEl.textContent = '--';
      const railVal = document.querySelector(`[data-rail-val="${key}"]`);
      if (railVal) railVal.textContent = '--';
    });

    document.querySelectorAll('.wx-row').forEach((row) => row.classList.remove('is-primary', 'is-source'));
    document.querySelectorAll('.wx-stop').forEach((stop) => stop.classList.remove('is-active', 'is-source'));
    if (railRead) railRead.textContent = 'Enter a value to populate every unit';
  }

  // Perform Main Weight Conversion (live + on submit)
  function executeWeightConversion() {
    if (!inputWeightVal || !selectFromUnit || !selectToUnit) return;
    const rawValStr = inputWeightVal.value.trim();

    if (!rawValStr) {
      hideWeightError();
      resetReadouts();
      return;
    }

    const val = parseFloat(rawValStr);
    if (isNaN(val)) {
      showWeightError('Please enter a valid numeric value.');
      return;
    }

    if (val < 0) {
      showWeightError('Weight cannot be negative. Please enter a positive value.');
      return;
    }

    hideWeightError();

    const fromUnit = selectFromUnit.value;
    const fromFactor = TO_KG[fromUnit] || 1;
    const baseKg = val * fromFactor;
    const primaryTarget = resolveTarget(fromUnit, selectToUnit.value);

    // Live rate for one source unit
    const targetFactor = TO_KG[primaryTarget];
    const primaryConverted = baseKg / targetFactor;
    const primaryFormatted = formatNum(primaryConverted, UNIT_DECIMALS[primaryTarget]);

    if (resRateText) resRateText.textContent = `1 ${UNIT_SYMBOLS[fromUnit]} = ${formatNum(targetFactor ? fromFactor / targetFactor : 0, 6)} ${UNIT_SYMBOLS[primaryTarget]}`;
    if (resPrimaryVal) resPrimaryVal.textContent = primaryFormatted;
    if (resPrimarySymbol) resPrimarySymbol.textContent = UNIT_SYMBOLS[primaryTarget];
    if (resPrimaryFormula) resPrimaryFormula.textContent = buildStep(val, fromUnit, primaryTarget, fromFactor, targetFactor, primaryFormatted);

    // Populate every readout row + rail stop
    let summaryText = `Weight Conversion for ${val} ${UNIT_SYMBOLS[fromUnit]}:\n`;

    Object.keys(TO_KG).forEach((key) => {
      const unitFactor = TO_KG[key];
      const rawConverted = baseKg / unitFactor;
      const formatted = formatNum(rawConverted, UNIT_DECIMALS[key]);

      const valEl = document.getElementById(`card-val-${key}`);
      const stepEl = document.getElementById(`card-formula-${key}`);
      const row = document.querySelector(`.wx-row[data-unit-row="${key}"]`);

      if (valEl) valEl.textContent = `${formatted} ${UNIT_SYMBOLS[key]}`;
      if (stepEl) {
        stepEl.textContent =
          key === fromUnit
            ? `Source unit — ${formatNum(val, 3)} ${UNIT_SYMBOLS[fromUnit]}`
            : buildStep(val, fromUnit, key, fromFactor, unitFactor, formatted);
      }
      if (row) {
        row.classList.toggle('is-primary', key === primaryTarget);
        row.classList.toggle('is-source', key === fromUnit);
      }

      const railVal = document.querySelector(`[data-rail-val="${key}"]`);
      if (railVal) railVal.textContent = formatRail(rawConverted);

      const stop = document.querySelector(`.wx-stop[data-rail-unit="${key}"]`);
      if (stop) {
        stop.classList.toggle('is-active', key === primaryTarget);
        stop.classList.toggle('is-source', key === fromUnit);
      }

      summaryText += `• ${UNIT_NAMES[key]}: ${formatted} ${UNIT_SYMBOLS[key]}\n`;
    });

    // Stone + Pounds compound breakdown
    const totalLbs = baseKg / TO_KG.lb;
    const stPart = Math.floor(totalLbs / 14);
    const lbsRemainder = Number((totalLbs % 14).toFixed(2));
    if (resStoneCompound) resStoneCompound.textContent = `${stPart} st ${lbsRemainder} lbs`;

    if (railRead) {
      railRead.textContent = `${formatNum(val, 3)} ${UNIT_SYMBOLS[fromUnit]} — ${magnitudeLabel(baseKg)}`;
    }

    if (btnCopySummary) btnCopySummary.dataset.summary = summaryText;
  }

  function showWeightError(msg) {
    if (!weightError) return;
    weightError.textContent = msg;
    weightError.classList.remove('hidden');
  }

  function hideWeightError() {
    if (!weightError) return;
    weightError.textContent = '';
    weightError.classList.add('hidden');
  }

  function clearWeightCalculator() {
    if (inputWeightVal) inputWeightVal.value = '';
    if (selectFromUnit) selectFromUnit.value = 'kg';
    if (selectToUnit) selectToUnit.value = 'auto';
    hideWeightError();
    resetReadouts();
    inputWeightVal?.focus();
  }

  buildRail();
  resetReadouts();

  // Event Listeners - Main Tool
  btnConvert?.addEventListener('click', (e) => {
    e.preventDefault();
    executeWeightConversion();
    inputWeightVal?.focus();
  });

  // Live conversion
  inputWeightVal?.addEventListener('input', executeWeightConversion);
  selectFromUnit?.addEventListener('change', executeWeightConversion);
  selectToUnit?.addEventListener('change', executeWeightConversion);

  inputWeightVal?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeWeightConversion();
    }
  });

  // Swap source and target units
  btnSwapUnits?.addEventListener('click', () => {
    if (!selectFromUnit || !selectToUnit) return;
    const from = selectFromUnit.value;
    const to = resolveTarget(from, selectToUnit.value);
    selectFromUnit.value = to;
    selectToUnit.value = from;
    if (!inputWeightVal?.value.trim()) {
      resetReadouts();
      return;
    }
    executeWeightConversion();
  });

  btnClear?.addEventListener('click', clearWeightCalculator);

  // Quick Preset Chips
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-val');
      const unit = btn.getAttribute('data-unit');
      if (inputWeightVal && val) inputWeightVal.value = val;
      if (selectFromUnit && unit) selectFromUnit.value = unit;
      if (selectToUnit) selectToUnit.value = 'auto';
      executeWeightConversion();
      inputWeightVal?.focus();
    });
  });

  // Rail stops set the target unit
  if (railTrack) {
    railTrack.addEventListener('click', (e) => {
      const pick = e.target.closest('[data-rail-pick]');
      if (!pick) return;
      const unit = pick.getAttribute('data-rail-pick');
      if (selectToUnit && unit) selectToUnit.value = unit;
      executeWeightConversion();
    });
  }

  // Copy Summary Handler
  btnCopySummary?.addEventListener('click', async () => {
    const text = btnCopySummary.dataset.summary || '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      if (copySummaryText) copySummaryText.textContent = 'Copied! ✓';
      setTimeout(() => {
        if (copySummaryText) copySummaryText.textContent = 'Copy Results';
      }, 2000);
    } catch (err) {
      console.error('Clipboard copy failed', err);
    }
  });


  // ==========================================
  // SUB-TOOL 1: GOLD WEIGHT CONVERTER
  // ==========================================
  const inputGoldVal = document.getElementById('input-gold-val');
  const selectGoldUnit = document.getElementById('select-gold-unit');
  const btnGoldConvert = document.getElementById('btn-gold-convert');
  const btnGoldClear = document.getElementById('btn-gold-clear');
  const goldError = document.getElementById('gold-error');
  const goldResultsBox = document.getElementById('gold-results-box');

  const goldResTroy = document.getElementById('gold-res-troy');
  const goldResGrams = document.getElementById('gold-res-grams');
  const goldResKg = document.getElementById('gold-res-kg');
  const goldResMg = document.getElementById('gold-res-mg');
  const goldResTola = document.getElementById('gold-res-tola');

  function executeGoldConversion() {
    if (!inputGoldVal || !selectGoldUnit) return;
    const rawValStr = inputGoldVal.value.trim();
    if (!rawValStr) {
      if (goldError) {
        goldError.textContent = 'Please enter a gold weight value.';
        goldError.classList.remove('hidden');
      }
      goldResultsBox?.classList.add('hidden');
      inputGoldVal.focus();
      return;
    }

    const val = parseFloat(rawValStr);
    if (isNaN(val) || val < 0) {
      if (goldError) {
        goldError.textContent = 'Please enter a valid positive weight.';
        goldError.classList.remove('hidden');
      }
      goldResultsBox?.classList.add('hidden');
      inputGoldVal.focus();
      return;
    }

    goldError?.classList.add('hidden');

    const unit = selectGoldUnit.value;
    let grams = 0;

    if (unit === 'g') grams = val;
    else if (unit === 'kg') grams = val * 1000;
    else if (unit === 'mg') grams = val / 1000;
    else if (unit === 'troy_oz') grams = val * 31.1034768;
    else if (unit === 'tola') grams = val * 11.6638038;

    const troyOz = grams / 31.1034768;
    const kg = grams / 1000;
    const mg = grams * 1000;
    const tola = grams / 11.6638038;

    if (goldResTroy) goldResTroy.textContent = `${formatNum(troyOz, 4)} oz t`;
    if (goldResGrams) goldResGrams.textContent = `${formatNum(grams, 3)} g`;
    if (goldResKg) goldResKg.textContent = `${formatNum(kg, 5)} kg`;
    if (goldResMg) goldResMg.textContent = `${formatNum(mg, 1)} mg`;
    if (goldResTola) goldResTola.textContent = `${formatNum(tola, 4)} tolas`;

    goldResultsBox?.classList.remove('hidden');
  }

  btnGoldConvert?.addEventListener('click', (e) => {
    e.preventDefault();
    executeGoldConversion();
  });

  inputGoldVal?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeGoldConversion();
    }
  });

  btnGoldClear?.addEventListener('click', () => {
    if (inputGoldVal) inputGoldVal.value = '';
    if (selectGoldUnit) selectGoldUnit.value = 'troy_oz';
    goldError?.classList.add('hidden');
    goldResultsBox?.classList.add('hidden');
  });

</script>
