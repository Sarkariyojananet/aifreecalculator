  // Western Zodiac
  function getWesternZodiac(m, d) {
    if ((m === 3 && d >= 21) || (m === 4 && d <= 19)) return { sign: 'Aries', symbol: '♈ Aries (Fire)' };
    if ((m === 4 && d >= 20) || (m === 5 && d <= 20)) return { sign: 'Taurus', symbol: '♉ Taurus (Earth)' };
    if ((m === 5 && d >= 21) || (m === 6 && d <= 20)) return { sign: 'Gemini', symbol: '♊ Gemini (Air)' };
    if ((m === 6 && d >= 21) || (m === 7 && d <= 22)) return { sign: 'Cancer', symbol: '♋ Cancer (Water)' };
    if ((m === 7 && d >= 23) || (m === 8 && d <= 22)) return { sign: 'Leo', symbol: '♌ Leo (Fire)' };
    if ((m === 8 && d >= 23) || (m === 9 && d <= 22)) return { sign: 'Virgo', symbol: '♍ Virgo (Earth)' };
    if ((m === 9 && d >= 23) || (m === 10 && d <= 22)) return { sign: 'Libra', symbol: '♎ Libra (Air)' };
    if ((m === 10 && d >= 23) || (m === 11 && d <= 21)) return { sign: 'Scorpio', symbol: '♏ Scorpio (Water)' };
    if ((m === 11 && d >= 22) || (m === 12 && d <= 21)) return { sign: 'Sagittarius', symbol: '♐ Sagittarius (Fire)' };
    if ((m === 12 && d >= 22) || (m === 1 && d <= 19)) return { sign: 'Capricorn', symbol: '♑ Capricorn (Earth)' };
    if ((m === 1 && d >= 20) || (m === 2 && d <= 18)) return { sign: 'Aquarius', symbol: '♒ Aquarius (Air)' };
    return { sign: 'Pisces', symbol: '♓ Pisces (Water)' };
  }

