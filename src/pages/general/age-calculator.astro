  // =========================================================================
  // TAB 2: AGE DIFFERENCE ENGINE
  // =========================================================================
  const ageDiffForm = document.getElementById('age-diff-form');
  const diffResultBox = document.getElementById('diff-result-box');
  const diffHeroText = document.getElementById('diff-hero-text');
  const diffResDays = document.getElementById('diff-res-days');
  const diffResWeeks = document.getElementById('diff-res-weeks');
  const diffResHours = document.getElementById('diff-res-hours');
  const diffDoubleAgeText = document.getElementById('diff-double-age-text');
  const btnDiffReset = document.getElementById('btn-diff-reset');

  function calculateAgeDifference() {
    const p1Name = document.getElementById('diff-p1-name').value || 'Person 1';
    const p2Name = document.getElementById('diff-p2-name').value || 'Person 2';
    const d1Str = diffP1Dob.value;
    const d2Str = diffP2Dob.value;

    if (!d1Str || !d2Str) return;

    const d1 = parseDateInput(d1Str);
    const d2 = parseDateInput(d2Str);

    let olderName = p1Name;
    let youngerName = p2Name;
    let olderDate = d1;
    let youngerDate = d2;

    if (d1 > d2) {
      olderName = p2Name;
      youngerName = p1Name;
      olderDate = d2;
      youngerDate = d1;
    } else if (d1.getTime() === d2.getTime()) {
      diffHeroText.textContent = `${p1Name} and ${p2Name} are born on the exact same date!`;
      diffResDays.textContent = '0';
      diffResWeeks.textContent = '0';
      diffResHours.textContent = '0';
      diffDoubleAgeText.textContent = 'Both persons were born on the same date, so there is no age difference.';
      diffResultBox.classList.remove('hidden');
      return;
    }

    let y = youngerDate.getFullYear() - olderDate.getFullYear();
    let m = youngerDate.getMonth() - olderDate.getMonth();
    let d = youngerDate.getDate() - olderDate.getDate();

    if (d < 0) {
      m--;
      const prevMonthDays = new Date(youngerDate.getFullYear(), youngerDate.getMonth(), 0).getDate();
      d += prevMonthDays;
    }
    if (m < 0) {
      y--;
      m += 12;
    }

    diffHeroText.textContent = `${olderName} is older than ${youngerName} by ${y} Years, ${m} Months, ${d} Days`;

    const diffMs = youngerDate.getTime() - olderDate.getTime();
    const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    diffResDays.textContent = totalDays.toLocaleString();
    diffResWeeks.textContent = Math.floor(totalDays / 7).toLocaleString();
    diffResHours.textContent = (totalDays * 24).toLocaleString();

    // Double Age Date: Date = youngerDate + diffMs
    const doubleAgeDateObj = new Date(youngerDate.getTime() + diffMs);
    const doubleAgeDateStr = doubleAgeDateObj.toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' });
    const isPast = doubleAgeDateObj < new Date();

    diffDoubleAgeText.textContent = `On ${doubleAgeDateStr}, ${olderName} ${isPast ? 'was' : 'will be'} exactly twice the age of ${youngerName}!`;
    diffResultBox.classList.remove('hidden');
  }

  ageDiffForm.addEventListener('submit', (e) => {
    e.preventDefault();
    calculateAgeDifference();
  });
  diffP1Dob.addEventListener('change', calculateAgeDifference);
  diffP2Dob.addEventListener('change', calculateAgeDifference);

  btnDiffReset.addEventListener('click', () => {
    ageDiffForm.reset();
    diffResultBox.classList.add('hidden');
