---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Age Calculator - Calculate Your Exact Age Online"
  description="Calculate your exact chronological age in years, months, and days for today or any selected date."
  category="General"
  calculatorName="Age Calculator"
  slug="age-calculator"
  keywords={['age calculator', 'age calculator online', 'calculate age', 'age calculator by date of birth', 'chronological age', 'birthday countdown']}
>
  <div class="space-y-6">
    <!-- Mode Tabs Navigation -->
    <div class="flex flex-wrap items-center gap-1.5 rounded-2xl border border-slate-200 bg-slate-100/80 p-1.5 dark:border-slate-800 dark:bg-slate-900/90 text-xs sm:text-sm font-bold" role="tablist" aria-label="Age Calculator Tools">
      <button
        type="button"
        role="tab"
        id="tab-btn-audit"
        aria-selected="true"
        aria-controls="panel-audit"
        data-tab="audit"
        class="tab-nav-btn active flex items-center gap-2 rounded-xl px-4 py-2.5 transition-all focus:outline-none"
      >
        <span>🎂</span>
        <span>Exact Age & Life Audit</span>
      </button>
      <button
        type="button"
        role="tab"
        id="tab-btn-diff"
        aria-selected="false"
        aria-controls="panel-diff"
        data-tab="diff"
        class="tab-nav-btn flex items-center gap-2 rounded-xl px-4 py-2.5 transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white focus:outline-none"
      >
        <span>👥</span>
        <span>Age Difference</span>
      </button>
      <button
        type="button"
        role="tab"
        id="tab-btn-exam"
        aria-selected="false"
        aria-controls="panel-exam"
        data-tab="exam"
        class="tab-nav-btn flex items-center gap-2 rounded-xl px-4 py-2.5 transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white focus:outline-none"
      >
        <span>🎓</span>
        <span>Exam & Job Eligibility</span>
      </button>
      <button
        type="button"
        role="tab"
        id="tab-btn-milestone"
        aria-selected="false"
        aria-controls="panel-milestone"
        data-tab="milestone"
        class="tab-nav-btn flex items-center gap-2 rounded-xl px-4 py-2.5 transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white focus:outline-none"
      >
        <span>⏳</span>
        <span>Milestones & DOB Finder</span>
      </button>
    </div>

    <!-- ========================================================================= -->
    <!-- PANEL 1: PRIMARY EXACT AGE & LIFE AUDIT -->
    <!-- ========================================================================= -->
    <div id="panel-audit" role="tabpanel" aria-labelledby="tab-btn-audit" class="space-y-6">
      <!-- Quick Preset Sample Bar -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="font-semibold text-slate-500 dark:text-slate-400">Quick Presets:</span>
        <button type="button" class="btn-preset rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-blue-400" data-preset-dob="2000-01-01">Born 2000 (Gen Z)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-blue-400" data-preset-dob="1995-08-15">Born 1995 (Millennial)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-blue-400" data-preset-dob="1980-06-20">Born 1980 (Gen X)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-medium text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-blue-400" data-preset-dob="2023-01-01">Toddler</button>
      </div>

      <form id="age-calculator-form" class="space-y-6" novalidate>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- Date of Birth Input Card -->
          <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/60">
            <div class="flex items-center justify-between">
              <label for="input-dob" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Date of Birth
              </label>
              <button type="button" id="btn-toggle-time" class="text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400">
                + Add Birth Time
              </button>
            </div>
            <input
              type="date"
              id="input-dob"
              required
              class="mt-2.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            />
            <!-- Collapsible Birth Time Input -->
            <div id="wrapper-birth-time" class="hidden mt-3 pt-3 border-t border-slate-100 dark:border-slate-800">
              <label for="input-dob-time" class="block text-xs font-medium text-slate-500 dark:text-slate-400">
                Exact Time of Birth (Optional)
              </label>
              <input
                type="time"
                id="input-dob-time"
                value="00:00"
                class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
              />
            </div>
          </div>

          <!-- Target Date Input Card -->
          <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs dark:border-slate-800 dark:bg-slate-900/60">
            <div class="flex items-center justify-between">
              <label for="input-target-date" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                Age as on Date
              </label>
              <button type="button" id="btn-set-today" class="text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400">
                Set to Today
              </button>
            </div>
            <input
              type="date"
              id="input-target-date"
              required
              class="mt-2.5 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
            />
            <div class="mt-2 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
              <span>Standard: Today's reference date</span>
              <button type="button" id="btn-next-new-year" class="hover:text-blue-600 dark:hover:text-blue-400">Next Jan 1</button>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap gap-2.5">
            <button type="submit" class="rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900">
              Calculate Age
            </button>
            <button type="button" id="clear-age-calculator" class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:focus:ring-offset-slate-900">
              Clear
            </button>
          </div>
          <div id="box-summary-actions" class="hidden">
            <div class="flex items-center gap-2">
              <button type="button" id="btn-copy-summary" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
                <span>📋</span> Copy Summary
              </button>
              <button type="button" id="btn-print-summary" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
                <span>🖨️</span> Print
              </button>
            </div>
          </div>
        </div>

        <p id="age-form-error" class="hidden text-sm font-semibold text-red-600 dark:text-red-400" role="alert"></p>

        <!-- ========================================================================= -->
        <!-- LIVE RESULT TERMINAL DASHBOARD -->
        <!-- ========================================================================= -->
        <div id="age-result" class="hidden space-y-5 rounded-2xl border border-slate-200/90 bg-slate-50/70 p-5 sm:p-6 dark:border-slate-800 dark:bg-slate-950/70" aria-live="polite">
          <!-- Main Hero Age Digital Card -->
          <div class="rounded-2xl border border-blue-200/60 bg-linear-to-br from-blue-50/90 via-white to-indigo-50/70 p-5 dark:border-blue-900/40 dark:from-blue-950/40 dark:via-slate-900 dark:to-indigo-950/30">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-blue-100 pb-3 dark:border-blue-900/40">
              <span id="res-age-label" class="text-xs font-bold uppercase tracking-wider text-blue-900 dark:text-blue-300">
                Current Exact Age
              </span>
              <div class="flex items-center gap-1.5">
                <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span id="res-live-clock" class="font-mono text-xs font-semibold text-slate-600 dark:text-slate-300">Age: 0.0000 yrs</span>
              </div>
            </div>

            <!-- 3 Digital Counter Blocks -->
            <div class="mt-4 grid grid-cols-3 gap-2.5 sm:gap-4 text-center">
              <div class="rounded-xl border border-blue-200/80 bg-white/90 p-3 shadow-xs dark:border-blue-900/50 dark:bg-slate-900/80">
                <div id="res-hero-years" class="font-mono text-2xl sm:text-4xl md:text-5xl font-black text-blue-600 dark:text-blue-400">0</div>
                <div class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">Years</div>
              </div>
              <div class="rounded-xl border border-blue-200/80 bg-white/90 p-3 shadow-xs dark:border-blue-900/50 dark:bg-slate-900/80">
                <div id="res-hero-months" class="font-mono text-2xl sm:text-4xl md:text-5xl font-black text-indigo-600 dark:text-indigo-400">0</div>
                <div class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">Months</div>
              </div>
              <div class="rounded-xl border border-blue-200/80 bg-white/90 p-3 shadow-xs dark:border-blue-900/50 dark:bg-slate-900/80">
                <div id="res-hero-days" class="font-mono text-2xl sm:text-4xl md:text-5xl font-black text-cyan-600 dark:text-cyan-400">0</div>
                <div class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">Days</div>
              </div>
            </div>

            <!-- Time Line (if active) -->
            <div id="res-time-ext" class="hidden mt-3 text-center font-mono text-xs font-semibold text-slate-600 dark:text-slate-300">
              Exact Time: <span id="res-hero-hours">0</span> Hours, <span id="res-hero-mins">0</span> Minutes
            </div>

            <!-- Legacy Screen Reader / String fallback -->
            <div id="res-main-age" class="sr-only">-- Years, -- Months, -- Days</div>

            <!-- Identity Badges Bar -->
            <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs font-medium text-slate-700 dark:text-slate-300">
              <span class="inline-flex items-center gap-1 rounded-lg bg-white/80 px-2.5 py-1 border border-slate-200/60 dark:bg-slate-900/80 dark:border-slate-800">
                <span>🗓️</span> Born on <strong id="res-born-day-name" class="font-bold">--</strong>
              </span>
              <span class="inline-flex items-center gap-1 rounded-lg bg-white/80 px-2.5 py-1 border border-slate-200/60 dark:bg-slate-900/80 dark:border-slate-800">
                <span>✨</span> <span id="res-zodiac-pill">--</span>
              </span>
              <span class="inline-flex items-center gap-1 rounded-lg bg-white/80 px-2.5 py-1 border border-slate-200/60 dark:bg-slate-900/80 dark:border-slate-800">
                <span id="res-chinese-emoji">🐉</span> <span id="res-chinese-pill">--</span>
              </span>
              <span class="inline-flex items-center gap-1 rounded-lg bg-white/80 px-2.5 py-1 border border-slate-200/60 dark:bg-slate-900/80 dark:border-slate-800">
                <span>👥</span> <strong id="res-generation-pill" class="font-bold">--</strong>
              </span>
            </div>
          </div>

          <!-- Birthday Celebration or Countdown Banner -->
          <div id="banner-birthday-today" class="hidden rounded-xl border border-amber-300 bg-amber-50 p-4 text-center text-amber-900 dark:border-amber-700 dark:bg-amber-950/50 dark:text-amber-200">
            <span class="text-2xl">🎉 🎂</span>
            <div class="text-base font-black">HAPPY BIRTHDAY!</div>
            <div class="text-xs font-medium">Wishing you health, happiness, and an extraordinary year ahead!</div>
          </div>

          <div id="banner-birthday-countdown" class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="text-xl">🎁</span>
                <div>
                  <div class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Next Birthday Countdown</div>
                  <div id="res-next-bday-detail" class="text-sm font-bold text-slate-900 dark:text-white">-- Days Remaining</div>
                </div>
              </div>
              <div class="text-xs text-right sm:text-right">
                <span id="res-next-bday" class="font-bold text-blue-600 dark:text-blue-400">-- days left</span>
                <div id="res-next-bday-day" class="text-slate-500 dark:text-slate-400">Turning -- yrs</div>
              </div>
            </div>
            <div class="mt-2.5 pt-2.5 border-t border-slate-100 text-xs flex flex-wrap items-center justify-between text-slate-600 dark:border-slate-800 dark:text-slate-400">
              <span>🌓 Half-Birthday: <strong id="res-half-bday" class="font-semibold text-slate-800 dark:text-slate-200">--</strong></span>
              <span id="res-weekend-alert" class="hidden text-emerald-600 dark:text-emerald-400 font-bold">🎉 Weekend Birthday!</span>
            </div>
          </div>

          <!-- Comprehensive Life Matrix (10 Equivalents) -->
          <div>
            <div class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400">
              Total Life Time Lived Equivalents
            </div>
            <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 md:grid-cols-4 text-xs font-mono">
              <div class="rounded-xl border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
                <div class="text-slate-500 font-sans dark:text-slate-400">Total Months</div>
                <div id="res-total-months" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">--</div>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
                <div class="text-slate-500 font-sans dark:text-slate-400">Total Weeks</div>
                <div id="res-total-weeks" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">--</div>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
                <div class="text-slate-500 font-sans dark:text-slate-400">Total Days</div>
                <div id="res-total-days" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">--</div>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
                <div class="text-slate-500 font-sans dark:text-slate-400">Total Hours</div>
                <div id="res-total-hours" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">--</div>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
                <div class="text-slate-500 font-sans dark:text-slate-400">Total Minutes</div>
                <div id="res-total-minutes" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">--</div>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
                <div class="text-slate-500 font-sans dark:text-slate-400">Total Seconds</div>
                <div id="res-total-seconds" class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white">--</div>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
                <div class="text-slate-500 font-sans dark:text-slate-400">Heartbeats (~75 bpm)</div>
                <div id="res-approx-heartbeats" class="mt-1 text-sm sm:text-base font-bold text-rose-600 dark:text-rose-400">--</div>
              </div>
              <div class="rounded-xl border border-slate-200/80 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
                <div class="text-slate-500 font-sans dark:text-slate-400">Breaths (~16 / min)</div>
                <div id="res-approx-breaths" class="mt-1 text-sm sm:text-base font-bold text-sky-600 dark:text-sky-400">--</div>
              </div>
            </div>
          </div>

          <!-- Life Journey Benchmark & Progress Bar -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-slate-700 dark:text-slate-300">Life Journey Progress (80-Year Average Lifespan)</span>
              <span id="res-life-pct" class="font-mono font-bold text-blue-600 dark:text-blue-400">0%</span>
            </div>
            <div class="mt-2 h-3 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
              <div id="res-life-progress-bar" class="h-full rounded-full bg-linear-to-r from-blue-500 via-indigo-500 to-purple-600 transition-all duration-500" style="width: 0%"></div>
            </div>
            <div class="mt-2 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
              <span>0 yrs (Birth)</span>
              <span>20 yrs (Youth)</span>
              <span>40 yrs (Midlife)</span>
              <span>60 yrs (Wisdom)</span>
              <span>80 yrs (Century Goal)</span>
            </div>
          </div>

          <!-- Next 5 Birthdays Roadmap -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-3">
              Upcoming Birthdays Day-of-Week Schedule
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead>
                  <tr class="border-b border-slate-200 text-slate-500 dark:border-slate-800 dark:text-slate-400">
                    <th class="pb-2 font-semibold">Birthday Year</th>
                    <th class="pb-2 font-semibold">Exact Date</th>
                    <th class="pb-2 font-semibold">Day of Week</th>
                    <th class="pb-2 font-semibold">Age</th>
                  </tr>
                </thead>
                <tbody id="res-bday-table-body" class="divide-y divide-slate-100 dark:divide-slate-800/60">
                  <!-- Injected via JavaScript -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- ========================================================================= -->
    <!-- PANEL 2: AGE DIFFERENCE & COMPARISON -->
    <!-- ========================================================================= -->
    <div id="panel-diff" role="tabpanel" aria-labelledby="tab-btn-diff" class="hidden space-y-6">
      <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900/60">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Compare Two People's Ages
        </h3>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Find the exact age difference between two individuals and discover the special "Double Age" milestone.
        </p>

        <form id="age-diff-form" class="mt-5 space-y-5" novalidate>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <!-- Person 1 -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-950/40">
              <label for="diff-p1-name" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Person 1 Name</label>
              <input type="text" id="diff-p1-name" value="Person 1" class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white" />

              <label for="diff-p1-dob" class="block mt-3 text-xs font-bold text-slate-700 dark:text-slate-300">Date of Birth</label>
              <input type="date" id="diff-p1-dob" required class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
            </div>

            <!-- Person 2 -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-950/40">
              <label for="diff-p2-name" class="block text-xs font-bold text-slate-700 dark:text-slate-300">Person 2 Name</label>
              <input type="text" id="diff-p2-name" value="Person 2" class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white" />

              <label for="diff-p2-dob" class="block mt-3 text-xs font-bold text-slate-700 dark:text-slate-300">Date of Birth</label>
