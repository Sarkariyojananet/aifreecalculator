  // TAB 3: EXAM & JOB ELIGIBILITY CHECKER
  // =========================================================================
  const examCheckerForm = document.getElementById('exam-checker-form');
  const examMinAge = document.getElementById('exam-min-age');
  const examMaxAge = document.getElementById('exam-max-age');
  const examCategoryRelax = document.getElementById('exam-category-relax');
  const examResultBox = document.getElementById('exam-result-box');
  const examStatusBadge = document.getElementById('exam-status-badge');
  const examAgeCutoffPill = document.getElementById('exam-age-cutoff-pill');
  const examStatusTitle = document.getElementById('exam-status-title');
  const examStatusDesc = document.getElementById('exam-status-desc');
  const examResEffMax = document.getElementById('exam-res-eff-max');
  const examResYearsLeft = document.getElementById('exam-res-years-left');

  function checkExamEligibility() {
    const dobStr = examInputDob.value;
    const cutoffStr = examInputCutoff.value;
    const minAge = Number(examMinAge.value) || 0;
    const baseMax = Number(examMaxAge.value) || 0;
    const relax = Number(examCategoryRelax.value) || 0;

    if (!dobStr || !cutoffStr) return;

    const birth = parseDateInput(dobStr);
    const cutoff = parseDateInput(cutoffStr);

    if (birth > cutoff) return;

    let y = cutoff.getFullYear() - birth.getFullYear();
    let m = cutoff.getMonth() - birth.getMonth();
    let d = cutoff.getDate() - birth.getDate();

    if (d < 0) {
      m--;
      const prevMonthDays = new Date(cutoff.getFullYear(), cutoff.getMonth(), 0).getDate();
      d += prevMonthDays;
    }
    if (m < 0) {
      y--;
      m += 12;
    }

    const effMax = baseMax + relax;
    examResEffMax.textContent = `${effMax} Years (${baseMax} + ${relax} relax)`;
    examAgeCutoffPill.textContent = `Age on Cutoff: ${y} yrs, ${m} mos, ${d} days`;

    examResultBox.classList.remove('border-emerald-300', 'bg-emerald-50/60', 'border-red-300', 'bg-red-50/60', 'border-amber-300', 'bg-amber-50/60');

    if (y < minAge) {
      // Underage
      examStatusBadge.className = 'rounded-full px-3 py-1 text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
      examStatusBadge.textContent = '❌ UNDERAGE';
      examResultBox.classList.add('border-amber-300', 'bg-amber-50/60', 'dark:border-amber-900', 'dark:bg-amber-950/40');
      examStatusTitle.textContent = `You are underage for this examination as of ${cutoff.toLocaleDateString()}.`;
      examStatusDesc.textContent = `Minimum required age is ${minAge} years. You need ${minAge - 1 - y} years and ${11 - m} months more.`;
      examResYearsLeft.textContent = '0 (Underage)';
    } else if (y > effMax || (y === effMax && (m > 0 || d > 0))) {
      // Overage
      examStatusBadge.className = 'rounded-full px-3 py-1 text-xs font-black uppercase tracking-wider bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300';
      examStatusBadge.textContent = '❌ OVERAGE';
      examResultBox.classList.add('border-red-300', 'bg-red-50/60', 'dark:border-red-900', 'dark:bg-red-950/40');
      examStatusTitle.textContent = `You have exceeded the maximum permissible age limit (${effMax} yrs).`;
      examStatusDesc.textContent = `Candidate age on cutoff date is ${y} yrs, ${m} mos (${y - effMax} years over the limit).`;
      examResYearsLeft.textContent = '0 (Exceeded)';
    } else {
      // Eligible
      examStatusBadge.className = 'rounded-full px-3 py-1 text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
      examStatusBadge.textContent = '✅ ELIGIBLE';
      examResultBox.classList.add('border-emerald-300', 'bg-emerald-50/60', 'dark:border-emerald-900', 'dark:bg-emerald-950/40');
      examStatusTitle.textContent = `Eligible: You satisfy the age criteria on ${cutoff.toLocaleDateString()}.`;
      const remainYears = effMax - 1 - y;
      const remainMonths = 11 - m;
      examStatusDesc.textContent = `You have approximately ${remainYears} years and ${remainMonths} months remaining before reaching the maximum age limit (${effMax} yrs).`;
      examResYearsLeft.textContent = `${effMax - y} years approx.`;
    }

    examResultBox.classList.remove('hidden');
  }

  examCheckerForm.addEventListener('submit', (e) => {
    e.preventDefault();
    checkExamEligibility();
  });
  examInputDob.addEventListener('change', checkExamEligibility);
  examInputCutoff.addEventListener('change', checkExamEligibility);
  examMinAge.addEventListener('input', checkExamEligibility);
  examMaxAge.addEventListener('input', checkExamEligibility);
  examCategoryRelax.addEventListener('change', checkExamEligibility);

  // Exam presets
  document.querySelectorAll('.btn-exam-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const min = btn.getAttribute('data-min');
      const max = btn.getAttribute('data-max');
      const cutoffSuffix = btn.getAttribute('data-cutoff');
      examMinAge.value = min;
      examMaxAge.value = max;
      examInputCutoff.value = `${new Date().getFullYear()}-${cutoffSuffix}`;
      if (examInputDob.value) checkExamEligibility();
    });
  });

  // =========================================================================
  // TAB 4: MILESTONES & REVERSE DOB FINDER
  // =========================================================================
  const btnCalcTurnDate = document.getElementById('btn-calc-turn-date');
  const turnResultCard = document.getElementById('turn-result-card');
  const turnResultDate = document.getElementById('turn-result-date');
  const turnTargetAge = document.getElementById('turn-target-age');

  btnCalcTurnDate.addEventListener('click', () => {
    const dobVal = turnDobInput.value || dobInput.value;
    if (!dobVal) return;
    const birth = parseDateInput(dobVal);
    const age = Number(turnTargetAge.value);
    const targetYear = birth.getFullYear() + age;
    const targetDate = new Date(targetYear, birth.getMonth(), birth.getDate());

    turnResultDate.textContent = targetDate.toLocaleDateString(undefined, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
    turnResultCard.classList.remove('hidden');
  });

  const btnCalcRevDob = document.getElementById('btn-calc-rev-dob');
  const revResultCard = document.getElementById('rev-result-card');
  const revResultDob = document.getElementById('rev-result-dob');
  const revAgeY = document.getElementById('rev-age-y');
  const revAgeM = document.getElementById('rev-age-m');
  const revAgeD = document.getElementById('rev-age-d');

  btnCalcRevDob.addEventListener('click', () => {
    const asOfStr = revAsOfDate.value;
    if (!asOfStr) return;
    const target = parseDateInput(asOfStr);
    const y = Number(revAgeY.value) || 0;
    const m = Number(revAgeM.value) || 0;
    const d = Number(revAgeD.value) || 0;

    let bYear = target.getFullYear() - y;
    let bMonth = target.getMonth() - m;
    let bDay = target.getDate() - d;

    if (bDay < 1) {
      bMonth--;
      const prevMonthDays = new Date(bYear, bMonth + 1, 0).getDate();
      bDay += prevMonthDays;
    }
    if (bMonth < 0) {
      bYear--;
      bMonth += 12;
    }

    const estDob = new Date(bYear, bMonth, bDay);
    revResultDob.textContent = estDob.toLocaleDateString(undefined, {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
    revResultCard.classList.remove('hidden');
  });

  // Auto-fill default DOB if available from query or prefill
  const urlParams = new URLSearchParams(window.location.search);
  const paramDob = urlParams.get('dob');
  if (paramDob) {
    dobInput.value = paramDob;
    updateAge();
  }
</script>
