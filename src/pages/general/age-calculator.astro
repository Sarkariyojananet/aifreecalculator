---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Age Calculator - Calculate Your Exact Age Online"
  description="Calculate your exact chronological age in years, months, and days for today or any selected date."
  category="General"
  calculatorName="Age Calculator"
  slug="age-calculator"
  keywords={['age calculator', 'age calculator online', 'calculate age', 'age calculator by date of birth', 'chronological age', 'birthday countdown']}
>
  <form id="age-calculator-form" class="space-y-6" novalidate>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <!-- Date of Birth Input -->
      <div>
        <label for="input-dob" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          Date of Birth
        </label>
        <input
          type="date"
          id="input-dob"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
      </div>

      <!-- Target / Current Date Input -->
      <div>
        <label for="input-target-date" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          Age as on Date
        </label>
        <input
          type="date"
          id="input-target-date"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <button type="submit" class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900">
        Calculate Age
      </button>
      <button type="button" id="clear-age-calculator" class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:focus:ring-offset-slate-900">
        Clear
      </button>
    </div>

    <p id="age-form-error" class="hidden text-sm font-semibold text-red-600 dark:text-red-400" role="alert"></p>

    <!-- Result is shown only after form submission. -->
    <div id="age-result" class="hidden rounded-2xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-800 dark:bg-slate-950" aria-live="polite">
      <div class="border-b border-slate-200/80 pb-4 dark:border-slate-800">
        <span id="res-age-label" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Current Exact Age</span>
        <div id="res-main-age" class="mt-1 text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400">
          -- Years, -- Months, -- Days
        </div>
      </div>

      <!-- Detailed Breakdown Grid -->
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 text-xs">
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="text-slate-500 dark:text-slate-400">Total Days</div>
          <div id="res-total-days" class="mt-1 text-base font-bold text-slate-900 dark:text-white">--</div>
        </div>
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="text-slate-500 dark:text-slate-400">Total Weeks</div>
          <div id="res-total-weeks" class="mt-1 text-base font-bold text-slate-900 dark:text-white">--</div>
        </div>
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="text-slate-500 dark:text-slate-400">Total Hours</div>
          <div id="res-total-hours" class="mt-1 text-base font-bold text-slate-900 dark:text-white">--</div>
        </div>
        <div class="rounded-xl border border-slate-200/60 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="text-slate-500 dark:text-slate-400">Day of Birth</div>
          <div id="res-day-born" class="mt-1 text-base font-bold text-slate-900 dark:text-white">--</div>
        </div>
      </div>

      <!-- Birthday Countdown -->
      <div class="mt-4 rounded-xl bg-blue-50/70 p-3.5 text-xs text-blue-900 dark:bg-blue-950/40 dark:text-blue-200 flex items-center justify-between">
        <span>🎉 Next Birthday Countdown:</span>
        <span id="res-next-bday" class="font-bold text-sm text-blue-700 dark:text-blue-300">-- days left</span>
      </div>
    </div>
  </form>

  <Fragment slot="content">
    <section class="age-calculator-content">
      <h2>Age Calculator - Calculate Your Exact Age Online</h2>
      <p>Our <strong>Age Calculator</strong> helps you calculate your exact age in years, months, and days. Enter your date of birth and select a date to find your chronological age quickly and accurately.</p>
      <p>Use it to calculate your current age, check your age on a future date, or find out how old you were on a specific date.</p>

    <h2>How Does the Age Calculator Work?</h2>
    <p>This <strong>age calculator by date of birth</strong> calculates the difference between your birth date and the selected reference date. By default, the reference date is today, so it can show your current exact age.</p>
    <p>You can also choose any past or future reference date to calculate your age on that date.</p>

    <h2>Chronological Age Calculator</h2>
    <p>A <strong>chronological age calculator</strong> measures the exact calendar time elapsed since a person's date of birth. Results are shown in years, months, and days, accounting for varying month lengths and leap years.</p>
    <p>Exact age is commonly needed for school admissions, job applications, examinations, government forms, and medical records.</p>

    <h2>Age Calculator by Date of Birth</h2>
    <p>Using the calculator is simple:</p>
    <ul>
      <li>Enter your date of birth.</li>
      <li>Select the date on which to calculate your age.</li>
      <li>View your exact age in years, months, and days.</li>
    </ul>

    <h2>Common Uses of an Age Calculator</h2>

    <h3>Age Calculator of India</h3>
    <p>This tool can help Indian users calculate their age for education, jobs, government services, examinations, and other official purposes. Always check the applicable rules and cutoff date where eligibility is involved.</p>

    <h3>Age Calculator for Children and Babies</h3>
    <p>Parents, schools, and guardians can use this calculator to find a child's exact age for admissions, classes, competitions, and other age-based requirements. For babies, the detailed total-day result can also be helpful.</p>

    <h3>Age Calculator for UPSC and Other Exams</h3>
    <p>Choose the relevant cutoff date to estimate your age for UPSC or another exam. Always verify the official eligibility requirements and cutoff date in the examination notification before applying.</p>

    <h2>Why Use an Online Age Calculator?</h2>
    <p>Manual age calculations can be confusing when months have different lengths or a leap year is involved. An online calculator makes the process faster and easier.</p>
    <ul>
      <li>Calculate exact age quickly.</li>
      <li>Find age in years, months, and days.</li>
      <li>Calculate age on a specific date.</li>
      <li>Check your current age today.</li>
      <li>Free and easy to use.</li>
    </ul>

      <h2>Calculate Your Age Now</h2>
      <p>Enter your date of birth, select a reference date, and use this free Age Calculator to find your exact age instantly.</p>
    </section>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-4 text-xs sm:text-sm">
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800" open>
        <summary class="cursor-pointer list-none">
          <h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">
          How do I calculate my age?
          <span class="group-open:rotate-180 transition-transform">▼</span>
          </h3>
        </summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">
          Enter your date of birth and select the date for which you want to calculate your age. The calculator shows your age in years, months, and days.
        </p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none">
          <h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">
          Can I calculate my age on a specific date?
          <span class="group-open:rotate-180 transition-transform">▼</span>
          </h3>
        </summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Yes. Select any past or future date in the Age as on Date field.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none">
          <h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">
          Does the calculator account for leap years?
          <span class="group-open:rotate-180 transition-transform">▼</span>
          </h3>
        </summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Yes. It uses the exact Gregorian calendar dates, including February 29 in leap years.</p>
      </details>
      <details class="group rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <summary class="cursor-pointer list-none">
          <h3 class="flex items-center justify-between font-bold text-slate-900 dark:text-white">
          Is the online age calculator free?
          <span class="group-open:rotate-180 transition-transform">▼</span>
          </h3>
        </summary>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Yes. You can use this online age calculator free of charge.</p>
      </details>
    </div>
  </Fragment>
</CalculatorLayout>

<style>
  .age-calculator-content h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.3;
    color: #0f172a;
  }

  .age-calculator-content h2:first-child {
    margin-top: 0;
  }

  .age-calculator-content h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.625rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: #1e293b;
  }

  .age-calculator-content p {
    margin: 0 0 1rem;
    line-height: 1.75;
    color: #475569;
  }

  .age-calculator-content ul {
    margin: 0.75rem 0 1.5rem;
    padding-left: 1.5rem;
    list-style: disc;
  }

  .age-calculator-content li + li {
    margin-top: 0.5rem;
  }

  :global(.dark) .age-calculator-content h2,
  :global(.dark) .age-calculator-content h3 {
    color: #f8fafc;
  }

  :global(.dark) .age-calculator-content p {
    color: #cbd5e1;
  }
</style>

<script is:inline>
  const ageCalculatorForm = document.getElementById('age-calculator-form');
  const dobInput = document.getElementById('input-dob');
  const targetDateInput = document.getElementById('input-target-date');
  const clearAgeCalculator = document.getElementById('clear-age-calculator');
  const ageResult = document.getElementById('age-result');
  const ageFormError = document.getElementById('age-form-error');
  const resMainAge = document.getElementById('res-main-age');
  const resAgeLabel = document.getElementById('res-age-label');
  const resTotalDays = document.getElementById('res-total-days');
  const resTotalWeeks = document.getElementById('res-total-weeks');
  const resTotalHours = document.getElementById('res-total-hours');
  const resDayBorn = document.getElementById('res-day-born');
  const resNextBday = document.getElementById('res-next-bday');

  // Keep date-only inputs in the visitor's local timezone.
  const toDateInputValue = (date) => {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  };
  const parseDateInput = (value) => {
    const [year, month, day] = value.split('-').map(Number);
    return new Date(year, month - 1, day);
  };
  const today = toDateInputValue(new Date());
  targetDateInput.value = today;

  function showError(message) {
    ageFormError.textContent = message;
    ageFormError.classList.remove('hidden');
    ageResult.classList.add('hidden');
  }

  function hideError() {
    ageFormError.textContent = '';
    ageFormError.classList.add('hidden');
  }

  function updateAge() {
    const dobVal = dobInput.value;
    const targetVal = targetDateInput.value;
    if (!dobVal || !targetVal) {
      showError('Please enter both your date of birth and the calculation date.');
      return;
    }

    const birth = parseDateInput(dobVal);
    const target = parseDateInput(targetVal);

    resAgeLabel.textContent = targetVal === today
      ? 'Current Exact Age'
      : `Exact Age on ${target.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' })}`;

    if (birth > target) {
      showError('The date of birth cannot be later than the calculation date.');
      return;
    }

    hideError();

    let y = target.getFullYear() - birth.getFullYear();
    let m = target.getMonth() - birth.getMonth();
    let d = target.getDate() - birth.getDate();

    if (d < 0) {
      m--;
      const prevMonthDays = new Date(target.getFullYear(), target.getMonth(), 0).getDate();
      d += prevMonthDays;
    }
    if (m < 0) {
      y--;
      m += 12;
    }

    resMainAge.textContent = `${y} Years, ${m} Months, ${d} Days`;

    const diffMs = target.getTime() - birth.getTime();
    const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    resTotalDays.textContent = totalDays.toLocaleString();
    resTotalWeeks.textContent = Math.floor(totalDays / 7).toLocaleString();
    resTotalHours.textContent = (totalDays * 24).toLocaleString();

    const daysOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    resDayBorn.textContent = daysOfWeek[birth.getDay()];

    const nextBday = new Date(target.getFullYear(), birth.getMonth(), birth.getDate());
    if (nextBday < target) nextBday.setFullYear(target.getFullYear() + 1);
    const daysLeft = Math.ceil((nextBday.getTime() - target.getTime()) / (1000 * 60 * 60 * 24));
    resNextBday.textContent = `${daysLeft} days remaining`;
    ageResult.classList.remove('hidden');
  }

  ageCalculatorForm.addEventListener('submit', (event) => {
    event.preventDefault();
    updateAge();
  });

  clearAgeCalculator.addEventListener('click', () => {
    ageCalculatorForm.reset();
    ageResult.classList.add('hidden');
    hideError();
    dobInput.focus();
  });
</script>
