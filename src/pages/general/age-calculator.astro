<script is:inline>
  // DOM Elements - Tabs
  const tabButtons = document.querySelectorAll('.tab-nav-btn');
  const tabPanels = {
    audit: document.getElementById('panel-audit'),
    diff: document.getElementById('panel-diff'),
    exam: document.getElementById('panel-exam'),
    milestone: document.getElementById('panel-milestone'),
  };

  // Tab switching logic
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');
      tabButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      Object.keys(tabPanels).forEach((key) => {
        if (key === targetTab) {
          tabPanels[key].classList.remove('hidden');
        } else {
          tabPanels[key].classList.add('hidden');
        }
      });
    });
  });

  // DOM Elements - Main Audit Form
  const ageForm = document.getElementById('age-calculator-form');
  const dobInput = document.getElementById('input-dob');
  const dobTimeInput = document.getElementById('input-dob-time');
  const targetDateInput = document.getElementById('input-target-date');
  const clearBtn = document.getElementById('clear-age-calculator');
  const ageResult = document.getElementById('age-result');
  const ageFormError = document.getElementById('age-form-error');
  const btnToggleTime = document.getElementById('btn-toggle-time');
  const wrapperBirthTime = document.getElementById('wrapper-birth-time');
  const btnSetToday = document.getElementById('btn-set-today');
  const btnNextNewYear = document.getElementById('btn-next-new-year');
  const btnCopySummary = document.getElementById('btn-copy-summary');
  const btnPrintSummary = document.getElementById('btn-print-summary');
