  function updateAge() {
    const dobVal = dobInput.value;
    const targetVal = targetDateInput.value;
    const hasTime = !wrapperBirthTime.classList.contains('hidden');
    const timeVal = hasTime ? dobTimeInput.value : '00:00';

    if (!dobVal || !targetVal) {
      showError('Please enter your date of birth and calculation date.');
      return;
    }

    const birth = parseDateInput(dobVal, timeVal);
    const target = parseDateInput(targetVal, '00:00');

    if (birth > target) {
      showError('The date of birth cannot be later than the calculation date.');
      return;
    }

    hideError();

    // Standard Calendar Subtraction
    let y = target.getFullYear() - birth.getFullYear();
    let m = target.getMonth() - birth.getMonth();
    let d = target.getDate() - birth.getDate();
    let h = target.getHours() - birth.getHours();
    let mins = target.getMinutes() - birth.getMinutes();

    if (mins < 0) {
      h--;
      mins += 60;
    }
    if (h < 0) {
      d--;
      h += 24;
    }
    if (d < 0) {
      m--;
      const prevMonthDays = new Date(target.getFullYear(), target.getMonth(), 0).getDate();
      d += prevMonthDays;
    }
    if (m < 0) {
      y--;
      m += 12;
    }

    // Populate Hero Digits
    resHeroYears.textContent = y;
    resHeroMonths.textContent = m;
    resHeroDays.textContent = d;
    resMainAge.textContent = `${y} Years, ${m} Months, ${d} Days`;

    if (hasTime) {
      resTimeExt.classList.remove('hidden');
      resHeroHours.textContent = h;
      resHeroMins.textContent = mins;
    } else {
      resTimeExt.classList.add('hidden');
    }

    resAgeLabel.textContent = targetVal === todayStr
      ? 'Current Exact Age'
      : `Exact Age on ${target.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' })}`;

    // Total Time Lived Equivalents
    const diffMs = target.getTime() - birth.getTime();
    const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    const totalWeeks = Math.floor(totalDays / 7);
    const totalHours = Math.floor(diffMs / (1000 * 60 * 60));
    const totalMinutes = Math.floor(diffMs / (1000 * 60));
    const totalSeconds = Math.floor(diffMs / 1000);
    const totalMonths = y * 12 + m;

    resTotalMonths.textContent = totalMonths.toLocaleString();
    resTotalWeeks.textContent = totalWeeks.toLocaleString();
    resTotalDays.textContent = totalDays.toLocaleString();
    resTotalHours.textContent = totalHours.toLocaleString();
    resTotalMinutes.textContent = totalMinutes.toLocaleString();
    resTotalSeconds.textContent = totalSeconds.toLocaleString();

    // Health Estimates
    resApproxHeartbeats.textContent = `~${Math.round(totalMinutes * 75).toLocaleString()}`;
    resApproxBreaths.textContent = `~${Math.round(totalMinutes * 16).toLocaleString()}`;

    // Life Progress Bar (Benchmark 80 years)
    const lifeProgress = Math.min(100, Number(((totalDays / (80 * 365.25)) * 100).toFixed(1)));
    resLifePct.textContent = `${lifeProgress}% Lived`;
    resLifeProgressBar.style.width = `${lifeProgress}%`;

    // Identity Badges
    const daysOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    resBornDayName.textContent = daysOfWeek[birth.getDay()];

    const zodiac = getWesternZodiac(birth.getMonth() + 1, birth.getDate());
    resZodiacPill.textContent = zodiac.symbol;

    const chineseZodiac = getChineseZodiac(birth.getFullYear());
    resChinesePill.textContent = `Year of the ${chineseZodiac.name}`;
    resChineseEmoji.textContent = chineseZodiac.emoji;

    resGenerationPill.textContent = getGeneration(birth.getFullYear());

    // Next Birthday Calculations
    const birthMonth = birth.getMonth();
    const birthDateNum = birth.getDate();
    let nextBdayYear = target.getFullYear();
    let nextBdayDate = new Date(nextBdayYear, birthMonth, birthDateNum);

    const isBdayToday =
      target.getFullYear() === nextBdayYear &&
      target.getMonth() === birthMonth &&
      target.getDate() === birthDateNum;

    if (isBdayToday) {
      bannerBirthdayToday.classList.remove('hidden');
      bannerBirthdayCountdown.classList.add('hidden');
    } else {
      bannerBirthdayToday.classList.add('hidden');
      bannerBirthdayCountdown.classList.remove('hidden');

      if (nextBdayDate < target) {
        nextBdayYear += 1;
        nextBdayDate = new Date(nextBdayYear, birthMonth, birthDateNum);
      }

      const daysLeft = Math.ceil((nextBdayDate.getTime() - target.getTime()) / (1000 * 60 * 60 * 24));
      resNextBday.textContent = `${daysLeft} days left`;
      resNextBdayDetail.textContent = `${daysLeft} Days (${nextBdayDate.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' })})`;
      const turningAge = nextBdayYear - birth.getFullYear();
      resNextBdayDay.textContent = `Turning ${turningAge} on a ${daysOfWeek[nextBdayDate.getDay()]}`;

      if (nextBdayDate.getDay() === 0 || nextBdayDate.getDay() === 6) {
        resWeekendAlert.classList.remove('hidden');
      } else {
        resWeekendAlert.classList.add('hidden');
      }
    }

    // Half Birthday
    const halfBdayMonth = (birthMonth + 6) % 12;
    const halfBdayYear = birthMonth + 6 >= 12 ? nextBdayYear : nextBdayYear - 1;
    const halfBday = new Date(halfBdayYear, halfBdayMonth, birthDateNum);
    resHalfBday.textContent = halfBday.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });

    // Upcoming 5 Birthdays Roadmap Table
    resBdayTableBody.innerHTML = '';
    const startRoadmapYear = isBdayToday ? target.getFullYear() + 1 : nextBdayYear;
    for (let i = 0; i < 5; i++) {
      const uYear = startRoadmapYear + i;
      const uDate = new Date(uYear, birthMonth, birthDateNum);
      const uDay = daysOfWeek[uDate.getDay()];
      const isWeekend = uDate.getDay() === 0 || uDate.getDay() === 6;
      const rowAge = uYear - birth.getFullYear();

      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-50 dark:hover:bg-slate-900/40';
      tr.innerHTML = `
        <td class="py-2.5 font-bold text-slate-900 dark:text-white">${uYear}</td>
        <td class="py-2.5 text-slate-700 dark:text-slate-300">${uDate.toLocaleDateString(undefined, { day: 'numeric', month: 'short' })}</td>
        <td class="py-2.5">
          <span class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 font-medium ${isWeekend ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 font-bold' : 'text-slate-700 dark:text-slate-300'}">
            ${isWeekend ? '🎉 ' : ''}${uDay}
          </span>
        </td>
        <td class="py-2.5 font-mono text-slate-600 dark:text-slate-400">${rowAge} yrs</td>
      `;
      resBdayTableBody.appendChild(tr);
    }

    // Start Live Clock Ticker
    if (liveTickerInterval) clearInterval(liveTickerInterval);
    const updateTicker = () => {
      const now = new Date();
      const liveDiff = now.getTime() - birth.getTime();
      const liveYears = (liveDiff / (1000 * 60 * 60 * 24 * 365.2425)).toFixed(6);
      resLiveClock.textContent = `Age: ${liveYears} yrs`;
    };
    updateTicker();
    if (targetVal === todayStr) {
      liveTickerInterval = setInterval(updateTicker, 100);
    }

    ageResult.classList.remove('hidden');
    boxSummaryActions?.classList.remove('hidden');
    btnCopySummary.classList.remove('hidden');
    btnPrintSummary.classList.remove('hidden');
  }

