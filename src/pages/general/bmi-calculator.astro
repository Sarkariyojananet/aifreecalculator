---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
---

<CalculatorLayout
  title="Free BMI Calculator: Check Body Mass Index & Healthy Weight Range"
  description="Calculate your BMI instantly with kg/cm, lbs/feet, or stones/meters. View WHO or Asian/Indian BMI categories, a healthy weight range, and practical body-composition estimates."
  category="General"
  calculatorName="BMI Calculator"
  slug="bmi-calculator"
  keywords={[
    "BMI Calculator",
    "bmi calculator women",
    "bmi calculator men",
    "bmi calculator female",
    "bmi calculator male",
    "bmi calculator kg with age",
    "bmi calculator women age",
    "bmi calculator for women",
    "bmi calculator online",
    "bmi calculator by age",
    "body mass index calculator",
    "ideal body weight for women",
    "ideal body weight for men",
    "body fat percentage calculator",
    "who bmi chart",
  ]}
>
  <div class="space-y-6">
    <!-- Calculator Card Container -->
    <div
      class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-emerald-50/60 p-1.5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-emerald-950/20"
    >
      <!-- Top Unit Tabs (US Units | Metric Units | Other Units) -->
      <div
        class="flex items-center gap-1 border-b border-slate-300/80 px-2 pt-1 pb-0 dark:border-slate-800"
      >
        <button
          type="button"
          id="tab-us"
          class="unit-tab active rounded-t-xl border-t border-x border-slate-300/90 bg-white px-4 py-2.5 text-xs sm:text-sm font-bold text-slate-900 shadow-2xs -mb-px dark:border-slate-700 dark:bg-slate-900 dark:text-white transition cursor-pointer"
        >
          US Units
        </button>
        <button
          type="button"
          id="tab-metric"
          class="unit-tab rounded-t-xl bg-blue-700/90 px-4 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer"
        >
          Metric Units
        </button>
        <button
          type="button"
          id="tab-other"
          class="unit-tab rounded-t-xl bg-blue-700/90 px-4 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer"
        >
          Other Units
        </button>
      </div>

      <!-- Main Inputs Form Box -->
      <form
        id="bmi-form"
        class="space-y-4 bg-white/45 p-4 sm:p-6 dark:bg-slate-950/40"
        novalidate
      >
        <!-- Standard Switcher (WHO vs Asian/Indian) -->
        <div
          class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200/80 pb-3 dark:border-slate-800/80 text-xs"
        >
          <span class="font-bold text-slate-600 dark:text-slate-400"
            >Classification Benchmark:</span
          >
          <select
            id="select-standard"
            class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-800 focus:border-blue-500 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 cursor-pointer"
          >
            <option value="who"
              >WHO Global Standard (Normal: 18.5 - 24.9)</option
            >
            <option value="asian"
              >Asian / Indian Standard (Normal: 18.5 - 22.9)</option
            >
          </select>
        </div>

        <!-- Row 1: Age Input -->
        <div
          class="grid grid-cols-1 sm:grid-cols-[100px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-age"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Age
          </label>
          <div class="flex items-center gap-3">
            <input
              type="number"
              id="input-age"
              value="25"
              min="20"
              max="120"
              required
              class="w-24 sm:w-28 rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white"
            />
            <span
              class="text-xs font-medium text-slate-600 dark:text-slate-400"
            >
              for adults ages 20 - 120
            </span>
          </div>
        </div>

        <!-- Row 2: Gender Radio Selection -->
        <div
          class="grid grid-cols-1 sm:grid-cols-[100px_1fr] items-center gap-2 sm:gap-4"
        >
          <span class="text-sm font-bold text-slate-900 dark:text-white">
            Gender
          </span>
          <div class="flex items-center gap-6">
            <label
              class="inline-flex items-center gap-2 text-sm font-semibold text-slate-800 dark:text-slate-200 cursor-pointer"
            >
              <input
                type="radio"
                name="gender"
                value="male"
                id="radio-gender-male"
                checked
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 cursor-pointer"
              />
              <span>Male</span>
            </label>
            <label
              class="inline-flex items-center gap-2 text-sm font-semibold text-slate-800 dark:text-slate-200 cursor-pointer"
            >
              <input
                type="radio"
                name="gender"
                value="female"
                id="radio-gender-female"
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 cursor-pointer"
              />
              <span>Female</span>
            </label>
          </div>
        </div>

        <!-- Row 3: Height Section (Conditional based on active tab) -->
        <!-- US Units Height (feet + inches) -->
        <div
          id="section-us-height"
          class="grid grid-cols-1 sm:grid-cols-[100px_1fr] items-center gap-2 sm:gap-4"
        >
          <label class="text-sm font-bold text-slate-900 dark:text-white">
            Height
          </label>
          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <div class="relative flex items-center">
              <input
                type="number"
                id="input-height-ft"
                min="3"
                max="8"
                value="5"
                class="w-24 sm:w-28 rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
              />
              <span
                class="pointer-events-none absolute right-2 text-xs text-slate-500 dark:text-slate-400"
                >feet</span
              >
            </div>
            <div class="relative flex items-center">
              <input
                type="number"
                id="input-height-in"
                min="0"
                max="11"
                value="10"
                class="w-24 sm:w-28 rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-12"
              />
              <span
                class="pointer-events-none absolute right-2 text-xs text-slate-500 dark:text-slate-400"
                >inches</span
              >
            </div>
          </div>
        </div>

        <!-- Metric Units Height (cm) -->
        <div
          id="section-metric-height"
          class="hidden grid grid-cols-1 sm:grid-cols-[100px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-height-cm"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Height
          </label>
          <div class="relative flex items-center w-36 sm:w-44">
            <input
              type="number"
              id="input-height-cm"
              min="90"
              max="230"
              value="175"
              class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
            />
            <span
              class="pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400"
              >cm</span
            >
          </div>
        </div>

        <!-- Other Units Height (meters) -->
        <div
          id="section-other-height"
          class="hidden grid grid-cols-1 sm:grid-cols-[100px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-height-m"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Height
          </label>
          <div class="relative flex items-center w-36 sm:w-44">
            <input
              type="number"
              id="input-height-m"
              min="0.9"
              max="2.3"
              step="0.01"
              value="1.75"
              class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-14"
            />
            <span
              class="pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400"
              >meters</span
            >
          </div>
        </div>

        <!-- Row 4: Weight Section (Conditional based on active tab) -->
        <!-- US Units Weight (pounds) -->
        <div
          id="section-us-weight"
          class="grid grid-cols-1 sm:grid-cols-[100px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-weight-lbs"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Weight
          </label>
          <div class="relative flex items-center w-36 sm:w-44">
            <input
              type="number"
              id="input-weight-lbs"
              min="66"
              max="500"
              value="160"
              class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-14"
            />
            <span
              class="pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400"
              >pounds</span
            >
          </div>
        </div>

        <!-- Metric Units Weight (kg) -->
        <div
          id="section-metric-weight"
          class="hidden grid grid-cols-1 sm:grid-cols-[100px_1fr] items-center gap-2 sm:gap-4"
        >
          <label
            for="input-weight-kg"
            class="text-sm font-bold text-slate-900 dark:text-white"
          >
            Weight
          </label>
          <div class="relative flex items-center w-36 sm:w-44">
            <input
              type="number"
              id="input-weight-kg"
              min="30"
              max="230"
              value="60"
              class="w-full rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
            />
            <span
              class="pointer-events-none absolute right-3 text-xs text-slate-500 dark:text-slate-400"
              >kg</span
            >
          </div>
        </div>

        <!-- Other Units Weight (stones + lbs) -->
        <div
          id="section-other-weight"
          class="hidden grid grid-cols-1 sm:grid-cols-[100px_1fr] items-center gap-2 sm:gap-4"
        >
          <label class="text-sm font-bold text-slate-900 dark:text-white">
            Weight
          </label>
          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <div class="relative flex items-center">
              <input
                type="number"
                id="input-weight-st"
                min="4"
                max="35"
                value="11"
                class="w-24 sm:w-28 rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-12"
              />
              <span
                class="pointer-events-none absolute right-2 text-xs text-slate-500 dark:text-slate-400"
                >stones</span
              >
            </div>
            <div class="relative flex items-center">
              <input
                type="number"
                id="input-weight-st-lbs"
                min="0"
                max="13"
                value="6"
                class="w-24 sm:w-28 rounded-lg border-2 border-slate-400/80 bg-white px-3 py-1.5 text-sm font-bold text-slate-900 shadow-2xs focus:border-blue-600 focus:outline-hidden dark:border-slate-700 dark:bg-slate-900 dark:text-white pr-10"
              />
              <span
                class="pointer-events-none absolute right-2 text-xs text-slate-500 dark:text-slate-400"
                >lbs</span
              >
            </div>
          </div>
        </div>

        <!-- Row 5: Action Buttons (Green Calculate ▶ and Gray Clear) -->
        <div class="flex flex-wrap items-center gap-3 pt-3">
          <button
            type="submit"
            id="btn-calculate"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-2.5 text-sm font-extrabold text-white shadow-lg shadow-emerald-600/20 transition hover:-translate-y-0.5 hover:bg-emerald-700 active:scale-[0.98] cursor-pointer"
          >
            <span>Calculate</span>
            <span
              class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-[10px]"
              >▶</span
            >
          </button>
          <button
            type="button"
            id="btn-clear"
            class="inline-flex items-center justify-center rounded-md bg-slate-400 hover:bg-slate-500 dark:bg-slate-600 dark:hover:bg-slate-500 px-5 py-2.5 text-sm font-bold text-white shadow-sm active:scale-[0.98] transition cursor-pointer"
          >
            Clear
          </button>
        </div>
        <p
          id="bmi-error"
          class="hidden rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300"
          role="alert"
          aria-live="polite"
        >
        </p>
      </form>
    </div>

    <!-- Initial Prompt Placeholder (Shown before Calculate is clicked) -->
    <div
      id="results-placeholder"
      class="rounded-2xl border border-dashed border-slate-300 bg-slate-50/60 p-8 text-center dark:border-slate-800 dark:bg-slate-950/40"
    >
      <div
        class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-xl text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"
      >
        ⚖️
      </div>
      <h3 class="mt-3 text-sm font-bold text-slate-900 dark:text-white">
        Ready to Calculate Your BMI
      </h3>
      <p
        class="mt-1 text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto"
      >
        Fill in your details above and click the green <strong
          >"Calculate ▶"</strong
        > button to view your BMI Speedometer Graph, healthy weight range, and gender
        breakdown.
      </p>
    </div>

    <!-- Calculation Results Card (Revealed on Submit) -->
    <div
      id="results-card"
      class="hidden rounded-2xl border border-slate-200 bg-slate-50/95 p-5 shadow-xs transition dark:border-slate-800 dark:bg-slate-950/90 sm:p-6 space-y-6"
    >
      <!-- Top Section: Main BMI Score & Classification -->
      <div
        class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-5 dark:border-slate-800"
      >
        <div>
          <div class="flex items-center gap-2">
            <span
              class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400"
            >
              Your Body Mass Index (BMI)
            </span>
            <span
              id="res-gender-tag"
              class="rounded-full bg-slate-200 px-2.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300"
            >
              Male (25 yrs)
            </span>
          </div>
          <div class="mt-1.5 flex flex-wrap items-baseline gap-3">
            <span
              id="res-bmi"
              class="text-4xl sm:text-5xl font-black tracking-tight text-emerald-600 dark:text-emerald-400"
            >
              22.9
            </span>
            <span
              id="res-badge"
              class="rounded-full bg-emerald-100 px-3.5 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300"
            >
              Normal Weight
            </span>
          </div>
        </div>

        <div
          class="flex sm:flex-col items-center sm:items-end justify-between gap-1 text-xs"
        >
          <div class="text-slate-500 dark:text-slate-400">
            BMI Prime: <span
              id="res-prime"
              class="font-bold text-slate-900 dark:text-white">0.91</span
            >
          </div>
          <div class="text-slate-500 dark:text-slate-400">
            Ponderal Index: <span
              id="res-ponderal"
              class="font-bold text-slate-900 dark:text-white">13.06 kg/m³</span
            >
          </div>
        </div>
      </div>

      <!-- RADIAL SPEEDOMETER GRAPH (Semi-Circular Arc with Pointer Needle) -->
      <div
        class="rounded-2xl border border-slate-200/90 bg-white p-4 sm:p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900"
      >
        <div
          class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800/80 mb-2"
        >
          <h4
            class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5"
          >
            <span>📈</span> BMI Visual Speedometer Gauge
          </h4>
          <span
            id="gauge-standard-label"
            class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-semibold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300"
          >
            WHO Global Standard
          </span>
        </div>

        <!-- SVG Radial Gauge Container -->
        <div
          class="relative mx-auto flex max-w-md items-center justify-center pt-2"
        >
          <svg
            id="bmi-gauge-svg"
            viewBox="0 0 420 235"
            class="w-full h-auto max-h-64 overflow-visible select-none drop-shadow-xs"
          >
            <!-- SVG Defs for Gradients & Glows -->
            <defs>
              <filter
                id="needle-shadow"
                x="-20%"
                y="-20%"
                width="140%"
                height="140%"
              >
                <feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity="0.3"
                ></feDropShadow>
              </filter>
            </defs>

            <!-- Arc Category Segments (Rendered dynamically by Script) -->
            <g id="gauge-segments-group"></g>

            <!-- Arc Divider Numbers & Text Labels (Rendered dynamically) -->
            <g id="gauge-labels-group"></g>

            <!-- Center Digital BMI Display -->
            <text
              id="gauge-center-bmi"
              x="210"
              y="180"
              text-anchor="middle"
              class="text-3xl sm:text-4xl font-black fill-slate-900 dark:fill-white transition-all duration-300"
              font-weight="900"
            >
              BMI = 22.9
            </text>

            <!-- Gauge Needle Group (Rotates around Pivot Center: 210, 205) -->
            <g
              id="gauge-needle-group"
              style="transform-origin: 210px 205px; transform: rotate(-20deg); transition: transform 0.8s cubic-bezier(0.34, 1.3, 0.64, 1);"
              filter="url(#needle-shadow)"
            >
              <!-- Needle Shaft Line -->
              <line
                x1="210"
                y1="205"
                x2="210"
                y2="76"
                stroke="#334155"
                stroke-width="4.5"
                stroke-linecap="round"
                class="dark:stroke-slate-200"></line>
              <!-- Needle Arrowhead Triangle -->
              <polygon
                points="210,58 202,78 218,78"
                fill="#1e293b"
                class="dark:fill-white"></polygon>
              <!-- Pivot Center Circle Core -->
              <circle
                cx="210"
                cy="205"
                r="10"
                fill="#475569"
                stroke="#1e293b"
                stroke-width="2.5"
                class="dark:fill-slate-700 dark:stroke-slate-300"></circle>
              <circle cx="210" cy="205" r="4" fill="#ffffff"></circle>
            </g>
          </svg>
        </div>

        <!-- Gauge Legend Bar -->
        <div
          class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4 text-center text-[11px] font-semibold"
        >
          <div
            class="flex items-center justify-center gap-1.5 rounded-lg bg-blue-50 py-1.5 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-blue-500"></span> Underweight
            (&lt;18.5)
          </div>
          <div
            class="flex items-center justify-center gap-1.5 rounded-lg bg-emerald-50 py-1.5 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span> Normal (18.5–24.9)
          </div>
          <div
            class="flex items-center justify-center gap-1.5 rounded-lg bg-amber-50 py-1.5 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span> Overweight
            (25–29.9)
          </div>
          <div
            class="flex items-center justify-center gap-1.5 rounded-lg bg-red-50 py-1.5 text-red-700 dark:bg-red-950/40 dark:text-red-300"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-red-600"></span> Obese (≥30.0)
          </div>
        </div>
      </div>

      <!-- Gender-Specific Health Breakdown Grid -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 text-xs">
        <!-- Healthy Weight Range -->
        <div
          class="rounded-xl border border-slate-200/80 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="text-slate-500 dark:text-slate-400 flex items-center gap-1 font-semibold"
          >
            <span>⚖️</span> Healthy Weight Range
          </div>
          <div
            id="res-healthy-range"
            class="mt-1.5 font-bold text-slate-900 dark:text-white"
          >
            58.4 kg - 78.6 kg
          </div>
          <div id="res-healthy-range-lbs" class="text-[10px] text-slate-400">
            (128.8 - 173.3 lbs)
          </div>
        </div>

        <!-- Target Weight Difference -->
        <div
          class="rounded-xl border border-slate-200/80 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="text-slate-500 dark:text-slate-400 flex items-center gap-1 font-semibold"
          >
            <span>🎯</span> Weight Goal
          </div>
          <div
            id="res-diff"
            class="mt-1.5 font-bold text-emerald-600 dark:text-emerald-400"
          >
            Ideal Range 👍
          </div>
          <div id="res-diff-sub" class="text-[10px] text-slate-400">
            Maintain your healthy lifestyle
          </div>
        </div>

        <!-- Estimated Body Fat % (Gender & Age Adjusted) -->
        <div
          class="rounded-xl border border-slate-200/80 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="text-slate-500 dark:text-slate-400 flex items-center gap-1 font-semibold"
          >
            <span>🔥</span> Est. Body Fat %
          </div>
          <div
            id="res-body-fat"
