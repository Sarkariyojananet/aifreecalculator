  // Conversion Helpers
  function cmToFtIn(cm) {
    const totalInches = cm / 2.54;
    let ft = Math.floor(totalInches / 12);
    let inch = Math.round(totalInches % 12);
    if (inch === 12) {
      ft += 1;
      inch = 0;
    }
    return { ft, inch };
  }

  function ftInToCm(ft, inch) {
    return (ft * 12 + inch) * 2.54;
  }

  function kgToLbs(kg) {
    return kg * 2.20462;
  }

  function lbsToKg(lbs) {
    return lbs / 2.20462;
  }

  function showValidationError(message) {
    bmiError.textContent = message;
    bmiError.classList.remove("hidden");
  }

  function clearValidationError() {
    bmiError.textContent = "";
    bmiError.classList.add("hidden");
  }

  function readValidNumber(input, label, min, max) {
    const value = Number(input.value);
    if (!Number.isFinite(value) || value < min || value > max) {
      throw new Error(`Enter a valid ${label} between ${min} and ${max}.`);
    }
    return value;
  }

  // Deurenberg Body Fat Formula
  function getBodyFat(bmi, age, gender) {
    const isMale = gender === "male" ? 1 : 0;
    let bf = 0;
    if (age < 18) {
      bf = 1.51 * bmi - 0.7 * age - 3.6 * isMale + 1.4;
    } else {
      bf = 1.2 * bmi + 0.23 * age - 10.8 * isMale - 5.4;
    }
    return Math.max(3, Math.min(60, parseFloat(bf.toFixed(1))));
  }

  // Devine Ideal Body Weight Formula
  function getIdealBodyWeightKg(heightCm, gender) {
    const heightInches = heightCm / 2.54;
    const inchesOver5Ft = Math.max(0, heightInches - 60);
    const base = gender === "female" ? 45.5 : 50.0;
    return parseFloat((base + 2.3 * inchesOver5Ft).toFixed(1));
  }

  // Mifflin-St Jeor Basal Metabolic Rate Formula
  function getBmrCalories(weightKg, heightCm, age, gender) {
    if (gender === "male") {
      return Math.round(10 * weightKg + 6.25 * heightCm - 5 * age + 5);
    } else {
      return Math.round(10 * weightKg + 6.25 * heightCm - 5 * age - 161);
    }
  }

  // Polar Coordinate Math for Gauge Geometry
  function polarToCartesian(cx, cy, r, angleDeg) {
    const angleRad = ((180 - angleDeg) * Math.PI) / 180;
    return {
      x: cx + r * Math.cos(angleRad),
      y: cy - r * Math.sin(angleRad),
    };
  }

  function describeArcSegment(cx, cy, rInside, rOutside, startAngle, endAngle) {
    const p1 = polarToCartesian(cx, cy, rOutside, startAngle);
    const p2 = polarToCartesian(cx, cy, rOutside, endAngle);
    const p3 = polarToCartesian(cx, cy, rInside, endAngle);
    const p4 = polarToCartesian(cx, cy, rInside, startAngle);
    const largeArc = endAngle - startAngle > 180 ? 1 : 0;

    return [
      `M ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}`,
      `A ${rOutside} ${rOutside} 0 ${largeArc} 1 ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`,
      `L ${p3.x.toFixed(1)} ${p3.y.toFixed(1)}`,
      `A ${rInside} ${rInside} 0 ${largeArc} 0 ${p4.x.toFixed(1)} ${p4.y.toFixed(1)}`,
      "Z",
    ].join(" ");
  }

  // Map BMI Score to Gauge Angle (0 deg = Left / Min, 180 deg = Right / Max)
  function getBmiGaugeAngle(bmi, standard = "who") {
    if (standard === "who") {
      if (bmi <= 15) return 2;
      if (bmi <= 16) return 2 + ((bmi - 15) / 1) * 9;
      if (bmi <= 17) return 11 + ((bmi - 16) / 1) * 12;
      if (bmi <= 18.5) return 23 + ((bmi - 17) / 1.5) * 17;
      if (bmi <= 25.0) return 40 + ((bmi - 18.5) / 6.5) * 50; // Normal: 18.5 - 25
      if (bmi <= 30.0) return 90 + ((bmi - 25.0) / 5.0) * 36; // Overweight: 25 - 30
      if (bmi <= 35.0) return 126 + ((bmi - 30.0) / 5.0) * 26; // Obese I: 30 - 35
      if (bmi <= 40.0) return 152 + ((bmi - 35.0) / 5.0) * 20; // Obese II: 35 - 40
      return Math.min(178, 172 + ((bmi - 40.0) / 5.0) * 6);
    } else {
      // Asian / Indian Standard
      if (bmi <= 15) return 2;
      if (bmi <= 16) return 2 + ((bmi - 15) / 1) * 9;
      if (bmi <= 17) return 11 + ((bmi - 16) / 1) * 12;
      if (bmi <= 18.5) return 23 + ((bmi - 17) / 1.5) * 17;
      if (bmi <= 23.0) return 40 + ((bmi - 18.5) / 4.5) * 45; // Normal: 18.5 - 23.0
      if (bmi <= 25.0) return 85 + ((bmi - 23.0) / 2.0) * 30; // Overweight: 23 - 25
      if (bmi <= 30.0) return 115 + ((bmi - 25.0) / 5.0) * 35; // Obese I
      if (bmi <= 35.0) return 150 + ((bmi - 30.0) / 5.0) * 20;
      return Math.min(178, 170 + ((bmi - 35.0) / 5.0) * 8);
    }
  }

  // Draw & Render the Speedometer Gauge Segments & Labels
  function renderGauge(standard = "who") {
    let segments = [];
    let ticks = [];
    let categoryLabels = [];

    if (standard === "who") {
      segments = [
        { start: 0, end: 11, color: "#b91c1c" }, // Severe Thinness (< 16)
        { start: 11, end: 23, color: "#d97706" }, // Moderate Thinness (16-17)
        { start: 23, end: 40, color: "#eab308" }, // Mild Thinness (17-18.5)
        { start: 40, end: 90, color: "#16a34a" }, // Normal (18.5-25)
        { start: 90, end: 126, color: "#facc15" }, // Overweight (25-30)
        { start: 126, end: 152, color: "#fb7185" }, // Obese I (30-35)
        { start: 152, end: 172, color: "#dc2626" }, // Obese II (35-40)
        { start: 172, end: 180, color: "#7f1d1d" }, // Obese III (40+)
      ];

      ticks = [
        { angle: 11, text: "16" },
        { angle: 23, text: "17" },
        { angle: 40, text: "18.5" },
        { angle: 90, text: "25" },
        { angle: 126, text: "30" },
        { angle: 152, text: "35" },
        { angle: 172, text: "40" },
      ];

      categoryLabels = [
        { angle: 20, text: "Underweight", rOffset: 20 },
        { angle: 65, text: "Normal", rOffset: 16 },
        { angle: 108, text: "Overweight", rOffset: 18 },
        { angle: 155, text: "Obesity", rOffset: 16 },
      ];
    } else {
      // Asian / Indian criteria
      segments = [
        { start: 0, end: 11, color: "#b91c1c" },
        { start: 11, end: 23, color: "#d97706" },
        { start: 23, end: 40, color: "#eab308" },
        { start: 40, end: 85, color: "#16a34a" }, // Normal (18.5 - 23.0)
        { start: 85, end: 115, color: "#facc15" }, // Overweight (23.0 - 25.0)
        { start: 115, end: 150, color: "#fb7185" }, // Obese I (25.0 - 30.0)
        { start: 150, end: 170, color: "#dc2626" }, // Obese II (30.0 - 35.0)
        { start: 170, end: 180, color: "#7f1d1d" }, // Obese III (35.0+)
      ];

      ticks = [
        { angle: 11, text: "16" },
        { angle: 23, text: "17" },
        { angle: 40, text: "18.5" },
        { angle: 85, text: "23" },
        { angle: 115, text: "25" },
        { angle: 150, text: "30" },
        { angle: 170, text: "35" },
      ];

      categoryLabels = [
        { angle: 20, text: "Underweight", rOffset: 20 },
        { angle: 62, text: "Normal", rOffset: 16 },
        { angle: 100, text: "Overweight", rOffset: 18 },
        { angle: 148, text: "Obesity", rOffset: 16 },
      ];
    }

    // Render Segment Paths
    let segmentPathsHtml = "";
    segments.forEach((seg) => {
      const d = describeArcSegment(CX, CY, R_IN, R_OUT, seg.start, seg.end);
      segmentPathsHtml += `<path d="${d}" fill="${seg.color}" stroke="#ffffff" stroke-width="1.2" />`;
    });
    gaugeSegmentsGroup.innerHTML = segmentPathsHtml;

    // Render Divider Tick Lines, Numbers, and Category Headings
    let labelsHtml = "";

    categoryLabels.forEach((lbl) => {
      const pos = polarToCartesian(CX, CY, R_OUT + lbl.rOffset, lbl.angle);
      labelsHtml += `
        <text
          x="${pos.x.toFixed(1)}"
          y="${pos.y.toFixed(1)}"
          text-anchor="middle"
          class="fill-slate-800 dark:fill-slate-100 font-extrabold text-[12px] sm:text-[13px] tracking-tight italic"
        >${lbl.text}</text>
      `;
    });

    ticks.forEach((t) => {
      const innerPt = polarToCartesian(CX, CY, R_IN, t.angle);
      const outerPt = polarToCartesian(CX, CY, R_OUT, t.angle);
      const numPt = polarToCartesian(CX, CY, (R_IN + R_OUT) / 2, t.angle);

      labelsHtml += `
        <line
          x1="${innerPt.x.toFixed(1)}"
          y1="${innerPt.y.toFixed(1)}"
          x2="${outerPt.x.toFixed(1)}"
          y2="${outerPt.y.toFixed(1)}"
          stroke="#ffffff"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      `;

      labelsHtml += `
        <text
          x="${numPt.x.toFixed(1)}"
          y="${numPt.y.toFixed(1)}"
          text-anchor="middle"
          dominant-baseline="central"
          fill="#ffffff"
          class="font-black text-[10px] sm:text-[11px] drop-shadow-xs"
        >${t.text}</text>
      `;
    });

    gaugeLabelsGroup.innerHTML = labelsHtml;
  }

  // Tab Switcher Styling & Section Visibility
  function setUnitTab(tab) {
    currentUnit = tab;

    // Reset tab buttons style
    [tabUs, tabMetric, tabOther].forEach((btn) => {
      btn.className =
        "unit-tab rounded-t-xl bg-blue-700/90 px-4 py-2.5 text-xs sm:text-sm font-bold text-white hover:bg-blue-800 dark:bg-blue-800 dark:hover:bg-blue-700 transition cursor-pointer";
    });

    // Active tab style
    const activeBtn =
      tab === "us" ? tabUs : tab === "metric" ? tabMetric : tabOther;
    activeBtn.className =
      "unit-tab active rounded-t-xl border-t border-x border-slate-300/90 bg-white px-4 py-2.5 text-xs sm:text-sm font-bold text-slate-900 shadow-2xs -mb-px dark:border-slate-700 dark:bg-slate-900 dark:text-white transition cursor-pointer";

    // Show/Hide Height Sections
    sectionUsHeight.classList.toggle("hidden", tab !== "us");
    sectionMetricHeight.classList.toggle("hidden", tab !== "metric");
    sectionOtherHeight.classList.toggle("hidden", tab !== "other");

    // Show/Hide Weight Sections
    sectionUsWeight.classList.toggle("hidden", tab !== "us");
    sectionMetricWeight.classList.toggle("hidden", tab !== "metric");
    sectionOtherWeight.classList.toggle("hidden", tab !== "other");

    if (hasCalculated) {
      calculate();
    }
  }

  // Synchronize inputs across all tabs
  function syncInputs(sourceUnit) {
    let heightCm = 177.8; // 5 ft 10 in
    let weightKg = 72.57; // 160 lbs

    if (sourceUnit === "us") {
      const ft = parseFloat(inputHeightFt.value) || 0;
      const inch = parseFloat(inputHeightIn.value) || 0;
      heightCm = ftInToCm(ft, inch);
      const lbs = parseFloat(inputWeightLbs.value) || 0;
      weightKg = lbsToKg(lbs);

      // Update metric & other
      inputHeightCm.value = Math.round(heightCm);
      inputHeightM.value = (heightCm / 100).toFixed(2);
      inputWeightKg.value = Math.round(weightKg);
      const roundedLbs = Math.round(lbs);
      inputWeightSt.value = Math.floor(roundedLbs / 14);
      inputWeightStLbs.value = roundedLbs % 14;
    } else if (sourceUnit === "metric") {
      heightCm = parseFloat(inputHeightCm.value) || 175;
      weightKg = parseFloat(inputWeightKg.value) || 60;
      const { ft, inch } = cmToFtIn(heightCm);
      const lbs = kgToLbs(weightKg);

      inputHeightFt.value = ft;
      inputHeightIn.value = inch;
      inputHeightM.value = (heightCm / 100).toFixed(2);
      inputWeightLbs.value = Math.round(lbs);
      const roundedLbs = Math.round(lbs);
      inputWeightSt.value = Math.floor(roundedLbs / 14);
      inputWeightStLbs.value = roundedLbs % 14;
    } else if (sourceUnit === "other") {
      const hm = parseFloat(inputHeightM.value) || 1.75;
      heightCm = hm * 100;
      const st = parseFloat(inputWeightSt.value) || 0;
      const stLbs = parseFloat(inputWeightStLbs.value) || 0;
      const totalLbs = st * 14 + stLbs;
      weightKg = lbsToKg(totalLbs);
      const { ft, inch } = cmToFtIn(heightCm);

      inputHeightCm.value = Math.round(heightCm);
      inputHeightFt.value = ft;
      inputHeightIn.value = inch;
      inputWeightKg.value = Math.round(weightKg);
      inputWeightLbs.value = Math.round(totalLbs);
    }
  }

  // Core Calculation Function
  function calculate() {
    let heightCm = 177.8;
    let weightKg = 72.57;
    let age;
    try {
      age = readValidNumber(inputAge, "age", 20, 120);
      if (!Number.isInteger(age))
        throw new Error("Enter age as a whole number between 20 and 120.");
      if (currentUnit === "us") {
        const ft = readValidNumber(inputHeightFt, "height in feet", 3, 8);
        const inch = readValidNumber(inputHeightIn, "height in inches", 0, 11);
        const lbs = readValidNumber(
          inputWeightLbs,
          "weight in pounds",
          66,
          500,
        );
        heightCm = ftInToCm(ft, inch);
        weightKg = lbsToKg(lbs);
      } else if (currentUnit === "metric") {
        heightCm = readValidNumber(inputHeightCm, "height in cm", 90, 230);
        weightKg = readValidNumber(inputWeightKg, "weight in kg", 30, 230);
      } else {
        const hm = readValidNumber(inputHeightM, "height in meters", 0.9, 2.3);
        const st = readValidNumber(inputWeightSt, "weight in stones", 4, 35);
        const stLbs = readValidNumber(
          inputWeightStLbs,
          "additional pounds",
          0,
          13,
        );
        heightCm = hm * 100;
        weightKg = lbsToKg(st * 14 + stLbs);
      }
      clearValidationError();
    } catch (error) {
      showValidationError(error.message);
      return false;
    }
    currentGender = radioGenderMale.checked ? "male" : "female";
    currentStandard = selectStandard.value;

    const heightM = heightCm / 100;
    const bmi = parseFloat((weightKg / (heightM * heightM)).toFixed(1));
    const primeDivisor = currentStandard === "asian" ? 23 : 25;
    const prime = (bmi / primeDivisor).toFixed(2);
    const ponderal = (weightKg / Math.pow(heightM, 3)).toFixed(2);

    // Standard Cutoffs
    const minHealthyBmi = 18.5;
    const maxHealthyBmi = currentStandard === "asian" ? 22.9 : 24.9;
    const maxOverweightBmi = currentStandard === "asian" ? 24.9 : 29.9;

    const minHealthyKg = parseFloat(
      (minHealthyBmi * heightM * heightM).toFixed(1),
    );
    const maxHealthyKg = parseFloat(
      (maxHealthyBmi * heightM * heightM).toFixed(1),
    );
    const minHealthyLbs = Math.round(kgToLbs(minHealthyKg));
    const maxHealthyLbs = Math.round(kgToLbs(maxHealthyKg));

    // Reveal results card
    resultsPlaceholder.classList.add("hidden");
    resultsCard.classList.remove("hidden");

    // Populate Results
    resBmi.textContent = bmi.toFixed(1);
    resPrime.textContent = prime;
    resPonderal.textContent = `${ponderal} kg/m³`;
    resGenderTag.textContent = `${currentGender === "male" ? "Male" : "Female"} (${age} yrs)`;
    resHealthyRange.textContent = `${minHealthyKg} kg - ${maxHealthyKg} kg`;
    resHealthyRangeLbs.textContent = `(${minHealthyLbs} - ${maxHealthyLbs} lbs)`;

    gaugeStandardLabel.textContent =
      currentStandard === "asian"
        ? "Asian / Indian Standard"
        : "WHO Global Standard";

    // RENDER SPEEDOMETER GAUGE & ANIMATE NEEDLE
    renderGauge(currentStandard);
    gaugeCenterBmi.textContent = `BMI = ${bmi.toFixed(1)}`;

    const gaugeAngle = getBmiGaugeAngle(bmi, currentStandard);
    const needleRotationDeg = gaugeAngle - 90; // Since needle is vertically straight up at 90 deg
    gaugeNeedleGroup.style.transform = `rotate(${needleRotationDeg.toFixed(1)}deg)`;

    // BMI Category Badge Styling
    if (bmi < minHealthyBmi) {
      resBadge.textContent = "Underweight";
      resBadge.className =
        "rounded-full bg-blue-100 px-3.5 py-1 text-xs font-bold text-blue-800 dark:bg-blue-950/80 dark:text-blue-300";
      resBmi.className =
        "text-4xl sm:text-5xl font-black tracking-tight text-blue-600 dark:text-blue-400";

      const diffKg = (minHealthyKg - weightKg).toFixed(1);
      const diffLbs = Math.round(kgToLbs(minHealthyKg - weightKg));
      resDiff.textContent = `Gain +${diffKg} kg (+${diffLbs} lbs)`;
      resDiff.className = "mt-1.5 font-bold text-blue-600 dark:text-blue-400";
      resDiffSub.textContent = "To reach minimum normal range";
    } else if (bmi <= maxHealthyBmi) {
      resBadge.textContent = "Normal / Healthy Weight";
      resBadge.className =
        "rounded-full bg-emerald-100 px-3.5 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300";
      resBmi.className =
        "text-4xl sm:text-5xl font-black tracking-tight text-emerald-600 dark:text-emerald-400";

      resDiff.textContent = "Ideal Range 👍";
      resDiff.className =
        "mt-1.5 font-bold text-emerald-600 dark:text-emerald-400";
      resDiffSub.textContent = "Maintain healthy diet & fitness";
    } else if (bmi <= maxOverweightBmi) {
      resBadge.textContent = "Overweight";
      resBadge.className =
        "rounded-full bg-amber-100 px-3.5 py-1 text-xs font-bold text-amber-800 dark:bg-amber-950/80 dark:text-amber-300";
      resBmi.className =
        "text-4xl sm:text-5xl font-black tracking-tight text-amber-600 dark:text-amber-400";

      const diffKg = (weightKg - maxHealthyKg).toFixed(1);
      const diffLbs = Math.round(kgToLbs(weightKg - maxHealthyKg));
      resDiff.textContent = `Lose -${diffKg} kg (-${diffLbs} lbs)`;
      resDiff.className = "mt-1.5 font-bold text-amber-600 dark:text-amber-400";
      resDiffSub.textContent = "To return to normal healthy range";
    } else {
      resBadge.textContent =
        currentStandard === "asian"
          ? "Obese"
          : bmi <= 34.9
            ? "Obese Class I"
            : "Obese Class II/III";
      resBadge.className =
        "rounded-full bg-red-100 px-3.5 py-1 text-xs font-bold text-red-800 dark:bg-red-950/80 dark:text-red-300";
      resBmi.className =
        "text-4xl sm:text-5xl font-black tracking-tight text-red-600 dark:text-red-400";

      const diffKg = (weightKg - maxHealthyKg).toFixed(1);
      const diffLbs = Math.round(kgToLbs(weightKg - maxHealthyKg));
      resDiff.textContent = `Lose -${diffKg} kg (-${diffLbs} lbs)`;
      resDiff.className = "mt-1.5 font-bold text-red-600 dark:text-red-400";
      resDiffSub.textContent = "Consult doctor or certified nutritionist";
    }

    // Gender-Specific Metrics Calculation
    const bodyFat = getBodyFat(bmi, age, currentGender);
    resBodyFat.textContent = `${bodyFat}%`;
    resBodyFat.className =
      "mt-1.5 font-bold " +
      (currentGender === "female"
        ? bodyFat <= 31
          ? "text-emerald-600 dark:text-emerald-400"
          : "text-amber-600 dark:text-amber-400"
        : bodyFat <= 24
          ? "text-emerald-600 dark:text-emerald-400"
          : "text-amber-600 dark:text-amber-400");

    const idealWeight = getIdealBodyWeightKg(heightCm, currentGender);
    const idealWeightLbs = Math.round(kgToLbs(idealWeight));
    resIdealWeight.textContent = `${idealWeight} kg`;
    resIdealWeightLbs.textContent = `(${idealWeightLbs} lbs - Devine formula for ${currentGender === "male" ? "Men" : "Women"})`;

    // Populate Gender Comparison Box
    const maleIbw = getIdealBodyWeightKg(heightCm, "male");
    const femaleIbw = getIdealBodyWeightKg(heightCm, "female");
    const maleFat = getBodyFat(bmi, age, "male");
    const femaleFat = getBodyFat(bmi, age, "female");
    const maleBmr = getBmrCalories(weightKg, heightCm, age, "male");
    const femaleBmr = getBmrCalories(weightKg, heightCm, age, "female");

    compMaleIbw.textContent = `${maleIbw} kg (${Math.round(kgToLbs(maleIbw))} lbs)`;
    compFemaleIbw.textContent = `${femaleIbw} kg (${Math.round(kgToLbs(femaleIbw))} lbs)`;
    compMaleFat.textContent = `${maleFat}%`;
    compFemaleFat.textContent = `${femaleFat}%`;
    compMaleBmr.textContent = `${maleBmr.toLocaleString()} kcal/day`;
    compFemaleBmr.textContent = `${femaleBmr.toLocaleString()} kcal/day`;

    if (currentGender === "male") {
      profileMale.className =
        "rounded-lg border-2 border-blue-500 bg-blue-50/70 p-3 shadow-2xs dark:border-blue-500 dark:bg-blue-950/40";
      profileFemale.className =
        "rounded-lg border border-slate-200 bg-slate-50/40 p-3 opacity-80 dark:border-slate-800 dark:bg-slate-900/30";
      badgeMaleActive.classList.remove("hidden");
      badgeFemaleActive.classList.add("hidden");
    } else {
      profileFemale.className =
        "rounded-lg border-2 border-pink-500 bg-pink-50/70 p-3 shadow-2xs dark:border-pink-500 dark:bg-pink-950/40";
      profileMale.className =
        "rounded-lg border border-slate-200 bg-slate-50/40 p-3 opacity-80 dark:border-slate-800 dark:bg-slate-900/30";
      badgeFemaleActive.classList.remove("hidden");
      badgeMaleActive.classList.add("hidden");
    }

    // Contextual Age & Gender Insights
    if (age < 20) {
      resInsightText.innerHTML = `<strong>Youth Advisory (${age} yrs, ${currentGender === "male" ? "Male" : "Female"}):</strong> For individuals aged 2 to 19, standard adult BMI cutoffs are not used in clinical diagnosis. Pediatricians evaluate <strong>BMI-for-age percentiles</strong> relative to CDC growth charts to monitor healthy adolescent development.`;
    } else if (age >= 60) {
      resInsightText.innerHTML = `<strong>Senior Advisory (${age} yrs, ${currentGender === "male" ? "Male" : "Female"}):</strong> For adults aged 60 and older, scientific studies demonstrate that a slightly higher BMI range of <strong>22.0 – 27.0 kg/m²</strong> protects bone density and reduces mortality risk.`;
    } else {
      const genderSpecific =
        currentGender === "female"
          ? `Women naturally possess higher essential body fat (21%–33%) for hormonal equilibrium. Your estimated BMR is ${femaleBmr.toLocaleString()} kcal/day.`
          : `Men naturally carry higher skeletal muscle mass and lower essential body fat (8%–20%). Your estimated BMR is ${maleBmr.toLocaleString()} kcal/day.`;
      resInsightText.innerHTML = `<strong>Adult Advisory (${age} yrs, ${currentGender === "male" ? "Male" : "Female"}):</strong> Standard reference criteria applied. ${genderSpecific} Regular physical activity and nutritious whole foods maintain peak metabolic health.`;
    }
    return true;
  }

  // Clear / Reset to Defaults
  function resetAll() {
    hasCalculated = false;
    inputAge.value = "25";
    radioGenderMale.checked = true;
    currentGender = "male";
    selectStandard.value = "who";

    // US defaults
    inputHeightFt.value = "5";
    inputHeightIn.value = "10";
    inputWeightLbs.value = "160";

    // Metric defaults
    inputHeightCm.value = "175";
    inputWeightKg.value = "60";

    // Other defaults
    inputHeightM.value = "1.75";
    inputWeightSt.value = "11";
    inputWeightStLbs.value = "6";

    setUnitTab("us");
    clearValidationError();

    // Hide result card and show placeholder
    resultsCard.classList.add("hidden");
    resultsPlaceholder.classList.remove("hidden");
  }

  // Tab Listeners
  tabUs.addEventListener("click", () => setUnitTab("us"));
  tabMetric.addEventListener("click", () => setUnitTab("metric"));
  tabOther.addEventListener("click", () => setUnitTab("other"));

  // Gender Radio Listeners
  radioGenderMale.addEventListener("change", () => {
    if (hasCalculated) calculate();
  });
  radioGenderFemale.addEventListener("change", () => {
    if (hasCalculated) calculate();
  });

  // Standard Select & Age Listeners
  selectStandard.addEventListener("change", () => {
    renderGauge(selectStandard.value);
    if (hasCalculated) calculate();
  });
  inputAge.addEventListener("input", () => {
    if (hasCalculated) calculate();
  });

  // Input synchronization listeners
  inputHeightFt.addEventListener("input", () => syncInputs("us"));
  inputHeightIn.addEventListener("input", () => syncInputs("us"));
  inputWeightLbs.addEventListener("input", () => syncInputs("us"));

  inputHeightCm.addEventListener("input", () => syncInputs("metric"));
  inputWeightKg.addEventListener("input", () => syncInputs("metric"));

  inputHeightM.addEventListener("input", () => syncInputs("other"));
  inputWeightSt.addEventListener("input", () => syncInputs("other"));
  inputWeightStLbs.addEventListener("input", () => syncInputs("other"));

  document.getElementById("bmi-form").addEventListener("submit", (event) => {
    event.preventDefault();
    hasCalculated = true;
    if (!calculate()) return;
    resultsCard.scrollIntoView({ behavior: "smooth", block: "nearest" });
    resultsCard.classList.add("ring-2", "ring-emerald-500/50");
    setTimeout(
      () => resultsCard.classList.remove("ring-2", "ring-emerald-500/50"),
      800,
    );
  });

  // Action Buttons
  btnClear.addEventListener("click", resetAll);

  // Initialize on page load
  setUnitTab("us");
  renderGauge("who");
</script>
