---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Date & Time Calculator – Calculate Time, Work Hours and Date Differences"
  description="Free online Date & Time calculator. Add and subtract time, calculate work hours with breaks and pay, elapsed time between two times/dates, convert time to decimal hours, working days, and USPS delivery date estimates."
  category="General"
  calculatorName="Date & Time Calculator"
  slug="time-calculator"
  keywords={[
    'time calculator',
    'work time calculator',
    'time calculator work',
    'date and time calculator',
    'usps delivery time calculator',
    'add time calculator',
    'elapsed time calculator',
    'time calculator hours',
    'time calculator between two times',
    'time calculator in hours',
    'date difference calculator',
    'business days calculator'
  ]}
>
  <div class="space-y-5">

    <!-- ============================ MODE NAVIGATION ============================ -->
    <div class="rounded-2xl border border-slate-200/90 bg-slate-100/70 p-2.5 dark:border-slate-800 dark:bg-slate-950/60">
      <div role="tablist" aria-label="Date and Time Calculator Modes" class="grid grid-cols-2 gap-1.5 text-[11px] font-bold sm:grid-cols-3 lg:grid-cols-5 sm:text-xs">
        <button type="button" role="tab" aria-selected="true" aria-controls="panel-tab-time-op" class="tab-mode-btn active" data-tab="tab-time-op"><span>⏱️</span> Add / Subtract</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-tab-add-multi" class="tab-mode-btn" data-tab="tab-add-multi"><span>➕</span> Sum of Times</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-tab-work-time" class="tab-mode-btn" data-tab="tab-work-time"><span>💼</span> Work &amp; Payroll</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-tab-between-times" class="tab-mode-btn" data-tab="tab-between-times"><span>⌛</span> Between Times</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-tab-time-hours" class="tab-mode-btn" data-tab="tab-time-hours"><span>🔢</span> Decimal Hours</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-tab-elapsed-time" class="tab-mode-btn" data-tab="tab-elapsed-time"><span>📅</span> Elapsed Time</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-tab-date-diff" class="tab-mode-btn" data-tab="tab-date-diff"><span>🗓️</span> Date Difference</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-tab-date-time-calc" class="tab-mode-btn" data-tab="tab-date-time-calc"><span>🧮</span> Date &amp; Time ±</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-tab-usps-delivery" class="tab-mode-btn" data-tab="tab-usps-delivery"><span>📦</span> USPS Delivery</button>
      </div>
    </div>

    <!-- ============================ QUICK PRESETS ============================ -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="mr-1 flex items-center gap-1 font-bold text-slate-600 dark:text-slate-400">
          <span>⚡</span> Quick Fill:
        </span>
        <button type="button" class="btn-preset" data-target="tab-time-op" data-p1="2,45,30" data-op="add" data-p2="1,30,45">2h 45m + 1h 30m</button>
        <button type="button" class="btn-preset" data-target="tab-work-time" data-start="09:00" data-end="17:30" data-break="30">9:00 AM – 5:30 PM (30m break)</button>
        <button type="button" class="btn-preset" data-target="tab-work-time" data-start="22:00" data-end="06:00" data-break="30">Overnight 10 PM – 6 AM</button>
        <button type="button" class="btn-preset" data-target="tab-between-times" data-t1="09:30" data-t2="17:45">9:30 AM – 5:45 PM</button>
        <button type="button" class="btn-preset" data-target="tab-time-hours" data-d="2" data-h="5" data-m="30">2d 5h 30m</button>
        <button type="button" class="btn-preset" data-target="tab-date-diff" data-sd="2026-01-01" data-ed="2026-12-31">Jan 1 – Dec 31, 2026</button>
      </div>
      <p class="mt-2 text-[11px] text-slate-400 dark:text-slate-500">
        Presets only fill the fields — press <strong>Calculate</strong> to see your result. Nothing updates automatically.
      </p>
    </div>

    <!-- ============================ CALCULATOR PANELS ============================ -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">

      <!-- =======================================================================
           1. TIME CALCULATOR (ADD / SUBTRACT)
           ======================================================================= -->
      <div id="panel-tab-time-op" class="calc-panel space-y-4" role="tabpanel">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h3 class="flex items-center gap-2 text-base font-black tracking-tight text-slate-900 dark:text-white sm:text-lg">
            <span>⏱️</span> Time Calculator – Add or Subtract Times
          </h3>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Add or subtract hours, minutes and seconds with exact base-60 normalization, plus a full unit breakdown.
          </p>
        </div>

        <form id="form-time-op" class="space-y-4" novalidate>
          <div class="grid grid-cols-1 items-center gap-3 lg:grid-cols-12">

            <!-- Time 1 -->
            <div class="rounded-2xl border border-slate-200 bg-white p-3.5 lg:col-span-4 dark:border-slate-800 dark:bg-slate-900">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Starting Time</span>
                <button type="button" class="btn-now-time text-[11px] font-bold text-blue-600 hover:underline dark:text-blue-400" data-h="top-h1" data-m="top-m1" data-s="top-s1">Use Now</button>
              </div>
              <div class="mt-2 grid grid-cols-3 gap-2 text-center text-xs">
                <div>
                  <label for="top-h1" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">Hours</label>
                  <input type="number" id="top-h1" value="2" min="0" class="num-field mt-1" />
                </div>
                <div>
                  <label for="top-m1" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">Minutes</label>
                  <input type="number" id="top-m1" value="45" min="0" class="num-field mt-1" />
                </div>
                <div>
                  <label for="top-s1" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">Seconds</label>
                  <input type="number" id="top-s1" value="30" min="0" class="num-field mt-1" />
                </div>
              </div>
            </div>

            <!-- Operation -->
            <div class="flex items-center justify-center lg:col-span-4">
              <div class="flex gap-1.5 rounded-2xl border border-slate-200 bg-white p-1.5 dark:border-slate-800 dark:bg-slate-900">
                <button type="button" id="btn-top-op-add" class="seg-btn active" data-op="add">＋ Add</button>
                <button type="button" id="btn-top-op-sub" class="seg-btn" data-op="subtract">－ Subtract</button>
              </div>
            </div>

            <!-- Time 2 -->
            <div class="rounded-2xl border border-slate-200 bg-white p-3.5 lg:col-span-4 dark:border-slate-800 dark:bg-slate-900">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Time to Add / Subtract</span>
              <div class="mt-2 grid grid-cols-3 gap-2 text-center text-xs">
                <div>
                  <label for="top-h2" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">Hours</label>
                  <input type="number" id="top-h2" value="1" min="0" class="num-field mt-1" />
                </div>
                <div>
                  <label for="top-m2" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">Minutes</label>
                  <input type="number" id="top-m2" value="30" min="0" class="num-field mt-1" />
                </div>
                <div>
                  <label for="top-s2" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400">Seconds</label>
                  <input type="number" id="top-s2" value="45" min="0" class="num-field mt-1" />
                </div>
              </div>
              <div class="mt-2.5 flex items-center justify-between gap-2 border-t border-slate-100 pt-2.5 dark:border-slate-800">
                <label for="top-mult" class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Multiply this time by</label>
                <input type="number" id="top-mult" value="1" min="1" step="1" class="w-20 num-field py-1.5 text-xs" />
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-1">
            <button type="submit" id="btn-top-calc" class="calc-btn">Calculate Time →</button>
            <button type="button" id="btn-top-clear" class="clear-btn">Clear (✕)</button>
          </div>

          <p id="err-top" class="err-box hidden" role="alert" aria-live="polite"></p>

          <!-- Result -->
          <div id="res-top-card" class="result-card results-section hidden">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-blue-200/70 pb-2 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Total Calculated Duration</span>
              <button type="button" class="btn-copy" data-copy-target="copy-top">📋 Copy</button>
            </div>
            <div id="res-top-formatted" class="mt-2 text-2xl font-black text-blue-600 sm:text-3xl dark:text-blue-400">4 Hours 16 Minutes 15 Seconds</div>
            <div id="res-top-norm" class="mt-1 font-mono text-xs font-bold text-slate-600 dark:text-slate-300">Normalized → 0d 04:16:15</div>
            <p id="res-top-warn" class="mt-2 hidden rounded-xl border border-amber-300 bg-amber-50 p-2.5 text-xs font-semibold text-amber-800 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-300"></p>

            <div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-3 lg:grid-cols-6">
              <div class="mini-chip"><span class="mini-label">Weeks</span><div id="res-top-weeks" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Days</span><div id="res-top-days" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Decimal Hours</span><div id="res-top-decimal" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Total Minutes</span><div id="res-top-minutes" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Total Seconds</span><div id="res-top-seconds" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Milliseconds</span><div id="res-top-ms" class="mini-value">--</div></div>
            </div>

            <details class="mt-3 rounded-xl border border-slate-200 bg-white/70 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <summary class="cursor-pointer text-[11px] font-bold text-slate-600 dark:text-slate-300">▸ How was this calculated?</summary>
              <p id="res-top-formula" class="mt-2 font-mono text-[11px] leading-relaxed text-slate-600 dark:text-slate-400">--</p>
            </details>
            <span id="copy-top" class="hidden"></span>
          </div>
        </form>
      </div>

      <!-- =======================================================================
           2. ADD MULTIPLE TIMES
           ======================================================================= -->
      <div id="panel-tab-add-multi" class="calc-panel hidden space-y-4" role="tabpanel">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h3 class="flex items-center gap-2 text-base font-black tracking-tight text-slate-900 dark:text-white sm:text-lg">
                <span>➕</span> Sum of Multiple Times
              </h3>
              <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
                Total up a timesheet, playlist, video timeline or race splits — with entries, average and decimal hours.
              </p>
            </div>
            <button type="button" id="btn-add-multi-row" class="add-row-btn">+ Add Time Entry</button>
          </div>
        </div>

        <form id="form-add-multi" class="space-y-3" novalidate>
          <div class="hidden grid-cols-[28px_1fr_1fr_1fr_32px] gap-2 px-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 sm:grid">
            <span>#</span><span class="text-center">Hours</span><span class="text-center">Minutes</span><span class="text-center">Seconds</span><span></span>
          </div>
          <div id="multi-rows-container" class="space-y-2">
            <div class="multi-row">
              <span class="row-index">1</span>
              <input type="number" placeholder="HH" class="m-h num-field" value="2" min="0" />
              <input type="number" placeholder="MM" class="m-m num-field" value="45" min="0" max="59" />
              <input type="number" placeholder="SS" class="m-s num-field" value="0" min="0" max="59" />
              <button type="button" class="row-del" title="Remove entry">&times;</button>
            </div>
            <div class="multi-row">
              <span class="row-index">2</span>
              <input type="number" placeholder="HH" class="m-h num-field" value="3" min="0" />
              <input type="number" placeholder="MM" class="m-m num-field" value="15" min="0" max="59" />
              <input type="number" placeholder="SS" class="m-s num-field" value="30" min="0" max="59" />
              <button type="button" class="row-del" title="Remove entry">&times;</button>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-1">
            <button type="submit" id="btn-multi-calc" class="calc-btn">Add All Times →</button>
            <button type="button" id="btn-multi-clear" class="clear-btn">Clear (✕)</button>
          </div>

          <p id="err-multi" class="err-box hidden" role="alert" aria-live="polite"></p>

          <div id="res-multi-card" class="result-card results-section hidden">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-blue-200/70 pb-2 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Combined Total Time</span>
              <button type="button" class="btn-copy" data-copy-target="copy-multi">📋 Copy</button>
            </div>
            <div id="res-multi-formatted" class="mt-2 text-2xl font-black text-blue-600 sm:text-3xl dark:text-blue-400">6 Hours 0 Minutes 30 Seconds</div>
            <div id="res-multi-norm" class="mt-1 font-mono text-xs font-bold text-slate-600 dark:text-slate-300">Normalized → 0d 06:00:30</div>

            <div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-3">
              <div class="mini-chip"><span class="mini-label">Entries Counted</span><div id="res-multi-count" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Average per Entry</span><div id="res-multi-avg" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Decimal Hours</span><div id="res-multi-decimal" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Total Minutes</span><div id="res-multi-minutes" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Total Seconds</span><div id="res-multi-seconds" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">8-Hour Workdays</span><div id="res-multi-workdays" class="mini-value">--</div></div>
            </div>
            <span id="copy-multi" class="hidden"></span>
          </div>
        </form>
      </div>

      <!-- =======================================================================
           3. WORK TIME CALCULATOR
           ======================================================================= -->
      <div id="panel-tab-work-time" class="calc-panel hidden space-y-4" role="tabpanel">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h3 class="flex items-center gap-2 text-base font-black tracking-tight text-slate-900 dark:text-white sm:text-lg">
            <span>💼</span> Work Time Calculator (Shifts, Breaks &amp; Pay)
          </h3>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Gross shift hours, multiple break deductions, net payable hours, overtime — and an optional pay estimate.
          </p>
        </div>

        <form id="form-work-time" class="space-y-4" novalidate>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <label for="work-start" class="field-label">Shift Start Time</label>
              <input type="time" id="work-start" value="09:00" class="time-field" />
            </div>
            <div>
              <label for="work-end" class="field-label">Shift End Time</label>
              <input type="time" id="work-end" value="17:30" class="time-field" />
            </div>
            <div>
              <label for="work-break" class="field-label">Main Unpaid Break (Minutes)</label>
              <input type="number" id="work-break" value="30" min="0" class="num-field w-full" />
            </div>
            <div>
              <label for="work-break2" class="field-label">Additional Break Time (Minutes)</label>
              <input type="number" id="work-break2" value="0" min="0" class="num-field w-full" />
            </div>
            <div>
              <label for="work-ot" class="field-label">Overtime Starts After (Hours)</label>
              <input type="number" id="work-ot" value="8" min="1" step="0.5" class="num-field w-full" />
            </div>
            <div>
              <label for="work-rate" class="field-label">Hourly Rate (Optional)</label>
              <input type="number" id="work-rate" value="0" min="0" step="0.01" class="num-field w-full" />
            </div>
            <div>
              <label for="work-otmult" class="field-label">Overtime Multiplier</label>
              <input type="number" id="work-otmult" value="1.5" min="1" step="0.1" class="num-field w-full" />
            </div>
            <div>
              <label for="work-currency" class="field-label">Currency Symbol</label>
              <select id="work-currency" class="select-field">
                <option value="$" selected>$ (USD)</option>
                <option value="₹">₹ (INR)</option>
                <option value="€">€ (EUR)</option>
                <option value="£">£ (GBP)</option>
                <option value="A$">A$ (AUD)</option>
              </select>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-1">
            <button type="submit" id="btn-work-calc" class="calc-btn">Calculate Work Hours →</button>
            <button type="button" id="btn-work-clear" class="clear-btn">Clear (✕)</button>
          </div>

          <p id="err-work" class="err-box hidden" role="alert" aria-live="polite"></p>

          <div id="res-work-card" class="result-card results-section hidden">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-blue-200/80 pb-2 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Net Payable Work Time</span>
              <div class="flex items-center gap-2">
                <span id="res-work-overnight-badge" class="hidden rounded-full bg-indigo-100 px-2.5 py-0.5 text-[10px] font-bold text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">🌙 Overnight (Next Day)</span>
                <button type="button" class="btn-copy" data-copy-target="copy-work">📋 Copy</button>
              </div>
            </div>

            <div class="mt-2 flex flex-wrap items-baseline gap-3">
              <span id="res-work-net" class="text-2xl font-black text-blue-600 sm:text-3xl dark:text-blue-400">8 Hours 0 Minutes</span>
              <span id="res-work-decimal" class="text-sm font-bold text-slate-600 dark:text-slate-300">(8.00 decimal hrs)</span>
            </div>
            <div id="res-work-clock" class="mt-1 font-mono text-xs font-bold text-slate-600 dark:text-slate-300">--</div>

            <div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">
              <div class="mini-chip"><span class="mini-label">Gross Shift</span><div id="res-work-gross" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Break Deducted</span><div id="res-work-break-val" class="mini-value">--</div></div>
              <div class="mini-chip"><span class="mini-label">Overtime Hours</span><div id="res-work-ot-val" class="mini-value text-emerald-600 dark:text-emerald-400">--</div></div>
              <div class="mini-chip"><span class="mini-label">Regular Hours</span><div id="res-work-reg-val" class="mini-value">--</div></div>
            </div>

            <!-- Pay Estimate -->
            <div id="res-work-pay-wrap" class="mt-3 hidden rounded-xl border border-emerald-200 bg-emerald-50/70 p-3 dark:border-emerald-900/50 dark:bg-emerald-950/30">
              <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">Estimated Pay for This Shift</div>
              <div class="mt-2 grid grid-cols-3 gap-2 text-xs">
                <div class="rounded-lg bg-white p-2.5 dark:bg-slate-900"><span class="mini-label">Regular Pay</span><div id="res-work-reg-pay" class="mini-value">--</div></div>
                <div class="rounded-lg bg-white p-2.5 dark:bg-slate-900"><span class="mini-label">Overtime Pay</span><div id="res-work-ot-pay" class="mini-value">--</div></div>
                <div class="rounded-lg bg-white p-2.5 dark:bg-slate-900"><span class="mini-label">Total Pay</span><div id="res-work-total-pay" class="mini-value text-emerald-700 dark:text-emerald-400">--</div></div>
              </div>
            </div>

            <details class="mt-3 rounded-xl border border-slate-200 bg-white/70 p-3 dark:border-slate-800 dark:bg-slate-900/70">
              <summary class="cursor-pointer text-[11px] font-bold text-slate-600 dark:text-slate-300">▸ How was this calculated?</summary>
              <p id="res-work-formula" class="mt-2 font-mono text-[11px] leading-relaxed text-slate-600 dark:text-slate-400">--</p>
            </details>
            <span id="copy-work" class="hidden"></span>
          </div>
        </form>
      </div>

      <!-- =======================================================================
           4. TIME BETWEEN TWO TIMES
           ======================================================================= -->
      <div id="panel-tab-between-times" class="calc-panel hidden space-y-4" role="tabpanel">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h3 class="flex items-center gap-2 text-base font-black tracking-tight text-slate-900 dark:text-white sm:text-lg">
            <span>⌛</span> Time Between Two Times
          </h3>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Exact hours and minutes from one clock time to another — add optional dates to span multiple days.
          </p>
        </div>

        <form id="form-between" class="space-y-4" novalidate>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900">
              <label for="between-start" class="field-label">Start Time</label>
