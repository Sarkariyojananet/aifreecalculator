  /* =========================================================
     3. WORK TIME CALCULATOR
     ========================================================= */
  function executeWorkCalc() {
    clearErr('err-work');

    var startVal = $('work-start').value;
    var endVal = $('work-end').value;
    if (!startVal || !endVal) {
      setErr('err-work', 'Please enter both a shift start time and a shift end time.');
      hide('res-work-card');
      return;
    }

    var sp = startVal.split(':');
    var ep = endVal.split(':');
    var startMin = parseInt(sp[0], 10) * 60 + parseInt(sp[1], 10);
    var endMin = parseInt(ep[0], 10) * 60 + parseInt(ep[1], 10);

    var isOvernight = false;
    if (endMin <= startMin) {
      endMin += 1440;
      isOvernight = true;
    }

    var shiftMin = endMin - startMin;
    var brk = Math.max(0, num($('work-break'))) + Math.max(0, num($('work-break2')));
    var netMin = Math.max(0, shiftMin - brk);

    var otThreshold = num($('work-ot')) || 8;
    var netDecimal = netMin / 60;
    var otHours = netDecimal > otThreshold ? netDecimal - otThreshold : 0;
    var regHours = netDecimal - otHours;

    safeSet('res-work-net', fmtLong(netMin * 60));
    safeSet('res-work-decimal', '(' + fmtNum(netDecimal, 2) + ' decimal hrs)');
    safeSet('res-work-clock', fmtClock(shiftMin * 60) + ' gross · ' + fmt12(startVal) + ' → ' + fmt12(endVal));
    safeSet('res-work-gross', Math.floor(shiftMin / 60) + 'h ' + (shiftMin % 60) + 'm');
    safeSet('res-work-break-val', brk + ' mins');
    safeSet('res-work-ot-val', fmtNum(otHours, 2) + ' hrs');
    safeSet('res-work-reg-val', fmtNum(regHours, 2) + ' hrs');

    // Pay estimate (only meaningful when a rate is supplied)
    var rate = Math.max(0, num($('work-rate')));
    var otMult = Math.max(1, num($('work-otmult')) || 1.5);
    var sym = $('work-currency').value || '$';
    var payWrap = $('res-work-pay-wrap');

    if (rate > 0) {
      var regPay = regHours * rate;
      var otPay = otHours * rate * otMult;
      safeSet('res-work-reg-pay', sym + fmtNum(regPay, 2));
      safeSet('res-work-ot-pay', sym + fmtNum(otPay, 2));
      safeSet('res-work-total-pay', sym + fmtNum(regPay + otPay, 2));
      payWrap.classList.remove('hidden');
    } else {
      payWrap.classList.add('hidden');
    }

    safeSet('res-work-formula',
      'Gross shift = ' + fmt12(endVal) + ' − ' + fmt12(startVal) +
        (isOvernight ? ' (+24h overnight rollover)' : '') + ' = ' + Math.floor(shiftMin / 60) + 'h ' + (shiftMin % 60) + 'm\n' +
      'Breaks deducted = ' + brk + ' minutes\n' +
      'Net payable = ' + fmtClock(netMin * 60) + ' = ' + fmtNum(netDecimal, 2) + ' decimal hours\n' +
      'Overtime = ' + fmtNum(netDecimal, 2) + ' − ' + otThreshold + ' = ' + fmtNum(otHours, 2) + ' hrs' +
        (otHours === 0 ? ' (none)' : '') +
      (rate > 0 ? '\nPay = (' + fmtNum(regHours, 2) + ' × ' + sym + rate + ') + (' + fmtNum(otHours, 2) + ' × ' + sym + rate + ' × ' + otMult + ')' : '')
    );

    var otBadge = $('res-work-overnight-badge');
    otBadge.classList.toggle('hidden', !isOvernight);

    var copyLines = [
      'Work Time Calculator',
      'Shift: ' + fmt12(startVal) + ' – ' + fmt12(endVal) + (isOvernight ? ' (overnight)' : ''),
      'Net Payable: ' + fmtLong(netMin * 60) + ' (' + fmtNum(netDecimal, 2) + ' decimal hrs)',
      'Gross Shift: ' + Math.floor(shiftMin / 60) + 'h ' + (shiftMin % 60) + 'm',
      'Breaks Deducted: ' + brk + ' mins',
      'Overtime: ' + fmtNum(otHours, 2) + ' hrs'
    ];
    if (rate > 0) {
      copyLines.push('Estimated Total Pay: ' + sym + fmtNum(regHours * rate + otHours * rate * otMult, 2));
    }
    copyLines.push('Calculated via aifreecalculator.com/general/time-calculator/');
    safeSet('copy-work', copyLines.join('\n'));

    show('res-work-card');
  }

