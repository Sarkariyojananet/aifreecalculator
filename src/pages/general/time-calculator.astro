  /* =========================================================
     6. ELAPSED TIME
     ========================================================= */
  function countWorkingDays(from, to, includeEnd) {
    // Counts Monday–Friday working days across the inclusive/exclusive range
    var cur = new Date(from.getFullYear(), from.getMonth(), from.getDate());
    var stop = new Date(to.getFullYear(), to.getMonth(), to.getDate());
    if (!includeEnd) stop.setDate(stop.getDate() - 1);
    var biz = 0;
    while (cur <= stop) {
      var wd = cur.getDay();
      if (wd !== 0 && wd !== 6) biz++;
      cur.setDate(cur.getDate() + 1);
    }
    return biz;
  }

  function executeElCalc() {
    clearErr('err-el');

    var aStr = $('el-start-dt').value;
    var bStr = $('el-end-dt').value;
    if (!aStr || !bStr) {
      setErr('err-el', 'Please enter both a start and an end date-time.');
      hide('res-el-card');
      return;
    }

    var a = new Date(aStr);
    var b = new Date(bStr);
    if (isNaN(a.getTime()) || isNaN(b.getTime())) {
      setErr('err-el', 'One of the provided date-time values is not valid.');
      hide('res-el-card');
      return;
    }
    if (a.getTime() === b.getTime()) {
      setErr('err-el', 'The start and end timestamps are identical, so the elapsed time is zero.');
      hide('res-el-card');
      return;
    }

    var isReverse = b < a;
    var early = isReverse ? b : a;
    var late = isReverse ? a : b;

    var totalSec = Math.floor((late.getTime() - early.getTime()) / 1000);

    var years = late.getFullYear() - early.getFullYear();
    var months = late.getMonth() - early.getMonth();
    var days = late.getDate() - early.getDate();
    var hours = late.getHours() - early.getHours();
    var mins = late.getMinutes() - early.getMinutes();
    var secs = late.getSeconds() - early.getSeconds();

    if (secs < 0) { secs += 60; mins--; }
    if (mins < 0) { mins += 60; hours--; }
    if (hours < 0) { hours += 24; days--; }
    if (days < 0) {
      months--;
      var prevMonthDays = new Date(late.getFullYear(), late.getMonth(), 0).getDate();
      days += prevMonthDays;
    }
    if (months < 0) { years--; months += 12; }

    var parts = [];
    if (years > 0) parts.push(plural(years, 'Year'));
    if (months > 0) parts.push(plural(months, 'Month'));
    if (days > 0) parts.push(plural(days, 'Day'));
    parts.push(plural(hours, 'Hour'));
    parts.push(plural(mins, 'Minute'));
    parts.push(plural(secs, 'Second'));

    safeSet('res-el-formatted', parts.join(' '));
    safeSet('res-el-direction',
      (isReverse ? '⇄ Reversed: ' : '') + fmtDate(early, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) +
      '  →  ' + fmtDate(late, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    );

    safeSet('res-el-days', fmtNum(Math.floor(totalSec / 86400), 0) + ' days');
    safeSet('res-el-weeks', fmtNum(totalSec / 604800, 3));
    safeSet('res-el-hours', fmtNum(totalSec / 3600, 2) + ' hrs');
    safeSet('res-el-minutes', fmtNum(totalSec / 60, 0) + ' mins');
    safeSet('res-el-seconds', fmtNum(totalSec, 0) + ' s');
    safeSet('res-el-biz', fmtNum(countWorkingDays(early, late, false), 0) + ' days');

    safeSet('copy-el',
      'Elapsed Time Calculator\n' +
      'From: ' + early.toString() + '\n' +
      'To: ' + late.toString() + '\n' +
      'Elapsed: ' + parts.join(' ') + '\n' +
      'Total Days: ' + fmtNum(Math.floor(totalSec / 86400), 0) + '\n' +
      'Total Hours: ' + fmtNum(totalSec / 3600, 2) + '\n' +
      'Total Minutes: ' + fmtNum(totalSec / 60, 0) + '\n' +
      'Calculated via aifreecalculator.com/general/time-calculator/'
    );

    show('res-el-card');
  }

