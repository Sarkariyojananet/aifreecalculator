  /* =========================================================
     4. TIME BETWEEN TWO TIMES
     ========================================================= */
  function executeBetweenCalc() {
    clearErr('err-between');

    var t1 = $('between-start').value;
    var t2 = $('between-end').value;
    if (!t1 || !t2) {
      setErr('err-between', 'Please enter both a start time and an end time.');
      hide('res-between-card');
      return;
    }

    var d1Str = $('between-start-date').value;
    var d2Str = $('between-end-date').value;
    var diffMin;
    var isNextDay = false;

    if (d1Str && d2Str) {
      var d1 = new Date(d1Str + 'T' + t1 + ':00');
      var d2 = new Date(d2Str + 'T' + t2 + ':00');
      if (isNaN(d1.getTime()) || isNaN(d2.getTime())) {
        setErr('err-between', 'One of the provided dates is not valid.');
        hide('res-between-card');
        return;
      }
      if (d2 < d1) {
        setErr('err-between', 'The end date/time is earlier than the start date/time. Swap them to get a positive duration.');
        hide('res-between-card');
        return;
      }
      diffMin = Math.round((d2.getTime() - d1.getTime()) / 60000);
      isNextDay = (d2.getDate() !== d1.getDate()) || (d2.getMonth() !== d1.getMonth()) || (d2.getFullYear() !== d1.getFullYear());
    } else {
      var p1 = t1.split(':');
      var p2 = t2.split(':');
      var a = parseInt(p1[0], 10) * 60 + parseInt(p1[1], 10);
      var b = parseInt(p2[0], 10) * 60 + parseInt(p2[1], 10);
      if (b < a) {
        b += 1440;
        isNextDay = true;
      }
      diffMin = b - a;
    }

    var diffSec = diffMin * 60;
    var h = Math.floor(diffMin / 60);
    var m = diffMin % 60;

    safeSet('res-between-formatted', plural(h, 'Hour') + ' ' + plural(m, 'Minute'));
    safeSet('res-between-clock', fmtHMS(diffSec) + ' (HH:MM:SS) · ' + fmtClock(diffSec));
    safeSet('res-between-decimal', fmtNum(diffMin / 60, 4) + ' hrs');
    safeSet('res-between-minutes', fmtNum(diffMin, 0) + ' mins');
    safeSet('res-between-seconds', fmtNum(diffSec, 0) + ' s');
    safeSet('res-between-pct', fmtNum((diffMin / 1440) * 100, 2) + '%');

    $('res-between-nextday').classList.toggle('hidden', !isNextDay);

    safeSet('copy-between',
      'Time Between Two Times\n' +
      (d1Str && d2Str ? 'From: ' + d1Str + ' ' + fmt12(t1) + '\nTo: ' + d2Str + ' ' + fmt12(t2) + '\n' : 'From: ' + fmt12(t1) + '\nTo: ' + fmt12(t2) + '\n') +
      'Difference: ' + plural(h, 'Hour') + ' ' + plural(m, 'Minute') + '\n' +
      'Decimal Hours: ' + fmtNum(diffMin / 60, 4) + '\n' +
      'Total Minutes: ' + fmtNum(diffMin, 0) + '\n' +
      'Calculated via aifreecalculator.com/general/time-calculator/'
    );

    show('res-between-card');
  }

  $('form-between').addEventListener('submit', function (e) {
    e.preventDefault();
    executeBetweenCalc();
  });

  $('btn-between-clear').addEventListener('click', function () {
