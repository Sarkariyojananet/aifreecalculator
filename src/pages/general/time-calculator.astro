  /* =========================================================
     8. DATE & TIME (+ / -)
     ========================================================= */
  function executeDtcCalc() {
    clearErr('err-dtc');

    var startStr = $('dtc-start').value;
    if (!startStr) {
      setErr('err-dtc', 'Please enter a starting date and time.');
      hide('res-dtc-card');
      return;
    }

    var d = new Date(startStr);
    if (isNaN(d.getTime())) {
      setErr('err-dtc', 'The starting date and time is not valid.');
      hide('res-dtc-card');
      return;
    }

    var factor = $('dtc-op').value === 'add' ? 1 : -1;
    var y = num($('dtc-y'));
    var mo = num($('dtc-m'));
    var w = num($('dtc-w'));
    var dd = num($('dtc-d'));
    var h = num($('dtc-h'));
    var mi = num($('dtc-min'));
    var se = num($('dtc-s'));

    if (y + mo + w + dd + h + mi + se === 0) {
      setErr('err-dtc', 'Enter at least one duration value (years, months, weeks, days, hours, minutes or seconds).');
      hide('res-dtc-card');
      return;
    }

    if (y) d.setFullYear(d.getFullYear() + factor * y);
    if (mo) d.setMonth(d.getMonth() + factor * mo);
    if (w) d.setDate(d.getDate() + factor * (w * 7));
    if (dd) d.setDate(d.getDate() + factor * dd);
    if (h) d.setHours(d.getHours() + factor * h);
    if (mi) d.setMinutes(d.getMinutes() + factor * mi);
    if (se) d.setSeconds(d.getSeconds() + factor * se);

    var tzMinutes = -d.getTimezoneOffset();
    var tzSign = tzMinutes >= 0 ? '+' : '-';
    var tzAbs = Math.abs(tzMinutes);
    var tzText = 'UTC' + tzSign + pad(Math.floor(tzAbs / 60)) + ':' + pad(tzAbs % 60);

    safeSet('res-dtc-formatted', fmtDate(d, {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    }));
    safeSet('res-dtc-day', dayName(d));
    safeSet('res-dtc-short', fmtDate(d, { day: '2-digit', month: 'short', year: 'numeric' }));
    safeSet('res-dtc-iso', d.toISOString().slice(0, 19).replace('T', ' '));
    safeSet('res-dtc-tz', tzText);

    safeSet('copy-dtc',
      'Date & Time Calculator\n' +
      'Operation: ' + ($('dtc-op').value === 'add' ? 'Add' : 'Subtract') + '\n' +
      'Duration: ' + y + 'y ' + mo + 'mo ' + w + 'w ' + dd + 'd ' + h + 'h ' + mi + 'm ' + se + 's\n' +
      'Result: ' + fmtDate(d, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) + '\n' +
      'Day of Week: ' + dayName(d) + '\n' +
      'ISO: ' + d.toISOString() + '\n' +
      'Calculated via aifreecalculator.com/general/time-calculator/'
    );

    show('res-dtc-card');
  }

  $('form-dt-calc').addEventListener('submit', function (e) {
    e.preventDefault();
    executeDtcCalc();
  });

  $('btn-dtc-clear').addEventListener('click', function () {
    $('dtc-start').value = '';
    ['dtc-y', 'dtc-m', 'dtc-w', 'dtc-d', 'dtc-h', 'dtc-min', 'dtc-s'].forEach(function (id) { $(id).value = '0'; });
    clearErr('err-dtc');
    hide('res-dtc-card');
  });

  /* =========================================================
     9. DELIVERY TIME ESTIMATOR
     ========================================================= */
  var USPS_SERVICES = {
    ground_advantage: { name: 'USPS Ground Advantage', min: 2, max: 5 },
    priority: { name: 'USPS Priority Mail', min: 1, max: 3 },
    priority_express: { name: 'USPS Priority Mail Express', min: 1, max: 2 }
  };

  $('usps-service').addEventListener('change', function () {
    var isCustom = $('usps-service').value === 'custom';
    $('usps-custom-min').disabled = !isCustom;
    $('usps-custom-max').disabled = !isCustom;
  });
  $('usps-custom-min').disabled = true;
  $('usps-custom-max').disabled = true;

  function addTransitDays(baseDate, days, allowSaturday) {
    var res = new Date(baseDate.getTime());
    var added = 0;
    var guard = 0;
    while (added < days && guard < 400) {
      res.setDate(res.getDate() + 1);
      var wd = res.getDay();
      guard++;
      if (wd === 0) continue;                       // Sunday never delivers
      if (!allowSaturday && wd === 6) continue;     // Saturday optional
      added++;
    }
    return res;
  }

  function computeDispatch(ship, handlingDays) {
    var dispatch = new Date(ship.getTime());
    var added = 0;
    var guard = 0;
    while (added < handlingDays && guard < 400) {
      dispatch.setDate(dispatch.getDate() + 1);
      guard++;
      if (dispatch.getDay() !== 0) added++;         // Sunday is not a dispatch day
    }
    return dispatch;
  }

  function windowText(minDate, maxDate) {
    return fmtDate(minDate, { month: 'short', day: 'numeric' }) + ' – ' + fmtDate(maxDate, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function executeUspsCalc() {
    clearErr('err-usps');

    var shipStr = $('usps-ship-date').value;
    if (!shipStr) {
      setErr('err-usps', 'Please select a shipment or order date.');
      hide('res-usps-card');
      return;
    }

    var ship = parseYmd(shipStr);
    if (!ship) {
      setErr('err-usps', 'The shipment date is not valid.');
      hide('res-usps-card');
      return;
    }

    var handling = Math.max(0, Math.floor(num($('usps-handling'))));
    var allowSat = $('usps-saturday').checked;
    var serviceKey = $('usps-service').value;

    var minT, maxT, serviceName;
    if (serviceKey === 'custom') {
      minT = Math.max(0, Math.floor(num($('usps-custom-min'))));
      maxT = Math.max(0, Math.floor(num($('usps-custom-max'))));
      if (maxT < minT) { var t = minT; minT = maxT; maxT = t; }
      serviceName = 'Custom Carrier Service';
    } else {
      var svc = USPS_SERVICES[serviceKey];
      minT = svc.min;
      maxT = svc.max;
      serviceName = svc.name;
    }

    var dispatch = computeDispatch(ship, handling);
    var minDate = addTransitDays(dispatch, minT, allowSat);
    var maxDate = addTransitDays(dispatch, maxT, allowSat);

    safeSet('res-usps-window', windowText(minDate, maxDate));
    safeSet('res-usps-service-name', serviceName + ' · ' + minT + '–' + maxT + ' transit business days' + (handling > 0 ? ' · ' + handling + 'd handling' : ''));
    safeSet('res-usps-ship', fmtDate(ship, { month: 'short', day: 'numeric', year: 'numeric' }));
    safeSet('res-usps-dispatch', fmtDate(dispatch, { weekday: 'short', month: 'short', day: 'numeric' }));
    safeSet('res-usps-min', fmtDate(minDate, { weekday: 'short', month: 'short', day: 'numeric' }));
    safeSet('res-usps-max', fmtDate(maxDate, { weekday: 'short', month: 'short', day: 'numeric' }));

    // Side-by-side comparison of every standard tier
    var body = $('res-usps-compare-body');
    body.innerHTML = '';
    Object.keys(USPS_SERVICES).forEach(function (key) {
      var svc = USPS_SERVICES[key];
      var lo = addTransitDays(dispatch, svc.min, allowSat);
      var hi = addTransitDays(dispatch, svc.max, allowSat);
      var isActive = key === serviceKey;

      var tr = document.createElement('tr');
      if (isActive) tr.className = 'bg-blue-50/70 dark:bg-blue-950/30';
      tr.innerHTML =
        '<td class="px-3 py-2 font-semibold text-slate-900 dark:text-white">' + svc.name + (isActive ? ' <span class="text-[10px] font-bold text-blue-600 dark:text-blue-400">(selected)</span>' : '') + '</td>' +
        '<td class="px-3 py-2 font-mono text-slate-600 dark:text-slate-400">' + svc.min + '–' + svc.max + ' days</td>' +
        '<td class="px-3 py-2 font-mono font-bold text-slate-800 dark:text-slate-200">' + windowText(lo, hi) + '</td>';
      body.appendChild(tr);
    });

    safeSet('copy-usps',
      'Delivery Time Estimate\n' +
      'Ship Date: ' + fmtDate(ship, { month: 'long', day: 'numeric', year: 'numeric' }) + '\n' +
      'Dispatch Date: ' + fmtDate(dispatch, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) + '\n' +
      'Service: ' + serviceName + ' (' + minT + '–' + maxT + ' business days)\n' +
      'Estimated Window: ' + windowText(minDate, maxDate) + '\n' +
      'Saturday Delivery: ' + (allowSat ? 'Yes' : 'No') + '\n' +
      'Estimated via aifreecalculator.com/general/time-calculator/ (not an official USPS tool)'
    );

    show('res-usps-card');
  }

  $('form-usps').addEventListener('submit', function (e) {
    e.preventDefault();
    executeUspsCalc();
  });

  $('btn-usps-clear').addEventListener('click', function () {
    $('usps-ship-date').value = '';
    $('usps-handling').value = '1';
    $('usps-custom-min').value = '2';
    $('usps-custom-max').value = '7';
    clearErr('err-usps');
    hide('res-usps-card');
  });

  /* =========================================================
     PRESETS — fill fields only, never auto-calculate
     ========================================================= */
  function pulseCalcButton(panelId) {
    var panel = document.getElementById('panel-' + panelId);
    if (!panel) return;
    var btn = panel.querySelector('.calc-btn');
    if (!btn) return;
    btn.classList.remove('btn-hint');
    void btn.offsetWidth;
    btn.classList.add('btn-hint');
  }

  document.querySelectorAll('.btn-preset').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = btn.getAttribute('data-target');
      switchTab(target);

      if (target === 'tab-time-op') {
        var p1 = btn.getAttribute('data-p1').split(',');
        var p2 = btn.getAttribute('data-p2').split(',');
        $('top-h1').value = p1[0]; $('top-m1').value = p1[1]; $('top-s1').value = p1[2];
        $('top-h2').value = p2[0]; $('top-m2').value = p2[1]; $('top-s2').value = p2[2];
        $('top-mult').value = '1';

        var wantOp = btn.getAttribute('data-op') || 'add';
        topOp = wantOp;
        btnTopOpAdd.classList.toggle('active', wantOp === 'add');
        btnTopOpSub.classList.toggle('active', wantOp === 'subtract');
      } else if (target === 'tab-work-time') {
        $('work-start').value = btn.getAttribute('data-start');
        $('work-end').value = btn.getAttribute('data-end');
        $('work-break').value = btn.getAttribute('data-break');
      } else if (target === 'tab-between-times') {
        $('between-start').value = btn.getAttribute('data-t1');
        $('between-end').value = btn.getAttribute('data-t2');
      } else if (target === 'tab-time-hours') {
        applyThMode('to-decimal');
        $('th-days').value = btn.getAttribute('data-d');
        $('th-hours').value = btn.getAttribute('data-h');
        $('th-mins').value = btn.getAttribute('data-m');
      } else if (target === 'tab-date-diff') {
        $('dd-start').value = btn.getAttribute('data-sd');
        $('dd-end').value = btn.getAttribute('data-ed');
      }

      pulseCalcButton(target);
    });
  });

  /* =========================================================
     INITIAL STATE — nothing is calculated or displayed on load
     ========================================================= */
  applyThMode('to-decimal');
  hide('res-top-card');
  hide('res-multi-card');
  hide('res-work-card');
  hide('res-between-card');
  hide('res-th-card');
  hide('res-el-card');
  hide('res-dd-card');
  hide('res-dtc-card');
  hide('res-usps-card');
})();
</script>
