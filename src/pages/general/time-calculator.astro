  /* =========================================================
     5. DECIMAL HOURS CONVERTER
     ========================================================= */
  var thMode = 'to-decimal';
  var btnThTo = $('btn-th-mode-to');
  var btnThFrom = $('btn-th-mode-from');

  function applyThMode(mode) {
    thMode = mode;
    btnThTo.classList.toggle('active', mode === 'to-decimal');
    btnThFrom.classList.toggle('active', mode === 'to-dhms');
    $('th-input-dhms').classList.toggle('hidden', mode !== 'to-decimal');
    $('th-input-decimal').classList.toggle('hidden', mode !== 'to-dhms');
    hide('res-th-card');
    clearErr('err-th');
  }

  btnThTo.addEventListener('click', function () { applyThMode('to-decimal'); });
  btnThFrom.addEventListener('click', function () { applyThMode('to-dhms'); });

  function executeThCalc() {
    clearErr('err-th');

    if (thMode === 'to-decimal') {
      var d = num($('th-days'));
      var h = num($('th-hours'));
      var m = num($('th-mins'));
      var s = num($('th-secs'));
      var totalSec = d * 86400 + h * 3600 + m * 60 + s;

      if (totalSec <= 0) {
        setErr('err-th', 'Please enter a duration greater than zero.');
        hide('res-th-card');
        return;
      }

      safeSet('res-th-val', fmtNum(totalSec / 3600, 4) + ' Hours');
      safeSet('res-th-secondary', 'Normalized → ' + fmtClock(totalSec) + ' (' + fmtLong(totalSec) + ')');
      safeSet('res-th-days', fmtNum(totalSec / 86400, 4));
      safeSet('res-th-minutes', fmtNum(totalSec / 60, 2) + ' mins');
      safeSet('res-th-seconds', fmtNum(totalSec, 0) + ' s');
      safeSet('res-th-weeks', fmtNum(totalSec / 604800, 4));
      safeSet('res-th-formula',
        'Decimal Hours = Days×24 + Hours + (Minutes ÷ 60) + (Seconds ÷ 3600)\n' +
        '= ' + d + '×24 + ' + h + ' + (' + m + ' ÷ 60) + (' + s + ' ÷ 3600)\n' +
        '= ' + fmtNum(totalSec / 3600, 4) + ' decimal hours'
      );
      safeSet('copy-th',
        'Decimal Hours Conversion\n' +
        'Input: ' + d + 'd ' + h + 'h ' + m + 'm ' + s + 's\n' +
        'Decimal Hours: ' + fmtNum(totalSec / 3600, 4) + '\n' +
        'Total Minutes: ' + fmtNum(totalSec / 60, 2) + '\n' +
        'Total Seconds: ' + fmtNum(totalSec, 0) + '\n' +
        'Calculated via aifreecalculator.com/general/time-calculator/'
      );
    } else {
      var dec = num($('th-decimal'));
      if (dec <= 0) {
        setErr('err-th', 'Please enter a decimal hour value greater than zero.');
        hide('res-th-card');
        return;
      }
      var totalSeconds = Math.round(dec * 3600);
      var dd = Math.floor(totalSeconds / 86400);
      var hh = Math.floor((totalSeconds % 86400) / 3600);
      var mm = Math.floor((totalSeconds % 3600) / 60);
      var ss = totalSeconds % 60;

      safeSet('res-th-val', fmtLong(totalSeconds));
      safeSet('res-th-secondary', 'Normalized → ' + fmtClock(totalSeconds) + ' (' + fmtNum(dec, 4) + ' decimal hours)');
      safeSet('res-th-days', dd + ' days');
      safeSet('res-th-minutes', fmtNum(dec * 60, 2) + ' mins');
      safeSet('res-th-seconds', fmtNum(totalSeconds, 0) + ' s');
      safeSet('res-th-weeks', fmtNum(dec / 168, 4));
      safeSet('res-th-formula',
        'Decimal Hours × 3600 = total seconds\n' +
        fmtNum(dec, 4) + ' × 3600 = ' + fmtNum(totalSeconds, 0) + ' seconds\n' +
        '= ' + dd + 'd ' + pad(hh) + ':' + pad(mm) + ':' + pad(ss)
      );
      safeSet('copy-th',
        'Decimal to D:H:M:S Conversion\n' +
        'Input: ' + fmtNum(dec, 4) + ' decimal hours\n' +
        'Result: ' + fmtLong(totalSeconds) + '\n' +
        'Clock: ' + fmtClock(totalSeconds) + '\n' +
        'Calculated via aifreecalculator.com/general/time-calculator/'
      );
    }

    show('res-th-card');
  }

