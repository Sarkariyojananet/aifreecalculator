  /* =========================================================
     7. DATE DIFFERENCE & WORKING DAYS
     ========================================================= */
  function parseHolidays(text) {
    if (!text) return [];
    var seen = {};
    var out = [];
    text.split(/[\s,;]+/).forEach(function (token) {
      if (!token) return;
      var d = parseYmd(token);
      if (d && !seen[token]) {
        seen[token] = true;
        out.push(d);
      }
    });
    return out;
  }

  function executeDdCalc() {
    clearErr('err-dd');

    var s = parseYmd($('dd-start').value);
    var e = parseYmd($('dd-end').value);
    if (!s || !e) {
      setErr('err-dd', 'Please enter both a start date and an end date.');
      hide('res-dd-card');
      return;
    }
    if (e.getTime() === s.getTime()) {
      setErr('err-dd', 'The start and end dates are the same. Choose two different dates.');
      hide('res-dd-card');
      return;
    }

    var includeEnd = $('chk-dd-include-end').checked;
    var early = e < s ? e : s;
    var late = e < s ? s : e;

    var diff = Math.round((late.getTime() - early.getTime()) / 86400000) + (includeEnd ? 1 : 0);

    var activeDays = [];
    document.querySelectorAll('.chk-work-day').forEach(function (cb) {
      if (cb.checked) activeDays.push(parseInt(cb.value, 10));
    });

    if (activeDays.length === 0) {
      setErr('err-dd', 'Select at least one day of the week as a working day.');
      hide('res-dd-card');
      return;
    }

    var holidays = parseHolidays($('dd-holidays').value);
    var holidayKeys = {};
    holidays.forEach(function (d) {
      holidayKeys[d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())] = true;
    });

    var biz = 0, off = 0, holidaysApplied = 0;
    var cur = new Date(early.getFullYear(), early.getMonth(), early.getDate());
    var stop = new Date(late.getFullYear(), late.getMonth(), late.getDate());
    if (!includeEnd) stop.setDate(stop.getDate() - 1);

    while (cur <= stop) {
      var key = cur.getFullYear() + '-' + pad(cur.getMonth() + 1) + '-' + pad(cur.getDate());
      var isWorkday = activeDays.indexOf(cur.getDay()) !== -1;
      if (isWorkday) {
        if (holidayKeys[key]) {
          holidaysApplied++;
          off++;
        } else {
          biz++;
        }
      } else {
        off++;
      }
      cur.setDate(cur.getDate() + 1);
    }

    // Calendar breakdown (years / months / days)
    var y = late.getFullYear() - early.getFullYear();
    var mo = late.getMonth() - early.getMonth();
    var dd = late.getDate() - early.getDate();
    if (dd < 0) {
      mo--;
      dd += new Date(late.getFullYear(), late.getMonth(), 0).getDate();
    }
    if (mo < 0) { y--; mo += 12; }

    safeSet('res-dd-total-days', fmtNum(diff, 0) + ' Days');
    safeSet('res-dd-breakdown',
      (y > 0 ? plural(y, 'year') + ' ' : '') + (mo > 0 ? plural(mo, 'month') + ' ' : '') + plural(dd, 'day') +
      '  ·  ' + fmtDate(early, { day: 'numeric', month: 'short', year: 'numeric' }) +
      ' → ' + fmtDate(late, { day: 'numeric', month: 'short', year: 'numeric' })
    );

    safeSet('res-dd-biz', fmtNum(biz, 0) + ' days');
    safeSet('res-dd-wknd', fmtNum(off, 0) + ' days');
    safeSet('res-dd-holidays', fmtNum(holidaysApplied, 0) + ' days');
    safeSet('res-dd-weeks', Math.floor(diff / 7) + ' wks ' + (diff % 7) + ' days');
    safeSet('res-dd-hours', fmtNum(diff * 24, 0) + ' hrs');
    safeSet('res-dd-net', fmtNum(biz, 0) + ' days');

    safeSet('copy-dd',
      'Date Difference Calculator\n' +
      'From: ' + fmtDate(early, { day: 'numeric', month: 'long', year: 'numeric' }) + '\n' +
      'To: ' + fmtDate(late, { day: 'numeric', month: 'long', year: 'numeric' }) + '\n' +
      'Total Days: ' + fmtNum(diff, 0) + (includeEnd ? ' (end date included)' : '') + '\n' +
      'Working Days: ' + fmtNum(biz, 0) + '\n' +
      'Weekends / Off Days: ' + fmtNum(off, 0) + '\n' +
      'Holidays Excluded: ' + fmtNum(holidaysApplied, 0) + '\n' +
      'Calculated via aifreecalculator.com/general/time-calculator/'
    );

    show('res-dd-card');
  }

