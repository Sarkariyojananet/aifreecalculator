<script is:inline>
  // Tab Mode Switching
  const tabButtons = document.querySelectorAll('.btn-tab-mode');
  const calcPanels = document.querySelectorAll('.calc-panel');

  function switchTab(tabId) {
    tabButtons.forEach((btn) => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.className = 'btn-tab-mode active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer';
      } else {
        btn.className = 'btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
      }
    });

    calcPanels.forEach((panel) => {
      if (panel.id === `panel-${tabId}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      switchTab(btn.getAttribute('data-tab'));
    });
  });

  // Check URL hash for direct tab selection (e.g., date-difference)
  if (window.location.hash) {
    const hash = window.location.hash.replace('#', '');
    if (document.getElementById(`panel-${hash}`)) {
      switchTab(hash);
    }
  }

  // ==========================================
  // 1. TIME CALCULATOR (ADD / SUBTRACT)
  // ==========================================
  let topOp = 'add';
  const btnTopOpAdd = document.getElementById('btn-top-op-add');
  const btnTopOpSub = document.getElementById('btn-top-op-sub');
  const topH1 = document.getElementById('top-h1');
  const topM1 = document.getElementById('top-m1');
  const topS1 = document.getElementById('top-s1');
  const topH2 = document.getElementById('top-h2');
  const topM2 = document.getElementById('top-m2');
  const topS2 = document.getElementById('top-s2');
  const btnTopCalc = document.getElementById('btn-top-calc');
  const btnTopClear = document.getElementById('btn-top-clear');
  const errTop = document.getElementById('err-top');
  const resTopCard = document.getElementById('res-top-card');
  const resTopFormatted = document.getElementById('res-top-formatted');
  const resTopDecimal = document.getElementById('res-top-decimal');
  const resTopMinutes = document.getElementById('res-top-minutes');
  const resTopSeconds = document.getElementById('res-top-seconds');

  btnTopOpAdd.addEventListener('click', () => {
    topOp = 'add';
    btnTopOpAdd.className = 'btn-top-op active rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-xs cursor-pointer';
    btnTopOpSub.className = 'btn-top-op rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
  });

  btnTopOpSub.addEventListener('click', () => {
    topOp = 'subtract';
    btnTopOpSub.className = 'btn-top-op active rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-xs cursor-pointer';
    btnTopOpAdd.className = 'btn-top-op rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer';
  });

  function executeTopCalc() {
    errTop.classList.add('hidden');
    const s1 = (parseInt(topH1.value) || 0) * 3600 + (parseInt(topM1.value) || 0) * 60 + (parseInt(topS1.value) || 0);
    const s2 = (parseInt(topH2.value) || 0) * 3600 + (parseInt(topM2.value) || 0) * 60 + (parseInt(topS2.value) || 0);

    let finalSec = topOp === 'add' ? s1 + s2 : s1 - s2;
    const isNeg = finalSec < 0;
    finalSec = Math.abs(finalSec);

    const h = Math.floor(finalSec / 3600);
    const m = Math.floor((finalSec % 3600) / 60);
    const s = finalSec % 60;

    const sign = isNeg ? '-' : '';
    resTopFormatted.textContent = `${sign}${h} Hours ${m} Minutes ${s} Seconds`;
    resTopDecimal.textContent = `${sign}${(finalSec / 3600).toFixed(4)} hrs`;
    resTopMinutes.textContent = `${sign}${(finalSec / 60).toFixed(2)} mins`;
    resTopSeconds.textContent = `${sign}${finalSec.toLocaleString()} s`;
    resTopCard.classList.remove('hidden');
  }

  btnTopCalc.addEventListener('click', executeTopCalc);

  btnTopClear.addEventListener('click', () => {
    topH1.value = '0';
    topM1.value = '0';
    topS1.value = '0';
    topH2.value = '0';
    topM2.value = '0';
    topS2.value = '0';
    errTop.classList.add('hidden');
    resTopCard.classList.add('hidden');
  });

  // ==========================================
  // 2. ADD MULTIPLE TIMES
  // ==========================================
  const multiRowsContainer = document.getElementById('multi-rows-container');
  const btnAddMultiRow = document.getElementById('btn-add-multi-row');
  const btnMultiCalc = document.getElementById('btn-multi-calc');
  const btnMultiClear = document.getElementById('btn-multi-clear');
  const resMultiCard = document.getElementById('res-multi-card');
  const resMultiFormatted = document.getElementById('res-multi-formatted');
  const resMultiDecimal = document.getElementById('res-multi-decimal');
  const resMultiMinutes = document.getElementById('res-multi-minutes');
  const resMultiSeconds = document.getElementById('res-multi-seconds');

  btnAddMultiRow.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'multi-row grid grid-cols-3 gap-2';
    row.innerHTML = `
      <input type="number" placeholder="Hours" class="m-h rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="1" min="0" />
      <input type="number" placeholder="Minutes" class="m-m rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="30" min="0" max="59" />
      <input type="number" placeholder="Seconds" class="m-s rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="0" min="0" max="59" />
    `;
    multiRowsContainer.appendChild(row);
  });

  function executeMultiCalc() {
    let totalSec = 0;
    document.querySelectorAll('.multi-row').forEach((r) => {
      const h = parseInt(r.querySelector('.m-h').value) || 0;
      const m = parseInt(r.querySelector('.m-m').value) || 0;
      const s = parseInt(r.querySelector('.m-s').value) || 0;
      totalSec += h * 3600 + m * 60 + s;
    });

    const h = Math.floor(totalSec / 3600);
    const m = Math.floor((totalSec % 3600) / 60);
    const s = totalSec % 60;

    resMultiFormatted.textContent = `${h} Hours ${m} Minutes ${s} Seconds`;
    resMultiDecimal.textContent = `${(totalSec / 3600).toFixed(4)} hrs`;
    resMultiMinutes.textContent = `${(totalSec / 60).toFixed(2)} mins`;
    resMultiSeconds.textContent = `${totalSec.toLocaleString()} s`;
    resMultiCard.classList.remove('hidden');
  }

  btnMultiCalc.addEventListener('click', executeMultiCalc);

  btnMultiClear.addEventListener('click', () => {
    multiRowsContainer.innerHTML = `
      <div class="multi-row grid grid-cols-3 gap-2">
        <input type="number" placeholder="Hours" class="m-h rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="0" min="0" />
        <input type="number" placeholder="Minutes" class="m-m rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="0" min="0" max="59" />
        <input type="number" placeholder="Seconds" class="m-s rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="0" min="0" max="59" />
      </div>
    `;
    resMultiCard.classList.add('hidden');
  });

  // ==========================================
  // 3. WORK TIME CALCULATOR
  // ==========================================
  const workStart = document.getElementById('work-start');
  const workEnd = document.getElementById('work-end');
  const workBreak = document.getElementById('work-break');
  const workOt = document.getElementById('work-ot');
  const btnWorkCalc = document.getElementById('btn-work-calc');
  const btnWorkClear = document.getElementById('btn-work-clear');
  const resWorkCard = document.getElementById('res-work-card');
  const resWorkNet = document.getElementById('res-work-net');
  const resWorkDecimal = document.getElementById('res-work-decimal');
  const resWorkGross = document.getElementById('res-work-gross');
  const resWorkBreakVal = document.getElementById('res-work-break-val');
  const resWorkOtVal = document.getElementById('res-work-ot-val');
  const resWorkOvernightBadge = document.getElementById('res-work-overnight-badge');

  function executeWorkCalc() {
    const [startH, startM] = workStart.value.split(':').map(Number);
    const [endH, endM] = workEnd.value.split(':').map(Number);

    const startMin = startH * 60 + startM;
    let endMin = endH * 60 + endM;

    let isOvernight = false;
    if (endMin < startMin) {
      endMin += 24 * 60;
      isOvernight = true;
    }

    const shiftMin = endMin - startMin;
    const brkMin = parseInt(workBreak.value) || 0;
    const netMin = Math.max(0, shiftMin - brkMin);

    const netH = Math.floor(netMin / 60);
    const netM = netMin % 60;
    const netDecimal = netMin / 60;

    const otThreshold = parseFloat(workOt.value) || 8;
    const ot = netDecimal > otThreshold ? netDecimal - otThreshold : 0;

    resWorkNet.textContent = `${netH} Hours ${netM} Minutes`;
    resWorkDecimal.textContent = `(${netDecimal.toFixed(2)} decimal hrs)`;
    resWorkGross.textContent = `${Math.floor(shiftMin / 60)}h ${shiftMin % 60}m`;
    resWorkBreakVal.textContent = `${brkMin} mins`;
    resWorkOtVal.textContent = `${ot.toFixed(2)} hrs`;

    if (isOvernight) {
      resWorkOvernightBadge.classList.remove('hidden');
    } else {
      resWorkOvernightBadge.classList.add('hidden');
    }

    resWorkCard.classList.remove('hidden');
  }

  btnWorkCalc.addEventListener('click', executeWorkCalc);

  btnWorkClear.addEventListener('click', () => {
    workStart.value = '09:00';
    workEnd.value = '17:00';
    workBreak.value = '0';
    workOt.value = '8';
    resWorkCard.classList.add('hidden');
  });

  // ==========================================
  // 4. TIME BETWEEN TWO TIMES
  // ==========================================
  const betweenStart = document.getElementById('between-start');
  const betweenEnd = document.getElementById('between-end');
  const btnBetweenCalc = document.getElementById('btn-between-calc');
  const btnBetweenClear = document.getElementById('btn-between-clear');
  const resBetweenCard = document.getElementById('res-between-card');
  const resBetweenFormatted = document.getElementById('res-between-formatted');
  const resBetweenDecimal = document.getElementById('res-between-decimal');
  const resBetweenMinutes = document.getElementById('res-between-minutes');

  function executeBetweenCalc() {
    const [h1, m1] = betweenStart.value.split(':').map(Number);
    const [h2, m2] = betweenEnd.value.split(':').map(Number);

    let startMin = h1 * 60 + m1;
    let endMin = h2 * 60 + m2;

    if (endMin < startMin) {
      endMin += 24 * 60;
    }

    const diffMin = endMin - startMin;
    const h = Math.floor(diffMin / 60);
    const m = diffMin % 60;

    resBetweenFormatted.textContent = `${h} Hours ${m} Minutes`;
    resBetweenDecimal.textContent = `${(diffMin / 60).toFixed(2)} hrs`;
    resBetweenMinutes.textContent = `${diffMin} mins`;
    resBetweenCard.classList.remove('hidden');
  }

  btnBetweenCalc.addEventListener('click', executeBetweenCalc);

  btnBetweenClear.addEventListener('click', () => {
    betweenStart.value = '09:00';
    betweenEnd.value = '17:00';
    resBetweenCard.classList.add('hidden');
  });

  // ==========================================
  // 5. TIME IN HOURS
  // ==========================================
  const thDays = document.getElementById('th-days');
  const thHours = document.getElementById('th-hours');
  const thMins = document.getElementById('th-mins');
  const thSecs = document.getElementById('th-secs');
  const btnThCalc = document.getElementById('btn-th-calc');
  const btnThClear = document.getElementById('btn-th-clear');
  const resThCard = document.getElementById('res-th-card');
  const resThVal = document.getElementById('res-th-val');
  const resThMinutes = document.getElementById('res-th-minutes');
  const resThSeconds = document.getElementById('res-th-seconds');

  function executeThCalc() {
    const d = parseInt(thDays.value) || 0;
    const h = parseInt(thHours.value) || 0;
    const m = parseInt(thMins.value) || 0;
    const s = parseInt(thSecs.value) || 0;

    const totalSec = d * 86400 + h * 3600 + m * 60 + s;
    const totalHours = totalSec / 3600;
    const totalMins = totalSec / 60;

    resThVal.textContent = `${totalHours.toFixed(4)} Hours`;
    resThMinutes.textContent = `${totalMins.toLocaleString()} mins`;
    resThSeconds.textContent = `${totalSec.toLocaleString()} s`;
    resThCard.classList.remove('hidden');
  }

  btnThCalc.addEventListener('click', executeThCalc);

  btnThClear.addEventListener('click', () => {
    thDays.value = '0';
    thHours.value = '0';
    thMins.value = '0';
    thSecs.value = '0';
    resThCard.classList.add('hidden');
  });

  // ==========================================
  // 6. ELAPSED TIME
  // ==========================================
  const elStartDt = document.getElementById('el-start-dt');
  const elEndDt = document.getElementById('el-end-dt');
  const btnElCalc = document.getElementById('btn-el-calc');
  const btnElClear = document.getElementById('btn-el-clear');
  const resElCard = document.getElementById('res-el-card');
  const resElFormatted = document.getElementById('res-el-formatted');
  const resElDays = document.getElementById('res-el-days');
  const resElHours = document.getElementById('res-el-hours');
  const resElMinutes = document.getElementById('res-el-minutes');

  function executeElCalc() {
    const d1 = new Date(elStartDt.value);
    const d2 = new Date(elEndDt.value);
    if (isNaN(d1.getTime()) || isNaN(d2.getTime())) return;

    const totalSec = Math.floor(Math.abs(d2.getTime() - d1.getTime()) / 1000);
    const totalDays = Math.floor(totalSec / 86400);
    const totalHours = totalSec / 3600;
    const totalMinutes = totalSec / 60;

    // Years, Months, Days Breakdown
    const early = d1 < d2 ? d1 : d2;
    const late = d1 < d2 ? d2 : d1;

    let years = late.getFullYear() - early.getFullYear();
    let months = late.getMonth() - early.getMonth();
    let days = late.getDate() - early.getDate();
    let hours = late.getHours() - early.getHours();
    let mins = late.getMinutes() - early.getMinutes();

    if (mins < 0) { mins += 60; hours--; }
    if (hours < 0) { hours += 24; days--; }
    if (days < 0) {
      months--;
      const prevMonthDays = new Date(late.getFullYear(), late.getMonth(), 0).getDate();
      days += prevMonthDays;
    }
    if (months < 0) { years--; months += 12; }

    let p = [];
    if (years > 0) p.push(`${years} Year${years > 1 ? 's' : ''}`);
    if (months > 0) p.push(`${months} Month${months > 1 ? 's' : ''}`);
    if (days > 0) p.push(`${days} Day${days > 1 ? 's' : ''}`);
    p.push(`${hours} Hour${hours !== 1 ? 's' : ''}`);
    p.push(`${mins} Minute${mins !== 1 ? 's' : ''}`);

    resElFormatted.textContent = p.join(' ');
    resElDays.textContent = `${totalDays.toLocaleString()} Days`;
    resElHours.textContent = `${totalHours.toFixed(2)} hrs`;
    resElMinutes.textContent = `${totalMinutes.toLocaleString()} mins`;
    resElCard.classList.remove('hidden');
  }

  btnElCalc.addEventListener('click', executeElCalc);

  btnElClear.addEventListener('click', () => {
    elStartDt.value = '2026-01-01T00:00';
    elEndDt.value = '2026-01-02T00:00';
    resElCard.classList.add('hidden');
  });

  // ==========================================
  // 7. DATE DIFFERENCE & WORKING DAYS
  // ==========================================
  const ddStart = document.getElementById('dd-start');
  const ddEnd = document.getElementById('dd-end');
  const chkDdIncludeEnd = document.getElementById('chk-dd-include-end');
  const chkWorkDays = document.querySelectorAll('.chk-work-day');
  const btnDdCalc = document.getElementById('btn-dd-calc');
  const btnDdClear = document.getElementById('btn-dd-clear');
  const resDdCard = document.getElementById('res-dd-card');
  const resDdTotalDays = document.getElementById('res-dd-total-days');
  const resDdBiz = document.getElementById('res-dd-biz');
  const resDdWknd = document.getElementById('res-dd-wknd');
  const resDdWeeks = document.getElementById('res-dd-weeks');
  const resDdHours = document.getElementById('res-dd-hours');

  function executeDdCalc() {
    const s = new Date(ddStart.value + 'T00:00:00');
    const e = new Date(ddEnd.value + 'T00:00:00');
    if (isNaN(s.getTime()) || isNaN(e.getTime())) return;

    const isReverse = e < s;
    const early = isReverse ? e : s;
    const late = isReverse ? s : e;

    let diff = Math.round((late.getTime() - early.getTime()) / (1000 * 60 * 60 * 24));
    if (chkDdIncludeEnd.checked) diff += 1;

    const activeDays = [];
    chkWorkDays.forEach((cb) => {
      if (cb.checked) activeDays.push(parseInt(cb.value));
    });

    let biz = 0;
    let wknd = 0;
    const cur = new Date(early);
    const stop = new Date(late);
    if (!chkDdIncludeEnd.checked) stop.setDate(stop.getDate() - 1);

    while (cur <= stop) {
      if (activeDays.includes(cur.getDay())) {
        biz++;
      } else {
        wknd++;
      }
      cur.setDate(cur.getDate() + 1);
    }

    resDdTotalDays.textContent = `${diff.toLocaleString()} Days`;
    resDdBiz.textContent = `${biz.toLocaleString()} Days`;
    resDdWknd.textContent = `${wknd.toLocaleString()} Days`;
    resDdWeeks.textContent = `${Math.floor(diff / 7)} wks, ${diff % 7} days`;
    resDdHours.textContent = `${(diff * 24).toLocaleString()} hrs`;
    resDdCard.classList.remove('hidden');
  }

  btnDdCalc.addEventListener('click', executeDdCalc);

  btnDdClear.addEventListener('click', () => {
    ddStart.value = '2026-01-01';
    ddEnd.value = '2026-01-02';
    chkDdIncludeEnd.checked = false;
    resDdCard.classList.add('hidden');
  });

  // ==========================================
  // 8. DATE & TIME (+ / -)
  // ==========================================
  const dtcStart = document.getElementById('dtc-start');
  const dtcOp = document.getElementById('dtc-op');
  const dtcY = document.getElementById('dtc-y');
  const dtcM = document.getElementById('dtc-m');
  const dtcD = document.getElementById('dtc-d');
  const dtcH = document.getElementById('dtc-h');
  const dtcMin = document.getElementById('dtc-min');
  const dtcS = document.getElementById('dtc-s');
  const btnDtcCalc = document.getElementById('btn-dtc-calc');
  const btnDtcClear = document.getElementById('btn-dtc-clear');
  const resDtcCard = document.getElementById('res-dtc-card');
  const resDtcFormatted = document.getElementById('res-dtc-formatted');

  function executeDtcCalc() {
    const d = new Date(dtcStart.value);
    if (isNaN(d.getTime())) return;

    const factor = dtcOp.value === 'add' ? 1 : -1;
    const y = parseInt(dtcY.value) || 0;
    const mo = parseInt(dtcM.value) || 0;
    const days = parseInt(dtcD.value) || 0;
    const h = parseInt(dtcH.value) || 0;
    const min = parseInt(dtcMin.value) || 0;
    const s = parseInt(dtcS.value) || 0;

    if (y) d.setFullYear(d.getFullYear() + factor * y);
    if (mo) d.setMonth(d.getMonth() + factor * mo);
    if (days) d.setDate(d.getDate() + factor * days);
    if (h) d.setHours(d.getHours() + factor * h);
    if (min) d.setMinutes(d.getMinutes() + factor * min);
    if (s) d.setSeconds(d.getSeconds() + factor * s);

    const formatted = d.toLocaleString('en-US', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });

    resDtcFormatted.textContent = formatted;
    resDtcCard.classList.remove('hidden');
  }

  btnDtcCalc.addEventListener('click', executeDtcCalc);

  btnDtcClear.addEventListener('click', () => {
    dtcStart.value = '2026-09-01T00:00';
    dtcY.value = '0';
    dtcM.value = '0';
    dtcD.value = '0';
    dtcH.value = '0';
    dtcMin.value = '0';
    dtcS.value = '0';
    resDtcCard.classList.add('hidden');
  });

  // ==========================================
  // 9. USPS DELIVERY TIME ESTIMATOR
  // ==========================================
  const uspsShipDate = document.getElementById('usps-ship-date');
  const uspsService = document.getElementById('usps-service');
  const uspsHandling = document.getElementById('usps-handling');
  const btnUspsCalc = document.getElementById('btn-usps-calc');
  const btnUspsClear = document.getElementById('btn-usps-clear');
  const resUspsCard = document.getElementById('res-usps-card');
  const resUspsWindow = document.getElementById('res-usps-window');

  function executeUspsCalc() {
    const ship = new Date(uspsShipDate.value + 'T12:00:00');
    if (isNaN(ship.getTime())) return;

    const handling = parseInt(uspsHandling.value) || 0;
    const dispatch = new Date(ship);
    let hAdded = 0;
    while (hAdded < handling) {
      dispatch.setDate(dispatch.getDate() + 1);
      if (dispatch.getDay() !== 0) hAdded++;
    }

    let minT = 2;
    let maxT = 5;
    if (uspsService.value === 'priority') { minT = 1; maxT = 3; }
    else if (uspsService.value === 'priority_express') { minT = 1; maxT = 2; }

    function addBiz(base, count) {
      const d = new Date(base);
      let added = 0;
      while (added < count) {
        d.setDate(d.getDate() + 1);
        if (d.getDay() !== 0) added++; // Skip Sunday
      }
      return d;
    }

    const minDate = addBiz(dispatch, minT);
    const maxDate = addBiz(dispatch, maxT);

    const opt = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
    resUspsWindow.textContent = `${minDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} – ${maxDate.toLocaleDateString('en-US', opt)}`;
    resUspsCard.classList.remove('hidden');
  }

  btnUspsCalc.addEventListener('click', executeUspsCalc);

  btnUspsClear.addEventListener('click', () => {
    uspsShipDate.value = '2026-09-01';
    uspsHandling.value = '1';
    resUspsCard.classList.add('hidden');
  });

  // ==========================================
  // PRESET CLICKS
  // ==========================================
  document.querySelectorAll('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      switchTab(target);

      if (target === 'tab-time-op') {
        const [h1, m1, s1] = btn.getAttribute('data-p1').split(',');
        const [h2, m2, s2] = btn.getAttribute('data-p2').split(',');
        topH1.value = h1; topM1.value = m1; topS1.value = s1;
        topH2.value = h2; topM2.value = m2; topS2.value = s2;
        executeTopCalc();
      } else if (target === 'tab-work-time') {
        workStart.value = btn.getAttribute('data-start');
        workEnd.value = btn.getAttribute('data-end');
        workBreak.value = btn.getAttribute('data-break');
        executeWorkCalc();
      } else if (target === 'tab-between-times') {
        betweenStart.value = btn.getAttribute('data-t1');
        betweenEnd.value = btn.getAttribute('data-t2');
        executeBetweenCalc();
      } else if (target === 'tab-time-hours') {
        thDays.value = btn.getAttribute('data-d');
        thHours.value = btn.getAttribute('data-h');
        thMins.value = btn.getAttribute('data-m');
        executeThCalc();
      } else if (target === 'tab-date-diff') {
        ddStart.value = btn.getAttribute('data-sd');
        ddEnd.value = btn.getAttribute('data-ed');
        executeDdCalc();
      }
    });
  });

  // Enter Key Handler for all forms
  document.querySelectorAll('form').forEach((form) => {
    form.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) submitBtn.click();
        }
      });
    });
  });
</script>
