---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Date & Time Calculator – Calculate Time, Work Hours and Date Differences"
  description="Free online Date & Time calculator. Add and subtract time, calculate work hours with breaks, elapsed time between two times/dates, convert time to decimal hours, working days, and USPS delivery date estimates."
  category="General"
  calculatorName="Date & Time Calculator"
  slug="time-calculator"
  keywords={[
    'time calculator',
    'work time calculator',
    'time calculator work',
    'date and time calculator',
    'usps delivery time calculator',
    'add time calculator',
    'elapsed time calculator',
    'time calculator hours',
    'time calculator between two times',
    'time calculator in hours',
    'date difference calculator',
    'business days calculator'
  ]}
>
  <div class="space-y-6">

    <!-- TOP CALCULATOR MODE TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-tab-mode active shrink-0 rounded-lg bg-blue-600 px-3 py-1.5 font-bold text-white shadow-xs cursor-pointer" data-tab="tab-time-op">Time Calculator</button>
        <button type="button" class="btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-add-multi">Add Multiple Times</button>
        <button type="button" class="btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-work-time">Work Time & Shifts</button>
        <button type="button" class="btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-between-times">Time Between Times</button>
        <button type="button" class="btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-time-hours">Time in Hours</button>
        <button type="button" class="btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-elapsed-time">Elapsed Time</button>
        <button type="button" class="btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-date-diff">Date Difference</button>
        <button type="button" class="btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-date-time-calc">Date & Time (+/-)</button>
        <button type="button" class="btn-tab-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-tab="tab-usps-delivery">USPS Delivery 📦</button>
      </div>
    </div>

    <!-- QUICK PRESETS BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="font-bold text-slate-600 dark:text-slate-400 mr-1 flex items-center gap-1">
          <span>⚡</span> Quick Presets:
        </span>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-time-op" data-p1="2,45,30" data-op="add" data-p2="1,30,45">Add: 2h 45m + 1h 30m</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-work-time" data-start="09:00" data-end="17:30" data-break="30">Work: 9:00 AM – 5:30 PM (30m break)</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-work-time" data-start="22:00" data-end="06:00" data-break="30">Overnight: 10:00 PM – 6:00 AM</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-between-times" data-t1="09:30" data-t2="17:45">Between: 9:30 AM – 5:45 PM</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-time-hours" data-d="2" data-h="5" data-m="30">Hours: 2d 5h 30m</button>
        <button type="button" class="btn-preset rounded-lg border border-slate-300 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer" data-target="tab-date-diff" data-sd="2026-01-01" data-ed="2026-12-31">Date: Jan 1 – Dec 31, 2026</button>
      </div>
    </div>

    <!-- MAIN CALCULATOR PANELS CONTAINER -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-slate-50 to-blue-50/30 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-blue-950/20 sm:p-7">
      
      <!-- 1. TIME CALCULATOR (ADD / SUBTRACT) -->
      <div id="panel-tab-time-op" class="calc-panel space-y-4">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h3 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>⏱️</span> Time Calculator – Add or Subtract Two Times
          </h3>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Add or subtract hours, minutes, and seconds with exact normalized time and decimal breakdown.
          </p>
        </div>

        <form id="form-time-op" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-12 items-center">
            
            <!-- Time 1 -->
            <div class="sm:col-span-4 rounded-2xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Starting Time</span>
              <div class="mt-2 grid grid-cols-3 gap-2 text-center text-xs">
                <div>
                  <label for="top-h1" class="text-[10px] font-semibold text-slate-500">Hours</label>
                  <input type="number" id="top-h1" value="2" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                  <label for="top-m1" class="text-[10px] font-semibold text-slate-500">Minutes</label>
                  <input type="number" id="top-m1" value="45" min="0" max="59" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                  <label for="top-s1" class="text-[10px] font-semibold text-slate-500">Seconds</label>
                  <input type="number" id="top-s1" value="30" min="0" max="59" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
              </div>
            </div>

            <!-- Operation Selector -->
            <div class="sm:col-span-4 flex items-center justify-center">
              <div class="flex gap-1.5 rounded-2xl border border-slate-200 bg-white p-1.5 dark:border-slate-800 dark:bg-slate-900">
                <button type="button" id="btn-top-op-add" class="btn-top-op active rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-xs cursor-pointer">＋ Add</button>
                <button type="button" id="btn-top-op-sub" class="btn-top-op rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer">－ Subtract</button>
              </div>
            </div>

            <!-- Time 2 -->
            <div class="sm:col-span-4 rounded-2xl border border-slate-200 bg-white p-3.5 dark:border-slate-800 dark:bg-slate-900">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Time to Add / Subtract</span>
              <div class="mt-2 grid grid-cols-3 gap-2 text-center text-xs">
                <div>
                  <label for="top-h2" class="text-[10px] font-semibold text-slate-500">Hours</label>
                  <input type="number" id="top-h2" value="1" min="0" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                  <label for="top-m2" class="text-[10px] font-semibold text-slate-500">Minutes</label>
                  <input type="number" id="top-m2" value="30" min="0" max="59" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
                <div>
                  <label for="top-s2" class="text-[10px] font-semibold text-slate-500">Seconds</label>
                  <input type="number" id="top-s2" value="45" min="0" max="59" class="mt-1 w-full rounded-xl border border-slate-300 bg-white p-2 font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
              </div>
            </div>

          </div>

          <!-- Buttons -->
          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-top-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition active:scale-[0.98] cursor-pointer">
              Calculate Time →
            </button>
            <button type="button" id="btn-top-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <p id="err-top" class="hidden rounded-xl border border-red-200 bg-red-50 p-2.5 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300" role="alert" aria-live="polite"></p>

          <!-- Result -->
          <div id="res-top-card" class="hidden rounded-2xl border border-blue-200 bg-blue-50/50 p-4 dark:border-blue-900/60 dark:bg-slate-900">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Total Calculated Duration</span>
            <div id="res-top-formatted" class="mt-1 text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400">4 Hours 16 Minutes 15 Seconds</div>
            <div class="mt-3 grid grid-cols-3 gap-2 text-xs">
              <div class="rounded-xl bg-white p-2.5 text-center dark:bg-slate-800">
                <span class="text-slate-500">Decimal Hours</span>
                <div id="res-top-decimal" class="font-bold text-slate-900 dark:text-white">4.2708 hrs</div>
              </div>
              <div class="rounded-xl bg-white p-2.5 text-center dark:bg-slate-800">
                <span class="text-slate-500">Total Minutes</span>
                <div id="res-top-minutes" class="font-bold text-slate-900 dark:text-white">256.25 mins</div>
              </div>
              <div class="rounded-xl bg-white p-2.5 text-center dark:bg-slate-800">
                <span class="text-slate-500">Total Seconds</span>
                <div id="res-top-seconds" class="font-bold text-slate-900 dark:text-white">15,375 s</div>
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- 2. ADD MULTIPLE TIMES -->
      <div id="panel-tab-add-multi" class="calc-panel hidden space-y-4">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
                <span>➕</span> Add Multiple Times (Sum Calculator)
              </h3>
              <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
                Add multiple time entries together (e.g., timesheets, video track lengths, race splits).
              </p>
            </div>
            <button type="button" id="btn-add-multi-row" class="rounded-lg bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700 hover:bg-blue-100 dark:bg-blue-950 dark:text-blue-300 cursor-pointer">
              + Add Time Entry
            </button>
          </div>
        </div>

        <form id="form-add-multi" class="space-y-3" novalidate onsubmit="return false;">
          <div id="multi-rows-container" class="space-y-2">
            <div class="multi-row grid grid-cols-3 gap-2">
              <input type="number" placeholder="Hours" class="m-h rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="2" min="0" />
              <input type="number" placeholder="Minutes" class="m-m rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="45" min="0" max="59" />
              <input type="number" placeholder="Seconds" class="m-s rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="0" min="0" max="59" />
            </div>
            <div class="multi-row grid grid-cols-3 gap-2">
              <input type="number" placeholder="Hours" class="m-h rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="3" min="0" />
              <input type="number" placeholder="Minutes" class="m-m rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="15" min="0" max="59" />
              <input type="number" placeholder="Seconds" class="m-s rounded-xl border border-slate-300 bg-white p-2 text-xs font-bold text-center dark:border-slate-700 dark:bg-slate-800 dark:text-white" value="30" min="0" max="59" />
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-multi-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition active:scale-[0.98] cursor-pointer">
              Add All Times →
            </button>
            <button type="button" id="btn-multi-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <div id="res-multi-card" class="hidden rounded-2xl border border-blue-200 bg-blue-50/50 p-4 dark:border-blue-900/60 dark:bg-slate-900">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Combined Total Time</span>
            <div id="res-multi-formatted" class="mt-1 text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400">6 Hours 0 Minutes 30 Seconds</div>
            <div class="mt-3 grid grid-cols-3 gap-2 text-xs">
              <div class="rounded-xl bg-white p-2.5 text-center dark:bg-slate-800"><span class="text-slate-500">Total Hours</span><div id="res-multi-decimal" class="font-bold text-slate-900 dark:text-white">6.0083 hrs</div></div>
              <div class="rounded-xl bg-white p-2.5 text-center dark:bg-slate-800"><span class="text-slate-500">Total Minutes</span><div id="res-multi-minutes" class="font-bold text-slate-900 dark:text-white">360.5 mins</div></div>
              <div class="rounded-xl bg-white p-2.5 text-center dark:bg-slate-800"><span class="text-slate-500">Total Seconds</span><div id="res-multi-seconds" class="font-bold text-slate-900 dark:text-white">21,630 s</div></div>
            </div>
          </div>
        </form>
      </div>

      <!-- 3. WORK TIME CALCULATOR -->
      <div id="panel-tab-work-time" class="calc-panel hidden space-y-4">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h3 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>💼</span> Work Time Calculator (Shifts & Timesheet)
          </h3>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Calculate gross shift hours, deduct lunch/unpaid breaks, compute net payable working hours and overtime.
          </p>
        </div>

        <form id="form-work-time" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <div>
              <label for="work-start" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Shift Start Time</label>
              <input type="time" id="work-start" value="09:00" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="work-end" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Shift End Time</label>
              <input type="time" id="work-end" value="17:30" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="work-break" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Unpaid Break (Minutes)</label>
              <input type="number" id="work-break" value="30" min="0" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <div>
              <label for="work-ot" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Daily Standard (OT after)</label>
              <input type="number" id="work-ot" value="8" min="1" step="0.5" class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button type="submit" id="btn-work-calc" class="flex-1 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition active:scale-[0.98] cursor-pointer">
              Calculate Work Hours →
            </button>
            <button type="button" id="btn-work-clear" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">
              Clear (✕)
            </button>
          </div>

          <div id="res-work-card" class="hidden rounded-2xl border border-blue-200 bg-blue-50/50 p-4 dark:border-blue-900/60 dark:bg-slate-900">
            <div class="flex items-center justify-between border-b border-blue-200/80 pb-2 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Net Payable Work Time</span>
              <span id="res-work-overnight-badge" class="hidden rounded-full bg-indigo-100 px-2.5 py-0.5 text-[10px] font-bold text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">Overnight Shift (Next Day)</span>
            </div>
            <div class="mt-2 flex flex-wrap items-baseline gap-3">
              <span id="res-work-net" class="text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400">8 Hours 0 Minutes</span>
              <span id="res-work-decimal" class="text-sm font-bold text-slate-600 dark:text-slate-300">(8.00 decimal hrs)</span>
            </div>
            <div class="mt-3 grid grid-cols-3 gap-2 text-xs">
              <div class="rounded-xl bg-white p-2.5 dark:bg-slate-800"><span class="text-slate-500">Gross Shift:</span><div id="res-work-gross" class="font-bold text-slate-900 dark:text-white">8h 30m</div></div>
              <div class="rounded-xl bg-white p-2.5 dark:bg-slate-800"><span class="text-slate-500">Break Deducted:</span><div id="res-work-break-val" class="font-bold text-slate-900 dark:text-white">30 mins</div></div>
              <div class="rounded-xl bg-white p-2.5 dark:bg-slate-800"><span class="text-slate-500">Overtime Hours:</span><div id="res-work-ot-val" class="font-bold text-emerald-600 dark:text-emerald-400">0.00 hrs</div></div>
            </div>
          </div>
        </form>
      </div>

      <!-- 4. TIME BETWEEN TWO TIMES -->
      <div id="panel-tab-between-times" class="calc-panel hidden space-y-4">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h3 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>⌛</span> Time Between Two Times
          </h3>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Find the exact hours and minutes elapsed from a starting time to an ending time.
          </p>
        </div>

        <form id="form-between" class="space-y-4" novalidate onsubmit="return false;">
