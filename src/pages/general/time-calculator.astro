<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script is:inline>
(function () {
  'use strict';

  /* =========================================================
     SHARED HELPERS
     ========================================================= */
  var $ = function (id) { return document.getElementById(id); };

  function num(el) {
    if (!el) return 0;
    var v = parseFloat(el.value);
    return isNaN(v) || !isFinite(v) ? 0 : v;
  }

  function pad(n) { return String(n).padStart(2, '0'); }

  function plural(n, word) { return n + ' ' + word + (n === 1 ? '' : 's'); }

  // "1 Day 4 Hours 16 Minutes 15 Seconds" — hours are omitted only for sub-hour spans
  function fmtLong(totalSec) {
    totalSec = Math.round(totalSec);
    var d = Math.floor(totalSec / 86400);
    var h = Math.floor((totalSec % 86400) / 3600);
    var m = Math.floor((totalSec % 3600) / 60);
    var s = totalSec % 60;
    var parts = [];
    if (d > 0) parts.push(plural(d, 'Day'));
    if (d > 0 || h > 0) parts.push(plural(h, 'Hour'));
    parts.push(plural(m, 'Minute'));
    parts.push(plural(s, 'Second'));
    return parts.join(' ');
  }

  // "0d 04:16:15"
  function fmtClock(totalSec) {
    totalSec = Math.round(totalSec);
    var d = Math.floor(totalSec / 86400);
    var h = Math.floor((totalSec % 86400) / 3600);
    var m = Math.floor((totalSec % 3600) / 60);
    var s = totalSec % 60;
    return d + 'd ' + pad(h) + ':' + pad(m) + ':' + pad(s);
  }

  // "04:16:15"
  function fmtHMS(totalSec) {
    totalSec = Math.round(totalSec);
    var h = Math.floor(totalSec / 3600);
    var m = Math.floor((totalSec % 3600) / 60);
    var s = totalSec % 60;
    return pad(h) + ':' + pad(m) + ':' + pad(s);
  }

  function fmt12(hhmm) {
    var bits = hhmm.split(':');
    var h = parseInt(bits[0], 10) || 0;
    var m = parseInt(bits[1], 10) || 0;
    var suffix = h >= 12 ? 'PM' : 'AM';
    var h12 = h % 12;
    if (h12 === 0) h12 = 12;
    return h12 + ':' + pad(m) + ' ' + suffix;
  }

  function fmtNum(n, dec) {
    if (!isFinite(n)) return '--';
    return Number(n).toLocaleString('en-US', {
      minimumFractionDigits: dec === undefined ? 0 : dec,
      maximumFractionDigits: dec === undefined ? 2 : dec
    });
  }

  function fmtDate(date, opts) {
    try {
      return date.toLocaleDateString('en-US', opts);
    } catch (e) {
      return date.toDateString();
    }
  }

  function dayName(date) {
    return ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][date.getDay()];
  }

  function todayYmd() {
    var t = new Date();
    return t.getFullYear() + '-' + pad(t.getMonth() + 1) + '-' + pad(t.getDate());
  }

  function setErr(id, msg) {
    var el = $(id);
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  function clearErr(id) {
    var el = $(id);
    if (!el) return;
    el.textContent = '';
    el.classList.add('hidden');
  }

  function show(cardId) {
    var card = $(cardId);
    if (card) card.classList.remove('hidden');
  }

  function hide(cardId) {
    var card = $(cardId);
    if (card) card.classList.add('hidden');
  }

  // Guard against NaN / Infinity leaking into the UI
  function safeSet(id, value) {
    var el = $(id);
    if (!el) return;
    var txt = String(value);
    el.textContent = txt;
    if (txt.indexOf('NaN') !== -1 || txt.indexOf('Infinity') !== -1) {
      el.textContent = '--';
      if (window.__reportCalculatorAnomaly) {
        window.__reportCalculatorAnomaly('CalculationAnomaly', id + ' produced ' + txt);
      }
    }
  }

  // Parses "YYYY-MM-DD" into a local-midnight Date (avoids UTC shift bugs)
  function parseYmd(str) {
    if (!str) return null;
    var p = str.split('-');
    if (p.length !== 3) return null;
    var d = new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10), 0, 0, 0, 0);
    return isNaN(d.getTime()) ? null : d;
  }

  /* =========================================================
     TAB SWITCHING
     ========================================================= */
  var tabButtons = document.querySelectorAll('.tab-mode-btn');
  var calcPanels = document.querySelectorAll('.calc-panel');

  function switchTab(tabId) {
    tabButtons.forEach(function (btn) {
      var on = btn.getAttribute('data-tab') === tabId;
      btn.classList.toggle('active', on);
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    calcPanels.forEach(function (panel) {
      panel.classList.toggle('hidden', panel.id !== 'panel-' + tabId);
    });
  }

  tabButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      switchTab(btn.getAttribute('data-tab'));
    });
  });

  if (window.location.hash) {
    var hash = window.location.hash.replace('#', '');
    if (document.getElementById('panel-' + hash)) switchTab(hash);
  }

  /* =========================================================
     COPY BUTTONS (delegated)
     ========================================================= */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.btn-copy');
    if (!btn) return;
    var payload = $(btn.getAttribute('data-copy-target'));
    if (!payload) return;
    var text = payload.textContent.trim();
    if (!text) return;

    var done = function () {
      var original = btn.innerHTML;
      btn.innerHTML = '✅ Copied';
      setTimeout(function () { btn.innerHTML = original; }, 1800);
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(function () { done(); });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch (err) {}
      document.body.removeChild(ta);
      done();
    }
  });

  /* =========================================================
     1. TIME CALCULATOR (ADD / SUBTRACT)
     ========================================================= */
  var topOp = 'add';
  var btnTopOpAdd = $('btn-top-op-add');
  var btnTopOpSub = $('btn-top-op-sub');

  [btnTopOpAdd, btnTopOpSub].forEach(function (btn) {
    btn.addEventListener('click', function () {
      topOp = btn.getAttribute('data-op');
      btnTopOpAdd.classList.toggle('active', topOp === 'add');
      btnTopOpSub.classList.toggle('active', topOp === 'subtract');
    });
  });

  document.querySelectorAll('.btn-now-time').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var now = new Date();
      $(btn.getAttribute('data-h')).value = now.getHours();
      $(btn.getAttribute('data-m')).value = now.getMinutes();
      $(btn.getAttribute('data-s')).value = now.getSeconds();
    });
  });

  function executeTopCalc() {
    clearErr('err-top');

    var s1 = num($('top-h1')) * 3600 + num($('top-m1')) * 60 + num($('top-s1'));
    var s2 = num($('top-h2')) * 3600 + num($('top-m2')) * 60 + num($('top-s2'));
    var mult = Math.max(1, Math.floor(num($('top-mult')) || 1));
    s2 = s2 * mult;

    if (s1 === 0 && s2 === 0) {
      setErr('err-top', 'Please enter at least one non-zero time value.');
      hide('res-top-card');
      return;
    }

    var raw = topOp === 'add' ? s1 + s2 : s1 - s2;
    var isNeg = raw < 0;
    var abs = Math.abs(raw);
    var sign = isNeg ? '-' : '';

    safeSet('res-top-formatted', (isNeg ? 'minus ' : '') + fmtLong(abs));
    safeSet('res-top-norm', 'Normalized → ' + sign + fmtClock(abs));

    safeSet('res-top-weeks', sign + fmtNum(abs / 604800, 4));
    safeSet('res-top-days', sign + fmtNum(abs / 86400, 4));
    safeSet('res-top-decimal', sign + fmtNum(abs / 3600, 4) + ' hrs');
    safeSet('res-top-minutes', sign + fmtNum(abs / 60, 2) + ' mins');
    safeSet('res-top-seconds', sign + fmtNum(abs, 0) + ' s');
    safeSet('res-top-ms', sign + fmtNum(abs * 1000, 0) + ' ms');

    var warn = $('res-top-warn');
    if (isNeg) {
      warn.textContent = '⚠ The subtracted time is larger than the starting time, so the result is a negative duration.';
      warn.classList.remove('hidden');
    } else {
      warn.classList.add('hidden');
    }

    var multText = mult > 1 ? ' (Time 2 × ' + mult + ')' : '';
    safeSet('res-top-formula',
      'Time 1 = ' + fmtHMS(s1) + ' (' + fmtNum(s1 / 3600, 4) + ' hrs)\n' +
      'Time 2 = ' + fmtHMS(s2 / mult) + multText + ' = ' + fmtHMS(s2) + '\n' +
      (topOp === 'add' ? 'Add' : 'Subtract') + ': ' + fmtHMS(s1) + ' ' + (topOp === 'add' ? '+' : '−') + ' ' + fmtHMS(s2) + ' = ' + sign + fmtHMS(abs) + '\n' +
      'Normalized: ' + sign + fmtClock(abs) + '  |  Decimal: ' + sign + fmtNum(abs / 3600, 4) + ' hrs'
    );

    safeSet('copy-top',
      'Time Calculator (' + (topOp === 'add' ? 'Addition' : 'Subtraction') + ')\n' +
      'Result: ' + sign + fmtLong(abs) + '\n' +
      'Normalized: ' + sign + fmtClock(abs) + '\n' +
      'Decimal Hours: ' + sign + fmtNum(abs / 3600, 4) + ' hrs\n' +
      'Total Minutes: ' + sign + fmtNum(abs / 60, 2) + '\n' +
      'Total Seconds: ' + sign + fmtNum(abs, 0) + '\n' +
      'Calculated via aifreecalculator.com/general/time-calculator/'
    );

    show('res-top-card');
  }

  $('form-time-op').addEventListener('submit', function (e) {
    e.preventDefault();
    executeTopCalc();
  });

  $('btn-top-clear').addEventListener('click', function () {
    ['top-h1', 'top-m1', 'top-s1', 'top-h2', 'top-m2', 'top-s2'].forEach(function (id) { $(id).value = '0'; });
    $('top-mult').value = '1';
    clearErr('err-top');
    hide('res-top-card');
  });

  /* =========================================================
     2. SUM OF MULTIPLE TIMES
     ========================================================= */
  var multiRows = $('multi-rows-container');

  function renumberRows() {
    multiRows.querySelectorAll('.multi-row').forEach(function (row, i) {
      var idx = row.querySelector('.row-index');
      if (idx) idx.textContent = i + 1;
    });
  }

  function makeRow(h, m, s) {
    var row = document.createElement('div');
    row.className = 'multi-row';
    row.innerHTML =
      '<span class="row-index"></span>' +
      '<input type="number" placeholder="HH" class="m-h num-field" value="' + h + '" min="0" />' +
      '<input type="number" placeholder="MM" class="m-m num-field" value="' + m + '" min="0" max="59" />' +
      '<input type="number" placeholder="SS" class="m-s num-field" value="' + s + '" min="0" max="59" />' +
      '<button type="button" class="row-del" title="Remove entry">&times;</button>';
    return row;
  }

  $('btn-add-multi-row').addEventListener('click', function () {
    multiRows.appendChild(makeRow(1, 30, 0));
    renumberRows();
  });

  multiRows.addEventListener('click', function (e) {
    var del = e.target.closest('.row-del');
    if (!del) return;
    if (multiRows.querySelectorAll('.multi-row').length <= 1) return;
    del.closest('.multi-row').remove();
    renumberRows();
  });

  renumberRows();

  function executeMultiCalc() {
    clearErr('err-multi');
    var totalSec = 0;
    var count = 0;

    multiRows.querySelectorAll('.multi-row').forEach(function (row) {
      var h = num(row.querySelector('.m-h'));
      var m = num(row.querySelector('.m-m'));
      var s = num(row.querySelector('.m-s'));
      var sec = h * 3600 + m * 60 + s;
      if (sec > 0) {
        totalSec += sec;
        count++;
      }
    });

    if (totalSec <= 0) {
      setErr('err-multi', 'Please enter at least one time entry greater than zero.');
      hide('res-multi-card');
      return;
    }

    safeSet('res-multi-formatted', fmtLong(totalSec));
    safeSet('res-multi-norm', 'Normalized → ' + fmtClock(totalSec));
    safeSet('res-multi-count', count + (count === 1 ? ' entry' : ' entries'));
    safeSet('res-multi-avg', fmtHMS(totalSec / count));
    safeSet('res-multi-decimal', fmtNum(totalSec / 3600, 4) + ' hrs');
    safeSet('res-multi-minutes', fmtNum(totalSec / 60, 2) + ' mins');
    safeSet('res-multi-seconds', fmtNum(totalSec, 0) + ' s');
    safeSet('res-multi-workdays', fmtNum(totalSec / 28800, 2) + ' days');

    safeSet('copy-multi',
      'Sum of Multiple Times\n' +
      'Total: ' + fmtLong(totalSec) + '\n' +
      'Normalized: ' + fmtClock(totalSec) + '\n' +
      'Entries: ' + count + '\n' +
      'Average per entry: ' + fmtHMS(totalSec / count) + '\n' +
      'Decimal Hours: ' + fmtNum(totalSec / 3600, 4) + '\n' +
      'Total Minutes: ' + fmtNum(totalSec / 60, 2) + '\n' +
      'Calculated via aifreecalculator.com/general/time-calculator/'
    );

    show('res-multi-card');
  }

