  .elec-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.5rem; font-weight: 800; color: #0f172a; }
  .elec-content h2:first-child { margin-top: 0; }
  .elec-content p { margin: 0 0 1rem; line-height: 1.75; color: #475569; }
