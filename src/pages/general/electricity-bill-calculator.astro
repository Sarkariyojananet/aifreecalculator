  :global(.dark) .elec-content p, :global(.dark) .elec-content li { color: #cbd5e1; }
</style>

<script is:inline>
  const elecTabs = document.querySelectorAll('.btn-elec-tab');
  const elecPanels = document.querySelectorAll('.elec-panel');
  const elecResults = document.getElementById('elec-results');

  elecTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      elecTabs.forEach(t => { t.classList.remove('bg-yellow-500','text-white','shadow-xs'); t.classList.add('border','border-slate-300','bg-white','text-slate-700','dark:border-slate-700','dark:bg-slate-800','dark:text-slate-200'); });
      tab.classList.add('bg-yellow-500','text-white','shadow-xs');
      tab.classList.remove('border','border-slate-300','bg-white','text-slate-700');
      elecPanels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + tab.dataset.tab)?.classList.remove('hidden');
      elecResults?.classList.add('hidden');
    });
  });

  document.querySelectorAll('.btn-state-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('elec-rate').value = btn.dataset.rate;
    });
  });

  function fmtINR(n) { return '₹' + Math.round(n).toLocaleString('en-IN'); }

  document.getElementById('form-elec-units')?.addEventListener('submit', () => {
    const units = parseFloat(document.getElementById('elec-units').value);
    const rate = parseFloat(document.getElementById('elec-rate').value);
    const fixed = parseFloat(document.getElementById('elec-fixed').value) || 0;
    const taxPct = parseFloat(document.getElementById('elec-tax').value) || 0;
    const energyCharge = units * rate;
    const tax = energyCharge * taxPct / 100;
    const total = energyCharge + fixed + tax;

    document.getElementById('elec-res-total').textContent = fmtINR(total);
    document.getElementById('elec-res-annual').textContent = fmtINR(total * 12) + '/year';
    document.getElementById('elec-res-units').textContent = units + ' kWh';
    document.getElementById('elec-res-energy').textContent = fmtINR(energyCharge);
    document.getElementById('elec-res-fixed').textContent = fmtINR(fixed + tax);
    document.getElementById('elec-res-per-day').textContent = fmtINR(total / 30) + '/day';

    elecResults.classList.remove('hidden');
    elecResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  document.getElementById('btn-elec-clear')?.addEventListener('click', () => elecResults?.classList.add('hidden'));

  // Setup appliance rows
  const appliances = [
    { name: 'Air Conditioner (1.5T)', watts: 1500, qty: 1, hrs: 8 },
    { name: 'Refrigerator', watts: 150, qty: 1, hrs: 24 },
    { name: 'Washing Machine', watts: 500, qty: 1, hrs: 1 },
    { name: 'LED TV (43-inch)', watts: 80, qty: 1, hrs: 5 },
    { name: 'Ceiling Fan', watts: 75, qty: 3, hrs: 10 },
    { name: 'Geyser (15L)', watts: 2000, qty: 1, hrs: 0.5 },
    { name: 'LED Bulbs (10W)', watts: 10, qty: 8, hrs: 6 },
    { name: 'Laptop', watts: 65, qty: 1, hrs: 8 },
  ];

  const tbody = document.getElementById('appliance-rows');
  if (tbody) {
    appliances.forEach((app, i) => {
      const row = document.createElement('div');
      row.className = 'grid grid-cols-4 gap-2 items-center';
      row.innerHTML = `<span class="text-xs font-semibold text-slate-700 dark:text-slate-300 truncate">${app.name}</span>
        <input type="number" class="app-watts rounded-lg border border-slate-300 p-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 text-center" value="${app.watts}" />
        <input type="number" class="app-qty rounded-lg border border-slate-300 p-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 text-center" value="${app.qty}" min="0" />
        <input type="number" class="app-hrs rounded-lg border border-slate-300 p-1.5 text-xs font-bold dark:border-slate-700 dark:bg-slate-800 text-center" value="${app.hrs}" step="0.5" />`;
      tbody.appendChild(row);
    });
  }

  document.getElementById('form-appliance')?.addEventListener('submit', () => {
    const rate = parseFloat(document.getElementById('app-rate').value) || 6.5;
    const wattsEls = document.querySelectorAll('.app-watts');
    const qtyEls = document.querySelectorAll('.app-qty');
    const hrsEls = document.querySelectorAll('.app-hrs');
    let totalKWh = 0;
    for (let i = 0; i < wattsEls.length; i++) {
      const w = parseFloat(wattsEls[i].value) || 0;
      const q = parseFloat(qtyEls[i].value) || 0;
      const h = parseFloat(hrsEls[i].value) || 0;
      totalKWh += (w / 1000) * q * h * 30; // monthly
    }
    const total = totalKWh * rate;
    document.getElementById('elec-res-total').textContent = fmtINR(total);
    document.getElementById('elec-res-annual').textContent = fmtINR(total * 12) + '/year';
    document.getElementById('elec-res-units').textContent = Math.round(totalKWh) + ' kWh/month';
    document.getElementById('elec-res-energy').textContent = fmtINR(totalKWh * rate);
    document.getElementById('elec-res-fixed').textContent = 'Fixed not included';
    document.getElementById('elec-res-per-day').textContent = fmtINR(total / 30) + '/day';
    elecResults.classList.remove('hidden');
    elecResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  document.getElementById('btn-app-clear')?.addEventListener('click', () => elecResults?.classList.add('hidden'));
</script>

