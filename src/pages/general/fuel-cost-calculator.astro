    var targetCurrPrefix = document.getElementById('target-curr-prefix');
    if (targetCurrPrefix) targetCurrPrefix.textContent = currency;
    var targetPricePrefix = document.getElementById('target-price-prefix');
    if (targetPricePrefix) targetPricePrefix.textContent = currency;

    var tripDistLabel = document.getElementById('trip-dist-label');
    if (tripDistLabel) tripDistLabel.textContent = distUnit;

    var tripEconLabel = document.getElementById('trip-econ-label');
    if (tripEconLabel) {
      if (econUnit === 'kml') tripEconLabel.textContent = 'km/L';
      else if (econUnit === 'l100km') tripEconLabel.textContent = 'L/100km';
      else if (econUnit === 'ukmpg') tripEconLabel.textContent = 'UK MPG';
      else if (econUnit === 'usmpg') tripEconLabel.textContent = 'US MPG';
    }

    // Update unit toggle buttons
    var toggles = document.querySelectorAll('.unit-dist-toggle');
    toggles.forEach(function(t) {
      if (t.getAttribute('data-unit') === distUnit) {
        t.className = 'unit-dist-toggle text-amber-600 dark:text-amber-400 underline font-bold cursor-pointer';
      } else {
        t.className = 'unit-dist-toggle text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 cursor-pointer';
      }
    });
  }

  if (presetIndia) {
    presetIndia.addEventListener('click', function() {
      setActivePreset(presetIndia);
      updateRegionPresets('₹', 'km', 'kml');
    });
  }
  if (presetUk) {
    presetUk.addEventListener('click', function() {
      setActivePreset(presetUk);
      updateRegionPresets('£', 'miles', 'ukmpg');
    });
  }
  if (presetUs) {
    presetUs.addEventListener('click', function() {
      setActivePreset(presetUs);
      updateRegionPresets('$', 'miles', 'usmpg');
    });
  }
  if (presetEu) {
    presetEu.addEventListener('click', function() {
      setActivePreset(presetEu);
      updateRegionPresets('€', 'km', 'l100km');
    });
  }

  function setActivePreset(activeBtn) {
    var allPresets = document.querySelectorAll('.btn-preset-region');
    allPresets.forEach(function(p) {
      p.className = 'btn-preset-region rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition';
    });
    activeBtn.className = 'btn-preset-region active rounded-lg border border-amber-500 bg-amber-50 px-3 py-1.5 font-bold text-amber-800 hover:bg-amber-100 dark:border-amber-600 dark:bg-amber-950/40 dark:text-amber-300 cursor-pointer transition';
  }

  // Unit Dist Toggle
  var distToggles = document.querySelectorAll('.unit-dist-toggle');
  distToggles.forEach(function(dt) {
    dt.addEventListener('click', function() {
      var unit = dt.getAttribute('data-unit');
      currentDistanceUnit = unit;
      var tripDistLabel = document.getElementById('trip-dist-label');
      if (tripDistLabel) tripDistLabel.textContent = unit;

      distToggles.forEach(function(t) {
        if (t === dt) {
          t.className = 'unit-dist-toggle text-amber-600 dark:text-amber-400 underline font-bold cursor-pointer';
        } else {
          t.className = 'unit-dist-toggle text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 cursor-pointer';
        }
      });
    });
  });

  // Currency select change
  var tripCurrencySelect = document.getElementById('trip-currency');
  if (tripCurrencySelect) {
    tripCurrencySelect.addEventListener('change', function() {
      currentCurrency = tripCurrencySelect.value;
      var tripCurrPrefix = document.getElementById('trip-curr-prefix');
      if (tripCurrPrefix) tripCurrPrefix.textContent = currentCurrency;
    });
  }

  // Economy select change
  var tripEconomyUnitSelect = document.getElementById('trip-economy-unit');
  if (tripEconomyUnitSelect) {
    tripEconomyUnitSelect.addEventListener('change', function() {
      var val = tripEconomyUnitSelect.value;
      var label = document.getElementById('trip-econ-label');
      if (label) {
        if (val === 'kml') label.textContent = 'km/L';
        else if (val === 'l100km') label.textContent = 'L/100km';
        else if (val === 'ukmpg') label.textContent = 'UK MPG';
        else if (val === 'usmpg') label.textContent = 'US MPG';
      }
    });
  }

  // --- RESULT DISPLAY HELPER ---
  var resultsWrapper = document.getElementById('fuel-results');
  var resMainCost = document.getElementById('res-main-cost');
  var resTotalDist = document.getElementById('res-total-dist');
  var resRoundtripBadge = document.getElementById('res-roundtrip-badge');
  var resFuelLitres = document.getElementById('res-fuel-litres');
  var resFuelGallons = document.getElementById('res-fuel-gallons');
  var resCostPerKm = document.getElementById('res-cost-per-km');
  var resCostPerMile = document.getElementById('res-cost-per-mile');
  var resEffectiveEconomy = document.getElementById('res-effective-economy');
  var resStepsContainer = document.getElementById('res-steps-container');
  var heroTitleLabel = document.getElementById('hero-title-label');

  function showResults(data) {
    if (!resultsWrapper) return;
    resultsWrapper.classList.remove('hidden');

    if (heroTitleLabel) heroTitleLabel.textContent = data.heroTitle || 'Estimated Total Fuel Cost';
    if (resMainCost) resMainCost.textContent = data.mainCostFormatted;
    if (resTotalDist) resTotalDist.textContent = data.totalDistFormatted;
    
    if (resRoundtripBadge) {
      if (data.isRoundTrip) resRoundtripBadge.classList.remove('hidden');
      else resRoundtripBadge.classList.add('hidden');
    }

    if (resFuelLitres) resFuelLitres.textContent = formatNum(data.fuelLitres) + ' L';
    if (resFuelGallons) resFuelGallons.textContent = formatNum(data.fuelLitres * LITRES_TO_US_GAL) + ' gal (US)';
    
    if (resCostPerKm) resCostPerKm.textContent = formatMoney(data.costPerKm, data.currency) + '/km';
    if (resCostPerMile) resCostPerMile.textContent = formatMoney(data.costPerMile, data.currency) + '/mi';
    if (resEffectiveEconomy) resEffectiveEconomy.textContent = data.effectiveEconomyFormatted;

    // Steps
    if (resStepsContainer && data.steps && data.steps.length > 0) {
      resStepsContainer.innerHTML = '';
      data.steps.forEach(function(step) {
        var p = document.createElement('div');
        p.className = 'p-2 rounded bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700';
        p.innerHTML = '<span class="text-amber-600 dark:text-amber-400 font-bold">' + step.label + ':</span> ' + step.calc;
        resStepsContainer.appendChild(p);
      });
    }

    // Smooth scroll to results on mobile
    if (window.innerWidth < 640) {
      resultsWrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function hideResults() {
    if (resultsWrapper) resultsWrapper.classList.add('hidden');
  }

  // --- MODE 1: TRIP FORM SUBMIT ---
  var formTrip = document.getElementById('form-fuel-trip');
  var tripError = document.getElementById('trip-error');
  var btnTripReset = document.getElementById('btn-trip-reset');

  if (formTrip) {
    formTrip.addEventListener('submit', function(e) {
      e.preventDefault();
      if (tripError) tripError.classList.add('hidden');

      var distInput = document.getElementById('trip-distance');
      var econInput = document.getElementById('trip-economy');
      var priceInput = document.getElementById('trip-price');
      var roundtripCheck = document.getElementById('trip-roundtrip');
      var econUnit = document.getElementById('trip-economy-unit').value;
      var currency = document.getElementById('trip-currency').value;

      var rawDist = parseFloat(distInput ? distInput.value : '');
      var rawEcon = parseFloat(econInput ? econInput.value : '');
      var rawPrice = parseFloat(priceInput ? priceInput.value : '');
      var isRoundTrip = roundtripCheck ? roundtripCheck.checked : false;

      // Validation
      if (isNaN(rawDist) || rawDist <= 0) {
        showError(tripError, 'Please enter a valid trip distance greater than 0.');
        return;
      }
      if (isNaN(rawEcon) || rawEcon <= 0) {
        showError(tripError, 'Please enter a valid vehicle fuel economy greater than 0.');
        return;
      }
      if (isNaN(rawPrice) || rawPrice < 0) {
        showError(tripError, 'Please enter a valid fuel price (0 or greater).');
        return;
      }

      // 1. Normalize Distance to Kilometres
      var distanceKm = currentDistanceUnit === 'miles' ? rawDist * MILES_TO_KM : rawDist;
      var totalDistanceKm = isRoundTrip ? distanceKm * 2 : distanceKm;
      var totalDisplayDistance = isRoundTrip ? rawDist * 2 : rawDist;

      // 2. Normalize Fuel Economy to km/L
      var economyKmL = 0;
      if (econUnit === 'kml') {
        economyKmL = rawEcon;
      } else if (econUnit === 'l100km') {
        economyKmL = 100 / rawEcon;
      } else if (econUnit === 'ukmpg') {
        economyKmL = rawEcon * (MILES_TO_KM / 4.54609);
      } else if (econUnit === 'usmpg') {
        economyKmL = rawEcon * (MILES_TO_KM / 3.785411784);
      }

      if (economyKmL <= 0 || !isFinite(economyKmL)) {
        showError(tripError, 'Invalid fuel economy configuration. Please check your inputs.');
        return;
      }

      // 3. Compute Fuel Required & Total Cost
      var fuelRequiredLitres = totalDistanceKm / economyKmL;
      var totalFuelCost = fuelRequiredLitres * rawPrice;
      var costPerKm = totalDistanceKm > 0 ? totalFuelCost / totalDistanceKm : 0;
      var costPerMile = costPerKm * MILES_TO_KM;

      // 4. Generate dynamic calculation steps using user's actual entered values
      var steps = [];
      if (isRoundTrip) {
        steps.push({
          label: 'Total Distance',
          calc: rawDist + ' ' + currentDistanceUnit + ' × 2 (Round trip) = ' + totalDisplayDistance + ' ' + currentDistanceUnit + ' (' + formatNum(totalDistanceKm) + ' km)'
        });
      } else {
        steps.push({
          label: 'Total Distance',
          calc: totalDisplayDistance + ' ' + currentDistanceUnit + (currentDistanceUnit === 'miles' ? ' (' + formatNum(totalDistanceKm) + ' km)' : '')
        });
      }

      if (econUnit === 'l100km') {
        steps.push({
          label: 'Fuel Required (L/100 km)',
          calc: '(' + formatNum(totalDistanceKm) + ' km × ' + rawEcon + ' L/100km) ÷ 100 = ' + formatNum(fuelRequiredLitres, 4) + ' Litres'
        });
      } else if (econUnit === 'kml') {
        steps.push({
          label: 'Fuel Required',
          calc: formatNum(totalDistanceKm) + ' km ÷ ' + rawEcon + ' km/L = ' + formatNum(fuelRequiredLitres, 4) + ' Litres'
        });
      } else {
        steps.push({
          label: 'Fuel Required',
          calc: formatNum(totalDistanceKm) + ' km ÷ ' + formatNum(economyKmL, 4) + ' km/L (' + rawEcon + ' ' + econUnit.toUpperCase() + ') = ' + formatNum(fuelRequiredLitres, 4) + ' Litres'
        });
      }

      steps.push({
        label: 'Total Fuel Cost',
        calc: formatNum(fuelRequiredLitres, 4) + ' Litres × ' + formatMoney(rawPrice, currency) + '/L = ' + formatMoney(totalFuelCost, currency)
      });

      steps.push({
        label: 'Cost per Kilometre',
        calc: formatMoney(rawPrice, currency) + ' ÷ ' + formatNum(economyKmL, 2) + ' km/L = ' + formatMoney(costPerKm, currency) + '/km'
      });

      showResults({
        heroTitle: 'Estimated Total Fuel Cost',
        mainCostFormatted: formatMoney(totalFuelCost, currency),
        totalDistFormatted: formatNum(totalDisplayDistance) + ' ' + currentDistanceUnit,
        isRoundTrip: isRoundTrip,
        fuelLitres: fuelRequiredLitres,
        costPerKm: costPerKm,
        costPerMile: costPerMile,
        currency: currency,
        effectiveEconomyFormatted: formatNum(economyKmL, 2) + ' km/L',
        steps: steps
      });
    });
  }

  if (btnTripReset) {
    btnTripReset.addEventListener('click', function() {
      if (formTrip) formTrip.reset();
      // Ensure all fields are explicitly cleared to empty strings
      var distInput = document.getElementById('trip-distance');
      if (distInput) distInput.value = '';
      var econInput = document.getElementById('trip-economy');
      if (econInput) econInput.value = '';
      var priceInput = document.getElementById('trip-price');
      if (priceInput) priceInput.value = '';
      var roundtripCheck = document.getElementById('trip-roundtrip');
      if (roundtripCheck) roundtripCheck.checked = false;

      if (tripError) tripError.classList.add('hidden');
      hideResults();
    });
  }

  // --- MODE 2: KNOWN FUEL USED FORM SUBMIT ---
  var formFuelUsed = document.getElementById('form-fuel-used');
  var usedError = document.getElementById('used-error');
  var btnUsedReset = document.getElementById('btn-used-reset');

  if (formFuelUsed) {
    formFuelUsed.addEventListener('submit', function(e) {
      e.preventDefault();
      if (usedError) usedError.classList.add('hidden');

      var dist = parseFloat(document.getElementById('used-distance').value);
      var litres = parseFloat(document.getElementById('used-litres').value);
      var price = parseFloat(document.getElementById('used-price').value);

      if (isNaN(dist) || dist <= 0) {
        showError(usedError, 'Please enter a valid distance greater than 0.');
        return;
      }
      if (isNaN(litres) || litres <= 0) {
        showError(usedError, 'Please enter valid litres filled greater than 0.');
        return;
      }
      if (isNaN(price) || price < 0) {
        showError(usedError, 'Please enter a valid fuel price per litre.');
        return;
      }

      var totalCost = litres * price;
      var economyKmL = dist / litres;
      var costPerKm = totalCost / dist;
      var costPerMile = costPerKm * MILES_TO_KM;

      var steps = [
        { label: 'Total Fuel Cost', calc: litres + ' Litres × ' + formatMoney(price, currentCurrency) + '/L = ' + formatMoney(totalCost, currentCurrency) },
        { label: 'Actual Mileage Achieved', calc: dist + ' km ÷ ' + litres + ' Litres = ' + formatNum(economyKmL, 2) + ' km/L' },
        { label: 'Cost per Kilometre', calc: formatMoney(totalCost, currentCurrency) + ' ÷ ' + dist + ' km = ' + formatMoney(costPerKm, currentCurrency) + '/km' }
      ];

      showResults({
        heroTitle: 'Total Fuel Cost',
        mainCostFormatted: formatMoney(totalCost, currentCurrency),
        totalDistFormatted: formatNum(dist) + ' km',
        isRoundTrip: false,
        fuelLitres: litres,
        costPerKm: costPerKm,
        costPerMile: costPerMile,
        currency: currentCurrency,
        effectiveEconomyFormatted: formatNum(economyKmL, 2) + ' km/L',
        steps: steps
      });
    });
  }

  if (btnUsedReset) {
    btnUsedReset.addEventListener('click', function() {
      if (formFuelUsed) formFuelUsed.reset();
      document.getElementById('used-distance').value = '';
      document.getElementById('used-litres').value = '';
      document.getElementById('used-price').value = '';
      if (usedError) usedError.classList.add('hidden');
      hideResults();
    });
  }

  // --- MODE 3: BUDGET TO DISTANCE FORM SUBMIT ---
  var formFuelBudget = document.getElementById('form-fuel-budget');
  var budgetError = document.getElementById('budget-error');
  var btnBudgetReset = document.getElementById('btn-budget-reset');

  if (formFuelBudget) {
    formFuelBudget.addEventListener('submit', function(e) {
      e.preventDefault();
      if (budgetError) budgetError.classList.add('hidden');

      var budget = parseFloat(document.getElementById('budget-amount').value);
      var price = parseFloat(document.getElementById('budget-price').value);
      var econ = parseFloat(document.getElementById('budget-economy').value);

      if (isNaN(budget) || budget <= 0) {
        showError(budgetError, 'Please enter a valid budget amount greater than 0.');
        return;
      }
      if (isNaN(price) || price <= 0) {
        showError(budgetError, 'Please enter a valid fuel price per litre greater than 0.');
        return;
      }
      if (isNaN(econ) || econ <= 0) {
        showError(budgetError, 'Please enter a valid fuel economy in km/L greater than 0.');
        return;
      }

      var fuelAvailableLitres = budget / price;
      var maxDistanceKm = fuelAvailableLitres * econ;
      var costPerKm = price / econ;
      var costPerMile = costPerKm * MILES_TO_KM;

      var steps = [
        { label: 'Fuel Purchased with Budget', calc: formatMoney(budget, currentCurrency) + ' ÷ ' + formatMoney(price, currentCurrency) + '/L = ' + formatNum(fuelAvailableLitres, 2) + ' Litres' },
        { label: 'Maximum Travel Distance', calc: formatNum(fuelAvailableLitres, 2) + ' Litres × ' + econ + ' km/L = ' + formatNum(maxDistanceKm, 2) + ' km (' + formatNum(maxDistanceKm * KM_TO_MILES, 2) + ' miles)' },
        { label: 'Cost per Kilometre', calc: formatMoney(price, currentCurrency) + ' ÷ ' + econ + ' km/L = ' + formatMoney(costPerKm, currentCurrency) + '/km' }
      ];

      showResults({
        heroTitle: 'Maximum Distance You Can Travel',
        mainCostFormatted: formatNum(maxDistanceKm, 1) + ' km',
        totalDistFormatted: formatNum(maxDistanceKm, 1) + ' km (' + formatNum(maxDistanceKm * KM_TO_MILES, 1) + ' mi)',
        isRoundTrip: false,
        fuelLitres: fuelAvailableLitres,
        costPerKm: costPerKm,
        costPerMile: costPerMile,
        currency: currentCurrency,
        effectiveEconomyFormatted: formatNum(econ, 2) + ' km/L',
        steps: steps
      });
    });
  }

  if (btnBudgetReset) {
    btnBudgetReset.addEventListener('click', function() {
      if (formFuelBudget) formFuelBudget.reset();
      document.getElementById('budget-amount').value = '';
      document.getElementById('budget-price').value = '';
      document.getElementById('budget-economy').value = '';
      if (budgetError) budgetError.classList.add('hidden');
      hideResults();
    });
  }

  // --- MODE 4: TARGET ECONOMY SUBMIT ---
  var formFuelTarget = document.getElementById('form-fuel-target');
  var targetError = document.getElementById('target-error');
  var btnTargetReset = document.getElementById('btn-target-reset');

  if (formFuelTarget) {
    formFuelTarget.addEventListener('submit', function(e) {
      e.preventDefault();
      if (targetError) targetError.classList.add('hidden');

      var dist = parseFloat(document.getElementById('target-dist').value);
      var budget = parseFloat(document.getElementById('target-budget').value);
      var price = parseFloat(document.getElementById('target-price').value);

      if (isNaN(dist) || dist <= 0) {
        showError(targetError, 'Please enter a valid distance in km greater than 0.');
        return;
      }
      if (isNaN(budget) || budget <= 0) {
        showError(targetError, 'Please enter a valid max budget greater than 0.');
        return;
      }
      if (isNaN(price) || price <= 0) {
        showError(targetError, 'Please enter a valid fuel price per litre greater than 0.');
        return;
      }

      var maxLitres = budget / price;
      var requiredKmL = dist / maxLitres;
      var costPerKm = budget / dist;
      var costPerMile = costPerKm * MILES_TO_KM;

      var steps = [
        { label: 'Max Fuel Affordable', calc: formatMoney(budget, currentCurrency) + ' ÷ ' + formatMoney(price, currentCurrency) + '/L = ' + formatNum(maxLitres, 2) + ' Litres' },
        { label: 'Required Fuel Economy', calc: dist + ' km ÷ ' + formatNum(maxLitres, 2) + ' Litres = ' + formatNum(requiredKmL, 2) + ' km/L' },
        { label: 'Target Running Cost', calc: formatMoney(budget, currentCurrency) + ' ÷ ' + dist + ' km = ' + formatMoney(costPerKm, currentCurrency) + '/km' }
      ];

      showResults({
        heroTitle: 'Minimum Required Fuel Economy',
        mainCostFormatted: formatNum(requiredKmL, 2) + ' km/L',
        totalDistFormatted: formatNum(dist) + ' km',
        isRoundTrip: false,
        fuelLitres: maxLitres,
        costPerKm: costPerKm,
        costPerMile: costPerMile,
        currency: currentCurrency,
        effectiveEconomyFormatted: formatNum(requiredKmL, 2) + ' km/L',
        steps: steps
      });
    });
  }

  if (btnTargetReset) {
    btnTargetReset.addEventListener('click', function() {
      if (formFuelTarget) formFuelTarget.reset();
      document.getElementById('target-dist').value = '';
      document.getElementById('target-budget').value = '';
      document.getElementById('target-price').value = '';
      if (targetError) targetError.classList.add('hidden');
      hideResults();
    });
  }

  function showError(el, msg) {
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

})();
</script>
