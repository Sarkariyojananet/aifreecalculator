---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---

<CalculatorLayout
  title="Fuel Cost Calculator – Calculate Trip Fuel Cost, Petrol & Diesel Expense"
  description="Calculate total fuel required in litres, trip fuel cost, cost per km, cost per mile, and distance from budget for cars, bikes, and road trips in India, UK, and worldwide."
  category="General"
  calculatorName="Fuel Cost Calculator"
  slug="fuel-cost-calculator"
  keywords={[
    'fuel cost calculator',
    'fuel cost calculator india',
    'fuel cost calculator km india',
    'trip fuel cost calculator india',
    'fuel cost calculator uk',
    'journey fuel cost calculator',
    'fuel cost per km',
    'fuel cost per mile',
    'trip fuel cost',
    'journey fuel cost',
    'calculate fuel cost',
    'petrol cost calculator',
    'diesel cost calculator',
    'car fuel cost calculator',
    'road trip fuel cost calculator',
    'fuel consumption calculator',
    'fuel economy calculator',
    'fuel cost per km calculator',
    'fuel cost per mile calculator',
    'petrol cost per km',
    'diesel cost per km',
    'fuel cost calculator for trip'
  ]}
>
  <div class="space-y-6">

    <!-- REGION / PRESET BAR -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-3.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="font-bold text-slate-600 dark:text-slate-400 mr-1">🌍 Quick Region Presets:</span>
          <button type="button" id="preset-india" class="btn-preset-region active rounded-lg border border-amber-500 bg-amber-50 px-3 py-1.5 font-bold text-amber-800 hover:bg-amber-100 dark:border-amber-600 dark:bg-amber-950/40 dark:text-amber-300 cursor-pointer transition">🇮🇳 India (₹ INR • km • km/L)</button>
          <button type="button" id="preset-uk" class="btn-preset-region rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition">🇬🇧 UK (£ GBP • miles • UK MPG)</button>
          <button type="button" id="preset-us" class="btn-preset-region rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition">🇺🇸 US ($ USD • miles • US MPG)</button>
          <button type="button" id="preset-eu" class="btn-preset-region rounded-lg border border-slate-300 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:border-amber-500 hover:text-amber-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition">🇪🇺 Europe (€ EUR • km • L/100 km)</button>
        </div>
        <span class="text-[11px] font-medium text-slate-500 italic">Enter current pump price below</span>
      </div>
    </div>

    <!-- CALCULATION MODE TABS -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-2.5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-semibold scrollbar-thin">
        <button type="button" class="btn-fuel-mode active shrink-0 rounded-lg bg-amber-500 px-3.5 py-2 font-bold text-white shadow-xs cursor-pointer transition" data-mode="trip">
          🚗 Trip Fuel Cost (Distance + Efficiency)
        </button>
        <button type="button" class="btn-fuel-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="fuel-used">
          ⛽ Known Fuel Used (Distance + Litres)
        </button>
        <button type="button" class="btn-fuel-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="budget">
          💰 Budget to Distance (Reverse)
        </button>
        <button type="button" class="btn-fuel-mode shrink-0 rounded-lg border border-slate-300 bg-white px-3.5 py-2 font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 cursor-pointer transition" data-mode="target-economy">
          🎯 Target Efficiency (Budget + Distance)
        </button>
      </div>
    </div>

    <!-- MAIN FORM PANEL -->
    <div class="overflow-hidden rounded-3xl border border-slate-200/90 bg-linear-to-br from-white via-amber-50/20 to-orange-50/20 p-5 shadow-xl shadow-slate-900/5 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-amber-950/10 sm:p-7">
      
      <!-- MODE 1: TRIP / DISTANCE + EFFICIENCY -->
      <div id="panel-trip" class="fuel-panel space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🚗</span> Trip & Journey Fuel Cost Calculator
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Calculate total fuel cost, litres required, and cost per kilometre or mile based on trip distance, vehicle mileage, and fuel price.
          </p>
        </div>

        <form id="form-fuel-trip" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            
            <!-- Distance Input & Unit -->
            <div>
              <div class="flex items-center justify-between">
                <label for="trip-distance" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Trip Distance *
                </label>
                <div class="flex items-center gap-1 text-[11px] font-semibold">
                  <button type="button" class="unit-dist-toggle text-amber-600 dark:text-amber-400 underline font-bold cursor-pointer" data-unit="km">km</button>
                  <span class="text-slate-400">|</span>
                  <button type="button" class="unit-dist-toggle text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 cursor-pointer" data-unit="miles">miles</button>
                </div>
              </div>
              <div class="relative mt-1.5">
                <input
                  type="number"
                  id="trip-distance"
                  placeholder="Enter distance (e.g. 500)"
                  step="any"
                  min="0.01"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-14 text-sm font-bold text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span id="trip-dist-label" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">km</span>
              </div>
            </div>

            <!-- Fuel Efficiency & Unit -->
            <div>
              <div class="flex items-center justify-between">
                <label for="trip-economy" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Fuel Economy / Mileage *
                </label>
                <select id="trip-economy-unit" class="text-[11px] font-bold text-amber-700 dark:text-amber-400 bg-transparent border-none cursor-pointer focus:ring-0 p-0">
                  <option value="kml">km/L</option>
                  <option value="l100km">L/100 km</option>
                  <option value="ukmpg">MPG (UK)</option>
                  <option value="usmpg">MPG (US)</option>
                </select>
              </div>
              <div class="relative mt-1.5">
                <input
                  type="number"
                  id="trip-economy"
                  placeholder="Enter mileage (e.g. 15)"
                  step="any"
                  min="0.01"
                  class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-18 text-sm font-bold text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span id="trip-econ-label" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">km/L</span>
              </div>
            </div>

            <!-- Fuel Price & Currency -->
            <div>
              <div class="flex items-center justify-between">
                <label for="trip-price" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                  Fuel Price (per litre) *
                </label>
                <select id="trip-currency" class="text-[11px] font-bold text-amber-700 dark:text-amber-400 bg-transparent border-none cursor-pointer focus:ring-0 p-0">
                  <option value="₹">₹ INR</option>
                  <option value="£">£ GBP</option>
                  <option value="$">$ USD</option>
                  <option value="€">€ EUR</option>
                </select>
              </div>
              <div class="relative mt-1.5">
                <span id="trip-curr-prefix" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">₹</span>
                <input
                  type="number"
                  id="trip-price"
                  placeholder="Enter price per litre (e.g. 100)"
                  step="any"
                  min="0"
                  class="w-full rounded-xl border border-slate-300 bg-white pl-8 pr-14 p-2.5 text-sm font-bold text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">/ litre</span>
              </div>
            </div>

          </div>

          <!-- Secondary Options: Round Trip & Fuel Type -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800">
              <input
                type="checkbox"
                id="trip-roundtrip"
                class="h-4 w-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500 cursor-pointer"
              />
              <label for="trip-roundtrip" class="text-xs font-semibold text-slate-800 dark:text-slate-200 cursor-pointer">
                🔁 Round trip (Doubles distance for return journey)
              </label>
            </div>

            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-800">
              <label for="trip-fuel-type" class="text-xs font-semibold text-slate-700 dark:text-slate-300">Fuel Type (Optional Label):</label>
              <select id="trip-fuel-type" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-bold text-slate-800 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200 cursor-pointer">
                <option value="petrol">Petrol / Gasoline</option>
                <option value="diesel">Diesel</option>
                <option value="cng">CNG / Other</option>
              </select>
            </div>
          </div>

          <!-- Error Message Container -->
          <div id="trip-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-400"></div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2 pt-2">
            <button
              type="submit"
              id="btn-trip-calc"
              class="flex-1 rounded-xl bg-amber-500 hover:bg-amber-600 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-amber-500/25 transition active:scale-[0.98] cursor-pointer"
            >
              Calculate Fuel Cost →
            </button>
            <button
              type="button"
              id="btn-trip-reset"
              class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer"
            >
              Reset (✕)
            </button>
          </div>
        </form>
      </div>

      <!-- MODE 2: KNOWN FUEL USED -->
      <div id="panel-fuel-used" class="fuel-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>⛽</span> Calculate Cost from Total Fuel Filled
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            If you already know exactly how many litres you filled at the fuel station, calculate total expense, effective mileage, and cost per km.
          </p>
        </div>

        <form id="form-fuel-used" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="used-distance" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Total Distance Travelled *</label>
              <div class="relative mt-1.5">
                <input type="number" id="used-distance" placeholder="Enter distance" step="any" min="0.01" class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-12 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">km</span>
              </div>
            </div>
            <div>
              <label for="used-litres" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Total Fuel Consumed / Filled *</label>
              <div class="relative mt-1.5">
                <input type="number" id="used-litres" placeholder="Enter litres filled" step="any" min="0.01" class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-14 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">Litres</span>
              </div>
            </div>
            <div>
              <label for="used-price" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Fuel Price (per litre) *</label>
              <div class="relative mt-1.5">
                <span id="used-curr-prefix" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">₹</span>
                <input type="number" id="used-price" placeholder="Price per litre" step="any" min="0" class="w-full rounded-xl border border-slate-300 bg-white pl-8 pr-12 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">/ L</span>
              </div>
            </div>
          </div>

          <div id="used-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-400"></div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-used-calc" class="flex-1 rounded-xl bg-amber-500 hover:bg-amber-600 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-amber-500/25 transition active:scale-[0.98] cursor-pointer">Calculate Cost & Mileage →</button>
            <button type="button" id="btn-used-reset" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Reset (✕)</button>
          </div>
        </form>
      </div>

      <!-- MODE 3: BUDGET TO DISTANCE -->
      <div id="panel-budget" class="fuel-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>💰</span> Calculate Distance from Fuel Budget
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Have a fixed amount of money for petrol or diesel? Find out how many litres you can buy and how far you can drive.
          </p>
        </div>

        <form id="form-fuel-budget" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="budget-amount" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Total Fuel Budget *</label>
              <div class="relative mt-1.5">
                <span id="budget-curr-prefix" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">₹</span>
                <input type="number" id="budget-amount" placeholder="Enter budget (e.g. 2000)" step="any" min="0.01" class="w-full rounded-xl border border-slate-300 bg-white pl-8 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
              </div>
            </div>
            <div>
              <label for="budget-price" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Fuel Price (per litre) *</label>
              <div class="relative mt-1.5">
                <span id="budget-price-prefix" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">₹</span>
                <input type="number" id="budget-price" placeholder="Price per litre (e.g. 100)" step="any" min="0.01" class="w-full rounded-xl border border-slate-300 bg-white pl-8 pr-12 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">/ L</span>
              </div>
            </div>
            <div>
              <label for="budget-economy" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Vehicle Mileage (km/L) *</label>
              <div class="relative mt-1.5">
                <input type="number" id="budget-economy" placeholder="Mileage (e.g. 20)" step="any" min="0.01" class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-14 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">km/L</span>
              </div>
            </div>
          </div>

          <div id="budget-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-400"></div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-budget-calc" class="flex-1 rounded-xl bg-amber-500 hover:bg-amber-600 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-amber-500/25 transition active:scale-[0.98] cursor-pointer">Calculate Travel Distance →</button>
            <button type="button" id="btn-budget-reset" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Reset (✕)</button>
          </div>
        </form>
      </div>

      <!-- MODE 4: TARGET EFFICIENCY -->
      <div id="panel-target-economy" class="fuel-panel hidden space-y-5">
        <div class="border-b border-slate-200/80 pb-3 dark:border-slate-800">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🎯</span> Required Fuel Economy for Target Budget
          </h2>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            Calculate the minimum mileage (km/L) your car or bike must achieve to complete a specific distance within a capped fuel budget.
          </p>
        </div>

        <form id="form-fuel-target" class="space-y-4" novalidate onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="target-dist" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Total Distance to Cover (km) *</label>
              <div class="relative mt-1.5">
                <input type="number" id="target-dist" placeholder="Distance in km" step="any" min="0.01" class="w-full rounded-xl border border-slate-300 bg-white p-2.5 pr-12 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">km</span>
              </div>
            </div>
            <div>
              <label for="target-budget" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Max Budget Available *</label>
              <div class="relative mt-1.5">
                <span id="target-curr-prefix" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">₹</span>
                <input type="number" id="target-budget" placeholder="Max budget" step="any" min="0.01" class="w-full rounded-xl border border-slate-300 bg-white pl-8 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
              </div>
            </div>
            <div>
              <label for="target-price" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Fuel Price (per litre) *</label>
              <div class="relative mt-1.5">
                <span id="target-price-prefix" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-500">₹</span>
                <input type="number" id="target-price" placeholder="Price per litre" step="any" min="0.01" class="w-full rounded-xl border border-slate-300 bg-white pl-8 pr-12 p-2.5 text-sm font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-500">/ L</span>
              </div>
            </div>
          </div>

          <div id="target-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-3 text-xs font-semibold text-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-400"></div>

          <div class="flex items-center gap-2 pt-2">
            <button type="submit" id="btn-target-calc" class="flex-1 rounded-xl bg-amber-500 hover:bg-amber-600 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-amber-500/25 transition active:scale-[0.98] cursor-pointer">Calculate Required Mileage →</button>
            <button type="button" id="btn-target-reset" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition cursor-pointer">Reset (✕)</button>
          </div>
        </form>
      </div>

      <!-- RESULTS SECTION -->
      <div id="fuel-results" class="hidden mt-7 space-y-5">
        
        <!-- Hero Card -->
        <div class="overflow-hidden rounded-3xl border border-amber-200 bg-linear-to-br from-white via-amber-50/40 to-orange-100/50 p-5 shadow-lg shadow-amber-500/5 dark:border-amber-900/60 dark:from-slate-950 dark:via-slate-900 dark:to-amber-950/30 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-amber-200/80 pb-4 dark:border-slate-800">
            <div>
