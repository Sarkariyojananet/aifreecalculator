---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCalculatorOverrides } from '../lib/admin/content-store';
import { getLivePageMeta } from '../lib/seo/page-metadata';

const overrides = await getCalculatorOverrides(Astro.locals);
const override = overrides['core:disclaimer'] || {};
const liveMeta = getLivePageMeta('core:disclaimer');

const effectiveTitle = override.metaTitle || liveMeta.title;
const effectiveDescription = override.metaDescription || liveMeta.description;
const effectiveCanonical = override.canonicalUrl;
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
>
  <!-- Hero Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-slate-50 via-white to-slate-50 px-4 py-16 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50/80 px-3.5 py-1 text-xs font-bold text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/50 dark:text-amber-300 shadow-xs">
        <span>⚠️</span> Legal &amp; Professional Disclaimers
      </div>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Disclaimer
      </h1>
      <p class="mt-4 text-sm font-medium text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        Please read these domain-specific disclaimers carefully before using or relying on computational figures generated by AI Free Calculator.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <span class="rounded-lg bg-slate-100 px-3 py-1 dark:bg-slate-800">
          📅 Effective: September 2026
        </span>
        <span class="rounded-lg bg-amber-100 text-amber-900 px-3 py-1 dark:bg-amber-950/60 dark:text-amber-300">
          Informational &amp; Estimation Purposes Only
        </span>
      </div>
    </div>
  </div>

  <!-- Main Content Body -->
  <main class="mx-auto max-w-4xl px-4 py-12 sm:py-16 text-slate-700 dark:text-slate-300">
    
    <!-- Primary Alert Box -->
    <div class="mb-12 rounded-3xl border border-amber-200 bg-amber-50/60 p-6 dark:border-amber-900/40 dark:bg-amber-950/20 sm:p-8 space-y-3 shadow-xs">
      <h2 class="text-base font-bold text-amber-900 dark:text-amber-200 flex items-center gap-2">
        <span>⚠️</span> Important Notice for All Users
      </h2>
      <p class="text-xs leading-relaxed text-amber-950 dark:text-amber-200/90">
        The algorithms, estimates, spreadsheets, formulas, and informational resources provided on <strong>AI Free Calculator</strong> (<a href="https://aifreecalculator.com" class="underline font-bold">aifreecalculator.com</a>) are designed strictly for <strong>preliminary planning, self-educational purposes, and general mathematical estimations</strong>. Under no circumstances should results generated on this site replace professional consultation with licensed engineers, certified chartered accountants, registered financial advisors, or healthcare professionals.
      </p>
    </div>

    <!-- Domain Specific Disclaimers -->
    <div class="space-y-12 text-sm leading-relaxed">
      
      <!-- Section 1: Civil & Construction -->
      <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/80 shadow-xs">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-3 dark:border-slate-800">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600 dark:bg-amber-950 dark:text-amber-400">
            🏗️
          </span>
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white">
              1. Civil &amp; Structural Engineering BOQ Disclaimer
            </h2>
            <span class="text-[11px] text-slate-400">Concrete, Steel Weight, Slabs, Beams, Columns, Footings &amp; Brickwork</span>
          </div>
        </div>
        <p>
          Our construction calculators (such as RCC Slab Steel, RCC Beam Rebar, Concrete Material Breakup, Steel Weight per meter, Brickwork mortar counts, Plaster, Paint, and Master BOQ estimates) apply standardized rule-of-thumb ratios, standard density coefficients (e.g. steel density 7850 kg/m³, dry volume multiplier 1.54 for concrete), and generalized code practices.
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
          <li><strong>Not a Structural Drawing:</strong> Computations do not account for site-specific soil bearing capacity, seismic zone parameters, wind load coefficients, deflection criteria, or localized municipal building bylaws.</li>
          <li><strong>Requirement for Licensed Engineer Sign-Off:</strong> All structural elements (rebar diameter, spacing, bend allowances, lap lengths, footing dimensions) must be formally designed and stamped by a licensed structural engineer before construction or bar bending commences.</li>
          <li><strong>Material Wastage &amp; Market Deviations:</strong> Actual job site material quantities may deviate based on contractor handling, cutting wastage, brick sizes, sand moisture bulking, and aggregate grading.</li>
        </ul>
      </section>

      <!-- Section 2: Financial & Taxation -->
      <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/80 shadow-xs">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-3 dark:border-slate-800">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400">
            💰
          </span>
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white">
              2. Financial, Banking, Investment &amp; Tax Disclaimer
            </h2>
            <span class="text-[11px] text-slate-400">Loan EMI, SIP Mutual Funds, Income Tax, GST &amp; Amortization</span>
          </div>
        </div>
        <p>
          Financial tools (including Home Loan EMI, SIP Wealth Forecasts, Compound Interest, Income Tax, GST, and Salary take-home calculations) operate on simplified mathematical compounding formulas and static tax rate assumptions:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
          <li><strong>Not Certified Financial or Tax Advice:</strong> Outputs do not constitute binding loan sanction schedules from commercial banks or formal tax declarations to government revenue authorities.</li>
          <li><strong>Dynamic Interest &amp; Market Volatility:</strong> Actual bank EMI amounts may vary based on daily reducing balance rules, processing fees, loan rest periods, and floating repo rate revisions. Mutual fund SIP returns are subject to market risks and historical returns do not guarantee future performance.</li>
          <li><strong>Tax Law Complexity:</strong> Tax computations reflect general brackets and standard deductions. Specific exemptions, surcharges, rebates (e.g. 87A), and cess may vary by individual jurisdiction. Consult a Certified Financial Planner (CFP) or Chartered Accountant (CA).</li>
        </ul>
      </section>

      <!-- Section 3: Health & Fitness -->
      <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/80 shadow-xs">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-3 dark:border-slate-800">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-50 text-xl text-rose-600 dark:bg-rose-950 dark:text-rose-400">
            ❤️
          </span>
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white">
              3. Medical &amp; Nutritional Health Disclaimer
            </h2>
            <span class="text-[11px] text-slate-400">BMI, BMR, Calorie Expenditure &amp; Body Fat Percentage</span>
          </div>
        </div>
        <p>
          Health calculators (such as Body Mass Index, Basal Metabolic Rate via Mifflin-St Jeor / Harris-Benedict formulas, Calorie counters, and Body Fat estimators) are statistical screening formulas designed for general healthy adult populations:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
          <li><strong>Not Medical Advice or Clinical Diagnosis:</strong> These tools do not distinguish between lean muscle mass and adipose tissue, nor do they consider pregnancy, endocrine disorders, metabolic conditions, or pediatric growth curves.</li>
          <li><strong>Always Consult Healthcare Providers:</strong> Never initiate extreme caloric deficits, rapid weight alteration regimens, or strenuous physical training based solely on algorithmic estimates without consulting a qualified medical doctor or registered clinical dietitian.</li>
        </ul>
      </section>

      <!-- Section 4: General Scientific Math & Unit Conversions -->
      <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/80 shadow-xs">
        <div class="flex items-center gap-3 border-b border-slate-100 pb-3 dark:border-slate-800">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-xl text-blue-600 dark:bg-blue-950 dark:text-blue-400">
            📐
          </span>
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white">
              4. Mathematical Accuracy &amp; Floating-Point Precision
            </h2>
            <span class="text-[11px] text-slate-400">Unit Conversions, Scientific Math &amp; Rounding</span>
          </div>
        </div>
        <p>
          While our algorithms are rigorously tested against standard scientific constants and double-precision arithmetic, slight rounding variances may occur due to browser floating-point representations or decimal truncation. For mission-critical aerospace, lab science, or high-frequency trading applications, always verify with dedicated specialized software.
        </p>
      </section>

      <!-- Section 5: External Links & Ads -->
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🔗</span> 5. Third-Party Advertisements &amp; External Links
        </h2>
        <p>
          AI Free Calculator displays third-party advertisements (such as Google AdSense, AdX, and partner networks). The presence of any advertisement or outbound hyperlink does not imply endorsement, warranty, or recommendation of the advertised products, loan offers, construction supplies, or medical services.
        </p>
      </section>

      <!-- Section 6: Limitation of Liability Confirmation -->
      <section class="space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-950">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🛡️</span> 6. User Acknowledgment &amp; Indemnity
        </h2>
        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          By utilizing AI Free Calculator, you expressly understand and agree that any reliance upon any calculation, formula, estimate, or information provided by this website is at your own sole risk. The creators, developers, and operators of AI Free Calculator shall not be liable for any direct, indirect, incidental, or consequential damages resulting from the use or inability to use any tool on this site.
        </p>
      </section>

    </div>
  </main>
</BaseLayout>
