---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCalculatorOverrides } from '../lib/admin/content-store';
import { getLivePageMeta } from '../lib/seo/page-metadata';

const overrides = await getCalculatorOverrides(Astro.locals);
const override = overrides['core:terms'] || {};
const liveMeta = getLivePageMeta('core:terms');

const effectiveTitle = override.metaTitle || liveMeta.title;
const effectiveDescription = override.metaDescription || liveMeta.description;
const effectiveCanonical = override.canonicalUrl;
---

<BaseLayout
  title={effectiveTitle}
  description={effectiveDescription}
  canonicalUrl={effectiveCanonical}
>
  <!-- Hero Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-slate-50 via-white to-slate-50 px-4 py-16 dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 sm:py-20">
    <div class="mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/80 px-3.5 py-1 text-xs font-bold text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/50 dark:text-blue-300 shadow-xs">
        <span>📜</span> Terms &amp; Conditions
      </div>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Terms of Service
      </h1>
      <p class="mt-4 text-sm font-medium text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        Please read these terms and conditions carefully before using our free calculation utilities, tools, and content.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <span class="rounded-lg bg-slate-100 px-3 py-1 dark:bg-slate-800">
          📅 Last Updated: September 2026
        </span>
        <span class="rounded-lg bg-blue-50 text-blue-700 px-3 py-1 dark:bg-blue-950/60 dark:text-blue-300">
          Applicable Globally
        </span>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <main class="mx-auto max-w-4xl px-4 py-12 sm:py-16 text-slate-700 dark:text-slate-300">
    <div class="space-y-10 text-sm leading-relaxed">
      
      <!-- Section 1 -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-xs text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold">1</span>
          Agreement to Terms
        </h2>
        <p>
          These Terms of Service constitute a legally binding agreement made between you, whether personally or on behalf of an entity ("you") and <strong>AI Free Calculator</strong> ("we", "us", or "our"), concerning your access to and use of the <a href="https://aifreecalculator.com" class="text-blue-600 underline dark:text-blue-400">aifreecalculator.com</a> website as well as any related web applications.
        </p>
        <p>
          By accessing or using any part of the site, you acknowledge that you have read, understood, and agreed to be bound by all of these Terms of Service. If you do not agree with all of these terms, you are expressly prohibited from using the site and must discontinue use immediately.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-xs text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold">2</span>
          Nature of Service &amp; Estimation Disclaimer
        </h2>
        <p>
          All calculators, algorithms, estimations, tables, charts, and explanations provided on AI Free Calculator are intended solely for <strong>general informational, educational, and preliminary estimation purposes</strong>:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>No Professional Advice:</strong> Computational outputs generated on this website do not constitute certified engineering drawings, binding banking commitments, legal tax counsel, or customized medical diagnoses.</li>
          <li><strong>Verification Obligation:</strong> You acknowledge and agree that critical figures must always be independently audited and verified with qualified professionals (e.g. licensed structural engineers, certified chartered accountants, or registered medical doctors) before executing significant real estate, engineering, financial, or medical decisions.</li>
        </ul>
      </section>

      <!-- Section 3 -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-xs text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold">3</span>
          Intellectual Property Rights
        </h2>
        <p>
          Unless otherwise indicated, the website is our proprietary property. All source code, databases, website functionality, software, website designs, audio, video, text, charts, graphics, and logos (collectively, the "Content") are owned or controlled by us or licensed to us, and are protected by copyright, trademark, and unfair competition laws.
        </p>
        <p>
          You are granted a limited license to access and use the site and its calculators solely for your personal, non-commercial, or internal business calculations. You may not duplicate, reverse engineer, scrape, republish, or distribute our proprietary code or calculators for commercial redistribution without prior written consent.
        </p>
      </section>

      <!-- Section 4 -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-xs text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold">4</span>
          Prohibited Activities &amp; User Conduct
        </h2>
        <p>
          You agree not to access or use the site for any purpose other than that for which we make the site available. Prohibited activities include, but are not limited to:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
          <li>Systematically retrieving data or content from the site to create or compile a collection, database, or directory without written permission.</li>
          <li>Interfering with, disrupting, or creating an undue burden on the website or the networks connected to the site (e.g. denial of service attacks).</li>
          <li>Attempting to bypass security measures designed to prevent or restrict access to the site or any portion thereof.</li>
          <li>Using automated scripts, bots, spiders, or scrapers to extract computation data or manipulate analytics.</li>
        </ul>
      </section>

      <!-- Section 5 -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-xs text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold">5</span>
          Third-Party Links &amp; Advertisements
        </h2>
        <p>
          The website may contain advertisements, sponsored banners, or links to third-party websites (such as Google AdSense, affiliate partners, or resource references). Such third-party links are not investigated, monitored, or checked for accuracy or completeness by us.
        </p>
        <p>
          We assume no responsibility for the content, privacy practices, terms, or services of third-party advertisers or external websites linked from AI Free Calculator.
        </p>
      </section>

      <!-- Section 6 -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-xs text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold">6</span>
          Disclaimer of Warranties
        </h2>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60 text-xs leading-relaxed space-y-2">
          <p class="font-bold text-slate-900 dark:text-white uppercase tracking-wider">
            "AS IS" AND "AS AVAILABLE" PROVISION
          </p>
          <p>
            THE SITE AND ALL CALCULATORS ARE PROVIDED ON AN "AS-IS" AND "AS-AVAILABLE" BASIS. YOU AGREE THAT YOUR USE OF THE SITE AND OUR SERVICES WILL BE AT YOUR SOLE RISK. TO THE FULLEST EXTENT PERMITTED BY LAW, WE DISCLAIM ALL WARRANTIES, EXPRESS OR IMPLIED, IN CONNECTION WITH THE SITE AND YOUR USE THEREOF, INCLUDING, WITHOUT LIMITATION, THE IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT.
          </p>
        </div>
      </section>

      <!-- Section 7 -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-xs text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold">7</span>
          Limitation of Liability
        </h2>
        <p>
          IN NO EVENT WILL AI FREE CALCULATOR, ITS OPERATORS, OR CONTRIBUTORS BE LIABLE TO YOU OR ANY THIRD PARTY FOR ANY DIRECT, INDIRECT, CONSEQUENTIAL, EXEMPLARY, INCIDENTAL, SPECIAL, OR PUNITIVE DAMAGES, INCLUDING LOST PROFIT, LOST REVENUE, LOSS OF DATA, CONSTRUCTION DISCREPANCIES, TAX PENALTIES, OR OTHER DAMAGES ARISING FROM YOUR USE OF THE SITE, EVEN IF WE HAVE BEEN ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.
        </p>
      </section>

      <!-- Section 8 -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-xs text-blue-600 dark:bg-blue-950 dark:text-blue-400 font-bold">8</span>
          Modifications and Interruptions
        </h2>
        <p>
          We reserve the right to change, modify, or remove the contents of the site or discontinue any calculation tool at any time or for any reason at our sole discretion without notice. We will not be liable to you or any third party for any modification, suspension, or discontinuance of the site.
        </p>
      </section>

      <!-- Section 9 -->
      <section class="space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-950">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📬</span> Questions &amp; Legal Inquiries
        </h2>
        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          In order to resolve a complaint regarding the site or to receive further information regarding terms of use, please contact us through our <a href="/contact/" class="text-blue-600 font-bold hover:underline dark:text-blue-400">Contact Us page</a> or email <code class="font-mono text-blue-600 dark:text-blue-400">support@aifreecalculator.com</code>.
        </p>
      </section>

    </div>
  </main>
</BaseLayout>
